    Private Sub ParseDomainArgs(ByVal rawArgs As String, ByRef outArg1 As String, ByRef outArg2 As String, ByRef outArg3 As String)
        Dim parts() As String
        outArg1 = ""
        outArg2 = ""
        outArg3 = ""
        parts = Split(rawArgs, ",")
        If UBound(parts) >= 0 Then outArg1 = CleanQuotedArg(parts(0))
        If UBound(parts) >= 1 Then outArg2 = CleanQuotedArg(parts(1))
        If UBound(parts) >= 2 Then outArg3 = CleanQuotedArg(parts(2))
    End Sub

    Private Function CleanQuotedArg(ByVal s As String) As String
        Dim res As String
        res = Trim$(s)
        If Len(res) >= 2 Then
            If (Left$(res, 1) = """" And Right$(res, 1) = """") Or (Left$(res, 1) = "'" And Right$(res, 1) = "'") Then
                res = Mid$(res, 2, Len(res) - 2)
            End If
        End If
        CleanQuotedArg = res
    End Function

    Public Function EvaluateAccessExpression(ByVal exprText As String, ByRef outResult As String, ByRef outErrorMsg As String) As Boolean
        Dim cleanExpr As String
        Dim upperExpr As String
        Dim pOpen As Long
        Dim pClose As Long
        Dim fnName As String
        Dim innerArgs As String
        Dim a1 As String
        Dim a2 As String
        Dim a3 As String
        Dim vRes As Variant
        Dim rs As Object
        Dim evalSql As String

        outResult = vbNullString
        outErrorMsg = vbNullString

        cleanExpr = Trim$(exprText)
        If Left$(cleanExpr, 1) = "?" Or Left$(cleanExpr, 1) = "=" Then
            cleanExpr = Trim$(Mid$(cleanExpr, 2))
        End If

        If Len(cleanExpr) = 0 Then
            outErrorMsg = "Empty expression."
            EvaluateAccessExpression = False
            Exit Function
        End If

        If m_immediateHistory Is Nothing Then
            Set m_immediateHistory = New Collection
        End If

        upperExpr = UCase$(cleanExpr)
        pOpen = InStr(cleanExpr, "(")
        pClose = InStrRev(cleanExpr, ")")

        If pOpen > 1 And pClose > pOpen Then
            fnName = UCase$(Trim$(Left$(cleanExpr, pOpen - 1)))
            innerArgs = Mid$(cleanExpr, pOpen + 1, pClose - pOpen - 1)

            Select Case fnName
                Case "DLOOKUP"
                    ParseDomainArgs innerArgs, a1, a2, a3
                    vRes = DLookup(a1, a2, a3)
                    If IsNull(vRes) Then outResult = "<NULL>" Else outResult = CStr(vRes)
                    m_immediateHistory.Add "? " & cleanExpr & "  ==>  " & outResult
                    EvaluateAccessExpression = True
                    Exit Function

                Case "DCOUNT"
                    ParseDomainArgs innerArgs, a1, a2, a3
                    outResult = CStr(DCount(a1, a2, a3))
                    m_immediateHistory.Add "? " & cleanExpr & "  ==>  " & outResult
                    EvaluateAccessExpression = True
                    Exit Function

                Case "DSUM"
                    ParseDomainArgs innerArgs, a1, a2, a3
                    outResult = CStr(DSum(a1, a2, a3))
                    m_immediateHistory.Add "? " & cleanExpr & "  ==>  " & outResult
                    EvaluateAccessExpression = True
                    Exit Function

                Case "DAVG"
                    ParseDomainArgs innerArgs, a1, a2, a3
                    outResult = CStr(DAvg(a1, a2, a3))
                    m_immediateHistory.Add "? " & cleanExpr & "  ==>  " & outResult
                    EvaluateAccessExpression = True
                    Exit Function

                Case "DMIN"
                    ParseDomainArgs innerArgs, a1, a2, a3
                    vRes = DMin(a1, a2, a3)
                    If IsNull(vRes) Then outResult = "<NULL>" Else outResult = CStr(vRes)
                    m_immediateHistory.Add "? " & cleanExpr & "  ==>  " & outResult
                    EvaluateAccessExpression = True
                    Exit Function

                Case "DMAX"
                    ParseDomainArgs innerArgs, a1, a2, a3
                    vRes = DMax(a1, a2, a3)
                    If IsNull(vRes) Then outResult = "<NULL>" Else outResult = CStr(vRes)
                    m_immediateHistory.Add "? " & cleanExpr & "  ==>  " & outResult
                    EvaluateAccessExpression = True
                    Exit Function
            End Select
        End If

        ' Evaluate general SQL/VBA scalar expression via DAO engine
        If Not m_database Is Nothing Then
            On Error Resume Next
            evalSql = "SELECT " & cleanExpr & " AS ExprResult;"
            Set rs = m_database.OpenRecordset(evalSql)
            If Err.Number = 0 And Not rs Is Nothing Then
                If Not rs.EOF Then
                    vRes = rs.Fields(0).Value
                    If IsNull(vRes) Then outResult = "<NULL>" Else outResult = CStr(vRes)
                End If
                rs.Close
                m_immediateHistory.Add "? " & cleanExpr & "  ==>  " & outResult
                EvaluateAccessExpression = True
                On Error GoTo 0
                Exit Function
            Else
                outErrorMsg = "Expression Error: " & Err.Description
            End If
            On Error GoTo 0
        Else
            outErrorMsg = "Open a database to evaluate domain or SQL expressions."
        End If

        EvaluateAccessExpression = False
    End Function

    Public Function GetVbaModuleEditorLines(ByVal moduleName As String, ByRef outErrorMsg As String) As Collection
        If m_isCompiledLocked Then
            outErrorMsg = "Design access denied: VBA code editor is locked in compiled applications."
            Set GetVbaModuleEditorLines = Nothing
            Exit Function
        End If
        Dim lines As New Collection
        Dim customCode As String
        Dim srcName As String
        Dim codeLines() As String
        Dim i As Long
        Dim itemVal As Variant

        outErrorMsg = vbNullString
        lines.Add "================================================================================"
        lines.Add "  OPENACCESS STUDIO - VBA / TWINBASIC CODE EDITOR & IMMEDIATE WINDOW"
        lines.Add "  Active Module: [" & moduleName & "]"
        lines.Add "================================================================================"
        lines.Add "  Option Compare Database"
        lines.Add "  Option Explicit"
        lines.Add ""

        If Not m_database Is Nothing Then
            customCode = GetCustomObjectDefinition("MODULE", moduleName, srcName, outErrorMsg)
            If Len(Trim$(customCode)) = 0 And Left$(UCase$(moduleName), 4) = "MOD_" Then
                If Len(Trim$(m_activeModuleName)) > 0 Then
                    customCode = GetNativeVbaModuleCode(m_activeModuleName)
                End If
                If Len(Trim$(customCode)) = 0 And Len(Trim$(m_activeFormName)) > 0 Then
                    customCode = GetNativeVbaModuleCode("Form_" & m_activeFormName)
                End If
                If Len(Trim$(customCode)) = 0 Then
                    customCode = GetNativeVbaModuleCode(Mid$(moduleName, 5))
                End If
            End If
            outErrorMsg = vbNullString
        End If

        If Len(Trim$(customCode)) > 0 Then
            codeLines = Split(customCode, vbCrLf)
            For i = 0 To UBound(codeLines)
                If Left$(Trim$(codeLines(i)), 10) <> "Attribute " Then
                    lines.Add "  " & codeLines(i)
                End If
            Next i
        Else
            lines.Add "  ' Standard Access Form & Database Event Module"
            lines.Add "  Public Sub Form_Load()"
            lines.Add "      ' Initialize bound controls and verify domain lookups"
            lines.Add "      Dim totalRows As Long"
            lines.Add "      totalRows = StudioController.DCount(""*"", """ & IIf(Len(m_activeTableName) > 0, m_activeTableName, "Customers") & """)"
            lines.Add "      Debug.Print ""Loaded records: "" & CStr(totalRows)"
            lines.Add "  End Sub"
            lines.Add ""
            lines.Add "  Public Function CalculateTax(ByVal netAmount As Double) As Double"
            lines.Add "      CalculateTax = Round(netAmount * 0.15, 2)"
            lines.Add "  End Function"
        End If

        lines.Add ""
        lines.Add "--------------------------------------------------------------------------------"
        lines.Add "  IMMEDIATE WINDOW (Interactive Expression & Domain Aggregate Runner):"
        lines.Add "  Supported: DLookup, DCount, DSum, DAvg, DMin, DMax, IIf, Format, Date, Mid..."
        lines.Add "--------------------------------------------------------------------------------"
        If Not m_immediateHistory Is Nothing Then
            If m_immediateHistory.Count > 0 Then
                For Each itemVal In m_immediateHistory
                    lines.Add "  " & CStr(itemVal)
                Next itemVal
            Else
                lines.Add "  (No expressions evaluated yet. Click 'Eval Expr (?)' to evaluate an expression.)"
            End If
        End If
        lines.Add "================================================================================"

        Set GetVbaModuleEditorLines = lines
    End Function

    ' =========================================================================
    ' Native Microsoft Access Storage (MSysAccessStorage) & MS-OVBA Engine
    ' =========================================================================
    ' Forwarding methods to VbaProjectStore module (Plan 7 WS8)
    Private Function CollectionContainsText(ByVal col As Collection, ByVal itemText As String) As Boolean
        CollectionContainsText = VbaProjectStore.CollectionContainsText(col, itemText)
    End Function

    Private Function Pow2(ByVal expVal As Long) As Long
        Pow2 = VbaProjectStore.Pow2(expVal)
    End Function

    Public Function DecompressOvbaStream(ByRef buf() As Byte, Optional ByVal startOffset As Long = 0) As String
        DecompressOvbaStream = VbaProjectStore.DecompressOvbaStream(buf, startOffset)
    End Function

    Public Function GetNativeVbaModuleCode(ByVal moduleName As String) As String
        GetNativeVbaModuleCode = VbaProjectStore.GetNativeVbaModuleCode(m_database, moduleName)
    End Function

    Private Function ExtractUtf16StringsFromBlob(ByRef buf() As Byte) As Collection
        Set ExtractUtf16StringsFromBlob = VbaProjectStore.ExtractUtf16StringsFromBlob(buf)
    End Function

    Public Function InspectNativeAccessForm(ByVal formName As String, ByRef outRecordSource As String, ByRef outControls As Collection, ByRef outButtonName As String, ByRef outButtonCaption As String, ByRef outFormVbaCode As String) As Boolean
        Dim rs As Object
        Dim formsFolderId As Long
        Dim dirBytes() As Byte
        Dim storageFolderName As String
        Dim formStorageId As Long
        Dim typeBytes() As Byte
        Dim blobBytes() As Byte
        Dim pos As Long
        Dim maxIdx As Long
        Dim cType As Long
        Dim cName As String
        Dim cTypeStr As String
        Dim blobStrings As Collection
        Dim sIdx As Long
        Dim candStr As String
        Dim tblNames As Collection
        Dim qryNames As Collection
        Dim typeInfoCtrls As Collection
        Dim formLayout As NativeFormLayout
        Dim blobParsed As Boolean
        Dim lIdx As Long

        InspectNativeAccessForm = False
        m_inspectLayoutValid = False
        outRecordSource = vbNullString
        Set outControls = New Collection
        Set typeInfoCtrls = New Collection
        outButtonName = vbNullString
        outButtonCaption = vbNullString
        outFormVbaCode = vbNullString

        If m_database Is Nothing Or Len(Trim$(formName)) = 0 Then Exit Function

        outFormVbaCode = GetNativeVbaModuleCode("Form_" & Trim$(formName))
        formsFolderId = -1

        On Error Resume Next
        Set rs = m_database.OpenRecordset("SELECT [Id] FROM [MSysAccessStorage] WHERE [Name] = 'Forms';")
        If Err.Number = 0 And Not rs Is Nothing Then
            If Not rs.EOF Then formsFolderId = CLng(rs.Fields(0).Value)
            rs.Close
        End If

        If formsFolderId <= 0 Then
            On Error GoTo 0
            Exit Function
        End If

        ' Find storage subfolder name ("0", "1", ...) from DirData or first available subfolder
        storageFolderName = "0"
        Set rs = m_database.OpenRecordset("SELECT [Name], [Lv] FROM [MSysAccessStorage] WHERE [ParentId] = " & CStr(formsFolderId) & ";")
        If Err.Number = 0 And Not rs Is Nothing Then
            Do Until rs.EOF
                If InStr(1, CStr(rs.Fields(0).Value), "DirData", vbTextCompare) > 0 Then
                    Dim vDir As Variant
                    vDir = rs.Fields(1).Value
                    If Not IsNull(vDir) Then
                        dirBytes = vDir
                        Dim dMax As Long
                        Dim dPos As Long
                        Dim recLen As Long
                        Dim nameBytesLen As Long
                        Dim chIdx As Long
                        Dim entryName As String
                        Dim folderNum As Long
                        dMax = UBound(dirBytes)
                        dPos = 4
                        Do While (dPos + 5) <= dMax
                            recLen = CLng(dirBytes(dPos + 1))
                            If recLen <= 4 Or (dPos + 1 + recLen) > dMax Then Exit Do
                            nameBytesLen = recLen - 4
                            entryName = vbNullString
                            For chIdx = 0 To (nameBytesLen \ 2) - 1
                                entryName = entryName & Chr$(dirBytes(dPos + 2 + (chIdx * 2)))
                            Next chIdx
                            folderNum = CLng(dirBytes(dPos + 2 + nameBytesLen))
                            If UCase$(Trim$(entryName)) = UCase$(Trim$(formName)) Then
                                storageFolderName = CStr(folderNum)
                                Exit Do
                            End If
                            dPos = dPos + 2 + recLen
                        Loop
                    End If
                End If
                rs.MoveNext
            Loop
            rs.Close
        End If

        formStorageId = -1
        Set rs = m_database.OpenRecordset("SELECT [Id] FROM [MSysAccessStorage] WHERE [ParentId] = " & CStr(formsFolderId) & " AND [Name] = '" & storageFolderName & "';")
        If Err.Number = 0 And Not rs Is Nothing Then
            If Not rs.EOF Then formStorageId = CLng(rs.Fields(0).Value)
            rs.Close
        End If

        If formStorageId <= 0 Then
            On Error GoTo 0
            Exit Function
        End If

        ' Read TypeInfo and Blob streams under formStorageId
        Set rs = m_database.OpenRecordset("SELECT [Name], [Lv] FROM [MSysAccessStorage] WHERE [ParentId] = " & CStr(formStorageId) & ";")
        If Err.Number = 0 And Not rs Is Nothing Then
            Do Until rs.EOF
                Dim vStm As Variant
                vStm = rs.Fields(1).Value
                If UCase$(CStr(rs.Fields(0).Value)) = "TYPEINFO" And Not IsNull(vStm) Then
                    typeBytes = vStm
                ElseIf UCase$(CStr(rs.Fields(0).Value)) = "BLOB" And Not IsNull(vStm) Then
                    blobBytes = vStm
                End If
                rs.MoveNext
            Loop
            rs.Close
        End If
        On Error GoTo 0

        ' Parse TypeInfo controls starting at offset 32
        On Error Resume Next
        maxIdx = -1
        maxIdx = UBound(typeBytes)
        On Error GoTo 0

        If maxIdx >= 40 Then
            pos = 32
            Do While (pos + 8) <= maxIdx
                cType = CLng(typeBytes(pos)) Or (CLng(typeBytes(pos + 1)) * 256&)
                pos = pos + 8
                cName = vbNullString
                Do While pos <= maxIdx
                    If typeBytes(pos) = 0 Then
                        pos = pos + 1
                        Exit Do
                    End If
                    cName = cName & Chr$(typeBytes(pos))
                    pos = pos + 1
                Loop
                ' Double-null terminator after ASCII control name: advance by 1 extra byte
                pos = pos + 1

                If Len(cName) > 0 Then
                    Select Case cType
                        Case &H1898&, &H1899&, &H189A&: cTypeStr = "Section"
                        Case &H126D&: cTypeStr = "TextBox"
                        Case &H0C64&, &H0D64&: cTypeStr = "Label"
                        Case &H0B68&
                            cTypeStr = "CommandButton"
                            If Len(outButtonName) = 0 Then outButtonName = cName
                        Case &H126E&, &H136F&: cTypeStr = "ComboBox"
                        Case &H126F&: cTypeStr = "ListBox"
                        Case Else: cTypeStr = "Control"
                    End Select
                    typeInfoCtrls.Add cTypeStr & "|" & cName
                End If
            Loop
        End If

        ' Layout model from the Blob property stream (Tier 1 parser).
        ResetNativeFormLayout formLayout, Trim$(formName)
        blobParsed = ParseFormBlobProperties(blobBytes, typeBytes, formLayout)

        If blobParsed Then
            ' Real controls of the form ("Type|Name"), in Blob order
            For lIdx = 0 To formLayout.CtlCount - 1
                If Len(formLayout.Ctls(lIdx).CtlName) > 0 Then
                    cTypeStr = formLayout.Ctls(lIdx).CtlType
                    If Len(cTypeStr) = 0 Then cTypeStr = "Control"
                    outControls.Add cTypeStr & "|" & formLayout.Ctls(lIdx).CtlName
                End If
            Next lIdx
            ' RecordSource property of the form; empty means an unbound form
            outRecordSource = Trim$(formLayout.RecordSource)
            m_inspectLayout = formLayout
            m_inspectLayoutValid = True
        Else
            Set outControls = typeInfoCtrls
        End If

        ' Parse Blob UTF-16LE strings to discover the Button Caption (and the
        ' RecordSource only when the Blob property stream could not be parsed)
        Set blobStrings = ExtractUtf16StringsFromBlob(blobBytes)
        Set tblNames = GetTableNames()
        Set qryNames = GetQueryNames()

        For sIdx = 1 To blobStrings.Count
            candStr = CStr(blobStrings(sIdx))
            If Len(outRecordSource) = 0 And Not blobParsed Then
                If CollectionContainsText(tblNames, candStr) Or CollectionContainsText(qryNames, candStr) Or Left$(UCase$(Trim$(candStr)), 7) = "SELECT " Then
                    outRecordSource = candStr
                End If
            End If
            If Len(outButtonName) > 0 And Len(outButtonCaption) = 0 Then
                If UCase$(Trim$(candStr)) = UCase$(Trim$(outButtonName)) And sIdx < blobStrings.Count Then
                    Dim nextStr As String
                    nextStr = CStr(blobStrings(sIdx + 1))
                    If Left$(nextStr, 1) <> "[" Then
                        outButtonCaption = nextStr
                    End If
                End If
            End If
        Next sIdx

        If Len(outButtonName) > 0 And Len(outButtonCaption) = 0 Then
            outButtonCaption = outButtonName
        End If

        ' No "first query / first table" guess: no RecordSource -> unbound form.

        InspectNativeAccessForm = True
    End Function

    ' Single entry point for the native form renderer. Tries, in order:
    '   Tier 1 - Blob property stream ("Blob"); missing properties take Access defaults
    '   Tier 3 - TypeInfo control list stacked vertically ("TypeInfoFallback")
    ' (Tier 2, Access.Application.SaveAsText, was removed by plan7 WS0-A: Studio never
    ' starts msaccess.exe. SaveAsText stays a developer-only oracle in tools/.)
    ' On success outLayout.LayoutSource names the tier that produced the layout.
    ' Before the tiers run, the in-memory cache and then the disk cache
    ' (%LOCALAPPDATA%\OpenAccessStudio\layoutcache, LayoutSource "Cache") are
    ' checked; complete Tier 1 results are stored in both. Cache entries written by
    ' older builds from the SaveAsText fallback are ignored.
    Public Function GetNativeFormLayout(ByVal formName As String, ByRef outLayout As NativeFormLayout, ByRef outErrorMsg As String) As Boolean
        Dim cleanName As String
        Dim cacheKey As String
        Dim cacheIdx As Long
        Dim cacheable As Boolean
        Dim cacheStatus As String

        GetNativeFormLayout = False
        outErrorMsg = vbNullString
        cleanName = Trim$(formName)
        ResetNativeFormLayout outLayout, cleanName
        m_lastLayoutStatus = vbNullString
        m_lastLayoutStatusKey = m_dbPath & "|" & UCase$(cleanName)

        If Len(cleanName) = 0 Then
            outErrorMsg = "No form name specified."
            Exit Function
        End If
        If m_database Is Nothing Then
            outErrorMsg = "No database is open."
            Exit Function
        End If

        ' Layout cache: memory first, then disk. An unreadable file key disables caching.
        cacheKey = BuildLayoutCacheKey(cleanName)
        If Len(cacheKey) > 0 Then
            cacheIdx = FindLayoutCacheEntry(cacheKey)
            If cacheIdx >= 0 Then
                outLayout = m_layoutCache(cacheIdx)
                RestoreBlobDefaults m_layoutCacheDefaults(cacheIdx), outLayout.CtlCount
                m_lastLayoutStatus = m_layoutCacheStatus(cacheIdx)
                GetNativeFormLayout = True
                Exit Function
            End If
            cacheStatus = vbNullString
            If LoadLayoutCache(cleanName, cacheKey, outLayout, cacheStatus) Then
                m_lastLayoutStatus = cacheStatus
                StoreLayoutCacheEntry cacheKey, outLayout, m_lastLayoutStatus
                GetNativeFormLayout = True
                Exit Function
            End If
            ResetNativeFormLayout outLayout, cleanName
        End If

        cacheable = False
        GetNativeFormLayout = ComputeNativeFormLayout(cleanName, outLayout, outErrorMsg, cacheable)
        If GetNativeFormLayout And cacheable And Len(cacheKey) > 0 Then
            StoreLayoutCacheEntry cacheKey, outLayout, m_lastLayoutStatus
            SaveLayoutCache cleanName, cacheKey, outLayout
        End If
    End Function

    ' Runs Tier 1 -> Tier 3 for an open database and a non-empty name.
    ' outCacheable = True only for complete Tier 1 results. An incomplete Tier 1
    ' result is kept (Access defaults for the missing properties) and reported in
    ' the status bar as an approximate layout.
    Private Function ComputeNativeFormLayout(ByVal cleanName As String, ByRef outLayout As NativeFormLayout, ByRef outErrorMsg As String, ByRef outCacheable As Boolean) As Boolean
        Dim tierMsg As String
        Dim allMsgs As String
        Dim blobIncomplete As Boolean
        Dim defaultedCount As Long

        ComputeNativeFormLayout = False
        outCacheable = False
        outErrorMsg = vbNullString
        ResetNativeFormLayout outLayout, cleanName

        ' Tier 1 - Blob property stream
        tierMsg = vbNullString
        blobIncomplete = False
        If TryNativeFormLayoutFromBlob(cleanName, outLayout, tierMsg, blobIncomplete) Then
            outLayout.LayoutSource = "Blob"
            ComputeNativeFormLayout = True
            If Not blobIncomplete Then
                outCacheable = True
                Exit Function
            End If
            defaultedCount = CountBlobDefaultedProperties()
            m_lastLayoutStatus = "Approximate layout: " & CStr(defaultedCount) & " properties defaulted (not stored in the form Blob)."
            Exit Function
        End If
        If Len(tierMsg) > 0 Then allMsgs = allMsgs & "Blob: " & tierMsg & "; "

        ' Tier 3 - TypeInfo fallback (approximate layout, form's own controls only)
        ResetNativeFormLayout outLayout, cleanName
        tierMsg = vbNullString
        If BuildTypeInfoFallbackLayout(cleanName, outLayout, tierMsg) Then
            outLayout.LayoutSource = "TypeInfoFallback"
            m_lastLayoutStatus = "Approximate layout: the form's own controls are stacked from its TypeInfo list (positions and bindings could not be read)."
            ComputeNativeFormLayout = True
            Exit Function
        End If
        If Len(tierMsg) > 0 Then allMsgs = allMsgs & "TypeInfo: " & tierMsg & "; "

        ResetNativeFormLayout outLayout, cleanName
        outErrorMsg = "Could not read the layout of form [" & cleanName & "]."
        If Len(allMsgs) > 0 Then outErrorMsg = outErrorMsg & " " & Trim$(allMsgs)
    End Function

    ' Number of properties of the last parsed Blob layout that took a hard-coded
    ' Access default (form level plus every control).
    Private Function CountBlobDefaultedProperties() As Long
        Dim k As Long
        Dim n As Long
        Dim parts() As String

        n = 0
        If Len(m_blobFormDefaulted) > 0 Then
            parts = Split(m_blobFormDefaulted, ",")
            n = n + UBound(parts) + 1
        End If
        For k = 0 To m_blobDefaultedCount - 1
            If Len(m_blobDefaulted(k)) > 0 Then
                parts = Split(m_blobDefaulted(k), ",")
                n = n + UBound(parts) + 1
            End If
        Next k
        CountBlobDefaultedProperties = n
    End Function

    ' Clears a layout and applies Access form defaults.
    Private Sub ResetNativeFormLayout(ByRef outLayout As NativeFormLayout, ByVal formName As String)
        Dim emptyLayout As NativeFormLayout
        outLayout = emptyLayout
        outLayout.FormName = formName
        outLayout.RecordSource = vbNullString
        outLayout.DefaultView = 0
        outLayout.RecordSelectors = True
        outLayout.NavigationButtons = True
        outLayout.AllowAdditions = True
        outLayout.FormWidthTw = 0
        outLayout.CtlCount = 0
        outLayout.LayoutSource = vbNullString
        outLayout.RightToLeft = False
    End Sub

    ' =====================================================================
    ' Layout cache (task 5.3)
    '   Memory: m_layoutCache()/m_layoutCacheKey(), cleared in CloseDatabase.
    '   Disk:   %LOCALAPPDATA%\OpenAccessStudio\layoutcache\<CRC32>\<form>.layout
    '           (never inside the user database). Only complete Tier 1
    '           results are written; an entry whose key differs is ignored.
    ' Disk format (ASCII, CRLF, tab-separated, fields escaped by EscapeCacheField):
    '   OALAYOUT  1  <key>  <LayoutSource>
    '   FORM  FormName RecordSource DefaultView RecordSelectors NavigationButtons
    '         AllowAdditions FormWidthTw CtlCount FormDefaulted
    '   SECTION  idx present heightTw backColor          (x5, idx 0..4)
    '   CTL   <24 NativeControlDef members in declaration order> Defaulted   (x CtlCount)
    '   END   CtlCount
    ' Mirrored by tools/studio_render_model.py (serialize_layout_cache).
    ' =====================================================================

    Private Sub ClearLayoutCache()
        Erase m_layoutCache
        Erase m_layoutCacheKey
        Erase m_layoutCacheStatus
        Erase m_layoutCacheDefaults
        m_layoutCacheCount = 0
    End Sub

    ' dbPath|formName|fileSize|DateLastModified for the open database ("" when the
    ' file cannot be inspected; caching is then skipped).
    Private Function BuildLayoutCacheKey(ByVal formName As String) As String
        Dim fileSize As Long
        Dim fileStamp As Date
        Dim stampText As String

        BuildLayoutCacheKey = vbNullString
        If Len(m_dbPath) = 0 Then Exit Function
        On Error Resume Next
        fileSize = FileLen(m_dbPath)
        If Err.Number <> 0 Then
            Err.Clear
            On Error GoTo 0
            Exit Function
        End If
        fileStamp = FileDateTime(m_dbPath)
        If Err.Number <> 0 Then
            Err.Clear
            On Error GoTo 0
            Exit Function
        End If
        On Error GoTo 0
        ' Built field by field so the key does not depend on locale separators.
        stampText = CStr(Year(fileStamp)) & "-" & Right$("0" & CStr(Month(fileStamp)), 2) & "-" & Right$("0" & CStr(Day(fileStamp)), 2) & " " & Right$("0" & CStr(Hour(fileStamp)), 2) & ":" & Right$("0" & CStr(Minute(fileStamp)), 2) & ":" & Right$("0" & CStr(Second(fileStamp)), 2)
        BuildLayoutCacheKey = MakeLayoutCacheKey(m_dbPath, formName, CStr(fileSize), stampText)
    End Function

    Public Function MakeLayoutCacheKey(ByVal dbPath As String, ByVal formName As String, ByVal fileSizeText As String, ByVal modifiedText As String) As String
        MakeLayoutCacheKey = UCase$(dbPath) & "|" & UCase$(Trim$(formName)) & "|" & fileSizeText & "|" & modifiedText
    End Function

    Private Function FindLayoutCacheEntry(ByVal cacheKey As String) As Long
        Dim k As Long
        FindLayoutCacheEntry = -1
        For k = 0 To m_layoutCacheCount - 1
            If StrComp(m_layoutCacheKey(k), cacheKey, vbBinaryCompare) = 0 Then
                FindLayoutCacheEntry = k
                Exit Function
            End If
        Next k
    End Function

    Private Sub StoreLayoutCacheEntry(ByVal cacheKey As String, ByRef layout As NativeFormLayout, ByVal statusText As String)
        Dim idx As Long

        idx = FindLayoutCacheEntry(cacheKey)
        If idx < 0 Then
            If m_layoutCacheCount >= LAYOUT_CACHE_MAX Then ClearLayoutCache
            idx = m_layoutCacheCount
            ReDim Preserve m_layoutCache(0 To idx)
            ReDim Preserve m_layoutCacheKey(0 To idx)
            ReDim Preserve m_layoutCacheStatus(0 To idx)
            ReDim Preserve m_layoutCacheDefaults(0 To idx)
            m_layoutCacheCount = idx + 1
        End If
        m_layoutCache(idx) = layout
        m_layoutCacheKey(idx) = cacheKey
        m_layoutCacheStatus(idx) = statusText
        m_layoutCacheDefaults(idx) = CaptureBlobDefaults(layout.CtlCount)
    End Sub

    ' Packs the "defaulted" lists of the last parsed layout: form list, then one
    ' list per control, separated by vbLf (the lists never contain line breaks).
    Private Function CaptureBlobDefaults(ByVal ctlCount As Long) As String
        Dim packed As String
        Dim k As Long

        packed = m_blobFormDefaulted
        For k = 0 To ctlCount - 1
            packed = packed & vbLf
            If k < m_blobDefaultedCount Then packed = packed & m_blobDefaulted(k)
        Next k
        CaptureBlobDefaults = packed
    End Function

    Private Sub RestoreBlobDefaults(ByVal packed As String, ByVal ctlCount As Long)
        Dim parts() As String
        Dim emptyDefaults() As String
        Dim partCount As Long
        Dim k As Long

        m_blobDefaulted = emptyDefaults
        m_blobDefaultedCount = 0
        m_blobFormDefaulted = vbNullString
        parts = Split(packed, vbLf)
        partCount = UBound(parts) + 1
        If partCount > 0 Then m_blobFormDefaulted = parts(0)
        If ctlCount > 0 Then
            ReDim m_blobDefaulted(0 To ctlCount - 1)
            For k = 0 To ctlCount - 1
                If k + 1 < partCount Then m_blobDefaulted(k) = parts(k + 1)
            Next k
            m_blobDefaultedCount = ctlCount
        End If
    End Sub

    ' Standard CRC-32 (poly &HEDB88320, reflected) over the UTF-16LE bytes of the
    ' text. Long arithmetic only: the right shift clears bit 0 first so "\ 2" is
    ' exact on negative values, then masks the sign bit (logical shift).
    Public Function Crc32OfText(ByVal textValue As String) As Long
        Dim crc As Long
        Dim k As Long
        Dim half As Long
        Dim bitNo As Long
        Dim code As Long
        Dim byteVal As Long

        crc = -1
        For k = 1 To Len(textValue)
            code = CLng(AscW(Mid$(textValue, k, 1))) And &HFFFF&
            For half = 0 To 1
                If half = 0 Then
                    byteVal = code And &HFF&
                Else
                    byteVal = (code \ &H100&) And &HFF&
                End If
                crc = crc Xor byteVal
                For bitNo = 1 To 8
                    If (crc And 1&) <> 0 Then
                        crc = (((crc Xor 1&) \ 2&) And &H7FFFFFFF&) Xor CRC32_POLY
                    Else
                        crc = (crc \ 2&) And &H7FFFFFFF&
                    End If
                Next bitNo
            Next half
        Next k
        Crc32OfText = Not crc
    End Function

    ' "<CRC32(UCase(dbPath)) as 8 hex digits>\<sanitized form name>.layout"
    Public Function GetLayoutCacheRelativePath(ByVal dbPath As String, ByVal formName As String) As String
        Dim folderName As String
        Dim fileName As String
        Dim k As Long
        Dim code As Long
        Dim ch As String

        folderName = Right$("00000000" & Hex$(Crc32OfText(UCase$(dbPath))), 8)
        fileName = vbNullString
        For k = 1 To Len(formName)
            ch = Mid$(formName, k, 1)
            code = CLng(AscW(ch)) And &HFFFF&
            If code < 32 Or code > 126 Or InStr(1, "\/:*?""<>|", ch, vbBinaryCompare) > 0 Then
                fileName = fileName & "_"
            Else
                fileName = fileName & ch
            End If
        Next k
        If Len(fileName) = 0 Then fileName = "_"
        GetLayoutCacheRelativePath = PalManager.FS.Combine(folderName, fileName & ".layout")
    End Function

    ' Full disk cache path for a form of the open database; creates the folders
    ' when createDirs is True. "" when %LOCALAPPDATA% is unknown or not writable.
    Private Function GetLayoutCacheFilePath(ByVal formName As String, ByVal createDirs As Boolean) As String
        Dim baseDir As String
        Dim relPath As String
        Dim dirPath As String
        Dim sepPos As Long

        GetLayoutCacheFilePath = vbNullString
        If Len(m_dbPath) = 0 Then Exit Function
        baseDir = PalManager.FS.Combine(PalManager.FS.GetCachePath(), "layoutcache")
        relPath = GetLayoutCacheRelativePath(m_dbPath, formName)

        If createDirs Then
            sepPos = InStr(1, relPath, PalManager.FS.PathSeparator, vbBinaryCompare)
            If sepPos = 0 Then sepPos = InStr(1, relPath, "\", vbBinaryCompare)
            On Error Resume Next
            If Not PalManager.FS.FolderExists(baseDir) Then PalManager.FS.CreateFolder baseDir
            If sepPos > 0 Then
                dirPath = PalManager.FS.Combine(baseDir, Left$(relPath, sepPos - 1))
                If Not PalManager.FS.FolderExists(dirPath) Then PalManager.FS.CreateFolder dirPath
            End If
            If Err.Number <> 0 Then
                Err.Clear
                On Error GoTo 0
                Exit Function
            End If
            On Error GoTo 0
        End If
        GetLayoutCacheFilePath = PalManager.FS.Combine(baseDir, relPath)
    End Function

    ' Disk cache read. False on a missing file, a format error or a key mismatch.
    Private Function LoadLayoutCache(ByVal formName As String, ByVal cacheKey As String, ByRef outLayout As NativeFormLayout, ByRef outStatus As String) As Boolean
        Dim filePath As String
        Dim found As String
        Dim content As String
        Dim readMsg As String
        Dim origin As String
        Dim packed As String
        Dim loaded As NativeFormLayout

        LoadLayoutCache = False
        outStatus = vbNullString
        filePath = GetLayoutCacheFilePath(formName, False)
        If Len(filePath) = 0 Then Exit Function
        On Error Resume Next
        If PalManager.FS.FileExists(filePath) Then found = PalManager.FS.GetFileName(filePath) Else found = ""
        If Err.Number <> 0 Then found = vbNullString
        Err.Clear
        On Error GoTo 0
        If Len(found) = 0 Then Exit Function

        content = ReadSaveAsTextFile(filePath, readMsg)
        If Len(content) = 0 Then Exit Function
        If Not DeserializeNativeFormLayout(content, cacheKey, loaded, origin, packed) Then Exit Function
        ' Only Blob results are trusted: entries that older builds produced with the
        ' removed Access SaveAsText fallback are ignored (plan7 WS0-A).
        If origin <> "Blob" Then Exit Function

        outLayout = loaded
        outLayout.LayoutSource = "Cache"
        RestoreBlobDefaults packed, outLayout.CtlCount
        LoadLayoutCache = True
    End Function

    ' Disk cache write (complete Tier 1 results only). Errors are ignored: the
    ' cache is an optimization. Writes a temp file first, then renames it.
    Private Sub SaveLayoutCache(ByVal formName As String, ByVal cacheKey As String, ByRef layout As NativeFormLayout)
        Dim filePath As String
        Dim tmpPath As String
        Dim content As String
        Dim fNum As Integer

        If layout.LayoutSource <> "Blob" And layout.LayoutSource <> "SaveAsText" Then Exit Sub
        filePath = GetLayoutCacheFilePath(formName, True)
        If Len(filePath) = 0 Then Exit Sub
        content = SerializeNativeFormLayout(layout, cacheKey, CaptureBlobDefaults(layout.CtlCount))
        tmpPath = filePath & ".tmp"

        On Error Resume Next
        If PalManager.FS.FileExists(tmpPath) Then PalManager.FS.DeleteFile tmpPath
        Err.Clear
        fNum = FreeFile
        Open tmpPath For Output As #fNum
        If Err.Number <> 0 Then
            Err.Clear
            On Error GoTo 0
            Exit Sub
        End If
        Print #fNum, content;
        Close #fNum
        If Err.Number <> 0 Then
            Err.Clear
            PalManager.FS.DeleteFile tmpPath
            Err.Clear
            On Error GoTo 0
            Exit Sub
        End If
        If PalManager.FS.FileExists(filePath) Then PalManager.FS.DeleteFile filePath
        Err.Clear
        Name tmpPath As filePath
        If Err.Number <> 0 Then
            Err.Clear
            PalManager.FS.DeleteFile tmpPath
        End If
        Err.Clear
        On Error GoTo 0
    End Sub

    ' Escapes one cache field to printable ASCII: \\ \t \r \n, and \uXXXX for any
    ' other UTF-16 code unit outside 32..126.
    Public Function EscapeCacheField(ByVal value As String) As String
        Dim k As Long
        Dim code As Long
        Dim ch As String
        Dim res As String

        res = vbNullString
        For k = 1 To Len(value)
            ch = Mid$(value, k, 1)
            code = CLng(AscW(ch)) And &HFFFF&
            Select Case code
                Case 92
                    res = res & "\\"
                Case 9
                    res = res & "\t"
                Case 13
                    res = res & "\r"
                Case 10
                    res = res & "\n"
                Case 32 To 126
                    res = res & ch
                Case Else
                    res = res & "\u" & Right$("0000" & Hex$(code), 4)
            End Select
        Next k
        EscapeCacheField = res
    End Function

    ' Reverses EscapeCacheField; sets ok = False on a malformed escape.
    Public Function UnescapeCacheField(ByVal value As String, ByRef ok As Boolean) As String
        Dim k As Long
        Dim n As Long
        Dim j As Long
        Dim d As Long
        Dim code As Long
        Dim ch As String
        Dim nxt As String
        Dim res As String
        Dim bad As Boolean

        res = vbNullString
        bad = False
        n = Len(value)
        k = 1
        Do While k <= n
            ch = Mid$(value, k, 1)
            If ch <> "\" Then
                res = res & ch
                k = k + 1
            Else
                If k = n Then
                    bad = True
                    Exit Do
                End If
                nxt = Mid$(value, k + 1, 1)
                Select Case nxt
                    Case "\"
                        res = res & "\"
                        k = k + 2
                    Case "t"
                        res = res & vbTab
                        k = k + 2
                    Case "r"
                        res = res & vbCr
                        k = k + 2
                    Case "n"
                        res = res & vbLf
                        k = k + 2
                    Case "u"
                        If k + 5 > n Then
                            bad = True
                        Else
                            code = 0
                            For j = 0 To 3
                                d = InStr(1, "0123456789ABCDEF", UCase$(Mid$(value, k + 2 + j, 1)), vbBinaryCompare) - 1
                                If d < 0 Then
                                    bad = True
                                    Exit For
                                End If
                                code = code * 16 + d
                            Next j
                            If Not bad Then res = res & ChrW$(code)
                            k = k + 6
                        End If
                    Case Else
                        bad = True
                End Select
                If bad Then Exit Do
            End If
        Loop
        If bad Then ok = False
        UnescapeCacheField = res
    End Function

    Private Function CacheBoolText(ByVal value As Boolean) As String
        If value Then
            CacheBoolText = "1"
        Else
            CacheBoolText = "0"
        End If
    End Function

    Private Function CacheFieldBool(ByVal value As String, ByRef ok As Boolean) As Boolean
        CacheFieldBool = False
        If value = "1" Then
            CacheFieldBool = True
        ElseIf value <> "0" Then
            ok = False
        End If
    End Function

    ' Optional "-" then 1..10 digits, within the Long range; else ok = False.
    Private Function CacheFieldLong(ByVal value As String, ByRef ok As Boolean) As Long
        Dim digits As String
        Dim k As Long
        Dim ch As String

        CacheFieldLong = 0
        digits = value
        If Left$(digits, 1) = "-" Then digits = Mid$(digits, 2)
        If Len(digits) = 0 Or Len(digits) > 10 Then
            ok = False
            Exit Function
        End If
        For k = 1 To Len(digits)
            ch = Mid$(digits, k, 1)
            If ch < "0" Or ch > "9" Then
                ok = False
                Exit Function
            End If
        Next k
        On Error Resume Next
        CacheFieldLong = CLng(value)
        If Err.Number <> 0 Then
            Err.Clear
            ok = False
            CacheFieldLong = 0
        End If
        On Error GoTo 0
    End Function

    ' Serializes a layout for the disk cache. packedDefaults is the vbLf-packed
    ' "defaulted" lists (form first, then one per control) from CaptureBlobDefaults.
    Public Function SerializeNativeFormLayout(ByRef layout As NativeFormLayout, ByVal cacheKey As String, ByVal packedDefaults As String) As String
        Dim s As String
        Dim parts() As String
        Dim partCount As Long
        Dim formDefaulted As String
        Dim ctlDefaulted As String
        Dim k As Long
        Dim ctlLine As String

        parts = Split(packedDefaults, vbLf)
        partCount = UBound(parts) + 1
        formDefaulted = vbNullString
        If partCount > 0 Then formDefaulted = parts(0)

        s = LAYOUT_CACHE_MAGIC & vbTab & LAYOUT_CACHE_VERSION & vbTab & EscapeCacheField(cacheKey) & vbTab & EscapeCacheField(layout.LayoutSource) & vbCrLf
        s = s & "FORM" & vbTab & EscapeCacheField(layout.FormName) & vbTab & EscapeCacheField(layout.RecordSource) & vbTab & CStr(layout.DefaultView) & vbTab & CacheBoolText(layout.RecordSelectors) & vbTab & CacheBoolText(layout.NavigationButtons) & vbTab & CacheBoolText(layout.AllowAdditions) & vbTab & CStr(layout.FormWidthTw) & vbTab & CStr(layout.CtlCount) & vbTab & EscapeCacheField(formDefaulted) & vbCrLf
        For k = 0 To 4
            s = s & "SECTION" & vbTab & CStr(k) & vbTab & CacheBoolText(layout.SectionPresent(k)) & vbTab & CStr(layout.SectionHeightTw(k)) & vbTab & CStr(layout.SectionBackColor(k)) & vbCrLf
        Next k
        For k = 0 To layout.CtlCount - 1
            ctlDefaulted = vbNullString
            If k + 1 < partCount Then ctlDefaulted = parts(k + 1)
            With layout.Ctls(k)
                ctlLine = "CTL" & vbTab & EscapeCacheField(.CtlType) & vbTab & EscapeCacheField(.CtlName) & vbTab & CStr(.Section) & vbTab & CStr(.LeftTw) & vbTab & CStr(.TopTw) & vbTab & CStr(.WidthTw) & vbTab & CStr(.HeightTw) & vbTab & EscapeCacheField(.Caption) & vbTab & EscapeCacheField(.ControlSource) & vbTab & EscapeCacheField(.RowSource) & vbTab & CStr(.BoundColumn) & vbTab & EscapeCacheField(.ColumnWidths) & vbTab & CStr(.ColumnCount) & vbTab & EscapeCacheField(.SourceObject) & vbTab & EscapeCacheField(.LinkMaster) & vbTab & EscapeCacheField(.LinkChild) & vbTab & EscapeCacheField(.OnClick) & vbTab & EscapeCacheField(.ParentLabelOf) & vbTab & CStr(.BackColor) & vbTab & CStr(.ForeColor) & vbTab & EscapeCacheField(.FontName) & vbTab & CStr(.FontSize) & vbTab & CacheBoolText(.FontBold) & vbTab & CacheBoolText(.Visible) & vbTab & EscapeCacheField(ctlDefaulted)
            End With
            s = s & ctlLine & vbCrLf
        Next k
        s = s & "END" & vbTab & CStr(layout.CtlCount) & vbCrLf
        SerializeNativeFormLayout = s
    End Function

    ' Parses SerializeNativeFormLayout output. False on any format error or when
    ' the stored key differs from expectedKey (outLayout is then left unchanged).
    Public Function DeserializeNativeFormLayout(ByVal content As String, ByVal expectedKey As String, ByRef outLayout As NativeFormLayout, ByRef outOrigin As String, ByRef outPackedDefaults As String) As Boolean
        Dim lines() As String
        Dim f() As String
        Dim lineCount As Long
        Dim li As Long
        Dim ok As Boolean
        Dim tmp As NativeFormLayout
        Dim ctl As NativeControlDef
        Dim emptyCtl As NativeControlDef
        Dim ctlCount As Long
        Dim ctlIdx As Long
        Dim secIdx As Long
        Dim packed As String
        Dim origin As String
        Dim sawForm As Boolean
        Dim sawEnd As Boolean
        Dim endCount As Long

        DeserializeNativeFormLayout = False
        outOrigin = vbNullString
        outPackedDefaults = vbNullString
        ok = True
        lines = Split(Replace(content, vbCr, vbNullString), vbLf)
        lineCount = UBound(lines) + 1
        If lineCount < 8 Then Exit Function

        f = Split(lines(0), vbTab)
        If UBound(f) <> 3 Then Exit Function
        If f(0) <> LAYOUT_CACHE_MAGIC Or f(1) <> LAYOUT_CACHE_VERSION Then Exit Function
        If StrComp(UnescapeCacheField(f(2), ok), expectedKey, vbBinaryCompare) <> 0 Or Not ok Then Exit Function
        origin = UnescapeCacheField(f(3), ok)
        If Not ok Then Exit Function

        ResetNativeFormLayout tmp, vbNullString
        sawForm = False
        sawEnd = False
        ctlIdx = 0
        ctlCount = 0
        For li = 1 To lineCount - 1
            If Len(lines(li)) = 0 Then
                ' blank line (trailing CRLF) - ignored
            ElseIf sawEnd Then
                Exit Function
            Else
                f = Split(lines(li), vbTab)
                Select Case f(0)
                    Case "FORM"
                        If sawForm Or UBound(f) <> LAYOUT_CACHE_FORM_FIELDS - 1 Then Exit Function
                        tmp.FormName = UnescapeCacheField(f(1), ok)
                        tmp.RecordSource = UnescapeCacheField(f(2), ok)
                        tmp.DefaultView = CacheFieldLong(f(3), ok)
                        tmp.RecordSelectors = CacheFieldBool(f(4), ok)
                        tmp.NavigationButtons = CacheFieldBool(f(5), ok)
                        tmp.AllowAdditions = CacheFieldBool(f(6), ok)
                        tmp.FormWidthTw = CacheFieldLong(f(7), ok)
                        ctlCount = CacheFieldLong(f(8), ok)
                        packed = UnescapeCacheField(f(9), ok)
                        If Not ok Or ctlCount < 0 Or ctlCount > lineCount Then Exit Function
                        If ctlCount > 0 Then ReDim tmp.Ctls(0 To ctlCount - 1)
                        tmp.CtlCount = ctlCount
                        sawForm = True
                    Case "SECTION"
                        If UBound(f) <> 4 Then Exit Function
                        secIdx = CacheFieldLong(f(1), ok)
                        If Not ok Or secIdx < 0 Or secIdx > 4 Then Exit Function
                        tmp.SectionPresent(secIdx) = CacheFieldBool(f(2), ok)
                        tmp.SectionHeightTw(secIdx) = CacheFieldLong(f(3), ok)
                        tmp.SectionBackColor(secIdx) = CacheFieldLong(f(4), ok)
                    Case "CTL"
                        If Not sawForm Or ctlIdx >= ctlCount Or UBound(f) <> LAYOUT_CACHE_CTL_FIELDS - 1 Then Exit Function
                        ctl = emptyCtl
                        ctl.CtlType = UnescapeCacheField(f(1), ok)
                        ctl.CtlName = UnescapeCacheField(f(2), ok)
                        ctl.Section = CacheFieldLong(f(3), ok)
                        ctl.LeftTw = CacheFieldLong(f(4), ok)
                        ctl.TopTw = CacheFieldLong(f(5), ok)
                        ctl.WidthTw = CacheFieldLong(f(6), ok)
                        ctl.HeightTw = CacheFieldLong(f(7), ok)
                        ctl.Caption = UnescapeCacheField(f(8), ok)
                        ctl.ControlSource = UnescapeCacheField(f(9), ok)
                        ctl.RowSource = UnescapeCacheField(f(10), ok)
                        ctl.BoundColumn = CacheFieldLong(f(11), ok)
                        ctl.ColumnWidths = UnescapeCacheField(f(12), ok)
                        ctl.ColumnCount = CacheFieldLong(f(13), ok)
                        ctl.SourceObject = UnescapeCacheField(f(14), ok)
                        ctl.LinkMaster = UnescapeCacheField(f(15), ok)
                        ctl.LinkChild = UnescapeCacheField(f(16), ok)
                        ctl.OnClick = UnescapeCacheField(f(17), ok)
                        ctl.ParentLabelOf = UnescapeCacheField(f(18), ok)
                        ctl.BackColor = CacheFieldLong(f(19), ok)
                        ctl.ForeColor = CacheFieldLong(f(20), ok)
                        ctl.FontName = UnescapeCacheField(f(21), ok)
                        ctl.FontSize = CacheFieldLong(f(22), ok)
                        ctl.FontBold = CacheFieldBool(f(23), ok)
                        ctl.Visible = CacheFieldBool(f(24), ok)
                        packed = packed & vbLf & UnescapeCacheField(f(25), ok)
                        If Not ok Then Exit Function
                        tmp.Ctls(ctlIdx) = ctl
                        ctlIdx = ctlIdx + 1
                    Case "END"
                        If Not sawForm Or UBound(f) <> 1 Then Exit Function
                        endCount = CacheFieldLong(f(1), ok)
                        If Not ok Or endCount <> ctlCount Or ctlIdx <> ctlCount Then Exit Function
                        sawEnd = True
                    Case Else
                        Exit Function
                End Select
                If Not ok Then Exit Function
            End If
        Next li
        If Not sawEnd Then Exit Function

        tmp.LayoutSource = origin
        outLayout = tmp
        outOrigin = origin
        outPackedDefaults = packed
        DeserializeNativeFormLayout = True
    End Function

    ' Tier 1 - Blob property stream parser wrapper.
    ' outIncomplete = True when the layout is approximate (see BlobLayoutIsIncomplete).
    Private Function TryNativeFormLayoutFromBlob(ByVal formName As String, ByRef outLayout As NativeFormLayout, ByRef outErrorMsg As String, ByRef outIncomplete As Boolean) As Boolean
        Dim typeBytes() As Byte
        Dim blobBytes() As Byte
        Dim readMsg As String

        TryNativeFormLayoutFromBlob = False
        outErrorMsg = vbNullString
        outIncomplete = False

        If Not ReadNativeFormStreams(formName, typeBytes, blobBytes, readMsg) Then
            outErrorMsg = readMsg
            Exit Function
        End If

        If ParseFormBlobProperties(blobBytes, typeBytes, outLayout) Then
            TryNativeFormLayoutFromBlob = True
            outIncomplete = BlobLayoutIsIncomplete(blobBytes, outLayout)
        Else
            outErrorMsg = "The form Blob holds no sections or controls."
        End If
    End Function

    ' Approximate-layout check. True when a visible control took a hard-coded default for
    ' Left/Top/Width/Height, or when the layout has no RecordSource although a
    ' Blob string names a table/query (or holds SELECT SQL) that no control uses.
    ' DefaultView is not checked: a missing DefaultView record is the normal
    ' encoding of the stored default (Customers form), not missing data.
    Private Function BlobLayoutIsIncomplete(ByRef blobBytes() As Byte, ByRef layout As NativeFormLayout) As Boolean
        Dim k As Long
        Dim d As String
        Dim blobStrings As Collection
        Dim itemVal As Variant
        Dim s As String
        Dim usedByControl As Boolean

        BlobLayoutIsIncomplete = False

        For k = 0 To layout.CtlCount - 1
            If layout.Ctls(k).Visible And k < m_blobDefaultedCount Then
                d = "," & m_blobDefaulted(k) & ","
                If InStr(1, d, ",Left,", vbBinaryCompare) > 0 Or InStr(1, d, ",Top,", vbBinaryCompare) > 0 Or InStr(1, d, ",Width,", vbBinaryCompare) > 0 Or InStr(1, d, ",Height,", vbBinaryCompare) > 0 Then
                    BlobLayoutIsIncomplete = True
                    Exit Function
                End If
            End If
        Next k

        If Len(Trim$(layout.RecordSource)) > 0 Then Exit Function

        Set blobStrings = ExtractUtf16StringsFromBlob(blobBytes)
        If blobStrings Is Nothing Then Exit Function
        For Each itemVal In blobStrings
            s = Trim$(CStr(itemVal))
            If Len(s) > 0 Then
                usedByControl = False
                For k = 0 To layout.CtlCount - 1
                    If StrComp(s, layout.Ctls(k).RowSource, vbTextCompare) = 0 Or StrComp(s, layout.Ctls(k).ControlSource, vbTextCompare) = 0 Or StrComp(s, layout.Ctls(k).SourceObject, vbTextCompare) = 0 Or StrComp(s, layout.Ctls(k).CtlName, vbTextCompare) = 0 Or StrComp(s, layout.Ctls(k).Caption, vbTextCompare) = 0 Then
                        usedByControl = True
                        Exit For
                    End If
                Next k
                If Not usedByControl Then
                    If UCase$(Left$(s, 7)) = "SELECT " Or DatabaseHasTableOrQuery(s) Then
                        BlobLayoutIsIncomplete = True
                        Exit Function
                    End If
                End If
            End If
        Next itemVal
    End Function

    ' True when the open database has a TableDef or QueryDef with this name.
    Private Function DatabaseHasTableOrQuery(ByVal objName As String) As Boolean
        Dim probe As Object

        DatabaseHasTableOrQuery = False
        If m_database Is Nothing Or Len(objName) = 0 Or Len(objName) > 64 Then Exit Function
        On Error Resume Next
        Set probe = m_database.TableDefs(objName)
        If Err.Number = 0 And Not probe Is Nothing Then DatabaseHasTableOrQuery = True
        Err.Clear
        If Not DatabaseHasTableOrQuery Then
            Set probe = Nothing
            Set probe = m_database.QueryDefs(objName)
            If Err.Number = 0 And Not probe Is Nothing Then DatabaseHasTableOrQuery = True
            Err.Clear
        End If
        Set probe = Nothing
        On Error GoTo 0
    End Function

    ' Reads the TypeInfo and Blob streams of a native form from MSysAccessStorage
    ' (same DirData walk as InspectNativeAccessForm, which stays unchanged).
    Private Function ReadNativeFormStreams(ByVal formName As String, ByRef outTypeBytes() As Byte, ByRef outBlobBytes() As Byte, ByRef outErrorMsg As String) As Boolean
        Dim rs As Object
        Dim formsFolderId As Long
        Dim formStorageId As Long
        Dim storageFolderName As String
        Dim dirBytes() As Byte
        Dim vVal As Variant
        Dim dMax As Long
        Dim dPos As Long
        Dim recLen As Long
        Dim nameBytesLen As Long
        Dim chIdx As Long
        Dim entryName As String
        Dim streamName As String
        Dim hasBlob As Boolean
        Dim emptyBytes() As Byte

        ReadNativeFormStreams = False
        outErrorMsg = vbNullString
        outTypeBytes = emptyBytes
        outBlobBytes = emptyBytes
        hasBlob = False
        formsFolderId = -1
        formStorageId = -1
        storageFolderName = vbNullString

        If m_database Is Nothing Or Len(Trim$(formName)) = 0 Then
            outErrorMsg = "No database is open."
            Exit Function
        End If

        On Error Resume Next
        Set rs = m_database.OpenRecordset("SELECT [Id] FROM [MSysAccessStorage] WHERE [Name] = 'Forms';")
        If Err.Number = 0 And Not rs Is Nothing Then
            If Not rs.EOF Then formsFolderId = CLng(rs.Fields(0).Value)
            rs.Close
        End If
        Err.Clear
        Set rs = Nothing

        If formsFolderId <= 0 Then
            On Error GoTo 0
            outErrorMsg = "MSysAccessStorage has no Forms folder."
            Exit Function
        End If

        Set rs = m_database.OpenRecordset("SELECT [Name], [Lv] FROM [MSysAccessStorage] WHERE [ParentId] = " & CStr(formsFolderId) & ";")
        If Err.Number = 0 And Not rs Is Nothing Then
            Do Until rs.EOF
                If InStr(1, CStr(rs.Fields(0).Value), "DirData", vbTextCompare) > 0 Then
                    vVal = rs.Fields(1).Value
                    If Not IsNull(vVal) Then
                        dirBytes = vVal
                        dMax = UBound(dirBytes)
                        dPos = 4
                        Do While (dPos + 5) <= dMax
                            recLen = CLng(dirBytes(dPos + 1))
                            If recLen <= 4 Or (dPos + 1 + recLen) > dMax Then Exit Do
                            nameBytesLen = recLen - 4
                            entryName = vbNullString
                            For chIdx = 0 To (nameBytesLen \ 2) - 1
                                entryName = entryName & Chr$(dirBytes(dPos + 2 + (chIdx * 2)))
                            Next chIdx
                            If UCase$(Trim$(entryName)) = UCase$(Trim$(formName)) Then
                                storageFolderName = CStr(CLng(dirBytes(dPos + 2 + nameBytesLen)))
                                Exit Do
                            End If
                            dPos = dPos + 2 + recLen
                        Loop
                    End If
                End If
                rs.MoveNext
            Loop
            rs.Close
        End If
        Err.Clear
        Set rs = Nothing

        If Len(storageFolderName) = 0 Then
            On Error GoTo 0
            outErrorMsg = "Form [" & formName & "] is not listed in DirData."
            Exit Function
        End If

        Set rs = m_database.OpenRecordset("SELECT [Id] FROM [MSysAccessStorage] WHERE [ParentId] = " & CStr(formsFolderId) & " AND [Name] = '" & storageFolderName & "';")
        If Err.Number = 0 And Not rs Is Nothing Then
            If Not rs.EOF Then formStorageId = CLng(rs.Fields(0).Value)
            rs.Close
        End If
        Err.Clear
        Set rs = Nothing

        If formStorageId <= 0 Then
            On Error GoTo 0
            outErrorMsg = "Storage folder of form [" & formName & "] not found."
            Exit Function
        End If

        Set rs = m_database.OpenRecordset("SELECT [Name], [Lv] FROM [MSysAccessStorage] WHERE [ParentId] = " & CStr(formStorageId) & ";")
        If Err.Number = 0 And Not rs Is Nothing Then
            Do Until rs.EOF
                streamName = UCase$(CStr(rs.Fields(0).Value))
                vVal = rs.Fields(1).Value
                If Not IsNull(vVal) Then
                    If streamName = "TYPEINFO" Then
                        outTypeBytes = vVal
                    ElseIf streamName = "BLOB" Then
                        outBlobBytes = vVal
                        hasBlob = True
                    End If
                End If
                rs.MoveNext
            Loop
            rs.Close
        End If
        Err.Clear
        On Error GoTo 0

        If Not hasBlob Then
            outErrorMsg = "Form [" & formName & "] has no Blob stream."
            Exit Function
        End If
        ReadNativeFormStreams = True
    End Function

    ' =====================================================================
    ' Form Blob property parser (Tier 1). Python mirror:
    ' tools/studio_render_model.py parse_form_blob_properties.
    '
    ' The Blob is a tree of objects (form -> type templates / sections ->
    ' controls -> attached labels):
    '   bytes 0..7 header, u16 at 8 = root type (&H96 Form), records from 10
    '   record: [u32 ordinal][u16 propId][u32 dataType][u32 maxSize][u32 byteLen][data]
    '   &HFF marker: [u32 FF][u16 childCount][u16 firstChildType]
    '   &HFE marker: [u32 FE][u16 childType]   (exactly one child)
    '   &HFD marker: [u32 FD] ends the current object; when the parent expects
    '                more children the next sibling's [u16 type] follows.
    ' A parent has no records after its children, so an object is complete
    ' when its first child starts. Inside one object the records are sorted by
    ' ordinal: Left/Top/Width/Height come right before Name, Caption/OnClick
    ' follow it; all of them belong to that object.
    ' Every propId was confirmed by tools/form_layout_oracle.py (task 4.2).
    ' =====================================================================

    ' Returns the defaulted property names of control ctlIndex of the last
    ' Blob layout, or of the form itself when ctlIndex < 0.
    Public Function GetLastBlobLayoutDefaults(ByVal ctlIndex As Long) As String
        GetLastBlobLayoutDefaults = vbNullString
        If ctlIndex < 0 Then
            GetLastBlobLayoutDefaults = m_blobFormDefaulted
        ElseIf ctlIndex < m_blobDefaultedCount Then
            GetLastBlobLayoutDefaults = m_blobDefaulted(ctlIndex)
        End If
    End Function

    ' The single propId table. Returns the scratch slot (-1 = not used) and its kind.
    Private Function BlobPropSlot(ByVal propId As Long, ByRef outKind As Long) As Long
        outKind = SLOT_KIND_INT
        Select Case propId
            Case &H14&: BlobPropSlot = SLOT_NAME: outKind = SLOT_KIND_TEXT
            Case &H11&: BlobPropSlot = SLOT_CAPTION: outKind = SLOT_KIND_TEXT
            Case &H1B&: BlobPropSlot = SLOT_CONTROL_SOURCE: outKind = SLOT_KIND_TEXT
            Case &H5B&: BlobPropSlot = SLOT_ROW_SOURCE: outKind = SLOT_KIND_TEXT
            Case &H12&: BlobPropSlot = SLOT_COLUMN_WIDTHS: outKind = SLOT_KIND_TEXT
            Case &H84&: BlobPropSlot = SLOT_SOURCE_OBJECT: outKind = SLOT_KIND_TEXT
            Case &H32&: BlobPropSlot = SLOT_LINK_MASTER: outKind = SLOT_KIND_TEXT
            Case &H31&: BlobPropSlot = SLOT_LINK_CHILD: outKind = SLOT_KIND_TEXT
            Case &H7E&: BlobPropSlot = SLOT_ON_CLICK: outKind = SLOT_KIND_TEXT
            Case &H9C&: BlobPropSlot = SLOT_RECORD_SOURCE: outKind = SLOT_KIND_TEXT
            Case &H22&: BlobPropSlot = SLOT_FONT_NAME: outKind = SLOT_KIND_TEXT
            Case &H36&: BlobPropSlot = SLOT_LEFT
            Case &H8D&: BlobPropSlot = SLOT_TOP
            Case &H96&: BlobPropSlot = SLOT_WIDTH
            Case &H2C&: BlobPropSlot = SLOT_HEIGHT
            Case &HD&: BlobPropSlot = SLOT_BOUND_COLUMN      ' stored zero-based
            Case &H46&: BlobPropSlot = SLOT_COLUMN_COUNT
            Case &H93&: BlobPropSlot = SLOT_DEFAULT_VIEW
            Case &H1C&: BlobPropSlot = SLOT_BACK_COLOR       ' controls and sections
            Case &HCC&: BlobPropSlot = SLOT_FORE_COLOR
            Case &H23&: BlobPropSlot = SLOT_FONT_SIZE
            Case &H25&: BlobPropSlot = SLOT_FONT_WEIGHT
            Case &H24A&: BlobPropSlot = SLOT_CACHED_LEFT     ' LayoutCachedLeft
            Case &H24B&: BlobPropSlot = SLOT_CACHED_TOP      ' LayoutCachedTop
            Case &H24C&: BlobPropSlot = SLOT_CACHED_RIGHT    ' LayoutCachedWidth = right edge
            Case &H24D&: BlobPropSlot = SLOT_CACHED_BOTTOM   ' LayoutCachedHeight = bottom edge
            Case &H13&: BlobPropSlot = SLOT_RECORD_SELECTORS: outKind = SLOT_KIND_BOOL
            Case &H117&: BlobPropSlot = SLOT_NAVIGATION_BUTTONS: outKind = SLOT_KIND_BOOL
            Case &H146&: BlobPropSlot = SLOT_ALLOW_ADDITIONS: outKind = SLOT_KIND_BOOL
            Case &H13B&, &H16A&: BlobPropSlot = SLOT_RIGHT_TO_LEFT: outKind = SLOT_KIND_BOOL
            Case Else: BlobPropSlot = -1
        End Select
    End Function

    Private Function BlobU16(ByRef b() As Byte, ByVal p As Long) As Long
        BlobU16 = CLng(b(p)) Or (CLng(b(p + 1)) << 8)
    End Function

    ' u32 at p, saturated to &H7FFFFFFF when the top bit is set (callers only
    ' compare it with small limits, so a Long never overflows).
    Private Function BlobU32(ByRef b() As Byte, ByVal p As Long) As Long
        If (CLng(b(p + 3)) And &H80&) <> 0 Then
            BlobU32 = &H7FFFFFFF&
        Else
            BlobU32 = CLng(b(p)) Or (CLng(b(p + 1)) << 8) Or (CLng(b(p + 2)) << 16) Or (CLng(b(p + 3)) << 24)
        End If
    End Function

    Private Function BlobIsKnownDataType(ByVal dataType As Long) As Boolean
        BlobIsKnownDataType = (dataType >= 1 And dataType <= 12)   ' Bool .. Memo
    End Function

    Private Function BlobPlausibleRecord(ByRef b() As Byte, ByVal p As Long, ByVal n As Long) As Boolean
        Dim ordinal As Long
        Dim dataType As Long
        Dim maxSize As Long
        Dim byteLen As Long

        BlobPlausibleRecord = False
        If p < 0 Or p + BLOB_RECORD_HEADER > n Then Exit Function
        ordinal = BlobU32(b, p)
        dataType = BlobU32(b, p + 6)
        maxSize = BlobU32(b, p + 10)
        byteLen = BlobU32(b, p + 14)
        If ordinal >= &H1000& Then Exit Function
        If Not BlobIsKnownDataType(dataType) Then Exit Function
        If maxSize > &H100000& Then Exit Function
        If byteLen > n - p - BLOB_RECORD_HEADER Then Exit Function
        BlobPlausibleRecord = True
    End Function

    Private Function BlobIsMarker(ByVal v As Long) As Boolean
        BlobIsMarker = (v = BLOB_MARK_CHILDREN Or v = BLOB_MARK_ONE_CHILD Or v = BLOB_MARK_NEXT_OR_END)
    End Function

    ' Signed value of a 1/2/4-byte integer record.
    Private Function BlobIntValue(ByRef b() As Byte, ByVal p As Long, ByVal byteLen As Long, ByRef outOk As Boolean) As Long
        Dim v As Long

        outOk = True
        v = 0
        Select Case byteLen
            Case 1
                v = CLng(b(p))
            Case 2
                v = CLng(b(p)) Or (CLng(b(p + 1)) << 8)
                If (v And &H8000&) <> 0 Then v = v - &H10000&
            Case 4
                v = CLng(b(p)) Or (CLng(b(p + 1)) << 8) Or (CLng(b(p + 2)) << 16) Or ((CLng(b(p + 3)) And &H7F&) << 24)
                If (CLng(b(p + 3)) And &H80&) <> 0 Then v = v - 2147483647 - 1
            Case Else
                outOk = False
        End Select
        BlobIntValue = v
    End Function

    Private Function BlobTextValue(ByRef b() As Byte, ByVal p As Long, ByVal byteLen As Long) As String
        Dim k As Long
        Dim s As String

        s = vbNullString
        For k = 0 To (byteLen \ 2) - 1
            s = s & ChrW$(CLng(b(p + 2 * k)) Or (CLng(b(p + 2 * k + 1)) << 8))
        Next k
        BlobTextValue = s
    End Function

    ' Stores one record of the current object in its scratch slot.
    Private Sub BlobApplyRecord(ByRef scr As BlobObjScratch, ByRef b() As Byte, ByVal p As Long, ByVal propId As Long, ByVal dataType As Long, ByVal byteLen As Long)
        Dim slot As Long
        Dim slotKind As Long
        Dim v As Long
        Dim ok As Boolean

        slot = BlobPropSlot(propId, slotKind)
        If slot < 0 Then Exit Sub
        Select Case slotKind
            Case SLOT_KIND_TEXT
                If dataType = 10 Or dataType = 12 Then
                    scr.TextVal(slot) = BlobTextValue(b, p, byteLen)
                    scr.Has(slot) = True
                End If
            Case SLOT_KIND_BOOL
                If dataType = 1 Then
                    ' Zero length = "NotDefault" flag; every Bool read here defaults to True.
                    If byteLen = 0 Then
                        scr.IntVal(slot) = 0
                    ElseIf b(p) <> 0 Then
                        scr.IntVal(slot) = 1
                    Else
                        scr.IntVal(slot) = 0
                    End If
                    scr.Has(slot) = True
                End If
            Case SLOT_KIND_INT
                If dataType >= 2 And dataType <= 4 Then
                    v = BlobIntValue(b, p, byteLen, ok)
                    If ok Then
                        scr.IntVal(slot) = v
                        scr.Has(slot) = True
                    End If
                End If
        End Select
    End Sub

    ' Access ControlType constant -> type name ("" when not a control type).
    Private Function AccessControlTypeName(ByVal code As Long) As String
        Select Case code
            Case 100: AccessControlTypeName = "Label"
            Case 101: AccessControlTypeName = "Rectangle"
            Case 102: AccessControlTypeName = "Line"
            Case 103: AccessControlTypeName = "Image"
            Case 104: AccessControlTypeName = "CommandButton"
            Case 105: AccessControlTypeName = "OptionButton"
            Case 106: AccessControlTypeName = "CheckBox"
            Case 107: AccessControlTypeName = "OptionGroup"
            Case 108: AccessControlTypeName = "BoundObjectFrame"
            Case 109: AccessControlTypeName = "TextBox"
            Case 110: AccessControlTypeName = "ListBox"
            Case 111: AccessControlTypeName = "ComboBox"
            Case 112: AccessControlTypeName = "Subform"
            Case 114: AccessControlTypeName = "ObjectFrame"
            Case 118: AccessControlTypeName = "PageBreak"
            Case 119: AccessControlTypeName = "CustomControl"
            Case 122: AccessControlTypeName = "ToggleButton"
            Case 123: AccessControlTypeName = "TabCtl"
            Case 124: AccessControlTypeName = "Page"
            Case 126: AccessControlTypeName = "Attachment"
            Case 127: AccessControlTypeName = "EmptyCell"
            Case 128: AccessControlTypeName = "WebBrowser"
            Case 129: AccessControlTypeName = "NavigationControl"
            Case 130: AccessControlTypeName = "NavigationButton"
            Case 131: AccessControlTypeName = "Chart"
            Case 132: AccessControlTypeName = "Edge"
            Case Else: AccessControlTypeName = vbNullString
        End Select
    End Function

    ' Blob section object type -> section index (-1 = not a section).
    ' &H98/&H99/&H9A confirmed by the oracle; &H9B/&H9C (page header/footer) assumed.
    Private Function BlobSectionIndex(ByVal typeCode As Long) As Long
        Select Case typeCode
            Case &H98&: BlobSectionIndex = 0
            Case &H99&: BlobSectionIndex = 1
            Case &H9A&: BlobSectionIndex = 2
            Case &H9B&: BlobSectionIndex = 3
            Case &H9C&: BlobSectionIndex = 4
            Case Else: BlobSectionIndex = -1
        End Select
    End Function

    Private Function InferBlobControlType(ByRef scr As BlobObjScratch) As String
        If scr.Has(SLOT_SOURCE_OBJECT) And Len(scr.TextVal(SLOT_SOURCE_OBJECT)) > 0 Then
            InferBlobControlType = "Subform"
        ElseIf Len(scr.TextVal(SLOT_ROW_SOURCE)) > 0 And Len(scr.TextVal(SLOT_COLUMN_WIDTHS)) > 0 Then
            InferBlobControlType = "ComboBox"
        ElseIf Len(scr.TextVal(SLOT_ON_CLICK)) > 0 And Len(scr.TextVal(SLOT_CAPTION)) > 0 And Len(scr.TextVal(SLOT_CONTROL_SOURCE)) = 0 Then
            InferBlobControlType = "CommandButton"
        ElseIf Len(scr.TextVal(SLOT_CONTROL_SOURCE)) > 0 Then
            InferBlobControlType = "TextBox"
        ElseIf Len(scr.TextVal(SLOT_CAPTION)) > 0 Then
            InferBlobControlType = "Label"
        Else
            InferBlobControlType = "Unknown"
        End If
    End Function

    Private Sub AppendDefaulted(ByRef listText As String, ByVal propName As String)
        If Len(listText) > 0 Then listText = listText & ","
        listText = listText & propName
    End Sub

    ' Geometry: own record -> LayoutCached rectangle -> type template -> Access default (flagged).
    Private Function BlobGeometry(ByRef scr As BlobObjScratch, ByRef tpl As BlobObjScratch, ByVal hasTpl As Boolean, ByVal slot As Long, ByVal cachedSlot As Long, ByVal baseSlot As Long, ByVal typeDefault As Long, ByRef defaultedList As String, ByVal propName As String) As Long
        If scr.Has(slot) Then
            BlobGeometry = scr.IntVal(slot)
            Exit Function
        End If
        If scr.Has(cachedSlot) Then
            If baseSlot < 0 Then
                BlobGeometry = scr.IntVal(cachedSlot)
                Exit Function
            End If
            If scr.Has(baseSlot) Then
                BlobGeometry = scr.IntVal(cachedSlot) - scr.IntVal(baseSlot)
                Exit Function
            End If
        End If
        If hasTpl Then
            If tpl.Has(slot) Then
                BlobGeometry = tpl.IntVal(slot)
                Exit Function
            End If
        End If
        AppendDefaulted defaultedList, propName
        BlobGeometry = typeDefault
    End Function

    ' Integer style property: own record -> type template -> Access default (flagged).
    Private Function BlobPickInt(ByRef scr As BlobObjScratch, ByRef tpl As BlobObjScratch, ByVal hasTpl As Boolean, ByVal slot As Long, ByVal fallback As Long, ByRef defaultedList As String, ByVal propName As String) As Long
        If scr.Has(slot) Then
            BlobPickInt = scr.IntVal(slot)
            Exit Function
        End If
        If hasTpl Then
            If tpl.Has(slot) Then
                BlobPickInt = tpl.IntVal(slot)
                Exit Function
            End If
        End If
        AppendDefaulted defaultedList, propName
        BlobPickInt = fallback
    End Function

    Private Function BlobPickText(ByRef scr As BlobObjScratch, ByRef tpl As BlobObjScratch, ByVal hasTpl As Boolean, ByVal slot As Long, ByVal fallback As String, ByRef defaultedList As String, ByVal propName As String) As String
        If scr.Has(slot) Then
            BlobPickText = scr.TextVal(slot)
            Exit Function
        End If
        If hasTpl Then
            If tpl.Has(slot) Then
                BlobPickText = tpl.TextVal(slot)
                Exit Function
            End If
        End If
        AppendDefaulted defaultedList, propName
        BlobPickText = fallback
    End Function

    ' Access default size (twips) of a control type with no size record.
    Private Function BlobDefaultSize(ByVal ctlType As String, ByVal captionText As String, ByVal wantWidth As Boolean) As Long
        Dim w As Long
        Dim h As Long
        Dim chars As Long

        h = 315
        Select Case ctlType
            Case "TextBox", "ComboBox": w = 1440
            Case "ListBox": w = 1440: h = 1440
            Case "CommandButton": w = 1440: h = 360
            Case "CheckBox", "OptionButton": w = 260: h = 240
            Case "Subform": w = 4320: h = 2880
            Case Else
                chars = Len(captionText)
                If chars < 1 Then chars = 1
                w = chars * 120 + 60
        End Select
        If wantWidth Then
            BlobDefaultSize = w
        Else
            BlobDefaultSize = h
        End If
    End Function

    Private Sub BlobStartChild(ByRef scr As BlobObjScratch, ByVal typeCode As Long, ByVal parentKind As Long, ByVal parentSection As Long, ByVal parentName As String)
        Dim emptyScr As BlobObjScratch
        Dim secIdx As Long

        scr = emptyScr
        scr.TypeCode = typeCode
        secIdx = BlobSectionIndex(typeCode)
        If secIdx >= 0 Then
            scr.Kind = BLOB_KIND_SECTION
            scr.SectionIdx = secIdx
            scr.ParentName = vbNullString
        ElseIf parentKind = BLOB_KIND_ROOT Then
            scr.Kind = BLOB_KIND_TEMPLATE
            scr.SectionIdx = parentSection
            scr.ParentName = vbNullString
        Else
            scr.Kind = BLOB_KIND_CONTROL
            scr.SectionIdx = parentSection
            If parentKind = BLOB_KIND_CONTROL Then
                scr.ParentName = parentName
            Else
                scr.ParentName = vbNullString
            End If
        End If
    End Sub

    Private Function HasArabicUnicode(ByVal s As String) As Boolean
        Dim i As Long
        Dim ch As Long
        For i = 1 To Len(s)
            ch = AscW(Mid$(s, i, 1))
            If ch >= &H600& And ch <= &H6FF& Then
                HasArabicUnicode = True
                Exit Function
            End If
        Next i
        HasArabicUnicode = False
    End Function

    ' Writes a completed scratch object into the layout.
    Private Sub BlobFinalizeObject(ByRef scr As BlobObjScratch, ByRef outLayout As NativeFormLayout, ByRef templates() As BlobObjScratch, ByRef tplPresent() As Boolean, ByRef tiNames() As String, ByRef tiTypes() As String, ByVal tiCount As Long)
        Dim ctl As NativeControlDef
        Dim tpl As BlobObjScratch
        Dim hasTpl As Boolean
        Dim ctlName As String
        Dim ctlType As String
        Dim defaultedList As String
        Dim k As Long
        Dim idx As Long

        Select Case scr.Kind
            Case BLOB_KIND_ROOT
                If scr.Has(SLOT_RECORD_SOURCE) Then outLayout.RecordSource = scr.TextVal(SLOT_RECORD_SOURCE)
                If scr.Has(SLOT_RIGHT_TO_LEFT) Then outLayout.RightToLeft = (scr.IntVal(SLOT_RIGHT_TO_LEFT) <> 0)
                If scr.Has(SLOT_DEFAULT_VIEW) Then
                    outLayout.DefaultView = scr.IntVal(SLOT_DEFAULT_VIEW)
                Else
                    outLayout.DefaultView = BLOB_DEFAULT_VIEW
                    AppendDefaulted m_blobFormDefaulted, "DefaultView"
                End If
                If scr.Has(SLOT_RECORD_SELECTORS) Then outLayout.RecordSelectors = (scr.IntVal(SLOT_RECORD_SELECTORS) <> 0)
                If scr.Has(SLOT_NAVIGATION_BUTTONS) Then outLayout.NavigationButtons = (scr.IntVal(SLOT_NAVIGATION_BUTTONS) <> 0)
                If scr.Has(SLOT_ALLOW_ADDITIONS) Then outLayout.AllowAdditions = (scr.IntVal(SLOT_ALLOW_ADDITIONS) <> 0)
                If scr.Has(SLOT_WIDTH) Then outLayout.FormWidthTw = scr.IntVal(SLOT_WIDTH)
                Exit Sub

            Case BLOB_KIND_SECTION
                idx = scr.SectionIdx
                If idx < 0 Or idx > 4 Then Exit Sub
                outLayout.SectionPresent(idx) = True
                If scr.Has(SLOT_HEIGHT) Then outLayout.SectionHeightTw(idx) = scr.IntVal(SLOT_HEIGHT)
                If scr.Has(SLOT_BACK_COLOR) Then
                    outLayout.SectionBackColor(idx) = scr.IntVal(SLOT_BACK_COLOR)
                Else
                    outLayout.SectionBackColor(idx) = BLOB_DEFAULT_BACK_COLOR
                End If
                Exit Sub
        End Select

        ctlName = vbNullString
        If scr.Has(SLOT_NAME) Then ctlName = scr.TextVal(SLOT_NAME)
        If Len(ctlName) = 0 Then
            ' Unnamed children of the form object hold per-type default properties.
            If scr.Kind = BLOB_KIND_TEMPLATE And scr.TypeCode >= 0 And scr.TypeCode <= 255 Then
                templates(scr.TypeCode) = scr
                tplPresent(scr.TypeCode) = True
            End If
            Exit Sub
        End If
        If outLayout.CtlCount >= BLOB_MAX_CONTROLS Then Exit Sub

        hasTpl = False
        If scr.TypeCode >= 0 And scr.TypeCode <= 255 Then
            If tplPresent(scr.TypeCode) Then
                tpl = templates(scr.TypeCode)
                hasTpl = True
            End If
        End If

        ' Control type: TypeInfo catalog by name, then Blob object type, then inference.
        ctlType = vbNullString
        For k = 0 To tiCount - 1
            If UCase$(Trim$(tiNames(k))) = UCase$(Trim$(ctlName)) Then
                ctlType = tiTypes(k)
                Exit For
            End If
        Next k
        If Len(ctlType) = 0 Then ctlType = AccessControlTypeName(scr.TypeCode)
        If Len(ctlType) = 0 Then ctlType = InferBlobControlType(scr)

        defaultedList = vbNullString
        ctl.CtlType = ctlType
        ctl.CtlName = ctlName
        ctl.Section = scr.SectionIdx
        ctl.Caption = scr.TextVal(SLOT_CAPTION)
        ctl.LeftTw = BlobGeometry(scr, tpl, hasTpl, SLOT_LEFT, SLOT_CACHED_LEFT, -1, 0, defaultedList, "Left")
        ctl.TopTw = BlobGeometry(scr, tpl, hasTpl, SLOT_TOP, SLOT_CACHED_TOP, -1, 0, defaultedList, "Top")
        ctl.WidthTw = BlobGeometry(scr, tpl, hasTpl, SLOT_WIDTH, SLOT_CACHED_RIGHT, SLOT_CACHED_LEFT, BlobDefaultSize(ctlType, ctl.Caption, True), defaultedList, "Width")
        ctl.HeightTw = BlobGeometry(scr, tpl, hasTpl, SLOT_HEIGHT, SLOT_CACHED_BOTTOM, SLOT_CACHED_TOP, BlobDefaultSize(ctlType, ctl.Caption, False), defaultedList, "Height")
        ctl.ControlSource = scr.TextVal(SLOT_CONTROL_SOURCE)
        ctl.RowSource = scr.TextVal(SLOT_ROW_SOURCE)
        If scr.Has(SLOT_BOUND_COLUMN) Then
            ctl.BoundColumn = scr.IntVal(SLOT_BOUND_COLUMN) + 1
        Else
            ctl.BoundColumn = 1
        End If
        ctl.ColumnWidths = scr.TextVal(SLOT_COLUMN_WIDTHS)
        If scr.Has(SLOT_COLUMN_COUNT) Then
            ctl.ColumnCount = scr.IntVal(SLOT_COLUMN_COUNT)
        Else
            ctl.ColumnCount = 1
        End If
        ctl.SourceObject = scr.TextVal(SLOT_SOURCE_OBJECT)
        ctl.LinkMaster = scr.TextVal(SLOT_LINK_MASTER)
        ctl.LinkChild = scr.TextVal(SLOT_LINK_CHILD)
        ctl.OnClick = scr.TextVal(SLOT_ON_CLICK)
        If ctlType = "Label" Then
            ctl.ParentLabelOf = scr.ParentName
        Else
            ctl.ParentLabelOf = vbNullString
        End If
        ctl.BackColor = BlobPickInt(scr, tpl, hasTpl, SLOT_BACK_COLOR, BLOB_DEFAULT_BACK_COLOR, defaultedList, "BackColor")
        ctl.ForeColor = BlobPickInt(scr, tpl, hasTpl, SLOT_FORE_COLOR, 0, defaultedList, "ForeColor")
        ctl.FontName = BlobPickText(scr, tpl, hasTpl, SLOT_FONT_NAME, "Calibri", defaultedList, "FontName")
        ctl.FontSize = BlobPickInt(scr, tpl, hasTpl, SLOT_FONT_SIZE, 11, defaultedList, "FontSize")
        ctl.FontBold = (BlobPickInt(scr, tpl, hasTpl, SLOT_FONT_WEIGHT, 400, defaultedList, "FontWeight") >= 700)
        ctl.Visible = True
        If HasArabicUnicode(ctl.Caption) Then
            outLayout.RightToLeft = True
            ctl.RightToLeft = True
        End If

        idx = outLayout.CtlCount
        ReDim Preserve outLayout.Ctls(0 To idx)
        outLayout.Ctls(idx) = ctl
        outLayout.CtlCount = idx + 1
        ReDim Preserve m_blobDefaulted(0 To idx)
        m_blobDefaulted(idx) = defaultedList
        m_blobDefaultedCount = idx + 1
    End Sub

    ' Tier 1 parser. Fills outLayout from a form Blob; TypeInfo (may be empty)
    ' supplies control types by name. Never reads outside the stream: an
    ' implausible record (byteLen past the end, unknown dataType) is skipped one
    ' byte at a time until the next plausible record or marker.
    ' Returns True when at least one section or control was found.
    Public Function ParseFormBlobProperties(ByRef blobBytes() As Byte, ByRef typeInfoBytes() As Byte, ByRef outLayout As NativeFormLayout) As Boolean
        Dim n As Long
        Dim maxIdx As Long
        Dim p As Long
        Dim v As Long
        Dim cnt As Long
        Dim t As Long
        Dim propId As Long
        Dim dataType As Long
        Dim byteLen As Long
        Dim scr As BlobObjScratch
        Dim templates(0 To 255) As BlobObjScratch
        Dim tplPresent(0 To 255) As Boolean
        Dim stkKind(0 To 31) As Long
        Dim stkRemain(0 To 31) As Long
        Dim stkSection(0 To 31) As Long
        Dim stkName(0 To 31) As String
        Dim depth As Long
        Dim openObj As Boolean
        Dim doneWalk As Boolean
        Dim tiNames() As String
        Dim tiTypes() As String
        Dim tiCount As Long
        Dim tiMax As Long
        Dim tiPos As Long
        Dim tiCode As Long
        Dim tiName As String
        Dim tiType As String
        Dim k As Long
        Dim emptyDefaults() As String

        ParseFormBlobProperties = False
        m_blobDefaulted = emptyDefaults
        m_blobDefaultedCount = 0
        m_blobFormDefaulted = vbNullString
        For k = 0 To 4
            outLayout.SectionBackColor(k) = BLOB_DEFAULT_BACK_COLOR
        Next k

        On Error Resume Next
        maxIdx = -1
        maxIdx = UBound(blobBytes)
        If Err.Number <> 0 Then maxIdx = -1
        Err.Clear
        tiMax = -1
        tiMax = UBound(typeInfoBytes)
        If Err.Number <> 0 Then tiMax = -1
        Err.Clear
        On Error GoTo 0

        n = maxIdx + 1
        If n < 10 Then Exit Function

        ' TypeInfo catalog (same walk as InspectNativeAccessForm); the low byte of
        ' the type code is the Access ControlType (&H126D TextBox, &H136F ComboBox,
        ' &H0B68 CommandButton, &H0C64/&H0D64 Label, &H106E ListBox, &H066A CheckBox,
        ' &H1470 Subform - confirmed by the oracle). Sections (&H1898..) and the
        ' &H1EFF field-name entries map to "" and are ignored.
        tiCount = 0
        If tiMax >= 40 Then
            ReDim tiNames(0 To 63)
            ReDim tiTypes(0 To 63)
            tiPos = 32
            Do While (tiPos + 8) <= tiMax
                tiCode = CLng(typeInfoBytes(tiPos)) Or (CLng(typeInfoBytes(tiPos + 1)) << 8)
                tiPos = tiPos + 8
                tiName = vbNullString
                Do While tiPos <= tiMax
                    If typeInfoBytes(tiPos) = 0 Then
                        tiPos = tiPos + 1
                        Exit Do
                    End If
                    tiName = tiName & Chr$(typeInfoBytes(tiPos))
                    tiPos = tiPos + 1
                Loop
                tiPos = tiPos + 1
                tiType = AccessControlTypeName(tiCode And &HFF&)
                If Len(tiName) > 0 And Len(tiType) > 0 Then
                    If tiCount > UBound(tiNames) Then
                        ReDim Preserve tiNames(0 To tiCount * 2)
                        ReDim Preserve tiTypes(0 To tiCount * 2)
                    End If
                    tiNames(tiCount) = tiName
                    tiTypes(tiCount) = tiType
                    tiCount = tiCount + 1
                End If
            Loop
        End If

        scr.TypeCode = BlobU16(blobBytes, 8)
        scr.Kind = BLOB_KIND_ROOT
        scr.SectionIdx = 0
        depth = 0
        openObj = True
        doneWalk = False
        p = 10

        Do While (p + 4) <= n And Not doneWalk
            v = BlobU32(blobBytes, p)

            If v = BLOB_MARK_CHILDREN And (p + 8) <= n And depth < BLOB_MAX_DEPTH Then
                cnt = BlobU16(blobBytes, p + 4)
                t = BlobU16(blobBytes, p + 6)
                BlobFinalizeObject scr, outLayout, templates, tplPresent, tiNames, tiTypes, tiCount
                stkKind(depth) = scr.Kind
                stkRemain(depth) = cnt
                stkSection(depth) = scr.SectionIdx
                stkName(depth) = scr.TextVal(SLOT_NAME)
                depth = depth + 1
                BlobStartChild scr, t, stkKind(depth - 1), stkSection(depth - 1), stkName(depth - 1)
                p = p + 8

            ElseIf v = BLOB_MARK_ONE_CHILD And (p + 6) <= n And depth < BLOB_MAX_DEPTH Then
                t = BlobU16(blobBytes, p + 4)
                BlobFinalizeObject scr, outLayout, templates, tplPresent, tiNames, tiTypes, tiCount
                stkKind(depth) = scr.Kind
                stkRemain(depth) = 1
                stkSection(depth) = scr.SectionIdx
                stkName(depth) = scr.TextVal(SLOT_NAME)
                depth = depth + 1
                BlobStartChild scr, t, stkKind(depth - 1), stkSection(depth - 1), stkName(depth - 1)
                p = p + 6

            ElseIf v = BLOB_MARK_NEXT_OR_END Then
                BlobFinalizeObject scr, outLayout, templates, tplPresent, tiNames, tiTypes, tiCount
                openObj = False
                p = p + 4
                Do While depth > 0
                    stkRemain(depth - 1) = stkRemain(depth - 1) - 1
                    If stkRemain(depth - 1) > 0 Then
                        If (p + 2) > n Then
                            depth = 0       ' sibling type expected at end of stream
                            Exit Do
                        End If
                        t = BlobU16(blobBytes, p)
                        BlobStartChild scr, t, stkKind(depth - 1), stkSection(depth - 1), stkName(depth - 1)
                        openObj = True
                        p = p + 2
                        Exit Do
                    End If
                    depth = depth - 1
                Loop
                If depth = 0 And Not openObj Then doneWalk = True

            ElseIf BlobPlausibleRecord(blobBytes, p, n) Then
                propId = BlobU16(blobBytes, p + 4)
                dataType = BlobU32(blobBytes, p + 6)
                byteLen = BlobU32(blobBytes, p + 14)
                BlobApplyRecord scr, blobBytes, p + BLOB_RECORD_HEADER, propId, dataType, byteLen
                p = p + BLOB_RECORD_HEADER + byteLen

            Else
                ' Resynchronize on the next plausible record or marker.
                p = p + 1
                Do While (p + 4) <= n
                    v = BlobU32(blobBytes, p)
                    If BlobIsMarker(v) Then Exit Do
                    If BlobPlausibleRecord(blobBytes, p, n) Then Exit Do
                    p = p + 1
                Loop
            End If
        Loop

        ' Truncated stream: keep what was read for the open object.
        If openObj Then
            BlobFinalizeObject scr, outLayout, templates, tplPresent, tiNames, tiTypes, tiCount
        End If

        If Not outLayout.SectionPresent(0) Then
            For k = 0 To outLayout.CtlCount - 1
                If outLayout.Ctls(k).Section = 0 Then
                    outLayout.SectionPresent(0) = True
                    Exit For
                End If
            Next k
        End If

        For k = 0 To 4
            If outLayout.SectionPresent(k) Then ParseFormBlobProperties = True
        Next k
        If outLayout.CtlCount > 0 Then ParseFormBlobProperties = True
    End Function

    ' =====================================================================
    ' SaveAsText text parser (pure text parsing, no Access process). Used for
    ' exported .txt form files; Python mirror of the parser:
    ' tools/studio_render_model.py parse_saveastext_layout.
    ' =====================================================================

    ' Opens a form's RecordSource as the active recordset (task 7.1).
    ' Table and saved query names go through OpenTable, so m_activeRecordset,
    ' navigation and CRUD behave exactly as for a table opened from the
    ' Navigation Pane. SQL sources (SELECT / TRANSFORM / PARAMETERS) run the
    ' same way ExecuteSqlQuery does, but m_activeTableName keeps the
    ' RecordSource text instead of "SQL Query Result".
    ' An empty RecordSource is an unbound form: the active recordset is closed
    ' and the function returns True with no recordset.
    Public Function OpenFormRecordset(ByVal recordSource As String, ByRef outErrorMsg As String) As Boolean
        Dim src As String
        Dim ok As Boolean

        OpenFormRecordset = False
        outErrorMsg = vbNullString
        src = Trim$(recordSource)

        If m_database Is Nothing Then
            outErrorMsg = "No database currently open."
            Exit Function
        End If

        If Len(src) = 0 Then
            If Not m_activeRecordset Is Nothing Then
                On Error Resume Next
                m_activeRecordset.Close
                Set m_activeRecordset = Nothing
                On Error GoTo 0
            End If
            m_activeTableName = vbNullString
            m_totalRecords = 0
            m_currentRecordIndex = 0
            OpenFormRecordset = True
            Exit Function
        End If

        If Not IsSqlRecordSource(src) Then
            OpenFormRecordset = OpenTable(src, outErrorMsg)
            Exit Function
        End If

        ok = ExecuteSqlQuery(src, outErrorMsg)
        If ok Then m_activeTableName = src
        OpenFormRecordset = ok
    End Function

    ' True when a RecordSource is SQL text rather than a table or query name.
    Public Function IsSqlRecordSource(ByVal recordSource As String) As Boolean
        Dim head As String
        head = UCase$(Left$(LTrim$(Replace$(Replace$(Replace$(recordSource, vbTab, " "), vbCr, " "), vbLf, " ")), 11))
        IsSqlRecordSource = (Left$(head, 7) = "SELECT " Or Left$(head, 10) = "TRANSFORM " Or Left$(head, 11) = "PARAMETERS " Or Left$(head, 1) = "(")
    End Function

    ' Opens a combo/list box RowSource (task 8.1) as a caller-owned recordset:
    ' SQL text, a table name, a saved query name or an Access "~sq_..." lookup
    ' query name. m_activeRecordset and the navigation state are not touched.
    ' Returns Nothing when no database is open, the RowSource is empty or it
    ' cannot be opened. The caller closes the returned recordset.
    Public Function OpenLookupRowSource(ByVal rowSource As String) As Object
        Dim src As String
        Dim rs As Object

        Set OpenLookupRowSource = Nothing
        src = Trim$(rowSource)
        If m_database Is Nothing Or Len(src) = 0 Then Exit Function

        On Error Resume Next
        Set rs = m_database.OpenRecordset(src)
        If Err.Number <> 0 Or rs Is Nothing Then
            Err.Clear
            Set rs = Nothing
            If Not IsSqlRecordSource(src) Then
                Set rs = m_database.OpenRecordset("SELECT * FROM [" & src & "];")
                If Err.Number <> 0 Then
                    Err.Clear
                    Set rs = Nothing
                End If
            End If
        End If
        On Error GoTo 0

        Set OpenLookupRowSource = rs
    End Function

    ' Text shown in the single-line SQL bar for a form RecordSource: SQL
    ' sources as-is, saved queries as their SQL, tables as the table name.
    ' Always passed through FormatSqlForDisplay(..., True) by the caller.
    Public Function GetRecordSourceDisplaySql(ByVal recordSource As String) As String
        Dim src As String
        Dim qSql As String
        Dim errMsg As String

        src = Trim$(recordSource)
        GetRecordSourceDisplaySql = src
        If Len(src) = 0 Or m_database Is Nothing Then Exit Function
        If IsSqlRecordSource(src) Then Exit Function
        qSql = GetSavedQuerySql(src, errMsg)
        If Len(Trim$(qSql)) > 0 Then GetRecordSourceDisplaySql = qSql
    End Function

    ' AutoForm layout (Single Form) for forms that have no native Access layout:
    ' _OpenAccess_Objects forms and the table "Form View [Card]" toggle.
    ' One label/textbox pair per field of rs (label left, textbox right, 420-twip
    ' rows), followed by the optional saved command button. LayoutSource = "AutoForm".
    Public Function BuildAutoFormLayout(ByVal formName As String, ByVal recordSource As String, ByVal rs As Object, ByVal buttonName As String, ByVal buttonCaption As String, ByRef outLayout As NativeFormLayout) As Boolean
        Const AF_LABEL_LEFT As Long = 300
        Const AF_LABEL_WIDTH As Long = 1500
        Const AF_CTL_LEFT As Long = 1920
        Const AF_CTL_WIDTH As Long = 3000
        Const AF_ROW_HEIGHT As Long = 315
        Const AF_STEP As Long = 420
        Const AF_TOP As Long = 240
        Dim fldCount As Long
        Dim total As Long
        Dim i As Long
        Dim fName As String
        Dim topTw As Long
        Dim ctl As NativeControlDef
        Dim lbl As NativeControlDef
        Dim emptyCtl As NativeControlDef

        ResetNativeFormLayout outLayout, formName
        outLayout.RecordSource = Trim$(recordSource)
        outLayout.DefaultView = 0
        outLayout.LayoutSource = "AutoForm"
        outLayout.SectionPresent(0) = True
        outLayout.SectionBackColor(0) = BLOB_DEFAULT_BACK_COLOR
        outLayout.FormWidthTw = AF_CTL_LEFT + AF_CTL_WIDTH + AF_LABEL_LEFT

        fldCount = 0
        If Not rs Is Nothing Then
            On Error Resume Next
            fldCount = rs.Fields.Count
            If Err.Number <> 0 Then fldCount = 0
            Err.Clear
            On Error GoTo 0
        End If

        total = fldCount * 2
        If Len(Trim$(buttonCaption)) > 0 Then total = total + 1
        outLayout.CtlCount = 0
        If total > 0 Then ReDim outLayout.Ctls(0 To total - 1)

        topTw = AF_TOP
        For i = 0 To fldCount - 1
            fName = vbNullString
            On Error Resume Next
            fName = rs.Fields(i).Name
            Err.Clear
            On Error GoTo 0

            ctl = emptyCtl
            ctl.Section = 0
            ctl.BoundColumn = 1
            ctl.ColumnCount = 1
            ctl.BackColor = BLOB_DEFAULT_BACK_COLOR
            ctl.ForeColor = 0
            ctl.FontName = "Calibri"
            ctl.FontSize = 11
            ctl.FontBold = False
            ctl.Visible = True
            lbl = ctl

            ctl.CtlType = "TextBox"
            ctl.CtlName = fName
            ctl.ControlSource = fName
            ctl.LeftTw = AF_CTL_LEFT
            ctl.TopTw = topTw
            ctl.WidthTw = AF_CTL_WIDTH
            ctl.HeightTw = AF_ROW_HEIGHT

            lbl.CtlType = "Label"
            lbl.CtlName = fName & "_Label"
            lbl.Caption = fName
            lbl.ParentLabelOf = fName
            lbl.LeftTw = AF_LABEL_LEFT
            lbl.TopTw = topTw
            lbl.WidthTw = AF_LABEL_WIDTH
            lbl.HeightTw = AF_ROW_HEIGHT

            outLayout.Ctls(outLayout.CtlCount) = lbl
            outLayout.CtlCount = outLayout.CtlCount + 1
            outLayout.Ctls(outLayout.CtlCount) = ctl
            outLayout.CtlCount = outLayout.CtlCount + 1
            topTw = topTw + AF_STEP
        Next i

        If Len(Trim$(buttonCaption)) > 0 Then
            ctl = emptyCtl
            ctl.CtlType = "CommandButton"
            If Len(Trim$(buttonName)) > 0 Then ctl.CtlName = Trim$(buttonName) Else ctl.CtlName = "Command1"
            ctl.Caption = Trim$(buttonCaption)
            ctl.OnClick = "[Event Procedure]"
            ctl.Section = 0
            ctl.LeftTw = AF_CTL_LEFT
            ctl.TopTw = topTw + 60
            ctl.WidthTw = 1440
            ctl.HeightTw = 360
            ctl.BoundColumn = 1
            ctl.ColumnCount = 1
            ctl.BackColor = BLOB_DEFAULT_BACK_COLOR
            ctl.FontName = "Calibri"
            ctl.FontSize = 11
            ctl.Visible = True
            outLayout.Ctls(outLayout.CtlCount) = ctl
            outLayout.CtlCount = outLayout.CtlCount + 1
            topTw = topTw + 60 + 360 + AF_STEP
        End If

        outLayout.SectionHeightTw(0) = topTw + AF_TOP
        BuildAutoFormLayout = True
    End Function

    ' Status bar note of the last GetNativeFormLayout call for this form in the
    ' open database ("" when the layout came from Tier 1 without remarks).
    Public Function GetLastLayoutStatus(ByVal formName As String) As String
        GetLastLayoutStatus = vbNullString
        If m_lastLayoutStatusKey = m_dbPath & "|" & UCase$(Trim$(formName)) Then
            GetLastLayoutStatus = m_lastLayoutStatus
        End If
    End Function

    ' Reads a SaveAsText file (UTF-16LE with BOM, otherwise ANSI).
    Private Function ReadSaveAsTextFile(ByVal filePath As String, ByRef outErrorMsg As String) As String
        Dim fileNum As Integer
        Dim byteCount As Long
        Dim buf() As Byte

        ReadSaveAsTextFile = vbNullString
        outErrorMsg = vbNullString
        On Error Resume Next
        fileNum = FreeFile()
        Open filePath For Binary Access Read Shared As #fileNum
        If Err.Number <> 0 Then
            outErrorMsg = Err.Description
            Err.Clear
            On Error GoTo 0
            Exit Function
        End If
        byteCount = LOF(fileNum)
        If byteCount > 0 Then
            ReDim buf(0 To byteCount - 1)
            Get #fileNum, 1, buf
        End If
        Close #fileNum
        If Err.Number <> 0 Then
            outErrorMsg = Err.Description
            Err.Clear
            On Error GoTo 0
            Exit Function
        End If
        On Error GoTo 0
        If byteCount <= 0 Then
            outErrorMsg = "empty file"
            Exit Function
        End If
        ReadSaveAsTextFile = DecodeSaveAsTextBytes(buf)
    End Function

    ' UTF-16LE when the bytes start with the FF FE BOM, else ANSI.
    Public Function DecodeSaveAsTextBytes(ByRef raw() As Byte) As String
        Dim maxIdx As Long
        Dim n As Long
        Dim k As Long
        Dim tail() As Byte

        DecodeSaveAsTextBytes = vbNullString
        On Error Resume Next
        maxIdx = -1
        maxIdx = UBound(raw)
        If Err.Number <> 0 Then maxIdx = -1
        Err.Clear
        On Error GoTo 0
        n = maxIdx + 1
        If n <= 0 Then Exit Function

        If n >= 2 Then
            If raw(0) = &HFF& And raw(1) = &HFE& Then
                n = ((n - 2) \ 2) * 2
                If n <= 0 Then Exit Function
                ReDim tail(0 To n - 1)
                For k = 0 To n - 1
                    tail(k) = raw(k + 2)
                Next k
                DecodeSaveAsTextBytes = tail
                Exit Function
            End If
        End If
        DecodeSaveAsTextBytes = StrConv(raw, vbUnicode)
    End Function

    ' Trims spaces and tabs.
    Private Function SatTrim(ByVal s As String) As String
        Dim a As Long
        Dim b As Long
        Dim ch As String

        a = 1
        b = Len(s)
        Do While a <= b
            ch = Mid$(s, a, 1)
            If ch <> " " And ch <> vbTab Then Exit Do
            a = a + 1
        Loop
        Do While b >= a
            ch = Mid$(s, b, 1)
            If ch <> " " And ch <> vbTab Then Exit Do
            b = b - 1
        Loop
        If b < a Then
            SatTrim = vbNullString
        Else
            SatTrim = Mid$(s, a, b - a + 1)
        End If
    End Function

    ' SaveAsText block name -> Blob object type (sections &H98.., Access
    ' ControlType for controls, 0 when unknown).
    Private Function SatTypeCode(ByVal kindName As String) As Long
        Dim code As Long

        Select Case kindName
            Case "Section": SatTypeCode = &H98&
            Case "FormHeader": SatTypeCode = &H99&
            Case "FormFooter": SatTypeCode = &H9A&
            Case "PageHeader": SatTypeCode = &H9B&
            Case "PageFooter": SatTypeCode = &H9C&
            Case "SubForm": SatTypeCode = 112
            Case "Tab": SatTypeCode = 123
            Case "UnboundObjectFrame": SatTypeCode = 114
            Case Else
                SatTypeCode = 0
                For code = 100 To 132
                    If StrComp(AccessControlTypeName(code), kindName, vbBinaryCompare) = 0 Then
                        SatTypeCode = code
                        Exit For
                    End If
                Next code
        End Select
    End Function

    ' SaveAsText key -> scratch slot (-1 = not used) and its kind.
    Private Function SatPropSlot(ByVal keyName As String, ByRef outKind As Long) As Long
        outKind = SLOT_KIND_INT
        Select Case keyName
            Case "Name": SatPropSlot = SLOT_NAME: outKind = SLOT_KIND_TEXT
            Case "Caption": SatPropSlot = SLOT_CAPTION: outKind = SLOT_KIND_TEXT
            Case "ControlSource": SatPropSlot = SLOT_CONTROL_SOURCE: outKind = SLOT_KIND_TEXT
            Case "RowSource": SatPropSlot = SLOT_ROW_SOURCE: outKind = SLOT_KIND_TEXT
            Case "ColumnWidths": SatPropSlot = SLOT_COLUMN_WIDTHS: outKind = SLOT_KIND_TEXT
            Case "SourceObject": SatPropSlot = SLOT_SOURCE_OBJECT: outKind = SLOT_KIND_TEXT
            Case "LinkMasterFields": SatPropSlot = SLOT_LINK_MASTER: outKind = SLOT_KIND_TEXT
            Case "LinkChildFields": SatPropSlot = SLOT_LINK_CHILD: outKind = SLOT_KIND_TEXT
            Case "OnClick": SatPropSlot = SLOT_ON_CLICK: outKind = SLOT_KIND_TEXT
            Case "RecordSource": SatPropSlot = SLOT_RECORD_SOURCE: outKind = SLOT_KIND_TEXT
            Case "FontName": SatPropSlot = SLOT_FONT_NAME: outKind = SLOT_KIND_TEXT
            Case "Left": SatPropSlot = SLOT_LEFT
            Case "Top": SatPropSlot = SLOT_TOP
            Case "Width": SatPropSlot = SLOT_WIDTH
            Case "Height": SatPropSlot = SLOT_HEIGHT
            Case "BoundColumn": SatPropSlot = SLOT_BOUND_COLUMN: outKind = SAT_KIND_BOUND
            Case "ColumnCount": SatPropSlot = SLOT_COLUMN_COUNT
            Case "DefaultView": SatPropSlot = SLOT_DEFAULT_VIEW
            Case "BackColor": SatPropSlot = SLOT_BACK_COLOR
            Case "ForeColor": SatPropSlot = SLOT_FORE_COLOR
            Case "FontSize": SatPropSlot = SLOT_FONT_SIZE
            Case "FontWeight": SatPropSlot = SLOT_FONT_WEIGHT
            Case "LayoutCachedLeft": SatPropSlot = SLOT_CACHED_LEFT
            Case "LayoutCachedTop": SatPropSlot = SLOT_CACHED_TOP
            Case "LayoutCachedWidth": SatPropSlot = SLOT_CACHED_RIGHT
            Case "LayoutCachedHeight": SatPropSlot = SLOT_CACHED_BOTTOM
            Case "RecordSelectors": SatPropSlot = SLOT_RECORD_SELECTORS: outKind = SLOT_KIND_BOOL
            Case "NavigationButtons": SatPropSlot = SLOT_NAVIGATION_BUTTONS: outKind = SLOT_KIND_BOOL
            Case "AllowAdditions": SatPropSlot = SLOT_ALLOW_ADDITIONS: outKind = SLOT_KIND_BOOL
            Case "RightToLeft": SatPropSlot = SLOT_RIGHT_TO_LEFT: outKind = SLOT_KIND_BOOL
            Case Else: SatPropSlot = -1
        End Select
    End Function

    ' Integer value of a SaveAsText scalar ("95.0" -> 95), truncated like Fix.
    Private Function SatParseLong(ByVal s As String, ByRef outOk As Boolean) As Long
        Dim d As Double
        Dim first As String

        outOk = False
        SatParseLong = 0
        s = SatTrim(s)
        If Len(s) = 0 Then Exit Function
        first = Left$(s, 1)
        If Not ((first >= "0" And first <= "9") Or first = "-" Or first = "+" Or first = ".") Then Exit Function
        d = Val(s)
        If d > 2147483647# Or d < -2147483648# Then Exit Function
        SatParseLong = CLng(Fix(d))
        outOk = True
    End Function

    ' Stores one SaveAsText property of the current object in its scratch slot.
    Private Sub SatApplyProperty(ByRef scr As BlobObjScratch, ByVal keyName As String, ByVal valueText As String, ByVal isQuoted As Boolean)
        Dim slot As Long
        Dim slotKind As Long
        Dim v As Long
        Dim ok As Boolean

        slot = SatPropSlot(keyName, slotKind)
        If slot < 0 Then Exit Sub
        Select Case slotKind
            Case SLOT_KIND_TEXT
                scr.TextVal(slot) = valueText
                scr.Has(slot) = True
            Case SLOT_KIND_BOOL
                If valueText = "NotDefault" And Not isQuoted Then
                    scr.IntVal(slot) = 0             ' every Bool read here defaults to True
                    scr.Has(slot) = True
                Else
                    v = SatParseLong(valueText, ok)
                    If ok Then
                        If v <> 0 Then
                            scr.IntVal(slot) = 1
                        Else
                            scr.IntVal(slot) = 0
                        End If
                        scr.Has(slot) = True
                    End If
                End If
            Case Else
                v = SatParseLong(valueText, ok)
                If ok Then
                    If slotKind = SAT_KIND_BOUND Then v = v - 1   ' stored zero-based like the Blob
                    scr.IntVal(slot) = v
                    scr.Has(slot) = True
                End If
        End Select
    End Sub

    ' Reads a quoted value starting after the opening quote of lines(lineIdx).
    ' Handles \" and \\ escapes, continuation lines that start with a quote, and
    ' values that continue on the next line (joined with vbCrLf). lineIdx is
    ' left on the last line consumed.
    Private Function SatReadQuoted(ByRef lines() As String, ByRef lineIdx As Long, ByVal lineCount As Long, ByVal startText As String) As String
        Dim buf As String
        Dim txt As String
        Dim j As Long
        Dim txtLen As Long
        Dim ch As String
        Dim nx As String
        Dim closed As Boolean
        Dim handled As Boolean

        buf = vbNullString
        txt = startText
        Do
            j = 1
            txtLen = Len(txt)
            closed = False
            Do While j <= txtLen
                ch = Mid$(txt, j, 1)
                handled = False
                If ch = "\" And j < txtLen Then
                    nx = Mid$(txt, j + 1, 1)
                    If nx = """" Or nx = "\" Then
                        buf = buf & nx
                        j = j + 2
                        handled = True
                    End If
                End If
                If Not handled Then
                    If ch = """" Then
                        closed = True
                        Exit Do
                    End If
                    buf = buf & ch
                    j = j + 1
                End If
            Loop
            If closed Then
                If lineIdx + 1 < lineCount Then
                    If Left$(SatTrim(lines(lineIdx + 1)), 1) = """" Then
                        lineIdx = lineIdx + 1
                        txt = Mid$(SatTrim(lines(lineIdx)), 2)
                    Else
                        Exit Do
                    End If
                Else
                    Exit Do
                End If
            Else
                If lineIdx + 1 >= lineCount Then Exit Do
                buf = buf & vbCrLf
                lineIdx = lineIdx + 1
                txt = lines(lineIdx)
            End If
        Loop
        SatReadQuoted = buf
    End Function

    ' SaveAsText parser. Fills outLayout from Access SaveAsText form text. Every
    ' object becomes a Blob scratch object and goes through BlobFinalizeObject,
    ' so the result follows the same rules as Tier 1 (type templates,
    ' LayoutCached geometry, Access defaults recorded in GetLastBlobLayoutDefaults).
    ' Binary blocks (Key = Begin ... End: PrtMip, GUID, NameMap, RecSrcDt) are
    ' skipped; parsing stops when the Form object closes (CodeBehindForm).
    ' Returns True when at least one section or control was found.
    Public Function ParseSaveAsTextLayout(ByVal textContent As String, ByRef outLayout As NativeFormLayout) As Boolean
        Dim lines() As String
        Dim lineCount As Long
        Dim i As Long
        Dim rawLine As String
        Dim lineText As String
        Dim kindName As String
        Dim typeCode As Long
        Dim objStack(0 To 31) As BlobObjScratch
        Dim objDone(0 To 31) As Boolean
        Dim objDepth As Long
        Dim nestKind(0 To 63) As Long
        Dim nestDepth As Long
        Dim rootSeen As Boolean
        Dim templates(0 To 255) As BlobObjScratch
        Dim tplPresent(0 To 255) As Boolean
        Dim tiNames() As String
        Dim tiTypes() As String
        Dim emptyDefaults() As String
        Dim emptyScr As BlobObjScratch
        Dim eqPos As Long
        Dim rawEq As Long
        Dim quotePos As Long
        Dim keyName As String
        Dim valText As String
        Dim isQuoted As Boolean
        Dim parentName As String
        Dim k As Long

        ParseSaveAsTextLayout = False
        m_blobDefaulted = emptyDefaults
        m_blobDefaultedCount = 0
        m_blobFormDefaulted = vbNullString
        For k = 0 To 4
            outLayout.SectionBackColor(k) = BLOB_DEFAULT_BACK_COLOR
        Next k

        If Len(textContent) = 0 Then Exit Function
        If AscW(Left$(textContent, 1)) = &HFEFF& Then textContent = Mid$(textContent, 2)
        textContent = Replace(textContent, vbCrLf, vbLf)
        textContent = Replace(textContent, vbCr, vbLf)
        lines = Split(textContent, vbLf)
        lineCount = UBound(lines) + 1

        objDepth = 0
        nestDepth = 0
        rootSeen = False
        i = 0
        Do While i < lineCount
            rawLine = lines(i)
            lineText = SatTrim(rawLine)

            If Len(lineText) > 0 Then
                If rootSeen And nestDepth = 0 Then Exit Do

                If lineText = "Begin" Then
                    If nestDepth >= SAT_MAX_NEST_DEPTH Then Exit Do
                    nestKind(nestDepth) = SAT_NEST_GROUP
                    nestDepth = nestDepth + 1

                ElseIf Left$(lineText, 6) = "Begin " Then
                    If nestDepth >= SAT_MAX_NEST_DEPTH Then Exit Do
                    kindName = SatTrim(Mid$(lineText, 7))
                    If Not rootSeen Then
                        If kindName = "Form" Then
                            objStack(0) = emptyScr
                            objStack(0).TypeCode = &H96&
                            objStack(0).Kind = BLOB_KIND_ROOT
                            objStack(0).SectionIdx = 0
                            objDone(0) = False
                            objDepth = 1
                            rootSeen = True
                            nestKind(nestDepth) = SAT_NEST_OBJECT
                        Else
                            nestKind(nestDepth) = SAT_NEST_SKIP
                        End If
                    ElseIf objDepth = 0 Or objDepth >= SAT_MAX_OBJ_DEPTH Then
                        nestKind(nestDepth) = SAT_NEST_SKIP
                    Else
                        ' A parent's properties all precede its children.
                        If Not objDone(objDepth - 1) Then
                            BlobFinalizeObject objStack(objDepth - 1), outLayout, templates, tplPresent, tiNames, tiTypes, 0
                            objDone(objDepth - 1) = True
                        End If
                        typeCode = SatTypeCode(kindName)
                        parentName = objStack(objDepth - 1).TextVal(SLOT_NAME)
                        BlobStartChild objStack(objDepth), typeCode, objStack(objDepth - 1).Kind, objStack(objDepth - 1).SectionIdx, parentName
                        objDone(objDepth) = False
                        objDepth = objDepth + 1
                        nestKind(nestDepth) = SAT_NEST_OBJECT
                    End If
                    nestDepth = nestDepth + 1

                ElseIf lineText = "End" Then
                    If nestDepth > 0 Then
                        nestDepth = nestDepth - 1
                        If nestKind(nestDepth) = SAT_NEST_OBJECT And objDepth > 0 Then
                            If Not objDone(objDepth - 1) Then
                                BlobFinalizeObject objStack(objDepth - 1), outLayout, templates, tplPresent, tiNames, tiTypes, 0
                                objDone(objDepth - 1) = True
                            End If
                            objDepth = objDepth - 1
                        End If
                    End If

                Else
                    eqPos = InStr(1, lineText, "=", vbBinaryCompare)
                    If eqPos > 0 And objDepth > 0 And nestDepth > 0 Then
                        If nestKind(nestDepth - 1) = SAT_NEST_OBJECT Then
                            keyName = SatTrim(Left$(lineText, eqPos - 1))
                            valText = SatTrim(Mid$(lineText, eqPos + 1))
                            If valText = "Begin" Then
                                ' Binary block: skip to its End line.
                                i = i + 1
                                Do While i < lineCount
                                    If SatTrim(lines(i)) = "End" Then Exit Do
                                    i = i + 1
                                Loop
                            Else
                                isQuoted = (Left$(valText, 1) = """")
                                If isQuoted Then
                                    rawEq = InStr(1, rawLine, "=", vbBinaryCompare)
                                    quotePos = InStr(rawEq, rawLine, """", vbBinaryCompare)
                                    valText = SatReadQuoted(lines, i, lineCount, Mid$(rawLine, quotePos + 1))
                                End If
                                SatApplyProperty objStack(objDepth - 1), keyName, valText, isQuoted
                            End If
                        End If
                    End If
                End If
            End If
            i = i + 1
        Loop

        ' Truncated text: keep what was read for the open objects.
        Do While objDepth > 0
            If Not objDone(objDepth - 1) Then
                BlobFinalizeObject objStack(objDepth - 1), outLayout, templates, tplPresent, tiNames, tiTypes, 0
                objDone(objDepth - 1) = True
            End If
            objDepth = objDepth - 1
        Loop

        If Not outLayout.SectionPresent(0) Then
            For k = 0 To outLayout.CtlCount - 1
                If outLayout.Ctls(k).Section = 0 Then
                    outLayout.SectionPresent(0) = True
                    Exit For
                End If
            Next k
        End If

        For k = 0 To 4
            If outLayout.SectionPresent(k) Then ParseSaveAsTextLayout = True
        Next k
        If outLayout.CtlCount > 0 Then ParseSaveAsTextLayout = True
    End Function

    ' Tier 3 - TypeInfo control list stacked vertically (approximate layout).
    ' Uses only the controls listed in the form's TypeInfo stream, in TypeInfo
    ' order; sections (&H1898..) and &H1EFF field-name entries are skipped (their
    ' low byte is not an Access ControlType). A Label directly followed by a
    ' non-Label control forms one row (label left, control right); every other
    ' entry takes a row of its own. Rows advance in 300-twip steps; ListBox and
    ' Subform take several steps. No generic or table-derived fields are added.
    ' Mirrored by build_typeinfo_fallback_layout in tools/studio_render_model.py.
    Private Function BuildTypeInfoFallbackLayout(ByVal formName As String, ByRef outLayout As NativeFormLayout, ByRef outErrorMsg As String) As Boolean
        Dim typeBytes() As Byte
        Dim blobBytes() As Byte
        Dim readMsg As String
        Dim tiMax As Long
        Dim tiPos As Long
        Dim tiCode As Long
        Dim tiName As String
        Dim tiType As String
        Dim tiNames() As String
        Dim tiTypes() As String
        Dim tiCount As Long
        Dim dup As Boolean
        Dim i As Long
        Dim k As Long
        Dim topTw As Long
        Dim ctlHeight As Long
        Dim steps As Long
        Dim pairCtl As Boolean
        Dim lbl As NativeControlDef
        Dim ctl As NativeControlDef
        Dim emptyCtl As NativeControlDef

        BuildTypeInfoFallbackLayout = False
        outErrorMsg = vbNullString

        If Not ReadNativeFormStreams(formName, typeBytes, blobBytes, readMsg) Then
            outErrorMsg = readMsg
            Exit Function
        End If

        On Error Resume Next
        tiMax = -1
        tiMax = UBound(typeBytes)
        If Err.Number <> 0 Then tiMax = -1
        Err.Clear
        On Error GoTo 0

        ' TypeInfo catalog (same walk as InspectNativeAccessForm / ParseFormBlobProperties)
        tiCount = 0
        If tiMax >= 40 Then
            ReDim tiNames(0 To 63)
            ReDim tiTypes(0 To 63)
            tiPos = 32
            Do While (tiPos + 8) <= tiMax
                tiCode = CLng(typeBytes(tiPos)) Or (CLng(typeBytes(tiPos + 1)) << 8)
                tiPos = tiPos + 8
                tiName = vbNullString
                Do While tiPos <= tiMax
                    If typeBytes(tiPos) = 0 Then
                        tiPos = tiPos + 1
                        Exit Do
                    End If
                    tiName = tiName & Chr$(typeBytes(tiPos))
                    tiPos = tiPos + 1
                Loop
                tiPos = tiPos + 1
                tiType = AccessControlTypeName(tiCode And &HFF&)
                If Len(tiName) > 0 And Len(tiType) > 0 Then
                    dup = False
                    For k = 0 To tiCount - 1
                        If StrComp(tiNames(k), tiName, vbTextCompare) = 0 Then
                            dup = True
                            Exit For
                        End If
                    Next k
                    If Not dup Then
                        If tiCount > UBound(tiNames) Then
                            ReDim Preserve tiNames(0 To tiCount * 2)
                            ReDim Preserve tiTypes(0 To tiCount * 2)
                        End If
                        tiNames(tiCount) = tiName
                        tiTypes(tiCount) = tiType
                        tiCount = tiCount + 1
                    End If
                End If
            Loop
        End If

        If tiCount = 0 Then
            outErrorMsg = "The form TypeInfo stream lists no controls."
            Exit Function
        End If

        outLayout.DefaultView = 0
        outLayout.SectionPresent(0) = True
        outLayout.SectionBackColor(0) = BLOB_DEFAULT_BACK_COLOR
        outLayout.FormWidthTw = TI_FB_CTL_LEFT + TI_FB_CTL_WIDTH + TI_FB_STEP
        outLayout.CtlCount = 0
        ReDim outLayout.Ctls(0 To tiCount - 1)

        topTw = TI_FB_STEP
        i = 0
        Do While i < tiCount
            ctl = emptyCtl
            ctl.Section = 0
            ctl.BoundColumn = 1
            ctl.ColumnCount = 1
            ctl.BackColor = BLOB_DEFAULT_BACK_COLOR
            ctl.ForeColor = 0
            ctl.FontName = "Calibri"
            ctl.FontSize = 11
            ctl.FontBold = False
            ctl.Visible = True
            lbl = ctl

            pairCtl = False
            If tiTypes(i) = "Label" And (i + 1) < tiCount Then
                If tiTypes(i + 1) <> "Label" Then pairCtl = True
            End If

            If tiTypes(i) = "Label" And Not pairCtl Then
                ' Stand-alone label
                lbl.CtlType = "Label"
                lbl.CtlName = tiNames(i)
                lbl.Caption = tiNames(i)
                lbl.LeftTw = TI_FB_LABEL_LEFT
                lbl.TopTw = topTw
                lbl.WidthTw = TI_FB_LABEL_WIDTH
                lbl.HeightTw = TI_FB_ROW_HEIGHT
                outLayout.Ctls(outLayout.CtlCount) = lbl
                outLayout.CtlCount = outLayout.CtlCount + 1
                topTw = topTw + TI_FB_STEP
                i = i + 1
            Else
                If pairCtl Then k = i + 1 Else k = i
                ctl.CtlType = tiTypes(k)
                ctl.CtlName = tiNames(k)
                Select Case ctl.CtlType
                    Case "ListBox": ctlHeight = 1170
                    Case "Subform": ctlHeight = 2670
                    Case Else: ctlHeight = TI_FB_ROW_HEIGHT
                End Select
                Select Case ctl.CtlType
                    Case "CheckBox", "OptionButton": ctl.WidthTw = 260
                    Case "CommandButton", "ToggleButton": ctl.WidthTw = TI_FB_LABEL_WIDTH
                    Case Else: ctl.WidthTw = TI_FB_CTL_WIDTH
                End Select
                If ctl.CtlType = "CommandButton" Or ctl.CtlType = "ToggleButton" Then ctl.Caption = ctl.CtlName
                ctl.LeftTw = TI_FB_CTL_LEFT
                ctl.TopTw = topTw
                ctl.HeightTw = ctlHeight

                If pairCtl Then
                    lbl.CtlType = "Label"
                    lbl.CtlName = tiNames(i)
                    lbl.Caption = ctl.CtlName
                    lbl.ParentLabelOf = ctl.CtlName
                    lbl.LeftTw = TI_FB_LABEL_LEFT
                    lbl.TopTw = topTw
                    lbl.WidthTw = TI_FB_LABEL_WIDTH
                    lbl.HeightTw = TI_FB_ROW_HEIGHT
                    outLayout.Ctls(outLayout.CtlCount) = lbl
                    outLayout.CtlCount = outLayout.CtlCount + 1
                End If
                outLayout.Ctls(outLayout.CtlCount) = ctl
                outLayout.CtlCount = outLayout.CtlCount + 1

                steps = (ctlHeight + 30 + TI_FB_STEP - 1) \ TI_FB_STEP
                topTw = topTw + (steps * TI_FB_STEP)
                i = k + 1
            End If
        Loop

        outLayout.SectionHeightTw(0) = topTw + TI_FB_STEP
        BuildTypeInfoFallbackLayout = (outLayout.CtlCount > 0)
    End Function

    Public Function ExecuteFormButtonClick(ByVal formName As String, ByVal buttonName As String, ByVal showDialog As Boolean, ByRef outExecutedMsg As String, ByRef outErrorMsg As String) As Boolean
        Dim targetForm As String
        Dim targetBtn As String
        Dim formVba As String
        Dim eventProcName As String

        outExecutedMsg = vbNullString
        outErrorMsg = vbNullString

        targetForm = Trim$(formName)
        If Len(targetForm) = 0 Then targetForm = m_activeFormName
        targetBtn = Trim$(buttonName)
        If Len(targetBtn) = 0 Then targetBtn = m_activeFormButtonName
        If Len(targetBtn) = 0 Then targetBtn = "Command2"

        If Len(targetForm) = 0 Then
            outErrorMsg = "No active Form selected."
            ExecuteFormButtonClick = False
            Exit Function
        End If

        formVba = GetNativeVbaModuleCode("Form_" & targetForm)
        eventProcName = targetBtn & "_Click"

        If Len(Trim$(formVba)) > 0 Then
            ExecuteFormButtonClick = ExecuteVbaProcedure(formVba, eventProcName, showDialog, outExecutedMsg, outErrorMsg)
        Else
            outErrorMsg = "No VBA event module found for Form [" & targetForm & "]."
            ExecuteFormButtonClick = False
        End If
    End Function

    Public Function ExecuteVbaModuleDefaultProc(ByVal moduleName As String, ByVal showDialog As Boolean, ByRef outExecutedMsg As String, ByRef outErrorMsg As String) As Boolean
        Dim modCode As String
        Dim srcName As String
        Dim lines() As String
        Dim i As Long
        Dim ln As String
        Dim upperLn As String
        Dim firstProc As String
        Dim pStart As Long
        Dim pOpen As Long

        outExecutedMsg = vbNullString
        outErrorMsg = vbNullString

        modCode = GetCustomObjectDefinition("MODULE", moduleName, srcName, outErrorMsg)
        If Len(Trim$(modCode)) = 0 Then
            modCode = GetNativeVbaModuleCode(moduleName)
        End If
        If Len(Trim$(modCode)) = 0 Then
            outErrorMsg = "VBA Module [" & moduleName & "] has no executable code."
            ExecuteVbaModuleDefaultProc = False
            Exit Function
        End If

        firstProc = vbNullString
        lines = Split(modCode, vbCrLf)
        For i = 0 To UBound(lines)
            ln = Trim$(lines(i))
            upperLn = UCase$(ln)
            pStart = 0
            If Left$(upperLn, 4) = "SUB " Then
                pStart = 5
            ElseIf Left$(upperLn, 11) = "PUBLIC SUB " Then
                pStart = 12
            ElseIf Left$(upperLn, 12) = "PRIVATE SUB " Then
                pStart = 13
            ElseIf Left$(upperLn, 9) = "FUNCTION " Then
                pStart = 10
            ElseIf Left$(upperLn, 16) = "PUBLIC FUNCTION " Then
                pStart = 17
            ElseIf Left$(upperLn, 17) = "PRIVATE FUNCTION " Then
                pStart = 18
            End If

            If pStart > 0 Then
                firstProc = Trim$(Mid$(ln, pStart))
                pOpen = InStr(firstProc, "(")
                If pOpen > 1 Then firstProc = Trim$(Left$(firstProc, pOpen - 1))
                Exit For
            End If
        Next i

        If Len(firstProc) > 0 Then
            ExecuteVbaModuleDefaultProc = ExecuteVbaProcedure(modCode, firstProc, showDialog, outExecutedMsg, outErrorMsg)
        Else
            ExecuteVbaModuleDefaultProc = ExecuteVbaProcedure(modCode, "", showDialog, outExecutedMsg, outErrorMsg)
        End If
    End Function

    Private m_pendingOpenFormName As String
    Private m_pendingOpenFormWhere As String
    Private m_pendingOpenQueryName As String
    Private m_pendingCloseForm As Boolean

    Public Sub RequestOpenForm(ByVal formName As String, Optional ByVal whereCondition As String = "")
        m_pendingOpenFormName = CleanQuotedArg(Trim$(formName))
        m_pendingOpenFormWhere = CleanQuotedArg(Trim$(whereCondition))
    End Sub

    Public Function ConsumePendingOpenForm(ByRef outFormName As String, ByRef outWhereCondition As String) As Boolean
        If Len(m_pendingOpenFormName) > 0 Then
            outFormName = m_pendingOpenFormName
            outWhereCondition = m_pendingOpenFormWhere
            m_pendingOpenFormName = vbNullString
            m_pendingOpenFormWhere = vbNullString
            ConsumePendingOpenForm = True
        Else
            outFormName = vbNullString
            outWhereCondition = vbNullString
            ConsumePendingOpenForm = False
        End If
    End Function

    Public Sub RequestOpenQuery(ByVal queryName As String)
        m_pendingOpenQueryName = CleanQuotedArg(Trim$(queryName))
    End Sub

    Public Function ConsumePendingOpenQuery(ByRef outQueryName As String) As Boolean
        If Len(m_pendingOpenQueryName) > 0 Then
            outQueryName = m_pendingOpenQueryName
            m_pendingOpenQueryName = vbNullString
            ConsumePendingOpenQuery = True
        Else
            outQueryName = vbNullString
            ConsumePendingOpenQuery = False
        End If
    End Function

    Public Sub RequestCloseForm()
        m_pendingCloseForm = True
    End Sub

    Public Function ConsumePendingCloseForm() As Boolean
        If m_pendingCloseForm Then
            m_pendingCloseForm = False
            ConsumePendingCloseForm = True
        Else
            ConsumePendingCloseForm = False
        End If
    End Function

    Public Function ExecuteVbaProcedure(ByVal moduleCode As String, ByVal procName As String, ByVal showDialog As Boolean, ByRef outExecutedMsg As String, ByRef outErrorMsg As String) As Boolean
        Dim lines() As String
        Dim i As Long
        Dim ln As String
        Dim upperLn As String
        Dim inTargetProc As Boolean
        Dim foundTargetProc As Boolean
        Dim targetUpper As String
        Dim stmt As String
        Dim upperStmt As String
        Dim msgArg As String
        Dim msgVal As String
        Dim calledProc As String
        Dim pOpen As Long
        Dim modNames As Collection
        Dim mItem As Variant
        Dim extCode As String
        Dim srcDummy As String
        Dim errDummy As String

        outErrorMsg = vbNullString
        If Len(Trim$(moduleCode)) = 0 Then
            outErrorMsg = "Empty VBA module code."
            ExecuteVbaProcedure = False
            Exit Function
        End If

        targetUpper = UCase$(Trim$(procName))
        inTargetProc = (Len(targetUpper) = 0)
        foundTargetProc = inTargetProc
        lines = Split(moduleCode, vbCrLf)

        For i = 0 To UBound(lines)
            ln = Trim$(lines(i))
            upperLn = UCase$(ln)

            If Not inTargetProc Then
                If InStr(1, upperLn, "SUB " & targetUpper, vbTextCompare) > 0 Or InStr(1, upperLn, "FUNCTION " & targetUpper, vbTextCompare) > 0 Then
                    inTargetProc = True
                    foundTargetProc = True
                End If
            Else
                If upperLn = "END SUB" Or upperLn = "END FUNCTION" Or upperLn = "EXIT SUB" Or upperLn = "EXIT FUNCTION" Then
                    If Len(targetUpper) > 0 Then Exit For
                ElseIf Left$(upperLn, 1) <> "'" And Left$(upperLn, 10) <> "ATTRIBUTE " And Left$(upperLn, 7) <> "OPTION " Then
                    stmt = ln
                    upperStmt = UCase$(stmt)

                    ' 1. Handle MsgBox statement
                    If Left$(upperStmt, 6) = "MSGBOX" Then
                        msgArg = Trim$(Mid$(stmt, 7))
                        If Left$(msgArg, 1) = "(" And Right$(msgArg, 1) = ")" Then
                            msgArg = Trim$(Mid$(msgArg, 2, Len(msgArg) - 2))
                        End If
                        If InStr(msgArg, ",") > 0 Then
                            msgArg = Trim$(Left$(msgArg, InStr(msgArg, ",") - 1))
                        End If
                        msgVal = CleanQuotedArg(msgArg)
                        If Len(outExecutedMsg) > 0 Then outExecutedMsg = outExecutedMsg & vbCrLf
                        outExecutedMsg = outExecutedMsg & msgVal

                        If m_immediateHistory Is Nothing Then Set m_immediateHistory = New Collection
                        m_immediateHistory.Add "[VBA MsgBox] (" & IIf(Len(procName) > 0, procName, "Module") & ") ==> """ & msgVal & """"

                        If showDialog Then
                            MsgBox msgVal, vbInformation, "Microsoft Access / OpenAccess VBA"
                        End If

                    ' 2. Handle DoCmd.<Action> statements (DoCmd.OpenForm, DoCmd.Close, DoCmd.OpenQuery, DoCmd.RunSQL, DoCmd.GoToRecord, etc.)
                    ElseIf Left$(upperStmt, 6) = "DOCMD." Then
                        Dim doCmdRest As String
                        Dim doCmdVerb As String
                        Dim doCmdArgsStr As String
                        Dim doCmdParts() As String
                        doCmdRest = Trim$(Mid$(stmt, 7))
                        If InStr(1, doCmdRest, "(") > 0 And Right$(doCmdRest, 1) = ")" Then
                            doCmdVerb = UCase$(Trim$(Left$(doCmdRest, InStr(1, doCmdRest, "(") - 1)))
                            doCmdArgsStr = Trim$(Mid$(doCmdRest, InStr(1, doCmdRest, "(") + 1, Len(doCmdRest) - InStr(1, doCmdRest, "(") - 1))
                        ElseIf InStr(1, doCmdRest, " ") > 0 Then
                            doCmdVerb = UCase$(Trim$(Left$(doCmdRest, InStr(1, doCmdRest, " ") - 1)))
                            doCmdArgsStr = Trim$(Mid$(doCmdRest, InStr(1, doCmdRest, " ") + 1))
                        Else
                            doCmdVerb = UCase$(Trim$(doCmdRest))
                            doCmdArgsStr = vbNullString
                        End If
                        doCmdParts = Split(doCmdArgsStr, ",")
                        Select Case doCmdVerb
                            Case "OPENFORM"
                                If UBound(doCmdParts) >= 0 Then
                                    Dim targetFrm As String
                                    Dim targetWhere As String
                                    targetFrm = CleanQuotedArg(Trim$(doCmdParts(0)))
                                    targetWhere = vbNullString
                                    If UBound(doCmdParts) >= 3 Then
                                        targetWhere = CleanQuotedArg(Trim$(doCmdParts(3)))
                                    End If
                                    If Len(targetFrm) > 0 Then
                                        RequestOpenForm targetFrm, targetWhere
                                        If Len(outExecutedMsg) > 0 Then outExecutedMsg = outExecutedMsg & vbCrLf
                                        outExecutedMsg = outExecutedMsg & "DoCmd.OpenForm [" & targetFrm & "]"
                                    End If
                                End If
                            Case "CLOSE"
                                RequestCloseForm
                                If Len(outExecutedMsg) > 0 Then outExecutedMsg = outExecutedMsg & vbCrLf
                                outExecutedMsg = outExecutedMsg & "DoCmd.Close"
                            Case "OPENQUERY"
                                If UBound(doCmdParts) >= 0 Then
                                    Dim targetQry As String
                                    targetQry = CleanQuotedArg(Trim$(doCmdParts(0)))
                                    If Len(targetQry) > 0 Then
                                        RequestOpenQuery targetQry
                                        If Len(outExecutedMsg) > 0 Then outExecutedMsg = outExecutedMsg & vbCrLf
                                        outExecutedMsg = outExecutedMsg & "DoCmd.OpenQuery [" & targetQry & "]"
                                    End If
                                End If
                            Case "RUNSQL"
                                If UBound(doCmdParts) >= 0 And Not m_database Is Nothing Then
                                    Dim sqlToRun As String
                                    sqlToRun = CleanQuotedArg(Trim$(doCmdParts(0)))
                                    If Len(sqlToRun) > 0 Then
                                        On Error Resume Next
                                        m_database.Execute sqlToRun
                                        On Error GoTo 0
                                        If Len(outExecutedMsg) > 0 Then outExecutedMsg = outExecutedMsg & vbCrLf
                                        outExecutedMsg = outExecutedMsg & "DoCmd.RunSQL: " & sqlToRun
                                    End If
                                End If
                            Case "GOTORECORD"
                                Dim recAction As String
                                recAction = UCase$( doCmdArgsStr )
                                If InStr(1, recAction, "ACFIRST") > 0 Then
                                    StudioController.MoveFirst
                                ElseIf InStr(1, recAction, "ACLAST") > 0 Then
                                    StudioController.MoveLast
                                ElseIf InStr(1, recAction, "ACPREVIOUS") > 0 Then
                                    StudioController.MovePrevious
                                Else
                                    StudioController.MoveNext
                                End If
                            Case "BEEP"
                                Beep
                        End Select

                    ' 3. Handle Call <ProcName> or direct <ProcName> invocation across all database Modules
                    Else
                        calledProc = vbNullString
                        If Left$(upperStmt, 5) = "CALL " Then
                            calledProc = Trim$(Mid$(stmt, 6))
                        ElseIf InStr(stmt, " ") = 0 And InStr(stmt, "=") = 0 And InStr(stmt, ".") = 0 Then
                            calledProc = stmt
                        End If

                        If Len(calledProc) > 0 Then
                            pOpen = InStr(calledProc, "(")
                            If pOpen > 1 Then calledProc = Trim$(Left$(calledProc, pOpen - 1))

                            If InStr(1, moduleCode, "Sub " & calledProc, vbTextCompare) > 0 Or InStr(1, moduleCode, "Function " & calledProc, vbTextCompare) > 0 Then
                                ExecuteVbaProcedure moduleCode, calledProc, showDialog, outExecutedMsg, outErrorMsg
                            Else
                                Set modNames = GetCustomObjectNames("MODULE")
                                For Each mItem In modNames
                                    extCode = GetNativeVbaModuleCode(CStr(mItem))
                                    If Len(Trim$(extCode)) = 0 Then
                                        extCode = GetCustomObjectDefinition("MODULE", CStr(mItem), srcDummy, errDummy)
                                    End If
                                    If Len(Trim$(extCode)) > 0 Then
                                        If InStr(1, extCode, "Sub " & calledProc, vbTextCompare) > 0 Or InStr(1, extCode, "Function " & calledProc, vbTextCompare) > 0 Then
                                            ExecuteVbaProcedure extCode, calledProc, showDialog, outExecutedMsg, outErrorMsg
                                            Exit For
                                        End If
                                    End If
                                Next mItem
                            End If
                        End If
                    End If
                End If
            End If
        Next i

        ExecuteVbaProcedure = foundTargetProc
    End Function

    Public Function IsNativeModuleActive() As Boolean
        IsNativeModuleActive = (Len(Trim$(m_activeModuleName)) > 0)
    End Function

    Public Function GetCleanVbaModuleCode(ByVal moduleName As String, ByRef outObjName As String, ByRef outProcName As String) As String
        Dim rawCode As String
        Dim srcDummy As String
        Dim errDummy As String
        Dim lines() As String
        Dim i As Long
        Dim ln As String
        Dim upperLn As String
        Dim cleanText As String
        Dim pStart As Long
        Dim pOpen As Long
        Dim fullProc As String
        Dim uPos As Long

        outObjName = "(General)"
        outProcName = "(Declarations)"
        GetCleanVbaModuleCode = vbNullString

        If m_database Is Nothing Or Len(Trim$(moduleName)) = 0 Then Exit Function

        rawCode = GetNativeVbaModuleCode(moduleName)
        If Len(Trim$(rawCode)) = 0 Then
            rawCode = GetCustomObjectDefinition("MODULE", moduleName, srcDummy, errDummy)
        End If
        If Len(Trim$(rawCode)) = 0 And Left$(UCase$(moduleName), 4) = "MOD_" Then
            rawCode = GetNativeVbaModuleCode(Mid$(moduleName, 5))
            If Len(Trim$(rawCode)) = 0 Then
                rawCode = GetNativeVbaModuleCode("Form_" & Mid$(moduleName, 5))
            End If
        End If
        If Len(Trim$(rawCode)) = 0 Then Exit Function

        cleanText = vbNullString
        lines = Split(rawCode, vbCrLf)
        For i = 0 To UBound(lines)
            ln = lines(i)
            upperLn = UCase$(Trim$(ln))
            If Left$(upperLn, 10) <> "ATTRIBUTE " Then
                If Len(cleanText) > 0 Or Len(Trim$(ln)) > 0 Then
                    If Len(cleanText) > 0 Then cleanText = cleanText & vbCrLf
                    cleanText = cleanText & ln
                End If

                If outProcName = "(Declarations)" Then
                    pStart = 0
                    If Left$(upperLn, 4) = "SUB " Then
                        pStart = 5
                    ElseIf Left$(upperLn, 11) = "PUBLIC SUB " Then
                        pStart = 12
                    ElseIf Left$(upperLn, 12) = "PRIVATE SUB " Then
                        pStart = 13
                    ElseIf Left$(upperLn, 9) = "FUNCTION " Then
                        pStart = 10
                    ElseIf Left$(upperLn, 16) = "PUBLIC FUNCTION " Then
                        pStart = 17
                    ElseIf Left$(upperLn, 17) = "PRIVATE FUNCTION " Then
                        pStart = 18
                    End If

                    If pStart > 0 Then
                        fullProc = Trim$(Mid$(Trim$(ln), pStart))
                        pOpen = InStr(fullProc, "(")
                        If pOpen > 1 Then fullProc = Trim$(Left$(fullProc, pOpen - 1))
                        uPos = InStr(fullProc, "_")
                        If uPos > 1 Then
                            outObjName = Left$(fullProc, uPos - 1)
                            outProcName = Mid$(fullProc, uPos + 1)
                        Else
                            outObjName = "(General)"
                            outProcName = fullProc
                        End If
                    End If
                End If
            End If
        Next i

        GetCleanVbaModuleCode = cleanText
    End Function

    Public Function ResolveFieldLookupValue(ByVal tableName As String, ByVal fieldName As String, ByVal rawVal As Variant, Optional ByRef outHasLookup As Boolean = False, Optional ByRef outLookupOptions As String = "") As String
        Dim i As Long
        Dim qDef As Object
        Dim qName As String
        Dim rs As Object
        Dim kVal As String
        Dim dVal As String
        Dim rawStr As String
        Dim matchedDisp As String
        Dim relLookups As Collection
        Dim lkItem As Variant
        Dim lkParts() As String

        outHasLookup = False
        outLookupOptions = vbNullString
        If IsNull(rawVal) Then
            ResolveFieldLookupValue = vbNullString
        Else
            ResolveFieldLookupValue = CStr(rawVal)
        End If

        If m_database Is Nothing Or Len(Trim$(tableName)) = 0 Or Len(Trim$(fieldName)) = 0 Then Exit Function
        rawStr = ResolveFieldLookupValue
        matchedDisp = rawStr

        ' Never treat a table's own Primary Key / AutoNumber column as a Foreign Key lookup
        On Error Resume Next
        Dim tdCheck As Object
        Dim fldCheck As Object
        Set tdCheck = m_database.TableDefs(tableName)
        If Not tdCheck Is Nothing Then
            Set fldCheck = tdCheck.Fields(fieldName)
            If Not fldCheck Is Nothing Then
                If (fldCheck.Attributes And &H10&) <> 0 Then
                    On Error GoTo 0
                    Exit Function
                End If
                If Right$(UCase$(Trim$(fieldName)), 2) = "ID" And Len(Trim$(fieldName)) > 2 Then
                    Dim fStem As String
                    fStem = Left$(Trim$(fieldName), Len(Trim$(fieldName)) - 2)
                    If StrComp(fStem, tableName, vbTextCompare) = 0 Or StrComp(fStem & "s", tableName, vbTextCompare) = 0 Or StrComp(fStem & "es", tableName, vbTextCompare) = 0 Then
                        On Error GoTo 0
                        Exit Function
                    End If
                End If
            End If
        End If
        Err.Clear

        ' 1. Check Access internal lookup QueryDefs (~sq_c<FormOrTable>~sq_c<Field>)
        For i = 0 To m_database.QueryDefs.Count - 1
            Set qDef = m_database.QueryDefs(i)
            If Not qDef Is Nothing Then
                qName = qDef.Name
                If Left$(qName, 4) = "~sq_" And InStr(1, qName, "~sq_c" & tableName & "~", vbTextCompare) > 0 And InStr(1, qName, "~sq_c" & fieldName, vbTextCompare) > 0 Then
                    Set rs = m_database.OpenRecordset(qDef.SQL)
                    If Err.Number = 0 And Not rs Is Nothing Then
                        If rs.Fields.Count >= 2 Then
                            outHasLookup = True
                            Do Until rs.EOF
                                kVal = CStr(rs.Fields(0).Value)
                                dVal = CStr(rs.Fields(1).Value)
                                If Len(outLookupOptions) > 0 Then outLookupOptions = outLookupOptions & " | "
                                outLookupOptions = outLookupOptions & dVal
                                If UCase$(Trim$(kVal)) = UCase$(Trim$(rawStr)) Or UCase$(Trim$(dVal)) = UCase$(Trim$(rawStr)) Then
                                    matchedDisp = dVal
                                End If
                                rs.MoveNext
                            Loop
                        End If
                        rs.Close
                        If outHasLookup Then
                            On Error GoTo 0
                            ResolveFieldLookupValue = matchedDisp
                            Exit Function
                        End If
                    End If
                End If
            End If
        Next i

        ' 2. Check DAO Foreign Key Relations
        Set relLookups = GetTableLookups(tableName)
        For Each lkItem In relLookups
            lkParts = Split(CStr(lkItem), "|")
            If UBound(lkParts) >= 2 Then
                If UCase$(Trim$(lkParts(0))) = UCase$(Trim$(fieldName)) Then
                    Set rs = m_database.OpenRecordset("SELECT * FROM [" & lkParts(1) & "];")
                    If Err.Number = 0 And Not rs Is Nothing Then
                        If rs.Fields.Count >= 2 Then
                            outHasLookup = True
                            Do Until rs.EOF
                                kVal = CStr(rs.Fields(0).Value)
                                dVal = CStr(rs.Fields(1).Value)
                                If Len(outLookupOptions) > 0 Then outLookupOptions = outLookupOptions & " | "
                                outLookupOptions = outLookupOptions & dVal
                                If UCase$(Trim$(kVal)) = UCase$(Trim$(rawStr)) Or UCase$(Trim$(dVal)) = UCase$(Trim$(rawStr)) Then
                                    matchedDisp = dVal
                                End If
                                rs.MoveNext
                            Loop
                        End If
                        rs.Close
                    End If
                    Exit For
                End If
            End If
        Next lkItem
        On Error GoTo 0

        ResolveFieldLookupValue = matchedDisp
    End Function

    Public Function ConvertLookupDisplayToKey(ByVal tableName As String, ByVal fieldName As String, ByVal displayOrKey As String) As String
        Dim i As Long
        Dim qDef As Object
        Dim qName As String
        Dim rs As Object
        Dim kVal As String
        Dim dVal As String

        ConvertLookupDisplayToKey = displayOrKey
        If m_database Is Nothing Or Len(Trim$(displayOrKey)) = 0 Then Exit Function

        On Error Resume Next
        For i = 0 To m_database.QueryDefs.Count - 1
            Set qDef = m_database.QueryDefs(i)
            If Not qDef Is Nothing Then
                qName = qDef.Name
                If Left$(qName, 4) = "~sq_" And InStr(1, qName, "~sq_c" & tableName & "~", vbTextCompare) > 0 And InStr(1, qName, "~sq_c" & fieldName, vbTextCompare) > 0 Then
                    Set rs = m_database.OpenRecordset(qDef.SQL)
                    If Err.Number = 0 And Not rs Is Nothing Then
                        If rs.Fields.Count >= 2 Then
                            Do Until rs.EOF
                                kVal = CStr(rs.Fields(0).Value)
                                dVal = CStr(rs.Fields(1).Value)
                                If UCase$(Trim$(dVal)) = UCase$(Trim$(displayOrKey)) Or UCase$(Trim$(kVal)) = UCase$(Trim$(displayOrKey)) Then
                                    ConvertLookupDisplayToKey = kVal
                                    rs.Close
                                    On Error GoTo 0
                                    Exit Function
                                End If
                                rs.MoveNext
                            Loop
                        End If
                        rs.Close
                    End If
                End If
            End If
        Next i

        Dim relLookups As Collection
        Dim lkItem As Variant
        Dim lkParts() As String
        Set relLookups = GetTableLookups(tableName)
        For Each lkItem In relLookups
            lkParts = Split(CStr(lkItem), "|")
            If UBound(lkParts) >= 2 Then
                If UCase$(Trim$(lkParts(0))) = UCase$(Trim$(fieldName)) Then
                    Set rs = m_database.OpenRecordset("SELECT * FROM [" & lkParts(1) & "];")
                    If Err.Number = 0 And Not rs Is Nothing Then
                        If rs.Fields.Count >= 2 Then
                            Do Until rs.EOF
                                kVal = CStr(rs.Fields(0).Value)
                                dVal = CStr(rs.Fields(1).Value)
                                If UCase$(Trim$(dVal)) = UCase$(Trim$(displayOrKey)) Or UCase$(Trim$(kVal)) = UCase$(Trim$(displayOrKey)) Then
                                    ConvertLookupDisplayToKey = kVal
                                    rs.Close
                                    On Error GoTo 0
                                    Exit Function
                                End If
                                rs.MoveNext
                            Loop
                        End If
                        rs.Close
                    End If
                    Exit For
                End If
            End If
        Next lkItem
        On Error GoTo 0
    End Function

    Public Function GetFormPropertySheetLines(ByVal formOrTableName As String) As Collection
        Dim props As New Collection
        Dim recSrc As String
        Dim ctrls As Collection
        Dim btnName As String
        Dim btnCap As String
        Dim vbaCode As String
        Dim cItem As Variant
        Dim parts() As String
        Dim viewCode As Long
        Dim viewName As String

        If m_database Is Nothing Then
            Set GetFormPropertySheetLines = props
            Exit Function
        End If

        If Len(Trim$(m_activeFormName)) > 0 Then
            If InspectNativeAccessForm(m_activeFormName, recSrc, ctrls, btnName, btnCap, vbaCode) Then
                props.Add "Form Name       : " & m_activeFormName
                props.Add "Record Source   : " & recSrc
                If m_inspectLayoutValid Then
                    viewCode = m_inspectLayout.DefaultView
                Else
                    viewCode = 0
                End If
                Select Case viewCode
                    Case 1: viewName = "Continuous Forms"
                    Case 2: viewName = "Datasheet"
                    Case 3: viewName = "PivotTable"
                    Case 4: viewName = "PivotChart"
                    Case 5: viewName = "Split Form"
                    Case Else: viewName = "Single Form"
                End Select
                props.Add "Default View    : " & viewName
                For Each cItem In ctrls
                    parts = Split(CStr(cItem), "|")
                    If UBound(parts) >= 1 Then
                        props.Add parts(0) & " [" & parts(1) & "]"
                    End If
                Next cItem
                If Len(btnName) > 0 Then
                    props.Add "Button Name     : " & btnName
                    props.Add "Button Caption  : " & btnCap
                    props.Add "On Click        : [Event Procedure]"
                End If
                Set GetFormPropertySheetLines = props
                Exit Function
            End If
        End If

        props.Add "Object Name     : " & formOrTableName
        props.Add "Record Source   : " & m_activeTableName
        props.Add "Total Records   : " & CStr(m_totalRecords)
        props.Add "Active Record   : #" & CStr(m_currentRecordIndex)
        Set GetFormPropertySheetLines = props
    End Function

    Public Function GetVisualQbeGridLines(ByVal queryName As String, ByRef outSql As String) As Collection
        Dim lines As New Collection
        Dim errMsg As String
        Dim rs As Object
        Dim i As Long
        Dim fLine As String
        Dim tLine As String
        Dim sLine As String
        Dim shLine As String
        Dim crLine As String
        Dim colName As String
        Dim srcTbl As String

        outSql = GetSavedQuerySql(queryName, errMsg)
        If Len(Trim$(outSql)) = 0 Then
            outSql = "SELECT * FROM [" & queryName & "];"
        End If

        lines.Add "================================================================================"
        lines.Add "  MICROSOFT ACCESS VISUAL QUERY DESIGNER (QBE - Query By Example)"
        lines.Add "  Active Query: [" & queryName & "]"
        lines.Add "================================================================================"
        lines.Add "  [TABLE DIAGRAM & JOINPANE]:"
        lines.Add "  " & Replace$(Replace$(Trim$(outSql), vbCr, " "), vbLf, " ")
        lines.Add "--------------------------------------------------------------------------------"

        fLine = "  Field:    "
        tLine = "  Table:    "
        sLine = "  Sort:     "
        shLine = "  Show:     "
        crLine = "  Criteria: "

        On Error Resume Next
        Set rs = m_database.OpenRecordset(outSql)
        If Err.Number = 0 And Not rs Is Nothing Then
            For i = 0 To rs.Fields.Count - 1
                colName = rs.Fields(i).Name
                srcTbl = rs.Fields(i).SourceTable
                If Len(Trim$(srcTbl)) = 0 Then srcTbl = queryName
                fLine = fLine & "| " & Left$(colName & Space$(16), 16) & " "
                tLine = tLine & "| " & Left$(srcTbl & Space$(16), 16) & " "
                sLine = sLine & "| (not sorted)     "
                shLine = shLine & "| [X] Show         "
                crLine = crLine & "|                  "
            Next i
            rs.Close
        End If
        On Error GoTo 0

        lines.Add fLine & "|"
        lines.Add tLine & "|"
        lines.Add sLine & "|"
        lines.Add shLine & "|"
        lines.Add crLine & "|"
        lines.Add "================================================================================"

        Set GetVisualQbeGridLines = lines
    End Function

    Private Function DummyKeepBalance() As Boolean
        DummyKeepBalance = True
    End Function

    ' =========================================================================
    ' Phase 21: External Data Import/Export Suite (CSV Import & SQL Script Dump)
    ' =========================================================================
    Private Function SplitCsvLine(ByVal lineStr As String) As Collection
        Dim cols As New Collection
        Dim i As Long
        Dim ch As String
        Dim inQuotes As Boolean
        Dim curVal As String

        inQuotes = False
        curVal = ""
        i = 1
        Do While i <= Len(lineStr)
            ch = Mid$(lineStr, i, 1)
            If ch = """" Then
                If inQuotes And i < Len(lineStr) And Mid$(lineStr, i + 1, 1) = """" Then
                    curVal = curVal & """"
                    i = i + 1
                Else
                    inQuotes = Not inQuotes
                End If
            ElseIf ch = "," And Not inQuotes Then
                cols.Add curVal
                curVal = ""
            Else
                curVal = curVal & ch
            End If
            i = i + 1
        Loop
        cols.Add curVal

        Set SplitCsvLine = cols
    End Function

    Public Function ImportCsvToTable(ByVal csvFilePath As String, ByVal targetTableName As String, ByVal createTableIfMissing As Boolean, ByRef outRowsImported As Long, ByRef outErrorMsg As String) As Boolean
        Dim fNum As Integer
        Dim lineText As String
        Dim headers As Collection
        Dim vals As Collection
        Dim i As Long
        Dim colDefs As String
        Dim fieldList As String
        Dim valList As String
        Dim cellVal As String
        Dim td As Object
        Dim tableExists As Boolean

        outRowsImported = 0
        outErrorMsg = vbNullString
        If m_database Is Nothing Then
            outErrorMsg = "No database open."
            ImportCsvToTable = False
            Exit Function
        End If

        If Not PalManager.FS.FileExists(csvFilePath) Then
            outErrorMsg = "CSV file not found: " & csvFilePath
            ImportCsvToTable = False
            Exit Function
        End If

        On Error Resume Next
        fNum = FreeFile
        Open csvFilePath For Input As #fNum
        If Err.Number <> 0 Then
            outErrorMsg = "Cannot open CSV file: " & Err.Description
            ImportCsvToTable = False
            Exit Function
        End If

        If EOF(fNum) Then
            Close #fNum
            outErrorMsg = "CSV file is empty."
            ImportCsvToTable = False
            Exit Function
        End If

        Line Input #fNum, lineText
        Set headers = SplitCsvLine(lineText)
        If headers.Count = 0 Then
            Close #fNum
            outErrorMsg = "Invalid CSV header."
            ImportCsvToTable = False
            Exit Function
        End If

        tableExists = False
        Set td = m_database.TableDefs(targetTableName)
        If Err.Number = 0 And Not td Is Nothing Then
            tableExists = True
        End If
        Err.Clear

        If Not tableExists And createTableIfMissing Then
            colDefs = ""
            For i = 1 To headers.Count
                If i > 1 Then colDefs = colDefs & ", "
                colDefs = colDefs & "[" & CStr(headers(i)) & "] TEXT(255)"
            Next i
            m_database.Execute "CREATE TABLE [" & targetTableName & "] (" & colDefs & ");"
            If Err.Number <> 0 Then
                outErrorMsg = "Failed to create table for CSV import: " & Err.Description
                Close #fNum
                ImportCsvToTable = False
                Exit Function
            End If
            m_database.TableDefs.Refresh
        End If

        fieldList = ""
        For i = 1 To headers.Count
            If i > 1 Then fieldList = fieldList & ", "
            fieldList = fieldList & "[" & CStr(headers(i)) & "]"
        Next i

        Do Until EOF(fNum)
            Line Input #fNum, lineText
            If Len(Trim$(lineText)) > 0 Then
                Set vals = SplitCsvLine(lineText)
                valList = ""
                For i = 1 To headers.Count
                    If i > 1 Then valList = valList & ", "
                    If i <= vals.Count Then
                        cellVal = CStr(vals(i))
                    Else
                        cellVal = ""
                    End If
                    If Len(cellVal) = 0 Then
                        valList = valList & "NULL"
                    ElseIf IsNumeric(cellVal) And Not tableExists Then
                        valList = valList & "'" & Replace$(cellVal, "'", "''") & "'"
                    ElseIf IsNumeric(cellVal) Then
                        valList = valList & cellVal
                    Else
                        valList = valList & "'" & Replace$(cellVal, "'", "''") & "'"
                    End If
                Next i

                Err.Clear
                m_database.Execute "INSERT INTO [" & targetTableName & "] (" & fieldList & ") VALUES (" & valList & ");"
                If Err.Number = 0 Then
                    outRowsImported = outRowsImported + 1
                End If
            End If
        Loop

        Close #fNum
        On Error GoTo 0

        ImportCsvToTable = True
    End Function

    Public Function ExportDatabaseToSqlScript(ByVal targetSqlPath As String, ByRef outTablesExported As Long, ByRef outRowsExported As Long, ByRef outErrorMsg As String) As Boolean
        Dim fNum As Integer
        Dim tblNames As Collection
        Dim tVar As Variant
        Dim tName As String
        Dim td As Object
        Dim rs As Object
        Dim i As Long
        Dim colDefs As String
        Dim colList As String
        Dim valList As String
        Dim fVal As Variant
        Dim sqlType As String

        outTablesExported = 0
        outRowsExported = 0
        outErrorMsg = vbNullString

        If m_database Is Nothing Then
            outErrorMsg = "No database open."
            ExportDatabaseToSqlScript = False
            Exit Function
        End If

        On Error Resume Next
        fNum = FreeFile
        Open targetSqlPath For Output As #fNum
        If Err.Number <> 0 Then
            outErrorMsg = "Cannot open SQL script file for writing: " & Err.Description
            ExportDatabaseToSqlScript = False
            Exit Function
        End If

        Print #fNum, "-- OpenAccess Studio Portable SQL Database Dump"
        Print #fNum, "-- Source Database: " & m_dbPath
        Print #fNum, "-- Generated At   : " & Format$(Now, "YYYY-MM-DD HH:NN:SS")
        Print #fNum, ""

        Set tblNames = GetTableNames()
        For Each tVar In tblNames
            tName = CStr(tVar)
            Set td = m_database.TableDefs(tName)
            If Not td Is Nothing Then
                outTablesExported = outTablesExported + 1
                colDefs = ""
                colList = ""
                For i = 0 To td.Fields.Count - 1
                    If i > 0 Then
                        colDefs = colDefs & ", "
                        colList = colList & ", "
                    End If
                    colList = colList & "[" & td.Fields(i).Name & "]"
                    Select Case CInt(td.Fields(i).Type)
                        Case 1: sqlType = "YESNO"
                        Case 2, 3: sqlType = "INTEGER"
                        Case 4: sqlType = "LONG"
                        Case 5: sqlType = "CURRENCY"
                        Case 6, 7: sqlType = "DOUBLE"
                        Case 8: sqlType = "DATETIME"
                        Case 11: sqlType = "MEMO"
                        Case Else: sqlType = "TEXT(" & CStr(td.Fields(i).Size) & ")"
                    End Select
                    colDefs = colDefs & "[" & td.Fields(i).Name & "] " & sqlType
                Next i

                Print #fNum, "CREATE TABLE [" & tName & "] (" & colDefs & ");"

                Set rs = m_database.OpenRecordset("SELECT * FROM [" & tName & "]")
                If Not rs Is Nothing Then
                    Do Until rs.EOF
                        valList = ""
                        For i = 0 To rs.Fields.Count - 1
                            If i > 0 Then valList = valList & ", "
                            fVal = rs.Fields(i).Value
                            If IsNull(fVal) Then
                                valList = valList & "NULL"
                            ElseIf IsNumeric(fVal) And rs.Fields(i).Type <> 10 And rs.Fields(i).Type <> 11 Then
                                valList = valList & CStr(fVal)
                            Else
                                valList = valList & "'" & Replace$(CStr(fVal), "'", "''") & "'"
                            End If
                        Next i
                        Print #fNum, "INSERT INTO [" & tName & "] (" & colList & ") VALUES (" & valList & ");"
                        outRowsExported = outRowsExported + 1
                        rs.MoveNext
                    Loop
                    rs.Close
                End If
                Print #fNum, ""
            End If
        Next tVar

        Close #fNum
        On Error GoTo 0

        ExportDatabaseToSqlScript = True
    End Function

    ' =========================================================================
    ' Phase 22: Database Documenter, Object Dependencies & Table Analyzer
    ' =========================================================================
    Public Function GetDatabaseDocumenterLines(ByRef outErrorMsg As String) As Collection
        Dim lines As New Collection
        Dim tbls As Collection
        Dim qrys As Collection
        Dim tItem As Variant
        Dim tName As String
        Dim td As Object
        Dim qDef As Object
        Dim i As Long
        Dim rCnt As Long

        outErrorMsg = vbNullString
        If m_database Is Nothing Then
            outErrorMsg = "No database open."
            Set GetDatabaseDocumenterLines = lines
            Exit Function
        End If

        lines.Add "================================================================================"
        lines.Add "  OPENACCESS STUDIO - COMPLETE DATABASE DOCUMENTER SPECIFICATION"
        lines.Add "  Database File : " & m_dbPath
        lines.Add "  DAO Engine    : v" & m_engineVersion
        lines.Add "  Documented At : " & Format$(Now, "YYYY-MM-DD HH:NN:SS")
        lines.Add "================================================================================"

        Set tbls = GetTableNames()
        lines.Add "  1. USER TABLES CATALOG (" & CStr(tbls.Count) & " Tables):"
        lines.Add "  " & String$(76, "-")

        On Error Resume Next
        For Each tItem In tbls
            tName = CStr(tItem)
            Set td = m_database.TableDefs(tName)
            rCnt = DCount("*", tName)
            lines.Add "  * TABLE: [" & tName & "] (Records: " & CStr(rCnt) & ", Columns: " & CStr(td.Fields.Count) & ", Indexes: " & CStr(td.Indexes.Count) & ")"
            For i = 0 To td.Fields.Count - 1
                lines.Add "      - " & td.Fields(i).Name & " : " & GetDaoDataTypeName(CInt(td.Fields(i).Type)) & " (Size=" & CStr(td.Fields(i).Size) & ")"
            Next i
        Next tItem

        lines.Add ""
        Set qrys = GetQueryNames()
        lines.Add "  2. SAVED QUERIES CATALOG (" & CStr(qrys.Count) & " Queries):"
        lines.Add "  " & String$(76, "-")
        If qrys.Count = 0 Then
            lines.Add "  (No saved QueryDefs in this database.)"
        Else
            For Each tItem In qrys
                tName = CStr(tItem)
                Set qDef = m_database.QueryDefs(tName)
                If Not qDef Is Nothing Then
                    lines.Add "  * QUERY: [" & tName & "]"
                    lines.Add "      SQL: " & Trim$(Replace$(Replace$(qDef.SQL, vbCr, " "), vbLf, " "))
                End If
            Next tItem
        End If

        lines.Add ""
        lines.Add "  3. RELATIONSHIPS & INTEGRITY RULES:"
        lines.Add "  " & String$(76, "-")
        Dim relLines As Collection
        Set relLines = GetRelationshipLines(outErrorMsg)
        For Each tItem In relLines
            lines.Add "  " & CStr(tItem)
        Next tItem
        On Error GoTo 0

        lines.Add "================================================================================"
        Set GetDatabaseDocumenterLines = lines
    End Function

    Public Function GetObjectDependenciesLines(ByVal targetObjectName As String, ByRef outErrorMsg As String) As Collection
        Dim lines As New Collection
        Dim i As Long
        Dim rel As Object
        Dim qDef As Object
        Dim depCount As Long
        Dim upperTarget As String

        outErrorMsg = vbNullString
        If m_database Is Nothing Then
            outErrorMsg = "No database open."
            Set GetObjectDependenciesLines = lines
            Exit Function
        End If

        upperTarget = UCase$(Trim$(targetObjectName))
        depCount = 0

        lines.Add "================================================================================"
        lines.Add "  OBJECT DEPENDENCIES & IMPACT ANALYSIS FOR: [" & targetObjectName & "]"
        lines.Add "================================================================================"
        lines.Add "  A. UPSTREAM DEPENDENCIES (Objects that [" & targetObjectName & "] depends on):"
        lines.Add "  " & String$(76, "-")

        On Error Resume Next
        For i = 0 To m_database.Relations.Count - 1
            Set rel = m_database.Relations(i)
            If Not rel Is Nothing Then
                If UCase$(rel.ForeignTable) = upperTarget Then
                    lines.Add "    -> Parent Table: [" & rel.Table & "] via Relation [" & rel.Name & "]"
                    depCount = depCount + 1
                End If
            End If
        Next i

        lines.Add ""
        lines.Add "  B. DOWNSTREAM DEPENDENTS (Objects that depend on [" & targetObjectName & "]):"
        lines.Add "  " & String$(76, "-")

        For i = 0 To m_database.Relations.Count - 1
            Set rel = m_database.Relations(i)
            If Not rel Is Nothing Then
                If UCase$(rel.Table) = upperTarget Then
                    lines.Add "    <- Child Table: [" & rel.ForeignTable & "] via Relation [" & rel.Name & "]"
                    depCount = depCount + 1
                End If
            End If
        Next i

        For i = 0 To m_database.QueryDefs.Count - 1
            Set qDef = m_database.QueryDefs(i)
            If Not qDef Is Nothing Then
                If Left$(qDef.Name, 4) <> "~TMP" Then
                    If InStr(1, UCase$(qDef.SQL), upperTarget) > 0 Then
                        lines.Add "    <- Saved Query: [" & qDef.Name & "] references [" & targetObjectName & "]"
                        depCount = depCount + 1
                    End If
                End If
            End If
        Next i
        On Error GoTo 0

        If depCount = 0 Then
            lines.Add "    (No direct relationship or query dependencies detected for [" & targetObjectName & "].)"
        End If

        lines.Add "================================================================================"
        lines.Add "  Total Dependency Links Found: " & CStr(depCount)
        lines.Add "================================================================================"

        Set GetObjectDependenciesLines = lines
    End Function

    Public Function GetTableAnalyzerLines(ByVal tableName As String, ByRef outErrorMsg As String) As Collection
        Dim lines As New Collection
        Dim td As Object
        Dim idx As Object
        Dim fld As Object
        Dim hasPk As Boolean
        Dim indexedCols As New Collection
        Dim i As Long
        Dim k As Long
        Dim fName As String
        Dim totalRows As Long
        Dim nullCnt As Long
        Dim recCount As Long

        outErrorMsg = vbNullString
        If m_database Is Nothing Then
            outErrorMsg = "No database open."
            Set GetTableAnalyzerLines = lines
            Exit Function
        End If

        On Error Resume Next
        Set td = m_database.TableDefs(tableName)
        If Err.Number <> 0 Or td Is Nothing Then
            outErrorMsg = "Table not found: " & tableName
            Set GetTableAnalyzerLines = lines
            Exit Function
        End If

        hasPk = False
        For i = 0 To td.Indexes.Count - 1
            Set idx = td.Indexes(i)
            If Not idx Is Nothing Then
                If idx.Primary Then hasPk = True
                For k = 0 To idx.Fields.Count - 1
                    indexedCols.Add idx.Fields(k).Name, UCase$(idx.Fields(k).Name)
                Next k
            End If
        Next i

        totalRows = DCount("*", tableName)
        recCount = 0

        lines.Add "================================================================================"
        lines.Add "  TABLE & PERFORMANCE ANALYZER DIAGNOSTIC: [" & tableName & "]"
        lines.Add "  Total Rows Analyzed: " & CStr(totalRows)
        lines.Add "================================================================================"

        If hasPk Then
            lines.Add "  [PASS] Primary Key Check: Table has an active Primary Key index."
        Else
            lines.Add "  [RECOMMENDATION] Missing Primary Key: Add an AutoNumber Primary Key via 'Modify Schema'."
            recCount = recCount + 1
        End If

        For i = 0 To td.Fields.Count - 1
            Set fld = td.Fields(i)
            fName = fld.Name
            If Right$(UCase$(fName), 2) = "ID" And UCase$(fName) <> "ID" Then
                Dim isIdx As Boolean
                isIdx = False
                Err.Clear
                If Len(indexedCols(UCase$(fName))) > 0 Then isIdx = True
                If Err.Number <> 0 Then isIdx = False
                Err.Clear
                If Not isIdx Then
                    lines.Add "  [RECOMMENDATION] Foreign Key Candidate [" & fName & "] is not indexed. Consider creating an index for faster joins."
                    recCount = recCount + 1
                Else
                    lines.Add "  [PASS] Foreign Key Column [" & fName & "] is properly indexed."
                End If
            End If

            If totalRows > 0 Then
                nullCnt = DCount("*", tableName, "[" & fName & "] IS NULL")
                If nullCnt > 0 Then
                    lines.Add "  [INFO] Field [" & fName & "]: " & CStr(nullCnt) & " of " & CStr(totalRows) & " row(s) contain NULL values."
                End If
            End If
        Next i
        On Error GoTo 0

        lines.Add "================================================================================"
        lines.Add "  Optimization Recommendations Count: " & CStr(recCount)
        lines.Add "================================================================================"

        Set GetTableAnalyzerLines = lines
    End Function

    ' =========================================================================
    ' Phase 23: Datasheet Power Tools (Sort, Filter, Find & Replace, Totals Row)
    ' =========================================================================
    Public Function SortActiveDatasheet(ByVal columnName As String, ByVal isDescending As Boolean, ByRef outErrorMsg As String) As Boolean
        If Len(Trim$(m_activeTableName)) = 0 Or m_activeTableName = "SQL Query Result" Then
            outErrorMsg = "Select a table first before sorting."
            SortActiveDatasheet = False
            Exit Function
        End If

        If Len(Trim$(columnName)) = 0 Then
            m_activeSortClause = vbNullString
        ElseIf isDescending Then
            m_activeSortClause = "[" & columnName & "] DESC"
        Else
            m_activeSortClause = "[" & columnName & "] ASC"
        End If

        SortActiveDatasheet = OpenTable(m_activeTableName, outErrorMsg)
    End Function

    Public Function FilterActiveDatasheet(ByVal filterCriteria As String, ByRef outErrorMsg As String) As Boolean
        If Len(Trim$(m_activeTableName)) = 0 Or m_activeTableName = "SQL Query Result" Then
            outErrorMsg = "Select a table first before filtering."
            FilterActiveDatasheet = False
            Exit Function
        End If

        m_activeFilterClause = Trim$(filterCriteria)
        FilterActiveDatasheet = OpenTable(m_activeTableName, outErrorMsg)
    End Function

    Public Function ApplyFormFilter(ByVal formName As String, ByVal filterClause As String, ByVal filterOn As Boolean, ByRef outErrorMsg As String) As Boolean
        Dim src As String
        Dim sql As String

        ApplyFormFilter = False
        outErrorMsg = vbNullString

        src = Trim$(m_activeTableName)
        If Len(src) = 0 Then
            outErrorMsg = "No active form table or query."
            Exit Function
        End If

        If filterOn And Len(Trim$(filterClause)) > 0 Then
            m_activeFilterClause = Trim$(filterClause)
        Else
            m_activeFilterClause = vbNullString
        End If

        If IsSqlRecordSource(src) Then
            If Len(m_activeFilterClause) > 0 Then
                sql = "SELECT * FROM (" & src & ") AS [_FilterSub] WHERE " & m_activeFilterClause
            Else
                sql = src
            End If
            ApplyFormFilter = ExecuteSqlQuery(sql, outErrorMsg)
        Else
            ApplyFormFilter = OpenTable(src, outErrorMsg)
        End If
    End Function

    Public Function GetActiveFilterClause() As String
        GetActiveFilterClause = m_activeFilterClause
    End Function

    Public Function IsActiveFilterOn() As Boolean
        IsActiveFilterOn = (Len(Trim$(m_activeFilterClause)) > 0)
    End Function

    Public Function FindAndReplaceInTable(ByVal tableName As String, ByVal columnName As String, ByVal findText As String, ByVal replaceText As String, ByVal doReplace As Boolean, ByRef outMatchedRows As Long, ByRef outUpdatedRows As Long, ByRef outErrorMsg As String) As Boolean
        Dim rs As Object
        Dim fVal As Variant
        Dim strVal As String

        outMatchedRows = 0
        outUpdatedRows = 0
        outErrorMsg = vbNullString

        If m_database Is Nothing Then
            outErrorMsg = "No database open."
            FindAndReplaceInTable = False
            Exit Function
        End If

        On Error Resume Next
        Set rs = m_database.OpenRecordset("SELECT * FROM [" & tableName & "]")
        If Err.Number <> 0 Or rs Is Nothing Then
            outErrorMsg = "Cannot open table [" & tableName & "]: " & Err.Description
            FindAndReplaceInTable = False
            Exit Function
        End If

        Do Until rs.EOF
            fVal = rs.Fields(columnName).Value
            If Not IsNull(fVal) Then
                strVal = CStr(fVal)
                If InStr(1, strVal, findText, vbTextCompare) > 0 Then
                    outMatchedRows = outMatchedRows + 1
                    If doReplace Then
                        rs.Edit
                        If IsNumeric(replaceText) And rs.Fields(columnName).Type <> 10 And rs.Fields(columnName).Type <> 11 Then
                            rs.Fields(columnName).Value = CDbl(replaceText)
                        Else
                            rs.Fields(columnName).Value = Replace$(strVal, findText, replaceText, 1, -1, vbTextCompare)
                        End If
                        rs.Update
                        If Err.Number = 0 Then
                            outUpdatedRows = outUpdatedRows + 1
                        End If
                        Err.Clear
                    End If
                End If
            End If
            rs.MoveNext
        Loop
        rs.Close
        On Error GoTo 0

        FindAndReplaceInTable = True
    End Function

    Public Function GetDatasheetWithTotalsLines(ByVal tableName As String, ByRef outErrorMsg As String) As Collection
        Dim lines As New Collection
        Dim rs As Object
        Dim i As Long
        Dim colCount As Long
        Dim headerLine As String
        Dim rowLine As String
        Dim totalsLine As String
        Dim fVal As Variant
        Dim fType As Integer
        Dim fName As String
        Dim sumVal As Double
        Dim cntVal As Long

        outErrorMsg = vbNullString
        If Not OpenTable(tableName, outErrorMsg) Then
            Set GetDatasheetWithTotalsLines = lines
            Exit Function
        End If

        Set rs = m_activeRecordset
        If rs Is Nothing Then
            Set GetDatasheetWithTotalsLines = lines
            Exit Function
        End If

        colCount = rs.Fields.Count
        headerLine = ""
        For i = 0 To colCount - 1
            If i > 0 Then headerLine = headerLine & " | "
            headerLine = headerLine & rs.Fields(i).Name
        Next i
        lines.Add "[ " & headerLine & " ]"
        lines.Add String$(88, "-")

        If rs.EOF And rs.BOF Then
            lines.Add "(0 records found in table [" & tableName & "])"
        Else
            Do Until rs.EOF
                rowLine = ""
                For i = 0 To colCount - 1
                    If i > 0 Then rowLine = rowLine & " | "
                    fVal = rs.Fields(i).Value
                    If IsNull(fVal) Then
                        rowLine = rowLine & "<NULL>"
                    Else
                        rowLine = rowLine & CStr(fVal)
                    End If
                Next i
                lines.Add rowLine
                rs.MoveNext
            Loop
            On Error Resume Next
            rs.MoveFirst
            On Error GoTo 0
        End If

        ' Compute Sigma Totals Row
        lines.Add String$(88, "=")
        totalsLine = "[SIGMA TOTALS] "
        For i = 0 To colCount - 1
            If i > 0 Then totalsLine = totalsLine & " | "
            fName = rs.Fields(i).Name
            fType = CInt(rs.Fields(i).Type)
            If (fType >= 2 And fType <= 7) And UCase$(fName) <> "ID" Then
                sumVal = DSum(fName, tableName, m_activeFilterClause)
                totalsLine = totalsLine & "Sum(" & fName & ")=" & Format$(sumVal, "0.##")
            Else
                cntVal = DCount(fName, tableName, m_activeFilterClause)
                totalsLine = totalsLine & "Count=" & CStr(cntVal)
            End If
        Next i
        lines.Add totalsLine

        Set GetDatasheetWithTotalsLines = lines
    End Function

    ' =========================================================================
    ' Phase 24: Grouped Report Designer with Subtotals & Aggregations
    ' =========================================================================
    Public Function GenerateGroupedReportLines(ByVal tableName As String, ByVal groupColumn As String, ByVal metricColumn As String, ByRef outErrorMsg As String) As Collection
        Dim lines As New Collection
        Dim rs As Object
        Dim curGroup As String
        Dim rowGroup As String
        Dim isFirst As Boolean
        Dim grpCount As Long
        Dim grpSum As Double
        Dim grandCount As Long
        Dim grandSum As Double
        Dim mVal As Double
        Dim fVal As Variant
        Dim i As Long
        Dim detailStr As String

        outErrorMsg = vbNullString
        If m_database Is Nothing Then
            outErrorMsg = "No database open."
            Set GenerateGroupedReportLines = lines
            Exit Function
        End If

        On Error Resume Next
        Set rs = m_database.OpenRecordset("SELECT * FROM [" & tableName & "] ORDER BY [" & groupColumn & "];")
        If Err.Number <> 0 Or rs Is Nothing Then
            outErrorMsg = "Failed to run grouped report query: " & Err.Description
            Set GenerateGroupedReportLines = lines
            Exit Function
        End If

        lines.Add "================================================================================"
        lines.Add "  OPENACCESS STUDIO - GROUPED SUMMARY REPORT"
        lines.Add "  Source Table : [" & tableName & "]"
        lines.Add "  Group By     : [" & groupColumn & "]  |  Summary Metric: [" & metricColumn & "]"
        lines.Add "================================================================================"

        isFirst = True
        curGroup = ""
        grpCount = 0
        grpSum = 0#
        grandCount = 0
        grandSum = 0#

        Do Until rs.EOF
            fVal = rs.Fields(groupColumn).Value
            If IsNull(fVal) Then rowGroup = "<NULL>" Else rowGroup = CStr(fVal)

            If isFirst Or rowGroup <> curGroup Then
                If Not isFirst Then
                    lines.Add "    ----------------------------------------------------------------------------"
                    lines.Add "    GROUP SUBTOTAL [" & curGroup & "]: Count = " & CStr(grpCount) & " | Sum(" & metricColumn & ") = " & Format$(grpSum, "0.00")
                    lines.Add ""
                End If
                curGroup = rowGroup
                grpCount = 0
                grpSum = 0#
                isFirst = False
                lines.Add "  >> GROUP HEADER: [" & groupColumn & "] = " & curGroup
                lines.Add "    ----------------------------------------------------------------------------"
            End If

            grpCount = grpCount + 1
            grandCount = grandCount + 1

            mVal = 0#
            If Len(Trim$(metricColumn)) > 0 Then
                fVal = rs.Fields(metricColumn).Value
                If Not IsNull(fVal) And IsNumeric(fVal) Then
                    mVal = CDbl(fVal)
                End If
            End If
            grpSum = grpSum + mVal
            grandSum = grandSum + mVal

            detailStr = "    "
            For i = 0 To rs.Fields.Count - 1
                If i > 0 Then detailStr = detailStr & " | "
                fVal = rs.Fields(i).Value
                If IsNull(fVal) Then detailStr = detailStr & "<NULL>" Else detailStr = detailStr & CStr(fVal)
            Next i
            lines.Add detailStr

            rs.MoveNext
        Loop

        If Not isFirst Then
            lines.Add "    ----------------------------------------------------------------------------"
            lines.Add "    GROUP SUBTOTAL [" & curGroup & "]: Count = " & CStr(grpCount) & " | Sum(" & metricColumn & ") = " & Format$(grpSum, "0.00")
        End If

        rs.Close
        On Error GoTo 0

        lines.Add "================================================================================"
        lines.Add "  GRAND TOTALS: Total Records = " & CStr(grandCount) & " | Grand Sum(" & metricColumn & ") = " & Format$(grandSum, "0.00")
        lines.Add "================================================================================"

        Set GenerateGroupedReportLines = lines
    End Function
    ' =========================================================================
    ' Banded Report Engine with Running Sums (RunningSumOverGroup & RunningSumOverAll)
    ' =========================================================================
    Public Function GenerateBandedReportWithRunningSum(ByVal tableName As String, ByVal groupColumn As String, ByVal metricColumn As String, ByRef outRunningGroupSum() As Double, ByRef outRunningAllSum() As Double, ByRef outGrandTotal As Double, ByRef outErrorMsg As String) As Collection
        Dim lines As New Collection
        Dim rs As Object
        Dim curGroup As String
        Dim rowGroup As String
        Dim isFirst As Boolean
        Dim grpRunning As Double
        Dim allRunning As Double
        Dim grpCount As Long
        Dim totalCount As Long
        Dim rowIdx As Long
        Dim mVal As Double
        Dim fVal As Variant
        Dim i As Long
        Dim detailStr As String

        outErrorMsg = vbNullString
        outGrandTotal = 0#
        ReDim outRunningGroupSum(0 To 63)
        ReDim outRunningAllSum(0 To 63)

        If m_database Is Nothing Then
            outErrorMsg = "No database open."
            ReDim outRunningGroupSum(0 To 0)
            ReDim outRunningAllSum(0 To 0)
            Set GenerateBandedReportWithRunningSum = lines
            Exit Function
        End If

        On Error Resume Next
        Set rs = m_database.OpenRecordset("SELECT * FROM [" & tableName & "] ORDER BY [" & groupColumn & "];")
        If Err.Number <> 0 Or rs Is Nothing Then
            outErrorMsg = "Failed to run banded report query: " & Err.Description
            ReDim outRunningGroupSum(0 To 0)
            ReDim outRunningAllSum(0 To 0)
            Set GenerateBandedReportWithRunningSum = lines
            Exit Function
        End If

        lines.Add "================================================================================"
        lines.Add "[ReportHeader] OPENACCESS STUDIO - BANDED REPORT WITH RUNNING SUMS"
        lines.Add "[ReportHeader] Source Table: [" & tableName & "] | Group: [" & groupColumn & "] | Metric: [" & metricColumn & "]"
        lines.Add "================================================================================"
        lines.Add "[PageHeader] Page 1"
        lines.Add "--------------------------------------------------------------------------------"

        isFirst = True
        curGroup = ""
        grpRunning = 0#
        allRunning = 0#
        grpCount = 0
        totalCount = 0
        rowIdx = 0

        Do Until rs.EOF
            fVal = rs.Fields(groupColumn).Value
            If IsNull(fVal) Then rowGroup = "<NULL>" Else rowGroup = CStr(fVal)

            If isFirst Or rowGroup <> curGroup Then
                If Not isFirst Then
                    lines.Add "  [GroupFooter] [" & curGroup & "] Subtotal = " & Format$(grpRunning, "0.00") & " (Count=" & CStr(grpCount) & ")"
                    lines.Add ""
                End If
                curGroup = rowGroup
                grpRunning = 0#
                grpCount = 0
                isFirst = False
                lines.Add "  [GroupHeader] Group: [" & groupColumn & "] = " & curGroup
                lines.Add "  ------------------------------------------------------------------------------"
            End If

            mVal = 0#
            If Len(Trim$(metricColumn)) > 0 Then
                fVal = rs.Fields(metricColumn).Value
                If Not IsNull(fVal) And IsNumeric(fVal) Then
                    mVal = CDbl(fVal)
                End If
            End If

            grpRunning = grpRunning + mVal
            allRunning = allRunning + mVal
            grpCount = grpCount + 1
            totalCount = totalCount + 1

            If rowIdx > UBound(outRunningGroupSum) Then
                ReDim Preserve outRunningGroupSum(0 To rowIdx + 64)
                ReDim Preserve outRunningAllSum(0 To rowIdx + 64)
            End If
            outRunningGroupSum(rowIdx) = grpRunning
            outRunningAllSum(rowIdx) = allRunning
            rowIdx = rowIdx + 1

            detailStr = "    [Detail] "
            For i = 0 To rs.Fields.Count - 1
                If i > 0 Then detailStr = detailStr & " | "
                fVal = rs.Fields(i).Value
                If IsNull(fVal) Then detailStr = detailStr & "<NULL>" Else detailStr = detailStr & CStr(fVal)
            Next i
            detailStr = detailStr & " | RunningGrpSum=" & Format$(grpRunning, "0.00") & " | RunningAllSum=" & Format$(allRunning, "0.00")
            lines.Add detailStr

            rs.MoveNext
        Loop

        If Not isFirst Then
            lines.Add "  [GroupFooter] [" & curGroup & "] Subtotal = " & Format$(grpRunning, "0.00") & " (Count=" & CStr(grpCount) & ")"
        End If

        rs.Close
        On Error GoTo 0

        lines.Add "--------------------------------------------------------------------------------"
        lines.Add "[PageFooter] End of Page 1"
        lines.Add "================================================================================"
        lines.Add "[ReportFooter] Total Records = " & CStr(totalCount) & " | Grand Total = " & Format$(allRunning, "0.00")
        lines.Add "================================================================================"

        If rowIdx > 0 Then
            ReDim Preserve outRunningGroupSum(0 To rowIdx - 1)
            ReDim Preserve outRunningAllSum(0 To rowIdx - 1)
        Else
            ReDim outRunningGroupSum(0 To 0)
            ReDim outRunningAllSum(0 To 0)
        End If
        outGrandTotal = allRunning

        Set GenerateBandedReportWithRunningSum = lines
    End Function


    ' ------------------------------------------------------------------
    ' SQL display formatting (mirrored by tools/studio_render_model.py
    ' format_sql_for_display). QueryDef.SQL separates clauses with vbCrLf,
    ' which a single-line TextBox hides ("type_customer.typeFROM").
    '   singleLine = True : no vbCr/vbLf; whitespace runs containing a break
    '                       or tab (outside quotes/brackets) become one space.
    '   singleLine = False: original breaks kept, normalized to vbCrLf.
    ' In both modes a space is inserted before a clause keyword that directly
    ' follows ) ] ' or " outside quotes and brackets, and trailing whitespace
    ' is trimmed.
    ' ------------------------------------------------------------------
    Private Function SqlFmtIsWordChar(ByVal ch As String) As Boolean
        If Len(ch) = 0 Then
            SqlFmtIsWordChar = False
        Else
            SqlFmtIsWordChar = (ch Like "[A-Za-z0-9_]")
        End If
    End Function

    Private Function SqlFmtIsWs(ByVal ch As String) As Boolean
        SqlFmtIsWs = (ch = " " Or ch = vbTab Or ch = vbLf)
    End Function

    Private Function SqlFmtWordAt(ByRef u As String, ByVal p As Long, ByRef outEnd As Long) As String
        Dim n As Long
        Dim q As Long
        n = Len(u)
        q = p
        Do While q <= n
            If Not SqlFmtIsWordChar(Mid$(u, q, 1)) Then Exit Do
            q = q + 1
        Loop
        outEnd = q
        If q > p Then
            SqlFmtWordAt = Mid$(u, p, q - p)
        Else
            SqlFmtWordAt = ""
        End If
    End Function

    Private Function SqlFmtSkipWs(ByRef u As String, ByVal p As Long) As Long
        Dim n As Long
        n = Len(u)
        Do While p <= n
            If Not SqlFmtIsWs(Mid$(u, p, 1)) Then Exit Do
            p = p + 1
        Loop
        SqlFmtSkipWs = p
    End Function

    Private Function SqlFmtStartsClause(ByRef u As String, ByVal p As Long) As Boolean
        Dim w As String
        Dim w2 As String
        Dim q As Long
        Dim q2 As Long
        Dim r As Long
        Dim r2 As Long
        Dim dummy As Long

        SqlFmtStartsClause = False
        w = SqlFmtWordAt(u, p, q)
        Select Case w
            Case "FROM", "WHERE", "HAVING", "ON", "UNION", "JOIN"
                SqlFmtStartsClause = True
            Case "GROUP", "ORDER"
                r = SqlFmtSkipWs(u, q)
                If r > q Then
                    If SqlFmtWordAt(u, r, dummy) = "BY" Then SqlFmtStartsClause = True
                End If
            Case "INNER", "LEFT", "RIGHT"
                r = SqlFmtSkipWs(u, q)
                If r > q Then
                    w2 = SqlFmtWordAt(u, r, q2)
                    If w2 = "JOIN" Then
                        SqlFmtStartsClause = True
                    ElseIf w2 = "OUTER" Then
                        r2 = SqlFmtSkipWs(u, q2)
                        If r2 > q2 Then
                            If SqlFmtWordAt(u, r2, dummy) = "JOIN" Then SqlFmtStartsClause = True
                        End If
                    End If
                End If
        End Select
    End Function

    Public Function FormatSqlForDisplay(ByVal sqlText As String, ByVal singleLine As Boolean) As String
        Dim s As String
        Dim u As String
        Dim outStr As String
        Dim ch As String
        Dim closeCh As String
        Dim lastCh As String
        Dim runStr As String
        Dim n As Long
        Dim i As Long
        Dim j As Long
        Dim a As Long
        Dim b As Long

        s = Replace$(sqlText, vbCrLf, vbLf)
        s = Replace$(s, vbCr, vbLf)
        u = UCase$(s)
        n = Len(s)
        outStr = ""
        closeCh = ""
        i = 1

        Do While i <= n
            ch = Mid$(s, i, 1)
            If Len(closeCh) > 0 Then
                ' Inside a quoted literal or bracketed identifier: copy as-is.
                If ch = vbLf And singleLine Then
                    outStr = outStr & " "
                Else
                    outStr = outStr & ch
                End If
                If ch = closeCh Then closeCh = ""
                i = i + 1
            ElseIf SqlFmtIsWs(ch) Then
                j = i
                Do While j <= n
                    If Not SqlFmtIsWs(Mid$(s, j, 1)) Then Exit Do
                    j = j + 1
                Loop
                runStr = Mid$(s, i, j - i)
                If singleLine And (InStr(1, runStr, vbLf) > 0 Or InStr(1, runStr, vbTab) > 0) Then
                    outStr = outStr & " "
                Else
                    outStr = outStr & runStr
                End If
                i = j
            Else
                If ch = "'" Or ch = """" Then
                    closeCh = ch
                ElseIf ch = "[" Then
                    closeCh = "]"
                ElseIf SqlFmtIsWordChar(ch) And Len(outStr) > 0 Then
                    lastCh = Right$(outStr, 1)
                    If lastCh = ")" Or lastCh = "]" Or lastCh = "'" Or lastCh = """" Then
                        If SqlFmtStartsClause(u, i) Then outStr = outStr & " "
                    End If
                End If
                outStr = outStr & ch
                i = i + 1
            End If
        Loop

        ' Trim trailing whitespace (and leading whitespace in single-line mode).
        b = Len(outStr)
        Do While b > 0
            If Not SqlFmtIsWs(Mid$(outStr, b, 1)) Then Exit Do
            b = b - 1
        Loop
        a = 1
        If singleLine Then
            Do While a <= b
                If Not SqlFmtIsWs(Mid$(outStr, a, 1)) Then Exit Do
                a = a + 1
            Loop
        End If
        If b >= a Then
            outStr = Mid$(outStr, a, b - a + 1)
        Else
            outStr = ""
        End If

        If Not singleLine Then outStr = Replace$(outStr, vbLf, vbCrLf)
        FormatSqlForDisplay = outStr
    End Function

    ' -------------------------------------------------------------------------
    ' Subforms: linked child recordsets (studio-forms-queries-rendering-fix 9.1)
    ' -------------------------------------------------------------------------

    ' Opens the child rows of a subform for the parent's current record.
    ' Returns a separate DAO recordset owned by the caller (m_activeRecordset,
    ' navigation and CRUD state are not touched), or Nothing with outErrorMsg set.
    ' sourceObject: "Form.X", "Table.X", "Query.X" or a bare name (form, then table/query).
    ' A parent at BOF/EOF (the (New) row) or Nothing gives Null masters, so no child rows.
    Public Function OpenChildRecordset(ByVal sourceObject As String, ByVal linkChild As String, ByVal linkMaster As String, ByVal parentRs As Object, ByRef outErrorMsg As String) As Object
        Dim childSource As String
        Dim masterNames() As String
        Dim childNames() As String
        Dim masterValues() As Variant
        Dim masterCount As Long
        Dim childCount As Long
        Dim i As Long
        Dim parentAtRow As Boolean
        Dim sqlText As String
        Dim rs As Object
        Dim errText As String

        Set OpenChildRecordset = Nothing
        outErrorMsg = vbNullString

        If m_database Is Nothing Then
            outErrorMsg = "No database currently open."
            Exit Function
        End If

        childSource = ResolveSubformChildSource(sourceObject, errText)
        If Len(childSource) = 0 Then
            If Len(errText) = 0 Then errText = "Subform source object [" & Trim$(sourceObject) & "] has no record source."
            outErrorMsg = errText
            Exit Function
        End If

        masterCount = SplitLinkFields(linkMaster, masterNames)
        childCount = SplitLinkFields(linkChild, childNames)
        If masterCount <> childCount Then
            outErrorMsg = "Link Master Fields (" & CStr(masterCount) & ") and Link Child Fields (" & CStr(childCount) & ") have different field counts."
            Exit Function
        End If

        If masterCount > 0 Then
            ReDim masterValues(0 To masterCount - 1)
        Else
            ReDim masterValues(0 To 0)
        End If
        For i = 0 To UBound(masterValues)
            masterValues(i) = Null
        Next i

        If masterCount > 0 And Not parentRs Is Nothing Then
            parentAtRow = False
            On Error Resume Next
            parentAtRow = Not (parentRs.BOF Or parentRs.EOF)
            If Err.Number <> 0 Then parentAtRow = False
            Err.Clear
            On Error GoTo 0
            If parentAtRow Then
                For i = 0 To masterCount - 1
                    On Error Resume Next
                    masterValues(i) = parentRs.Fields(masterNames(i)).Value
                    If Err.Number <> 0 Then
                        errText = Err.Description
                        Err.Clear
                        On Error GoTo 0
                        outErrorMsg = "Link master field [" & masterNames(i) & "] not found in the parent record source: " & errText
                        Exit Function
                    End If
                    On Error GoTo 0
                Next i
            End If
        End If

        sqlText = BuildLinkedChildSql(childSource, linkChild, masterValues)

        On Error Resume Next
        Set rs = m_database.OpenRecordset(sqlText)
        If Err.Number <> 0 Then
            outErrorMsg = "Subform query error: " & Err.Description
            Err.Clear
            Set rs = Nothing
        End If
        On Error GoTo 0

        Set OpenChildRecordset = rs
    End Function

    ' Builds the SQL that selects the child rows linked to the parent's master values.
    ' childFields is LinkChildFields (split on ";"); masterValues(i) pairs with field i.
    ' Table/query source: SELECT * FROM [X] WHERE [C1] = lit1 AND ...
    ' SQL source:         SELECT * FROM (<sql>) AS [_c] WHERE ...
    ' No child fields: no WHERE (unlinked subform). Any Null master, or a count
    ' mismatch between fields and values: WHERE 1 = 0.
    Public Function BuildLinkedChildSql(ByVal childSource As String, ByVal childFields As String, ByRef masterValues() As Variant) As String
        Dim src As String
        Dim fromText As String
        Dim fieldNames() As String
        Dim fieldCount As Long
        Dim valueCount As Long
        Dim lo As Long
        Dim hi As Long
        Dim i As Long
        Dim lit As String
        Dim isNullLit As Boolean
        Dim whereText As String

        src = Trim$(childSource)
        If IsSqlRecordSource(src) Then
            Do While Len(src) > 0
                If Right$(src, 1) = ";" Or Right$(src, 1) = " " Or Right$(src, 1) = vbCr Or Right$(src, 1) = vbLf Or Right$(src, 1) = vbTab Then
                    src = Left$(src, Len(src) - 1)
                Else
                    Exit Do
                End If
            Loop
            fromText = "SELECT * FROM (" & src & ") AS [_c]"
        Else
            fromText = "SELECT * FROM " & BracketSqlName(src)
        End If

        fieldCount = SplitLinkFields(childFields, fieldNames)
        If fieldCount = 0 Then
            BuildLinkedChildSql = fromText
            Exit Function
        End If

        valueCount = 0
        On Error Resume Next
        lo = LBound(masterValues)
        hi = UBound(masterValues)
        If Err.Number = 0 Then valueCount = hi - lo + 1
        Err.Clear
        On Error GoTo 0
        If valueCount <> fieldCount Then
            BuildLinkedChildSql = fromText & " WHERE 1 = 0"
            Exit Function
        End If

        whereText = vbNullString
        For i = 0 To fieldCount - 1
            isNullLit = False
            lit = LinkSqlLiteral(masterValues(lo + i), isNullLit)
            If isNullLit Then
                BuildLinkedChildSql = fromText & " WHERE 1 = 0"
                Exit Function
            End If
            If i > 0 Then whereText = whereText & " AND "
            whereText = whereText & BracketSqlName(fieldNames(i)) & " = " & lit
        Next i

        BuildLinkedChildSql = fromText & " WHERE " & whereText
    End Function

    ' Splits a LinkMasterFields/LinkChildFields value on ";". Names are trimmed,
    ' surrounding brackets removed and empty entries dropped. Returns the count;
    ' outNames is 0-based (one empty element when the count is 0).
    Public Function SplitLinkFields(ByVal fieldList As String, ByRef outNames() As String) As Long
        Dim parts() As String
        Dim nameText As String
        Dim n As Long
        Dim i As Long

        n = 0
        ReDim outNames(0 To 0)
        If Len(Trim$(fieldList)) = 0 Then
            SplitLinkFields = 0
            Exit Function
        End If

        parts = Split(fieldList, ";")
        ReDim outNames(0 To UBound(parts) - LBound(parts))
        For i = LBound(parts) To UBound(parts)
            nameText = Trim$(parts(i))
            If Len(nameText) >= 2 Then
                If Left$(nameText, 1) = "[" And Right$(nameText, 1) = "]" Then nameText = Trim$(Mid$(nameText, 2, Len(nameText) - 2))
            End If
            If Len(nameText) > 0 Then
                outNames(n) = nameText
                n = n + 1
            End If
        Next i
        If n > 0 Then
            ReDim Preserve outNames(0 To n - 1)
        Else
            ReDim outNames(0 To 0)
        End If
        SplitLinkFields = n
    End Function

    ' Formats one master value as a Jet SQL literal. Null/Empty set outIsNull.
    ' Numbers via Str$ (invariant "." decimal point, leading space trimmed),
    ' Booleans as True/False, dates as #yyyy-mm-dd hh:nn:ss#, text quoted with ' doubled.
    Public Function LinkSqlLiteral(ByVal v As Variant, ByRef outIsNull As Boolean) As String
        Dim vt As Long
        Dim textValue As String
        Dim dt As Date

        outIsNull = False
        LinkSqlLiteral = vbNullString
        vt = VarType(v)

        Select Case vt
            Case vbNull, vbEmpty
                outIsNull = True
            Case vbBoolean
                If CBool(v) Then
                    LinkSqlLiteral = "True"
                Else
                    LinkSqlLiteral = "False"
                End If
            Case vbDate
                dt = CDate(v)
                LinkSqlLiteral = "#" & CStr(Year(dt)) & "-" & Right$("0" & CStr(Month(dt)), 2) & "-" & Right$("0" & CStr(Day(dt)), 2) & " " & Right$("0" & CStr(Hour(dt)), 2) & ":" & Right$("0" & CStr(Minute(dt)), 2) & ":" & Right$("0" & CStr(Second(dt)), 2) & "#"
            Case vbInteger, vbLong, vbSingle, vbDouble, vbCurrency, vbDecimal, vbByte, 20
                LinkSqlLiteral = Trim$(Str$(v))
            Case vbString
                LinkSqlLiteral = "'" & Replace$(CStr(v), "'", "''") & "'"
            Case Else
                textValue = vbNullString
                On Error Resume Next
                textValue = CStr(v)
                If Err.Number <> 0 Then outIsNull = True
                Err.Clear
                On Error GoTo 0
                If Not outIsNull Then LinkSqlLiteral = "'" & Replace$(textValue, "'", "''") & "'"
        End Select
    End Function

    ' [name] with "]" escaped as "]]" (surrounding brackets on the input are kept as-is).
    Private Function BracketSqlName(ByVal nameText As String) As String
        Dim s As String
        s = Trim$(nameText)
        If Len(s) >= 2 Then
            If Left$(s, 1) = "[" And Right$(s, 1) = "]" Then
                BracketSqlName = s
                Exit Function
            End If
        End If
        BracketSqlName = "[" & Replace$(s, "]", "]]") & "]"
    End Function

    ' Child record source of a subform SourceObject. "Form.X" -> X's RecordSource
    ' (_OpenAccess_Objects catalog, then native layout); "Table.X"/"Query.X" -> X;
    ' a bare name -> form first, then table/query. Empty result with outErrorMsg on failure.
    Private Function ResolveSubformChildSource(ByVal sourceObject As String, ByRef outErrorMsg As String) As String
        Dim src As String
        Dim upSrc As String
        Dim objName As String
        Dim formSource As String
        Dim formFound As Boolean

        ResolveSubformChildSource = vbNullString
        outErrorMsg = vbNullString
        src = Trim$(sourceObject)
        upSrc = UCase$(src)

        If Len(src) = 0 Then
            outErrorMsg = "Subform has no Source Object."
            Exit Function
        End If

        If Left$(upSrc, 6) = "TABLE." Or Left$(upSrc, 6) = "QUERY." Then
            objName = Trim$(Mid$(src, 7))
            If Len(objName) = 0 Then
                outErrorMsg = "Subform Source Object [" & src & "] names no table or query."
                Exit Function
            End If
            ResolveSubformChildSource = objName
            Exit Function
        End If

        If Left$(upSrc, 5) = "FORM." Then
            objName = Trim$(Mid$(src, 6))
        Else
            objName = src
        End If
        If Len(objName) = 0 Then
            outErrorMsg = "Subform Source Object [" & src & "] names no form."
            Exit Function
        End If

        formFound = False
        formSource = SubformFormRecordSource(objName, formFound, (Left$(upSrc, 5) = "FORM."))
        If formFound Then
            If Len(Trim$(formSource)) = 0 Then
                outErrorMsg = "Subform form [" & objName & "] has no Record Source."
                Exit Function
            End If
            ResolveSubformChildSource = Trim$(formSource)
            Exit Function
        End If

        If Left$(upSrc, 5) <> "FORM." Then
            If DatabaseHasTableOrQuery(objName) Then
                ResolveSubformChildSource = objName
                Exit Function
            End If
        End If

        outErrorMsg = "Subform Source Object [" & src & "] was not found."
    End Function

    ' RecordSource of a form used as a subform, without changing the active form,
    ' the layout status or the Property Sheet defaults of the parent form.
    Private Function SubformFormRecordSource(ByVal formName As String, ByRef outFound As Boolean, Optional ByVal isExplicitForm As Boolean = False) As String
        Dim rs As Object
        Dim safeName As String
        Dim sourceText As String
        Dim nativeKnown As Boolean
        Dim nativeExists As Boolean
        Dim childLayout As NativeFormLayout
        Dim layoutErr As String
        Dim savedStatus As String
        Dim savedStatusKey As String
        Dim savedDefaulted() As String
        Dim savedDefaultedCount As Long
        Dim savedFormDefaulted As String

        outFound = False
        SubformFormRecordSource = vbNullString
        If m_database Is Nothing Or Len(formName) = 0 Then Exit Function
        safeName = Replace$(formName, "'", "''")

        ' 1. _OpenAccess_Objects catalog (SourceName is the form's record source).
        On Error Resume Next
        Set rs = m_database.OpenRecordset("SELECT [SourceName] FROM [_OpenAccess_Objects] WHERE [ObjType] = 'FORM' AND [ObjName] = '" & safeName & "';")
        If Err.Number = 0 And Not rs Is Nothing Then
            If Not rs.EOF Then
                outFound = True
                If Not IsNull(rs.Fields(0).Value) Then sourceText = CStr(rs.Fields(0).Value)
            End If
            rs.Close
        End If
        Err.Clear
        Set rs = Nothing
        On Error GoTo 0
        If outFound Then
            SubformFormRecordSource = sourceText
            Exit Function
        End If

        ' 2. Native Access form: only when MSysObjects lists it (or cannot be read),
        '    so a table/query name does not trigger the layout fallbacks.
        nativeKnown = False
        nativeExists = False
        On Error Resume Next
        Set rs = m_database.OpenRecordset("SELECT [Name] FROM [MSysObjects] WHERE [Type] = -32768 AND [Name] = '" & safeName & "';")
        If Err.Number = 0 And Not rs Is Nothing Then
            nativeKnown = True
            nativeExists = Not rs.EOF
            rs.Close
        End If
        Err.Clear
        Set rs = Nothing
        On Error GoTo 0
        If nativeKnown And Not nativeExists Then Exit Function
        ' A bare name that is also a table/query means the table/query; "Form.X" always
        ' means the form (forms often share their table's name).
        If Not nativeKnown And Not isExplicitForm And DatabaseHasTableOrQuery(formName) Then Exit Function

        savedStatus = m_lastLayoutStatus
        savedStatusKey = m_lastLayoutStatusKey
        savedDefaulted = m_blobDefaulted
        savedDefaultedCount = m_blobDefaultedCount
        savedFormDefaulted = m_blobFormDefaulted
        If GetNativeFormLayout(formName, childLayout, layoutErr) Then
            outFound = True
            SubformFormRecordSource = childLayout.RecordSource
        End If
        m_lastLayoutStatus = savedStatus
        m_lastLayoutStatusKey = savedStatusKey
        m_blobDefaulted = savedDefaulted
        m_blobDefaultedCount = savedDefaultedCount
        m_blobFormDefaulted = savedFormDefaulted
    End Function

    ' -------------------------------------------------------------------------
    ' Query Design View model (studio-forms-queries-rendering-fix 10.1)
    ' Mirrored by tools/studio_render_model.py parse_query_design_sql.
    '
    ' Encodings (all arrays 0-based; UBound = -1 when empty):
    '   outTables: "key" or "key|source" (key = alias when the FROM item has one;
    '              joins and columns refer to the key, source names the table/query)
    '   outJoins:  "leftTable|leftField|rightTable|rightField|joinType" (INNER|LEFT|RIGHT)
    '   outCols:   "field|table|sort|show|criteria|or" (sort = Ascending|Descending|"",
    '              show = 1|0; WHERE/ORDER BY fields missing from SELECT get show = 0)
    ' -------------------------------------------------------------------------

    ' Design View model of a saved query, parsed from QueryDef.SQL.
    ' Returns True when the model is usable. Returns False with
    ' QueryDesignCannotRepresent() = True when the query cannot be shown in
    ' Design View (UNION, pass-through, DDL, subquery in FROM, ...); outErrorMsg
    ' then holds "This query cannot be shown in Design View (<reason>)." A False
    ' result with QueryDesignCannotRepresent() = False is a real error (no
    ' database, query not found). Columns without a table fall back to
    ' rs.Fields(i).SourceTable.
    Public Function GetQueryDesignModel(ByVal queryName As String, ByRef outTables() As String, ByRef outJoins() As String, ByRef outCols() As String, ByRef outErrorMsg As String) As Boolean
        If m_isCompiledLocked Then
            outErrorMsg = "Design access denied: Query design view is disabled in compiled applications."
            GetQueryDesignModel = False
            Exit Function
        End If
        Dim qDefObj As Object
        Dim rs As Object
        Dim sqlText As String
        Dim qType As Long
        Dim connectText As String
        Dim reasonText As String
        Dim isOk As Boolean
        Dim parts() As String
        Dim i As Long
        Dim k As Long
        Dim shownCount As Long
        Dim needSource As Boolean
        Dim hasStar As Boolean
        Dim srcTbl As String

        GetQueryDesignModel = False
        m_qdCannotRepresent = False
        outErrorMsg = vbNullString
        outTables = Split(vbNullString, "|")
        outJoins = Split(vbNullString, "|")
        outCols = Split(vbNullString, "|")

        If m_database Is Nothing Then
            outErrorMsg = "No database open."
            Exit Function
        End If

        On Error Resume Next
        Set qDefObj = m_database.QueryDefs(queryName)
        If Err.Number <> 0 Or qDefObj Is Nothing Then
            Err.Clear
            Dim tDefObj As Object
            Set tDefObj = m_database.TableDefs(queryName)
            If Err.Number = 0 And Not tDefObj Is Nothing Then
                outTables = Split(queryName, "|")
                outJoins = Split(vbNullString, "|")
                Dim fCnt As Long, fldNames() As String
                fCnt = GetTableFieldNames(queryName, fldNames)
                If fCnt > 0 Then
                    ReDim outCols(0 To fCnt - 1)
                    For i = 0 To fCnt - 1
                        outCols(i) = fldNames(i) & "|" & queryName & "||1||"
                    Next i
                Else
                    ReDim outCols(0 To 0)
                    outCols(0) = "*|" & queryName & "||1||"
                End If
                GetQueryDesignModel = True
                Exit Function
            End If
            On Error GoTo 0
            outErrorMsg = "Query or table not found: " & queryName
            Exit Function
        End If
        sqlText = qDefObj.SQL
        qType = 0
        qType = qDefObj.Type
        connectText = vbNullString
        connectText = qDefObj.Connect
        Err.Clear
        On Error GoTo 0

        reasonText = vbNullString
        If qType = 112 Or UCase$(Left$(Trim$(connectText), 5)) = "ODBC;" Then
            reasonText = "pass-through query"
        ElseIf qType = 96 Then
            reasonText = "data-definition query"
        End If
        isOk = False
        If Len(reasonText) = 0 Then
            isOk = ParseQueryDesignSql(sqlText, outTables, outJoins, outCols, reasonText)
        End If
        If Not isOk Then
            m_qdCannotRepresent = True
            outErrorMsg = "This query cannot be shown in Design View (" & reasonText & ")."
            Exit Function
        End If

        ' Table row fallback: rs.Fields(i).SourceTable for shown columns without a table.
        shownCount = 0
        needSource = False
        hasStar = False
        For i = 0 To UBound(outCols)
            parts = Split(outCols(i), "|")
            If UBound(parts) >= 5 Then
                If parts(3) = "1" Then
                    shownCount = shownCount + 1
                    If parts(0) = "*" Or Right$(parts(0), 2) = ".*" Then hasStar = True
                    If Len(parts(1)) = 0 Then needSource = True
                End If
            End If
        Next i

        If needSource And Not hasStar And shownCount > 0 Then
            On Error Resume Next
            Set rs = m_database.OpenRecordset(queryName, 4)
            If Err.Number = 0 And Not rs Is Nothing Then
                If rs.Fields.Count = shownCount Then
                    k = 0
                    For i = 0 To UBound(outCols)
                        parts = Split(outCols(i), "|")
                        If UBound(parts) >= 5 Then
                            If parts(3) = "1" Then
                                If Len(parts(1)) = 0 Then
                                    srcTbl = vbNullString
                                    srcTbl = CStr(rs.Fields(k).SourceTable)
                                    If Len(srcTbl) > 0 Then
                                        parts(1) = QdTableKeyForSource(outTables, srcTbl)
                                        outCols(i) = Join(parts, "|")
                                    End If
                                End If
                                k = k + 1
                            End If
                        End If
                    Next i
                End If
                rs.Close
            End If
            Err.Clear
            Set rs = Nothing
            On Error GoTo 0
        End If

        GetQueryDesignModel = True
    End Function

    ' True when the last GetQueryDesignModel call found a query that Design View cannot show.
    Public Function QueryDesignCannotRepresent() As Boolean
        QueryDesignCannotRepresent = m_qdCannotRepresent
    End Function

    ' Field names of a table (TableDefs) or saved query (QueryDefs), for the
    ' Design View field-list boxes. Returns the count; outNames is 0-based
    ' (UBound = -1 when the count is 0).
    Public Function GetTableFieldNames(ByVal objName As String, ByRef outNames() As String) As Long
        Dim obj As Object
        Dim cnt As Long
        Dim i As Long

        GetTableFieldNames = 0
        outNames = Split(vbNullString, "|")
        If m_database Is Nothing Then Exit Function
        Dim cleanObj As String
        cleanObj = Trim$(Replace$(Replace$(objName, "[", ""), "]", ""))
        If Len(cleanObj) = 0 Then Exit Function

        cnt = 0
        On Error Resume Next
        Set obj = Nothing
        Set obj = m_database.TableDefs(cleanObj)
        If Err.Number <> 0 Or obj Is Nothing Then
            Err.Clear
            Set obj = Nothing
            Set obj = m_database.QueryDefs(cleanObj)
        End If
        If Err.Number = 0 And Not obj Is Nothing Then
            cnt = obj.Fields.Count
            If Err.Number = 0 And cnt > 0 Then
                ReDim outNames(0 To cnt - 1)
                For i = 0 To cnt - 1
                    outNames(i) = CStr(obj.Fields(i).Name)
                Next i
            Else
                cnt = 0
            End If
        End If
        Err.Clear
        Set obj = Nothing
        On Error GoTo 0
        GetTableFieldNames = cnt
    End Function

    ' Key of the outTables entry whose source is srcTable (alias-aware), else srcTable.
    Private Function QdTableKeyForSource(ByRef tables() As String, ByVal srcTable As String) As String
        Dim i As Long
        Dim parts() As String
        Dim srcName As String

        QdTableKeyForSource = srcTable
        For i = 0 To UBound(tables)
            parts = Split(tables(i), "|")
            If UBound(parts) >= 0 Then
                If UBound(parts) >= 1 Then
                    srcName = parts(1)
                Else
                    srcName = parts(0)
                End If
                If UCase$(srcName) = UCase$(srcTable) Then
                    QdTableKeyForSource = parts(0)
                    Exit Function
                End If
            End If
        Next i
    End Function

    ' Pure SQL -> Design View model (no database). Returns True when the query can
    ' be represented; False with outReason (and empty arrays) otherwise.
    ' Handles SELECT [DISTINCT|DISTINCTROW|ALL] [TOP n [PERCENT]] lists (T.F, [T].[F],
    ' expr AS alias, T.*), FROM with nested (...) INNER|LEFT|RIGHT [OUTER] JOIN ... ON
    ' a.b = c.d [AND ...], comma lists and aliases, WHERE conjuncts (up to two OR
    ' alternatives -> criteria / or) and ORDER BY (-> sort). GROUP BY and HAVING are ignored.
    Public Function ParseQueryDesignSql(ByVal sqlText As String, ByRef outTables() As String, ByRef outJoins() As String, ByRef outCols() As String, ByRef outReason As String) As Boolean
        Dim st As QdParseState
        Dim p As Long
        Dim c As Long
        Dim c2 As Long
        Dim clStart(0 To 4) As Long
        Dim clContent(0 To 4) As Long
        Dim clEnd(0 To 4) As Long
        Dim endPos As Long
        Dim selEnd As Long
        Dim q As Long
        Dim selectCount As Long
        Dim i As Long

        ParseQueryDesignSql = False
        outTables = Split(vbNullString, "|")
        outJoins = Split(vbNullString, "|")
        outCols = Split(vbNullString, "|")
        outReason = vbNullString

        QdInit st, sqlText
        p = 0
        If st.TokCount = 0 Then
            QdFail st, "empty SQL"
        ElseIf QdIsW(st, 0, "PARAMETERS") Then
            Do While p < st.TokCount
                If QdIsP(st, p, ";") Then Exit Do
                p = p + 1
            Loop
            p = p + 1
        End If
        If Len(st.Reason) = 0 Then
            If QdIsW(st, p, "TRANSFORM") Then
                QdFail st, "crosstab query"
            ElseIf Not QdIsW(st, p, "SELECT") Then
                QdFail st, "not a SELECT query"
            End If
        End If

        If Len(st.Reason) = 0 Then
            p = p + 1
            Do
                If QdIsW(st, p, "DISTINCT") Or QdIsW(st, p, "DISTINCTROW") Or QdIsW(st, p, "ALL") Then
                    p = p + 1
                ElseIf QdIsW(st, p, "TOP") Then
                    p = p + 2
                    If QdIsW(st, p, "PERCENT") Then p = p + 1
                Else
                    Exit Do
                End If
            Loop

            ' Depth-0 clause starts: 0 FROM, 1 WHERE, 2 HAVING, 3 GROUP BY, 4 ORDER BY.
            endPos = QdFindClauses(st, p, clStart, clContent)
            If Len(st.Reason) = 0 Then
                selEnd = endPos
                For c = 0 To 4
                    If clStart(c) >= 0 Then
                        If clStart(c) < selEnd Then selEnd = clStart(c)
                        clEnd(c) = endPos
                        For c2 = 0 To 4
                            If clStart(c2) > clStart(c) And clStart(c2) < clEnd(c) Then clEnd(c) = clStart(c2)
                        Next c2
                    Else
                        clEnd(c) = -1
                    End If
                Next c

                If clStart(0) >= 0 Then
                    q = QdParseSource(st, clContent(0), clEnd(0), 0)
                    If Len(st.Reason) = 0 And q < clEnd(0) Then QdFail st, "unsupported FROM clause"
                End If
                If Len(st.Reason) = 0 Then QdParseSelectList st, p, selEnd
                selectCount = st.ColCount
                If Len(st.Reason) = 0 And clStart(1) >= 0 Then QdParseWhere st, clContent(1), clEnd(1)
                If Len(st.Reason) = 0 And clStart(4) >= 0 Then QdParseOrderBy st, clContent(4), clEnd(4), selectCount
            End If
        End If

        If Len(st.Reason) > 0 Then
            outReason = st.Reason
            Exit Function
        End If

        If st.TblCount > 0 Then
            ReDim outTables(0 To st.TblCount - 1)
            For i = 0 To st.TblCount - 1
                If st.TblKey(i) = st.TblSrc(i) Then
                    outTables(i) = st.TblKey(i)
                Else
                    outTables(i) = st.TblKey(i) & "|" & st.TblSrc(i)
                End If
            Next i
        End If
        If st.JoinCount > 0 Then
            ReDim outJoins(0 To st.JoinCount - 1)
            For i = 0 To st.JoinCount - 1
                outJoins(i) = st.Joins(i)
            Next i
        End If
        If st.ColCount > 0 Then
            ReDim outCols(0 To st.ColCount - 1)
            For i = 0 To st.ColCount - 1
                outCols(i) = st.ColField(i) & "|" & st.ColTable(i) & "|" & st.ColSort(i) & "|" & st.ColShow(i) & "|" & st.ColCrit(i) & "|" & st.ColOr(i)
            Next i
        End If
        ParseQueryDesignSql = True
    End Function

    Private Sub QdInit(ByRef st As QdParseState, ByVal sqlText As String)
        st.Sql = sqlText
        ReDim st.TokKind(0 To 31)
        ReDim st.TokText(0 To 31)
        ReDim st.TokUp(0 To 31)
        ReDim st.TokStart(0 To 31)
        ReDim st.TokEnd(0 To 31)
        st.TokCount = 0
        ReDim st.TblKey(0 To 7)
        ReDim st.TblSrc(0 To 7)
        st.TblCount = 0
        ReDim st.Joins(0 To 7)
        st.JoinCount = 0
        ReDim st.ColField(0 To 7)
        ReDim st.ColTable(0 To 7)
        ReDim st.ColBase(0 To 7)
        ReDim st.ColAlias(0 To 7)
        ReDim st.ColExpr(0 To 7)
        ReDim st.ColSort(0 To 7)
        ReDim st.ColShow(0 To 7)
        ReDim st.ColCrit(0 To 7)
        ReDim st.ColOr(0 To 7)
        st.ColCount = 0
        st.Reason = vbNullString
        QdTokenize st
    End Sub

    Private Sub QdFail(ByRef st As QdParseState, ByVal why As String)
        If Len(st.Reason) = 0 Then st.Reason = why
    End Sub

    Private Function QdIsWsChar(ByVal ch As String) As Boolean
        QdIsWsChar = (ch = " " Or ch = vbTab Or ch = vbCr Or ch = vbLf)
    End Function

    Private Sub QdAddTok(ByRef st As QdParseState, ByVal tokKind As Long, ByVal tokText As String, ByVal tokStart As Long, ByVal tokEnd As Long)
        Dim newMax As Long
        If st.TokCount > UBound(st.TokKind) Then
            newMax = UBound(st.TokKind) * 2 + 1
            ReDim Preserve st.TokKind(0 To newMax)
            ReDim Preserve st.TokText(0 To newMax)
            ReDim Preserve st.TokUp(0 To newMax)
            ReDim Preserve st.TokStart(0 To newMax)
            ReDim Preserve st.TokEnd(0 To newMax)
        End If
        st.TokKind(st.TokCount) = tokKind
        st.TokText(st.TokCount) = tokText
        st.TokUp(st.TokCount) = UCase$(tokText)
        st.TokStart(st.TokCount) = tokStart
        st.TokEnd(st.TokCount) = tokEnd
        st.TokCount = st.TokCount + 1
    End Sub

    ' Whitespace separates tokens; [names], 'strings' / "strings" ('' / "" escapes)
    ' and #dates# are single tokens; <>, <= and >= are single punctuation tokens.
    Private Sub QdTokenize(ByRef st As QdParseState)
        Dim s As String
        Dim n As Long
        Dim i As Long
        Dim j As Long
        Dim tokEnd As Long
        Dim ch As String
        Dim twoCh As String

        s = st.Sql
        n = Len(s)
        i = 1
        Do While i <= n
            ch = Mid$(s, i, 1)
            If QdIsWsChar(ch) Then
                i = i + 1
            ElseIf ch = "[" Then
                j = InStr(i + 1, s, "]")
                If j = 0 Then
                    QdAddTok st, QD_TOK_NAME, Mid$(s, i + 1), i, n + 1
                    i = n + 1
                Else
                    QdAddTok st, QD_TOK_NAME, Mid$(s, i + 1, j - i - 1), i, j + 1
                    i = j + 1
                End If
            ElseIf ch = "'" Or ch = """" Then
                j = i + 1
                Do While j <= n
                    If Mid$(s, j, 1) = ch Then
                        If Mid$(s, j + 1, 1) = ch Then
                            j = j + 2
                        Else
                            Exit Do
                        End If
                    Else
                        j = j + 1
                    End If
                Loop
                tokEnd = j + 1
                If tokEnd > n + 1 Then tokEnd = n + 1
                QdAddTok st, QD_TOK_STRING, Mid$(s, i, tokEnd - i), i, tokEnd
                i = tokEnd
            ElseIf ch = "#" Then
                j = InStr(i + 1, s, "#")
                If j = 0 Then
                    tokEnd = n + 1
                Else
                    tokEnd = j + 1
                End If
                QdAddTok st, QD_TOK_DATE, Mid$(s, i, tokEnd - i), i, tokEnd
                i = tokEnd
            ElseIf InStr(1, QD_SPECIAL_CHARS, ch) > 0 Then
                twoCh = Mid$(s, i, 2)
                If twoCh = "<>" Or twoCh = "<=" Or twoCh = ">=" Then
                    QdAddTok st, QD_TOK_PUNCT, twoCh, i, i + 2
                    i = i + 2
                Else
                    QdAddTok st, QD_TOK_PUNCT, ch, i, i + 1
                    i = i + 1
                End If
            Else
                j = i
                Do While j <= n
                    ch = Mid$(s, j, 1)
                    If QdIsWsChar(ch) Then Exit Do
                    If InStr(1, QD_SPECIAL_CHARS, ch) > 0 Then Exit Do
                    j = j + 1
                Loop
                QdAddTok st, QD_TOK_WORD, Mid$(s, i, j - i), i, j
                i = j
            End If
        Loop
    End Sub

    Private Function QdKind(ByRef st As QdParseState, ByVal i As Long) As Long
        QdKind = 0
        If i >= 0 And i < st.TokCount Then QdKind = st.TokKind(i)
    End Function

    Private Function QdText(ByRef st As QdParseState, ByVal i As Long) As String
        QdText = vbNullString
        If i >= 0 And i < st.TokCount Then QdText = st.TokText(i)
    End Function

    Private Function QdIsW(ByRef st As QdParseState, ByVal i As Long, ByVal upperWord As String) As Boolean
        QdIsW = False
        If i >= 0 And i < st.TokCount Then
            If st.TokKind(i) = QD_TOK_WORD Then QdIsW = (st.TokUp(i) = upperWord)
        End If
    End Function

    Private Function QdIsP(ByRef st As QdParseState, ByVal i As Long, ByVal punct As String) As Boolean
        QdIsP = False
        If i >= 0 And i < st.TokCount Then
            If st.TokKind(i) = QD_TOK_PUNCT Then QdIsP = (st.TokText(i) = punct)
        End If
    End Function

    Private Function QdIsCompareOp(ByRef st As QdParseState, ByVal i As Long) As Boolean
        Dim t As String
        QdIsCompareOp = False
        If QdKind(st, i) = QD_TOK_PUNCT Then
            t = st.TokText(i)
            QdIsCompareOp = (t = "=" Or t = "<" Or t = ">" Or t = "<=" Or t = ">=" Or t = "<>")
        End If
    End Function

    ' [name], or a word that does not start with a digit and is not a reserved word.
    Private Function QdIsName(ByRef st As QdParseState, ByVal i As Long) As Boolean
        Dim firstCh As String
        QdIsName = False
        If i < 0 Or i >= st.TokCount Then Exit Function
        If st.TokKind(i) = QD_TOK_NAME Then
            QdIsName = True
        ElseIf st.TokKind(i) = QD_TOK_WORD Then
            firstCh = Left$(st.TokText(i), 1)
            If firstCh >= "0" And firstCh <= "9" Then Exit Function
            QdIsName = (InStr(1, QD_RESERVED, "|" & st.TokUp(i) & "|") = 0)
        End If
    End Function

    Private Function QdAllDigits(ByVal t As String) As Boolean
        Dim k As Long
        Dim ch As String
        QdAllDigits = False
        If Len(t) = 0 Then Exit Function
        For k = 1 To Len(t)
            ch = Mid$(t, k, 1)
            If ch < "0" Or ch > "9" Then Exit Function
        Next k
        QdAllDigits = True
    End Function

    ' Source text of tokens [a, b), line breaks and tabs as spaces, trimmed.
    Private Function QdRaw(ByRef st As QdParseState, ByVal a As Long, ByVal b As Long) As String
        Dim t As String
        QdRaw = vbNullString
        If a >= b Then Exit Function
        t = Mid$(st.Sql, st.TokStart(a), st.TokEnd(b - 1) - st.TokStart(a))
        t = Replace$(Replace$(Replace$(t, vbCr, " "), vbLf, " "), vbTab, " ")
        QdRaw = Trim$(t)
    End Function

    Private Function QdMatchParen(ByRef st As QdParseState, ByVal i As Long, ByVal b As Long) As Long
        Dim d As Long
        Dim q As Long
        QdMatchParen = -1
        d = 0
        For q = i To b - 1
            If QdIsP(st, q, "(") Then
                d = d + 1
            ElseIf QdIsP(st, q, ")") Then
                d = d - 1
                If d = 0 Then
                    QdMatchParen = q
                    Exit Function
                End If
            End If
        Next q
    End Function

    ' Strips parentheses that enclose the whole range [a, b).
    Private Sub QdPeel(ByRef st As QdParseState, ByRef a As Long, ByRef b As Long)
        Do While b - a >= 2
            If Not QdIsP(st, a, "(") Then Exit Do
            If QdMatchParen(st, a, b) <> b - 1 Then Exit Do
            a = a + 1
            b = b - 1
        Loop
    End Sub

    Private Sub QdPushRange(ByRef outA() As Long, ByRef outB() As Long, ByRef cnt As Long, ByVal x As Long, ByVal y As Long)
        Dim newMax As Long
        If cnt > UBound(outA) Then
            newMax = UBound(outA) * 2 + 1
            ReDim Preserve outA(0 To newMax)
            ReDim Preserve outB(0 To newMax)
        End If
        outA(cnt) = x
        outB(cnt) = y
        cnt = cnt + 1
    End Sub

    ' Splits [a, b) on depth-0 sep ("," or an upper-case keyword). For AND, the AND
    ' of BETWEEN x AND y is not a separator. Returns the range count (>= 1).
    Private Function QdSplitTop(ByRef st As QdParseState, ByVal a As Long, ByVal b As Long, ByVal sep As String, ByRef outA() As Long, ByRef outB() As Long) As Long
        Dim cnt As Long
        Dim d As Long
        Dim q As Long
        Dim startPos As Long
        Dim pendingBetween As Boolean
        Dim isSep As Boolean

        ReDim outA(0 To 7)
        ReDim outB(0 To 7)
        cnt = 0
        d = 0
        startPos = a
        pendingBetween = False
        For q = a To b - 1
            isSep = False
            If QdIsP(st, q, "(") Then
                d = d + 1
            ElseIf QdIsP(st, q, ")") Then
                d = d - 1
            ElseIf d = 0 Then
                If sep = "," Then
                    isSep = QdIsP(st, q, ",")
                ElseIf QdIsW(st, q, "BETWEEN") Then
                    pendingBetween = True
                ElseIf QdIsW(st, q, sep) Then
                    If sep = "AND" And pendingBetween Then
                        pendingBetween = False
                    Else
                        isSep = True
                    End If
                End If
            End If
            If isSep Then
                QdPushRange outA, outB, cnt, startPos, q
                startPos = q + 1
            End If
        Next q
        QdPushRange outA, outB, cnt, startPos, b
        QdSplitTop = cnt
    End Function

    ' True when [a, b) is exactly *, F, T.F, T!F or T.*.
    Private Function QdColRef(ByRef st As QdParseState, ByVal a As Long, ByVal b As Long, ByRef outTable As String, ByRef outField As String, ByRef outStar As Boolean) As Boolean
        QdColRef = False
        outTable = vbNullString
        outField = vbNullString
        outStar = False
        If b - a = 1 Then
            If QdIsP(st, a, "*") Then
                outField = "*"
                outStar = True
                QdColRef = True
            ElseIf QdIsName(st, a) Then
                outField = st.TokText(a)
                QdColRef = True
            End If
        ElseIf b - a = 3 Then
            If QdIsName(st, a) And (QdIsP(st, a + 1, ".") Or QdIsP(st, a + 1, "!")) Then
                If QdIsP(st, a + 2, "*") Then
                    outTable = st.TokText(a)
                    outField = "*"
                    outStar = True
                    QdColRef = True
                ElseIf QdKind(st, a + 2) = QD_TOK_WORD Or QdKind(st, a + 2) = QD_TOK_NAME Then
                    outTable = st.TokText(a)
                    outField = st.TokText(a + 2)
                    QdColRef = True
                End If
            End If
        End If
    End Function

    Private Function QdTableIndex(ByRef st As QdParseState, ByVal tableKey As String, ByVal lo As Long, ByVal hi As Long) As Long
        Dim i As Long
        QdTableIndex = -1
        For i = lo To hi - 1
            If UCase$(st.TblKey(i)) = UCase$(tableKey) Then
                QdTableIndex = i
                Exit Function
            End If
        Next i
    End Function

    ' An unqualified field belongs to the only table of the FROM clause.
    Private Function QdResolveTable(ByRef st As QdParseState, ByVal tableKey As String) As String
        QdResolveTable = tableKey
        If Len(tableKey) = 0 And st.TblCount = 1 Then QdResolveTable = st.TblKey(0)
    End Function

    Private Function QdFindCol(ByRef st As QdParseState, ByVal tableKey As String, ByVal baseField As String) As Long
        Dim i As Long
        QdFindCol = -1
        For i = 0 To st.ColCount - 1
            If Len(st.ColBase(i)) > 0 And st.ColBase(i) <> "*" Then
                If UCase$(st.ColBase(i)) = UCase$(baseField) Then
                    If Len(tableKey) = 0 Or Len(st.ColTable(i)) = 0 Or UCase$(st.ColTable(i)) = UCase$(tableKey) Then
                        QdFindCol = i
                        Exit Function
                    End If
                End If
            End If
        Next i
    End Function

    Private Function QdFindExprCol(ByRef st As QdParseState, ByVal exprText As String) As Long
        Dim i As Long
        QdFindExprCol = -1
        For i = 0 To st.ColCount - 1
            If Len(st.ColBase(i)) = 0 And UCase$(st.ColExpr(i)) = UCase$(exprText) Then
                QdFindExprCol = i
                Exit Function
            End If
        Next i
    End Function

    Private Function QdAddCol(ByRef st As QdParseState, ByVal fieldText As String, ByVal tableKey As String, ByVal baseField As String, ByVal aliasName As String, ByVal exprText As String, ByVal showFlag As String) As Long
        Dim newMax As Long
        If st.ColCount > UBound(st.ColField) Then
            newMax = UBound(st.ColField) * 2 + 1
            ReDim Preserve st.ColField(0 To newMax)
            ReDim Preserve st.ColTable(0 To newMax)
            ReDim Preserve st.ColBase(0 To newMax)
            ReDim Preserve st.ColAlias(0 To newMax)
            ReDim Preserve st.ColExpr(0 To newMax)
            ReDim Preserve st.ColSort(0 To newMax)
            ReDim Preserve st.ColShow(0 To newMax)
            ReDim Preserve st.ColCrit(0 To newMax)
            ReDim Preserve st.ColOr(0 To newMax)
        End If
        st.ColField(st.ColCount) = fieldText
        st.ColTable(st.ColCount) = tableKey
        st.ColBase(st.ColCount) = baseField
        st.ColAlias(st.ColCount) = aliasName
        st.ColExpr(st.ColCount) = exprText
        st.ColSort(st.ColCount) = vbNullString
        st.ColShow(st.ColCount) = showFlag
        st.ColCrit(st.ColCount) = vbNullString
        st.ColOr(st.ColCount) = vbNullString
        QdAddCol = st.ColCount
        st.ColCount = st.ColCount + 1
    End Function

    Private Sub QdAddTable(ByRef st As QdParseState, ByVal tableKey As String, ByVal sourceName As String)
        Dim newMax As Long
        If st.TblCount > UBound(st.TblKey) Then
            newMax = UBound(st.TblKey) * 2 + 1
            ReDim Preserve st.TblKey(0 To newMax)
            ReDim Preserve st.TblSrc(0 To newMax)
        End If
        st.TblKey(st.TblCount) = tableKey
        st.TblSrc(st.TblCount) = sourceName
        st.TblCount = st.TblCount + 1
    End Sub

    Private Sub QdAddJoin(ByRef st As QdParseState, ByVal joinText As String)
        Dim newMax As Long
        If st.JoinCount > UBound(st.Joins) Then
            newMax = UBound(st.Joins) * 2 + 1
            ReDim Preserve st.Joins(0 To newMax)
        End If
        st.Joins(st.JoinCount) = joinText
        st.JoinCount = st.JoinCount + 1
    End Sub

    ' FROM item: ( source ) or name [[AS] alias]. Returns the next token index.
    Private Function QdParsePrimary(ByRef st As QdParseState, ByVal p As Long, ByVal b As Long, ByVal depth As Long) As Long
        Dim srcName As String
        Dim aliasName As String

        QdParsePrimary = b
        If Len(st.Reason) > 0 Then Exit Function
        If p >= b Then
            QdFail st, "missing table name"
            Exit Function
        End If
        If QdIsP(st, p, "(") Then
            If QdIsW(st, p + 1, "SELECT") Then
                QdFail st, "subquery in FROM"
                Exit Function
            End If
            p = QdParseSource(st, p + 1, b, depth + 1)
            If Len(st.Reason) > 0 Then Exit Function
            If p >= b Or Not QdIsP(st, p, ")") Then
                QdFail st, "unbalanced parentheses in FROM"
                Exit Function
            End If
            QdParsePrimary = p + 1
            Exit Function
        End If
        If Not QdIsName(st, p) Then
            QdFail st, "unsupported FROM clause"
            Exit Function
        End If
        srcName = st.TokText(p)
        p = p + 1
        aliasName = vbNullString
        If p < b And QdIsW(st, p, "AS") Then
            If p + 1 >= b Or Not QdIsName(st, p + 1) Then
                QdFail st, "missing alias"
                Exit Function
            End If
            aliasName = st.TokText(p + 1)
            p = p + 2
        ElseIf p < b And QdIsName(st, p) Then
            aliasName = st.TokText(p)
            p = p + 1
        End If
        If p < b And QdIsW(st, p, "IN") Then
            QdFail st, "table in an external database"
            Exit Function
        End If
        If Len(aliasName) > 0 Then
            QdAddTable st, aliasName, srcName
        Else
            QdAddTable st, srcName, srcName
        End If
        QdParsePrimary = p
    End Function

    Private Function QdIsJoinWord(ByRef st As QdParseState, ByVal q As Long) As Boolean
        QdIsJoinWord = False
        If QdIsW(st, q, "INNER") Or QdIsW(st, q, "LEFT") Or QdIsW(st, q, "RIGHT") Or QdIsW(st, q, "JOIN") Or QdIsW(st, q, "FULL") Then
            QdIsJoinWord = Not QdIsP(st, q + 1, "(")
        End If
    End Function

    ' ON condition [a, b): equalities joined by AND (any parentheses). Left/right
    ' table ranges orient each equality so the left field belongs to the left side.
    Private Sub QdParseJoinCondition(ByRef st As QdParseState, ByVal a As Long, ByVal b As Long, ByVal joinType As String, ByVal lStart As Long, ByVal lEnd As Long, ByVal rStart As Long, ByVal rEnd As Long, ByVal depth As Long)
        Dim partA() As Long
        Dim partB() As Long
        Dim cnt As Long
        Dim k As Long
        Dim q As Long
        Dim d As Long
        Dim opPos As Long
        Dim la As Long
        Dim lb As Long
        Dim ra As Long
        Dim rb As Long
        Dim lt As String
        Dim lf As String
        Dim rt As String
        Dim rf As String
        Dim tmp As String
        Dim star1 As Boolean
        Dim star2 As Boolean
        Dim ok1 As Boolean
        Dim ok2 As Boolean

        If Len(st.Reason) > 0 Then Exit Sub
        If depth > QD_MAX_DEPTH Then
            QdFail st, "join condition nested too deeply"
            Exit Sub
        End If
        QdPeel st, a, b
        If a >= b Then
            QdFail st, "empty join condition"
            Exit Sub
        End If
        If QdSplitTop(st, a, b, "OR", partA, partB) > 1 Then
            QdFail st, "OR in a join condition"
            Exit Sub
        End If
        cnt = QdSplitTop(st, a, b, "AND", partA, partB)
        If cnt > 1 Then
            For k = 0 To cnt - 1
                QdParseJoinCondition st, partA(k), partB(k), joinType, lStart, lEnd, rStart, rEnd, depth + 1
            Next k
            Exit Sub
        End If

        opPos = -1
        d = 0
        For q = a To b - 1
            If QdIsP(st, q, "(") Then
                d = d + 1
            ElseIf QdIsP(st, q, ")") Then
                d = d - 1
            ElseIf d = 0 And QdIsCompareOp(st, q) Then
                If opPos >= 0 Then
                    QdFail st, "unsupported join expression"
                    Exit Sub
                End If
                opPos = q
            End If
        Next q
        If opPos < 0 Then
            QdFail st, "unsupported join expression"
            Exit Sub
        End If
        If st.TokText(opPos) <> "=" Then
            QdFail st, "join that is not an equality"
            Exit Sub
        End If
        la = a
        lb = opPos
        QdPeel st, la, lb
        ra = opPos + 1
        rb = b
        QdPeel st, ra, rb
        ok1 = QdColRef(st, la, lb, lt, lf, star1)
        ok2 = QdColRef(st, ra, rb, rt, rf, star2)
        If Not ok1 Or Not ok2 Or star1 Or star2 Then
            QdFail st, "unsupported join expression"
            Exit Sub
        End If
        lt = QdResolveTable(st, lt)
        rt = QdResolveTable(st, rt)
        If Len(lt) = 0 Or Len(rt) = 0 Then
            QdFail st, "unqualified field in a join"
            Exit Sub
        End If
        If QdTableIndex(st, lt, rStart, rEnd) >= 0 And QdTableIndex(st, rt, lStart, lEnd) >= 0 Then
            tmp = lt
            lt = rt
            rt = tmp
            tmp = lf
            lf = rf
            rf = tmp
        End If
        QdAddJoin st, lt & "|" & lf & "|" & rt & "|" & rf & "|" & joinType
    End Sub

    ' FROM source: primary { , primary | [INNER|LEFT|RIGHT [OUTER]] JOIN primary ON cond }.
    ' Stops at b or at a ")" that closes the enclosing group; returns that index.
    Private Function QdParseSource(ByRef st As QdParseState, ByVal p As Long, ByVal b As Long, ByVal depth As Long) As Long
        Dim startTbl As Long
        Dim leftEnd As Long
        Dim rightEnd As Long
        Dim joinType As String
        Dim q As Long
        Dim d As Long

        If depth > QD_MAX_DEPTH Then
            QdFail st, "FROM clause nested too deeply"
            QdParseSource = b
            Exit Function
        End If
        startTbl = st.TblCount
        p = QdParsePrimary(st, p, b, depth)
        Do While Len(st.Reason) = 0 And p < b
            If QdIsP(st, p, ")") Then Exit Do
            If QdIsP(st, p, ",") Then
                p = QdParsePrimary(st, p + 1, b, depth)
            Else
                joinType = vbNullString
                If QdIsW(st, p, "INNER") Then
                    joinType = "INNER"
                    p = p + 1
                ElseIf QdIsW(st, p, "LEFT") Then
                    joinType = "LEFT"
                    p = p + 1
                ElseIf QdIsW(st, p, "RIGHT") Then
                    joinType = "RIGHT"
                    p = p + 1
                ElseIf QdIsW(st, p, "JOIN") Then
                    joinType = "INNER"
                Else
                    QdFail st, "unsupported FROM clause"
                    Exit Do
                End If
                If joinType <> "INNER" And QdIsW(st, p, "OUTER") Then p = p + 1
                If Not QdIsW(st, p, "JOIN") Then
                    QdFail st, "unsupported join type"
                    Exit Do
                End If
                leftEnd = st.TblCount
                p = QdParsePrimary(st, p + 1, b, depth)
                If Len(st.Reason) > 0 Then Exit Do
                rightEnd = st.TblCount
                If p >= b Or Not QdIsW(st, p, "ON") Then
                    QdFail st, "join without ON"
                    Exit Do
                End If
                p = p + 1
                q = p
                d = 0
                Do While q < b
                    If QdIsP(st, q, "(") Then
                        d = d + 1
                    ElseIf QdIsP(st, q, ")") Then
                        If d = 0 Then Exit Do
                        d = d - 1
                    ElseIf d = 0 And (QdIsP(st, q, ",") Or QdIsJoinWord(st, q)) Then
                        Exit Do
                    End If
                    q = q + 1
                Loop
                QdParseJoinCondition st, p, q, joinType, startTbl, leftEnd, leftEnd, rightEnd, 0
                p = q
            End If
        Loop
        QdParseSource = p
    End Function

    Private Sub QdParseSelectList(ByRef st As QdParseState, ByVal a As Long, ByVal b As Long)
        Dim itemA() As Long
        Dim itemB() As Long
        Dim cnt As Long
        Dim k As Long
        Dim x As Long
        Dim y As Long
        Dim px As Long
        Dim py As Long
        Dim aliasName As String
        Dim tbl As String
        Dim fld As String
        Dim isStar As Boolean
        Dim isRef As Boolean
        Dim exprText As String
        Dim shown As String

        cnt = QdSplitTop(st, a, b, ",", itemA, itemB)
        For k = 0 To cnt - 1
            x = itemA(k)
            y = itemB(k)
            If x >= y Then
                QdFail st, "empty SELECT item"
                Exit Sub
            End If
            aliasName = vbNullString
            If y - x >= 3 Then
                If QdIsW(st, y - 2, "AS") And (QdKind(st, y - 1) = QD_TOK_WORD Or QdKind(st, y - 1) = QD_TOK_NAME) Then
                    aliasName = st.TokText(y - 1)
                    y = y - 2
                End If
            End If
            px = x
            py = y
            QdPeel st, px, py
            isRef = QdColRef(st, px, py, tbl, fld, isStar)
            exprText = QdRaw(st, x, y)
            If isRef And isStar Then
                If Len(tbl) > 0 Then
                    QdAddCol st, tbl & ".*", tbl, "*", vbNullString, exprText, "1"
                Else
                    QdAddCol st, "*", vbNullString, "*", vbNullString, exprText, "1"
                End If
            ElseIf isRef Then
                tbl = QdResolveTable(st, tbl)
                shown = fld
                If Len(aliasName) > 0 And UCase$(aliasName) <> UCase$(fld) Then shown = aliasName & ": " & fld
                QdAddCol st, shown, tbl, fld, aliasName, exprText, "1"
            ElseIf Len(aliasName) > 0 Then
                QdAddCol st, aliasName & ": " & exprText, vbNullString, vbNullString, aliasName, exprText, "1"
            Else
                QdAddCol st, exprText, vbNullString, vbNullString, vbNullString, exprText, "1"
            End If
        Next k
    End Sub

    ' One WHERE conjunct -> criteria (slot 0) or "or" (slot 1) of its column.
    ' "[(]T.F[)] op rest" puts rest (without a leading "=") on column T.F, adding a
    ' hidden column when needed; other conditions become a hidden expression
    ' column with criteria True.
    Private Sub QdApplyCondition(ByRef st As QdParseState, ByVal a As Long, ByVal b As Long, ByVal slot As Long)
        Dim k As Long
        Dim p As Long
        Dim q As Long
        Dim ln As Long
        Dim pass As Long
        Dim closes As Long
        Dim found As Boolean
        Dim isStar As Boolean
        Dim t As String
        Dim f As String
        Dim tbl As String
        Dim fld As String
        Dim crit As String
        Dim exprText As String
        Dim idx As Long

        QdPeel st, a, b
        If a >= b Then Exit Sub
        k = 0
        p = a
        Do While p < b
            If Not QdIsP(st, p, "(") Then Exit Do
            k = k + 1
            p = p + 1
        Loop
        found = False
        q = p
        For pass = 0 To 1
            ln = 3 - 2 * pass
            If p + ln <= b Then
                If QdColRef(st, p, p + ln, t, f, isStar) Then
                    If Not isStar Then
                        q = p + ln
                        closes = 0
                        Do While closes < k And q < b
                            If Not QdIsP(st, q, ")") Then Exit Do
                            closes = closes + 1
                            q = q + 1
                        Loop
                        If closes = k And q < b Then
                            If QdIsCompareOp(st, q) Then
                                found = True
                            ElseIf QdIsW(st, q, "LIKE") Or QdIsW(st, q, "IS") Or QdIsW(st, q, "IN") Or QdIsW(st, q, "BETWEEN") Or QdIsW(st, q, "NOT") Then
                                found = True
                            End If
                            If found Then
                                tbl = t
                                fld = f
                                Exit For
                            End If
                        End If
                    End If
                End If
            End If
        Next pass

        crit = vbNullString
        If found Then
            If QdIsP(st, q, "=") Then
                crit = QdRaw(st, q + 1, b)
            Else
                crit = QdRaw(st, q, b)
            End If
            If Len(crit) = 0 Then found = False
        End If
        If found Then
            tbl = QdResolveTable(st, tbl)
            idx = QdFindCol(st, tbl, fld)
            If idx < 0 Then idx = QdAddCol(st, fld, tbl, fld, vbNullString, fld, "0")
        Else
            crit = "True"
            exprText = QdRaw(st, a, b)
            idx = QdFindExprCol(st, exprText)
            If idx < 0 Then idx = QdAddCol(st, exprText, vbNullString, vbNullString, vbNullString, exprText, "0")
        End If
        If slot = 0 Then
            If Len(st.ColCrit(idx)) > 0 Then
                st.ColCrit(idx) = st.ColCrit(idx) & " And " & crit
            Else
                st.ColCrit(idx) = crit
            End If
        Else
            If Len(st.ColOr(idx)) > 0 Then
                st.ColOr(idx) = st.ColOr(idx) & " And " & crit
            Else
                st.ColOr(idx) = crit
            End If
        End If
    End Sub

    Private Sub QdParseWhere(ByRef st As QdParseState, ByVal a As Long, ByVal b As Long)
        Dim altA() As Long
        Dim altB() As Long
        Dim conA() As Long
        Dim conB() As Long
        Dim altCount As Long
        Dim conCount As Long
        Dim n As Long
        Dim k As Long
        Dim x As Long
        Dim y As Long

        QdPeel st, a, b
        If a >= b Then Exit Sub
        altCount = QdSplitTop(st, a, b, "OR", altA, altB)
        If altCount > 2 Then
            QdFail st, "more than two OR alternatives in WHERE"
            Exit Sub
        End If
        For n = 0 To altCount - 1
            x = altA(n)
            y = altB(n)
            QdPeel st, x, y
            conCount = QdSplitTop(st, x, y, "AND", conA, conB)
            For k = 0 To conCount - 1
                QdApplyCondition st, conA(k), conB(k), n
            Next k
        Next n
    End Sub

    Private Sub QdParseOrderBy(ByRef st As QdParseState, ByVal a As Long, ByVal b As Long, ByVal selectCount As Long)
        Dim itemA() As Long
        Dim itemB() As Long
        Dim cnt As Long
        Dim k As Long
        Dim i As Long
        Dim x As Long
        Dim y As Long
        Dim idx As Long
        Dim ordinal As Long
        Dim sortText As String
        Dim t As String
        Dim f As String
        Dim isStar As Boolean
        Dim exprText As String

        cnt = QdSplitTop(st, a, b, ",", itemA, itemB)
        For k = 0 To cnt - 1
            x = itemA(k)
            y = itemB(k)
            sortText = "Ascending"
            If y > x And QdIsW(st, y - 1, "DESC") Then
                sortText = "Descending"
                y = y - 1
            ElseIf y > x And QdIsW(st, y - 1, "ASC") Then
                y = y - 1
            End If
            QdPeel st, x, y
            If x < y Then
                idx = -1
                If y - x = 1 And QdKind(st, x) = QD_TOK_WORD Then
                    If QdAllDigits(st.TokText(x)) And Len(st.TokText(x)) <= 9 Then
                        ordinal = CLng(st.TokText(x))
                        If ordinal >= 1 And ordinal <= selectCount Then idx = ordinal - 1
                    End If
                End If
                If idx < 0 Then
                    If QdColRef(st, x, y, t, f, isStar) And Not isStar Then
                        t = QdResolveTable(st, t)
                        idx = QdFindCol(st, t, f)
                        If idx < 0 And Len(t) = 0 Then
                            For i = 0 To st.ColCount - 1
                                If Len(st.ColAlias(i)) > 0 And UCase$(st.ColAlias(i)) = UCase$(f) Then
                                    idx = i
                                    Exit For
                                End If
                            Next i
                        End If
                        If idx < 0 Then idx = QdAddCol(st, f, t, f, vbNullString, f, "0")
                    Else
                        exprText = QdRaw(st, x, y)
                        idx = QdFindExprCol(st, exprText)
                        If idx < 0 Then idx = QdAddCol(st, exprText, vbNullString, vbNullString, vbNullString, exprText, "0")
                    End If
                End If
                st.ColSort(idx) = sortText
            End If
        Next k
    End Sub

    ' Records depth-0 clause starts after SELECT (index 0 FROM, 1 WHERE, 2 HAVING,
    ' 3 GROUP BY, 4 ORDER BY; -1 = absent) and returns the statement end
    ' (";", WITH OWNERACCESS or the last token). UNION and SELECT ... INTO fail.
    Private Function QdFindClauses(ByRef st As QdParseState, ByVal p0 As Long, ByRef clStart() As Long, ByRef clContent() As Long) As Long
        Dim c As Long
        Dim d As Long
        Dim p As Long

        For c = 0 To 4
            clStart(c) = -1
            clContent(c) = -1
        Next c
        d = 0
        p = p0
        Do While p < st.TokCount
            If QdIsP(st, p, "(") Then
                d = d + 1
            ElseIf QdIsP(st, p, ")") Then
                d = d - 1
            ElseIf d = 0 Then
                If QdIsP(st, p, ";") Then Exit Do
                If QdIsW(st, p, "WITH") And QdIsW(st, p + 1, "OWNERACCESS") Then Exit Do
                If QdIsW(st, p, "UNION") Then
                    QdFail st, "UNION query"
                    Exit Do
                End If
                If QdIsW(st, p, "FROM") And clStart(0) < 0 Then
                    clStart(0) = p
                    clContent(0) = p + 1
                End If
                If QdIsW(st, p, "WHERE") And clStart(1) < 0 Then
                    clStart(1) = p
                    clContent(1) = p + 1
                End If
                If QdIsW(st, p, "HAVING") And clStart(2) < 0 Then
                    clStart(2) = p
                    clContent(2) = p + 1
                End If
                If QdIsW(st, p, "GROUP") And QdIsW(st, p + 1, "BY") And clStart(3) < 0 Then
                    clStart(3) = p
                    clContent(3) = p + 2
                End If
                If QdIsW(st, p, "ORDER") And QdIsW(st, p + 1, "BY") And clStart(4) < 0 Then
                    clStart(4) = p
                    clContent(4) = p + 2
                End If
                If QdIsW(st, p, "INTO") And clStart(0) < 0 Then
                    QdFail st, "make-table query"
                    Exit Do
                End If
            End If
            p = p + 1
        Loop
        QdFindClauses = p
    End Function


    Public Function GetNativeReportLayout(ByRef reportName As String, ByRef outLayout As NativeFormLayout, ByRef outErrorMsg As String) As Boolean
        GetNativeReportLayout = AccessStreamDecoder.GetNativeReportLayout(m_database, reportName, outLayout, outErrorMsg)
    End Function

    ' =========================================================================
    ' Form Designer Command History (Undo / Redo) Architecture
    ' =========================================================================
    Private m_commandHistory As DesignerCommandHistory
    Private m_designerLayout As NativeFormLayout
    Private m_designerLayoutValid As Boolean

    Public Property Get CommandHistory() As DesignerCommandHistory
        If m_commandHistory Is Nothing Then
            Set m_commandHistory = New DesignerCommandHistory
        End If
        Set CommandHistory = m_commandHistory
    End Property

    Public Sub SetDesignerLayout(ByRef layout As NativeFormLayout)
        m_designerLayout = layout
        m_designerLayoutValid = True
    End Sub

    Public Sub GetDesignerLayout(ByRef outLayout As NativeFormLayout)
        outLayout = m_designerLayout
    End Sub

    Public Sub ApplyControlGeometry(ByVal ctlIndex As Long, ByVal leftTw As Long, ByVal topTw As Long, ByVal widthTw As Long, ByVal heightTw As Long)
        If ctlIndex >= 0 And ctlIndex < m_designerLayout.CtlCount Then
            m_designerLayout.Ctls(ctlIndex).LeftTw = leftTw
            m_designerLayout.Ctls(ctlIndex).TopTw = topTw
            m_designerLayout.Ctls(ctlIndex).WidthTw = widthTw
            m_designerLayout.Ctls(ctlIndex).HeightTw = heightTw
        End If
    End Sub

    Public Sub ApplyControlProperty(ByVal ctlIndex As Long, ByVal propName As String, ByVal propVal As String)
        Dim pName As String
        pName = LCase$(Trim$(propName))
        If ctlIndex >= 0 And ctlIndex < m_designerLayout.CtlCount Then
            Select Case pName
                Case "caption"
                    m_designerLayout.Ctls(ctlIndex).Caption = propVal
                Case "controlsource"
                    m_designerLayout.Ctls(ctlIndex).ControlSource = propVal
                Case "rowsource"
                    m_designerLayout.Ctls(ctlIndex).RowSource = propVal
                Case "ctlname", "name"
                    m_designerLayout.Ctls(ctlIndex).CtlName = propVal
                Case "left", "lefttw"
                    m_designerLayout.Ctls(ctlIndex).LeftTw = Val(propVal)
                Case "top", "toptw"
                    m_designerLayout.Ctls(ctlIndex).TopTw = Val(propVal)
                Case "width", "widthtw"
                    m_designerLayout.Ctls(ctlIndex).WidthTw = Val(propVal)
                Case "height", "heighttw"
                    m_designerLayout.Ctls(ctlIndex).HeightTw = Val(propVal)
                Case "backcolor"
                    m_designerLayout.Ctls(ctlIndex).BackColor = Val(propVal)
                Case "forecolor"
                    m_designerLayout.Ctls(ctlIndex).ForeColor = Val(propVal)
                Case "visible"
                    m_designerLayout.Ctls(ctlIndex).Visible = (LCase$(propVal) = "true" Or propVal = "1" Or LCase$(propVal) = "yes")
                Case "fontname"
                    m_designerLayout.Ctls(ctlIndex).FontName = propVal
                Case "fontsize"
                    m_designerLayout.Ctls(ctlIndex).FontSize = Val(propVal)
                Case "fontbold"
                    m_designerLayout.Ctls(ctlIndex).FontBold = (LCase$(propVal) = "true" Or propVal = "1" Or LCase$(propVal) = "yes")
            End Select
        ElseIf ctlIndex = -1 Then
            Select Case pName
                Case "caption", "formname"
                    m_designerLayout.FormName = propVal
                Case "recordsource"
                    m_designerLayout.RecordSource = propVal
                Case "defaultview"
                    m_designerLayout.DefaultView = Val(propVal)
                Case "recordselectors"
                    m_designerLayout.RecordSelectors = (LCase$(propVal) = "true" Or propVal = "1" Or LCase$(propVal) = "yes")
                Case "navigationbuttons"
                    m_designerLayout.NavigationButtons = (LCase$(propVal) = "true" Or propVal = "1" Or LCase$(propVal) = "yes")
                Case "allowadditions"
                    m_designerLayout.AllowAdditions = (LCase$(propVal) = "true" Or propVal = "1" Or LCase$(propVal) = "yes")
                Case "formwidthtw", "width"
                    m_designerLayout.FormWidthTw = Val(propVal)
            End Select
        End If
    End Sub

    Public Sub RecordMoveResizeCommand(ByVal ctlIndex As Long, ByVal newLeft As Long, ByVal newTop As Long, ByVal newWidth As Long, ByVal newHeight As Long, ByVal oldLeft As Long, ByVal oldTop As Long, ByVal oldWidth As Long, ByVal oldHeight As Long, Optional ByVal target As Object = Nothing)
        Dim cmd As New MoveResizeControlCommand
        cmd.Init target, ctlIndex, newLeft, newTop, newWidth, newHeight, oldLeft, oldTop, oldWidth, oldHeight
        If m_commandHistory Is Nothing Then Set m_commandHistory = New DesignerCommandHistory
        m_commandHistory.ExecuteCommand cmd
    End Sub

    Public Sub RecordChangePropertyCommand(ByVal ctlIndex As Long, ByVal propName As String, ByVal newValue As String, ByVal oldValue As String, Optional ByVal target As Object = Nothing)
        Dim cmd As New ChangeControlPropertyCommand
        cmd.Init target, ctlIndex, propName, newValue, oldValue
        If m_commandHistory Is Nothing Then Set m_commandHistory = New DesignerCommandHistory
        m_commandHistory.ExecuteCommand cmd
    End Sub

    Public Function UndoDesignerAction() As Boolean
        If m_commandHistory Is Nothing Then Set m_commandHistory = New DesignerCommandHistory
        UndoDesignerAction = m_commandHistory.Undo()
    End Function

    Public Function RedoDesignerAction() As Boolean
        If m_commandHistory Is Nothing Then Set m_commandHistory = New DesignerCommandHistory
        RedoDesignerAction = m_commandHistory.Redo()
    End Function

    ' Compiled Application Package Generator (Native .accde equivalent)
    Public Function MakeCompiledPackage(Optional ByVal sourceDbPath As String = "", Optional ByVal targetPackagePath As String = "", Optional ByRef outErrorMsg As String = "") As Boolean
        Dim srcPath As String
        srcPath = Trim$(sourceDbPath)
        If Len(srcPath) = 0 Then srcPath = m_dbPath
        If Len(srcPath) = 0 Then
            outErrorMsg = "No source database specified or open."
            MakeCompiledPackage = False
            Exit Function
        End If

        Dim tgtPath As String
        tgtPath = Trim$(targetPackagePath)
        If Len(tgtPath) = 0 Then
            Dim dotIdx As Long
            dotIdx = InStrRev(srcPath, ".")
            If dotIdx > 0 Then
                tgtPath = Left$(srcPath, dotIdx - 1) & "_compiled.accde"
            Else
                tgtPath = srcPath & "_compiled.accde"
            End If
        End If

        If StrComp(srcPath, tgtPath, vbTextCompare) = 0 Then
            outErrorMsg = "Target compiled package path cannot be the same as the source database."
            MakeCompiledPackage = False
            Exit Function
        End If

        Dim wasOpen As Boolean
        wasOpen = (StrComp(Trim$(m_dbPath), Trim$(srcPath), vbTextCompare) = 0)
        If wasOpen Then CloseDatabase

        On Error Resume Next
        If Dir$(tgtPath) <> "" Then Kill tgtPath
        FileCopy srcPath, tgtPath
        If Err.Number <> 0 Then
            outErrorMsg = "Failed to create compiled package: " & Err.Description
            If wasOpen Then OpenDatabaseFile srcPath, outErrorMsg
            MakeCompiledPackage = False
            Exit Function
        End If
        On Error GoTo 0

        Dim dbePkg As Object
        Set dbePkg = New DBEngine
        Dim dbPkg As Object
        On Error Resume Next
        Set dbPkg = dbePkg.OpenDatabase(tgtPath)
        If Err.Number <> 0 Or dbPkg Is Nothing Then
            outErrorMsg = "Failed to open package for compiled stamping: " & Err.Description
            If wasOpen Then OpenDatabaseFile srcPath, outErrorMsg
            MakeCompiledPackage = False
            Exit Function
        End If
        On Error GoTo 0

        Dim hasAppInfo As Boolean
        hasAppInfo = False
        Dim tIdx As Long
        For tIdx = 0 To dbPkg.TableDefs.Count - 1
            If UCase$(Trim$(dbPkg.TableDefs.Item(tIdx).Name)) = "MSYSAPPINFO" Then
                hasAppInfo = True
                Exit For
            End If
        Next tIdx

        On Error Resume Next
        dbPkg.IsCompiledLocked = False
        If Not hasAppInfo Then
            dbPkg.Execute "CREATE TABLE MSysAppInfo (PropName TEXT(50), PropVal TEXT(50))"
        End If

        dbPkg.Execute "DELETE FROM MSysAppInfo WHERE PropName = 'IsCompiledLocked' OR PropName = 'MDE'"
        dbPkg.Execute "INSERT INTO MSysAppInfo (PropName, PropVal) VALUES ('IsCompiledLocked', 'True')"
        dbPkg.Execute "INSERT INTO MSysAppInfo (PropName, PropVal) VALUES ('MDE', 'B')"
        dbPkg.IsCompiledLocked = True
        On Error GoTo 0

        dbPkg.Close
        Set dbPkg = Nothing
        Set dbePkg = Nothing

        If wasOpen Then
            OpenDatabaseFile srcPath, outErrorMsg
        End If

        outErrorMsg = vbNullString
        MakeCompiledPackage = True
    End Function

End Module
