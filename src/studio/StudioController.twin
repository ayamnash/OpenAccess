    ' Native Access form layout model (studio-forms-queries-rendering-fix).
    ' Geometry is stored in twips. Stored in typed dynamic arrays only (never Collection, TB5083).
    Public Type NativeControlDef
        CtlType As String        ' Label|TextBox|ComboBox|ListBox|CommandButton|CheckBox|OptionButton|Subform|Line|Rectangle|Image|Unknown
        CtlName As String
        Section As Long          ' 0 Detail, 1 FormHeader, 2 FormFooter, 3 PageHeader, 4 PageFooter
        LeftTw As Long
        TopTw As Long
        WidthTw As Long
        HeightTw As Long
        Caption As String
        ControlSource As String
        RowSource As String
        BoundColumn As Long
        ColumnWidths As String
        ColumnCount As Long
        SourceObject As String
        LinkMaster As String
        LinkChild As String
        OnClick As String
        ParentLabelOf As String
        BackColor As Long
        ForeColor As Long
        FontName As String
        FontSize As Long
        FontBold As Boolean
        Visible As Boolean
        TextAlign As Long
        ReadingOrder As Long
        RightToLeft As Boolean
    End Type

    Public Type NativeFormLayout
        FormName As String
        RecordSource As String
        DefaultView As Long      ' 0 Single, 1 Continuous, 2 Datasheet, 5 Split -> treated as Single
        RecordSelectors As Boolean
        NavigationButtons As Boolean
        AllowAdditions As Boolean
        FormWidthTw As Long
        SectionHeightTw(0 To 4) As Long
        SectionBackColor(0 To 4) As Long
        SectionPresent(0 To 4) As Boolean
        CtlCount As Long
        Ctls() As NativeControlDef
        LayoutSource As String   ' "Blob", "SaveAsText", "Cache", "TypeInfoFallback"
        RightToLeft As Boolean
    End Type

