    Public Function GetStartupFormName(ByRef outFormName As String) As Boolean
        outFormName = vbNullString
        GetStartupFormName = False
        If m_database Is Nothing Then Exit Function

        Dim forms As Collection
        Set forms = GetCustomObjectNames("FORM")
        If forms Is Nothing Then Exit Function
        If forms.Count = 0 Then Exit Function

        Dim candidate As Variant
        Dim standardNames(0 To 4) As String
        standardNames(0) = "Startup"
        standardNames(1) = "Main"
        standardNames(2) = "Switchboard"
        standardNames(3) = "Home"
        standardNames(4) = "frmMain"

        Dim sIdx As Long
        For sIdx = 0 To 4
            For Each candidate In forms
                If StrComp(CStr(candidate), standardNames(sIdx), vbTextCompare) = 0 Then
                    outFormName = CStr(candidate)
                    GetStartupFormName = True
                    Exit Function
                End If
            Next candidate
        Next sIdx

        outFormName = CStr(forms(1))
        GetStartupFormName = True
    End Function

    Public Function HasMacro(ByVal macroName As String) As Boolean
        HasMacro = False
        If m_database Is Nothing Then Exit Function
        Dim macros As Collection
        Set macros = GetCustomObjectNames("MACRO")
        If macros Is Nothing Then Exit Function
        Dim m As Variant
        For Each m In macros
            If StrComp(CStr(m), macroName, vbTextCompare) = 0 Then
                HasMacro = True
                Exit Function
            End If
        Next m
    End Function

    Private m_engine As IDataEngine

    Public Property Get ActiveDataEngine() As IDataEngine
        If m_engine Is Nothing Then
            Set m_engine = EngineManager.ActiveEngine
        End If
        ' Plan 7 WS0-B [CRITICAL FIX]: Synchronize active engine with open database to prevent split-brain state
        If Not m_database Is Nothing And Not m_engine Is Nothing Then
            If Not m_engine.IsOpen Then
                m_engine.OpenDatabase m_dbPath
            End If
        End If
        Set ActiveDataEngine = m_engine
    End Property

    Public Function GetCurrentEngine() As IDataEngine
        Set GetCurrentEngine = ActiveDataEngine
    End Function

    Public Sub SetEngineMode(ByVal mode As String)
        EngineManager.EngineMode = mode
        Set m_engine = EngineManager.ActiveEngine
        If Not m_engine Is Nothing Then
            Set m_dbe = m_engine.RawDBEngine
            m_engineVersion = m_engine.EngineVersion
            If Len(m_dbPath) > 0 Then
                Set m_database = m_engine.OpenDatabase(m_dbPath)
            End If
        End If
    End Sub

