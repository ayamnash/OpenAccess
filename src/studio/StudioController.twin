    Public Function GetNavCategoryName(ByVal catIdx As Long) As String
        Select Case catIdx
            Case 0: GetNavCategoryName = "All Access Objects"
            Case 1: GetNavCategoryName = "Tables"
            Case 2: GetNavCategoryName = "Queries"
            Case 3: GetNavCategoryName = "Forms"
            Case 4: GetNavCategoryName = "Reports"
            Case 5: GetNavCategoryName = "Macros"
            Case 6: GetNavCategoryName = "Modules"
            Case Else: GetNavCategoryName = "All Access Objects"
        End Select
    End Function

