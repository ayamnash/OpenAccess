    Public Function InitializeEngine() As Boolean
        Dim isOk As Boolean
        isOk = False
        On Error Resume Next

        ' 1. Try active engine or installed ACE DAO engine via PAL
        Err.Clear
        Dim curEng As IDataEngine
        Set curEng = EngineManager.ActiveEngine
        If Not curEng Is Nothing Then
            Set m_dbe = curEng.RawDBEngine
        End If
        If m_dbe Is Nothing Then
            Set m_dbe = New DBEngine
        End If

        If Not m_dbe Is Nothing Then
            Err.Clear
            m_engineVersion = m_dbe.Version
            isOk = True
        End If
        On Error GoTo 0

        If m_immediateHistory Is Nothing Then
            Set m_immediateHistory = New Collection
        End If

        InitializeEngine = isOk
    End Function

