    ' Native Form View (mode 10) state. LoadFormLayout fills m_formLayout,
    ' RenderNativeForm shows it (painting and pool binding: task 7.2).
    ' m_formLayoutKey = "FORM|<name>" for forms, "TABLE|<name>" for the table AutoForm card.
    Private m_formLayout As NativeFormLayout
    Private m_formLayoutValid As Boolean
    Private m_formLayoutKey As String
    Private m_formName As String
    Private m_formNeedsOpen As Boolean

    ' Form canvas pool map (task 7.2). Global slot numbers: 1..24 fcTxtNN, 25..32 fcCboNN,
    ' 33..40 fcBtnNN, 41..48 fcChkNN. m_poolCtlIndex(slot) = index into m_formLayout.Ctls, -1 = free.
    Private Const FC_SLOT_TXT_BASE As Long = 0
    Private Const FC_SLOT_CBO_BASE As Long = FC_POOL_TXT
    Private Const FC_SLOT_LST_BASE As Long = FC_POOL_TXT + FC_POOL_CBO
    Private Const FC_SLOT_BTN_BASE As Long = FC_POOL_TXT + FC_POOL_CBO + FC_POOL_LST
    Private Const FC_SLOT_CHK_BASE As Long = FC_POOL_TXT + FC_POOL_CBO + FC_POOL_LST + FC_POOL_BTN
    Private Const FC_SLOT_TOTAL As Long = FC_POOL_TXT + FC_POOL_CBO + FC_POOL_LST + FC_POOL_BTN + FC_POOL_CHK
    Private Const FC_SELECTOR_PX As Long = 16
    Private m_poolCtlIndex(1 To FC_SLOT_TOTAL) As Long
    Private m_formOverflowCount As Long
    Private m_formCanvasNote As String

    ' Continuous Forms / Datasheet default view state (task 7.3).
    ' m_formTopRow = 0-based record index of the first painted row. The (New) row has index = record count.
    ' m_fcRow* hold the row geometry of the last paint for picFormCanvas_MouseDown hit-testing.
    Private Const FC_ROW_LIVE As Long = 0        ' pooled controls bound to the current record
    Private Const FC_ROW_PAINTED As Long = 1     ' painted read-only from a row cursor
    Private Const FC_ROW_NEW As Long = 2         ' painted (New) row, empty values
    Private Const FC_DS_HEADER_PX As Long = 22
    Private Const FC_DS_ROW_PX As Long = 20
    Private Const FC_DS_MAX_COL_PX As Long = 240
    ' Query Design View (mode 12) geometry, pixels
    Private Const QD_BOX_LEFT_PX As Long = 20
    Private Const QD_BOX_TOP_PX As Long = 16
    Private Const QD_BOX_W_PX As Long = 150
    Private Const QD_BOX_GAP_PX As Long = 60
    Private Const QD_BOX_TITLE_PX As Long = 20
    Private Const QD_BOX_ROW_PX As Long = 16
    Private Const QD_BOX_MAX_ROWS As Long = 10
    Private Const QD_JOIN_STUB_PX As Long = 8
    Private Const QD_QBE_HEADER_W_PX As Long = 80
    Private Const QD_QBE_TOP_PX As Long = 10
    Private Const QD_QBE_ROW_PX As Long = 22
    Private Const QD_QBE_COL_W_PX As Long = 120
    Private m_formTopRow As Long
    Private m_formRenderedName As String
    Private m_formScrollPaint As Boolean      ' True while repainting from vsbFormCanvas (no snap to the current row)
    Private m_formScrollSync As Boolean
    Private m_fcRowHitEnabled As Boolean
    Private m_fcRowsTop As Long
    Private m_fcRowPx As Long
    Private m_fcRecords As Long
    Private m_fcPaintedRows As Long
    Private m_fcNewShown As Boolean
    ' Form navigation bar state (task 7.4). The (New) position is the active recordset at EOF
    ' (controller index stays at the record count); m_formAtNew mirrors it so a non-clone
    ' row cursor walk puts the recordset back on EOF. m_navSkipFormRebind suppresses the
    ' canvas repaint in UpdateNavigationControls right after RenderNativeForm painted it.
    Private m_formAtNew As Boolean
    Private m_navSkipFormRebind As Boolean
    ' Lookup display cache for painted combo values: key "ctlIdx|raw" (reset by RenderNativeForm).
    Private m_lkCacheKey() As String
    Private m_lkCacheVal() As String
    Private m_lkCacheCount As Long
    ' Pooled combo lists (task 8.1), per combo pool slot n = 1..FC_POOL_CBO (fcCboNN):
    '   m_cboFilled(n) / m_cboListCtl(n): list already filled from the RowSource of layout
    '     control m_cboListCtl(n) (reset by RenderNativeForm, so each list is filled once per render).
    '   m_cboBound(n): the bound-column values parallel to the list items. VBA cannot declare
    '     "m_cboBound(n)() As String", so each Variant element holds a String() array (jagged array).
    '   m_cboCount(n): number of list items.
    '   m_cboBinding: True while the code sets ListIndex/Text, so Click/Change handlers can ignore it.
    Private Const FC_CBO_MAX_ITEMS As Long = 2000
    Private m_cboFilled(1 To FC_POOL_CBO) As Boolean
    Private m_cboListCtl(1 To FC_POOL_CBO) As Long
    Private m_cboBound(1 To FC_POOL_CBO) As Variant
    Private m_cboCount(1 To FC_POOL_CBO) As Long
    Private m_cboBinding As Boolean

    ' Pooled control edits (task 8.2): m_poolDirty(slot) = the user changed the pooled control
    ' in global slot `slot` since the last bind; "Save Form Record" (mode 10) writes those
    ' values to the current record. m_poolBinding is True while BindPoolControl sets values,
    ' so the Change/Click handlers ignore code-driven changes. PaintFormCanvas clears both.
    Private m_poolDirty(1 To FC_SLOT_TOTAL) As Boolean
    Private m_poolBinding As Boolean

    ' Paint target of the shared canvas painters (labels, read-only controls, painted rows,
    ' selector and datasheet cells): picFormCanvas for the parent form, picSubNN while a
    ' subform slot is painted (PaintSubformSlot). m_lkKeyPrefix separates the lookup cache
    ' keys of subform controls ("" for the parent form).
    Private m_fcPic As PictureBox
    Private m_lkKeyPrefix As String

    ' Embedded subforms (task 9.2), slot s = 1..FC_POOL_SUB (picSubNN with vsbSubNN):
    '   m_subUsed(s) / m_subCtlIdx(s): slot shown by the last PaintFormCanvas for parent layout
    '     control m_subCtlIdx(s); m_subCount = slots taken in that pass (overflow is painted
    '     as a labeled rectangle).
    '   m_subPaintedKey(s): m_formLayoutKey & "|" & ctlIdx of the child content in the slot.
    '   m_subLayout(s) / m_subLayoutName(s): child layout for SourceObject m_subLayoutName(s)
    '     (Form.X: GetNativeFormLayout; Table.X / Query.X: AutoForm layout shown as a datasheet).
    '   m_subRs(s): linked child recordset from OpenChildRecordset (owned here; closed on each
    '     refresh and by HideRenderSurfaces). m_subRecords(s) / m_subTopRow(s): child row count
    '     and the child's own top row (vsbSubNN). m_subNote(s): open error shown in the slot.
    Private Const FC_ROW_BANDS As Long = 3       ' painted FormHeader/FormFooter controls (subforms)
    Private m_subCount As Long
    Private m_subUsed(1 To FC_POOL_SUB) As Boolean
    Private m_subCtlIdx(1 To FC_POOL_SUB) As Long
    Private m_subPaintedKey(1 To FC_POOL_SUB) As String
    Private m_subLayout(1 To FC_POOL_SUB) As NativeFormLayout
    Private m_subLayoutName(1 To FC_POOL_SUB) As String
    Private m_subRs(1 To FC_POOL_SUB) As Object
    Private m_subRecords(1 To FC_POOL_SUB) As Long
    Private m_subTopRow(1 To FC_POOL_SUB) As Long
    Private m_subNote(1 To FC_POOL_SUB) As String
    Private m_subScrollSync As Boolean

    ' Query Datasheet View (mode 11, task 10.2), painted on picDatasheet by PaintDatasheet:
    '   m_dsQueryName: saved query shown (lookup resolution source for ResolveFieldLookupValue).
    '   m_dsTopRow: 0-based first painted record row (vsbDatasheet); the (New) row index = record count.
    '   m_dsColRs / m_dsColCount / m_dsColName() / m_dsColW(): column layout computed once per
    '     recordset: width = max(header, sampled values) * avgCharWidth, capped at FC_DS_MAX_COL_PX.
    '   m_dsAllowNew: the recordset is updatable, so a (New) row with * is painted.
    '   m_dsRows* / m_dsRecords / m_dsPainted / m_dsNewShown: geometry of the last paint
    '     (picDatasheet_MouseDown hit-testing); m_dsVisibleRows / m_dsMaxTop: scroll range.
    '   m_dsLk*: lookup display cache "colIdx|raw" (reset when a query is opened).
    Private Const DS_SAMPLE_ROWS As Long = 50
    Private m_dsQueryName As String
    ' Saved query shown in the current Query view (modes 11/12/13); used by the
    ' btnQryDatasheet / btnQryDesign / btnQrySql view switches (task 10.4).
    Private m_activeQueryName As String
    Private m_dsTopRow As Long
    Private m_dsScrollSync As Boolean
    Private m_dsScrollPaint As Boolean
    Private m_dsColRs As Object
    Private m_dsColCount As Long
    Private m_dsColName() As String
    Private m_dsIsRtl As Boolean
    Private m_dsColW() As Long
    Private m_dsColIsBool() As Boolean
    Private m_dsAllowNew As Boolean
    Private m_dsRecords As Long
    Private m_dsPainted As Long
    Private m_dsNewShown As Boolean
    Private m_dsVisibleRows As Long
    Private m_dsMaxTop As Long
    Private m_dsLkKey() As String
    Private m_dsLkVal() As String
    Private m_dsLkCount As Long
    Private m_dsEditActive As Boolean
    Private m_dsEditCol As Long
    Private m_dsEditRow As Long
    Private m_dsRecordDirty As Boolean
    Private m_dsOriginalVal As String
    Private m_dsSortCol As Long
    Private m_dsSortDesc As Boolean
    Private m_dsResizingCol As Long
    Private m_dsResizeStartX As Single
    Private m_dsResizeStartW As Long
    Private Sub Form_QueryUnload(Cancel As Integer, UnloadMode As Integer)
        On Error Resume Next
        If m_dsEditActive Then CommitDatasheetCellEdit
        If m_dsRecordDirty Then SaveDatasheetRecord
        On Error GoTo 0
    End Sub

    Private Sub Form_Unload(Cancel As Integer)
        On Error Resume Next
        If m_dsEditActive Then CommitDatasheetCellEdit
        If m_dsRecordDirty Then SaveDatasheetRecord
        StudioController.CloseDatabase
        On Error GoTo 0
    End Sub







    Private m_relDialogActive As Boolean
    Private m_relDialogExistingName As String
    Private m_relDialogIsQbeJoin As Boolean
    Private m_relDialogQbeJoinIdx As Long
    Private m_relDialogUpdatingChecks As Boolean
    Private m_qbeSelectedJoinIdx As Long

    Private Sub picSub01_Paint()
        If m_relDialogActive Then PaintVisualRelationshipDialog
    End Sub

    Private Sub Form_Activate()
        On Error Resume Next
        ApplyResponsiveLayout
        On Error GoTo 0
    End Sub

    Private Sub Form_Resize()
        On Error Resume Next
        If Me.WindowState = vbMinimized Then Exit Sub
        If m_dsEditActive Then CommitDatasheetCellEdit
        If m_tdEditing Then CommitTableDesignCellEdit
        ApplyResponsiveLayout
        On Error GoTo 0
    End Sub

    Public Sub ApplyResponsiveLayout()
        Static inLayout As Boolean
        If inLayout Then Exit Sub
        On Error Resume Next
        If Me.WindowState = vbMinimized Then Exit Sub
        inLayout = True

        Me.ScaleMode = vbPixels
        Dim sw As Long
        Dim sh As Long
        Dim rc As WIN32_CLIENT_RECT
        sw = CLng(Me.ScaleWidth)
        sh = CLng(Me.ScaleHeight)
        If Me.hWnd <> 0 Then
            If GetClientRect(Me.hWnd, rc) <> 0 Then
                If (rc.Right - rc.Left) > 400 Then sw = rc.Right - rc.Left
                If (rc.Bottom - rc.Top) > 300 Then sh = rc.Bottom - rc.Top
            End If
        End If
        If sw < 780 Then sw = 780
        If sh < 480 Then sh = 480

        ' 1. Bottom-Docked Section (Always anchored at the bottom of the screen):
        '    Row 3 (Bottom): Status bar (lblStatus)
        '    Row 2 (Middle): SQL / Expr bar (lblSqlTitle, txtSql, btnRunSql, btnEvalExpr)
        '    Row 1 (Top):    Open Selected Object (btnOpenTable) + Record Navigation Bar
        Dim statusTop As Long
        Dim sqlTop As Long
        Dim navTop As Long
        statusTop = sh - 28
        sqlTop = sh - 64
        navTop = sh - 98

        lblStatus.Left = 12
        lblStatus.Top = statusTop
        lblStatus.Width = sw - 24
        lblStatus.Height = 22

        lblSqlTitle.Left = 12
        lblSqlTitle.Top = sqlTop + 4
        lblSqlTitle.Width = 80
        lblSqlTitle.Height = 22

        btnEvalExpr.Width = 117
        btnEvalExpr.Height = 28
        btnEvalExpr.Left = sw - 12 - 117
        btnEvalExpr.Top = sqlTop

        btnRunSql.Caption = "Run SQL (!) (Trial)"
        btnRunSql.Width = 135
        btnRunSql.Height = 28
        btnRunSql.Left = btnEvalExpr.Left - 6 - 135
        btnRunSql.Top = sqlTop

        txtSql.Left = 96
        txtSql.Top = sqlTop
        If btnRunSql.Left - 6 - 96 > 120 Then
            txtSql.Width = btnRunSql.Left - 6 - 96
        Else
            txtSql.Width = 120
        End If
        txtSql.Height = 28

        btnOpenTable.Left = 12
        btnOpenTable.Top = navTop
        btnOpenTable.Width = 216
        btnOpenTable.Height = 28

        Dim dx As Long
        If m_currentWorkspaceMode = 10 Then dx = 48 Else dx = 0
        lblNavRecord.Left = 238
        lblNavRecord.Top = navTop + 4
        btnFirst.Left = 238 + dx
        btnFirst.Top = navTop
        btnPrev.Left = 278 + dx
        btnPrev.Top = navTop
        txtRecordPos.Left = 318 + dx
        txtRecordPos.Top = navTop + 1
        lblOfTotal.Left = 368 + dx
        lblOfTotal.Top = navTop + 4
        btnNext.Left = 432 + dx
        btnNext.Top = navTop
        btnLast.Left = 472 + dx
        btnLast.Top = navTop
        btnNavNew.Left = 512 + dx
        btnNavNew.Top = navTop
        lblActiveRow.Left = 560 + dx
        lblActiveRow.Top = navTop + 4
        If sw - 12 - lblActiveRow.Left > 80 Then
            lblActiveRow.Width = sw - 12 - lblActiveRow.Left
        End If

        ' 2. Left Navigation Pane (stretches vertically down to btnOpenTable)
        lstTables.Left = 12
        lstTables.Top = 158
        lstTables.Width = 216
        If navTop - 4 - 158 > 60 Then
            lstTables.Height = navTop - 4 - 158
        End If

        ' 3. Top Header Labels
        If sw - 12 - lblDbInfo.Left > 120 Then
            lblDbInfo.Width = sw - 12 - lblDbInfo.Left
        End If
        lblTableTitle.Left = 238
        If sw - 12 - 238 > 120 Then
            lblTableTitle.Width = sw - 12 - 238
        End If

        ' 4. Main Workspace Surface (stretches horizontally & vertically to fill available space)
        Dim workLeft As Long
        Dim workTop As Long
        Dim workW As Long
        Dim workBottom As Long
        Dim workH As Long
        workLeft = 238
        workTop = 104
        workW = sw - workLeft - 12
        If workW < 400 Then workW = 400
        workBottom = navTop - 6
        workH = workBottom - workTop
        If workH < 220 Then workH = 220

        Select Case m_currentWorkspaceMode
            Case 0, 11  ' Table / Query Datasheet View
                picDatasheet.Left = workLeft
                picDatasheet.Top = workTop
                picDatasheet.Width = workW - 16
                picDatasheet.Height = workH
                vsbDatasheet.Left = workLeft + workW - 16
                vsbDatasheet.Top = workTop
                vsbDatasheet.Height = workH
                PaintQueryDatasheet

            Case 1  ' Table Design View (Upper Schema Grid + Lower Field Properties)
                Dim tdUpperH As Long
                tdUpperH = (workH * 58) \ 100
                If tdUpperH < 160 Then tdUpperH = 160
                picDatasheet.Left = workLeft
                picDatasheet.Top = workTop
                picDatasheet.Width = workW - 16
                picDatasheet.Height = tdUpperH
                vsbDatasheet.Left = workLeft + workW - 16
                vsbDatasheet.Top = workTop
                vsbDatasheet.Height = tdUpperH

                lblPropHeader.Left = workLeft
                lblPropHeader.Top = workTop + tdUpperH + 6
                lblPropHeader.Width = workW

                lstPropSheet.Left = workLeft
                lstPropSheet.Top = workTop + tdUpperH + 28
                lstPropSheet.Width = workW
                If workBottom - (workTop + tdUpperH + 28) > 60 Then
                    lstPropSheet.Height = workBottom - (workTop + tdUpperH + 28)
                End If
                PaintTableDesignGrid

            Case 2  ' Interactive Form View
                lstRecords.Left = workLeft
                lstRecords.Top = 300
                lstRecords.Width = workW
                If workBottom - 300 > 60 Then
                    lstRecords.Height = workBottom - 300
                End If

            Case 3, 6  ' Form Design View (Canvas + Right Property Sheet)
                Dim propW As Long
                propW = 312
                picFormCanvas.Left = workLeft
                picFormCanvas.Top = workTop
                picFormCanvas.Width = workW - propW - 20
                picFormCanvas.Height = workH
                vsbFormCanvas.Left = workLeft + workW - propW - 18
                vsbFormCanvas.Top = workTop
                vsbFormCanvas.Height = workH

                lblPropHeader.Left = workLeft + workW - propW
                lblPropHeader.Top = workTop
                lblPropHeader.Width = propW
                lstPropSheet.Left = workLeft + workW - propW
                lstPropSheet.Top = 128
                lstPropSheet.Width = propW
                If workBottom - 128 > 60 Then
                    lstPropSheet.Height = workBottom - 128
                End If
                PaintVisualFormDesigner

            Case 4, 7  ' VBE Code Editor
                txtVbaCode.Left = workLeft
                txtVbaCode.Top = 154
                txtVbaCode.Width = workW
                If workBottom - 154 > 60 Then
                    txtVbaCode.Height = workBottom - 154
                End If

            Case 8  ' Visual Relationships Diagram (Upper ERD Canvas + Right Add Tables + Lower Active Relationships)
                Dim addPaneW As Long
                Dim relUpperH As Long
                addPaneW = 192
                relUpperH = (workH * 54) \ 100
                If relUpperH < 180 Then relUpperH = 180

                picQryTables.Left = workLeft
                picQryTables.Top = workTop
                picQryTables.Width = workW - addPaneW - 4
                picQryTables.Height = relUpperH

                lblPropHeader.Left = workLeft + workW - addPaneW
                lblPropHeader.Top = workTop
                lblPropHeader.Width = addPaneW
                lstPropSheet.Left = workLeft + workW - addPaneW
                lstPropSheet.Top = 126
                lstPropSheet.Width = addPaneW
                If relUpperH - 22 > 60 Then
                    lstPropSheet.Height = relUpperH - 22
                End If

                lblGridHeader.Left = workLeft
                lblGridHeader.Top = workTop + relUpperH + 6
                lblGridHeader.Width = workW

                lstRecords.Left = workLeft
                lstRecords.Top = workTop + relUpperH + 28
                lstRecords.Width = workW
                If workBottom - (workTop + relUpperH + 28) > 60 Then
                    lstRecords.Height = workBottom - (workTop + relUpperH + 28)
                End If
                PaintQueryTables picQryTables, m_qbeTables, m_qbeJoins

            Case 10  ' Native Form View
                picFormCanvas.Left = workLeft
                picFormCanvas.Top = workTop
                picFormCanvas.Width = workW - 16
                picFormCanvas.Height = workH
                vsbFormCanvas.Left = workLeft + workW - 16
                vsbFormCanvas.Top = workTop
                vsbFormCanvas.Height = workH
                PaintFormCanvas

            Case 12  ' Query Design View (Upper Tables/Joins + Right Add Tables + Lower QBE Grid)
                Dim qbeAddW As Long
                Dim qbeUpperH As Long
                qbeAddW = 192
                qbeUpperH = (workH * 48) \ 100
                If qbeUpperH < 160 Then qbeUpperH = 160

                picQryTables.Left = workLeft
                picQryTables.Top = workTop
                picQryTables.Width = workW - qbeAddW - 4
                picQryTables.Height = qbeUpperH

                lblPropHeader.Left = workLeft + workW - qbeAddW
                lblPropHeader.Top = workTop
                lblPropHeader.Width = qbeAddW
                lstPropSheet.Left = workLeft + workW - qbeAddW
                lstPropSheet.Top = 126
                lstPropSheet.Width = qbeAddW
                If qbeUpperH - 22 > 60 Then
                    lstPropSheet.Height = qbeUpperH - 22
                End If

                picQbeGrid.Left = workLeft
                picQbeGrid.Top = workTop + qbeUpperH + 6
                picQbeGrid.Width = workW
                If workBottom - (workTop + qbeUpperH + 6) > 60 Then
                    picQbeGrid.Height = workBottom - (workTop + qbeUpperH + 6)
                End If
                PaintQueryTables picQryTables, m_qbeTables, m_qbeJoins
                PaintQbeGrid picQbeGrid, m_qbeCols

            Case 13  ' Query SQL View
                txtSqlView.Left = workLeft
                txtSqlView.Top = workTop
                txtSqlView.Width = workW
                txtSqlView.Height = workH

            Case Else
                lblGridHeader.Left = workLeft
                lblGridHeader.Top = workTop
                lblGridHeader.Width = workW
                lstRecords.Left = workLeft
                lstRecords.Top = 126
                lstRecords.Width = workW
                If workBottom - 126 > 60 Then
                    lstRecords.Height = workBottom - 126
                End If
        End Select

        If m_relDialogActive Then LayoutVisualRelationshipDialog
        inLayout = False
        On Error GoTo 0
    End Sub
Private Sub Form_Load()
        Dim isEngineReady As Boolean
        isEngineReady = StudioController.InitializeEngine()

        If isEngineReady Then
            lblStatus.Caption = "Ready | Engine v" & StudioController.GetEngineVersion() & " Active | Mode: Table Datasheet"
        Else
            lblStatus.Caption = "Notice: Database Engine not detected. Please register DLLs before connecting."
        End If

        m_editorLeft = 690
        m_editorTop = 130
        m_editorWidth = 500
        m_editorHeight = 280
        m_editorVisible = True
        m_editorExpanded = False

        UpdateRibbonToolbar "TABLE"
        SwitchWorkspaceMode 0
        UpdateNavigationControls
        Me.WindowState = vbMaximized
        ApplyResponsiveLayout
    End Sub

