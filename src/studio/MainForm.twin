    ' -------------------------------------------------------------------------
    ' Phase 1 & Phase 17: File Operations (New, Open & Close Database)
    ' -------------------------------------------------------------------------
    Private Sub btnNewDb_Click()
        Dim targetFile As String
        Dim errMsg As String
        Dim ok As Boolean

        targetFile = CommonDialogs.ShowSaveDatabaseDialog(Me.hWnd)
        If Len(Trim$(targetFile)) = 0 Then
            targetFile = InputBox("Enter destination file path for the new database (.accdb or .mdb):", "New Database from Template", "NewDatabase1.accdb")
        End If
        targetFile = Trim$(targetFile)
        If Len(targetFile) = 0 Then Exit Sub

        lblStatus.Caption = "Creating new database from template: " & targetFile & "..."
        ok = StudioController.CreateNewDatabaseFile(targetFile, False, errMsg)
        If ok Then
            lblDbInfo.Caption = "Active: " & targetFile
            lblStatus.Caption = "Created and opened database from template: " & targetFile
            RefreshNavigationPane
            MsgBox "New database created from template successfully:" & vbCrLf & targetFile, vbInformation, "Database Created"
        Else
            lblStatus.Caption = "Error: " & errMsg
            Dim promptChoice As VbMsgBoxResult
            promptChoice = MsgBox(errMsg & vbCrLf & vbCrLf & "Would you like to select an existing Access file (.accdb / .mdb) to open instead?", vbQuestion + vbYesNo, "Select Existing File")
            If promptChoice = vbYes Then
                btnOpenDb_Click
            End If
        End If
    End Sub

    Private Sub btnOpenDb_Click()
        Dim chosenFile As String
        Dim errMsg As String
        Dim ok As Boolean

        chosenFile = CommonDialogs.ShowOpenDatabaseDialog(Me.hWnd)
        If Len(chosenFile) = 0 Then Exit Sub

        lblStatus.Caption = "Opening database: " & chosenFile & "..."
        ok = StudioController.OpenDatabaseFile(chosenFile, errMsg)

        If ok Then
            lblDbInfo.Caption = "Active: " & chosenFile
            lblStatus.Caption = "Database opened successfully. Engine: v" & StudioController.GetEngineVersion()
            RefreshNavigationPane
        Else
            lblStatus.Caption = "Error opening file: " & errMsg
            MsgBox errMsg, vbCritical, "OpenAccess Studio"
        End If
    End Sub

    Private Sub btnCloseDb_Click()
        If m_dsEditActive Then CommitDatasheetCellEdit
        If m_dsRecordDirty Then SaveDatasheetRecord
        StudioController.CloseDatabase
        lstTables.Clear
        lstRecords.Clear
        lstVbaCode.Clear
        lstPropSheet.Clear
        lblDbInfo.Caption = "No database open. Click 'Open DB...' or 'New DB [+]' to begin."
        lblTableTitle.Caption = "Datasheet View:"
        lblStatus.Caption = "Database closed."
        UpdateNavigationControls
    End Sub

    ' -------------------------------------------------------------------------
    ' Phase 1 & Phase 19: 6-Category Navigation Pane & Object Filtering
    ' -------------------------------------------------------------------------
    Private Sub btnNavFilter_Click()
        Dim catName As String
        catName = StudioController.CycleNavCategoryFilter()
        btnNavFilter.Caption = "Category: " & catName
        lblNavTitle.Caption = catName & ":"
        If StudioController.IsDatabaseOpen() Then
            RefreshNavigationPane
        End If
    End Sub

    Private Sub RefreshNavigationPane()
        Dim tblCollection As Collection
        Dim qryCollection As Collection
        Dim frmCollection As Collection
        Dim rptCollection As Collection
        Dim macCollection As Collection
        Dim modCollection As Collection
        Dim itemVal As Variant
        Dim tName As String
        Dim catFilter As Long

        lstTables.Clear
        If Not StudioController.IsDatabaseOpen() Then Exit Sub

        catFilter = StudioController.GetNavCategoryFilter()

        Set tblCollection = StudioController.GetTableNames()
        If catFilter = 0 Or catFilter = 1 Then
            For Each itemVal In tblCollection
                tName = CStr(itemVal)
                lstTables.AddItem tName
            Next itemVal
        End If

        Set qryCollection = StudioController.GetQueryNames()
        If catFilter = 0 Or catFilter = 2 Then
            For Each itemVal In qryCollection
                tName = CStr(itemVal)
                lstTables.AddItem "[Query] " & tName
            Next itemVal
        End If

        Set frmCollection = StudioController.GetCustomObjectNames("FORM")
        If catFilter = 0 Or catFilter = 3 Then
            For Each itemVal In frmCollection
                tName = CStr(itemVal)
                lstTables.AddItem "[Form] " & tName
            Next itemVal
        End If

        Set rptCollection = StudioController.GetCustomObjectNames("REPORT")
        If catFilter = 0 Or catFilter = 4 Then
            For Each itemVal In rptCollection
                tName = CStr(itemVal)
                lstTables.AddItem "[Report] " & tName
            Next itemVal
        End If

        Set macCollection = StudioController.GetCustomObjectNames("MACRO")
        If catFilter = 0 Or catFilter = 5 Then
            For Each itemVal In macCollection
                tName = CStr(itemVal)
                lstTables.AddItem "[Macro] " & tName
            Next itemVal
        End If

        Set modCollection = StudioController.GetCustomObjectNames("MODULE")
        If catFilter = 0 Or catFilter = 6 Then
            For Each itemVal In modCollection
                tName = CStr(itemVal)
                lstTables.AddItem "[Module] " & tName
            Next itemVal
        End If

        If lstTables.ListCount > 0 Then
            lstTables.ListIndex = 0
            LoadSelectedTableOrQuery
            lblStatus.Caption = "Catalog: " & CStr(tblCollection.Count) & " table(s), " & CStr(qryCollection.Count) & " query(ies), " & CStr(frmCollection.Count + rptCollection.Count + macCollection.Count + modCollection.Count) & " custom object(s)."
        Else
            lstRecords.Clear
            m_dsQueryName = ""
            m_activeQueryName = ""
            Set m_dsColRs = Nothing
            m_dsColCount = 0
            m_dsAllowNew = False
            lblTableTitle.Caption = "Datasheet View: (No Tables)"
            txtSql.Text = ""
            picDatasheet.Cls
            PaintQueryDatasheet
            If tblCollection.Count = 0 And qryCollection.Count = 0 Then
                lstRecords.AddItem "[ Connected to: " & StudioController.GetDatabasePath() & " ]"
                lstRecords.AddItem "Notice: This database is empty and contains no tables yet."
                lblStatus.Caption = "Database opened successfully (0 tables)."
                MsgBox "The database was opened successfully, but it currently contains no tables." & vbCrLf & "You can create a new table from the 'Create' tab, Table Design View, or by running a CREATE TABLE SQL statement.", vbInformation, "Empty Database - OpenAccess Studio"
            Else
                lstRecords.AddItem "[ Connected to: " & StudioController.GetDatabasePath() & " ]"
                lstRecords.AddItem "Notice: No objects found in category [" & StudioController.GetNavCategoryName(catFilter) & "]."
                lblStatus.Caption = "Connected. No matching objects in active filter."
            End If
        End If
    End Sub

