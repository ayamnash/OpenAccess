    Private Sub fcChk01_Click()
        If m_relDialogActive Then
            If m_relDialogUpdatingChecks Then Exit Sub
            If m_relDialogIsQbeJoin Then
                m_relDialogUpdatingChecks = True
                fcChk01.Value = 1
                fcChk02.Value = 0
                fcChk03.Value = 0
                m_relDialogUpdatingChecks = False
                PaintVisualRelationshipDialog
                Exit Sub
            End If
            fcChk02.Enabled = (fcChk01.Value = 1)
            fcChk03.Enabled = (fcChk01.Value = 1)
            If fcChk01.Value = 0 Then fcChk02.Value = 0: fcChk03.Value = 0
            Exit Sub
        End If
        OnPoolCheckClick 1
    End Sub

    Private Sub fcChk02_Click()
        If m_relDialogActive Then
            If m_relDialogUpdatingChecks Then Exit Sub
            If m_relDialogIsQbeJoin Then
                m_relDialogUpdatingChecks = True
                fcChk01.Value = 0
                fcChk02.Value = 1
                fcChk03.Value = 0
                m_relDialogUpdatingChecks = False
                PaintVisualRelationshipDialog
                Exit Sub
            End If
            Exit Sub
        End If
        OnPoolCheckClick 2
    End Sub

    Private Sub fcChk03_Click()
        If m_relDialogActive Then
            If m_relDialogUpdatingChecks Then Exit Sub
            If m_relDialogIsQbeJoin Then
                m_relDialogUpdatingChecks = True
                fcChk01.Value = 0
                fcChk02.Value = 0
                fcChk03.Value = 1
                m_relDialogUpdatingChecks = False
                PaintVisualRelationshipDialog
                Exit Sub
            End If
            Exit Sub
        End If
        OnPoolCheckClick 3
    End Sub

    Private Sub fcChk04_Click()
        OnPoolCheckClick 4
    End Sub

    Private Sub fcChk05_Click()
        OnPoolCheckClick 5
    End Sub

    Private Sub fcChk06_Click()
        OnPoolCheckClick 6
    End Sub

    Private Sub fcChk07_Click()
        OnPoolCheckClick 7
    End Sub

    Private Sub fcChk08_Click()
        OnPoolCheckClick 8
    End Sub

    ' Paints the Native Form View for m_formLayout and binds the control pool.
    '   Bands: FormHeader (section 1) at the top, Detail (section 0) below it, FormFooter
    '   (section 2) docked at the canvas bottom (or right after Detail when it does not fit).
    '   Control rect = (selectorPx + TwipsToPx(Left), bandTop + TwipsToPx(Top), TwipsToPx(Width), TwipsToPx(Height)).
    '   Labels are painted; TextBox/ComboBox/CommandButton/CheckBox take the next free pool
    '   slot of their type; overflow and other types are painted read-only.
    '   DefaultView 0 (Single) and 5 (Split) render one record.
    '   DefaultView 1 (Continuous Forms): FormHeader with its column header labels, then
    '   visibleRows = (canvasHeight - headerPx - footerPx) \ detailPx Detail rows from m_formTopRow
    '   (row window: ComputeFormRowWindow). The current record's row gets the pooled controls,
    '   the other rows are painted read-only, and a (New) row with * follows the last record
    '   when AllowAdditions is True. See PaintContinuousForm.
    '   DefaultView 2 (Datasheet): painted grid with the form's bound controls as columns
    '   (PaintFormDatasheetView).
    ' Mirrored by compute_form_canvas in tools/studio_render_model.py.
    Private Sub PaintFormCanvas()
        Dim cw As Long
        Dim ch As Long
        Dim originX As Long
        Dim originY As Long
        Dim headerPx As Long
        Dim detailPx As Long
        Dim footerPx As Long
        Dim detailTop As Long
        Dim footerTop As Long
        Dim selPx As Long
        Dim i As Long
        Dim slot As Long
        Dim detailBack As Long
        Dim maxBottom As Long
        Dim atNew As Boolean
        Dim rs As Object
        Dim ctlObj As Object
        Dim s As Long

        Set m_fcPic = picFormCanvas
        m_lkKeyPrefix = vbNullString
        m_formOverflowCount = 0
        m_formCanvasNote = vbNullString
        m_fcRowHitEnabled = False
        For slot = 1 To FC_SLOT_TOTAL
            m_poolCtlIndex(slot) = -1
            m_poolDirty(slot) = False
        Next slot
        m_subCount = 0
        For s = 1 To FC_POOL_SUB
            m_subUsed(s) = False
            m_subCtlIdx(s) = -1
        Next s

        On Error Resume Next
        cw = picFormCanvas.ScaleWidth
        ch = picFormCanvas.ScaleHeight
        originX = picFormCanvas.Left + (picFormCanvas.Width - cw) \ 2
        originY = picFormCanvas.Top + (picFormCanvas.Height - ch) \ 2
        On Error GoTo 0
        If cw <= 0 Then cw = 952
        If ch <= 0 Then ch = 520

        ' Band geometry
        headerPx = 0
        footerPx = 0
        If m_formLayout.SectionPresent(1) Then headerPx = TwipsToPxY(m_formLayout.SectionHeightTw(1))
        If m_formLayout.SectionPresent(2) Then footerPx = TwipsToPxY(m_formLayout.SectionHeightTw(2))
        detailPx = TwipsToPxY(m_formLayout.SectionHeightTw(0))
        If detailPx <= 0 Then
            maxBottom = 0
            For i = 0 To m_formLayout.CtlCount - 1
                If m_formLayout.Ctls(i).Section = 0 Then
                    If m_formLayout.Ctls(i).TopTw + m_formLayout.Ctls(i).HeightTw > maxBottom Then
                        maxBottom = m_formLayout.Ctls(i).TopTw + m_formLayout.Ctls(i).HeightTw
                    End If
                End If
            Next i
            detailPx = TwipsToPxY(maxBottom + 240)
        End If
        detailTop = headerPx
        footerTop = ch - footerPx
        If footerTop < detailTop + detailPx Then footerTop = detailTop + detailPx
        If m_formLayout.RecordSelectors Then selPx = FC_SELECTOR_PX Else selPx = 0

        If m_formLayout.DefaultView = 2 Then
            ' Datasheet default view: grid only (no bands, no pooled controls)
            PaintFormDatasheetView cw, ch
        Else
            detailBack = FormSafeColor(m_formLayout.SectionBackColor(0), &HFFFFFF&)

            On Error Resume Next
            picFormCanvas.AutoRedraw = True
            picFormCanvas.BackColor = detailBack
            picFormCanvas.Cls
            picFormCanvas.FontTransparent = True

            ' FormHeader / FormFooter bands (Detail is the canvas background)
            If headerPx > 0 Then
                picFormCanvas.Line (0, 0)-(cw - 1, headerPx - 1), FormSafeColor(m_formLayout.SectionBackColor(1), &HFFFFFF&), BF
            End If
            If footerPx > 0 Then
                picFormCanvas.Line (0, footerTop)-(cw - 1, footerTop + footerPx - 1), FormSafeColor(m_formLayout.SectionBackColor(2), &HFFFFFF&), BF
            End If
            On Error GoTo 0

            If m_formLayout.DefaultView = 1 Then
                PaintContinuousForm cw, ch, originX, originY, headerPx, detailPx, footerPx, footerTop, selPx
            Else
                SyncFormScrollBar 0, 1

                ' Record selector strip over the Detail band (current record glyph, or * at (New))
                On Error Resume Next
                If selPx > 0 Then
                    atNew = False
                    Set rs = StudioController.GetCurrentRecordset()
                    If Not rs Is Nothing Then
                        atNew = (rs.EOF Or rs.BOF)
                    End If
                    picFormCanvas.Line (0, detailTop)-(selPx - 1, detailTop + detailPx - 1), &HE6E6E6&, BF
                    picFormCanvas.Line (selPx - 1, detailTop)-(selPx - 1, detailTop + detailPx - 1), &HA0A0A0&
                    picFormCanvas.FontName = "Segoe UI Symbol"
                    picFormCanvas.FontSize = 7
                    picFormCanvas.FontBold = False
                    picFormCanvas.ForeColor = &H404040&
                    picFormCanvas.CurrentX = 3
                    picFormCanvas.CurrentY = detailTop + 2
                    If atNew Then picFormCanvas.Print "*" Else picFormCanvas.Print ChrW(&H25B6&)
                End If
                On Error GoTo 0

                ' Controls (one record)
                PaintFormControlsPass detailTop, 0, footerTop, selPx, cw, ch, originX, originY, FC_ROW_LIVE, Nothing
            End If
        End If

        ' Hide pool controls that were not assigned in this pass
        For slot = 1 To FC_SLOT_TOTAL
            If m_poolCtlIndex(slot) < 0 Then
                Set ctlObj = PoolControlBySlot(slot)
                If Not ctlObj Is Nothing Then
                    On Error Resume Next
                    ctlObj.Visible = False
                    On Error GoTo 0
                End If
            End If
        Next slot

        ' Subform surfaces: hide free slots; fill slots whose child content is not painted yet
        ' (moves refresh every slot through RefreshSubforms)
        For s = 1 To FC_POOL_SUB
            If Not m_subUsed(s) Then
                On Error Resume Next
                SubformPic(s).Visible = False
                SubformScrollBar(s).Visible = False
                On Error GoTo 0
                CloseSubformRecordset s
                m_subPaintedKey(s) = vbNullString
            ElseIf m_subPaintedKey(s) <> m_formLayoutKey & "|" & CStr(m_subCtlIdx(s)) Then
                RefreshSubformSlot s
            End If
        Next s

        If m_formOverflowCount > 0 Then
            m_formCanvasNote = CStr(m_formOverflowCount) & " controls shown read-only (pool limit)"
        End If

        On Error Resume Next
        picFormCanvas.Refresh
        On Error GoTo 0
    End Sub

    ' One pass over the layout controls in layout order (pool slots are assigned in this order).
    '   rowMode FC_ROW_LIVE: every section whose band top is >= 0; windowed controls take the
    '   next free pool slot and are bound to the current record (overflow painted read-only).
    '   FC_ROW_PAINTED / FC_ROW_NEW: Detail controls only, painted read-only from rowRs
    '   (FC_ROW_NEW: empty values). A band top < 0 skips that section.
    '   FC_ROW_BANDS (subforms): every section with a band top >= 0 painted read-only from
    '   rowRs (callers pass detailTop = -1 to paint only FormHeader/FormFooter controls).
    Private Sub PaintFormControlsPass(ByVal detailTop As Long, ByVal headerTop As Long, ByVal footerTop As Long, ByVal selPx As Long, ByVal cw As Long, ByVal ch As Long, ByVal originX As Long, ByVal originY As Long, ByVal rowMode As Long, ByVal rowRs As Object)
        Dim i As Long
        Dim slot As Long
        Dim x As Long
        Dim y As Long
        Dim w As Long
        Dim h As Long
        Dim bandTop As Long
        Dim ctlType As String
        Dim ctlObj As Object

        For i = 0 To m_formLayout.CtlCount - 1
            If m_formLayout.Ctls(i).Visible Then
                Select Case m_formLayout.Ctls(i).Section
                    Case 0: bandTop = detailTop
                    Case 1: bandTop = headerTop
                    Case 2: bandTop = footerTop
                    Case Else: bandTop = -1       ' page header/footer: not shown in Form View
                End Select
                If (rowMode = FC_ROW_PAINTED Or rowMode = FC_ROW_NEW) And m_formLayout.Ctls(i).Section <> 0 Then bandTop = -1

                If bandTop >= 0 Then
                    x = selPx + TwipsToPxX(m_formLayout.Ctls(i).LeftTw)
                    y = bandTop + TwipsToPxY(m_formLayout.Ctls(i).TopTw)
                    w = TwipsToPxX(m_formLayout.Ctls(i).WidthTw)
                    h = TwipsToPxY(m_formLayout.Ctls(i).HeightTw)
                    If m_formLayout.RightToLeft Then
                        Dim formWpx As Long
                        formWpx = TwipsToPxX(m_formLayout.FormWidthTw)
                        If formWpx <= 0 Or formWpx < cw Then formWpx = cw
                        x = formWpx - x - w
                    End If
                    ctlType = m_formLayout.Ctls(i).CtlType

                    If rowMode <> FC_ROW_LIVE Then
                        PaintFormRowControl i, x, y, w, h, rowMode, rowRs
                    Else
                        Select Case ctlType
                            Case "Label"
                                PaintFormLabel i, x, y

                            Case "TextBox", "ComboBox", "CommandButton", "CheckBox", "ListBox"
                                slot = NextFreePoolSlot(ctlType)
                                If slot > 0 Then
                                    m_poolCtlIndex(slot) = i
                                    Set ctlObj = PoolControlBySlot(slot)
                                    BindPoolControl slot
                                    PlacePoolControl ctlObj, (ctlType = "ComboBox"), x, y, w, h, cw, ch, originX, originY
                                    On Error Resume Next
                                    ctlObj.RightToLeft = m_formLayout.RightToLeft
                                    On Error GoTo 0
                                Else
                                    m_formOverflowCount = m_formOverflowCount + 1
                                    If ctlType = "CommandButton" Or ctlType = "CheckBox" Then
                                        PaintReadOnlyControl i, x, y, w, h, IIf(Len(m_formLayout.Ctls(i).Caption) > 0, m_formLayout.Ctls(i).Caption, m_formLayout.Ctls(i).CtlName)
                                    Else
                                        PaintReadOnlyControl i, x, y, w, h, GetFormControlValueText(i)
                                    End If
                                End If

                            Case "Line"
                                On Error Resume Next
                                m_fcPic.Line (x, y)-(x + w, y + h), FormSafeColor(m_formLayout.Ctls(i).ForeColor, 0)
                                On Error GoTo 0

                            Case "Rectangle"
                                On Error Resume Next
                                m_fcPic.Line (x, y)-(x + w - 1, y + h - 1), FormSafeColor(m_formLayout.Ctls(i).ForeColor, 0), B
                                On Error GoTo 0

                            Case "Subform"
                                ' Embedded subform: next picSubNN at the control's rectangle
                                ' (overflow: labeled empty rectangle)
                                PlaceSubformSurface i, x, y, w, h, cw, ch, originX, originY

                            Case "OptionButton"
                                Dim isOptChecked As Boolean
                                Dim optCap As String
                                isOptChecked = False
                                optCap = m_formLayout.Ctls(i).Caption
                                If Len(optCap) = 0 Then optCap = m_formLayout.Ctls(i).CtlName
                                If InStr(1, m_formLayout.Ctls(i).CtlName, "Option16", vbTextCompare) > 0 Or InStr(1, optCap, "Start", vbTextCompare) > 0 Then
                                    isOptChecked = (m_faytFilterType = 1)
                                ElseIf InStr(1, m_formLayout.Ctls(i).CtlName, "Option18", vbTextCompare) > 0 Or InStr(1, optCap, "Any", vbTextCompare) > 0 Then
                                    isOptChecked = (m_faytFilterType = 0)
                                End If
                                PaintCanvasOptionButton x, y, w, h, isOptChecked, optCap

                            Case "OptionGroup"
                                PaintCanvasOptionGroup x, y, w, h, m_formLayout.Ctls(i).Caption

                            Case "Image"
                                PaintReadOnlyControl i, x, y, w, h, GetFormControlValueText(i)
                        End Select
                    End If
                End If
            End If
        Next i
    End Sub

    ' Paints one Detail control of a non-current Continuous Forms row (FC_ROW_PAINTED, values
    ' from rowRs) or of the (New) row (FC_ROW_NEW, empty values): a bordered rectangle with the
    ' formatted, lookup-resolved value, so the control pool does not grow with the row count.
    Private Sub PaintFormRowControl(ByVal ctlIdx As Long, ByVal x As Long, ByVal y As Long, ByVal w As Long, ByVal h As Long, ByVal rowMode As Long, ByVal rowRs As Object)
        Dim txt As String
        Dim v As Variant

        Select Case m_formLayout.Ctls(ctlIdx).CtlType
            Case "Label"
                PaintFormLabel ctlIdx, x, y

            Case "TextBox", "ComboBox", "ListBox", "Image"
                txt = vbNullString
                If rowMode = FC_ROW_PAINTED Or rowMode = FC_ROW_BANDS Then txt = GetRowControlText(rowRs, ctlIdx)
                PaintReadOnlyControl ctlIdx, x, y, w, h, txt

            Case "OptionButton"
                PaintCanvasOptionButton x, y, w, h, False, m_formLayout.Ctls(ctlIdx).Caption

            Case "OptionGroup"
                PaintCanvasOptionGroup x, y, w, h, m_formLayout.Ctls(ctlIdx).Caption

            Case "CheckBox"
                v = Null
                If rowMode = FC_ROW_PAINTED Or rowMode = FC_ROW_BANDS Then v = GetRowControlRawValue(rowRs, ctlIdx)
                PaintCanvasCheckBox x, y, w, h, v

            Case "CommandButton"
                txt = m_formLayout.Ctls(ctlIdx).Caption
                If Len(txt) = 0 Then txt = m_formLayout.Ctls(ctlIdx).CtlName
                PaintReadOnlyControl ctlIdx, x, y, w, h, txt

            Case "Line"
                On Error Resume Next
                m_fcPic.Line (x, y)-(x + w, y + h), FormSafeColor(m_formLayout.Ctls(ctlIdx).ForeColor, 0)
                On Error GoTo 0

            Case "Rectangle"
                On Error Resume Next
                m_fcPic.Line (x, y)-(x + w - 1, y + h - 1), FormSafeColor(m_formLayout.Ctls(ctlIdx).ForeColor, 0), B
                On Error GoTo 0

            Case "Subform"
                PaintReadOnlyControl ctlIdx, x, y, w, h, m_formLayout.Ctls(ctlIdx).SourceObject
        End Select
    End Sub

    ' Painted check box (13 px square, check mark when the value is True).
    Private Sub PaintCanvasCheckBox(ByVal x As Long, ByVal y As Long, ByVal w As Long, ByVal h As Long, ByVal v As Variant)
        Dim bx As Long
        Dim by As Long
        Dim isOn As Boolean

        isOn = False
        On Error Resume Next
        If Not (IsNull(v) Or IsEmpty(v)) Then isOn = CBool(v)
        Err.Clear
        bx = x
        by = y
        If h > 13 Then by = y + (h - 13) \ 2
        m_fcPic.Line (bx, by)-(bx + 12, by + 12), &HFFFFFF&, BF
        m_fcPic.Line (bx, by)-(bx + 12, by + 12), &H808080&, B
        If isOn Then
            m_fcPic.Line (bx + 3, by + 6)-(bx + 5, by + 9), &H202020&
            m_fcPic.Line (bx + 5, by + 9)-(bx + 10, by + 3), &H202020&
        End If
        On Error GoTo 0
    End Sub

    ' Record selector cell of one painted row: gray box, optional glyph (current record or *).
    Private Sub PaintFormSelectorCell(ByVal y As Long, ByVal h As Long, ByVal selPx As Long, ByVal glyph As String)
        If selPx <= 0 Or h <= 0 Then Exit Sub
        On Error Resume Next
        m_fcPic.Line (0, y)-(selPx - 1, y + h - 1), &HE6E6E6&, BF
        m_fcPic.Line (0, y)-(selPx - 1, y + h - 1), &HA0A0A0&, B
        If Len(glyph) > 0 Then
            m_fcPic.FontName = "Segoe UI Symbol"
            m_fcPic.FontSize = 7
            m_fcPic.FontBold = False
            m_fcPic.ForeColor = &H404040&
            m_fcPic.CurrentX = 3
            m_fcPic.CurrentY = y + 2
            m_fcPic.Print glyph
        End If
        On Error GoTo 0
    End Sub

    ' Continuous Forms / form Datasheet row window (mirror for tools/studio_render_model.py, task 7.5):
    '   visibleRows < 1 -> 1; totalRows = records + (1 when allowAdd: the (New) row)
    '   maxTop = max(0, totalRows - visibleRows); topRow clamped to [0, maxTop]
    '   painted = max(0, min(records - topRow, visibleRows))   (record rows in the viewport)
    '   newShown = allowAdd And topRow <= records And (records - topRow) < visibleRows
    Private Sub ComputeFormRowWindow(ByVal records As Long, ByVal visibleRows As Long, ByVal allowAdd As Boolean, ByRef ioTopRow As Long, ByRef outPainted As Long, ByRef outNewShown As Boolean, ByRef outMaxTop As Long)
        Dim totalRows As Long

        If records < 0 Then records = 0
        If visibleRows < 1 Then visibleRows = 1
        totalRows = records
        If allowAdd Then totalRows = totalRows + 1
        outMaxTop = totalRows - visibleRows
        If outMaxTop < 0 Then outMaxTop = 0
        If ioTopRow > outMaxTop Then ioTopRow = outMaxTop
        If ioTopRow < 0 Then ioTopRow = 0
        outPainted = records - ioTopRow
        If outPainted > visibleRows Then outPainted = visibleRows
        If outPainted < 0 Then outPainted = 0
        outNewShown = False
        If allowAdd Then
            If ioTopRow <= records And (records - ioTopRow) < visibleRows Then outNewShown = True
        End If
    End Sub

    ' 0-based row of the current record; = records when the recordset is at the (New) position
    ' (no recordset, empty, EOF/BOF).
    Private Function GetFormCurrentRow(ByVal records As Long) As Long
        Dim rs As Object
        Dim atNew As Boolean
        Dim idx As Long

        atNew = True
        Set rs = StudioController.GetCurrentRecordset()
        If Not rs Is Nothing And records > 0 Then
            On Error Resume Next
            atNew = (rs.EOF Or rs.BOF)
            If Err.Number <> 0 Then atNew = True
            Err.Clear
            On Error GoTo 0
        End If
        idx = StudioController.GetCurrentRecordIndex()
        If atNew Or idx < 1 Or idx > records Then
            GetFormCurrentRow = records
        Else
            GetFormCurrentRow = idx - 1
        End If
    End Function

    ' vsbFormCanvas range for the row window (disabled when everything fits or in Single Form).
    Private Sub SyncFormScrollBar(ByVal maxTop As Long, ByVal pageRows As Long)
        If maxTop > 32767 Then maxTop = 32767
        If pageRows < 1 Then pageRows = 1
        m_formScrollSync = True
        On Error Resume Next
        vsbFormCanvas.Min = 0
        vsbFormCanvas.Max = maxTop
        vsbFormCanvas.SmallChange = 1
        vsbFormCanvas.LargeChange = pageRows
        If m_formTopRow <= maxTop Then vsbFormCanvas.Value = m_formTopRow Else vsbFormCanvas.Value = maxTop
        vsbFormCanvas.Enabled = (maxTop > 0)
        On Error GoTo 0
        m_formScrollSync = False
    End Sub

    ' Read-only row cursor for painted rows, positioned on record topRow (0-based): a Clone of
    ' the active recordset when the engine supports it, else the active recordset itself
    ' (outIsClone = False: the caller restores its position with RestoreFormActivePosition).
    Private Function OpenFormRowCursor(ByVal topRow As Long, ByRef outIsClone As Boolean) As Object
        Dim rs As Object
        Dim c As Object
        Dim k As Long

        outIsClone = False
        Set rs = StudioController.GetCurrentRecordset()
        If rs Is Nothing Then Exit Function
        On Error Resume Next
        Set c = rs.Clone
        If Err.Number <> 0 Or c Is Nothing Then
            Err.Clear
            Set c = rs
        Else
            outIsClone = True
        End If
        c.MoveFirst
        For k = 1 To topRow
            If c.EOF Then Exit For
            c.MoveNext
        Next k
        Err.Clear
        On Error GoTo 0
        Set OpenFormRowCursor = c
    End Function

    ' Closes a cloned row cursor, or puts the active recordset back on the controller's
    ' current record when the active recordset itself was walked.
    Private Sub CloseFormRowCursor(ByVal cursor As Object, ByVal isClone As Boolean, ByVal records As Long)
        Dim rs As Object
        Dim idx As Long
        Dim k As Long

        If cursor Is Nothing Then Exit Sub
        On Error Resume Next
        If isClone Then
            cursor.Close
        Else
            Set rs = StudioController.GetCurrentRecordset()
            idx = StudioController.GetCurrentRecordIndex()
            If Not rs Is Nothing And records > 0 Then
                rs.MoveFirst
                If m_formAtNew Or idx < 1 Or idx > records Then
                    rs.MoveLast
                    rs.MoveNext
                Else
                    For k = 2 To idx
                        rs.MoveNext
                    Next k
                End If
            End If
        End If
        Err.Clear
        On Error GoTo 0
    End Sub

    ' Advances a row cursor by one record (no-op at EOF).
    Private Sub AdvanceFormRowCursor(ByVal cursor As Object)
        If cursor Is Nothing Then Exit Sub
        On Error Resume Next
        If Not cursor.EOF Then cursor.MoveNext
        Err.Clear
        On Error GoTo 0
    End Sub

    ' Field name of a bound control ("" for unbound and "=expr" controls).
    Private Function FormControlFieldName(ByVal ctlIdx As Long) As String
        Dim cs As String

        If Not m_formLayoutValid Then Exit Function
        If ctlIdx < 0 Or ctlIdx >= m_formLayout.CtlCount Then Exit Function
        cs = Trim$(m_formLayout.Ctls(ctlIdx).ControlSource)
        If Left$(cs, 1) = "=" Then cs = vbNullString
        If Len(cs) > 1 And Left$(cs, 1) = "[" And Right$(cs, 1) = "]" Then cs = Mid$(cs, 2, Len(cs) - 2)
        FormControlFieldName = cs
    End Function

    ' Display text of a bound control for the record under rowRs (painted rows):
    '   unbound -> ""; "=expr" -> GetFormControlValueText; missing field -> "#Name?"; Null -> "";
    '   ComboBox/ListBox values are lookup-resolved (ResolveFormLookupText).
    Private Function GetRowControlText(ByVal rowRs As Object, ByVal ctlIdx As Long) As String
        Dim cs As String
        Dim fName As String
        Dim v As Variant
        Dim ctlType As String
        Dim failed As Boolean

        GetRowControlText = vbNullString
        cs = Trim$(m_formLayout.Ctls(ctlIdx).ControlSource)
        If Len(cs) = 0 Then Exit Function
        If Left$(cs, 1) = "=" Then
            GetRowControlText = GetFormControlValueText(ctlIdx)
            Exit Function
        End If
        If rowRs Is Nothing Then Exit Function
        fName = FormControlFieldName(ctlIdx)

        failed = False
        On Error Resume Next
        If rowRs.EOF Or rowRs.BOF Then
            If Err.Number = 0 Then
                On Error GoTo 0
                Exit Function
            End If
            Err.Clear
        End If
        v = rowRs.Fields(fName).Value
        If Err.Number <> 0 Then failed = True
        Err.Clear
        On Error GoTo 0
        If failed Then
            GetRowControlText = "#Name?"
            Exit Function
        End If
        If IsNull(v) Or IsEmpty(v) Then Exit Function

        ctlType = m_formLayout.Ctls(ctlIdx).CtlType
        If ctlType = "ComboBox" Or ctlType = "ListBox" Then
            GetRowControlText = ResolveFormLookupText(ctlIdx, v)
        Else
            On Error Resume Next
            GetRowControlText = CStr(v)
            If Err.Number <> 0 Then GetRowControlText = "#Name?"
            Err.Clear
            On Error GoTo 0
        End If
    End Function

    ' Raw bound value for the record under rowRs (Null when unbound, missing or at EOF/BOF).
    Private Function GetRowControlRawValue(ByVal rowRs As Object, ByVal ctlIdx As Long) As Variant
        Dim fName As String

        GetRowControlRawValue = Null
        fName = FormControlFieldName(ctlIdx)
        If Len(fName) = 0 Or rowRs Is Nothing Then Exit Function
        On Error Resume Next
        If rowRs.EOF Or rowRs.BOF Then Exit Function
        GetRowControlRawValue = rowRs.Fields(fName).Value
        If Err.Number <> 0 Then GetRowControlRawValue = Null
        Err.Clear
        On Error GoTo 0
    End Function

    ' Lookup display text of a combo/list value through the existing
    ' StudioController.ResolveFieldLookupValue (same resolution as the table datasheet),
    ' cached per control and raw value until the next RenderNativeForm.
    Private Function ResolveFormLookupText(ByVal ctlIdx As Long, ByVal rawVal As Variant) As String
        Dim key As String
        Dim rawText As String
        Dim res As String
        Dim k As Long

        rawText = vbNullString
        On Error Resume Next
        rawText = CStr(rawVal)
        Err.Clear
        On Error GoTo 0
        key = m_lkKeyPrefix & CStr(ctlIdx) & "|" & rawText

        For k = 0 To m_lkCacheCount - 1
            If m_lkCacheKey(k) = key Then
                ResolveFormLookupText = m_lkCacheVal(k)
                Exit Function
            End If
        Next k

        res = StudioController.ResolveFieldLookupValue(m_formLayout.RecordSource, FormControlFieldName(ctlIdx), rawVal)
        If Len(res) = 0 Then res = rawText
        ResolveFormLookupText = res

        If m_lkCacheCount >= 4096 Then Exit Function
        If m_lkCacheCount = 0 Then
            ReDim m_lkCacheKey(0 To 31)
            ReDim m_lkCacheVal(0 To 31)
        ElseIf m_lkCacheCount > UBound(m_lkCacheKey) Then
            ReDim Preserve m_lkCacheKey(0 To m_lkCacheCount * 2 - 1)
            ReDim Preserve m_lkCacheVal(0 To m_lkCacheCount * 2 - 1)
        End If
        m_lkCacheKey(m_lkCacheCount) = key
        m_lkCacheVal(m_lkCacheCount) = res
        m_lkCacheCount = m_lkCacheCount + 1
    End Function

    ' Continuous Forms (DefaultView 1) body, painted after the FormHeader/FormFooter bands:
    '   visibleRows = (ch - headerPx - footerPx) \ detailPx rows of detailPx starting at m_formTopRow,
    '   row r (0-based record index) at y = headerPx + (r - m_formTopRow) * detailPx;
    '   non-current rows painted from a row cursor, the (New) row (index = records, selector *)
    '   painted empty, then one live pass that puts the pooled controls on the current row
    '   (hidden when the current row is scrolled out of view) plus header/footer controls.
    '   Unless the repaint comes from the scroll bar, m_formTopRow first snaps so that the
    '   current row is visible.
    Private Sub PaintContinuousForm(ByVal cw As Long, ByVal ch As Long, ByVal originX As Long, ByVal originY As Long, ByVal headerPx As Long, ByVal detailPx As Long, ByVal footerPx As Long, ByVal footerTop As Long, ByVal selPx As Long)
        Dim records As Long
        Dim visibleRows As Long
        Dim painted As Long
        Dim newShown As Boolean
        Dim maxTop As Long
        Dim curRow As Long
        Dim r As Long
        Dim rowY As Long
        Dim curY As Long
        Dim cursor As Object
        Dim isClone As Boolean
        Dim needCursor As Boolean

        records = StudioController.GetTotalRecords()
        If StudioController.GetCurrentRecordset() Is Nothing Then records = 0
        If records < 0 Then records = 0
        If detailPx < 1 Then detailPx = 1
        visibleRows = (ch - headerPx - footerPx) \ detailPx
        If visibleRows < 1 Then visibleRows = 1
        curRow = GetFormCurrentRow(records)

        If Not m_formScrollPaint Then
            If curRow < m_formTopRow Then m_formTopRow = curRow
            If curRow >= m_formTopRow + visibleRows Then m_formTopRow = curRow - visibleRows + 1
        End If
        ComputeFormRowWindow records, visibleRows, m_formLayout.AllowAdditions, m_formTopRow, painted, newShown, maxTop
        SyncFormScrollBar maxTop, visibleRows

        ' Non-current record rows
        needCursor = False
        For r = m_formTopRow To m_formTopRow + painted - 1
            If r <> curRow Then needCursor = True
        Next r
        If needCursor Then
            Set cursor = OpenFormRowCursor(m_formTopRow, isClone)
            For r = m_formTopRow To m_formTopRow + painted - 1
                If r <> curRow Then
                    rowY = headerPx + (r - m_formTopRow) * detailPx
                    PaintFormSelectorCell rowY, detailPx, selPx, vbNullString
                    PaintFormControlsPass rowY, -1, -1, selPx, cw, ch, originX, originY, FC_ROW_PAINTED, cursor
                End If
                AdvanceFormRowCursor cursor
            Next r
            CloseFormRowCursor cursor, isClone, records
        End If

        ' (New) row when it is not the current row
        If newShown And curRow <> records Then
            rowY = headerPx + (records - m_formTopRow) * detailPx
            PaintFormSelectorCell rowY, detailPx, selPx, "*"
            PaintFormControlsPass rowY, -1, -1, selPx, cw, ch, originX, originY, FC_ROW_NEW, Nothing
        End If

        ' Current row: real pooled controls (exactly one row), plus header/footer controls
        curY = -1
        If curRow >= m_formTopRow And curRow < m_formTopRow + visibleRows Then
            If curRow < records Or newShown Then curY = headerPx + (curRow - m_formTopRow) * detailPx
        End If
        If curY >= 0 Then
            If curRow = records Then
                PaintFormSelectorCell curY, detailPx, selPx, "*"
            Else
                PaintFormSelectorCell curY, detailPx, selPx, ChrW(&H25B6&)
            End If
        End If
        PaintFormControlsPass curY, 0, footerTop, selPx, cw, ch, originX, originY, FC_ROW_LIVE, Nothing

        m_fcRowsTop = headerPx
        m_fcRowPx = detailPx
        m_fcRecords = records
        m_fcPaintedRows = painted
        m_fcNewShown = newShown
        m_fcRowHitEnabled = True
    End Sub

    ' Column header text for a form Datasheet column: the attached label's caption, else the
    ' caption of "<name>_Label", else the control name.
    Private Function FormColumnCaption(ByVal ctlIdx As Long) As String
        Dim k As Long
        Dim nm As String

        nm = m_formLayout.Ctls(ctlIdx).CtlName
        FormColumnCaption = nm
        For k = 0 To m_formLayout.CtlCount - 1
            If m_formLayout.Ctls(k).CtlType = "Label" Then
                If Len(m_formLayout.Ctls(k).ParentLabelOf) > 0 And StrComp(m_formLayout.Ctls(k).ParentLabelOf, nm, vbTextCompare) = 0 Then
                    If Len(m_formLayout.Ctls(k).Caption) > 0 Then FormColumnCaption = m_formLayout.Ctls(k).Caption
                    Exit Function
                End If
            End If
        Next k
        For k = 0 To m_formLayout.CtlCount - 1
            If m_formLayout.Ctls(k).CtlType = "Label" Then
                If StrComp(m_formLayout.Ctls(k).CtlName, nm & "_Label", vbTextCompare) = 0 Then
                    If Len(m_formLayout.Ctls(k).Caption) > 0 Then FormColumnCaption = m_formLayout.Ctls(k).Caption
                    Exit Function
                End If
            End If
        Next k
    End Function

    ' Text cut to fit a cell width on picFormCanvas (current font).
    Private Function FitCanvasText(ByVal txt As String, ByVal maxW As Long) As String
        Dim t As String

        t = txt
        On Error Resume Next
        Do While Len(t) > 0 And m_fcPic.TextWidth(t) > maxW
            t = Left$(t, Len(t) - 1)
        Loop
        On Error GoTo 0
        FitCanvasText = t
    End Function

    ' One datasheet cell: grid border and left-aligned text.
    Private Sub PaintFormDatasheetCell(ByVal x As Long, ByVal y As Long, ByVal w As Long, ByVal h As Long, ByVal txt As String, ByVal backC As Long, Optional ByVal isRtl As Boolean = False)
        On Error Resume Next
        m_fcPic.Line (x, y)-(x + w - 1, y + h - 1), backC, BF
        m_fcPic.Line (x, y)-(x + w - 1, y + h - 1), &HD0D0D0&, B
        m_fcPic.ForeColor = &H202020&
        Dim txtFit As String
        txtFit = FitCanvasText(txt, w - 6)
        If (isRtl Or ArabicCollationHelper.HasArabicUnicode(txtFit)) And w > 0 Then
            m_fcPic.CurrentX = x + w - m_fcPic.TextWidth(txtFit) - 4
            If m_fcPic.CurrentX < x + 4 Then m_fcPic.CurrentX = x + 4
        Else
            m_fcPic.CurrentX = x + 4
        End If
        m_fcPic.CurrentY = y + 2
        m_fcPic.Print txtFit
        On Error GoTo 0
    End Sub

    ' Datasheet default view (DefaultView 2) of a form: a painted grid whose columns are the
    ' form's bound Detail controls (TextBox, ComboBox, CheckBox, ListBox, OptionButton) in layout
    ' order, header = FormColumnCaption, width = max(control width, header) capped at 240 px.
    ' Gray header row (FC_DS_HEADER_PX), 16 px record selector column, FC_DS_ROW_PX rows from
    ' m_formTopRow with the same row window as Continuous Forms, (New) row with * when
    ' AllowAdditions. Minimal stand-in for the query datasheet painter (task 10.2 PaintDatasheet):
    ' its inputs are the column list, the row cursor, m_formTopRow and the current row, so
    ' PaintDatasheet can replace the body once it exists.
    Private Sub PaintFormDatasheetView(ByVal cw As Long, ByVal ch As Long)
        Dim colIdx() As Long
        Dim colW() As Long
        Dim colCap() As String
        Dim nCols As Long
        Dim i As Long
        Dim c As Long
        Dim ctlType As String
        Dim records As Long
        Dim visibleRows As Long
        Dim painted As Long
        Dim newShown As Boolean
        Dim maxTop As Long
        Dim curRow As Long
        Dim r As Long
        Dim rowY As Long
        Dim x As Long
        Dim tw As Long
        Dim cursor As Object
        Dim isClone As Boolean
        Dim txt As String
        Dim v As Variant
        Dim selPx As Long
        Dim backC As Long

        selPx = FC_SELECTOR_PX
        nCols = 0
        ReDim colIdx(0 To 0)
        ReDim colW(0 To 0)
        ReDim colCap(0 To 0)
        For i = 0 To m_formLayout.CtlCount - 1
            If m_formLayout.Ctls(i).Visible And m_formLayout.Ctls(i).Section = 0 Then
                ctlType = m_formLayout.Ctls(i).CtlType
                If ctlType = "TextBox" Or ctlType = "ComboBox" Or ctlType = "CheckBox" Or ctlType = "ListBox" Or ctlType = "OptionButton" Then
                    ReDim Preserve colIdx(0 To nCols)
                    ReDim Preserve colW(0 To nCols)
                    ReDim Preserve colCap(0 To nCols)
                    colIdx(nCols) = i
                    colCap(nCols) = FormColumnCaption(i)
                    nCols = nCols + 1
                End If
            End If
        Next i

        On Error Resume Next
        picFormCanvas.AutoRedraw = True
        picFormCanvas.BackColor = &HFFFFFF&
        picFormCanvas.Cls
        picFormCanvas.FontTransparent = True
        picFormCanvas.FontName = "Calibri"
        picFormCanvas.FontSize = 11
        picFormCanvas.FontBold = False
        For c = 0 To nCols - 1
            colW(c) = TwipsToPxX(m_formLayout.Ctls(colIdx(c)).WidthTw)
            tw = CLng(picFormCanvas.TextWidth(colCap(c))) + 10
            If colW(c) < tw Then colW(c) = tw
            If colW(c) > FC_DS_MAX_COL_PX Then colW(c) = FC_DS_MAX_COL_PX
            If colW(c) < 24 Then colW(c) = 24
        Next c
        On Error GoTo 0

        records = StudioController.GetTotalRecords()
        If StudioController.GetCurrentRecordset() Is Nothing Then records = 0
        If records < 0 Then records = 0
        visibleRows = (ch - FC_DS_HEADER_PX) \ FC_DS_ROW_PX
        If visibleRows < 1 Then visibleRows = 1
        curRow = GetFormCurrentRow(records)
        If Not m_formScrollPaint Then
            If curRow < m_formTopRow Then m_formTopRow = curRow
            If curRow >= m_formTopRow + visibleRows Then m_formTopRow = curRow - visibleRows + 1
        End If
        ComputeFormRowWindow records, visibleRows, m_formLayout.AllowAdditions, m_formTopRow, painted, newShown, maxTop
        SyncFormScrollBar maxTop, visibleRows

        ' Header row
        PaintFormSelectorCell 0, FC_DS_HEADER_PX, selPx, vbNullString
        x = selPx
        For c = 0 To nCols - 1
            If x >= cw Then Exit For
            PaintFormDatasheetCell x, 0, colW(c), FC_DS_HEADER_PX, colCap(c), &HF0F0F0&
            x = x + colW(c)
        Next c

        ' Record rows
        If painted > 0 Then
            Set cursor = OpenFormRowCursor(m_formTopRow, isClone)
            For r = m_formTopRow To m_formTopRow + painted - 1
                rowY = FC_DS_HEADER_PX + (r - m_formTopRow) * FC_DS_ROW_PX
                If r = curRow Then
                    If m_dsRecordDirty Then
                        PaintFormSelectorCell rowY, FC_DS_ROW_PX, selPx, ChrW(&H270E&)
                    Else
                        PaintFormSelectorCell rowY, FC_DS_ROW_PX, selPx, ChrW(&H25B6&)
                    End If
                    backC = &HF7EBDD&
                Else
                    PaintFormSelectorCell rowY, FC_DS_ROW_PX, selPx, vbNullString
                    backC = &HFFFFFF&
                End If
                x = selPx
                For c = 0 To nCols - 1
                    If x >= cw Then Exit For
                    If m_formLayout.Ctls(colIdx(c)).CtlType = "CheckBox" Then
                        PaintFormDatasheetCell x, rowY, colW(c), FC_DS_ROW_PX, vbNullString, backC
                        v = GetRowControlRawValue(cursor, colIdx(c))
                        PaintCanvasCheckBox x + (colW(c) - 13) \ 2, rowY, 13, FC_DS_ROW_PX, v
                    Else
                        txt = GetRowControlText(cursor, colIdx(c))
                        PaintFormDatasheetCell x, rowY, colW(c), FC_DS_ROW_PX, txt, backC
                    End If
                    x = x + colW(c)
                Next c
                AdvanceFormRowCursor cursor
            Next r
            CloseFormRowCursor cursor, isClone, records
        End If

        ' (New) row
        If newShown Then
            rowY = FC_DS_HEADER_PX + (records - m_formTopRow) * FC_DS_ROW_PX
            PaintFormSelectorCell rowY, FC_DS_ROW_PX, selPx, "*"
            x = selPx
            For c = 0 To nCols - 1
                If x >= cw Then Exit For
                PaintFormDatasheetCell x, rowY, colW(c), FC_DS_ROW_PX, vbNullString, &HFFFFFF&
                x = x + colW(c)
            Next c
        End If

        m_fcRowsTop = FC_DS_HEADER_PX
        m_fcRowPx = FC_DS_ROW_PX
        m_fcRecords = records
        m_fcPaintedRows = painted
        m_fcNewShown = newShown
        m_fcRowHitEnabled = True
    End Sub

    ' vsbFormCanvas scrolls m_formTopRow (Continuous Forms and form Datasheet only).
    Private Sub vsbFormCanvas_Change()
        OnFormCanvasScroll
    End Sub

    Private Sub vsbFormCanvas_Scroll()
        OnFormCanvasScroll
    End Sub

    Private Sub OnFormCanvasScroll()
        Dim newTop As Long

        If m_formScrollSync Then Exit Sub
        If m_currentWorkspaceMode <> 10 Or Not m_formLayoutValid Then Exit Sub
        If m_formLayout.DefaultView <> 1 And m_formLayout.DefaultView <> 2 Then Exit Sub
        newTop = vsbFormCanvas.Value
        If newTop = m_formTopRow Then Exit Sub
        m_formTopRow = newTop
        m_formScrollPaint = True
        PaintFormCanvas
        m_formScrollPaint = False
    End Sub

    ' Click on a painted Continuous Forms / form Datasheet row: moves the recordset to that
    ' record and re-renders. Click on the (New) row: existing btnAddRecord_Click flow, then the
    ' form is re-opened on its source (on the new last record) when a record was inserted.
    Private Sub picFormCanvas_MouseDown(Button As Integer, Shift As Integer, X As Single, Y As Single)
        Dim rowNo As Long
        Dim target As Long
        Dim curRow As Long
        Dim k As Long
        Dim rsBefore As Object
        Dim totBefore As Long
        Dim insertMsg As String

        If Button <> vbLeftButton Then Exit Sub

        ' Handle Form Design View (Mode 3 / 6)
        If m_currentWorkspaceMode = 3 Or m_currentWorkspaceMode = 6 Then
            HandleFormDesignerMouseDown X, Y
            Exit Sub
        End If

        ' Handle Native Form View (Mode 10)
        If m_currentWorkspaceMode <> 10 Then Exit Sub
        If Y < m_fcRowsTop Then
            HandleFormHeaderClick X, Y
            Exit Sub
        End If

        If Not m_fcRowHitEnabled Then Exit Sub

        If m_fcRowPx <= 0 Then Exit Sub
        rowNo = CLng(Int((Y - m_fcRowsTop) / m_fcRowPx))
        target = m_formTopRow + rowNo

        If target < m_formTopRow + m_fcPaintedRows Then
            curRow = GetFormCurrentRow(m_fcRecords)
            If target <> curRow Then
                StudioController.MoveFirst
                For k = 1 To target
                    StudioController.MoveNext
                Next k
                UpdateNavigationControls
            End If
        ElseIf m_fcNewShown And target = m_fcRecords Then
            Set rsBefore = StudioController.GetCurrentRecordset()
            totBefore = StudioController.GetTotalRecords()
            btnAddRecord_Click
            If m_formLayoutValid And Len(m_formName) > 0 Then
                If Not (StudioController.GetCurrentRecordset() Is rsBefore) Or StudioController.GetTotalRecords() <> totBefore Then
                    insertMsg = lblStatus.Caption
                    m_formNeedsOpen = True
                    RenderNativeForm m_formName
                    If StudioController.GetTotalRecords() > totBefore Then
                        StudioController.MoveLast
                        UpdateNavigationControls
                    Else
                        m_navSkipFormRebind = True
                        UpdateNavigationControls
                        m_navSkipFormRebind = False
                    End If
                    lblStatus.Caption = insertMsg & " | " & lblStatus.Caption
                End If
            End If
        End If
    End Sub

    Private Sub picFormCanvas_MouseMove(Button As Integer, Shift As Integer, X As Single, Y As Single)
        If m_currentWorkspaceMode = 3 Or m_currentWorkspaceMode = 6 Then
            HandleFormDesignerMouseMove X, Y
        End If
    End Sub

    Private Sub picFormCanvas_MouseUp(Button As Integer, Shift As Integer, X As Single, Y As Single)
        If m_currentWorkspaceMode = 3 Or m_currentWorkspaceMode = 6 Then
            HandleFormDesignerMouseUp X, Y
        End If
    End Sub

    ' -------------------------------------------------------------------------
    ' Query Datasheet View (mode 11, task 10.2)
    ' -------------------------------------------------------------------------
    ' Opens a saved query in Access's default Datasheet View: the result rows come from
    ' StudioController.OpenTable (DAO OpenRecordset on the QueryDef) and are painted on
    ' picDatasheet by PaintDatasheet, with the shared bottom nav bar (UpdateNavigationControls
    ' Case 11). Nothing is written to lstRecords; the SQL bar gets the single-line SQL.
    Private Sub DisplayQueryDatasheet(ByVal queryName As String)
        Dim errMsg As String
        Dim sqlErr As String
        Dim savedSql As String
        Dim ok As Boolean
        Dim rs As Object

        ok = StudioController.OpenTable(queryName, errMsg)

        m_dsQueryName = queryName
        m_activeQueryName = queryName
        m_dsTopRow = 0
        m_dsLkCount = 0
        Set m_dsColRs = Nothing
        m_dsColCount = 0
        m_dsAllowNew = False

        If ok Then
            Set rs = StudioController.GetCurrentRecordset()
            If Not rs Is Nothing Then
                On Error Resume Next
                m_dsAllowNew = CBool(rs.Updatable)
                If Err.Number <> 0 Then m_dsAllowNew = False
                Err.Clear
                On Error GoTo 0
            End If
        End If

        SwitchWorkspaceMode 11
        lblTableTitle.Caption = queryName

        savedSql = StudioController.GetSavedQuerySql(queryName, sqlErr)
        If Len(savedSql) > 0 Then
            txtSql.Text = StudioController.FormatSqlForDisplay(savedSql, True)
        End If

        ' Case 11 sets the nav bar and paints the grid
        m_dsLkCount = 0
        Set m_dsColRs = Nothing
        UpdateNavigationControls

        lblStatus.Caption = "Query Tools: [" & queryName & "] | Datasheet View"
        If ok Then
            lblStatus.Caption = lblStatus.Caption & " | " & CStr(StudioController.GetTotalRecords()) & " record(s)"
        ElseIf Len(errMsg) > 0 Then
            lblStatus.Caption = lblStatus.Caption & " | " & errMsg
        End If
    End Sub

    ' Repaints the Query Datasheet View from the active recordset. Outside a scroll-bar repaint
    ' the row window follows the current record.
    Private Sub PaintQueryDatasheet()
        Dim rs As Object
        Dim records As Long
        Dim curRow As Long
        Dim vis As Long

        If m_currentWorkspaceMode <> 11 And m_currentWorkspaceMode <> 0 Then Exit Sub
        Set rs = StudioController.GetCurrentRecordset()
        records = 0
        If Not rs Is Nothing Then records = StudioController.GetTotalRecords()
        If records < 0 Then records = 0
        curRow = GetFormCurrentRow(records)
        vis = DatasheetVisibleRows(picDatasheet)
        If Not m_dsScrollPaint Then
            If curRow < m_dsTopRow Then m_dsTopRow = curRow
            If curRow >= m_dsTopRow + vis Then m_dsTopRow = curRow - vis + 1
        End If
        PaintDatasheet picDatasheet, rs, m_dsTopRow, curRow
        SyncDatasheetScrollBar
    End Sub

    ' Number of record rows that fit below the header row of a datasheet surface.
    Private Function DatasheetVisibleRows(ByVal pic As PictureBox) As Long
        Dim ch As Long

        On Error Resume Next
        ch = pic.ScaleHeight
        On Error GoTo 0
        If ch <= 0 Then ch = 518
        DatasheetVisibleRows = (ch - FC_DS_HEADER_PX) \ FC_DS_ROW_PX
        If DatasheetVisibleRows < 1 Then DatasheetVisibleRows = 1
    End Function

    ' Record count of a datasheet recordset (the controller's count for the active recordset).
    Private Function DatasheetRecordCount(ByVal rs As Object) As Long
        DatasheetRecordCount = 0
        If rs Is Nothing Then Exit Function
        If rs Is StudioController.GetCurrentRecordset() Then
            DatasheetRecordCount = StudioController.GetTotalRecords()
        Else
            On Error Resume Next
            DatasheetRecordCount = rs.RecordCount
            Err.Clear
            On Error GoTo 0
        End If
        If DatasheetRecordCount < 0 Then DatasheetRecordCount = 0
    End Function

    ' Cell font of the datasheet painter (PaintFormSelectorCell switches to the glyph font).
    Private Sub SetDatasheetFont()
        On Error Resume Next
        m_fcPic.FontName = "Calibri"
        m_fcPic.FontSize = 11
        m_fcPic.FontBold = False
        On Error GoTo 0
    End Sub

    ' Read-only row cursor on record topRow (0-based): a Clone of rs when supported, else rs
    ' itself (CloseDatasheetCursor then puts rs back on curRow).
    Private Function OpenDatasheetCursor(ByVal rs As Object, ByVal topRow As Long, ByRef outIsClone As Boolean) As Object
        Dim c As Object
        Dim k As Long

        outIsClone = False
        If rs Is Nothing Then Exit Function
        On Error Resume Next
        Set c = rs.Clone
        If Err.Number <> 0 Or c Is Nothing Then
            Err.Clear
            Set c = rs
        Else
            outIsClone = True
        End If
        c.MoveFirst
        For k = 1 To topRow
            If c.EOF Then Exit For
            c.MoveNext
        Next k
        Err.Clear
        On Error GoTo 0
        Set OpenDatasheetCursor = c
    End Function

    Private Sub CloseDatasheetCursor(ByVal rs As Object, ByVal cursor As Object, ByVal isClone As Boolean, ByVal records As Long, ByVal curRow As Long)
        Dim k As Long

        If cursor Is Nothing Then Exit Sub
        On Error Resume Next
        If isClone Then
            cursor.Close
        ElseIf Not rs Is Nothing And records > 0 Then
            rs.MoveFirst
            If curRow >= records Then
                rs.MoveLast
                rs.MoveNext
            Else
                For k = 1 To curRow
                    rs.MoveNext
                Next k
            End If
        End If
        Err.Clear
        On Error GoTo 0
    End Sub

    ' Display text of column c for the record under cursor: Null -> "", values resolved through
    ' the existing StudioController.ResolveFieldLookupValue (cached per "c|raw").
    Private Function DatasheetCellText(ByVal cursor As Object, ByVal c As Long) As String
        Dim v As Variant
        Dim raw As String
        Dim key As String
        Dim k As Long
        Dim res As String
        Dim failed As Boolean

        DatasheetCellText = vbNullString
        If cursor Is Nothing Then Exit Function
        failed = False
        On Error Resume Next
        If cursor.EOF Then failed = True
        If Not failed Then
            v = cursor.Fields(c).Value
            If Err.Number <> 0 Then failed = True
        End If
        If Not failed Then
            If IsNull(v) Or IsEmpty(v) Then
                failed = True
            Else
                raw = CStr(v)
                If Err.Number <> 0 Then failed = True
            End If
        End If
        Err.Clear
        On Error GoTo 0
        If failed Then Exit Function

        key = UCase$(Trim$(m_dsQueryName)) & "|" & UCase$(Trim$(m_dsColName(c))) & "|" & CStr(c) & "|" & raw
        For k = 0 To m_dsLkCount - 1
            If m_dsLkKey(k) = key Then
                DatasheetCellText = m_dsLkVal(k)
                Exit Function
            End If
        Next k

        res = raw
        On Error Resume Next
        res = LookupCache.ResolveLookupValue(StudioController.ActiveDatabase, m_dsQueryName, m_dsColName(c), v)
        If Err.Number <> 0 Or Len(res) = 0 Then
            res = StudioController.ResolveFieldLookupValue(m_dsQueryName, m_dsColName(c), v)
        End If
        If Err.Number <> 0 Then res = raw
        Err.Clear
        On Error GoTo 0
        DatasheetCellText = res

        If m_dsLkCount >= 4096 Then Exit Function
        If m_dsLkCount = 0 Then
            ReDim m_dsLkKey(0 To 31)
            ReDim m_dsLkVal(0 To 31)
        ElseIf m_dsLkCount > UBound(m_dsLkKey) Then
            ReDim Preserve m_dsLkKey(0 To m_dsLkCount * 2 - 1)
            ReDim Preserve m_dsLkVal(0 To m_dsLkCount * 2 - 1)
        End If
        m_dsLkKey(m_dsLkCount) = key
        m_dsLkVal(m_dsLkCount) = res
        m_dsLkCount = m_dsLkCount + 1
    End Function

    ' Column layout of rs: names, Boolean flags and widths
    ' max(Len(header), Len(sampled display values)) * avgCharWidth + padding, capped at 240 px.
    ' The first DS_SAMPLE_ROWS records are sampled.
    Private Sub ComputeDatasheetColumns(ByVal pic As PictureBox, ByVal rs As Object, ByVal curRow As Long)
        Dim n As Long
        Dim c As Long
        Dim r As Long
        Dim fType As Long
        Dim avgW As Single
        Dim sample As String
        Dim maxLen() As Long
        Dim cursor As Object
        Dim isClone As Boolean
        Dim records As Long
        Dim txt As String

        Set m_dsColRs = rs
        m_dsColCount = 0
        m_dsLkCount = 0
        If rs Is Nothing Then Exit Sub
        On Error Resume Next
        n = rs.Fields.Count
        If Err.Number <> 0 Then n = 0
        Err.Clear
        On Error GoTo 0
        If n <= 0 Then Exit Sub

        ReDim m_dsColName(0 To n - 1)
        ReDim m_dsColW(0 To n - 1)
        ReDim m_dsColIsBool(0 To n - 1)
        ReDim maxLen(0 To n - 1)
        On Error Resume Next
        For c = 0 To n - 1
            m_dsColName(c) = rs.Fields(c).Name
            fType = 0
            fType = rs.Fields(c).Type
            m_dsColIsBool(c) = (fType = 1)
            maxLen(c) = Len(m_dsColName(c))
        Next c
        Err.Clear
        On Error GoTo 0
        m_dsColCount = n
        m_dsIsRtl = False
        If m_formLayout.RightToLeft Then m_dsIsRtl = True
        For c = 0 To n - 1
            If ArabicCollationHelper.HasArabicUnicode(m_dsColName(c)) Then
                m_dsIsRtl = True
                Exit For
            End If
        Next c

        records = DatasheetRecordCount(rs)
        If records > 0 Then
            Set cursor = OpenDatasheetCursor(rs, 0, isClone)
            For r = 0 To records - 1
                If r >= DS_SAMPLE_ROWS Then Exit For
                For c = 0 To n - 1
                    If Not m_dsColIsBool(c) Then
                        txt = DatasheetCellText(cursor, c)
                        If Len(txt) > maxLen(c) Then maxLen(c) = Len(txt)
                    End If
                Next c
                AdvanceFormRowCursor cursor
            Next r
            CloseDatasheetCursor rs, cursor, isClone, records, curRow
        End If

        sample = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
        avgW = 7
        On Error Resume Next
        pic.FontName = "Calibri"
        pic.FontSize = 11
        pic.FontBold = False
        avgW = CSng(pic.TextWidth(sample)) / Len(sample)
        Err.Clear
        On Error GoTo 0
        If avgW <= 0 Then avgW = 7

        For c = 0 To n - 1
            m_dsColW(c) = CLng(maxLen(c) * avgW) + 12
            If m_dsColW(c) < 30 Then m_dsColW(c) = 30
            If m_dsColW(c) > FC_DS_MAX_COL_PX Then m_dsColW(c) = FC_DS_MAX_COL_PX
        Next c
    End Sub

    ' Datasheet painter (Access Datasheet View): gray header row with the field names, 16 px
    ' record selector column (current record glyph, * on the (New) row), grid lines and
    ' lookup-resolved cells. Columns come from rs (ComputeDatasheetColumns, once per recordset);
    ' rows from topRow (clamped here) with the shared row window ComputeFormRowWindow; the
    ' (New) row is painted when m_dsAllowNew. curRow = 0-based current row (= record count at
    ' the (New) position). Paints through m_fcPic, restored afterwards.
    Private Sub PaintDatasheet(ByVal pic As PictureBox, ByVal rs As Object, ByRef topRow As Long, ByVal curRow As Long)
        Dim prevPic As PictureBox
        Dim cw As Long
        Dim ch As Long
        Dim records As Long
        Dim visibleRows As Long
        Dim painted As Long
        Dim newShown As Boolean
        Dim maxTop As Long
        Dim selPx As Long
        Dim c As Long
        Dim r As Long
        Dim x As Long
        Dim rowY As Long
        Dim cursor As Object
        Dim isClone As Boolean
        Dim backC As Long
        Dim v As Variant

        If pic Is Nothing Then Exit Sub
        Set prevPic = m_fcPic
        Set m_fcPic = pic
        selPx = FC_SELECTOR_PX

        On Error Resume Next
        pic.AutoRedraw = True
        pic.ScaleMode = vbPixels
        pic.BackColor = &HFFFFFF&
        pic.Cls
        pic.FontTransparent = True
        cw = pic.ScaleWidth
        ch = pic.ScaleHeight
        On Error GoTo 0
        If cw <= 0 Then cw = 950
        If ch <= 0 Then ch = 518

        records = DatasheetRecordCount(rs)
        If rs Is Nothing Then
            m_dsColCount = 0
            Set m_dsColRs = Nothing
        ElseIf Not (rs Is m_dsColRs) Then
            ComputeDatasheetColumns pic, rs, curRow
        End If
        SetDatasheetFont

        visibleRows = DatasheetVisibleRows(pic)
        ComputeFormRowWindow records, visibleRows, m_dsAllowNew, topRow, painted, newShown, maxTop
        If m_dsColCount = 0 Then
            painted = 0
            newShown = False
        End If

        ' Header row
        PaintFormSelectorCell 0, FC_DS_HEADER_PX, selPx, vbNullString
        SetDatasheetFont
        If m_dsIsRtl Then
            x = cw - selPx
            For c = 0 To m_dsColCount - 1
                x = x - m_dsColW(c)
                If x < 0 Then Exit For
                PaintFormDatasheetCell x, 0, m_dsColW(c), FC_DS_HEADER_PX, m_dsColName(c), &HE6E6E6&, True
            Next c
        Else
            x = selPx
            For c = 0 To m_dsColCount - 1
                If x >= cw Then Exit For
                PaintFormDatasheetCell x, 0, m_dsColW(c), FC_DS_HEADER_PX, m_dsColName(c), &HE6E6E6&, False
                x = x + m_dsColW(c)
            Next c
        End If

        ' Record rows
        If painted > 0 Then
            Set cursor = OpenDatasheetCursor(rs, topRow, isClone)
            For r = topRow To topRow + painted - 1
                rowY = FC_DS_HEADER_PX + (r - topRow) * FC_DS_ROW_PX
                If r = curRow Then
                    PaintFormSelectorCell rowY, FC_DS_ROW_PX, selPx, ChrW(&H25B6&)
                    backC = &HF7EBDD&
                Else
                    PaintFormSelectorCell rowY, FC_DS_ROW_PX, selPx, vbNullString
                    backC = &HFFFFFF&
                End If
                SetDatasheetFont
                If m_dsIsRtl Then
                    x = cw - selPx
                    For c = 0 To m_dsColCount - 1
                        x = x - m_dsColW(c)
                        If x < 0 Then Exit For
                        If m_dsColIsBool(c) Then
                            PaintFormDatasheetCell x, rowY, m_dsColW(c), FC_DS_ROW_PX, vbNullString, backC, True
                            v = Null
                            On Error Resume Next
                            If Not cursor.EOF Then v = cursor.Fields(c).Value
                            Err.Clear
                            On Error GoTo 0
                            PaintCanvasCheckBox x + (m_dsColW(c) - 13) \ 2, rowY, 13, FC_DS_ROW_PX, v
                        Else
                            PaintFormDatasheetCell x, rowY, m_dsColW(c), FC_DS_ROW_PX, DatasheetCellText(cursor, c), backC, True
                        End If
                    Next c
                Else
                    x = selPx
                    For c = 0 To m_dsColCount - 1
                        If x >= cw Then Exit For
                        If m_dsColIsBool(c) Then
                            PaintFormDatasheetCell x, rowY, m_dsColW(c), FC_DS_ROW_PX, vbNullString, backC, False
                            v = Null
                            On Error Resume Next
                            If Not cursor.EOF Then v = cursor.Fields(c).Value
                            Err.Clear
                            On Error GoTo 0
                            PaintCanvasCheckBox x + (m_dsColW(c) - 13) \ 2, rowY, 13, FC_DS_ROW_PX, v
                        Else
                            PaintFormDatasheetCell x, rowY, m_dsColW(c), FC_DS_ROW_PX, DatasheetCellText(cursor, c), backC, False
                        End If
                        x = x + m_dsColW(c)
                    Next c
                End If
                AdvanceFormRowCursor cursor
            Next r
            CloseDatasheetCursor rs, cursor, isClone, records, curRow
        End If

        ' (New) row
        If newShown Then
            rowY = FC_DS_HEADER_PX + (records - topRow) * FC_DS_ROW_PX
            If curRow = records Then
                backC = &HF7EBDD&
                If m_dsRecordDirty Then
                    PaintFormSelectorCell rowY, FC_DS_ROW_PX, selPx, ChrW(&H270E&)
                Else
                    PaintFormSelectorCell rowY, FC_DS_ROW_PX, selPx, "*"
                End If
            Else
                backC = &HFFFFFF&
                PaintFormSelectorCell rowY, FC_DS_ROW_PX, selPx, "*"
            End If
            SetDatasheetFont
            x = selPx
            For c = 0 To m_dsColCount - 1
                If x >= cw Then Exit For
                Dim newCellTxt As String
                newCellTxt = vbNullString
                If m_dsRecordDirty And Not rs Is Nothing Then
                    On Error Resume Next
                    If rs.EditMode = 2 Then
                        Dim nv As Variant
                        nv = rs.Fields(c).Value
                        If Not IsNull(nv) And Not IsEmpty(nv) Then
                            newCellTxt = LookupCache.ResolveLookupValue(StudioController.ActiveDatabase, m_dsQueryName, m_dsColName(c), nv)
                            If Len(newCellTxt) = 0 Then newCellTxt = CStr(nv)
                        End If
                    End If
                    On Error GoTo 0
                ElseIf (rs.Fields(c).Attributes And &H10&) <> 0 Then
                    newCellTxt = "(New)"
                End If
                PaintFormDatasheetCell x, rowY, m_dsColW(c), FC_DS_ROW_PX, newCellTxt, backC
                x = x + m_dsColW(c)
            Next c
        End If

        If rs Is Nothing Then
            On Error Resume Next
            If Len(m_dsQueryName) > 0 Then
                pic.ForeColor = &H2020C0&
                pic.CurrentX = selPx + 6
                pic.CurrentY = FC_DS_HEADER_PX + 6
                pic.Print "The query could not be opened."
            ElseIf StudioController.IsDatabaseOpen() Then
                pic.ForeColor = &H606060&
                pic.CurrentX = selPx + 6
                pic.CurrentY = FC_DS_HEADER_PX + 6
                pic.Print "No tables in this database yet. Use the 'Create' tab, Design View, or SQL to create a table."
            End If
            On Error GoTo 0
        End If

        m_dsRecords = records
        m_dsPainted = painted
        m_dsNewShown = newShown
        m_dsVisibleRows = visibleRows
        m_dsMaxTop = maxTop
        Set m_fcPic = prevPic
    End Sub

    ' vsbDatasheet range for the Query Datasheet row window.
    Private Sub SyncDatasheetScrollBar()
        Dim maxTop As Long

        maxTop = m_dsMaxTop
        If maxTop > 32767 Then maxTop = 32767
        If maxTop < 0 Then maxTop = 0
        m_dsScrollSync = True
        On Error Resume Next
        vsbDatasheet.Min = 0
        vsbDatasheet.Max = maxTop
        vsbDatasheet.SmallChange = 1
        If m_dsVisibleRows > 0 Then vsbDatasheet.LargeChange = m_dsVisibleRows Else vsbDatasheet.LargeChange = 1
        If m_dsTopRow <= maxTop Then vsbDatasheet.Value = m_dsTopRow Else vsbDatasheet.Value = maxTop
        vsbDatasheet.Enabled = (maxTop > 0)
        On Error GoTo 0
        m_dsScrollSync = False
    End Sub

    Private Sub vsbDatasheet_Change()
        OnDatasheetScroll
    End Sub

    Private Sub vsbDatasheet_Scroll()
        OnDatasheetScroll
    End Sub

    ' Scrolling sets the first painted row; when the current record leaves the viewport the
    ' current record moves to the nearest visible record row (the nav bar follows).
    Private Sub OnDatasheetScroll()
        Dim newTop As Long
        Dim curRow As Long
        Dim target As Long
        Dim k As Long

        If m_dsScrollSync Then Exit Sub
        If m_currentWorkspaceMode = 1 Then
            m_tdTopRow = vsbDatasheet.Value
            PaintTableDesignGrid
            Exit Sub
        End If
        If m_currentWorkspaceMode <> 11 And m_currentWorkspaceMode <> 0 Then Exit Sub
        newTop = vsbDatasheet.Value
        If newTop = m_dsTopRow Then Exit Sub
        m_dsTopRow = newTop

        curRow = GetFormCurrentRow(m_dsRecords)
        target = curRow
        If curRow < newTop Then target = newTop
        If curRow >= newTop + m_dsVisibleRows Then target = newTop + m_dsVisibleRows - 1
        If target >= m_dsRecords And Not (target = curRow And m_dsNewShown) Then target = m_dsRecords - 1

        m_dsScrollPaint = True
        If target >= 0 And target <> curRow Then
            StudioController.MoveFirst
            For k = 1 To target
                StudioController.MoveNext
            Next k
        End If
        UpdateNavigationControls
        m_dsScrollPaint = False
    End Sub

    ' Datasheet interaction: header click sorts/resizes, cell click activates editor,
    ' record selector navigates/selects row, right-click filters by selection.
    Private Sub picDatasheet_MouseDown(Button As Integer, Shift As Integer, X As Single, Y As Single)
        Dim rowNo As Long
        Dim target As Long
        Dim curRow As Long
        Dim k As Long
        Dim rs As Object
        Dim selPx As Long
        Dim curX As Long
        Dim c As Long
        Dim hitCol As Long
        Dim colLeft As Long
        Dim colW As Long
        Dim rowTop As Long
        Dim sortErr As String
        Dim filterErr As String
        Dim curCellText As String
        Dim saveOk As Boolean

        If m_currentWorkspaceMode = 1 Then
            TableDesign_MouseDown Button, Shift, X, Y
            Exit Sub
        End If
        If m_currentWorkspaceMode <> 11 And m_currentWorkspaceMode <> 0 Then Exit Sub
        selPx = FC_SELECTOR_PX

        ' 1. Header click: sort column or begin column resize
        If Y < FC_DS_HEADER_PX Then
            CommitDatasheetCellEdit
            If m_dsRecordDirty Then
                saveOk = SaveDatasheetRecord()
                If Not saveOk Then Exit Sub
            End If
            If X < selPx Then Exit Sub

            curX = selPx
            For c = 0 To m_dsColCount - 1
                curX = curX + m_dsColW(c)
                If Abs(X - curX) <= 4 Then
                    m_dsResizingCol = c
                    m_dsResizeStartX = X
                    m_dsResizeStartW = m_dsColW(c)
                    Exit Sub
                End If
            Next c

            curX = selPx
            For c = 0 To m_dsColCount - 1
                If X >= curX And X < curX + m_dsColW(c) Then
                    If m_dsSortCol = c Then
                        m_dsSortDesc = Not m_dsSortDesc
                    Else
                        m_dsSortCol = c
                        m_dsSortDesc = False
                    End If
                    StudioController.SortActiveDatasheet m_dsColName(c), m_dsSortDesc, sortErr
                    If Len(sortErr) > 0 Then
                        lblStatus.Caption = "Sort notice: " & sortErr
                    Else
                        DisplayTableDatasheet m_dsQueryName
                    End If
                    Exit Sub
                End If
                curX = curX + m_dsColW(c)
            Next c
            Exit Sub
        End If

        ' Row & column calculation
        rowNo = CLng(Int((Y - FC_DS_HEADER_PX) / FC_DS_ROW_PX))
        target = m_dsTopRow + rowNo

        hitCol = -1
        colLeft = 0
        colW = 0
        If X >= selPx Then
            curX = selPx
            For c = 0 To m_dsColCount - 1
                If X >= curX And X < curX + m_dsColW(c) Then
                    hitCol = c
                    colLeft = curX
                    colW = m_dsColW(c)
                    Exit For
                End If
                curX = curX + m_dsColW(c)
            Next c
        End If

        ' Commit any active inline cell edit BEFORE evaluating row counts or moving records
        If m_dsEditActive Then
            If target <> m_dsEditRow Or hitCol <> m_dsEditCol Or X < selPx Or Button = vbRightButton Then
                CommitDatasheetCellEdit
            Else
                Exit Sub
            End If
        End If

        m_dsRecords = StudioController.GetTotalRecords()
        curRow = GetFormCurrentRow(m_dsRecords)

        ' 2. Right-click: Filter by selection
        If Button = vbRightButton Then
            If hitCol >= 0 And target < m_dsRecords Then
                Set rs = StudioController.GetCurrentRecordset()
                If Not rs Is Nothing Then
                    If target <> curRow Then
                        StudioController.MoveFirst
                        For k = 1 To target
                            StudioController.MoveNext
                        Next k
                        UpdateNavigationControls
                    End If
                    curCellText = vbNullString
                    On Error Resume Next
                    If Not rs.EOF Then curCellText = CStr(rs.Fields(hitCol).Value)
                    Err.Clear
                    On Error GoTo 0
                    If Len(curCellText) > 0 Then
                        StudioController.FilterActiveDatasheet "[" & m_dsColName(hitCol) & "] = '" & Replace$(curCellText, "'", "''") & "'", filterErr
                        If Len(filterErr) > 0 Then
                            lblStatus.Caption = "Filter error: " & filterErr
                        Else
                            DisplayTableDatasheet m_dsQueryName
                        End If
                    End If
                End If
            End If
            Exit Sub
        End If

        If Button <> vbLeftButton Then Exit Sub

        ' 3. Left-click on record selector
        If X < selPx Then
            If target <> curRow And m_dsRecordDirty Then
                saveOk = SaveDatasheetRecord()
                If Not saveOk Then Exit Sub
            End If
            If target >= 0 And target < m_dsRecords Then
                StudioController.MoveFirst
                For k = 1 To target
                    StudioController.MoveNext
                Next k
                UpdateNavigationControls
            ElseIf m_dsNewShown And target = m_dsRecords Then
                Set rs = StudioController.GetCurrentRecordset()
                If Not rs Is Nothing Then
                    If m_dsRecords > 0 Then
                        StudioController.MoveLast
                        On Error Resume Next
                        If Not rs.EOF Then rs.MoveNext
                        Err.Clear
                        On Error GoTo 0
                    Else
                        StudioController.MoveFirst
                    End If
                End If
                UpdateNavigationControls
            End If
            Exit Sub
        End If

        ' 4. Left-click on a data cell (or empty area to commit)
        If hitCol < 0 Then
            If m_dsRecordDirty Then SaveDatasheetRecord
            Exit Sub
        End If

        Set rs = StudioController.GetCurrentRecordset()
        If rs Is Nothing Then Exit Sub

        If target >= 0 And target < m_dsRecords Then
            If target <> curRow And m_dsRecordDirty Then
                saveOk = SaveDatasheetRecord()
                If Not saveOk Then Exit Sub
            End If
            StudioController.MoveFirst
            For k = 1 To target
                StudioController.MoveNext
            Next k
            UpdateNavigationControls
        ElseIf m_dsNewShown And target >= m_dsRecords Then
            target = m_dsRecords
            If target <> curRow And m_dsRecordDirty Then
                saveOk = SaveDatasheetRecord()
                If Not saveOk Then Exit Sub
                m_dsRecords = StudioController.GetTotalRecords()
            End If
            On Error Resume Next
            If rs.EditMode <> 2 Then
                If m_dsRecords > 0 Then
                    StudioController.MoveLast
                    If Not rs.EOF Then rs.MoveNext
                Else
                    StudioController.MoveFirst
                End If
            End If
            Err.Clear
            On Error GoTo 0
            UpdateNavigationControls
        Else
            Exit Sub
        End If

        rowTop = FC_DS_HEADER_PX + (target - m_dsTopRow) * FC_DS_ROW_PX
        If m_dsColIsBool(hitCol) Then
            ToggleDatasheetBoolCell hitCol
        Else
            ActivateDatasheetCellEditor hitCol, target, colLeft, colW, rowTop
        End If
    End Sub

    Private Sub picDatasheet_MouseMove(Button As Integer, Shift As Integer, X As Single, Y As Single)
        Dim c As Long
        Dim curX As Long
        Dim selPx As Long
        Dim nearSep As Boolean
        Dim newW As Long

        If m_currentWorkspaceMode <> 11 And m_currentWorkspaceMode <> 0 Then Exit Sub
        selPx = FC_SELECTOR_PX

        If m_dsResizingCol >= 0 And Button = vbLeftButton Then
            newW = m_dsResizeStartW + CLng(X - m_dsResizeStartX)
            If newW < 30 Then newW = 30
            If newW > FC_DS_MAX_COL_PX Then newW = FC_DS_MAX_COL_PX
            m_dsColW(m_dsResizingCol) = newW
            PaintQueryDatasheet
            Exit Sub
        End If

        If Y < FC_DS_HEADER_PX And X >= selPx Then
            curX = selPx
            nearSep = False
            For c = 0 To m_dsColCount - 1
                curX = curX + m_dsColW(c)
                If Abs(X - curX) <= 4 Then
                    nearSep = True
                    Exit For
                End If
            Next c
            If nearSep Then
                picDatasheet.MousePointer = vbSizeWE
            Else
                picDatasheet.MousePointer = vbDefault
            End If
        Else
            picDatasheet.MousePointer = vbDefault
        End If
    End Sub

    Private Sub picDatasheet_MouseUp(Button As Integer, Shift As Integer, X As Single, Y As Single)
        If m_dsResizingCol >= 0 Then
            m_dsResizingCol = -1
            picDatasheet.MousePointer = vbDefault
        End If
    End Sub

    Private Sub picDatasheet_KeyDown(KeyCode As Integer, Shift As Integer)
        Dim rs As Object
        Dim confirmRes As VbMsgBoxResult

        If m_currentWorkspaceMode <> 11 And m_currentWorkspaceMode <> 0 Then Exit Sub
        If KeyCode = vbKeyDelete Then
            Set rs = StudioController.GetCurrentRecordset()
            If rs Is Nothing Then Exit Sub
            On Error Resume Next
            If rs.EOF Or rs.BOF Then Exit Sub
            On Error GoTo 0
            confirmRes = MsgBox("Are you sure you want to delete this record?", vbYesNo + vbQuestion, "OpenAccess Studio")
            If confirmRes = vbYes Then
                On Error Resume Next
                rs.Delete
                If Err.Number <> 0 Then
                    MsgBox "Cannot delete record: " & Err.Description, vbExclamation, "Delete Record"
                Else
                    DisplayTableDatasheet m_dsQueryName
                End If
                Err.Clear
                On Error GoTo 0
            End If
            KeyCode = 0
        End If
    End Sub

    Private Sub ActivateDatasheetCellEditor(ByVal c As Long, ByVal r As Long, ByVal colLeft As Long, ByVal colW As Long, ByVal rowTop As Long)
        Dim rs As Object
        Dim curVal As Variant
        Dim cellText As String
        Dim isLookup As Boolean
        Dim cellLeft As Long
        Dim cellTop As Long
        Dim cellHeight As Long

        CommitDatasheetCellEdit
        If c < 0 Or c >= m_dsColCount Then Exit Sub

        Set rs = StudioController.GetCurrentRecordset()
        If rs Is Nothing Then Exit Sub

        On Error Resume Next
        If Not rs.Updatable Then
            On Error GoTo 0
            Exit Sub
        End If
        ' If user clicks an AutoNumber column, automatically jump to the first editable column in the same row
        If (rs.Fields(c).Attributes And &H10&) <> 0 Then
            Dim altCol As Long
            Dim altLeft As Long
            altLeft = FC_SELECTOR_PX
            For altCol = 0 To m_dsColCount - 1
                If (rs.Fields(altCol).Attributes And &H10&) = 0 And Not m_dsColIsBool(altCol) Then
                    c = altCol
                    colLeft = altLeft
                    colW = m_dsColW(altCol)
                    Exit For
                End If
                altLeft = altLeft + m_dsColW(altCol)
            Next altCol
            If (rs.Fields(c).Attributes And &H10&) <> 0 Then
                On Error GoTo 0
                Exit Sub
            End If
        End If
        On Error GoTo 0

        m_dsEditCol = c
        m_dsEditRow = r
        m_dsEditActive = True

        cellLeft = picDatasheet.Left + colLeft
        cellTop = picDatasheet.Top + rowTop
        cellHeight = FC_DS_ROW_PX

        curVal = Null
        On Error Resume Next
        If Not rs.EOF Or rs.EditMode = 2 Then curVal = rs.Fields(c).Value
        On Error GoTo 0
        If IsNull(curVal) Or IsEmpty(curVal) Then
            m_dsOriginalVal = vbNullString
        Else
            m_dsOriginalVal = CStr(curVal)
        End If

        isLookup = LookupCache.IsLookupField(StudioController.ActiveDatabase, m_dsQueryName, m_dsColName(c))

        If isLookup Then
            fcTxt01.Visible = False
            LookupCache.PopulateLookupComboBox StudioController.ActiveDatabase, m_dsQueryName, m_dsColName(c), fcCbo01
            cellText = LookupCache.ResolveLookupValue(StudioController.ActiveDatabase, m_dsQueryName, m_dsColName(c), curVal)
            If Len(cellText) = 0 Then cellText = m_dsOriginalVal
            fcCbo01.Text = cellText
            fcCbo01.Left = cellLeft
            fcCbo01.Top = cellTop
            fcCbo01.Width = colW
            fcCbo01.Height = cellHeight
            fcCbo01.Visible = True
            fcCbo01.ZOrder 0
            On Error Resume Next
            fcCbo01.SetFocus
            On Error GoTo 0
        Else
            fcCbo01.Visible = False
            fcTxt01.Text = m_dsOriginalVal
            fcTxt01.Left = cellLeft
            fcTxt01.Top = cellTop
            fcTxt01.Width = colW
            fcTxt01.Height = cellHeight
            fcTxt01.Visible = True
            fcTxt01.ZOrder 0
            On Error Resume Next
            fcTxt01.SetFocus
            fcTxt01.SelStart = 0
            fcTxt01.SelLength = Len(fcTxt01.Text)
            On Error GoTo 0
        End If
    End Sub

    Public Sub StartDatasheetCellEdit(Optional ByVal targetCol As Long = -1, Optional ByVal targetRow As Long = -1)
        On Error Resume Next
        Dim c As Long
        Dim r As Long
        Dim colLeft As Long
        Dim colW As Long
        Dim rowTop As Long
        Dim rs As Object
        Dim selPx As Long
        Dim curX As Long
        Dim vis As Long

        If m_currentWorkspaceMode <> 0 And m_currentWorkspaceMode <> 11 Then Exit Sub
        If m_dsColCount <= 0 Then Exit Sub

        Set rs = StudioController.GetCurrentRecordset()
        If rs Is Nothing Then Exit Sub

        selPx = FC_SELECTOR_PX

        If targetRow >= 0 Then
            r = targetRow
        Else
            r = GetFormCurrentRow(m_dsRecords)
        End If

        If r >= 0 And r < m_dsRecords Then
            StudioController.MoveFirst
            Dim k As Long
            For k = 1 To r
                StudioController.MoveNext
            Next k
        ElseIf m_dsNewShown And r >= m_dsRecords Then
            r = m_dsRecords
            StudioController.MoveLast
            On Error Resume Next
            If Not rs.EOF Then rs.MoveNext
            Err.Clear
            On Error GoTo 0
            UpdateNavigationControls
        End If

        vis = DatasheetVisibleRows(picDatasheet)
        If r < m_dsTopRow Then m_dsTopRow = r
        If r >= m_dsTopRow + vis Then m_dsTopRow = r - vis + 1
        PaintQueryDatasheet

        rowTop = FC_DS_HEADER_PX + (r - m_dsTopRow) * FC_DS_ROW_PX

        c = targetCol
        If c < 0 Or c >= m_dsColCount Then
            c = 0
            For c = 0 To m_dsColCount - 1
                If (rs.Fields(c).Attributes And &H10&) = 0 And Not m_dsColIsBool(c) Then Exit For
            Next c
            If c >= m_dsColCount Then c = 0
        End If

        curX = selPx
        Dim i As Long
        For i = 0 To c - 1
            curX = curX + m_dsColW(i)
        Next i
        colLeft = curX
        colW = m_dsColW(c)

        ActivateDatasheetCellEditor c, r, colLeft, colW, rowTop
    End Sub

    Sub CommitDatasheetCellEdit()
        Static inCommit As Boolean
        Dim rs As Object
        Dim newVal As String
        Dim displayVal As String

        If Not m_dsEditActive Or inCommit Then Exit Sub
        inCommit = True

        Set rs = StudioController.GetCurrentRecordset()
        If rs Is Nothing Then
            m_dsEditActive = False
            fcTxt01.Visible = False
            fcCbo01.Visible = False
            inCommit = False
            Exit Sub
        End If

        Dim curColName As String
        curColName = m_dsColName(m_dsEditCol)

        If fcCbo01.Visible Then
            displayVal = Trim$(fcCbo01.Text)
            newVal = displayVal
        ElseIf fcTxt01.Visible Then
            newVal = Trim$(fcTxt01.Text)
        Else
            m_dsEditActive = False
            inCommit = False
            Exit Sub
        End If

        ' Referential integrity & Lookup validation (UI-2B)
        If LookupCache.IsLookupField(StudioController.ActiveDatabase, m_dsQueryName, curColName) Then
            Dim resolvedKey As String
            If Len(newVal) > 0 Then
                If Not LookupCache.ValidateLookupValue(StudioController.ActiveDatabase, m_dsQueryName, curColName, newVal, resolvedKey) Then
                    MsgBox "The text you entered isn't an item in the list, or you cannot add or change a record because a related record is required in table.", vbExclamation, "OpenAccess Studio"
                    fcTxt01.Visible = False
                    fcCbo01.Visible = False
                    m_dsEditActive = False
                    inCommit = False
                    PaintQueryDatasheet
                    Exit Sub
                End If
                newVal = resolvedKey
            End If
        End If

        If newVal <> m_dsOriginalVal Then
            On Error Resume Next
            If rs.EditMode = 0 Then
                If m_dsEditRow >= m_dsRecords And m_dsNewShown Then
                    rs.AddNew
                ElseIf m_dsEditRow >= 0 And m_dsEditRow < m_dsRecords Then
                    If rs.EOF Or rs.BOF Or rs.AbsolutePosition <> m_dsEditRow Then
                        rs.MoveFirst
                        Dim moveIdx As Long
                        For moveIdx = 1 To m_dsEditRow
                            If Not rs.EOF Then rs.MoveNext
                        Next moveIdx
                    End If
                    rs.Edit
                Else
                    rs.Edit
                End If
            End If

            If Len(newVal) = 0 Then
                rs.Fields(m_dsColName(m_dsEditCol)).Value = Null
            Else
                rs.Fields(m_dsColName(m_dsEditCol)).Value = newVal
            End If

            If Err.Number <> 0 Then
                lblStatus.Caption = "Validation error: " & Err.Description
                Err.Clear
                rs.CancelUpdate
                Err.Clear
                m_dsRecordDirty = False
                On Error GoTo 0
            Else
                m_dsRecordDirty = True
                m_dsOriginalVal = newVal
                rs.Update
                If Err.Number = 0 Then
                    m_dsRecordDirty = False
                    m_dsLkCount = 0
                    LookupCache.ClearLookupCache
                    m_dsRecords = StudioController.GetTotalRecords()
                    lblStatus.Caption = "Record saved."
                Else
                    Dim commitErrMsg As String
                    commitErrMsg = Err.Description
                    lblStatus.Caption = "Validation error: " & commitErrMsg
                    Err.Clear
                    rs.CancelUpdate
                    Err.Clear
                    m_dsRecordDirty = False
                End If
            End If
            On Error GoTo 0
        End If

        fcTxt01.Visible = False
        fcCbo01.Visible = False
        m_dsEditActive = False
        inCommit = False
        UpdateNavigationControls
        PaintQueryDatasheet
    End Sub

    Private Sub CancelDatasheetCellEdit()
        If m_dsEditActive Then
            fcTxt01.Visible = False
            fcCbo01.Visible = False
            m_dsEditActive = False
            PaintQueryDatasheet
        End If
    End Sub

    Private Function SaveDatasheetRecord() As Boolean
        Dim rs As Object
        Dim errMsg As String

        SaveDatasheetRecord = True
        If Not m_dsRecordDirty Then Exit Function

        Set rs = StudioController.GetCurrentRecordset()
        If rs Is Nothing Then Exit Function

        On Error Resume Next
        rs.Update
        If Err.Number <> 0 Then
            errMsg = Err.Description
            lblStatus.Caption = "Error saving record: " & errMsg
            MsgBox errMsg, vbExclamation, "Referential Integrity / Validation Error"
            Err.Clear
            rs.CancelUpdate
            Err.Clear
            m_dsRecordDirty = False
            SaveDatasheetRecord = False
            On Error GoTo 0
            Exit Function
        End If
        On Error GoTo 0

        m_dsRecordDirty = False
        m_dsLkCount = 0
        LookupCache.ClearLookupCache
        m_dsRecords = StudioController.GetTotalRecords()
        lblStatus.Caption = "Record saved."
        UpdateNavigationControls
        PaintQueryDatasheet
    End Function

    Private Sub CancelDatasheetRecord()
        Dim rs As Object
        If m_dsRecordDirty Then
            Set rs = StudioController.GetCurrentRecordset()
            If Not rs Is Nothing Then
                On Error Resume Next
                rs.CancelUpdate
                Err.Clear
                On Error GoTo 0
            End If
            m_dsRecordDirty = False
            lblStatus.Caption = "Record changes cancelled."
            PaintQueryDatasheet
        End If
    End Sub

    Private Sub ToggleDatasheetBoolCell(ByVal colIdx As Long)
        Dim rs As Object
        Dim curVal As Variant
        Dim newVal As Boolean

        If colIdx < 0 Or colIdx >= m_dsColCount Then Exit Sub
        Set rs = StudioController.GetCurrentRecordset()
        If rs Is Nothing Then Exit Sub

        On Error Resume Next
        If Not rs.Updatable Then
            On Error GoTo 0
            Exit Sub
        End If

        curVal = rs.Fields(colIdx).Value
        If IsNull(curVal) Or IsEmpty(curVal) Then
            newVal = True
        Else
            newVal = Not CBool(curVal)
        End If

        If rs.EditMode = 2 Then
            rs.Fields(colIdx).Value = newVal
            m_dsRecordDirty = True
            PaintQueryDatasheet
        ElseIf rs.EOF And m_dsNewShown Then
            rs.AddNew
            If Err.Number = 0 Then
                rs.Fields(colIdx).Value = newVal
                m_dsRecordDirty = True
                PaintQueryDatasheet
            End If
        Else
            If rs.EditMode = 0 Then rs.Edit
            If Err.Number = 0 Then
                rs.Fields(colIdx).Value = newVal
                rs.Update
                m_dsRecordDirty = False
                If Err.Number = 0 Then
                    PaintQueryDatasheet
                End If
            End If
        End If
        Err.Clear
        On Error GoTo 0
    End Sub

    Private Sub NavigateDatasheetCell(ByVal targetCol As Long, ByVal targetRow As Long)
        Dim curX As Long
        Dim c As Long
        Dim colLeft As Long
        Dim colW As Long
        Dim rowTop As Long
        Dim k As Long
        Dim curRow As Long
        Dim saveOk As Boolean

        If m_dsColCount <= 0 Then Exit Sub
        m_dsRecords = StudioController.GetTotalRecords()
        curRow = GetFormCurrentRow(m_dsRecords)

        Dim rsNav As Object
        Set rsNav = StudioController.GetCurrentRecordset()
        If Not rsNav Is Nothing Then
            On Error Resume Next
            Do While targetCol >= 0 And targetCol < m_dsColCount
                If (rsNav.Fields(targetCol).Attributes And &H10&) <> 0 Or m_dsColIsBool(targetCol) Then
                    targetCol = targetCol + 1
                Else
                    Exit Do
                End If
            Loop
            On Error GoTo 0
        End If

        If targetCol >= m_dsColCount Then
            targetCol = 0
            If Not rsNav Is Nothing Then
                On Error Resume Next
                Do While targetCol < m_dsColCount
                    If (rsNav.Fields(targetCol).Attributes And &H10&) <> 0 Or m_dsColIsBool(targetCol) Then
                        targetCol = targetCol + 1
                    Else
                        Exit Do
                    End If
                Loop
                If targetCol >= m_dsColCount Then targetCol = 0
                On Error GoTo 0
            End If
            targetRow = targetRow + 1
        ElseIf targetCol < 0 Then
            targetCol = m_dsColCount - 1
            If targetRow > 0 Then targetRow = targetRow - 1
        End If

        If targetRow >= 0 And targetRow < m_dsRecords Then
            If targetRow <> curRow And m_dsRecordDirty Then
                saveOk = SaveDatasheetRecord()
                If Not saveOk Then Exit Sub
            End If
            StudioController.MoveFirst
            For k = 1 To targetRow
                StudioController.MoveNext
            Next k
            UpdateNavigationControls
        ElseIf m_dsNewShown And targetRow >= m_dsRecords Then
            targetRow = m_dsRecords
            If targetRow <> curRow And m_dsRecordDirty Then
                saveOk = SaveDatasheetRecord()
                If Not saveOk Then Exit Sub
                m_dsRecords = StudioController.GetTotalRecords()
            End If
            On Error Resume Next
            If rsNav.EditMode <> 2 Then
                If m_dsRecords > 0 Then
                    StudioController.MoveLast
                    If Not rsNav.EOF Then rsNav.MoveNext
                Else
                    StudioController.MoveFirst
                End If
            End If
            Err.Clear
            On Error GoTo 0
            UpdateNavigationControls
        Else
            Exit Sub
        End If

        curX = FC_SELECTOR_PX
        colW = m_dsColW(targetCol)
        For c = 0 To targetCol - 1
            curX = curX + m_dsColW(c)
        Next c
        colLeft = curX

        rowTop = FC_DS_HEADER_PX + (targetRow - m_dsTopRow) * FC_DS_ROW_PX
        If Not m_dsColIsBool(targetCol) Then
            ActivateDatasheetCellEditor targetCol, targetRow, colLeft, colW, rowTop
        End If
    End Sub

    Private Sub HandleDatasheetEditorKeyDown(ByRef KeyCode As Integer, ByVal Shift As Integer)
        If m_currentWorkspaceMode = 1 Then
            If KeyCode = vbKeyReturn Or KeyCode = vbKeyTab Then
                KeyCode = 0
                CommitTableDesignCellEdit
            ElseIf KeyCode = vbKeyEscape Then
                KeyCode = 0
                m_tdEditing = False
                fcTxt01.Visible = False
                fcCbo01.Visible = False
            End If
            Exit Sub
        End If
        If m_currentWorkspaceMode = 12 Then
            If KeyCode = vbKeyReturn Then
                KeyCode = 0
                CommitQbeCellEdit
            End If
            Exit Sub
        End If
        If m_currentWorkspaceMode = 10 Then
            If KeyCode = vbKeyReturn Then
                KeyCode = 0
                ApplyFaytFilter
            End If
            Exit Sub
        End If

        If m_currentWorkspaceMode <> 11 And m_currentWorkspaceMode <> 0 Then Exit Sub

        Select Case KeyCode
            Case vbKeyReturn
                If (Shift And 1) <> 0 Then
                    CommitDatasheetCellEdit
                    SaveDatasheetRecord
                Else
                    CommitDatasheetCellEdit
                    NavigateDatasheetCell m_dsEditCol + 1, m_dsEditRow
                End If
                KeyCode = 0

            Case vbKeyTab
                If (Shift And 1) <> 0 Then
                    CommitDatasheetCellEdit
                    NavigateDatasheetCell m_dsEditCol - 1, m_dsEditRow
                Else
                    CommitDatasheetCellEdit
                    NavigateDatasheetCell m_dsEditCol + 1, m_dsEditRow
                End If
                KeyCode = 0

            Case vbKeyEscape
                If m_dsEditActive Then
                    CancelDatasheetCellEdit
                ElseIf m_dsRecordDirty Then
                    CancelDatasheetRecord
                End If
                KeyCode = 0

            Case vbKeyUp
                CommitDatasheetCellEdit
                If m_dsEditRow > 0 Then
                    NavigateDatasheetCell m_dsEditCol, m_dsEditRow - 1
                End If
                KeyCode = 0

            Case vbKeyDown
                CommitDatasheetCellEdit
                NavigateDatasheetCell m_dsEditCol, m_dsEditRow + 1
                KeyCode = 0
        End Select
    End Sub

    Private Sub HandleFormEditorKeyPress(ByRef KeyAscii As Integer)
        If KeyAscii = 13 Then
            KeyAscii = 0  ' Suppress Windows default beep on Enter; KeyDown handles execution
        End If
    End Sub

