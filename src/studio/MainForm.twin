            MsgBox "Please open a database first.", vbInformation, "VBE Run [F5]"
            Exit Sub
        End If

        codeText = Trim$(txtVbaCode.Text)
        If Len(codeText) > 0 Then
            Dim execOut As String
            Dim errOut As String
            If StudioController.ExecuteVbaProcedure(codeText, "", True, execOut, errOut) Then
                ProcessPendingVbaUiActions
                If Len(execOut) > 0 Then
                    lblStatus.Caption = "VBE Executed ==> " & execOut
                    Exit Sub
                End If
            End If
        End If

        btnFormCmd_Click
    End Sub

    Private Sub SaveActiveFormDirectly()
        Dim targetForm As String
        Dim modName As String
        Dim vbaText As String
        Dim errMsg As String
        Dim savedVba As Boolean
        Dim savedDesign As Boolean
        Dim savedRec As Boolean

        targetForm = Trim$(StudioController.GetActiveFormName())
        If Len(targetForm) = 0 Then targetForm = Trim$(m_formName)
        If Len(targetForm) = 0 Then
            If lstTables.ListIndex >= 0 Then
                If Left$(lstTables.List(lstTables.ListIndex), 7) = "[Form] " Then
                    targetForm = Trim$(Mid$(lstTables.List(lstTables.ListIndex), 8))
                End If
            End If
        End If

        If Len(targetForm) = 0 Then
            MsgBox "No active Form is open to save.", vbInformation, "Save Form"
            Exit Sub
        End If

        StudioController.SetActiveFormName targetForm
        m_formName = targetForm

        ' 1. If in Native Form View (mode 10), commit any edited record fields first
        If m_currentWorkspaceMode = 10 Then
            On Error Resume Next
            SaveNativeFormRecord
            savedRec = True
            On Error GoTo 0
        End If

        ' 2. Save Form VBA module code (Form_<targetForm>) if present in VBE editor
        modName = "Form_" & targetForm
        vbaText = Trim$(txtVbaCode.Text)
        If Len(vbaText) > 0 And vbaText <> "Option Compare Database" Then
            If StudioController.SaveVbaModuleCode(modName, txtVbaCode.Text, errMsg) Then
                savedVba = True
                FormRuntime.OpenForm targetForm, Me, True
            End If
        End If

        ' 3. Save Form Design layout (geometry & captions) ONLY when in Form Design View (mode 3 or 6)
        If m_formLayoutValid And (m_currentWorkspaceMode = 3 Or m_currentWorkspaceMode = 6) Then
            Dim blobErr As String
            If StudioController.SaveNativeFormDesignChanges(targetForm, m_formLayout, blobErr) Then
                savedDesign = True
            End If
        End If

        If savedVba Or savedDesign Or savedRec Then
            lblStatus.Caption = "Form [" & targetForm & "] saved directly to database."
            MsgBox "Form [" & targetForm & "] changes saved successfully!", vbInformation, "Save Form"
        ElseIf Len(errMsg) > 0 Then
            lblStatus.Caption = "Form Save Error: " & errMsg
            MsgBox "Error saving Form [" & targetForm & "]: " & errMsg, vbExclamation, "Save Form Error"
        Else
            lblStatus.Caption = "Form [" & targetForm & "] is up to date."
            MsgBox "Form [" & targetForm & "] saved successfully!", vbInformation, "Save Form"
        End If
    End Sub

    Private Sub btnSaveVbaCode_Click()
        Dim modName As String
        Dim fullCode As String
        Dim hdrText As String
        Dim errMsg As String
        Dim ok As Boolean

        If Not StudioController.IsDatabaseOpen() Then
            MsgBox "Please open a database first.", vbInformation, "Save VBA Module"
            Exit Sub
        End If

        modName = vbNullString
        hdrText = Trim$(lblVbeHeader.Caption)
        If Left$(hdrText, 10) = "VBE Code: " Then
            modName = Trim$(Mid$(hdrText, 11))
            If Right$(modName, 7) = " (Code)" Then
                modName = Trim$(Left$(modName, Len(modName) - 7))
            End If
        End If

        If Len(modName) = 0 Then
            If StudioController.IsNativeModuleActive() Then
                modName = StudioController.GetActiveModuleName()
            ElseIf StudioController.IsNativeFormActive() Then
                modName = "Form_" & StudioController.GetActiveFormName()
            ElseIf Len(Trim$(m_formName)) > 0 Then
                modName = "Form_" & Trim$(m_formName)
            End If
        End If

        If Len(modName) = 0 Then
            MsgBox "Please select a Module or Form to edit and save.", vbInformation, "Save VBA Module"
            Exit Sub
        End If

        fullCode = txtVbaCode.Text
        ok = StudioController.SaveVbaModuleCode(modName, fullCode, errMsg)
        If ok Then
            If Left$(UCase$(modName), 5) = "FORM_" Then
                Dim fName As String
                fName = Mid$(modName, 6)
                StudioController.SetActiveFormName fName
                m_formName = fName
                FormRuntime.OpenForm fName, Me, True

            ElseIf StudioController.IsNativeFormActive() Then
                FormRuntime.OpenForm StudioController.GetActiveFormName(), Me, True
            End If
            lblStatus.Caption = "Saved VBA code for [" & modName & "] to MSysAccessStorage."
            MsgBox "VBA Code for [" & modName & "] saved and compiled successfully!", vbInformation, "VBE Code Saved"
        Else
            lblStatus.Caption = "VBA Save Error: " & errMsg
            MsgBox "Error saving VBA code: " & errMsg, vbExclamation, "Save VBA Error"
        End If
    End Sub

    Private Sub lstPropSheet_Click()
        If m_currentWorkspaceMode = 12 Or m_currentWorkspaceMode = 1 Then Exit Sub
        Dim selIdx As Long
        Dim lineText As String
        Dim colonPos As Long
        Dim propName As String
        Dim ctlName As String
        Dim eventName As String

        selIdx = lstPropSheet.ListIndex
        If selIdx < 0 Then Exit Sub

        If selIdx = 0 Then
            ' Cycle through tabs: Format -> Data -> Event -> Other -> All
            m_activePropTab = (m_activePropTab + 1) Mod 5
            PopulateTabbedPropertySheet m_selectedDesignCtlIndex
            Exit Sub
        End If

        lineText = lstPropSheet.List(selIdx)

        If InStr(1, lineText, "[...]") > 0 Then
            colonPos = InStr(1, lineText, ":")
            If colonPos > 0 Then
                propName = Trim$(Left$(lineText, colonPos - 1))
                If Left$(propName, 3) = "On " Then
                    eventName = Replace$(Mid$(propName, 4), " ", "")
                Else
                    eventName = propName
                End If

                If m_selectedDesignCtlIndex >= 0 And m_selectedDesignCtlIndex < m_formLayout.CtlCount Then
                    ctlName = m_formLayout.Ctls(m_selectedDesignCtlIndex).CtlName
                Else
                    ctlName = "Form"
                End If

                JumpToVbeEventCode ctlName, eventName
            End If
        End If
    End Sub

    Private Sub lstPropSheet_DblClick()
        Dim selIdx As Long
        Dim lineText As String
        Dim colonPos As Long
        Dim propName As String
        Dim ctlName As String
        Dim eventName As String

        selIdx = lstPropSheet.ListIndex
        If selIdx < 0 Then Exit Sub

        If m_currentWorkspaceMode = 1 Then
            HandleTableDesignPropDblClick selIdx
            Exit Sub
        End If

        If m_currentWorkspaceMode = 12 Or m_currentWorkspaceMode = 8 Then
            lineText = lstPropSheet.List(selIdx)
            QbeAddTable lineText
            Exit Sub
        End If

        If selIdx = 0 Then
            m_activePropTab = (m_activePropTab + 1) Mod 5
            PopulateTabbedPropertySheet m_selectedDesignCtlIndex
            Exit Sub
        End If

        lineText = lstPropSheet.List(selIdx)

        If InStr(1, lineText, "[...]") > 0 Then
            colonPos = InStr(1, lineText, ":")
            If colonPos > 0 Then
                propName = Trim$(Left$(lineText, colonPos - 1))
                If Left$(propName, 3) = "On " Then
                    eventName = Replace$(Mid$(propName, 4), " ", "")
                Else
                    eventName = propName
                End If

                If m_selectedDesignCtlIndex >= 0 And m_selectedDesignCtlIndex < m_formLayout.CtlCount Then
                    ctlName = m_formLayout.Ctls(m_selectedDesignCtlIndex).CtlName
                Else
                    ctlName = "Form"
                End If

                JumpToVbeEventCode ctlName, eventName
                Exit Sub
            End If
        End If

        If m_currentWorkspaceMode = 3 Or m_currentWorkspaceMode = 6 Then
            colonPos = InStr(1, lineText, ":")
            If colonPos > 0 Then
                propName = Trim$(Left$(lineText, colonPos - 1))
                Dim curPropVal As String
                Dim newPropVal As String
                curPropVal = Trim$(Mid$(lineText, colonPos + 1))
                newPropVal = InputBox("Edit property [" & propName & "]:", "Form Design Property", curPropVal)
                If Len(newPropVal) > 0 And newPropVal <> curPropVal Then
                    If m_selectedDesignCtlIndex >= 0 And m_selectedDesignCtlIndex < m_formLayout.CtlCount Then
                        ApplyControlProperty m_selectedDesignCtlIndex, propName, newPropVal
                    Else
                        StudioController.ApplyControlProperty -1, propName, newPropVal
                        StudioController.GetDesignerLayout m_formLayout
                        PaintVisualFormDesigner
                        PopulateTabbedPropertySheet m_selectedDesignCtlIndex
                    End If
                    Exit Sub
                End If
            End If
        End If

        MsgBox "Property Inspector Detail:" & vbCrLf & vbCrLf & lineText, vbInformation, "Property Sheet"
    End Sub

    Private Sub lstRecords_DblClick()
        If lstRecords.ListIndex < 0 Then Exit Sub
        Dim selText As String
        selText = lstRecords.List(lstRecords.ListIndex)
        If m_currentWorkspaceMode = 8 Then
            If InStr(1, selText, " -> ") > 0 And InStr(1, selText, " | ") > 0 And Left$(Trim$(selText), 1) <> "[" Then
                Dim editRelName As String
                editRelName = Trim$(Left$(selText, InStr(1, selText, " | ") - 1))
                PromptCreateRelationshipDialog "", "", "", "", editRelName
            Else
                PromptCreateRelationshipDialog
            End If
            Exit Sub
        End If
        If Left$(Trim$(selText), 7) = "* (New)" Then
            btnAddRecord_Click
        Else
            btnEditRecord_Click
        End If
    End Sub

    ' -------------------------------------------------------------------------
    ' Floating / Movable / Resizable Record Details Editor Panel Engine
    ' -------------------------------------------------------------------------

    ' -------------------------------------------------------------------------
    ' Movable & Resizable Record Details Editor Engine (Standard Controls)
    ' -------------------------------------------------------------------------
    Private Sub LayoutRecordEditorPanel()
        Dim w As Single
        Dim labelWidth As Single
        Dim textWidth As Single
        Dim curY As Single
        Dim fldHeight As Single
        Dim fldGap As Single

        If Not m_editorVisible Then
            lblFormSection.Visible = False
            lblFormFld1.Visible = False: txtFormFld1.Visible = False
            lblFormFld2.Visible = False: txtFormFld2.Visible = False
            lblFormFld3.Visible = False: txtFormFld3.Visible = False
            lblFormFld4.Visible = False: txtFormFld4.Visible = False
            lblFormFld5.Visible = False: txtFormFld5.Visible = False
            btnLookupDrop.Visible = False
            lblLookupHint.Visible = False
            btnSaveFormRec.Visible = False
            btnNewFormRec.Visible = False
            btnFormCmd.Visible = False
            Exit Sub
        End If

        w = m_editorWidth
        If w < 340 Then w = 340

        ' Title / Move Header Bar
        lblFormSection.Visible = True
        lblFormSection.Left = m_editorLeft
        lblFormSection.Top = m_editorTop
        lblFormSection.Width = w
        lblFormSection.Height = 22

        ' Toggle Size / Minimize Button
        btnFormCmd.Visible = True
        btnFormCmd.Left = m_editorLeft + w - 130
        btnFormCmd.Top = m_editorTop
        btnFormCmd.Width = 130
        btnFormCmd.Height = 22
        If m_editorExpanded Then
            btnFormCmd.Caption = "Compact View [-]"
        Else
            btnFormCmd.Caption = "Expand View [+]"
        End If

        labelWidth = 90
        textWidth = w - labelWidth - 30
        If textWidth < 120 Then textWidth = 120
        fldHeight = 24
        fldGap = 6
        curY = m_editorTop + 28

        If Len(lblFormFld1.Caption) > 0 Then
            lblFormFld1.Visible = True: txtFormFld1.Visible = True
            lblFormFld1.Left = m_editorLeft
            lblFormFld1.Top = curY + 2
            lblFormFld1.Width = labelWidth
            lblFormFld1.Height = 20
            txtFormFld1.Left = m_editorLeft + labelWidth + 4
            txtFormFld1.Top = curY
            txtFormFld1.Width = textWidth
            txtFormFld1.Height = fldHeight
            curY = curY + fldHeight + fldGap
        End If

        If Len(lblFormFld2.Caption) > 0 Then
            lblFormFld2.Visible = True: txtFormFld2.Visible = True
            lblFormFld2.Left = m_editorLeft
            lblFormFld2.Top = curY + 2
            lblFormFld2.Width = labelWidth
            lblFormFld2.Height = 20
            txtFormFld2.Left = m_editorLeft + labelWidth + 4
            txtFormFld2.Top = curY
            txtFormFld2.Width = textWidth
            txtFormFld2.Height = fldHeight
            curY = curY + fldHeight + fldGap
        End If

        If Len(lblFormFld3.Caption) > 0 Then
            lblFormFld3.Visible = True: txtFormFld3.Visible = True
            lblFormFld3.Left = m_editorLeft
            lblFormFld3.Top = curY + 2
            lblFormFld3.Width = labelWidth
            lblFormFld3.Height = 20
            txtFormFld3.Left = m_editorLeft + labelWidth + 4
            txtFormFld3.Top = curY
            txtFormFld3.Width = textWidth
            txtFormFld3.Height = fldHeight
            curY = curY + fldHeight + fldGap
        End If

        If Len(lblFormFld4.Caption) > 0 Then
            lblFormFld4.Visible = True: txtFormFld4.Visible = True
            lblFormFld4.Left = m_editorLeft
            lblFormFld4.Top = curY + 2
            lblFormFld4.Width = labelWidth
            lblFormFld4.Height = 20
            txtFormFld4.Left = m_editorLeft + labelWidth + 4
            txtFormFld4.Top = curY
            txtFormFld4.Width = textWidth
            txtFormFld4.Height = fldHeight
            curY = curY + fldHeight + fldGap
        End If

        If Len(lblFormFld5.Caption) > 0 Then
            lblFormFld5.Visible = True: txtFormFld5.Visible = True
            lblFormFld5.Left = m_editorLeft
            lblFormFld5.Top = curY + 2
            lblFormFld5.Width = labelWidth
            lblFormFld5.Height = 20
            txtFormFld5.Left = m_editorLeft + labelWidth + 4
            txtFormFld5.Top = curY
            txtFormFld5.Width = textWidth - 60
            txtFormFld5.Height = fldHeight
            btnLookupDrop.Left = m_editorLeft + labelWidth + 4 + (textWidth - 56)
            btnLookupDrop.Top = curY
            btnLookupDrop.Width = 54
            btnLookupDrop.Height = fldHeight
            curY = curY + fldHeight + fldGap
        End If

        lblLookupHint.Visible = True
        lblLookupHint.Left = m_editorLeft
        lblLookupHint.Top = curY
        lblLookupHint.Width = w
        lblLookupHint.Height = 18
        curY = curY + 22

        btnSaveFormRec.Visible = True
        btnSaveFormRec.Left = m_editorLeft
        btnSaveFormRec.Top = curY
        btnSaveFormRec.Width = 110
        btnSaveFormRec.Height = 26
        btnSaveFormRec.Caption = "Save Record"

        btnNewFormRec.Visible = True
        btnNewFormRec.Left = m_editorLeft + 120
        btnNewFormRec.Top = curY
        btnNewFormRec.Width = 110
        btnNewFormRec.Height = 26
        btnNewFormRec.Caption = "+ New Record"
    End Sub

    Private Sub lblFormSection_MouseDown(Button As Integer, Shift As Integer, X As Single, Y As Single)
        If Button = 1 Then
            m_isEditorDragging = True
            m_dragStartX = X
            m_dragStartY = Y
        End If
    End Sub

    Private Sub lblFormSection_MouseMove(Button As Integer, Shift As Integer, X As Single, Y As Single)
        If m_isEditorDragging Then
            m_editorLeft = m_editorLeft + (X - m_dragStartX)
            m_editorTop = m_editorTop + (Y - m_dragStartY)
            If m_editorLeft < 238 Then m_editorLeft = 238
            If m_editorTop < 100 Then m_editorTop = 100
            If m_editorLeft > 1150 Then m_editorLeft = 1150
            If m_editorTop > 650 Then m_editorTop = 650
            LayoutRecordEditorPanel
        End If
    End Sub

    Private Sub lblFormSection_MouseUp(Button As Integer, Shift As Integer, X As Single, Y As Single)
        m_isEditorDragging = False
    End Sub

    Private Sub txtFormFld1_KeyPress(KeyAscii As Integer)
        If KeyAscii = 13 Then
            KeyAscii = 0
            btnSaveFormRec_Click
        End If
    End Sub

    Private Sub txtFormFld2_KeyPress(KeyAscii As Integer)
        If KeyAscii = 13 Then
            KeyAscii = 0
            btnSaveFormRec_Click
        End If
    End Sub

    Private Sub txtFormFld3_KeyPress(KeyAscii As Integer)
        If KeyAscii = 13 Then
            KeyAscii = 0
            btnSaveFormRec_Click
        End If
    End Sub

    Private Sub txtFormFld4_KeyPress(KeyAscii As Integer)
        If KeyAscii = 13 Then
            KeyAscii = 0
            btnSaveFormRec_Click
        End If
    End Sub

    Private Sub txtFormFld5_KeyPress(KeyAscii As Integer)
        If KeyAscii = 13 Then
            KeyAscii = 0
            btnSaveFormRec_Click
        End If
    End Sub

    ' =========================================================================
    ' FormRuntime Control Bridge Methods (WS4 & WS5)
    ' =========================================================================

    Public Sub SetControlText(ByVal ctlName As String, ByVal newText As String)
        Dim slot As Long
        Dim idx As Long
        Dim ctlObj As Object

        For slot = 1 To FC_SLOT_TOTAL
            idx = m_poolCtlIndex(slot)
            If idx >= 0 Then
                If UCase$(Trim$(m_formLayout.Ctls(idx).CtlName)) = UCase$(Trim$(ctlName)) Then
                    Set ctlObj = PoolControlBySlot(slot)
                    If Not ctlObj Is Nothing Then
                        On Error Resume Next
                        ctlObj.Text = newText
                        On Error GoTo 0
                    End If
                    Exit Sub
                End If
            End If
        Next slot

        ' If control is an unpooled Label on the canvas, update its caption and refresh
        For idx = 0 To m_formLayout.CtlCount - 1
            If UCase$(Trim$(m_formLayout.Ctls(idx).CtlName)) = UCase$(Trim$(ctlName)) Then
                If m_formLayout.Ctls(idx).CtlType = "Label" Then
                    m_formLayout.Ctls(idx).Caption = newText
                    On Error Resume Next
                    picFormCanvas.Refresh
                    On Error GoTo 0
                    Exit Sub
                End If
            End If
        Next idx
    End Sub

    Public Function GetControlText(ByVal ctlName As String) As String
        Dim slot As Long
        Dim idx As Long
        Dim ctlObj As Object

        GetControlText = vbNullString
        For slot = 1 To FC_SLOT_TOTAL
            idx = m_poolCtlIndex(slot)
            If idx >= 0 Then
                If UCase$(Trim$(m_formLayout.Ctls(idx).CtlName)) = UCase$(Trim$(ctlName)) Then
                    Set ctlObj = PoolControlBySlot(slot)
                    If Not ctlObj Is Nothing Then
                        On Error Resume Next
                        GetControlText = ctlObj.Text
                        On Error GoTo 0
                    End If
                    Exit Function
                End If
            End If
        Next slot
    End Function

    Public Sub PopulateListBox(ByVal ctlName As String, ByRef items() As String, Optional ByVal colCount As Long = 1, Optional ByVal colWidths As String = "")
        Dim slot As Long
        Dim idx As Long
        Dim lstObj As ListBox
        Dim i As Long

        For slot = FC_SLOT_LST_BASE + 1 To FC_SLOT_BTN_BASE
            idx = m_poolCtlIndex(slot)
            If idx >= 0 Then
                If UCase$(Trim$(m_formLayout.Ctls(idx).CtlName)) = UCase$(Trim$(ctlName)) Then
                    Set lstObj = PoolListBox(slot - FC_SLOT_LST_BASE)
                    If Not lstObj Is Nothing Then
                        lstObj.Clear
                        On Error Resume Next
                        For i = LBound(items) To UBound(items)
                            lstObj.AddItem items(i)
                        Next i
                        On Error GoTo 0
                    End If
                    Exit Sub
                End If
            End If
        Next slot
    End Sub

    Public Sub SelectListBoxItem(ByVal ctlName As String, ByVal itemIndex As Long)
        Dim slot As Long
        Dim idx As Long
        Dim lstObj As ListBox

        For slot = FC_SLOT_LST_BASE + 1 To FC_SLOT_BTN_BASE
            idx = m_poolCtlIndex(slot)
            If idx >= 0 Then
                If UCase$(Trim$(m_formLayout.Ctls(idx).CtlName)) = UCase$(Trim$(ctlName)) Then
                    Set lstObj = PoolListBox(slot - FC_SLOT_LST_BASE)
                    If Not lstObj Is Nothing Then
                        On Error Resume Next
                        lstObj.ListIndex = itemIndex
                        On Error GoTo 0
                    End If
                    Exit Sub
                End If
            End If
        Next slot
    End Sub

    Public Function GetListBoxSelectedIndex(ByVal ctlName As String) As Long
        Dim slot As Long
        Dim idx As Long
        Dim lstObj As ListBox

        GetListBoxSelectedIndex = -1
        For slot = FC_SLOT_LST_BASE + 1 To FC_SLOT_BTN_BASE
            idx = m_poolCtlIndex(slot)
            If idx >= 0 Then
                If UCase$(Trim$(m_formLayout.Ctls(idx).CtlName)) = UCase$(Trim$(ctlName)) Then
                    Set lstObj = PoolListBox(slot - FC_SLOT_LST_BASE)
                    If Not lstObj Is Nothing Then
                        On Error Resume Next
                        GetListBoxSelectedIndex = lstObj.ListIndex
                        On Error GoTo 0
                    End If
                    Exit Function
                End If
            End If
        Next slot
    End Function

    Public Sub SetControlFocus(ByVal ctlName As String)
        Dim slot As Long
        Dim idx As Long
        Dim ctlObj As Object

        For slot = 1 To FC_SLOT_TOTAL
            idx = m_poolCtlIndex(slot)
            If idx >= 0 Then
                If UCase$(Trim$(m_formLayout.Ctls(idx).CtlName)) = UCase$(Trim$(ctlName)) Then
                    Set ctlObj = PoolControlBySlot(slot)
                    If Not ctlObj Is Nothing Then
                        On Error Resume Next
                        ctlObj.SetFocus
                        On Error GoTo 0
                    End If
                    Exit Sub
                End If
            End If
        Next slot
    End Sub

    Public Sub SetControlEnabled(ByVal ctlName As String, ByVal isEnabled As Boolean)
        Dim slot As Long
        Dim idx As Long
        Dim ctlObj As Object

        For slot = 1 To FC_SLOT_TOTAL
            idx = m_poolCtlIndex(slot)
            If idx >= 0 Then
                If UCase$(Trim$(m_formLayout.Ctls(idx).CtlName)) = UCase$(Trim$(ctlName)) Then
                    Set ctlObj = PoolControlBySlot(slot)
                    If Not ctlObj Is Nothing Then
                        On Error Resume Next
                        ctlObj.Enabled = isEnabled
                        On Error GoTo 0
                    End If
                    Exit Sub
                End If
            End If
        Next slot
    End Sub

End Class
