    Private Sub PlaceRibbonButton(ByRef btn As CommandButton, ByRef curLeft As Long, ByVal btnWidth As Long, ByVal btnCaption As String)
        On Error Resume Next
        btn.Caption = btnCaption
        btn.Left = curLeft
        btn.Top = 38
        btn.Width = btnWidth
        btn.Height = 34
        btn.Enabled = True
        btn.Visible = True
        btn.ZOrder 0
        curLeft = curLeft + btnWidth + 6
        On Error GoTo 0
    End Sub

    Public Sub UpdateRibbonToolbar(ByVal activeContext As String)
        Dim curLeft As Long
        curLeft = 12
        m_currentRibbonContext = UCase$(Trim$(activeContext))
        HideAllRibbonButtons

        Select Case m_currentRibbonContext
            Case "TABLE", "HOME"
                PlaceRibbonButton btnToggleDesign, curLeft, 98, "Design View"
                PlaceRibbonButton btnDeleteRecord, curLeft, 80, "Delete [X]"
                PlaceRibbonButton btnSortFilter, curLeft, 102, "Sort A-Z / Z-A"
                PlaceRibbonButton btnFindReplace, curLeft, 96, "Find / Replace"
                PlaceRibbonButton btnTotalsRow, curLeft, 94, "Totals [Sigma]"
                PlaceRibbonButton btnSubdatasheet, curLeft, 104, "Subdatasheet [+]"
                PlaceRibbonButton btnRelationships, curLeft, 102, "Relations [Rel]"
                PlaceRibbonButton btnModifySchema, curLeft, 106, "Modify Schema"
                PlaceRibbonButton btnSaveObject, curLeft, 92, "Save Object"

            Case "QUERY"
                PlaceRibbonButton btnQryDatasheet, curLeft, 110, "Datasheet View"
                PlaceRibbonButton btnQryDesign, curLeft, 100, "Design View"
                PlaceRibbonButton btnQrySql, curLeft, 90, "SQL View"
                PlaceRibbonButton btnRunQuery, curLeft, 110, "Run Query (!)"
                PlaceRibbonButton btnQbeDesign, curLeft, 110, "QBE Design"
                PlaceRibbonButton btnQueryBuilder, curLeft, 115, "Query Builder"
                PlaceRibbonButton btnCrossTab, curLeft, 110, "CrossTab [XTab]"
                PlaceRibbonButton btnSaveObject, curLeft, 100, "Save Query"
                PlaceRibbonButton btnToggleDesign, curLeft, 110, "SQL / Design"

            Case "FORM"
                PlaceRibbonButton btnFormView, curLeft, 100, "Form View"
                PlaceRibbonButton btnFormDesign, curLeft, 110, "Form Design"
                PlaceRibbonButton btnCreateFormWiz, curLeft, 100, "+ New Form"
                btnCreateFormWiz.Enabled = False
                PlaceRibbonButton btnAddCtrlWiz, curLeft, 95, "+ Control"
                btnAddCtrlWiz.Enabled = False
                PlaceRibbonButton btnSaveFormRec, curLeft, 125, "Save Form Record"
                PlaceRibbonButton btnNewFormRec, curLeft, 120, "+ New Record"
                PlaceRibbonButton btnVbaEditor, curLeft, 125, "View Code (VBE)"
                PlaceRibbonButton btnSaveObject, curLeft, 100, "Save Form"

            Case "MODULE"
                PlaceRibbonButton btnRunVbaCode, curLeft, 110, "Run Sub [F5]"
                PlaceRibbonButton btnSaveVbaCode, curLeft, 115, "Save Module"
                PlaceRibbonButton btnFormView, curLeft, 105, "Form View"
                PlaceRibbonButton btnToggleDesign, curLeft, 110, "Datasheet View"

            Case "FILE"
                PlaceRibbonButton btnNewDb, curLeft, 110, "New (Template)"
                btnNewDb.Enabled = False
                PlaceRibbonButton btnOpenDb, curLeft, 95, "Open DB..."
                PlaceRibbonButton btnCloseDb, curLeft, 85, "Close DB"
                PlaceRibbonButton btnBackup, curLeft, 105, "Backup [Bak]"
                btnBackup.Enabled = False
                PlaceRibbonButton btnCompact, curLeft, 155, "Compact & Repair (Trial)"
                PlaceRibbonButton btnHealth, curLeft, 110, "Diagnostics"
                PlaceRibbonButton btnThemeToggle, curLeft, 100, btnThemeToggle.Caption

            Case "CREATE"
                PlaceRibbonButton btnNewTable, curLeft, 105, "New Table [*]"
                PlaceRibbonButton btnToggleDesign, curLeft, 110, "Table Design"
                PlaceRibbonButton btnQbeDesign, curLeft, 165, "Query Design - New Query"
                PlaceRibbonButton btnCreateFormWiz, curLeft, 100, "+ Form Wizard"
                btnCreateFormWiz.Enabled = False
                PlaceRibbonButton btnAddCtrlWiz, curLeft, 95, "+ Control"
                btnAddCtrlWiz.Enabled = False
                PlaceRibbonButton btnReport, curLeft, 115, "Report Wizard"
                btnReport.Enabled = False
                PlaceRibbonButton btnMacro, curLeft, 105, "Macro Wizard"
                btnMacro.Enabled = False
                PlaceRibbonButton btnSaveObject, curLeft, 100, "Save Object"

            Case "EXTERNAL"
                PlaceRibbonButton btnImportData, curLeft, 125, "Import [CSV/SQL]"
                btnImportData.Enabled = False
                PlaceRibbonButton btnExportCsv, curLeft, 105, "Export CSV"
                btnExportCsv.Enabled = False
                PlaceRibbonButton btnExportJson, curLeft, 105, "Export JSON"
                btnExportJson.Enabled = False
                PlaceRibbonButton btnPrintHtml, curLeft, 115, "Print/PDF [Doc]"
                btnPrintHtml.Enabled = False
                PlaceRibbonButton btnLinkedTables, curLeft, 115, "Linked Tables"
                btnLinkedTables.Enabled = False

            Case "TOOLS"
                PlaceRibbonButton btnRelationships, curLeft, 115, "Relations [Rel]"
                PlaceRibbonButton btnDiagram, curLeft, 110, "ERD Map [Map]"
                PlaceRibbonButton btnDocumenter, curLeft, 140, "Documenter/Analyze"
                PlaceRibbonButton btnMacro, curLeft, 105, "Run Macro"
                PlaceRibbonButton btnVbaEditor, curLeft, 120, "VBA / Immediate"

            Case Else
                PlaceRibbonButton btnToggleDesign, curLeft, 110, "Design View"
                PlaceRibbonButton btnDeleteRecord, curLeft, 85, "Delete [X]"
                PlaceRibbonButton btnSortFilter, curLeft, 115, "Sort A-Z / Z-A"
                PlaceRibbonButton btnFindReplace, curLeft, 105, "Find / Replace"
                PlaceRibbonButton btnTotalsRow, curLeft, 105, "Totals [Sigma]"
                PlaceRibbonButton btnSaveObject, curLeft, 100, "Save Object"
        End Select

        If StudioController.IsRuntimeMode Then
            btnToggleDesign.Visible = False
            btnModifySchema.Visible = False
            btnQryDesign.Visible = False
            btnQbeDesign.Visible = False
            btnQueryBuilder.Visible = False
            btnFormDesign.Visible = False
            btnCreateFormWiz.Visible = False
            btnAddCtrlWiz.Visible = False
            btnVbaEditor.Visible = False
            btnNewTable.Visible = False
            btnRibbonCreate.Visible = False
            btnRibbonDbTools.Visible = False
        End If
    End Sub

    ' -------------------------------------------------------------------------
    ' Dedicated Mode-Switched Workspace Surfaces Engine
    ' -------------------------------------------------------------------------
    Public Sub SwitchWorkspaceMode(ByVal mode As Long)
        If (m_currentWorkspaceMode = 0 Or m_currentWorkspaceMode = 11) And mode <> m_currentWorkspaceMode Then
            If m_dsEditActive Then CommitDatasheetCellEdit
            If m_dsRecordDirty Then SaveDatasheetRecord
        End If
        m_currentWorkspaceMode = mode
        StudioController.SetViewMode mode
        ' The Query view switches only target a query while a Query view (11..13) is shown
        If mode < 11 Or mode > 13 Then m_activeQueryName = vbNullString

        On Error Resume Next
        ' Hide the Native Form View / Query View render surfaces (modes 10..13) and restore the default nav bar
        HideRenderSurfaces

        ' Hide all Form-specific detail controls
        lblFormSection.Visible = False
        lblFormFld1.Visible = False
        txtFormFld1.Visible = False
        lblFormFld2.Visible = False
        txtFormFld2.Visible = False
        lblFormFld3.Visible = False
        txtFormFld3.Visible = False
        lblFormFld4.Visible = False
        txtFormFld4.Visible = False
        lblFormFld5.Visible = False
        txtFormFld5.Visible = False
        btnLookupDrop.Visible = False
        btnFormCmd.Visible = False
        lblLookupHint.Visible = False
        btnSaveFormRec.Visible = False
        btnNewFormRec.Visible = False

        ' Hide VBE code controls
        lblVbeHeader.Visible = False
        txtVbeObj.Visible = False
        txtVbeProc.Visible = False
        txtVbaCode.Visible = False
        lstVbaCode.Visible = False
        lblPropHeader.Visible = False
        lstPropSheet.Visible = False

        ' Position elements according to mode
        Select Case mode
            Case 0  ' Mode 0: Table Datasheet View (virtual grid + nav bar, Plan 7 WS1)
                lblTableTitle.Visible = True
                lblGridHeader.Visible = False
                lstRecords.Visible = False
                m_editorVisible = False

                picDatasheet.Left = 238
                picDatasheet.Top = 104
                picDatasheet.Width = 954
                picDatasheet.Height = 522
                picDatasheet.Visible = True
                vsbDatasheet.Left = 1192
                vsbDatasheet.Top = 104
                vsbDatasheet.Height = 522
                vsbDatasheet.Visible = True

            Case 5, 9  ' Mode 5: Subdatasheet / Mode 9: QBE Query Results
                lblTableTitle.Visible = True
                lblGridHeader.Visible = True
                lblGridHeader.Caption = "Datasheet Grid:"
                lstRecords.Visible = True
                lstRecords.Left = 238
                lstRecords.Top = 126
                lstRecords.Width = 970
                lstRecords.Height = 496
                m_editorVisible = False
                LayoutRecordEditorPanel

            Case 8  ' Mode 8: Visual Relationships Diagram (Upper ERD Canvas + Lower Relationship Manager)
                lblTableTitle.Visible = True
                m_editorVisible = False
                LayoutRecordEditorPanel

                picQryTables.Left = 238
                picQryTables.Top = 104
                picQryTables.Width = 774
                picQryTables.Height = 250
                picQryTables.Visible = True

                lblPropHeader.Left = 1016
                lblPropHeader.Top = 104
                lblPropHeader.Width = 192
                lblPropHeader.Height = 22
                lblPropHeader.Caption = "Add Tables (Dbl-Click):"
                lblPropHeader.Visible = True

                lstPropSheet.Left = 1016
                lstPropSheet.Top = 126
                lstPropSheet.Width = 192
                lstPropSheet.Height = 228
                lstPropSheet.Visible = True
                PopulateQueryAddTablesPane

                lblGridHeader.Visible = True
                lblGridHeader.Left = 238
                lblGridHeader.Top = 360
                lblGridHeader.Caption = "Active Relationships (Drag fields between tables above to link, or Dbl-Click below to Add / Delete):"

                lstRecords.Visible = True
                lstRecords.Left = 238
                lstRecords.Top = 382
                lstRecords.Width = 970
                lstRecords.Height = 240
                SetNavBarVisible False

            Case 1  ' Mode 1: Table Design View (Upper Schema Grid + Lower Field Properties)
                lblTableTitle.Visible = True
                lblGridHeader.Visible = False
                lstRecords.Visible = False
                m_editorVisible = False

                picDatasheet.Left = 238
                picDatasheet.Top = 104
                picDatasheet.Width = 954
                picDatasheet.Height = 300
                picDatasheet.Visible = True

                vsbDatasheet.Left = 1192
                vsbDatasheet.Top = 104
                vsbDatasheet.Height = 300
                vsbDatasheet.Visible = True

                lblPropHeader.Left = 238
                lblPropHeader.Top = 410
                lblPropHeader.Width = 954
                lblPropHeader.Caption = "Field Properties (General / Lookup):"
                lblPropHeader.Visible = True

                lstPropSheet.Left = 238
                lstPropSheet.Top = 432
                lstPropSheet.Width = 954
                lstPropSheet.Height = 190
                lstPropSheet.Visible = True

            Case 2  ' Mode 2: Interactive Form View (Form Canvas + Bound Fields + 3D CommandButton + Lower Record Preview)
                lblTableTitle.Visible = True
                lblGridHeader.Visible = True
                lblGridHeader.Caption = "Continuous Form / Bound Record Preview:"
                lblFormSection.Visible = True
                btnFormCmd.Visible = True
                lblLookupHint.Visible = True
                btnSaveFormRec.Visible = True
                btnNewFormRec.Visible = True

                lstRecords.Visible = True
                lstRecords.Left = 238
                lstRecords.Top = 300
                lstRecords.Width = 970
                lstRecords.Height = 322

            Case 3, 6  ' Mode 3 / 6: Form Design View (Multi-Section Form Canvas + Right-Side Tabbed Property Sheet)
                lblTableTitle.Visible = True
                lblGridHeader.Visible = False
                lstRecords.Visible = False
                m_editorVisible = False

                picFormCanvas.Left = 238
                picFormCanvas.Top = 104
                picFormCanvas.Width = 638
                picFormCanvas.Height = 522
                picFormCanvas.Visible = True
                vsbFormCanvas.Left = 878
                vsbFormCanvas.Top = 104
                vsbFormCanvas.Height = 522
                vsbFormCanvas.Visible = True

                lblPropHeader.Visible = True
                lblPropHeader.Left = 896
                lblPropHeader.Top = 104
                lblPropHeader.Width = 312
                lblPropHeader.Height = 22
                lblPropHeader.Caption = "Property Sheet"
                lstPropSheet.Visible = True
                lstPropSheet.Left = 896
                lstPropSheet.Top = 128
                lstPropSheet.Width = 312
                lstPropSheet.Height = 498

            Case 4, 7  ' Mode 4: Microsoft Visual Basic (VBE) Code Editor & Immediate Window
                lblTableTitle.Visible = True
                lblTableTitle.Caption = "Microsoft Visual Basic for Applications (VBE)"
                lblGridHeader.Visible = True
                lblGridHeader.Caption = "Immediate Window / Procedure Output:"
                lblGridHeader.Left = 238
                lblGridHeader.Top = 508

                lstRecords.Visible = False

                lblVbeHeader.Visible = True
                lblVbeHeader.Left = 238
                lblVbeHeader.Top = 126
                txtVbeObj.Visible = True
                txtVbeObj.Left = 440
                txtVbeObj.Top = 124
                txtVbeProc.Visible = True
                txtVbeProc.Left = 690
                txtVbeProc.Top = 124

                txtVbaCode.Visible = True
                txtVbaCode.Left = 238
                txtVbaCode.Top = 154
                txtVbaCode.Width = 970
                txtVbaCode.Height = 470

                lstVbaCode.Visible = False

            Case 10  ' Mode 10: Native Form View (owner-drawn form canvas + control pool + Access-style nav bar)
                lblTableTitle.Visible = True
                lblGridHeader.Visible = False
                lstRecords.Visible = False
                m_editorVisible = False
                lblFormSection.Visible = False
                btnFormCmd.Visible = False
                ' Keep the FORM ribbon's "Save Form Record" button (hidden above) available
                If m_currentRibbonContext = "FORM" Then btnSaveFormRec.Visible = True

                picFormCanvas.Left = 238
                picFormCanvas.Top = 104
                picFormCanvas.Width = 954
                picFormCanvas.Height = 522
                picFormCanvas.Visible = True
                vsbFormCanvas.Left = 1192
                vsbFormCanvas.Top = 104
                vsbFormCanvas.Height = 522
                vsbFormCanvas.Visible = True

                LayoutNavBar True

            Case 11  ' Mode 11: Query Datasheet View (owner-drawn grid + shared nav bar)
                lblTableTitle.Visible = True
                lblGridHeader.Visible = False
                lstRecords.Visible = False
                m_editorVisible = False

                picDatasheet.Left = 238
                picDatasheet.Top = 104
                picDatasheet.Width = 954
                picDatasheet.Height = 522
                picDatasheet.Visible = True
                vsbDatasheet.Left = 1192
                vsbDatasheet.Top = 104
                vsbDatasheet.Height = 522
                vsbDatasheet.Visible = True

            Case 12  ' Mode 12: Query Design View (field-list boxes with join lines over the QBE grid)
                lblTableTitle.Visible = True
                lblGridHeader.Visible = False
                lstRecords.Visible = False
                m_editorVisible = False

                picQryTables.Left = 238
                picQryTables.Top = 104
                picQryTables.Width = 774
                picQryTables.Height = 240
                picQryTables.Visible = True

                lblPropHeader.Left = 1016
                lblPropHeader.Top = 104
                lblPropHeader.Width = 192
                lblPropHeader.Height = 22
                lblPropHeader.Caption = "Add Tables (Dbl-Click):"
                lblPropHeader.Visible = True

                lstPropSheet.Left = 1016
                lstPropSheet.Top = 126
                lstPropSheet.Width = 192
                lstPropSheet.Height = 218
                lstPropSheet.Visible = True
                PopulateQueryAddTablesPane

                picQbeGrid.Left = 238
                picQbeGrid.Top = 350
                picQbeGrid.Width = 970
                picQbeGrid.Height = 272
                picQbeGrid.Visible = True
                ' Access Design View has no record navigation bar
                SetNavBarVisible False

            Case 13  ' Mode 13: Query SQL View (multi-line SQL editor)
                lblTableTitle.Visible = True
                lblGridHeader.Visible = False
                lstRecords.Visible = False
                m_editorVisible = False

                txtSqlView.Left = 238
                txtSqlView.Top = 104
                txtSqlView.Width = 970
                txtSqlView.Height = 518
                txtSqlView.Visible = True
                ' Access SQL View has no record navigation bar
                SetNavBarVisible False

            Case Else
                lblTableTitle.Visible = True
                lblGridHeader.Visible = True
                lstRecords.Visible = True
                lstRecords.Left = 238
                lstRecords.Top = 126
                lstRecords.Width = 970
                lstRecords.Height = 496
        End Select
        ApplyResponsiveLayout
        On Error GoTo 0
    End Sub

    ' Hides every Native Form View / Query View render surface (modes 10..13), the Form View
    ' control pool (fcTxt01..24, fcCbo01..08, fcBtn01..08, fcChk01..08), the subform surfaces
    ' (picSub01..02 / vsbSub01..02) and the Form View nav additions, then restores the
    ' default nav bar geometry so modes 0..9 look exactly as they did before.
    ' Explicit per-control lines (no control arrays exist); counts mirror FC_POOL_* consts.
    Private Sub HideRenderSurfaces()
        On Error Resume Next
        picFormCanvas.Visible = False
        vsbFormCanvas.Visible = False
        picDatasheet.Visible = False
        vsbDatasheet.Visible = False
        picQryTables.Visible = False
        picQbeGrid.Visible = False
        txtSqlView.Visible = False

        ' TextBox pool (FC_POOL_TXT = 24)
        fcTxt01.Visible = False: fcTxt02.Visible = False: fcTxt03.Visible = False: fcTxt04.Visible = False
        fcTxt05.Visible = False: fcTxt06.Visible = False: fcTxt07.Visible = False: fcTxt08.Visible = False
        fcTxt09.Visible = False: fcTxt10.Visible = False: fcTxt11.Visible = False: fcTxt12.Visible = False
        fcTxt13.Visible = False: fcTxt14.Visible = False: fcTxt15.Visible = False: fcTxt16.Visible = False
        fcTxt17.Visible = False: fcTxt18.Visible = False: fcTxt19.Visible = False: fcTxt20.Visible = False
        fcTxt21.Visible = False: fcTxt22.Visible = False: fcTxt23.Visible = False: fcTxt24.Visible = False

        ' ComboBox pool (FC_POOL_CBO = 8)
        fcCbo01.Visible = False: fcCbo02.Visible = False: fcCbo03.Visible = False: fcCbo04.Visible = False
        fcCbo05.Visible = False: fcCbo06.Visible = False: fcCbo07.Visible = False: fcCbo08.Visible = False

        ' ListBox pool (FC_POOL_LST = 4)
        fcLst01.Visible = False: fcLst02.Visible = False: fcLst03.Visible = False: fcLst04.Visible = False

        ' CommandButton pool (FC_POOL_BTN = 8)
        fcBtn01.Visible = False: fcBtn02.Visible = False: fcBtn03.Visible = False: fcBtn04.Visible = False
        fcBtn05.Visible = False: fcBtn06.Visible = False: fcBtn07.Visible = False: fcBtn08.Visible = False

        ' CheckBox pool (FC_POOL_CHK = 8)
        fcChk01.Visible = False: fcChk02.Visible = False: fcChk03.Visible = False: fcChk04.Visible = False
        fcChk05.Visible = False: fcChk06.Visible = False: fcChk07.Visible = False: fcChk08.Visible = False

        ' Subform surfaces (FC_POOL_SUB = 2)
        m_relDialogActive = False
        picSub01.Visible = False: vsbSub01.Visible = False
        picSub02.Visible = False: vsbSub02.Visible = False
        CloseSubformRecordsets

        LayoutNavBar False
        SetNavBarVisible True
        On Error GoTo 0
    End Sub

    ' Shows or hides the shared record navigation bar (|< < [N] of M > >| and the active-row
    ' label). Visible in every mode except Query Design View (12) and Query SQL View (13),
    ' which have no record navigation in Access. lblNavRecord / btnNavNew are owned by LayoutNavBar.
    Private Sub SetNavBarVisible(ByVal makeVisible As Boolean)
        On Error Resume Next
        btnFirst.Visible = makeVisible
        btnPrev.Visible = makeVisible
        txtRecordPos.Visible = makeVisible
        lblOfTotal.Visible = makeVisible
        btnNext.Visible = makeVisible
        btnLast.Visible = makeVisible
        lblActiveRow.Visible = makeVisible
        If Not makeVisible Then
            lblNavRecord.Visible = False
            btnNavNew.Visible = False
        End If
        On Error GoTo 0
    End Sub

    ' Positions the shared record navigation bar (Y = 632).
    ' formView = False: default tbform geometry used by modes 0..9 and 11..13; lblNavRecord and btnNavNew hidden.
    ' formView = True : Access Form View layout "Record: |< < [N] of M > >| >*" (mode 10); every
    '                   control shifts right by the lblNavRecord width + gap (48 px).
    Private Sub LayoutNavBar(ByVal formView As Boolean)
        Dim dx As Single
        On Error Resume Next
        If formView Then dx = 48 Else dx = 0

        lblNavRecord.Left = 238
        lblNavRecord.Top = 636
        lblNavRecord.Visible = formView

        btnFirst.Left = 238 + dx
        btnPrev.Left = 278 + dx
        txtRecordPos.Left = 318 + dx
        lblOfTotal.Left = 368 + dx
        btnNext.Left = 432 + dx
        btnLast.Left = 472 + dx

        btnNavNew.Left = 512 + dx
        btnNavNew.Top = 632
        btnNavNew.Visible = formView

        lblActiveRow.Left = 560 + dx
        lblActiveRow.Width = 688 - dx
        ApplyResponsiveLayout
        On Error GoTo 0
    End Sub

    ' -------------------------------------------------------------------------
    ' Phase 17: Office-Style Ribbon Tabs & Dark/Light Theme Engine
    ' -------------------------------------------------------------------------
    Private Sub btnRibbonFile_Click()
        StudioController.SetRibbonTab 1
        UpdateRibbonToolbar "FILE"
        lblStatus.Caption = "Ribbon [File]: New Database (Template), Open Database, Close, Backup, Compact & Repair, Diagnostics."
    End Sub

    Private Sub btnRibbonHome_Click()
        StudioController.SetRibbonTab 2
        If Len(StudioController.GetActiveFormName()) > 0 Then
            UpdateRibbonToolbar "FORM"
        ElseIf Len(StudioController.GetActiveModuleName()) > 0 Then
            UpdateRibbonToolbar "MODULE"
        ElseIf InStr(1, StudioController.GetActiveTableName(), "Query", vbTextCompare) > 0 Then
            UpdateRibbonToolbar "QUERY"
        Else
            UpdateRibbonToolbar "TABLE"
        End If
    End Sub

