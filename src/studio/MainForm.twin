    Private Sub fcCbo01_Click()
        If m_currentWorkspaceMode = 0 Or m_currentWorkspaceMode = 11 Then
            If m_dsEditActive And fcCbo01.Visible And fcCbo01.ListIndex >= 0 Then
                fcCbo01.Text = fcCbo01.List(fcCbo01.ListIndex)
                CommitDatasheetCellEdit
            End If
            Exit Sub
        End If
        If m_currentWorkspaceMode = 12 Then
            If fcCbo01.ListIndex >= 0 Then fcCbo01.Text = fcCbo01.List(fcCbo01.ListIndex)
            CommitQbeCellEdit
            Exit Sub
        End If
        If m_currentWorkspaceMode = 1 Then
            If fcCbo01.ListIndex >= 0 Then fcCbo01.Text = fcCbo01.List(fcCbo01.ListIndex)
            CommitTableDesignCellEdit
            Exit Sub
        End If
        OnPoolComboClick 1
    End Sub

    Private Sub fcCbo02_Click()
        If m_relDialogActive Then
            If fcCbo02.ListIndex >= 0 Then fcCbo02.Text = fcCbo02.List(fcCbo02.ListIndex)
            PopulateRelDialogFieldCombo fcCbo03, fcCbo02.Text, Not m_relDialogIsQbeJoin
            If Not m_relDialogIsQbeJoin Then
                PopulateRelDialogFieldCombo fcCbo05, fcCbo04.Text, False, fcCbo03.Text
            Else
                UpdateQbeJoinDialogCheckCaptions
            End If
            Exit Sub
        End If
        OnPoolComboClick 2
    End Sub

