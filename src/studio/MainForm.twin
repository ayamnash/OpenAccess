    ' -------------------------------------------------------------------------
    ' Phase 14: Visual Print / PDF Report Export
    ' -------------------------------------------------------------------------
    Private Sub btnPrintHtml_Click()
        Dim curTable As String
        Dim targetPath As String
        Dim errMsg As String
        Dim ok As Boolean

        curTable = StudioController.GetActiveTableName()
        If Not StudioController.IsDatabaseOpen() Or Len(curTable) = 0 Or curTable = "SQL Query Result" Then
            MsgBox "Please select a table to export for print/PDF.", vbInformation, "OpenAccess Studio"
            Exit Sub
        End If

        targetPath = InputBox("Enter target PDF or HTML print document path (.pdf / .html):", "Print/PDF Document Export", curTable & "_report.pdf")
        targetPath = Trim$(targetPath)
        If Len(targetPath) = 0 Then Exit Sub

        If LCase$(Right$(targetPath, 4)) = ".pdf" Then
            ok = StudioController.ExportReportToPdf(curTable, targetPath, errMsg)
        Else
            ok = StudioController.ExportReportToPrintableHtml(curTable, targetPath, errMsg)
        End If
        If ok Then
            MsgBox "Printable report created successfully at:" & vbCrLf & targetPath, vbInformation, "Report Generated"
            lblStatus.Caption = "Print report generated: " & targetPath
        Else
            MsgBox "Error generating print report: " & errMsg, vbCritical, "Print Error"
        End If
    End Sub

    ' -------------------------------------------------------------------------
    ' Phase 15: CrossTab Query Builder
    ' -------------------------------------------------------------------------
    Private Sub btnCrossTab_Click()
        Dim curTable As String
        Dim rowHdr As String
        Dim colHdr As String
        Dim valCol As String
        Dim aggFn As String
        Dim crossSql As String

        If Not StudioController.IsDatabaseOpen() Then
            MsgBox "Please open a database first.", vbInformation, "OpenAccess Studio"
            Exit Sub
        End If

        curTable = StudioController.GetActiveTableName()
        If Len(curTable) = 0 Or curTable = "SQL Query Result" Then
            curTable = "Employees"
        End If

        curTable = InputBox("CrossTab - Source Table:", "CrossTab Query Wizard (1/5)", curTable)
        If Len(Trim$(curTable)) = 0 Then Exit Sub

        rowHdr = InputBox("CrossTab - Row Heading Column (GROUP BY):", "CrossTab Query Wizard (2/5)", "Department")
        If Len(Trim$(rowHdr)) = 0 Then Exit Sub

        colHdr = InputBox("CrossTab - Column Heading Column (PIVOT):", "CrossTab Query Wizard (3/5)", "JobTitle")
        If Len(Trim$(colHdr)) = 0 Then Exit Sub

        valCol = InputBox("CrossTab - Summary Value Column:", "CrossTab Query Wizard (4/5)", "EmployeeID")
        If Len(Trim$(valCol)) = 0 Then Exit Sub

        aggFn = InputBox("CrossTab - Aggregate Function (COUNT, SUM, AVG):", "CrossTab Query Wizard (5/5)", "COUNT")
        If Len(Trim$(aggFn)) = 0 Then aggFn = "COUNT"

        crossSql = StudioController.BuildCrossTabSql(curTable, rowHdr, colHdr, valCol, aggFn)
        txtSql.Text = StudioController.FormatSqlForDisplay(crossSql, True)
        lblStatus.Caption = "CrossTab SQL generated into query box."

        If MsgBox("Generated CrossTab SQL:" & vbCrLf & crossSql & vbCrLf & vbCrLf & "Execute this CrossTab matrix query now?", vbYesNo + vbQuestion, "Run CrossTab?") = vbYes Then
            btnRunSql_Click
        End If
    End Sub

    ' -------------------------------------------------------------------------
    ' Phase 16: External Data Integration & Linked Tables
    ' -------------------------------------------------------------------------
    Private Sub btnLinkedTables_Click()
        Dim linkedList As Collection
        Dim errMsg As String
        Dim itemVal As Variant
        Dim msgInfo As String
        Dim userAction As VbMsgBoxResult

        If Not StudioController.IsDatabaseOpen() Then
            MsgBox "Please open a database first.", vbInformation, "OpenAccess Studio"
            Exit Sub
        End If

        Set linkedList = StudioController.GetLinkedTableNames()
        msgInfo = "Active Linked Tables in this database (" & CStr(linkedList.Count) & "):" & vbCrLf
        For Each itemVal In linkedList
            msgInfo = msgInfo & " * " & CStr(itemVal) & vbCrLf
        Next itemVal

        userAction = MsgBox(msgInfo & vbCrLf & "Would you like to link a new external table from another Access database?", vbYesNo + vbQuestion, "Linked Table Manager")
        If userAction = vbYes Then
            Dim localTbl As String
            Dim extDb As String
            Dim extTbl As String
            Dim ok As Boolean

            localTbl = InputBox("Enter local name for the linked table:", "Link External Table (1/3)", "RemoteTable1")
            If Len(Trim$(localTbl)) = 0 Then Exit Sub

            extDb = InputBox("Enter absolute file path of external .accdb or .mdb database:", "Link External Table (2/3)", "F:\NEW_MSACCESS\tests\fixtures\company.accdb")
            If Len(Trim$(extDb)) = 0 Then Exit Sub

            extTbl = InputBox("Enter table name inside the external database to link:", "Link External Table (3/3)", "Departments")
            If Len(Trim$(extTbl)) = 0 Then Exit Sub

            ok = StudioController.LinkExternalAccessTable(localTbl, extDb, extTbl, errMsg)
            If ok Then
                MsgBox "Table [" & localTbl & "] successfully linked to [" & extDb & "] -> [" & extTbl & "]!", vbInformation, "Link Complete"
                RefreshNavigationPane
            Else
                MsgBox "Error linking table: " & errMsg, vbCritical, "Link Error"
            End If
        End If
    End Sub

