    ' -------------------------------------------------------------------------
    ' Phase 20: VBA Module Editor & Immediate Expression Evaluator
    ' -------------------------------------------------------------------------
    Private Sub btnVbaEditor_Click()
        Dim targetMod As String
        If StudioController.IsNativeFormActive() Then
            targetMod = "Form_" & StudioController.GetActiveFormName()
        ElseIf StudioController.IsNativeModuleActive() Then
            targetMod = StudioController.GetActiveModuleName()
        Else
            Dim mods As Collection
            Set mods = StudioController.GetCustomObjectNames("MODULE")
            If Not mods Is Nothing Then
                If mods.Count > 0 Then targetMod = CStr(mods(1))
            End If
            If Len(targetMod) = 0 Then
                Dim curTable As String
                curTable = StudioController.GetActiveTableName()
                If Len(curTable) = 0 Or curTable = "SQL Query Result" Then curTable = "Database"
                targetMod = "Mod_" & curTable
            End If
        End If
        StudioController.SetViewMode 9
        UpdateRibbonToolbar "MODULE"
        SwitchWorkspaceMode 4
        DisplayVbaModuleView targetMod
    End Sub

    Private Sub DisplayVbaModuleView(ByVal moduleName As String)
        Dim lines As Collection
        Dim errMsg As String
        Dim itemVal As Variant

        lblTableTitle.Caption = "Microsoft Visual Basic for Applications (VBE): [" & moduleName & "]"
        lblGridHeader.Caption = "VBE Code & Immediate Window Inspector: [" & moduleName & "] (Editable in VBE Pane on Right)"
        lstRecords.Clear

        Set lines = StudioController.GetVbaModuleEditorLines(moduleName, errMsg)
        For Each itemVal In lines
            lstRecords.AddItem CStr(itemVal)
        Next itemVal

        SyncVisualFormControlsAndVbe
        lblStatus.Caption = "Viewing VBA Module [" & moduleName & "] in VBE Code Editor. Click 'Run VBA [F5]' to execute."
    End Sub

    Private Sub btnEvalExpr_Click()
        Dim exprInput As String
        Dim defaultExpr As String
        Dim curTable As String
        Dim evalOut As String
        Dim errMsg As String
        Dim ok As Boolean

        curTable = StudioController.GetActiveTableName()
        If Len(curTable) = 0 Or curTable = "SQL Query Result" Then curTable = "Customers"

        defaultExpr = Trim$(txtSql.Text)
        If Left$(UCase$(defaultExpr), 7) = "SELECT " Or Len(defaultExpr) = 0 Then
            defaultExpr = "DCount(""*"", """ & curTable & """)"
        End If

        exprInput = InputBox("Enter Access / VBA Expression or Domain Aggregate (DLookup, DCount, DSum, DAvg, DMin, DMax, IIf):", "Immediate Window - Evaluate Expression", defaultExpr)
        exprInput = Trim$(exprInput)
        If Len(exprInput) = 0 Then Exit Sub

        ok = StudioController.EvaluateAccessExpression(exprInput, evalOut, errMsg)
        If ok Then
            lblStatus.Caption = "Immediate Result: " & exprInput & " ==> " & evalOut
            If StudioController.GetViewMode() = 9 Then
                DisplayVbaModuleView "Mod_" & curTable
            End If
            MsgBox "Expression: " & exprInput & vbCrLf & "Result: " & evalOut, vbInformation, "Immediate Window Result"
        Else
            MsgBox "Expression evaluation error: " & errMsg, vbExclamation, "Immediate Window"
        End If
    End Sub

    ' -------------------------------------------------------------------------
    ' Phase 22: Database Documenter, Object Dependencies & Table Analyzer
    ' -------------------------------------------------------------------------
    Private Sub btnDocumenter_Click()
        Dim toolChoice As String
        Dim curTable As String
        Dim lines As Collection
        Dim errMsg As String
        Dim itemVal As Variant

        If Not StudioController.IsDatabaseOpen() Then
            MsgBox "Please open a database first.", vbInformation, "OpenAccess Studio"
            Exit Sub
        End If

        curTable = StudioController.GetActiveTableName()
        If Len(curTable) = 0 Or curTable = "SQL Query Result" Then curTable = "Customers"

        toolChoice = InputBox("Database Tools & Analysis:" & vbCrLf & "1 = Full Database Documenter" & vbCrLf & "2 = Object Dependencies Tracker" & vbCrLf & "3 = Table & Performance Analyzer", "Database Tools", "1")
        toolChoice = Trim$(toolChoice)
        If Len(toolChoice) = 0 Then Exit Sub

        lstRecords.Clear
        If toolChoice = "1" Then
            lblTableTitle.Caption = "Database Documenter Specification"
            Set lines = StudioController.GetDatabaseDocumenterLines(errMsg)
        ElseIf toolChoice = "2" Then
            curTable = InputBox("Enter object name to inspect dependencies:", "Object Dependencies", curTable)
            If Len(Trim$(curTable)) = 0 Then Exit Sub
            lblTableTitle.Caption = "Object Dependencies: [" & curTable & "]"
            Set lines = StudioController.GetObjectDependenciesLines(Trim$(curTable), errMsg)
        ElseIf toolChoice = "3" Then
            curTable = InputBox("Enter table name to analyze:", "Table & Performance Analyzer", curTable)
            If Len(Trim$(curTable)) = 0 Then Exit Sub
            lblTableTitle.Caption = "Table Analyzer Diagnostic: [" & curTable & "]"
            Set lines = StudioController.GetTableAnalyzerLines(Trim$(curTable), errMsg)
        Else
            Exit Sub
        End If

        If Len(errMsg) > 0 Then
            lstRecords.AddItem "Analysis Error: " & errMsg
        Else
            For Each itemVal In lines
                lstRecords.AddItem CStr(itemVal)
            Next itemVal
            lblStatus.Caption = "Completed database analysis tool."
        End If
    End Sub

    ' -------------------------------------------------------------------------
    ' Phase 23: Datasheet Power Tools (Sort, Filter, Find & Replace, Totals Row)
    ' -------------------------------------------------------------------------
    Private Sub btnSortFilter_Click()
        Dim curTable As String
        Dim actionMode As String
        Dim colName As String
        Dim filterStr As String
        Dim errMsg As String
        Dim ok As Boolean

        curTable = StudioController.GetActiveTableName()
        If Not StudioController.IsDatabaseOpen() Or Len(curTable) = 0 Or curTable = "SQL Query Result" Then
            MsgBox "Please select a table in Datasheet View first.", vbInformation, "Sort & Filter"
            Exit Sub
        End If

        actionMode = InputBox("Datasheet Sort & Filter [" & curTable & "]:" & vbCrLf & "1 = Sort Ascending (A to Z)" & vbCrLf & "2 = Sort Descending (Z to A)" & vbCrLf & "3 = Apply Filter Criteria (WHERE)" & vbCrLf & "4 = Clear All Sorts & Filters", "Sort & Filter", "1")
        actionMode = Trim$(actionMode)
        If Len(actionMode) = 0 Then Exit Sub

        If actionMode = "1" Or actionMode = "2" Then
            colName = InputBox("Enter column name to sort by:", "Sort Datasheet", "ID")
            If Len(Trim$(colName)) = 0 Then Exit Sub
            ok = StudioController.SortActiveDatasheet(Trim$(colName), (actionMode = "2"), errMsg)
        ElseIf actionMode = "3" Then
            filterStr = InputBox("Enter filter criteria (e.g. ID > 1):", "Filter Datasheet", "")
            ok = StudioController.FilterActiveDatasheet(filterStr, errMsg)
        ElseIf actionMode = "4" Then
            StudioController.SortActiveDatasheet "", False, errMsg
            ok = StudioController.FilterActiveDatasheet("", errMsg)
        Else
            Exit Sub
        End If

        If ok Then
            StudioController.SetViewMode 0
            DisplayTableDatasheet curTable
        Else
            MsgBox "Sort/Filter error: " & errMsg, vbExclamation, "Sort & Filter"
        End If
    End Sub

    Private Sub btnFindReplace_Click()
        Dim curTable As String
        Dim colName As String
        Dim findTxt As String
        Dim replTxt As String
        Dim doRepl As Boolean
        Dim matchedCnt As Long
        Dim updatedCnt As Long
        Dim errMsg As String
        Dim ok As Boolean

        curTable = StudioController.GetActiveTableName()
        If Not StudioController.IsDatabaseOpen() Or Len(curTable) = 0 Or curTable = "SQL Query Result" Then
            MsgBox "Please select a table first.", vbInformation, "Find & Replace"
            Exit Sub
        End If

        colName = InputBox("Enter column name to search in [" & curTable & "]:", "Find & Replace (1/3)", "ID")
        If Len(Trim$(colName)) = 0 Then Exit Sub

        findTxt = InputBox("Enter value/text to find:", "Find & Replace (2/3)", "")
        If Len(findTxt) = 0 Then Exit Sub

        replTxt = InputBox("Enter replacement value (or leave blank to Find only):", "Find & Replace (3/3)", "")
        doRepl = (Len(replTxt) > 0)

        ok = StudioController.FindAndReplaceInTable(curTable, Trim$(colName), findTxt, replTxt, doRepl, matchedCnt, updatedCnt, errMsg)
        If ok Then
            If doRepl Then
                DisplayTableDatasheet curTable
                MsgBox "Find & Replace completed!" & vbCrLf & "Matches found: " & CStr(matchedCnt) & vbCrLf & "Records updated: " & CStr(updatedCnt), vbInformation, "Find & Replace"
            Else
                MsgBox "Search completed!" & vbCrLf & "Matching records found: " & CStr(matchedCnt), vbInformation, "Find Results"
            End If
            lblStatus.Caption = "Find/Replace on [" & curTable & "]: " & CStr(matchedCnt) & " match(es)."
        Else
            MsgBox "Find & Replace error: " & errMsg, vbCritical, "Error"
        End If
    End Sub

    Private Sub btnTotalsRow_Click()
        Dim curTable As String
        Dim showTotals As Boolean

        curTable = StudioController.GetActiveTableName()
        If Not StudioController.IsDatabaseOpen() Or Len(curTable) = 0 Or curTable = "SQL Query Result" Then
            MsgBox "Please select a table first.", vbInformation, "Datasheet Totals Row"
            Exit Sub
        End If

        showTotals = StudioController.ToggleTotalsRow()
        If showTotals Then
            btnTotalsRow.Caption = "Hide Totals [Sigma]"
        Else
            btnTotalsRow.Caption = "Totals [Sigma]"
        End If
        StudioController.SetViewMode 0
        DisplayTableDatasheet curTable
    End Sub

    Private Sub DisplayTableDatasheet(ByVal tableName As String)
        Dim errMsg As String
        Dim ok As Boolean
        Dim rs As Object
        Dim totalsLines As Collection
        Dim itemVal As Variant

        If StudioController.IsTotalsRowActive() Then
            lblTableTitle.Caption = "Datasheet View (with Sigma Totals): [" & tableName & "]"
            lblGridHeader.Caption = "Datasheet Grid + Sigma Totals: [" & tableName & "]"
            lstRecords.Clear
            Set totalsLines = StudioController.GetDatasheetWithTotalsLines(tableName, errMsg)
            If Len(errMsg) > 0 Then
                lstRecords.AddItem "Notice: " & errMsg
            Else
                For Each itemVal In totalsLines
                    lstRecords.AddItem CStr(itemVal)
                Next itemVal
                lblStatus.Caption = "Loaded table [" & tableName & "] with Sigma Totals row."
            End If
            UpdateNavigationControls
            Exit Sub
        End If

        ok = StudioController.OpenTable(tableName, errMsg)

        m_dsQueryName = tableName
        m_activeQueryName = vbNullString
        m_dsTopRow = 0
        m_dsLkCount = 0
        Set m_dsColRs = Nothing
        m_dsColCount = 0
        m_dsAllowNew = True

        If ok Then
            Set rs = StudioController.GetCurrentRecordset()
            If Not rs Is Nothing Then
                On Error Resume Next
                m_dsAllowNew = CBool(rs.Updatable)
                If Err.Number <> 0 Then m_dsAllowNew = False
                Err.Clear
                On Error GoTo 0
            End If
        End If

        SwitchWorkspaceMode 0
        StudioController.SetViewMode 0
        btnToggleDesign.Caption = "Design View"
        lblTableTitle.Caption = "Datasheet View: [" & tableName & "]"
        txtSql.Text = "SELECT * FROM [" & tableName & "]"

        m_dsLkCount = 0
        Set m_dsColRs = Nothing
        UpdateNavigationControls
        PaintQueryDatasheet

        If ok Then
            lblStatus.Caption = "Loaded table [" & tableName & "] (" & CStr(StudioController.GetTotalRecords()) & " records) | Fast Datasheet View"
        ElseIf Len(errMsg) > 0 Then
            lblStatus.Caption = "Notice: " & errMsg
        End If
    End Sub

    ' -------------------------------------------------------------------------
    ' Phase 1 & Phase 4: Interactive SQL Query Runner
    ' -------------------------------------------------------------------------
    Private Sub btnRunQuery_Click()
        btnRunSql_Click
    End Sub

    Private Sub txtSql_KeyPress(KeyAscii As Integer)
        If KeyAscii = 13 Then
            KeyAscii = 0
            btnRunSql_Click
        End If
    End Sub

    Private Sub btnRunSql_Click()
        Dim queryText As String
        Dim errMsg As String
        Dim ok As Boolean
        Dim upperSql As String
        Dim params As Collection
        Dim paramVal As String
        Dim i As Long
        Dim pPrompts As New Collection
        Dim pVals As New Collection

        queryText = Trim$(txtSql.Text)
        If Len(queryText) = 0 Then
            MsgBox "Please enter an SQL query to execute.", vbExclamation, "Empty Query"
            Exit Sub
        End If

        ' Parameter Query Discovery: check for tokens like [Enter ...]
        Set params = StudioController.ExtractQueryParameters(queryText)
        If params.Count > 0 Then
            For i = 1 To params.Count
                paramVal = InputBox("Enter parameter value for [" & CStr(params(i)) & "]:", "Enter Parameter Value")
                pPrompts.Add CStr(params(i))
                pVals.Add paramVal
            Next i
            lblStatus.Caption = "Executing Parameterized SQL Query..."
            ok = StudioController.ExecuteParameterizedQuery(queryText, pPrompts, pVals, errMsg)
            If ok Then
                lblTableTitle.Caption = "Parameterized SQL Result"
                m_dsQueryName = "SQL Query Result"
                m_dsTopRow = 0: m_dsLkCount = 0: Set m_dsColRs = Nothing: m_dsColCount = 0: m_dsAllowNew = False
                If m_currentWorkspaceMode <> 0 And m_currentWorkspaceMode <> 11 Then SwitchWorkspaceMode 11
                UpdateNavigationControls
                PaintQueryDatasheet
                lblStatus.Caption = "Parameterized query executed successfully: " & CStr(StudioController.GetTotalRecords()) & " row(s) returned."
            Else
                lblStatus.Caption = "SQL Error: " & errMsg
                MsgBox errMsg, vbCritical, "SQL Parameter Error"
            End If
            Exit Sub
        End If

        lblStatus.Caption = "Executing SQL..."
        upperSql = UCase$(queryText)

        If Left$(upperSql, 7) = "SELECT " Or Left$(upperSql, 10) = "TRANSFORM " Then
            ok = StudioController.ExecuteSqlQuery(queryText, errMsg)
            If ok Then
                lblTableTitle.Caption = "SQL Query Result"
                m_dsQueryName = "SQL Query Result"
                m_dsTopRow = 0: m_dsLkCount = 0: Set m_dsColRs = Nothing: m_dsColCount = 0: m_dsAllowNew = False
                If m_currentWorkspaceMode <> 0 And m_currentWorkspaceMode <> 11 Then SwitchWorkspaceMode 11
                UpdateNavigationControls
                PaintQueryDatasheet
                lblStatus.Caption = "Query executed successfully: " & CStr(StudioController.GetTotalRecords()) & " row(s) returned."
            Else
                lblStatus.Caption = "SQL Error: " & errMsg
                MsgBox errMsg, vbCritical, "SQL Execution Error"
            End If
        Else
            ' Action query: INSERT, UPDATE, DELETE, CREATE TABLE, ALTER TABLE, DROP TABLE
            Dim rowsAff As Long
            ok = StudioController.ExecuteBulkActionQuery(queryText, rowsAff, errMsg)
            If ok Then
                lblStatus.Caption = "Action query executed successfully (" & CStr(rowsAff) & " records affected)."
                MsgBox "SQL action executed successfully! Records affected: " & CStr(rowsAff), vbInformation, "OpenAccess Studio"
                RefreshNavigationPane
            Else
                lblStatus.Caption = "SQL Error: " & errMsg
                MsgBox errMsg, vbCritical, "SQL Execution Error"
            End If
        End If
    End Sub

    Private Sub LoadRecordsetIntoView(ByVal rs As Object)
        Dim headerLine As String
        Dim rowLine As String
        Dim i As Long
        Dim fVal As Variant

        lstRecords.Clear
        If rs Is Nothing Then
            UpdateNavigationControls
            Exit Sub
        End If

        headerLine = ""
        For i = 0 To rs.Fields.Count - 1
            If i > 0 Then headerLine = headerLine & " | "
            headerLine = headerLine & rs.Fields(i).Name
        Next i
        lstRecords.AddItem "[ " & headerLine & " ]"
        lstRecords.AddItem String$(80, "-")

        Do Until rs.EOF
            rowLine = ""
            For i = 0 To rs.Fields.Count - 1
                If i > 0 Then rowLine = rowLine & " | "
                fVal = rs.Fields(i).Value
                If IsNull(fVal) Then
                    rowLine = rowLine & "<NULL>"
                Else
                    rowLine = rowLine & CStr(fVal)
                End If
            Next i
            lstRecords.AddItem rowLine
            rs.MoveNext
        Loop
        On Error Resume Next
        rs.MoveFirst
        On Error GoTo 0

        UpdateNavigationControls
    End Sub

    ' -------------------------------------------------------------------------
    ' Phase 2 & Phase 23: CRUD Data Operations (Insert, In-Place Edit, Delete)
    ' -------------------------------------------------------------------------
        Private Sub btnAddRecord_Click()
        If Not StudioController.IsDatabaseOpen() Then
            MsgBox "Please open a database first.", vbInformation, "OpenAccess Studio"
            Exit Sub
        End If

        If m_currentWorkspaceMode = 0 Or m_currentWorkspaceMode = 11 Then
            StartDatasheetCellEdit -1, m_dsRecords
            lblStatus.Caption = "Entering new record directly in datasheet grid."
            Exit Sub
        End If

        If m_currentWorkspaceMode = 10 Then
            btnNewFormRec_Click
            Exit Sub
        End If
    End Sub

    Private Sub btnEditRecord_Click()
        Dim curRow As Long
        If Not StudioController.IsDatabaseOpen() Then
            MsgBox "Please open a database first.", vbInformation, "OpenAccess Studio"
            Exit Sub
        End If

        If m_currentWorkspaceMode = 0 Or m_currentWorkspaceMode = 11 Then
            curRow = GetFormCurrentRow(m_dsRecords)
            StartDatasheetCellEdit -1, curRow
            lblStatus.Caption = "Editing record in datasheet grid."
            Exit Sub
        End If

        m_editorVisible = True
        LayoutRecordEditorPanel
    End Sub

    Private Sub btnDeleteRecord_Click()
        Dim curTable As String
        Dim confirmRes As VbMsgBoxResult
        Dim rs As Object
        Dim errMsg As String

        If Not StudioController.IsDatabaseOpen() Then
            MsgBox "Please open a database first.", vbInformation, "OpenAccess Studio"
            Exit Sub
        End If

        curTable = StudioController.GetActiveTableName()
        If Len(curTable) = 0 Or curTable = "SQL Query Result" Then
            MsgBox "Please select an active table first.", vbInformation, "OpenAccess Studio"
            Exit Sub
        End If

        confirmRes = MsgBox("Are you sure you want to delete the selected record?", vbYesNo + vbQuestion, "Confirm Delete")
        If confirmRes <> vbYes Then Exit Sub

        Set rs = StudioController.GetCurrentRecordset()
        If Not rs Is Nothing Then
            On Error Resume Next
            rs.Delete
            If Err.Number <> 0 Then
                errMsg = Err.Description
                MsgBox "Error deleting record: " & errMsg, vbCritical, "Delete Error"
                Err.Clear
            Else
                lblStatus.Caption = "Record deleted successfully."
                If m_currentWorkspaceMode = 11 Then
                    DisplayQueryDatasheet curTable
                Else
                    DisplayTableDatasheet curTable
                End If
            End If
            On Error GoTo 0
        End If
    End Sub

    ' -------------------------------------------------------------------------
    ' Phase 4: Schema DDL (Create Table Wizard)
    ' -------------------------------------------------------------------------
    Private Sub btnNewTable_Click()
        If Not StudioController.IsDatabaseOpen() Then
            MsgBox "Please open a database first.", vbInformation, "OpenAccess Studio"
            Exit Sub
        End If

        Dim newTblName As String
        newTblName = GetNextAvailableTableName()
        StartNewVisualTableDesigner newTblName
    End Sub

    ' -------------------------------------------------------------------------
    ' Phase 1: Record Navigation Bar Controls
    ' -------------------------------------------------------------------------
    Private Sub UpdateNavigationControls()
        Dim curIdx As Long
        Dim totRecs As Long
        Dim atNew As Boolean
        Dim hasRecs As Boolean

        curIdx = StudioController.GetCurrentRecordIndex()
        totRecs = StudioController.GetTotalRecords()

        Select Case m_currentWorkspaceMode
            Case 10
                ' Native Form View nav bar: "Record: |< < [N] of M > >| >*". The (New) position
                ' (recordset at EOF, or no records) shows N = M + 1. Every move re-binds the
                ' canvas to the current record and refreshes the subforms.
                atNew = (GetFormCurrentRow(totRecs) = totRecs)
                m_formAtNew = atNew
                hasRecs = (totRecs > 0)
                lblNavRecord.Caption = "Record:"
                If atNew Then
                    txtRecordPos.Text = CStr(totRecs + 1)
                Else
                    txtRecordPos.Text = CStr(curIdx)
                End If
                lblOfTotal.Caption = "of " & CStr(totRecs)
                btnFirst.Enabled = hasRecs And (atNew Or curIdx > 1)
                btnPrev.Enabled = hasRecs And (atNew Or curIdx > 1)
                btnNext.Enabled = hasRecs And (Not atNew) And (curIdx < totRecs)
                btnLast.Enabled = hasRecs And (atNew Or curIdx < totRecs)
                btnNavNew.Enabled = m_formLayoutValid And m_formLayout.AllowAdditions And (Not atNew)
                If atNew Then
                    lblActiveRow.Caption = "Current Record: (New)"
                Else
                    lblActiveRow.Caption = "Current Record: #" & CStr(curIdx)
                End If
                If Not m_navSkipFormRebind Then RebindFormCanvas
                ' VBE / Property Sheet duties only (the record editor block is skipped in mode 10)
                SyncVisualFormControlsAndVbe
                RefreshSubforms
                Exit Sub

            Case 0, 11
                ' Table & Query Datasheet View nav bar (default geometry): "|< < [N] of M > >|". Every move
                ' repaints the painted grid on picDatasheet; lstRecords is not touched. The (New)
                ' row (updatable recordset at EOF) shows N = M + 1.
                If StudioController.GetCurrentRecordset() Is Nothing Then
                    totRecs = 0
                    curIdx = 0
                End If
                atNew = (GetFormCurrentRow(totRecs) = totRecs)
                m_formAtNew = atNew
                hasRecs = (totRecs > 0)
                If atNew And m_dsAllowNew Then
                    txtRecordPos.Text = CStr(totRecs + 1)
                Else
                    txtRecordPos.Text = CStr(curIdx)
                End If
                lblOfTotal.Caption = "of " & CStr(totRecs)
                btnFirst.Enabled = hasRecs And (atNew Or curIdx > 1)
                btnPrev.Enabled = hasRecs And (atNew Or curIdx > 1)
                btnNext.Enabled = hasRecs And (Not atNew) And (curIdx < totRecs)
                btnLast.Enabled = hasRecs And (atNew Or curIdx < totRecs)
                If atNew Then
                    If m_dsAllowNew Then lblActiveRow.Caption = "Current Record: (New)" Else lblActiveRow.Caption = ""
                Else
                    lblActiveRow.Caption = "Current Record: #" & CStr(curIdx)
                End If
                PaintQueryDatasheet
                Exit Sub
        End Select

        txtRecordPos.Text = CStr(curIdx)
        lblOfTotal.Caption = "of " & CStr(totRecs)

        btnFirst.Enabled = (curIdx > 1)
        btnPrev.Enabled = (curIdx > 1)
        btnNext.Enabled = (curIdx < totRecs)
        btnLast.Enabled = (curIdx < totRecs)

        If totRecs > 0 And curIdx > 0 Then
            If StudioController.GetViewMode() = 2 Then
                DisplayFormView StudioController.GetActiveTableName()
            Else
                If (curIdx + 1) < lstRecords.ListCount Then
                    On Error Resume Next
                    lstRecords.ListIndex = curIdx + 1
                    On Error GoTo 0
                End If
                SyncVisualFormControlsAndVbe
            End If
            lblActiveRow.Caption = "Current Record: #" & CStr(curIdx)
        Else
            lblActiveRow.Caption = ""
            SyncVisualFormControlsAndVbe
        End If
    End Sub

    Private Sub btnFirst_Click()
        If m_dsEditActive Then CommitDatasheetCellEdit
        If m_dsRecordDirty Then SaveDatasheetRecord
        StudioController.MoveFirst
        UpdateNavigationControls
    End Sub

    Private Sub btnPrev_Click()
        If m_dsEditActive Then CommitDatasheetCellEdit
        If m_dsRecordDirty Then SaveDatasheetRecord
        If (m_currentWorkspaceMode = 0 Or m_currentWorkspaceMode = 10 Or m_currentWorkspaceMode = 11) And m_formAtNew Then
            StudioController.MoveLast
        Else
            StudioController.MovePrevious
        End If
        UpdateNavigationControls
    End Sub

    Private Sub btnNext_Click()
        If m_dsEditActive Then CommitDatasheetCellEdit
        If m_dsRecordDirty Then SaveDatasheetRecord
        StudioController.MoveNext
        UpdateNavigationControls
    End Sub

    Private Sub btnLast_Click()
        If m_dsEditActive Then CommitDatasheetCellEdit
        If m_dsRecordDirty Then SaveDatasheetRecord
        StudioController.MoveLast
        UpdateNavigationControls
    End Sub

    ' Form View (mode 10) New Record button (">*"): moves to the (New) position, i.e. the
    ' active recordset at EOF after the last record (controller index stays at the record
    ' count). Continuous Forms / Datasheet mark the (New) row as current, Single Form shows
    ' empty controls. Inserting stays with the existing btnAddRecord_Click flow (clicking the
    ' (New) row, task 7.3, or the Add Record ribbon button).
    Private Sub btnNavNew_Click()
        Dim rs As Object

        If m_currentWorkspaceMode <> 10 Or Not m_formLayoutValid Then Exit Sub
        If Not m_formLayout.AllowAdditions Then
            lblStatus.Caption = "Form View: " & m_formName & " | This form does not allow new records."
            Exit Sub
        End If
        Set rs = StudioController.GetCurrentRecordset()
        If Not rs Is Nothing And StudioController.GetTotalRecords() > 0 Then
            StudioController.MoveLast
            On Error Resume Next
            If Not rs.EOF Then rs.MoveNext
            Err.Clear
            On Error GoTo 0
        End If
        UpdateNavigationControls
        lblStatus.Caption = "Form View: " & m_formName & " | New record (use Add Record or click the (New) row to insert)."
    End Sub

    ' Form View (mode 10) record number entry: Enter in txtRecordPos moves to that record
    ' (clamped to 1..M; M + 1 goes to the (New) position when the form allows additions).
    ' Other workspace modes keep their existing behavior (no handler action).
    Private Sub txtRecordPos_KeyPress(KeyAscii As Integer)
        If KeyAscii <> 13 Then Exit Sub
        If m_currentWorkspaceMode <> 10 Then Exit Sub
        KeyAscii = 0
        GoToFormRecord txtRecordPos.Text
    End Sub

    Private Sub GoToFormRecord(ByVal posText As String)
        Dim totRecs As Long
        Dim v As Double
        Dim target As Long
        Dim k As Long

        totRecs = StudioController.GetTotalRecords()
        posText = Trim$(posText)
        If Len(posText) = 0 Or Not IsNumeric(posText) Or totRecs <= 0 Then
            UpdateNavigationControls
            Exit Sub
        End If
        v = Int(Val(posText))
        If v > totRecs Then
            If v = totRecs + 1 And m_formLayoutValid And m_formLayout.AllowAdditions Then
                btnNavNew_Click
                Exit Sub
            End If
            v = totRecs
        End If
        If v < 1 Then v = 1
        target = CLng(v)

        StudioController.MoveFirst
        For k = 2 To target
            StudioController.MoveNext
        Next k
        UpdateNavigationControls
    End Sub

    ' Subform refresh, called after every Form View (mode 10) move by UpdateNavigationControls:
    ' every subform slot shown by the last PaintFormCanvas re-opens its child rows through
    ' OpenChildRecordset (BuildLinkedChildSql with the parent's current link master values;
    ' no rows at the parent's (New) position) and repaints its picSubNN from the top.
    Private Sub RefreshSubforms()
        Dim s As Long

        If m_currentWorkspaceMode <> 10 Or Not m_formLayoutValid Then Exit Sub
        For s = 1 To FC_POOL_SUB
            If m_subUsed(s) Then RefreshSubformSlot s
        Next s
    End Sub

    Private Function SubformPic(ByVal s As Long) As PictureBox
        Select Case s
            Case 1: Set SubformPic = picSub01
            Case 2: Set SubformPic = picSub02
            Case Else: Set SubformPic = Nothing
        End Select
    End Function

    Private Function SubformScrollBar(ByVal s As Long) As Object
        Select Case s
            Case 1: Set SubformScrollBar = vsbSub01
            Case 2: Set SubformScrollBar = vsbSub02
            Case Else: Set SubformScrollBar = Nothing
        End Select
    End Function

    ' Live-pass placement of a Subform control (parent form only): takes the next picSubNN,
    ' places it over the canvas at the control's rectangle (clipped to the visible canvas)
    ' with vsbSubNN on its right edge, and brings both in front of the canvas. Beyond
    ' FC_POOL_SUB slots the subform is painted as a labeled empty rectangle.
    Private Sub PlaceSubformSurface(ByVal ctlIdx As Long, ByVal x As Long, ByVal y As Long, ByVal w As Long, ByVal h As Long, ByVal cw As Long, ByVal ch As Long, ByVal originX As Long, ByVal originY As Long)
        Dim s As Long
        Dim pic As PictureBox
        Dim vsb As Object
        Dim wClip As Long
        Dim hClip As Long
        Dim sbW As Long

        If m_subCount >= FC_POOL_SUB Then
            m_formOverflowCount = m_formOverflowCount + 1
            PaintReadOnlyControl ctlIdx, x, y, w, h, m_formLayout.Ctls(ctlIdx).SourceObject
            Exit Sub
        End If
        m_subCount = m_subCount + 1
        s = m_subCount
        m_subUsed(s) = True
        m_subCtlIdx(s) = ctlIdx
        Set pic = SubformPic(s)
        Set vsb = SubformScrollBar(s)
        If pic Is Nothing Then Exit Sub

        wClip = w
        hClip = h
        On Error Resume Next
        If Not ClipFormRect(x, y, wClip, hClip, cw, ch) Then
            pic.Visible = False
            vsb.Visible = False
            Exit Sub
        End If
        sbW = 0
        If wClip >= 48 Then sbW = 16
        pic.Left = originX + x
        pic.Top = originY + y
        pic.Width = wClip - sbW
        pic.Height = hClip
        pic.Visible = True
        pic.ZOrder 0
        If sbW > 0 Then
            vsb.Left = originX + x + wClip - sbW
            vsb.Top = originY + y
            vsb.Width = sbW
            vsb.Height = hClip
            vsb.Visible = True
            vsb.ZOrder 0
        Else
            vsb.Visible = False
        End If
        On Error GoTo 0
    End Sub

    Private Sub CloseSubformRecordset(ByVal s As Long)
        If m_subRs(s) Is Nothing Then Exit Sub
        On Error Resume Next
        m_subRs(s).Close
        Err.Clear
        On Error GoTo 0
        Set m_subRs(s) = Nothing
    End Sub

    ' Closes every child recordset and forgets the slot contents (HideRenderSurfaces).
    Private Sub CloseSubformRecordsets()
        Dim s As Long

        For s = 1 To FC_POOL_SUB
            CloseSubformRecordset s
            m_subUsed(s) = False
            m_subCtlIdx(s) = -1
            m_subPaintedKey(s) = vbNullString
            m_subLayoutName(s) = vbNullString
            m_subRecords(s) = 0
            m_subTopRow(s) = 0
        Next s
        m_subCount = 0
    End Sub

    ' Re-opens the linked child rows of slot s for the parent's current record, loads the
    ' child layout when the SourceObject changed, and repaints the slot from its first row.
    Private Sub RefreshSubformSlot(ByVal s As Long)
        Dim idx As Long
        Dim so As String
        Dim errMsg As String
        Dim rs As Object
        Dim n As Long

        idx = m_subCtlIdx(s)
        If idx < 0 Or idx >= m_formLayout.CtlCount Then Exit Sub
        CloseSubformRecordset s
        so = Trim$(m_formLayout.Ctls(idx).SourceObject)

        errMsg = vbNullString
        Set rs = StudioController.OpenChildRecordset(so, m_formLayout.Ctls(idx).LinkChild, m_formLayout.Ctls(idx).LinkMaster, StudioController.GetCurrentRecordset(), errMsg)
        Set m_subRs(s) = rs
        m_subNote(s) = vbNullString
        If rs Is Nothing Then
            m_subNote(s) = errMsg
            If Len(m_subNote(s)) = 0 Then m_subNote(s) = "Subform source not available: " & so
        End If

        If StrComp(m_subLayoutName(s), so, vbTextCompare) <> 0 Or Len(m_subLayoutName(s)) = 0 Then
            LoadSubformLayout s, so, rs
        End If

        ' Child row count (walk; the recordset is left before the first row is re-positioned)
        n = 0
        If Not rs Is Nothing Then
            On Error Resume Next
            If Not (rs.BOF And rs.EOF) Then
                rs.MoveFirst
                Do While Err.Number = 0 And Not rs.EOF
                    n = n + 1
                    If n >= 100000 Then Exit Do
                    rs.MoveNext
                Loop
            End If
            Err.Clear
            On Error GoTo 0
        End If
        m_subRecords(s) = n
        m_subTopRow(s) = 0
        m_subPaintedKey(s) = m_formLayoutKey & "|" & CStr(idx)
        PaintSubformSlot s
    End Sub

    ' Child layout of a SourceObject: "Form.X" (or a bare form name) through
    ' GetNativeFormLayout; "Table.X" / "Query.X" (or a bare name that is no form) as an
    ' AutoForm layout over the child recordset fields, shown as a datasheet.
    Private Sub LoadSubformLayout(ByVal s As Long, ByVal so As String, ByVal rs As Object)
        Dim childName As String
        Dim isSheet As Boolean
        Dim layoutErr As String
        Dim ok As Boolean
        Dim i As Long

        isSheet = False
        If StrComp(Left$(so, 6), "Table.", vbTextCompare) = 0 Or StrComp(Left$(so, 6), "Query.", vbTextCompare) = 0 Then
            childName = Mid$(so, 7)
            isSheet = True
        ElseIf StrComp(Left$(so, 5), "Form.", vbTextCompare) = 0 Then
            childName = Mid$(so, 6)
        Else
            childName = so
        End If
        childName = Trim$(childName)
        If Len(childName) > 1 And Left$(childName, 1) = "[" And Right$(childName, 1) = "]" Then childName = Mid$(childName, 2, Len(childName) - 2)

        ok = False
        If Not isSheet Then
            layoutErr = vbNullString
            ok = StudioController.GetNativeFormLayout(childName, m_subLayout(s), layoutErr)
            If ok And m_subLayout(s).CtlCount = 0 Then ok = False
            If Not ok Then isSheet = True
        End If
        If isSheet Then
            StudioController.BuildAutoFormLayout childName, childName, rs, vbNullString, vbNullString, m_subLayout(s)
            m_subLayout(s).DefaultView = 2
            m_subLayout(s).RecordSelectors = True
            ' Datasheet columns start at 1 inch (widened to the header text by the painter)
            For i = 0 To m_subLayout(s).CtlCount - 1
                m_subLayout(s).Ctls(i).WidthTw = 1440
            Next i
            ok = (m_subLayout(s).CtlCount > 0)
        End If
        ' Cache the layout only when it has columns (a failed open is retried next refresh)
        If ok Then m_subLayoutName(s) = so Else m_subLayoutName(s) = vbNullString
    End Sub

    ' Paints slot s with the shared painters: m_formLayout and m_fcPic are switched to the
    ' child layout and picSubNN for the duration and always restored.
    Private Sub PaintSubformSlot(ByVal s As Long)
        Dim saved As NativeFormLayout

        If s < 1 Or s > FC_POOL_SUB Then Exit Sub
        If Not m_subUsed(s) Then Exit Sub
        saved = m_formLayout
        m_formLayout = m_subLayout(s)
        Set m_fcPic = SubformPic(s)
        m_lkKeyPrefix = "S" & CStr(s) & "|"
        On Error GoTo PaintFailed
        PaintSubformBody s
RestoreParent:
        On Error GoTo 0
        m_formLayout = saved
        Set m_fcPic = picFormCanvas
        m_lkKeyPrefix = vbNullString
        Exit Sub
PaintFailed:
        m_subNote(s) = "Subform paint error: " & Err.Description
        Resume RestoreParent
    End Sub

    ' Moves a child recordset to row `row` (0-based); no-op for an empty recordset.
    Private Sub PositionSubformRow(ByVal rs As Object, ByVal row As Long, ByVal records As Long)
        Dim k As Long

        If rs Is Nothing Or records <= 0 Then Exit Sub
        On Error Resume Next
        rs.MoveFirst
        For k = 1 To row
            If rs.EOF Then Exit For
            rs.MoveNext
        Next k
        Err.Clear
        On Error GoTo 0
    End Sub

    ' Child body (m_formLayout = child layout, m_fcPic = picSubNN; nesting depth 1, so
    ' Subform controls of the child are painted as labeled empty rectangles):
    '   DefaultView 2 (and Table./Query. sources): PaintSubformDatasheet.
    '   DefaultView 1: FormHeader band and labels, Detail rows from m_subTopRow(s), (New) row.
    '   DefaultView 0/5: one record (row m_subTopRow(s)) painted read-only, or the (New) row.
    ' The child's first record is its current record (selector glyph).
    Private Sub PaintSubformBody(ByVal s As Long)
        Dim pic As PictureBox
        Dim rs As Object
        Dim cw As Long
        Dim ch As Long
        Dim headerPx As Long
        Dim detailPx As Long
        Dim footerPx As Long
        Dim detailTop As Long
        Dim footerTop As Long
        Dim selPx As Long
        Dim maxBottom As Long
        Dim records As Long
        Dim visibleRows As Long
        Dim painted As Long
        Dim newShown As Boolean
        Dim maxTop As Long
        Dim topRow As Long
        Dim r As Long
        Dim rowY As Long
        Dim i As Long
        Dim glyph As String

        Set pic = m_fcPic
        If pic Is Nothing Then Exit Sub
        Set rs = m_subRs(s)
        records = m_subRecords(s)
        If rs Is Nothing Then records = 0

        On Error Resume Next
        cw = pic.ScaleWidth
        ch = pic.ScaleHeight
        On Error GoTo 0
        If cw <= 0 Or ch <= 0 Then Exit Sub

        If m_formLayout.DefaultView = 2 Then
            PaintSubformDatasheet s, cw, ch
            Exit Sub
        End If

        headerPx = 0
        footerPx = 0
        If m_formLayout.SectionPresent(1) Then headerPx = TwipsToPxY(m_formLayout.SectionHeightTw(1))
        If m_formLayout.SectionPresent(2) Then footerPx = TwipsToPxY(m_formLayout.SectionHeightTw(2))
        detailPx = TwipsToPxY(m_formLayout.SectionHeightTw(0))
        If detailPx <= 0 Then
            maxBottom = 0
            For i = 0 To m_formLayout.CtlCount - 1
                If m_formLayout.Ctls(i).Section = 0 Then
                    If m_formLayout.Ctls(i).TopTw + m_formLayout.Ctls(i).HeightTw > maxBottom Then
                        maxBottom = m_formLayout.Ctls(i).TopTw + m_formLayout.Ctls(i).HeightTw
                    End If
                End If
            Next i
            detailPx = TwipsToPxY(maxBottom + 240)
        End If
        If detailPx < 1 Then detailPx = 1
        detailTop = headerPx
        footerTop = ch - footerPx
        If footerTop < detailTop + detailPx Then footerTop = detailTop + detailPx
        If m_formLayout.RecordSelectors Then selPx = FC_SELECTOR_PX Else selPx = 0

        On Error Resume Next
        pic.AutoRedraw = True
        pic.BackColor = FormSafeColor(m_formLayout.SectionBackColor(0), &HFFFFFF&)
        pic.Cls
        pic.FontTransparent = True
        If headerPx > 0 Then
            pic.Line (0, 0)-(cw - 1, headerPx - 1), FormSafeColor(m_formLayout.SectionBackColor(1), &HFFFFFF&), BF
        End If
        If footerPx > 0 Then
            pic.Line (0, footerTop)-(cw - 1, footerTop + footerPx - 1), FormSafeColor(m_formLayout.SectionBackColor(2), &HFFFFFF&), BF
        End If
        On Error GoTo 0

        If m_formLayout.DefaultView = 1 Then
            visibleRows = (ch - headerPx - footerPx) \ detailPx
        Else
            visibleRows = 1
        End If
        If visibleRows < 1 Then visibleRows = 1
        topRow = m_subTopRow(s)
        ComputeFormRowWindow records, visibleRows, m_formLayout.AllowAdditions, topRow, painted, newShown, maxTop
        m_subTopRow(s) = topRow

        ' Record rows painted read-only from the child recordset
        If painted > 0 Then
            PositionSubformRow rs, topRow, records
            For r = topRow To topRow + painted - 1
                rowY = detailTop + (r - topRow) * detailPx
                glyph = vbNullString
                If m_formLayout.DefaultView <> 1 Or r = 0 Then glyph = ChrW(&H25B6&)
                PaintFormSelectorCell rowY, detailPx, selPx, glyph
                PaintFormControlsPass rowY, -1, -1, selPx, cw, ch, 0, 0, FC_ROW_PAINTED, rs
                AdvanceFormRowCursor rs
            Next r
        End If

        ' (New) row
        If newShown Then
            rowY = detailTop + (records - topRow) * detailPx
            PaintFormSelectorCell rowY, detailPx, selPx, "*"
            PaintFormControlsPass rowY, -1, -1, selPx, cw, ch, 0, 0, FC_ROW_NEW, Nothing
        End If

        ' FormHeader / FormFooter controls (values from the first visible row)
        PositionSubformRow rs, topRow, records
        PaintFormControlsPass -1, 0, footerTop, selPx, cw, ch, 0, 0, FC_ROW_BANDS, rs

        PaintSubformNote s, ch
        SyncSubformScrollBar s, maxTop, visibleRows
        On Error Resume Next
        pic.Refresh
        On Error GoTo 0
    End Sub

    ' Child datasheet: columns are the child layout's bound Detail controls (same rules as
    ' PaintFormDatasheetView), rows from m_subTopRow(s), the first record marked current,
    ' (New) row with * when AllowAdditions.
    Private Sub PaintSubformDatasheet(ByVal s As Long, ByVal cw As Long, ByVal ch As Long)
        Dim pic As PictureBox
        Dim rs As Object
        Dim colIdx() As Long
        Dim colW() As Long
        Dim colCap() As String
        Dim nCols As Long
        Dim i As Long
        Dim c As Long
        Dim ctlType As String
        Dim records As Long
        Dim visibleRows As Long
        Dim painted As Long
        Dim newShown As Boolean
        Dim maxTop As Long
        Dim topRow As Long
        Dim r As Long
        Dim rowY As Long
        Dim x As Long
        Dim tw As Long
        Dim txt As String
        Dim v As Variant
        Dim selPx As Long
        Dim backC As Long

        Set pic = m_fcPic
        Set rs = m_subRs(s)
        records = m_subRecords(s)
        If rs Is Nothing Then records = 0
        selPx = FC_SELECTOR_PX

        nCols = 0
        ReDim colIdx(0 To 0)
        ReDim colW(0 To 0)
        ReDim colCap(0 To 0)
        For i = 0 To m_formLayout.CtlCount - 1
            If m_formLayout.Ctls(i).Visible And m_formLayout.Ctls(i).Section = 0 Then
                ctlType = m_formLayout.Ctls(i).CtlType
                If ctlType = "TextBox" Or ctlType = "ComboBox" Or ctlType = "CheckBox" Or ctlType = "ListBox" Or ctlType = "OptionButton" Then
                    ReDim Preserve colIdx(0 To nCols)
                    ReDim Preserve colW(0 To nCols)
                    ReDim Preserve colCap(0 To nCols)
                    colIdx(nCols) = i
                    colCap(nCols) = FormColumnCaption(i)
                    nCols = nCols + 1
                End If
            End If
        Next i

        On Error Resume Next
        pic.AutoRedraw = True
        pic.BackColor = &HFFFFFF&
        pic.Cls
        pic.FontTransparent = True
        pic.FontName = "Calibri"
        pic.FontSize = 11
        pic.FontBold = False
        For c = 0 To nCols - 1
            colW(c) = TwipsToPxX(m_formLayout.Ctls(colIdx(c)).WidthTw)
            tw = CLng(pic.TextWidth(colCap(c))) + 10
            If colW(c) < tw Then colW(c) = tw
            If colW(c) > FC_DS_MAX_COL_PX Then colW(c) = FC_DS_MAX_COL_PX
            If colW(c) < 24 Then colW(c) = 24
        Next c
        On Error GoTo 0

        visibleRows = (ch - FC_DS_HEADER_PX) \ FC_DS_ROW_PX
        If visibleRows < 1 Then visibleRows = 1
        topRow = m_subTopRow(s)
        ComputeFormRowWindow records, visibleRows, m_formLayout.AllowAdditions, topRow, painted, newShown, maxTop
        m_subTopRow(s) = topRow

        ' Header row
        PaintFormSelectorCell 0, FC_DS_HEADER_PX, selPx, vbNullString
        x = selPx
        For c = 0 To nCols - 1
            If x >= cw Then Exit For
            PaintFormDatasheetCell x, 0, colW(c), FC_DS_HEADER_PX, colCap(c), &HF0F0F0&
            x = x + colW(c)
        Next c

        ' Record rows
        If painted > 0 Then
            PositionSubformRow rs, topRow, records
            For r = topRow To topRow + painted - 1
                rowY = FC_DS_HEADER_PX + (r - topRow) * FC_DS_ROW_PX
                If r = 0 Then
                    PaintFormSelectorCell rowY, FC_DS_ROW_PX, selPx, ChrW(&H25B6&)
                    backC = &HF7EBDD&
                Else
                    PaintFormSelectorCell rowY, FC_DS_ROW_PX, selPx, vbNullString
                    backC = &HFFFFFF&
                End If
                x = selPx
                For c = 0 To nCols - 1
                    If x >= cw Then Exit For
                    If m_formLayout.Ctls(colIdx(c)).CtlType = "CheckBox" Then
                        PaintFormDatasheetCell x, rowY, colW(c), FC_DS_ROW_PX, vbNullString, backC
                        v = GetRowControlRawValue(rs, colIdx(c))
                        PaintCanvasCheckBox x + (colW(c) - 13) \ 2, rowY, 13, FC_DS_ROW_PX, v
                    Else
                        txt = GetRowControlText(rs, colIdx(c))
                        PaintFormDatasheetCell x, rowY, colW(c), FC_DS_ROW_PX, txt, backC
                    End If
                    x = x + colW(c)
                Next c
                AdvanceFormRowCursor rs
            Next r
        End If

        ' (New) row
        If newShown Then
            rowY = FC_DS_HEADER_PX + (records - topRow) * FC_DS_ROW_PX
            PaintFormSelectorCell rowY, FC_DS_ROW_PX, selPx, "*"
            x = selPx
            For c = 0 To nCols - 1
                If x >= cw Then Exit For
                PaintFormDatasheetCell x, rowY, colW(c), FC_DS_ROW_PX, vbNullString, &HFFFFFF&
                x = x + colW(c)
            Next c
        End If

        PaintSubformNote s, ch
        SyncSubformScrollBar s, maxTop, visibleRows
        On Error Resume Next
        pic.Refresh
        On Error GoTo 0
    End Sub

    ' Open/layout error of slot s, printed at the bottom-left of the subform surface.
    Private Sub PaintSubformNote(ByVal s As Long, ByVal ch As Long)
        If Len(m_subNote(s)) = 0 Then Exit Sub
        On Error Resume Next
        m_fcPic.FontName = "Calibri"
        m_fcPic.FontSize = 9
        m_fcPic.FontBold = False
        m_fcPic.ForeColor = &H2020C0&
        m_fcPic.CurrentX = 4
        m_fcPic.CurrentY = ch - 18
        m_fcPic.Print m_subNote(s)
        On Error GoTo 0
    End Sub

    ' vsbSubNN range for the child's row window (disabled when everything fits).
    Private Sub SyncSubformScrollBar(ByVal s As Long, ByVal maxTop As Long, ByVal pageRows As Long)
        Dim vsb As Object

        Set vsb = SubformScrollBar(s)
        If vsb Is Nothing Then Exit Sub
        If maxTop > 32767 Then maxTop = 32767
        If pageRows < 1 Then pageRows = 1
        m_subScrollSync = True
        On Error Resume Next
        vsb.Min = 0
        vsb.Max = maxTop
        vsb.SmallChange = 1
        vsb.LargeChange = pageRows
        If m_subTopRow(s) <= maxTop Then vsb.Value = m_subTopRow(s) Else vsb.Value = maxTop
        vsb.Enabled = (maxTop > 0)
        On Error GoTo 0
        m_subScrollSync = False
    End Sub

    ' vsbSubNN scrolls the child's own top row (the parent form is not repainted).
    Private Sub OnSubformScroll(ByVal s As Long)
        Dim vsb As Object
        Dim newTop As Long

        If m_subScrollSync Then Exit Sub
        If m_currentWorkspaceMode <> 10 Then Exit Sub
        If s < 1 Or s > FC_POOL_SUB Then Exit Sub
        If Not m_subUsed(s) Then Exit Sub
        Set vsb = SubformScrollBar(s)
        If vsb Is Nothing Then Exit Sub
        newTop = vsb.Value
        If newTop = m_subTopRow(s) Then Exit Sub
        m_subTopRow(s) = newTop
        PaintSubformSlot s
    End Sub

    Private Sub vsbSub01_Change()
        OnSubformScroll 1
    End Sub

    Private Sub vsbSub01_Scroll()
        OnSubformScroll 1
    End Sub

    Private Sub vsbSub02_Change()
        OnSubformScroll 2
    End Sub

    Private Sub vsbSub02_Scroll()
        OnSubformScroll 2
    End Sub

    Private Sub lstRecords_Click()
        Dim selIdx As Long
        Dim targetRow As Long
        Dim stepIdx As Long
        Dim selLineText As String

        selIdx = lstRecords.ListIndex
        If selIdx < 0 Then Exit Sub
        selLineText = lstRecords.List(selIdx)

        If Left$(Trim$(selLineText), 7) = "* (New)" Then
            btnAddRecord_Click
            Exit Sub
        End If

        If InStr(1, selLineText, "[BUTTON]", vbTextCompare) > 0 Or InStr(1, selLineText, "Click this button row", vbTextCompare) > 0 Then
            btnFormCmd_Click
            Exit Sub
        End If

        If selIdx >= 2 Then
            targetRow = selIdx - 1
            If targetRow >= 1 And targetRow <= StudioController.GetTotalRecords() Then
                StudioController.MoveFirst
                For stepIdx = 2 To targetRow
                    StudioController.MoveNext
                Next stepIdx
                txtRecordPos.Text = CStr(StudioController.GetCurrentRecordIndex())
                lblActiveRow.Caption = "Current Record: #" & CStr(StudioController.GetCurrentRecordIndex())
                SyncVisualFormControlsAndVbe
            End If
        End If
    End Sub

    Private Sub btnFormCmd_Click()
        If StudioController.GetViewMode() = 0 Or StudioController.GetViewMode() = 4 Then
            If m_editorExpanded Then
                m_editorWidth = 460
                m_editorExpanded = False
            Else
                m_editorWidth = 620
                m_editorExpanded = True
            End If
            LayoutRecordEditorPanel
            Exit Sub
        End If

        Dim execMsg As String
        Dim errMsg As String
        Dim ok As Boolean
        Dim frms As Collection
        Dim mods As Collection

        If Not StudioController.IsDatabaseOpen() Then
            MsgBox "Please open a database first.", vbInformation, "OpenAccess Studio"
            Exit Sub
        End If

        If StudioController.IsNativeFormActive() Then
            ok = StudioController.ExecuteFormButtonClick(StudioController.GetActiveFormName(), StudioController.GetActiveFormButtonName(), True, execMsg, errMsg)
            If ok Then
                ProcessPendingVbaUiActions
                lblStatus.Caption = "Executed Form [" & StudioController.GetActiveFormName() & "] Button [" & StudioController.GetActiveFormButtonName() & "] ==> " & execMsg
            Else
                MsgBox "Form event error: " & errMsg, vbExclamation, "Form Event"
            End If
            Exit Sub
        End If

        If StudioController.IsNativeModuleActive() Then
            ok = StudioController.ExecuteVbaModuleDefaultProc(StudioController.GetActiveModuleName(), True, execMsg, errMsg)
            If ok Then
                lblStatus.Caption = "Executed VBA Module [" & StudioController.GetActiveModuleName() & "] ==> MsgBox: " & execMsg
                If StudioController.GetViewMode() = 9 Then
                    DisplayVbaModuleView StudioController.GetActiveModuleName()
                End If
            Else
                MsgBox "VBA Module error: " & errMsg, vbExclamation, "VBA Execution"
            End If
            Exit Sub
        End If

        Set frms = StudioController.GetCustomObjectNames("FORM")
        If frms.Count > 0 Then
            ok = StudioController.ExecuteFormButtonClick(CStr(frms(1)), "", True, execMsg, errMsg)
            If ok Then
                lblStatus.Caption = "Executed Form [" & CStr(frms(1)) & "] Command Button ==> MsgBox: " & execMsg
                Exit Sub
            End If
        End If

        Set mods = StudioController.GetCustomObjectNames("MODULE")
        If mods.Count > 0 Then
            ok = StudioController.ExecuteVbaModuleDefaultProc(CStr(mods(1)), True, execMsg, errMsg)
            If ok Then
                lblStatus.Caption = "Executed VBA Module [" & CStr(mods(1)) & "] ==> MsgBox: " & execMsg
                Exit Sub
            End If
        End If

        If Not StudioController.IsNativeFormActive() Then
            MsgBox "No executable Form CommandButton or VBA Module procedure found in the current database.", vbInformation, "OpenAccess Studio"
        End If
    End Sub

    ' -------------------------------------------------------------------------
    ' Visual Form Controls Synchronizer, VBE Code Editor & Property Sheet
    ' -------------------------------------------------------------------------
    Private Sub SyncVisualFormControlsAndVbe()
        Dim rs As Object
        Dim curTable As String
        Dim fldCnt As Long
        Dim i As Long
        Dim fName As String
        Dim rawVal As Variant
        Dim dispVal As String
        Dim lkpDisp As String
        Dim hasLookup As Boolean
        Dim lkpFieldName As String
        Dim vbeMod As String
        Dim vbeObj As String
        Dim vbeProc As String
        Dim cleanCode As String
        Dim codeArr() As String
        Dim activeStmt As String
        Dim propLines As Collection
        Dim itemVal As Variant
        Dim mods As Collection

        On Error Resume Next
        lblFormFld1.Visible = False
        txtFormFld1.Visible = False
        lblFormFld2.Visible = False
        txtFormFld2.Visible = False
        lblFormFld3.Visible = False
        txtFormFld3.Visible = False
        lblFormFld4.Visible = False
        txtFormFld4.Visible = False
        lblFormFld5.Visible = False
        txtFormFld5.Visible = False
        btnLookupDrop.Visible = False
        lblLookupHint.Caption = ""

        If Not StudioController.IsDatabaseOpen() Then
            txtVbeObj.Text = "(General)"
            txtVbeProc.Text = "(Declarations)"
            lstVbaCode.Clear
            lstVbaCode.AddItem "Option Compare Database"
            lstVbaCode.AddItem "' Open a database to view and edit Form/Module VBA code."
            txtVbaCode.Text = "Option Compare Database"
            lstPropSheet.Clear
            On Error GoTo 0
            Exit Sub
        End If

        curTable = StudioController.GetActiveTableName()
        Set rs = StudioController.GetCurrentRecordset()
        hasLookup = False
        lkpFieldName = ""

        ' Clear every slot caption first: LayoutRecordEditorPanel shows a slot when its
        ' caption is non-empty, so captions left from a wider table must not survive.
        lblFormFld1.Caption = ""
        lblFormFld2.Caption = ""
        lblFormFld3.Caption = ""
        lblFormFld4.Caption = ""
        lblFormFld5.Caption = ""

        ' Record editor panel (mode 0 etc.); Native Form View (mode 10) renders its own controls.
        If m_currentWorkspaceMode <> 10 Then
            If Not rs Is Nothing Then
                fldCnt = rs.Fields.Count
                If fldCnt > 5 Then fldCnt = 5
                For i = 0 To fldCnt - 1
                    fName = rs.Fields(i).Name
                    dispVal = ""
                    If Not (rs.BOF And rs.EOF) Then
                        rawVal = rs.Fields(i).Value
                        If Not IsNull(rawVal) Then
                            dispVal = CStr(rawVal)
                            lkpDisp = StudioController.ResolveFieldLookupValue(curTable, fName, rawVal)
                            If Len(lkpDisp) > 0 And LCase$(lkpDisp) <> LCase$(dispVal) Then
                                dispVal = lkpDisp
                                hasLookup = True
                                lkpFieldName = fName
                            End If
                        End If
                    End If
                    If LCase$(fName) = "type" Or LCase$(fName) = "type_customer" Then
                        hasLookup = True
                        If Len(lkpFieldName) = 0 Then lkpFieldName = fName
                    End If

                    Select Case i
                        Case 0
                            lblFormFld1.Caption = fName & ":"
                            lblFormFld1.Visible = True
                            txtFormFld1.Text = dispVal
                            txtFormFld1.Visible = True
                        Case 1
                            lblFormFld2.Caption = fName & ":"
                            lblFormFld2.Visible = True
                            txtFormFld2.Text = dispVal
                            txtFormFld2.Visible = True
                        Case 2
                            lblFormFld3.Caption = fName & ":"
                            lblFormFld3.Visible = True
                            txtFormFld3.Text = dispVal
                            txtFormFld3.Visible = True
                        Case 3
                            lblFormFld4.Caption = fName & ":"
                            lblFormFld4.Visible = True
                            txtFormFld4.Text = dispVal
                            txtFormFld4.Visible = True
                        Case 4
                            lblFormFld5.Caption = fName & ":"
                            lblFormFld5.Visible = True
                            txtFormFld5.Text = dispVal
                            txtFormFld5.Visible = True
                    End Select
                Next i
            End If

            If hasLookup Then
                btnLookupDrop.Visible = True
                lblLookupHint.Caption = "Lookup [" & lkpFieldName & "]: 1=good | 2=bad"
            End If

            lblFormSection.Caption = "  Record Editor: [" & curTable & "] (#" & CStr(StudioController.GetCurrentRecordIndex()) & " of " & CStr(StudioController.GetTotalRecords()) & ")"
            LayoutRecordEditorPanel
        End If

        If StudioController.IsNativeFormActive() Then
            lblFormSection.Caption = "Form [" & StudioController.GetActiveFormName() & "] Detail Section (RecordSource: " & curTable & "):"
            If Len(StudioController.GetActiveFormButtonCaption()) > 0 Then
                btnFormCmd.Caption = StudioController.GetActiveFormButtonCaption()
            Else
                btnFormCmd.Caption = "Form Event [Run]"
            End If
        ElseIf StudioController.IsNativeModuleActive() Then
            lblFormSection.Caption = "VBA Module [" & StudioController.GetActiveModuleName() & "] Active:"
            btnFormCmd.Caption = "Run [" & StudioController.GetActiveModuleName() & "]"
        Else
            lblFormSection.Caption = "Form Detail Surface [" & curTable & "]:"
            btnFormCmd.Caption = "CALL MODULE"
        End If

        ' Populate VBE Code Editor (Object Box, Procedure Box, Multi-Line List & Statement Editor)
        vbeMod = ""
        If StudioController.IsNativeModuleActive() Then
            vbeMod = StudioController.GetActiveModuleName()
        ElseIf StudioController.IsNativeFormActive() Then
            If Len(StudioController.GetNativeVbaModuleCode("Form_" & StudioController.GetActiveFormName())) > 0 Then
                vbeMod = "Form_" & StudioController.GetActiveFormName()
            Else
                vbeMod = StudioController.GetActiveFormName()
            End If
        End If
        If Len(vbeMod) = 0 Then
            Set mods = StudioController.GetCustomObjectNames("MODULE")
            If mods.Count > 0 Then
                vbeMod = CStr(mods(1))
            Else
                vbeMod = "Module1"
            End If
        End If

        cleanCode = StudioController.GetCleanVbaModuleCode(vbeMod, vbeObj, vbeProc)
        lblVbeHeader.Caption = "VBE Code: " & vbeMod & " (Code)"
        txtVbeObj.Text = vbeObj
        txtVbeProc.Text = vbeProc

        ' Plan 7 WS3: Full-module code editor
        txtVbaCode.Text = cleanCode

        ' Populate Right-Bottom Property Sheet (except in Table Design, Form Design, Relationships, or QBE where lstPropSheet holds mode-specific items)
        If m_currentWorkspaceMode <> 1 And m_currentWorkspaceMode <> 6 And m_currentWorkspaceMode <> 8 And m_currentWorkspaceMode <> 12 Then
            lstPropSheet.Clear
            Set propLines = StudioController.GetFormPropertySheetLines(curTable)
            For Each itemVal In propLines
                lstPropSheet.AddItem CStr(itemVal)
            Next itemVal
        End If
        On Error GoTo 0
    End Sub

    Private Sub lstVbaCode_Click()
        ' Legacy stub maintained for compatibility
    End Sub

    Private Sub txtVbaCode_KeyDown(KeyCode As Integer, Shift As Integer)
        If KeyCode = vbKeyS And (Shift And 2) <> 0 Then
            ' Ctrl+S: Save Module
            btnSaveVbaCode_Click
            KeyCode = 0
        ElseIf KeyCode = vbKeyF And (Shift And 2) <> 0 Then
            ' Ctrl+F: Find in module
            Dim findText As String
            Dim fPos As Long
            findText = InputBox("Enter text to find in code:", "Find in Module")
            If Len(findText) > 0 Then
                fPos = InStr(txtVbaCode.SelStart + 2, txtVbaCode.Text, findText, vbTextCompare)
                If fPos = 0 Then fPos = InStr(1, txtVbaCode.Text, findText, vbTextCompare)
                If fPos > 0 Then
                    txtVbaCode.SelStart = fPos - 1
                    txtVbaCode.SelLength = Len(findText)
                Else
                    MsgBox "Text not found: " & findText, vbInformation, "Find"
                End If
            End If
            KeyCode = 0
        End If
    End Sub

    ' -------------------------------------------------------------------------
    ' Query Design View (mode 12, task 10.3)
    ' -------------------------------------------------------------------------
    ' Shows a saved query in Access Design View: field-list boxes with join lines on
    ' picQryTables (PaintQueryTables) over the QBE grid on picQbeGrid (PaintQbeGrid), both
    ' from StudioController.GetQueryDesignModel. Nothing is written to lstRecords; the SQL
    ' bar gets the single-line SQL. Queries the model cannot represent (UNION, pass-through,
    ' DDL, subquery in FROM) show "This query cannot be shown in Design View" and offer SQL View.
    Private Sub DisplayQueryWithQbeView(ByVal queryName As String)
        Dim tables() As String
        Dim joins() As String
        Dim cols() As String
        Dim errMsg As String
        Dim sqlErr As String
        Dim savedSql As String
        Dim ok As Boolean
        Dim openSql As VbMsgBoxResult

        m_activeQueryName = queryName
        SwitchWorkspaceMode 12
        lblTableTitle.Caption = queryName

        savedSql = StudioController.GetSavedQuerySql(queryName, sqlErr)
        If Len(savedSql) > 0 Then
            txtSql.Text = StudioController.FormatSqlForDisplay(savedSql, True)
        End If

        Erase m_qbeBoxX
        Erase m_qbeBoxY
        m_qbeSelectedJoinIdx = -1
        ok = StudioController.GetQueryDesignModel(queryName, m_qbeTables, m_qbeJoins, m_qbeCols, errMsg)
        If ok Then
            m_qbeColCount = UBound(m_qbeCols) + 1
            PaintQueryTables picQryTables, m_qbeTables, m_qbeJoins
            PaintQbeGrid picQbeGrid, m_qbeCols
            lblStatus.Caption = "Query Tools: [" & queryName & "] | Design View | " & CStr(UBound(m_qbeTables) + 1) & " table(s), " & CStr(UBound(m_qbeJoins) + 1) & " join(s), " & CStr(m_qbeColCount) & " column(s)"
            Exit Sub
        End If

        Erase m_qbeTables
        Erase m_qbeJoins
        Erase m_qbeCols
        m_qbeColCount = 0
        PaintQueryTables picQryTables, m_qbeTables, m_qbeJoins
        PaintQbeGrid picQbeGrid, m_qbeCols

        If StudioController.QueryDesignCannotRepresent() Then
            PaintQueryDesignMessage picQryTables, "This query cannot be shown in Design View", errMsg
            lblStatus.Caption = "Query Tools: [" & queryName & "] | This query cannot be shown in Design View"
            openSql = MsgBox("This query cannot be shown in Design View." & vbCrLf & vbCrLf & errMsg & vbCrLf & vbCrLf & "Open [" & queryName & "] in SQL View?", vbYesNo + vbInformation, "Microsoft Access")
            If openSql = vbYes Then ShowQuerySqlView queryName
        Else
            PaintQueryDesignMessage picQryTables, "The query could not be opened in Design View.", errMsg
            lblStatus.Caption = "Query Tools: [" & queryName & "] | Design View | " & errMsg
        End If
    End Sub

    ' Query SQL View (mode 13): the saved SQL, formatted one clause per line, in txtSqlView.
    ' The SQL bar keeps the single-line form.
    Private Sub ShowQuerySqlView(ByVal queryName As String)
        Dim sqlErr As String
        Dim savedSql As String

        m_activeQueryName = queryName
        SwitchWorkspaceMode 13
        lblTableTitle.Caption = queryName
        savedSql = StudioController.GetSavedQuerySql(queryName, sqlErr)
        If Len(savedSql) = 0 Then savedSql = txtSql.Text
        txtSqlView.Text = StudioController.FormatSqlForDisplay(savedSql, False)
        If Len(savedSql) > 0 Then
            txtSql.Text = StudioController.FormatSqlForDisplay(savedSql, True)
        End If
        If Len(sqlErr) > 0 Then
            lblStatus.Caption = "Query Tools: [" & queryName & "] | SQL View | " & sqlErr
        Else
            lblStatus.Caption = "Query Tools: [" & queryName & "] | SQL View"
        End If
    End Sub

    Private Sub txtSqlView_Change()
        If m_currentWorkspaceMode = 13 Then
            txtSql.Text = StudioController.FormatSqlForDisplay(txtSqlView.Text, True)
        End If
    End Sub

    ' -------------------------------------------------------------------------
    ' Query view switches (QUERY ribbon, task 10.4): Datasheet (11) / Design (12) / SQL (13)
    ' -------------------------------------------------------------------------
    ' The query shown by the current Query view; falls back to the active object when it is
    ' a saved query. Returns "" (with a prompt) when no saved query is open.
    Private Function ResolveActiveQueryName() As String
        Dim curObj As String

        If Not StudioController.IsDatabaseOpen() Then
            MsgBox "Please open a database first.", vbInformation, "OpenAccess Studio"
            Exit Function
        End If

        curObj = m_activeQueryName
        If Len(curObj) = 0 Then curObj = StudioController.GetActiveTableName()
        If Len(curObj) = 0 Or curObj = "SQL Query Result" Then
            curObj = "Query1"
        End If

        ResolveActiveQueryName = curObj
    End Function

    Private Sub btnQryDatasheet_Click()
        If m_currentWorkspaceMode = 12 Or m_currentWorkspaceMode = 13 Then
            btnRunSql_Click
        Else
            Dim qName As String
            qName = ResolveActiveQueryName()
            If Len(qName) > 0 Then
                DisplayQueryDatasheet qName
            Else
                btnRunSql_Click
            End If
        End If
    End Sub

    Private Sub btnQryDesign_Click()
        If m_currentWorkspaceMode = 12 And m_qbeColCount > 0 Then
            PaintQueryTables picQryTables, m_qbeTables, m_qbeJoins
            PaintQbeGrid picQbeGrid, m_qbeCols
        Else
            Dim qName As String
            qName = ResolveActiveQueryName()
            OpenQbeDesigner qName
        End If
    End Sub

    Private Sub btnQrySql_Click()
        Dim qName As String
        qName = ResolveActiveQueryName()
        ShowQuerySqlView qName
    End Sub

    ' Prepares a Design View surface for painting (pixels, persistent drawing, cleared).
    Private Sub PrepareQueryDesignSurface(ByVal pic As PictureBox, ByVal bgColor As Long)
        On Error Resume Next
        pic.AutoRedraw = True
        pic.ScaleMode = vbPixels
        pic.BackColor = bgColor
        pic.Cls
        pic.FontTransparent = True
        pic.DrawWidth = 1
        pic.FontName = "Calibri"
        pic.FontSize = 10
        pic.FontBold = False
        pic.ForeColor = &H202020&
        On Error GoTo 0
    End Sub

    ' Two-line notice in the upper Design View pane.
    Private Sub PaintQueryDesignMessage(ByVal pic As PictureBox, ByVal title As String, ByVal detail As String)
        On Error Resume Next
        pic.FontBold = True
        pic.ForeColor = &H2020C0&
        pic.CurrentX = 20
        pic.CurrentY = 20
        pic.Print title
        pic.FontBold = False
        pic.ForeColor = &H404040&
        pic.CurrentX = 20
        pic.CurrentY = 42
        pic.Print detail
        On Error GoTo 0
    End Sub

    ' Prints s at (x, y), cut to fit maxW pixels (trailing "..." when cut).
    Private Sub PrintQueryDesignText(ByVal pic As PictureBox, ByVal x As Long, ByVal y As Long, ByVal maxW As Long, ByVal s As String)
        Dim t As String
        Dim tw As Single

        t = s
        On Error Resume Next
        tw = pic.TextWidth(t)
        If Err.Number = 0 And tw > maxW Then
            Do While Len(t) > 0
                t = Left$(t, Len(t) - 1)
                tw = pic.TextWidth(t & "...")
                If Err.Number <> 0 Or tw <= maxW Then Exit Do
            Loop
            t = t & "..."
        End If
        pic.CurrentX = x
        pic.CurrentY = y
        pic.Print t
        Err.Clear
        On Error GoTo 0
    End Sub

    ' Upper Design View pane: one 150 px field-list box per table (title bar with the table
    ' or alias name, then *, then the fields of TableDefs(t)/QueryDefs(q), 16 px rows, up to
    ' 10 visible), left to right with 60 px gaps. Each join is a line from the right edge of
    ' the left box at the left field's row center to the left edge of the right box at the
    ' right field's row center; LEFT/RIGHT joins get an arrowhead at the side whose rows
    ' may be missing (Access: the arrow points away from the "all records" table).
    '   tables: "key" or "key|source";  joins: "leftTable|leftField|rightTable|rightField|type"
        Private Sub PaintQueryTables(ByVal pic As PictureBox, ByRef tables() As String, ByRef joins() As String)
        Dim n As Long
        Dim t As Long
        Dim j As Long
        Dim k As Long
        Dim parts() As String
        Dim fieldNames() As String
        Dim fieldCount As Long
        Dim keys() As String
        Dim lists() As String
        Dim boxX() As Long
        Dim boxRows() As Long
        Dim srcName As String
        Dim visRows As Long
        Dim bx As Long
        Dim by As Long
        Dim bh As Long
        Dim rowY As Long
        Dim ia As Long
        Dim ib As Long
        Dim ya As Long
        Dim yb As Long
        Dim x1 As Long
        Dim y1 As Long
        Dim x2 As Long
        Dim y2 As Long
        Dim jType As String
        Dim arrowAtA As Boolean
        Dim arrowAtB As Boolean
        Dim aLeft As Boolean
        Dim uTb As Long

        If pic Is Nothing Then Exit Sub
        PrepareQueryDesignSurface pic, &HF3F3F3&

        ' Draw action buttons at the top right of picQryTables
        Dim addBtnLeft As Long
        Dim addBtnW As Long
        addBtnW = 155
        addBtnLeft = pic.ScaleWidth - addBtnW - 16
        If addBtnLeft < 200 Then addBtnLeft = 200
        If m_currentWorkspaceMode = 8 Then
            Dim newRelBtnLeft As Long
            newRelBtnLeft = addBtnLeft - 155
            pic.Line (newRelBtnLeft, 10)-(newRelBtnLeft + 148, 36), &HD8E8F8&, BF
            pic.Line (newRelBtnLeft, 10)-(newRelBtnLeft + 148, 36), &H406090&, B
            pic.FontBold = True
            pic.ForeColor = &H102040&
            PrintQueryDesignText pic, newRelBtnLeft + 10, 14, 132, "+ New Relationship"
            pic.Line (addBtnLeft, 10)-(addBtnLeft + addBtnW, 36), &HE6E6E6&, BF
            pic.Line (addBtnLeft, 10)-(addBtnLeft + addBtnW, 36), &H707070&, B
            pic.ForeColor = &H101010&
            PrintQueryDesignText pic, addBtnLeft + 10, 14, addBtnW - 16, "+ Add Selected Table"
            pic.FontBold = False
        Else
            Dim delJoinBtnLeft As Long
            delJoinBtnLeft = addBtnLeft - 148
            pic.Line (delJoinBtnLeft, 10)-(delJoinBtnLeft + 140, 36), &HF4E4E4&, BF
            pic.Line (delJoinBtnLeft, 10)-(delJoinBtnLeft + 140, 36), &H904040&, B
            pic.FontBold = True
            pic.ForeColor = &H201080&
            PrintQueryDesignText pic, delJoinBtnLeft + 10, 14, 124, "Delete Join [X]"
            pic.Line (addBtnLeft, 10)-(addBtnLeft + addBtnW, 36), &HE6E6E6&, BF
            pic.Line (addBtnLeft, 10)-(addBtnLeft + addBtnW, 36), &H707070&, B
            pic.FontBold = True
            pic.ForeColor = &H101010&
            PrintQueryDesignText pic, addBtnLeft + 12, 14, addBtnW - 20, "+ Add Table to Query"
            pic.FontBold = False
        End If

        On Error Resume Next
        uTb = -1
        uTb = UBound(tables)
        On Error GoTo 0
        If uTb < 0 Then Exit Sub

        n = uTb + 1
        Dim boxY() As Long
        ReDim keys(0 To n - 1)
        ReDim lists(0 To n - 1)
        ReDim boxX(0 To n - 1)
        ReDim boxY(0 To n - 1)
        ReDim boxRows(0 To n - 1)

        For t = 0 To n - 1
            parts = Split(tables(t), "|")
            keys(t) = vbNullString
            srcName = vbNullString
            If UBound(parts) >= 0 Then keys(t) = parts(0)
            If UBound(parts) >= 1 Then srcName = parts(1) Else srcName = keys(t)
            fieldCount = StudioController.GetTableFieldNames(srcName, fieldNames)
            ' Row list: "*" then the fields
            lists(t) = "*"
            For k = 0 To fieldCount - 1
                lists(t) = lists(t) & vbTab & fieldNames(k)
            Next k
            visRows = fieldCount + 1
            If visRows > QD_BOX_MAX_ROWS Then visRows = QD_BOX_MAX_ROWS
            boxRows(t) = visRows
            bx = GetTableBoxX(t)
            by = GetTableBoxY(t)
            boxX(t) = bx
            boxY(t) = by
            bh = QD_BOX_TITLE_PX + visRows * QD_BOX_ROW_PX + 4

            On Error Resume Next
            ' Box body, title bar and border
            pic.Line (bx, by)-(bx + QD_BOX_W_PX - 1, by + bh - 1), &HFFFFFF&, BF
            pic.Line (bx, by)-(bx + QD_BOX_W_PX - 1, by + QD_BOX_TITLE_PX - 1), &HF0D9C6&, BF
            pic.Line (bx, by + QD_BOX_TITLE_PX - 1)-(bx + QD_BOX_W_PX - 1, by + QD_BOX_TITLE_PX - 1), &HA0A0A0&
            pic.Line (bx, by)-(bx + QD_BOX_W_PX - 1, by + bh - 1), &H808080&, B

            ' Draw table title text
            pic.FontBold = True
            pic.ForeColor = &H202020&
            On Error GoTo 0
            PrintQueryDesignText pic, bx + 6, by + 3, QD_BOX_W_PX - 26, keys(t)

            ' Draw Red Close Button [X] (14x14 px) on table header
            Dim closeX As Long, closeY As Long
            closeX = bx + QD_BOX_W_PX - 18
            closeY = by + (QD_BOX_TITLE_PX - 14) \ 2
            pic.Line (closeX, closeY)-(closeX + 13, closeY + 13), &H2020C0&, BF
            pic.Line (closeX, closeY)-(closeX + 13, closeY + 13), &H808080&, B
            pic.Line (closeX + 3, closeY + 3)-(closeX + 10, closeY + 10), &HFFFFFF&
            pic.Line (closeX + 10, closeY + 3)-(closeX + 3, closeY + 10), &HFFFFFF&

            On Error Resume Next
            pic.FontBold = False
            On Error GoTo 0
            parts = Split(lists(t), vbTab)
            For k = 0 To visRows - 1
                rowY = by + QD_BOX_TITLE_PX + 2 + k * QD_BOX_ROW_PX
                Dim isPk As Boolean
                isPk = False
                If k > 0 Then isPk = IsPrimaryKeyField(srcName, parts(k))
                If isPk Then
                    pic.FontBold = True
                    pic.ForeColor = &H0060C0&  ' Golden amber PK badge
                    PrintQueryDesignText pic, bx + 6, rowY + 1, 28, "[PK]"
                    pic.FontBold = False
                    pic.ForeColor = &H202020&
                    PrintQueryDesignText pic, bx + 36, rowY + 1, QD_BOX_W_PX - 42, parts(k)
                Else
                    pic.ForeColor = &H202020&
                    PrintQueryDesignText pic, bx + 8, rowY + 1, QD_BOX_W_PX - 16, parts(k)
                End If
            Next k
            If fieldCount + 1 > visRows Then
                On Error Resume Next
                pic.Line (bx + QD_BOX_W_PX - 10, by + QD_BOX_TITLE_PX)-(bx + QD_BOX_W_PX - 2, by + bh - 2), &HE6E6E6&, BF
                pic.Line (bx + QD_BOX_W_PX - 10, by + QD_BOX_TITLE_PX)-(bx + QD_BOX_W_PX - 2, by + QD_BOX_TITLE_PX + 24), &HB0B0B0&, BF
                On Error GoTo 0
            End If
        Next t

        ' Join lines
        Dim uJn As Long
        On Error Resume Next
        uJn = -1
        uJn = UBound(joins)
        On Error GoTo 0
        If uJn < 0 Then Exit Sub

        For j = 0 To uJn
            parts = Split(joins(j), "|")
            If UBound(parts) >= 3 Then
                ia = QdTableIndex(keys, parts(0))
                ib = QdTableIndex(keys, parts(2))
                If ia >= 0 And ib >= 0 And ia <> ib Then
                    jType = vbNullString
                    If UBound(parts) >= 4 Then jType = UCase$(parts(4))
                    ya = boxY(ia) + QD_BOX_TITLE_PX + 2 + QdFieldRow(lists(ia), parts(1), boxRows(ia)) * QD_BOX_ROW_PX + QD_BOX_ROW_PX \ 2
                    yb = boxY(ib) + QD_BOX_TITLE_PX + 2 + QdFieldRow(lists(ib), parts(3), boxRows(ib)) * QD_BOX_ROW_PX + QD_BOX_ROW_PX \ 2
                    arrowAtB = (jType = "LEFT")
                    arrowAtA = (jType = "RIGHT")
                    aLeft = (boxX(ia) <= boxX(ib))
                    If aLeft Then
                        x1 = boxX(ia) + QD_BOX_W_PX
                        y1 = ya
                        x2 = boxX(ib) - 1
                        y2 = yb
                    Else
                        x1 = boxX(ib) + QD_BOX_W_PX
                        y1 = yb
                        x2 = boxX(ia) - 1
                        y2 = ya
                    End If
                    Dim lineClr As Long
                    lineClr = &H000000&
                    On Error Resume Next
                    If j = m_qbeSelectedJoinIdx Then
                        lineClr = &H0020D0&
                        pic.DrawWidth = 2
                    Else
                        pic.DrawWidth = 1
                    End If
                    pic.Line (x1, y1)-(x1 + QD_JOIN_STUB_PX, y1), lineClr
                    pic.Line (x1 + QD_JOIN_STUB_PX, y1)-(x2 - QD_JOIN_STUB_PX, y2), lineClr
                    pic.Line (x2 - QD_JOIN_STUB_PX, y2)-(x2, y2), lineClr
                    pic.DrawWidth = 1
                    On Error GoTo 0

                    ' Draw 1 and oo (infinity) indicators at endpoints (parts(0)=Primary '1', parts(2)=Foreign 'oo')
                    Dim pkA As Boolean, pkB As Boolean
                    Dim lblA As String, lblB As String
                    If jType = "ONE_TO_MANY" Or m_currentWorkspaceMode = 8 Then
                        lblA = "1"
                        lblB = IIf(jType = "ONE_TO_ONE", "1", "oo")
                    ElseIf jType = "ONE_TO_ONE" Then
                        lblA = "1"
                        lblB = "1"
                    Else
                        pkA = IsPrimaryKeyField(keys(ia), parts(1))
                        pkB = IsPrimaryKeyField(keys(ib), parts(3))
                        If pkA And Not pkB Then
                            lblA = "1": lblB = "oo"
                        ElseIf pkB And Not pkA Then
                            lblA = "oo": lblB = "1"
                        Else
                            lblA = "1": lblB = "oo"
                        End If
                    End If

                    pic.FontBold = True
                    pic.ForeColor = &H0000A0&
                    If aLeft Then
                        PrintQueryDesignText pic, x1 + 4, y1 - 14, 18, lblA
                        PrintQueryDesignText pic, x2 - 20, y2 - 14, 18, lblB
                    Else
                        PrintQueryDesignText pic, x1 + 4, y1 - 14, 18, lblB
                        PrintQueryDesignText pic, x2 - 20, y2 - 14, 18, lblA
                    End If
                    pic.FontBold = False
                    pic.ForeColor = &H202020&

                    ' Arrowhead for LEFT / RIGHT joins
                    If (arrowAtB And aLeft) Or (arrowAtA And Not aLeft) Then
                        PaintQueryJoinArrow pic, x2, y2, 1
                    ElseIf (arrowAtA And aLeft) Or (arrowAtB And Not aLeft) Then
                        PaintQueryJoinArrow pic, x1, y1, -1
                    End If
                End If
            End If
        Next j
    End Sub

    ' Arrowhead with its tip at (x, y) pointing right (dirX = 1) or left (dirX = -1).
    Private Sub PaintQueryJoinArrow(ByVal pic As PictureBox, ByVal x As Long, ByVal y As Long, ByVal dirX As Long)
        On Error Resume Next
        pic.Line (x, y)-(x - dirX * 7, y - 4), &H000000&
        pic.Line (x, y)-(x - dirX * 7, y + 4), &H000000&
        pic.Line (x - dirX * 7, y - 4)-(x - dirX * 7, y + 5), &H000000&
        On Error GoTo 0
    End Sub

    ' Index of key in keys (case-insensitive, brackets ignored), -1 when missing.
    Private Function QdTableIndex(ByRef keys() As String, ByVal key As String) As Long
        Dim i As Long
        Dim k As String

        QdTableIndex = -1
        k = UCase$(Replace(Replace(key, "[", ""), "]", ""))
        For i = 0 To UBound(keys)
            If UCase$(keys(i)) = k Then
                QdTableIndex = i
                Exit Function
            End If
        Next i
    End Function

    ' Visible row of fieldName in a box row list ("*" + vbTab + fields). Fields below the
    ' visible rows map to the last visible row; unknown fields map to the "*" row.
    Private Function QdFieldRow(ByVal rowList As String, ByVal fieldName As String, ByVal visRows As Long) As Long
        Dim parts() As String
        Dim i As Long
        Dim f As String

        QdFieldRow = 0
        parts = Split(rowList, vbTab)
        f = UCase$(Replace(Replace(fieldName, "[", ""), "]", ""))
        For i = 1 To UBound(parts)
            If UCase$(parts(i)) = f Then
                QdFieldRow = i
                Exit For
            End If
        Next i
        If visRows < 1 Then visRows = 1
        If QdFieldRow > visRows - 1 Then QdFieldRow = visRows - 1
    End Function

    ' Lower Design View pane: the QBE grid. A row header column (Field:, Table:, Sort:,
    ' Show:, Criteria:, or:) and one 120 px column per output field; the remaining width is
    ' filled with empty columns as in Access. Show is a 12 px checkbox, checked when show = 1.
    '   cols: "field|table|sort|show|criteria|or"
        Private Sub PaintQbeGrid(ByVal pic As PictureBox, ByRef cols() As String)
        Dim cw As Long
        Dim n As Long
        Dim c As Long
        Dim r As Long
        Dim x As Long
        Dim y As Long
        Dim colCount As Long
        Dim parts() As String
        Dim labels() As String
        Dim cellText As String
        Dim bx As Long
        Dim by As Long
        Dim isOn As Boolean
        Dim uCol As Long

        If pic Is Nothing Then Exit Sub
        PrepareQueryDesignSurface pic, &HFFFFFF&
        On Error Resume Next
        cw = pic.ScaleWidth
        On Error GoTo 0
        If cw <= 0 Then cw = 970

        labels = Split("Field:|Table:|Sort:|Show:|Criteria:|or:", "|")
        On Error Resume Next
        uCol = -1
        uCol = UBound(cols)
        On Error GoTo 0

        If uCol >= 0 Then n = uCol + 1 Else n = 0
        colCount = n
        If QD_QBE_HEADER_W_PX + colCount * QD_QBE_COL_W_PX < cw Then
            colCount = colCount + (cw - QD_QBE_HEADER_W_PX - colCount * QD_QBE_COL_W_PX + QD_QBE_COL_W_PX - 1) \ QD_QBE_COL_W_PX
        End If

        On Error Resume Next
        ' Row header column
        pic.Line (0, 0)-(QD_QBE_HEADER_W_PX - 1, QD_QBE_TOP_PX + 6 * QD_QBE_ROW_PX), &HF3F3F3&, BF
        pic.FontBold = True
        pic.ForeColor = &H202020&
        For r = 0 To 5
            y = QD_QBE_TOP_PX + r * QD_QBE_ROW_PX
            pic.CurrentX = 6
            pic.CurrentY = y + 3
            pic.Print labels(r)
        Next r
        pic.FontBold = False
        On Error GoTo 0

        For c = 0 To colCount - 1
            x = QD_QBE_HEADER_W_PX + c * QD_QBE_COL_W_PX
            If x >= cw Then Exit For
            If c < n Then
                parts = Split(cols(c) & "|||||", "|")
            Else
                parts = Split("|||||", "|")
            End If
            On Error Resume Next
            ' Column selector bar with [x] delete button
            pic.Line (x, 0)-(x + QD_QBE_COL_W_PX - 1, QD_QBE_TOP_PX - 1), &HE6E6E6&, BF
            pic.Line (x, 0)-(x + QD_QBE_COL_W_PX - 1, QD_QBE_TOP_PX - 1), &HA0A0A0&, B
            If c < n Then
                pic.ForeColor = &H606060&
                PrintQueryDesignText pic, x + QD_QBE_COL_W_PX - 18, 0, 16, "[x]"
                pic.ForeColor = &H202020&
            End If
            On Error GoTo 0

            For r = 0 To 5
                y = QD_QBE_TOP_PX + r * QD_QBE_ROW_PX
                On Error Resume Next
                pic.Line (x, y)-(x + QD_QBE_COL_W_PX - 1, y + QD_QBE_ROW_PX - 1), &HC8C8C8&, B
                pic.ForeColor = &H202020&
                On Error GoTo 0
                If r = 3 Then
                    If c < n Then
                        isOn = (parts(3) = "1")
                        bx = x + (QD_QBE_COL_W_PX - 12) \ 2
                        by = y + (QD_QBE_ROW_PX - 12) \ 2
                        On Error Resume Next
                        pic.Line (bx, by)-(bx + 11, by + 11), &HFFFFFF&, BF
                        pic.Line (bx, by)-(bx + 11, by + 11), &H808080&, B
                        If isOn Then
                            pic.Line (bx + 2, by + 6)-(bx + 4, by + 9), &H202020&
                            pic.Line (bx + 4, by + 9)-(bx + 10, by + 2), &H202020&
                        End If
                        On Error GoTo 0
                    End If
                Else
                    cellText = parts(r)
                    If Len(cellText) > 0 Then
                        PrintQueryDesignText pic, x + 4, y + 3, QD_QBE_COL_W_PX - 18, cellText
                    End If
                    ' Draw dropdown glyph 'v' on Field (0), Table (1), and Sort (2)
                    If r = 0 Or r = 1 Or r = 2 Then
                        Dim arrowX As Long, arrowY As Long
                        arrowX = x + QD_QBE_COL_W_PX - 12
                        arrowY = y + 7
                        On Error Resume Next
                        pic.Line (arrowX, arrowY)-(arrowX + 6, arrowY), &H808080&
                        pic.Line (arrowX + 1, arrowY + 1)-(arrowX + 5, arrowY + 1), &H808080&
                        pic.Line (arrowX + 2, arrowY + 2)-(arrowX + 4, arrowY + 2), &H808080&
                        pic.PSet (arrowX + 3, arrowY + 3), &H808080&
                        On Error GoTo 0
                    End If
                End If
            Next r
        Next c

        ' Header column right border and outer grid border
        On Error Resume Next
        pic.Line (QD_QBE_HEADER_W_PX - 1, 0)-(QD_QBE_HEADER_W_PX - 1, QD_QBE_TOP_PX + 6 * QD_QBE_ROW_PX), &HA0A0A0&
        pic.Line (0, QD_QBE_TOP_PX + 6 * QD_QBE_ROW_PX)-(cw, QD_QBE_TOP_PX + 6 * QD_QBE_ROW_PX), &HA0A0A0&
        On Error GoTo 0
    End Sub

    ' -------------------------------------------------------------------------
    ' Interactive Form Designer, Control Wizard, QBE Designer & VBE Runners
    ' -------------------------------------------------------------------------
    Private Sub btnCreateFormWiz_Click()
        Dim curTable As String
        Dim formName As String
        Dim recSource As String
        Dim btnCap As String
        Dim btnVba As String
        Dim formDef As String
        Dim vbaModCode As String
        Dim errMsg As String
        Dim ok As Boolean

        If Not StudioController.IsDatabaseOpen() Then
            MsgBox "Please open a database first.", vbInformation, "Create New Form Wizard"
            Exit Sub
        End If

        curTable = StudioController.GetActiveTableName()
        If Len(curTable) = 0 Or curTable = "SQL Query Result" Then curTable = "Customers"

        formName = InputBox("Create New Access Form (Step 1/4)" & vbCrLf & "Enter a name for the new Form:", "Create Form Wizard", "Form_" & curTable)
        formName = Trim$(formName)
        If Len(formName) = 0 Then Exit Sub

        recSource = InputBox("Create New Access Form (Step 2/4)" & vbCrLf & "Enter RecordSource Table or Query name:", "Create Form Wizard", curTable)
        recSource = Trim$(recSource)
        If Len(recSource) = 0 Then Exit Sub

        btnCap = InputBox("Create New Access Form (Step 3/4)" & vbCrLf & "Enter optional CommandButton Caption on Form (or leave blank):", "Create Form Wizard", "CALL MODULE")
        btnCap = Trim$(btnCap)

        If Len(btnCap) > 0 Then
            btnVba = InputBox("Create New Access Form (Step 4/4)" & vbCrLf & "Enter VBA OnClick statement for button [" & btnCap & "] (e.g. Call ayman or MsgBox ""Hello""):", "Create Form Wizard", "Call ayman")
        End If

        formDef = "AutoFormLayout|" & recSource & "|Button=" & btnCap & "|OnClick=" & btnVba
        ok = StudioController.SaveCustomAccessObject("FORM", formName, recSource, formDef, errMsg)
        If ok Then
            If Len(btnCap) > 0 And Len(Trim$(btnVba)) > 0 Then
                vbaModCode = "Option Compare Database" & vbCrLf & vbCrLf & "Private Sub Command1_Click()" & vbCrLf & "    " & Trim$(btnVba) & vbCrLf & "End Sub"
                StudioController.SaveCustomAccessObject "MODULE", "Form_" & formName, "VBA", vbaModCode, errMsg
            End If
            RefreshNavigationPane
            StudioController.OpenTable recSource, errMsg
            StudioController.SetActiveFormName formName
            StudioController.SetViewMode 2
            DisplayFormView recSource
            If Len(btnCap) > 0 Then
                btnFormCmd.Caption = btnCap
            End If
            SyncVisualFormControlsAndVbe
            MsgBox "New Form [" & formName & "] bound to [" & recSource & "] created and opened in Form View!", vbInformation, "Form Created"
        Else
            MsgBox "Error creating form: " & errMsg, vbCritical, "Form Wizard Error"
        End If
    End Sub

    Private Sub btnAddCtrlWiz_Click()
        Dim ctrlType As String
        Dim ctrlName As String
        Dim ctrlCap As String
        Dim ctrlVba As String
        Dim curForm As String
        Dim curTable As String
        Dim errMsg As String
        Dim vbaCode As String

        If Not StudioController.IsDatabaseOpen() Then
            MsgBox "Please open a database first.", vbInformation, "Add Form Control Wizard"
            Exit Sub
        End If

        curForm = StudioController.GetActiveFormName()
        curTable = StudioController.GetActiveTableName()
        If Len(curForm) = 0 Then curForm = "Form_" & curTable

        ctrlType = InputBox("Add Control to Form [" & curForm & "]:" & vbCrLf & "1 = CommandButton (with VBA OnClick Event)" & vbCrLf & "2 = Bound TextBox / Field Column" & vbCrLf & "3 = Lookup ComboBox Control", "Form Control Toolbox", "1")
        ctrlType = Trim$(ctrlType)
        If Len(ctrlType) = 0 Then Exit Sub

        If ctrlType = "1" Then
            ctrlName = InputBox("Enter CommandButton Control Name:", "Add CommandButton (1/3)", "Command2")
            If Len(Trim$(ctrlName)) = 0 Then Exit Sub
            ctrlCap = InputBox("Enter CommandButton Caption:", "Add CommandButton (2/3)", "CALL MODULE")
            If Len(Trim$(ctrlCap)) = 0 Then Exit Sub
            ctrlVba = InputBox("Enter VBA code for " & Trim$(ctrlName) & "_Click():", "Add CommandButton (3/3)", "Call ayman")

            btnFormCmd.Caption = Trim$(ctrlCap)
            vbaCode = "Option Compare Database" & vbCrLf & vbCrLf & "Private Sub " & Trim$(ctrlName) & "_Click()" & vbCrLf & "    " & Trim$(ctrlVba) & vbCrLf & "End Sub"
            txtVbeObj.Text = Trim$(ctrlName)
            txtVbeProc.Text = "Click"
            lstVbaCode.Clear
            lstVbaCode.AddItem "Option Compare Database"
            lstVbaCode.AddItem ""
            lstVbaCode.AddItem "Private Sub " & Trim$(ctrlName) & "_Click()"
            lstVbaCode.AddItem "    " & Trim$(ctrlVba)
            lstVbaCode.AddItem "End Sub"
            txtVbaCode.Text = Trim$(ctrlVba)
            StudioController.SaveCustomAccessObject "MODULE", "Form_" & curForm, "VBA", vbaCode, errMsg
            lblStatus.Caption = "Added CommandButton [" & Trim$(ctrlName) & "] ('" & Trim$(ctrlCap) & "') to [" & curForm & "]."
            MsgBox "CommandButton [" & Trim$(ctrlName) & "] with caption '" & Trim$(ctrlCap) & "' added to Form [" & curForm & "]!", vbInformation, "Control Added"
        ElseIf ctrlType = "2" Then
            btnModifySchema_Click
        ElseIf ctrlType = "3" Then
            btnLookupDrop_Click
        End If
    End Sub

    Private Sub btnQbeDesign_Click()
        Dim curObj As String
        curObj = ResolveActiveQueryName()
        OpenQbeDesigner curObj
    End Sub

    Public Sub OpenQbeDesigner(ByVal objName As String)
        Dim savedSql As String
        Dim sqlErr As String
        Dim errMsg As String
        Dim ok As Boolean
        Dim fNames() As String
        Dim fCount As Long
        Dim k As Long
        Dim curTable As String

        If Not StudioController.IsDatabaseOpen() Then
            MsgBox "Please open a database first.", vbInformation, "Access QBE Query Designer"
            Exit Sub
        End If

        curTable = Trim$(objName)
        If Len(curTable) = 0 Or curTable = "SQL Query Result" Then
            curTable = StudioController.GetActiveTableName()
            If Len(curTable) = 0 Or curTable = "SQL Query Result" Then
                StartNewVisualQueryDesigner
                Exit Sub
            End If
        End If

        m_activeQueryName = curTable
        Erase m_qbeBoxX
        Erase m_qbeBoxY
        m_qbeSelectedJoinIdx = -1
        SwitchWorkspaceMode 12
        UpdateRibbonToolbar "QUERY"
        lblTableTitle.Caption = curTable

        ' 1. Check if it is a saved query
        savedSql = StudioController.GetSavedQuerySql(curTable, sqlErr)
        If Len(sqlErr) = 0 And Len(savedSql) > 0 Then
            ok = StudioController.GetQueryDesignModel(curTable, m_qbeTables, m_qbeJoins, m_qbeCols, errMsg)
            If ok Then
                m_qbeColCount = UBound(m_qbeCols) + 1
                txtSql.Text = StudioController.FormatSqlForDisplay(savedSql, True)
                PaintQueryTables picQryTables, m_qbeTables, m_qbeJoins
                PaintQbeGrid picQbeGrid, m_qbeCols
                lblStatus.Caption = "Query Tools: [" & curTable & "] | Design View | " & CStr(UBound(m_qbeTables) + 1) & " table(s), " & CStr(m_qbeColCount) & " column(s)"
                Exit Sub
            End If
        End If

        ' 2. If it is a table or new object
        m_activeQueryName = GetNextAvailableQueryName()
        lblTableTitle.Caption = m_activeQueryName
        fCount = StudioController.GetTableFieldNames(curTable, fNames)
        If fCount = 0 Then
            Dim tblCol As Collection
            Set tblCol = StudioController.GetTableNames()
            If tblCol.Count > 0 Then
                curTable = CStr(tblCol(1))
                fCount = StudioController.GetTableFieldNames(curTable, fNames)
            End If
        End If

        ReDim m_qbeTables(0 To 0)
        m_qbeTables(0) = curTable
        Erase m_qbeJoins

        If fCount > 0 Then
            ReDim m_qbeCols(0 To fCount - 1)
            For k = 0 To fCount - 1
                m_qbeCols(k) = fNames(k) & "|" & curTable & "||1||"
            Next k
            m_qbeColCount = fCount
        Else
            ReDim m_qbeCols(0 To 0)
            m_qbeCols(0) = "*|" & curTable & "||1||"
            m_qbeColCount = 1
        End If

        RebuildSqlFromQbeGrid
        PaintQueryTables picQryTables, m_qbeTables, m_qbeJoins
        PaintQbeGrid picQbeGrid, m_qbeCols
        lblStatus.Caption = "Query Tools: [" & curTable & "] | Interactive QBE Designer | " & CStr(m_qbeColCount) & " column(s)"
    End Sub

    Public Sub PopulateQueryAddTablesPane()
        Dim tList As Collection
        Dim qList As Collection
        Dim itemVal As Variant

        lstPropSheet.Clear
        If Not StudioController.IsDatabaseOpen() Then Exit Sub

        Set tList = StudioController.GetTableNames()
        If Not tList Is Nothing Then
            For Each itemVal In tList
                lstPropSheet.AddItem "[Table] " & CStr(itemVal)
            Next itemVal
        End If

        Set qList = StudioController.GetQueryNames()
        If Not qList Is Nothing Then
            For Each itemVal In qList
                lstPropSheet.AddItem "[Query] " & CStr(itemVal)
            Next itemVal
        End If
    End Sub

    Private Sub QbeAddTable(ByVal tableName As String)
        Dim cleanName As String
        cleanName = Trim$(tableName)
        If Left$(cleanName, 8) = "[Table] " Then
            cleanName = Mid$(cleanName, 9)
        ElseIf Left$(cleanName, 8) = "[Query] " Then
            cleanName = Mid$(cleanName, 9)
        End If
        cleanName = Replace$(Replace$(cleanName, "[", ""), "]", "")
        If Len(cleanName) = 0 Then Exit Sub

        Dim uTb As Long
        On Error Resume Next
        uTb = -1
        uTb = UBound(m_qbeTables)
        On Error GoTo 0

        Dim t As Long
        Dim countExisting As Long
        countExisting = 0
        If uTb >= 0 Then
            For t = 0 To uTb
                Dim tParts() As String
                tParts = Split(m_qbeTables(t), "|")
                Dim baseName As String
                If UBound(tParts) >= 1 Then baseName = tParts(1) Else baseName = tParts(0)
                If StrComp(baseName, cleanName, vbTextCompare) = 0 Then
                    countExisting = countExisting + 1
                End If
            Next t
        End If

        Dim tableEntry As String
        If countExisting > 0 Then
            If m_currentWorkspaceMode = 8 Then
                lblStatus.Caption = "Table [" & cleanName & "] is already shown on the Relationships canvas."
                Exit Sub
            End If
            Dim aliasName As String
            aliasName = cleanName & "_" & CStr(countExisting)
            tableEntry = aliasName & "|" & cleanName
        Else
            tableEntry = cleanName
        End If

        Dim addedSlot As Long
        If uTb < 0 Then
            ReDim m_qbeTables(0 To 0)
            m_qbeTables(0) = tableEntry
            addedSlot = 0
        Else
            ReDim Preserve m_qbeTables(0 To uTb + 1)
            m_qbeTables(uTb + 1) = tableEntry
            addedSlot = uTb + 1
        End If
        If addedSlot >= 0 And addedSlot <= 63 Then
            m_qbeBoxX(addedSlot) = 0
            m_qbeBoxY(addedSlot) = 0
        End If

        ' Auto-detect relationships with existing tables
        AutoDetectTableJoins cleanName

        ' If first table and grid empty, populate default columns
        If uTb < 0 And m_qbeColCount = 0 Then
            Dim fNames() As String
            Dim fCount As Long
            fCount = StudioController.GetTableFieldNames(cleanName, fNames)
            If fCount > 0 Then
                ReDim m_qbeCols(0 To fCount - 1)
                Dim k As Long
                For k = 0 To fCount - 1
                    m_qbeCols(k) = fNames(k) & "|" & cleanName & "||1||"
                Next k
                m_qbeColCount = fCount
            Else
                ReDim m_qbeCols(0 To 0)
                m_qbeCols(0) = "*|" & cleanName & "||1||"
                m_qbeColCount = 1
            End If
        End If

        PaintQueryTables picQryTables, m_qbeTables, m_qbeJoins
        If m_currentWorkspaceMode = 8 Then
            lblStatus.Caption = "Added table [" & cleanName & "] to Relationships canvas. Drag its title bar to move, or drag a field to link."
            Exit Sub
        End If
        PaintQbeGrid picQbeGrid, m_qbeCols
        RebuildSqlFromQbeGrid
        lblStatus.Caption = "Added table [" & cleanName & "] to Query Designer."
    End Sub

    Private Sub QbeRemoveTable(ByVal tableIdx As Long)
        Dim uTb As Long
        On Error Resume Next
        uTb = -1
        uTb = UBound(m_qbeTables)
        On Error GoTo 0
        If tableIdx < 0 Or tableIdx > uTb Then Exit Sub

        Dim delTableEntry As String
        Dim delTableKey As String
        delTableEntry = m_qbeTables(tableIdx)
        delTableKey = Split(delTableEntry, "|")(0)

        ' 1. Remove from m_qbeTables
        Dim i As Long
        Dim newTables() As String
        Dim newCount As Long
        newCount = 0
        For i = 0 To uTb
            If i <> tableIdx Then
                ReDim Preserve newTables(0 To newCount)
                newTables(newCount) = m_qbeTables(i)
                If newCount <= 63 And i <= 63 Then
                    m_qbeBoxX(newCount) = m_qbeBoxX(i)
                    m_qbeBoxY(newCount) = m_qbeBoxY(i)
                End If
                newCount = newCount + 1
            End If
        Next i
        If newCount <= 63 Then
            m_qbeBoxX(newCount) = 0
            m_qbeBoxY(newCount) = 0
        End If
        If newCount = 0 Then
            Erase m_qbeTables
        Else
            m_qbeTables = newTables
        End If

        ' 2. Remove joins involving delTableKey
        Dim j As Long
        Dim jParts() As String
        Dim newJoins() As String
        Dim newJoinCount As Long
        newJoinCount = 0
        Dim uJn As Long
        On Error Resume Next
        uJn = -1
        uJn = UBound(m_qbeJoins)
        On Error GoTo 0

        If uJn >= 0 Then
            For j = 0 To uJn
                jParts = Split(m_qbeJoins(j), "|")
                If UBound(jParts) >= 3 Then
                    If StrComp(jParts(0), delTableKey, vbTextCompare) <> 0 And StrComp(jParts(2), delTableKey, vbTextCompare) <> 0 Then
                        ReDim Preserve newJoins(0 To newJoinCount)
                        newJoins(newJoinCount) = m_qbeJoins(j)
                        newJoinCount = newJoinCount + 1
                    End If
                End If
            Next j
            If newJoinCount = 0 Then
                Erase m_qbeJoins
            Else
                m_qbeJoins = newJoins
            End If
        End If

        ' 3. Remove columns belonging to delTableKey
        Dim c As Long
        Dim cParts() As String
        Dim newCols() As String
        Dim newColCount As Long
        newColCount = 0
        Dim uCol As Long
        On Error Resume Next
        uCol = -1
        uCol = UBound(m_qbeCols)
        On Error GoTo 0

        If uCol >= 0 Then
            For c = 0 To uCol
                cParts = Split(m_qbeCols(c) & "|||||", "|")
                If StrComp(cParts(1), delTableKey, vbTextCompare) <> 0 Then
                    ReDim Preserve newCols(0 To newColCount)
                    newCols(newColCount) = m_qbeCols(c)
                    newColCount = newColCount + 1
                End If
            Next c
            If newColCount = 0 Then
                Erase m_qbeCols
                m_qbeColCount = 0
            Else
                m_qbeCols = newCols
                m_qbeColCount = newColCount
            End If
        End If

        PaintQueryTables picQryTables, m_qbeTables, m_qbeJoins
        PaintQbeGrid picQbeGrid, m_qbeCols
        RebuildSqlFromQbeGrid
        lblStatus.Caption = "Removed table [" & delTableKey & "] from query."
    End Sub

    Private Function IsPrimaryKeyField(ByVal tableName As String, ByVal fieldName As String) As Boolean
        Dim uFld As String
        Dim uTbl As String
        Dim uStem As String
        uFld = UCase$(Trim$(Replace(Replace(fieldName, "[", ""), "]", "")))
        uTbl = UCase$(Trim$(Replace(Replace(tableName, "[", ""), "]", "")))

        If uFld = "ID" Or uFld = "PK" Or uFld = uTbl & "ID" Or uFld = uTbl & "_ID" Then
            IsPrimaryKeyField = True
            Exit Function
        End If
        If Right$(uTbl, 3) = "IES" And Len(uTbl) > 3 Then
            uStem = Left$(uTbl, Len(uTbl) - 3) & "Y"
            If uFld = uStem & "ID" Or uFld = uStem & "_ID" Then
                IsPrimaryKeyField = True
                Exit Function
            End If
        ElseIf Right$(uTbl, 1) = "S" And Len(uTbl) > 1 Then
            uStem = Left$(uTbl, Len(uTbl) - 1)
            If uFld = uStem & "ID" Or uFld = uStem & "_ID" Then
                IsPrimaryKeyField = True
                Exit Function
            End If
        End If

        On Error Resume Next
        If Not StudioController.ActiveDatabase Is Nothing Then
            Dim rIdx As Long
            Dim rObj As Object
            For rIdx = 0 To StudioController.ActiveDatabase.Relations.Count - 1
                Set rObj = StudioController.ActiveDatabase.Relations.Item(rIdx)
                If Not rObj Is Nothing Then
                    If StrComp(Trim$(rObj.Table), uTbl, vbTextCompare) = 0 And rObj.Fields.Count > 0 Then
                        If StrComp(Trim$(rObj.Fields(0).Name), uFld, vbTextCompare) = 0 Then
                            IsPrimaryKeyField = True
                            On Error GoTo 0
                            Exit Function
                        End If
                    End If
                End If
            Next rIdx

            Dim td As Object
            Set td = StudioController.ActiveDatabase.TableDefs(tableName)
            If Not td Is Nothing Then
                Dim idx As Object
                Dim i As Long
                For i = 0 To td.Indexes.Count - 1
                    Set idx = td.Indexes(i)
                    If idx.Primary Or (idx.Unique And Not idx.Foreign) Then
                        If UCase$(Trim$(idx.Fields(0).Name)) = uFld Then
                            IsPrimaryKeyField = True
                            On Error GoTo 0
                            Exit Function
                        End If
                    End If
                Next i
                If td.Fields.Count > 0 Then
                    If UCase$(Trim$(td.Fields(0).Name)) = uFld And Right$(uFld, 2) = "ID" Then
                        IsPrimaryKeyField = True
                        On Error GoTo 0
                        Exit Function
                    End If
                End If
            End If
        End If
        On Error GoTo 0
        IsPrimaryKeyField = False
    End Function

    Private Sub AutoDetectTableJoins(ByVal newTable As String)
        Dim uTb As Long
        On Error Resume Next
        uTb = -1
        uTb = UBound(m_qbeTables)
        On Error GoTo 0
        If uTb < 1 Then Exit Sub

        Dim newTableEntry As String
        Dim newTableKey As String
        Dim newBaseTable As String
        newTableEntry = m_qbeTables(uTb)
        newTableKey = Split(newTableEntry, "|")(0)
        If UBound(Split(newTableEntry, "|")) >= 1 Then newBaseTable = Split(newTableEntry, "|")(1) Else newBaseTable = newTable

        Dim prevT As Long
        Dim prevTableEntry As String, prevTable As String, prevBaseTable As String
        Dim newFields() As String, newCount As Long
        Dim prevFields() As String, prevCount As Long
        Dim k1 As Long, k2 As Long
        Dim joinStr As String
        Dim foundJoin As Boolean

        newCount = StudioController.GetTableFieldNames(newBaseTable, newFields)
        If newCount = 0 Then Exit Sub

        For prevT = 0 To uTb - 1
            prevTableEntry = m_qbeTables(prevT)
            prevTable = Split(prevTableEntry, "|")(0)
            If UBound(Split(prevTableEntry, "|")) >= 1 Then prevBaseTable = Split(prevTableEntry, "|")(1) Else prevBaseTable = prevTable

            If StrComp(prevTable, newTableKey, vbTextCompare) <> 0 Then
                foundJoin = False
                prevCount = StudioController.GetTableFieldNames(prevBaseTable, prevFields)

                ' 1. Check formal DAO Relations (MSysRelationships)
                On Error Resume Next
                If Not StudioController.ActiveDatabase Is Nothing Then
                    Dim rels As Object
                    Set rels = Nothing
                    Set rels = StudioController.ActiveDatabase.Relations
                    If Not rels Is Nothing Then
                        Dim rIdx As Long
                        Dim relObj As Object
                        For rIdx = 0 To rels.Count - 1
                            Set relObj = Nothing
                            Set relObj = rels.Item(rIdx)
                            If Not relObj Is Nothing Then
                                If relObj.Fields.Count > 0 Then
                                    If (StrComp(relObj.Table, prevBaseTable, vbTextCompare) = 0 And StrComp(relObj.ForeignTable, newBaseTable, vbTextCompare) = 0) Then
                                        joinStr = prevTable & "|" & relObj.Fields(0).Name & "|" & newTableKey & "|" & relObj.Fields(0).ForeignName & "|INNER"
                                        foundJoin = True
                                        Exit For
                                    ElseIf (StrComp(relObj.Table, newBaseTable, vbTextCompare) = 0 And StrComp(relObj.ForeignTable, prevBaseTable, vbTextCompare) = 0) Then
                                        joinStr = prevTable & "|" & relObj.Fields(0).ForeignName & "|" & newTableKey & "|" & relObj.Fields(0).Name & "|INNER"
                                        foundJoin = True
                                        Exit For
                                    End If
                                End If
                            End If
                        Next rIdx

                        ' 1b. If one side is a saved Query exposing a specific Foreign Key column from MSysRelationships (not generic ID/PK)
                        If Not foundJoin And m_currentWorkspaceMode <> 8 Then
                            For rIdx = 0 To rels.Count - 1
                                Set relObj = Nothing
                                Set relObj = rels.Item(rIdx)
                                If Not relObj Is Nothing Then
                                    If relObj.Fields.Count > 0 Then
                                        Dim relPkTbl As String, relPkFld As String, relFkFld As String
                                        relPkTbl = Trim$(relObj.Table)
                                        relPkFld = Trim$(relObj.Fields(0).Name)
                                        relFkFld = Trim$(relObj.Fields(0).ForeignName)
                                        If UCase$(relFkFld) <> "ID" And UCase$(relFkFld) <> "PK" Then
                                            If StrComp(relPkTbl, newBaseTable, vbTextCompare) = 0 And StrComp(relPkTbl, prevBaseTable, vbTextCompare) <> 0 Then
                                                For k1 = 0 To prevCount - 1
                                                    If StrComp(Trim$(prevFields(k1)), relFkFld, vbTextCompare) = 0 And Not IsPrimaryKeyField(prevBaseTable, prevFields(k1)) Then
                                                        joinStr = prevTable & "|" & prevFields(k1) & "|" & newTableKey & "|" & relPkFld & "|INNER"
                                                        foundJoin = True
                                                        Exit For
                                                    End If
                                                Next k1
                                                If foundJoin Then Exit For
                                            ElseIf StrComp(relPkTbl, prevBaseTable, vbTextCompare) = 0 And StrComp(relPkTbl, newBaseTable, vbTextCompare) <> 0 Then
                                                For k2 = 0 To newCount - 1
                                                    If StrComp(Trim$(newFields(k2)), relFkFld, vbTextCompare) = 0 And Not IsPrimaryKeyField(newBaseTable, newFields(k2)) Then
                                                        joinStr = prevTable & "|" & relPkFld & "|" & newTableKey & "|" & newFields(k2) & "|INNER"
                                                        foundJoin = True
                                                        Exit For
                                                    End If
                                                Next k2
                                                If foundJoin Then Exit For
                                            End If
                                        End If
                                    End If
                                End If
                            Next rIdx
                        End If
                    End If
                End If
                On Error GoTo 0

                ' In Relationships View (Mode 8), only draw formal DAO Relations from MSysRelationships
                If m_currentWorkspaceMode = 8 Then
                    If foundJoin Then
                        Dim uJnRel As Long
                        On Error Resume Next
                        uJnRel = -1
                        uJnRel = UBound(m_qbeJoins)
                        On Error GoTo 0
                        If uJnRel < 0 Then
                            ReDim m_qbeJoins(0 To 0)
                            m_qbeJoins(0) = joinStr
                        Else
                            ReDim Preserve m_qbeJoins(0 To uJnRel + 1)
                            m_qbeJoins(uJnRel + 1) = joinStr
                        End If
                    End If
                    GoTo NextPrevTable
                End If

                ' 2. Check LookupCache RowSource (both directions, non-PK fields only)
                If Not foundJoin Then
                    For k2 = 0 To newCount - 1
                        If Not IsPrimaryKeyField(newBaseTable, newFields(k2)) Then
                            If LookupCache.IsLookupField(StudioController.ActiveDatabase, newBaseTable, newFields(k2)) Then
                                Dim rsSrc As String
                                rsSrc = vbNullString
                                On Error Resume Next
                                rsSrc = UCase$(StudioController.ActiveDatabase.TableDefs(newBaseTable).Fields(newFields(k2)).Properties("RowSource").Value)
                                On Error GoTo 0
                                If Len(rsSrc) > 0 And InStr(1, rsSrc, UCase$(prevBaseTable)) > 0 Then
                                    Dim prevPk As String
                                    prevPk = "ID"
                                    For k1 = 0 To prevCount - 1
                                        If IsPrimaryKeyField(prevBaseTable, prevFields(k1)) Then
                                            prevPk = prevFields(k1)
                                            Exit For
                                        End If
                                    Next k1
                                    joinStr = prevTable & "|" & prevPk & "|" & newTableKey & "|" & newFields(k2) & "|INNER"
                                    foundJoin = True
                                    Exit For
                                End If
                            End If
                        End If
                    Next k2
                End If

                If Not foundJoin Then
                    For k1 = 0 To prevCount - 1
                        If Not IsPrimaryKeyField(prevBaseTable, prevFields(k1)) Then
                            If LookupCache.IsLookupField(StudioController.ActiveDatabase, prevBaseTable, prevFields(k1)) Then
                                Dim rsSrcPrev As String
                                rsSrcPrev = vbNullString
                                On Error Resume Next
                                rsSrcPrev = UCase$(StudioController.ActiveDatabase.TableDefs(prevBaseTable).Fields(prevFields(k1)).Properties("RowSource").Value)
                                On Error GoTo 0
                                If Len(rsSrcPrev) > 0 And InStr(1, rsSrcPrev, UCase$(newBaseTable)) > 0 Then
                                    Dim newPk As String
                                    newPk = "ID"
                                    For k2 = 0 To newCount - 1
                                        If IsPrimaryKeyField(newBaseTable, newFields(k2)) Then
                                            newPk = newFields(k2)
                                            Exit For
                                        End If
                                    Next k2
                                    joinStr = prevTable & "|" & prevFields(k1) & "|" & newTableKey & "|" & newPk & "|INNER"
                                    foundJoin = True
                                    Exit For
                                End If
                            End If
                        End If
                    Next k1
                End If

                ' 3. Strict FK-to-PK Naming Heuristic (NEVER match PK-to-PK and NEVER match generic ID/PK)
                If Not foundJoin Then
                    Dim uPrevTbl As String
                    uPrevTbl = UCase$(Trim$(prevBaseTable))
                    For k1 = 0 To prevCount - 1
                        If IsPrimaryKeyField(prevBaseTable, prevFields(k1)) Then
                            Dim uPrevPk As String
                            uPrevPk = UCase$(Trim$(prevFields(k1)))
                            For k2 = 0 To newCount - 1
                                Dim uFld As String
                                uFld = UCase$(Trim$(newFields(k2)))
                                If Not IsPrimaryKeyField(newBaseTable, newFields(k2)) And uFld <> "ID" And uFld <> "PK" Then
                                    If uFld = uPrevTbl Or uFld = uPrevTbl & "ID" Or uFld = uPrevTbl & "_ID" Or (uFld = uPrevPk And uPrevPk <> "ID" And uPrevPk <> "PK") Then
                                        joinStr = prevTable & "|" & prevFields(k1) & "|" & newTableKey & "|" & newFields(k2) & "|INNER"
                                        foundJoin = True
                                        Exit For
                                    End If
                                End If
                            Next k2
                            If foundJoin Then Exit For
                        End If
                    Next k1
                End If

                If Not foundJoin Then
                    Dim uNewTbl As String
                    uNewTbl = UCase$(Trim$(newBaseTable))
                    For k2 = 0 To newCount - 1
                        If IsPrimaryKeyField(newBaseTable, newFields(k2)) Then
                            Dim uNewPk As String
                            uNewPk = UCase$(Trim$(newFields(k2)))
                            For k1 = 0 To prevCount - 1
                                Dim uPrevFld As String
                                uPrevFld = UCase$(Trim$(prevFields(k1)))
                                If Not IsPrimaryKeyField(prevBaseTable, prevFields(k1)) And uPrevFld <> "ID" And uPrevFld <> "PK" Then
                                    If uPrevFld = uNewTbl Or uPrevFld = uNewTbl & "ID" Or uPrevFld = uNewTbl & "_ID" Or (uPrevFld = uNewPk And uNewPk <> "ID" And uNewPk <> "PK") Then
                                        joinStr = prevTable & "|" & prevFields(k1) & "|" & newTableKey & "|" & newFields(k2) & "|INNER"
                                        foundJoin = True
                                        Exit For
                                    End If
                                End If
                            Next k1
                            If foundJoin Then Exit For
                        End If
                    Next k2
                End If

                If foundJoin Then
                    Dim uJn As Long
                    On Error Resume Next
                    uJn = -1
                    uJn = UBound(m_qbeJoins)
                    On Error GoTo 0
                    Dim existsAlready As Boolean
                    existsAlready = False
                    Dim j As Long
                    If uJn >= 0 Then
                        For j = 0 To uJn
                            If m_qbeJoins(j) = joinStr Then existsAlready = True: Exit For
                        Next j
                    End If
                    If Not existsAlready Then
                        If uJn < 0 Then
                            ReDim m_qbeJoins(0 To 0)
                            m_qbeJoins(0) = joinStr
                        Else
                            ReDim Preserve m_qbeJoins(0 To uJn + 1)
                            m_qbeJoins(uJn + 1) = joinStr
                        End If
                    End If
                End If
            End If
NextPrevTable:
        Next prevT
    End Sub

    Private Function PtNearSegment(ByVal px As Single, ByVal py As Single, ByVal x1 As Long, ByVal y1 As Long, ByVal x2 As Long, ByVal y2 As Long, ByVal tol As Long) As Boolean
        Dim dx As Double, dy As Double, l2 As Double, t As Double, projX As Double, projY As Double, dist2 As Double
        dx = x2 - x1
        dy = y2 - y1
        l2 = dx * dx + dy * dy
        If l2 < 0.0001 Then
            dist2 = (px - x1) * (px - x1) + (py - y1) * (py - y1)
            PtNearSegment = (dist2 <= tol * tol)
            Exit Function
        End If
        t = ((px - x1) * dx + (py - y1) * dy) / l2
        If t < 0# Then t = 0#
        If t > 1# Then t = 1#
        projX = x1 + t * dx
        projY = y1 + t * dy
        dist2 = (px - projX) * (px - projX) + (py - projY) * (py - projY)
        PtNearSegment = (dist2 <= tol * tol)
    End Function

    Private Function FindClickedJoinIndex(ByVal clickX As Single, ByVal clickY As Single) As Long
        FindClickedJoinIndex = -1
        Dim uTb As Long, uJn As Long
        On Error Resume Next
        uTb = -1
        uTb = UBound(m_qbeTables)
        uJn = -1
        uJn = UBound(m_qbeJoins)
        On Error GoTo 0
        If uTb < 0 Or uJn < 0 Then Exit Function

        Dim n As Long
        n = uTb + 1
        Dim keys() As String, lists() As String, boxX() As Long, boxY() As Long, boxRows() As Long
        ReDim keys(0 To n - 1)
        ReDim lists(0 To n - 1)
        ReDim boxX(0 To n - 1)
        ReDim boxY(0 To n - 1)
        ReDim boxRows(0 To n - 1)
        Dim t As Long, parts() As String, srcName As String, fieldNames() As String, fieldCount As Long, k As Long, visRows As Long

        For t = 0 To n - 1
            parts = Split(m_qbeTables(t), "|")
            keys(t) = parts(0)
            If UBound(parts) >= 1 Then srcName = parts(1) Else srcName = keys(t)
            fieldCount = StudioController.GetTableFieldNames(srcName, fieldNames)
            lists(t) = "*"
            For k = 0 To fieldCount - 1: lists(t) = lists(t) & vbTab & fieldNames(k): Next k
            visRows = fieldCount + 1
            If visRows > QD_BOX_MAX_ROWS Then visRows = QD_BOX_MAX_ROWS
            boxRows(t) = visRows
            boxX(t) = GetTableBoxX(t)
            boxY(t) = GetTableBoxY(t)
        Next t

        Dim j As Long, ia As Long, ib As Long, ya As Long, yb As Long, x1 As Long, y1 As Long, x2 As Long, y2 As Long, aLeft As Boolean
        For j = 0 To uJn
            parts = Split(m_qbeJoins(j), "|")
            If UBound(parts) >= 3 Then
                ia = QdTableIndex(keys, parts(0))
                ib = QdTableIndex(keys, parts(2))
                If ia >= 0 And ib >= 0 And ia <> ib Then
                    ya = boxY(ia) + QD_BOX_TITLE_PX + 2 + QdFieldRow(lists(ia), parts(1), boxRows(ia)) * QD_BOX_ROW_PX + QD_BOX_ROW_PX \ 2
                    yb = boxY(ib) + QD_BOX_TITLE_PX + 2 + QdFieldRow(lists(ib), parts(3), boxRows(ib)) * QD_BOX_ROW_PX + QD_BOX_ROW_PX \ 2
                    aLeft = (boxX(ia) <= boxX(ib))
                    If aLeft Then
                        x1 = boxX(ia) + QD_BOX_W_PX: y1 = ya
                        x2 = boxX(ib) - 1: y2 = yb
                    Else
                        x1 = boxX(ib) + QD_BOX_W_PX: y1 = yb
                        x2 = boxX(ia) - 1: y2 = ya
                    End If

                    If PtNearSegment(clickX, clickY, x1, y1, x1 + QD_JOIN_STUB_PX, y1, 6) Or PtNearSegment(clickX, clickY, x1 + QD_JOIN_STUB_PX, y1, x2 - QD_JOIN_STUB_PX, y2, 6) Or PtNearSegment(clickX, clickY, x2 - QD_JOIN_STUB_PX, y2, x2, y2, 6) Then
                        FindClickedJoinIndex = j
                        Exit Function
                    End If
                End If
            End If
        Next j
    End Function

    Private Sub RemoveQbeJoinAt(ByVal joinIdx As Long)
        Dim uJn As Long
        Dim j As Long
        Dim newJoins() As String
        Dim newJoinCount As Long

        On Error Resume Next
        uJn = -1
        uJn = UBound(m_qbeJoins)
        On Error GoTo 0
        If joinIdx < 0 Or joinIdx > uJn Then Exit Sub

        If uJn = 0 Then
            Erase m_qbeJoins
        Else
            ReDim newJoins(0 To uJn - 1)
            newJoinCount = 0
            For j = 0 To uJn
                If j <> joinIdx Then
                    newJoins(newJoinCount) = m_qbeJoins(j)
                    newJoinCount = newJoinCount + 1
                End If
            Next j
            m_qbeJoins = newJoins
        End If

        m_qbeSelectedJoinIdx = -1
        PaintQueryTables picQryTables, m_qbeTables, m_qbeJoins
        RebuildSqlFromQbeGrid
        lblStatus.Caption = "Relationship line removed from query."
    End Sub

    Private Sub EditQueryJoin(ByVal joinIdx As Long)
        Dim uJn As Long
        Dim uTb As Long
        Dim jParts() As String
        Dim curType As String
        Dim t As Long
        Dim tKey As String
        Dim lIdx As Long
        Dim rIdx As Long

        On Error Resume Next
        uJn = -1
        uJn = UBound(m_qbeJoins)
        uTb = -1
        uTb = UBound(m_qbeTables)
        On Error GoTo 0
        If joinIdx < 0 Or joinIdx > uJn Then Exit Sub

        m_qbeSelectedJoinIdx = joinIdx
        PaintQueryTables picQryTables, m_qbeTables, m_qbeJoins

        jParts = Split(m_qbeJoins(joinIdx), "|")
        If UBound(jParts) < 4 Then
            ReDim Preserve jParts(0 To 4)
            jParts(4) = "INNER"
        End If

        curType = UCase$(Trim$(jParts(4)))
        If Len(curType) = 0 Then curType = "INNER"

        m_relDialogIsQbeJoin = True
        m_relDialogQbeJoinIdx = joinIdx
        m_relDialogExistingName = jParts(0) & "_" & jParts(2)

        fcCbo02.Clear
        fcCbo04.Clear
        lIdx = 0
        rIdx = 0
        If uTb >= 0 Then
            For t = 0 To uTb
                tKey = Split(m_qbeTables(t), "|")(0)
                fcCbo02.AddItem tKey
                fcCbo04.AddItem tKey
                If StrComp(tKey, jParts(0), vbTextCompare) = 0 Then lIdx = t
                If StrComp(tKey, jParts(2), vbTextCompare) = 0 Then rIdx = t
            Next t
        End If

        If fcCbo02.ListCount > 0 Then
            fcCbo02.ListIndex = lIdx
            fcCbo02.Text = fcCbo02.List(lIdx)
        End If
        If fcCbo04.ListCount > 0 Then
            fcCbo04.ListIndex = rIdx
            fcCbo04.Text = fcCbo04.List(rIdx)
        End If

        PopulateRelDialogFieldCombo fcCbo03, fcCbo02.Text, False, jParts(1)
        PopulateRelDialogFieldCombo fcCbo05, fcCbo04.Text, False, jParts(3)

        m_relDialogUpdatingChecks = True
        UpdateQbeJoinDialogCheckCaptions
        fcChk01.Enabled = True
        fcChk02.Enabled = True
        fcChk03.Enabled = True
        fcChk01.Value = IIf(curType = "INNER", 1, 0)
        fcChk02.Value = IIf(curType = "LEFT", 1, 0)
        fcChk03.Value = IIf(curType = "RIGHT", 1, 0)
        m_relDialogUpdatingChecks = False

        fcBtn01.Caption = "Save Join"
        fcBtn02.Caption = "Cancel"
        fcBtn03.Caption = "Delete Join [X]"

        m_relDialogActive = True
        LayoutVisualRelationshipDialog
        lblStatus.Caption = "Selected join [" & jParts(0) & "].[" & jParts(1) & "] <---> [" & jParts(2) & "].[" & jParts(3) & "]. Click 'Delete Join [X]' or press Delete to remove."
    End Sub

    Private Sub EditRelationshipLineDialog(ByVal joinIdx As Long)
        Dim jPartsRel() As String
        jPartsRel = Split(m_qbeJoins(joinIdx), "|")
        If UBound(jPartsRel) < 3 Then Exit Sub
        PromptCreateRelationshipDialog jPartsRel(2), jPartsRel(3), jPartsRel(0), jPartsRel(1)
    End Sub

    Private Sub picQryTables_MouseDown(Button As Integer, Shift As Integer, X As Single, Y As Single)
        If m_currentWorkspaceMode <> 12 And m_currentWorkspaceMode <> 8 Then Exit Sub

        Dim uTb As Long
        On Error Resume Next
        uTb = -1
        uTb = UBound(m_qbeTables)
        On Error GoTo 0

        ' Check click on top-right action buttons
        Dim addBtnW As Long
        Dim addBtnLeft As Long
        addBtnW = 155
        addBtnLeft = picQryTables.ScaleWidth - addBtnW - 16
        If addBtnLeft < 200 Then addBtnLeft = 200

        If m_currentWorkspaceMode = 8 Then
            Dim newRelBtnLeft As Long
            newRelBtnLeft = addBtnLeft - 155
            If X >= newRelBtnLeft And X <= newRelBtnLeft + 148 And Y >= 10 And Y <= 36 Then
                PromptCreateRelationshipDialog
                Exit Sub
            End If
        ElseIf m_currentWorkspaceMode = 12 Then
            Dim delJoinBtnLeft As Long
            delJoinBtnLeft = addBtnLeft - 148
            If X >= delJoinBtnLeft And X <= delJoinBtnLeft + 140 And Y >= 10 And Y <= 36 Then
                Dim uJnDelBtn As Long
                On Error Resume Next
                uJnDelBtn = -1
                uJnDelBtn = UBound(m_qbeJoins)
                On Error GoTo 0
                If uJnDelBtn < 0 Then
                    lblStatus.Caption = "No relationship join lines in this query to delete."
                ElseIf m_qbeSelectedJoinIdx >= 0 And m_qbeSelectedJoinIdx <= uJnDelBtn Then
                    If m_relDialogActive Then CloseVisualRelationshipDialog
                    RemoveQbeJoinAt m_qbeSelectedJoinIdx
                Else
                    If m_relDialogActive Then CloseVisualRelationshipDialog
                    RemoveQbeJoinAt uJnDelBtn
                End If
                Exit Sub
            End If
        End If

        If X >= addBtnLeft And X <= addBtnLeft + addBtnW And Y >= 10 And Y <= 36 Then
            If lstPropSheet.ListIndex >= 0 Then
                QbeAddTable lstPropSheet.List(lstPropSheet.ListIndex)
            ElseIf lstPropSheet.ListCount > 0 Then
                lstPropSheet.ListIndex = 0
                QbeAddTable lstPropSheet.List(0)
            End If
            Exit Sub
        End If

        If uTb < 0 Then Exit Sub

        ' Check click near existing relationship line
        Dim joinIdx As Long
        joinIdx = FindClickedJoinIndex(X, Y)
        If joinIdx >= 0 Then
            m_qbeSelectedJoinIdx = joinIdx
            If m_currentWorkspaceMode = 8 Then
                EditRelationshipLineDialog joinIdx
            Else
                If Button = 2 Then
                    If m_relDialogActive Then CloseVisualRelationshipDialog
                    RemoveQbeJoinAt joinIdx
                Else
                    EditQueryJoin joinIdx
                End If
            End If
            Exit Sub
        End If

        ' Check click inside table boxes
        Dim t As Long
        Dim bx As Long
        Dim by As Long
        Dim bh As Long
        Dim visRows As Long
        Dim fNames() As String
        Dim fCount As Long
        Dim tableEntry As String, tableName As String, tableKey As String
        Dim fieldName As String
        Dim rowK As Long
        Dim closeX As Long, closeY As Long

        For t = uTb To 0 Step -1
            bx = GetTableBoxX(t)
            by = GetTableBoxY(t)
            tableEntry = m_qbeTables(t)
            tableKey = Split(tableEntry, "|")(0)
            If UBound(Split(tableEntry, "|")) >= 1 Then tableName = Split(tableEntry, "|")(1) Else tableName = tableKey
            fCount = StudioController.GetTableFieldNames(tableName, fNames)
            visRows = fCount + 1
            If visRows > QD_BOX_MAX_ROWS Then visRows = QD_BOX_MAX_ROWS
            bh = QD_BOX_TITLE_PX + visRows * QD_BOX_ROW_PX + 4

            closeX = bx + QD_BOX_W_PX - 18
            closeY = by + (QD_BOX_TITLE_PX - 14) \ 2

            ' 1. Check click on Red Close Button [X] or right-click on table
            If (X >= closeX And X <= closeX + 14 And Y >= closeY And Y <= closeY + 14) Or (Button = 2 And X >= bx And X <= bx + QD_BOX_W_PX And Y >= by And Y <= by + bh) Then
                QbeRemoveTable t
                Exit Sub
            End If

            ' 2. Check click on Table Title Bar to drag/move the table box on the canvas!
            If Button = 1 And X >= bx And X <= bx + QD_BOX_W_PX And Y >= by And Y < by + QD_BOX_TITLE_PX Then
                m_qbeDraggingBox = True
                m_qbeDragBoxIdx = t
                m_qbeDragBoxOffX = X - CSng(bx)
                m_qbeDragBoxOffY = Y - CSng(by)
                Exit Sub
            End If

            ' 3. Check click on field row to add to grid or start drag-and-drop relationship
            If X >= bx And X <= bx + QD_BOX_W_PX And Y >= by + QD_BOX_TITLE_PX And Y <= by + bh Then
                rowK = (CLng(Y) - (by + QD_BOX_TITLE_PX + 2)) \ QD_BOX_ROW_PX
                If rowK = 0 Then
                    If m_currentWorkspaceMode = 8 And fCount > 0 Then
                        fieldName = fNames(0)
                    Else
                        fieldName = "*"
                    End If
                ElseIf rowK > 0 And rowK <= fCount Then
                    fieldName = fNames(rowK - 1)
                ElseIf fCount > 0 Then
                    fieldName = fNames(fCount - 1)
                Else
                    fieldName = vbNullString
                End If

                If Len(fieldName) > 0 Then
                    If fieldName <> "*" Then
                        m_qbeDraggingJoin = True
                        m_qbeDragTableIdx = t
                        m_qbeDragTableName = tableKey
                        m_qbeDragFieldName = fieldName
                        m_qbeDragStartX = X
                        m_qbeDragStartY = Y
                    End If
                    If m_currentWorkspaceMode = 12 Then QbeAddColumn fieldName, tableKey
                End If
                Exit Sub
            End If
        Next t
    End Sub

    Private Sub picQryTables_MouseMove(Button As Integer, Shift As Integer, X As Single, Y As Single)
        If m_currentWorkspaceMode <> 12 And m_currentWorkspaceMode <> 8 Then Exit Sub
        If m_qbeDraggingBox And Button = 1 Then
            Dim newBx As Long, newBy As Long
            newBx = CLng(X - m_qbeDragBoxOffX)
            newBy = CLng(Y - m_qbeDragBoxOffY)
            If newBx < 6 Then newBx = 6
            If newBy < 6 Then newBy = 6
            If newBx > picQryTables.ScaleWidth - QD_BOX_W_PX - 6 Then newBx = picQryTables.ScaleWidth - QD_BOX_W_PX - 6
            If newBy > picQryTables.ScaleHeight - 36 Then newBy = picQryTables.ScaleHeight - 36
            If m_qbeDragBoxIdx >= 0 And m_qbeDragBoxIdx <= 63 Then
                m_qbeBoxX(m_qbeDragBoxIdx) = newBx
                m_qbeBoxY(m_qbeDragBoxIdx) = newBy
            End If
            PaintQueryTables picQryTables, m_qbeTables, m_qbeJoins
            Exit Sub
        End If
        If m_qbeDraggingJoin And Button = 1 Then
            PaintQueryTables picQryTables, m_qbeTables, m_qbeJoins
            On Error Resume Next
            picQryTables.Line (m_qbeDragStartX, m_qbeDragStartY)-(X, Y), &H0000FF&
            picQryTables.Circle (X, Y), 4, &H0000FF&
            On Error GoTo 0
        End If
    End Sub

    Private Sub picQryTables_MouseUp(Button As Integer, Shift As Integer, X As Single, Y As Single)
        If m_currentWorkspaceMode <> 12 And m_currentWorkspaceMode <> 8 Then Exit Sub
        If m_qbeDraggingBox Then
            m_qbeDraggingBox = False
            PaintQueryTables picQryTables, m_qbeTables, m_qbeJoins
            Exit Sub
        End If
        If Not m_qbeDraggingJoin Then Exit Sub
        m_qbeDraggingJoin = False

        Dim uTb As Long
        On Error Resume Next
        uTb = -1
        uTb = UBound(m_qbeTables)
        On Error GoTo 0
        If uTb < 0 Then Exit Sub

        Dim t As Long, bx As Long, by As Long, bh As Long, visRows As Long, fNames() As String, fCount As Long, rowK As Long
        Dim destEntry As String, destKey As String, destName As String, destField As String

        For t = uTb To 0 Step -1
            If t <> m_qbeDragTableIdx Then
                bx = GetTableBoxX(t)
                by = GetTableBoxY(t)
                destEntry = m_qbeTables(t)
                destKey = Split(destEntry, "|")(0)
                If UBound(Split(destEntry, "|")) >= 1 Then destName = Split(destEntry, "|")(1) Else destName = destKey
                fCount = StudioController.GetTableFieldNames(destName, fNames)
                visRows = fCount + 1
                If visRows > QD_BOX_MAX_ROWS Then visRows = QD_BOX_MAX_ROWS
                bh = QD_BOX_TITLE_PX + visRows * QD_BOX_ROW_PX + 4

                If X >= bx And X <= bx + QD_BOX_W_PX And Y >= by And Y <= by + bh Then
                    If Y < by + QD_BOX_TITLE_PX + 2 Then
                        rowK = 0
                    Else
                        rowK = (CLng(Y) - (by + QD_BOX_TITLE_PX + 2)) \ QD_BOX_ROW_PX
                    End If
                    If rowK <= 0 And fCount > 0 Then
                        Dim matchFkIdx As Long
                        rowK = 1
                        For matchFkIdx = 0 To fCount - 1
                            If StrComp(Trim$(fNames(matchFkIdx)), Trim$(m_qbeDragFieldName), vbTextCompare) = 0 Then
                                rowK = matchFkIdx + 1
                                Exit For
                            End If
                        Next matchFkIdx
                    End If
                    If rowK > fCount And fCount > 0 Then rowK = fCount
                    If rowK > 0 And rowK <= fCount Then
                        destField = fNames(rowK - 1)
                        If m_currentWorkspaceMode = 8 Then
                            Dim pkT As String, pkF As String, fkT As String, fkF As String
                            If IsPrimaryKeyField(destKey, destField) And Not IsPrimaryKeyField(m_qbeDragTableName, m_qbeDragFieldName) Then
                                pkT = destKey: pkF = destField
                                fkT = m_qbeDragTableName: fkF = m_qbeDragFieldName
                            Else
                                pkT = m_qbeDragTableName: pkF = m_qbeDragFieldName
                                fkT = destKey: fkF = destField
                            End If
                            PromptCreateRelationshipDialog fkT, fkF, pkT, pkF
                            Exit Sub
                        End If
                        Dim newJoinStr As String
                        newJoinStr = m_qbeDragTableName & "|" & m_qbeDragFieldName & "|" & destKey & "|" & destField & "|INNER"
                        Dim uJn As Long
                        On Error Resume Next
                        uJn = -1
                        uJn = UBound(m_qbeJoins)
                        On Error GoTo 0
                        If uJn < 0 Then
                            ReDim m_qbeJoins(0 To 0)
                            m_qbeJoins(0) = newJoinStr
                        Else
                            ReDim Preserve m_qbeJoins(0 To uJn + 1)
                            m_qbeJoins(uJn + 1) = newJoinStr
                        End If
                        PaintQueryTables picQryTables, m_qbeTables, m_qbeJoins
                        RebuildSqlFromQbeGrid
                        lblStatus.Caption = "Relationship created: [" & m_qbeDragTableName & "].[" & m_qbeDragFieldName & "] <---> [" & destKey & "].[" & destField & "]"
                        Exit Sub
                    End If
                End If
            End If
        Next t

        PaintQueryTables picQryTables, m_qbeTables, m_qbeJoins
    End Sub

    Private Sub QbeAddColumn(ByVal fieldName As String, ByVal tableName As String)
        Dim uCol As Long
        On Error Resume Next
        uCol = -1
        uCol = UBound(m_qbeCols)
        On Error GoTo 0

        If uCol < 0 Then
            ReDim m_qbeCols(0 To 0)
            m_qbeCols(0) = fieldName & "|" & tableName & "||1||"
            m_qbeColCount = 1
        Else
            If m_qbeColCount = 1 And Split(m_qbeCols(0), "|")(0) = "*" And fieldName <> "*" Then
                m_qbeCols(0) = fieldName & "|" & tableName & "||1||"
            Else
                ReDim Preserve m_qbeCols(0 To uCol + 1)
                m_qbeCols(uCol + 1) = fieldName & "|" & tableName & "||1||"
                m_qbeColCount = uCol + 2
            End If
        End If

        PaintQbeGrid picQbeGrid, m_qbeCols
        RebuildSqlFromQbeGrid
        lblStatus.Caption = "Added [" & tableName & "].[" & fieldName & "] to Query Design grid."
    End Sub

    Private Sub QbeRemoveColumn(ByVal colIdx As Long)
        Dim uCol As Long
        On Error Resume Next
        uCol = -1
        uCol = UBound(m_qbeCols)
        On Error GoTo 0
        If colIdx < 0 Or colIdx > uCol Then Exit Sub

        Dim i As Long
        Dim newCols() As String
        Dim newColCount As Long
        newColCount = 0
        For i = 0 To uCol
            If i <> colIdx Then
                ReDim Preserve newCols(0 To newColCount)
                newCols(newColCount) = m_qbeCols(i)
                newColCount = newColCount + 1
            End If
        Next i
        If newColCount = 0 Then
            Erase m_qbeCols
            m_qbeColCount = 0
        Else
            m_qbeCols = newCols
            m_qbeColCount = newColCount
        End If

        fcCbo01.Visible = False
        fcTxt01.Visible = False
        m_qbeEditingCol = -1
        m_qbeEditingRow = -1

        PaintQbeGrid picQbeGrid, m_qbeCols
        RebuildSqlFromQbeGrid
        lblStatus.Caption = "Column removed from query design grid."
    End Sub

    Private Sub picQbeGrid_MouseDown(Button As Integer, Shift As Integer, X As Single, Y As Single)
        If m_currentWorkspaceMode <> 12 Then Exit Sub
        If X < QD_QBE_HEADER_W_PX Then Exit Sub

        Dim uCol As Long
        On Error Resume Next
        uCol = -1
        uCol = UBound(m_qbeCols)
        On Error GoTo 0

        Dim colIdx As Long
        Dim rowIdx As Long
        Dim parts() As String
        Dim cellLeft As Long
        Dim cellTop As Long

        colIdx = (CLng(X) - QD_QBE_HEADER_W_PX) \ QD_QBE_COL_W_PX

        ' Check column deletion via top gray selector bar (Y < QD_QBE_TOP_PX) or right click (Button = 2)
        If Y < QD_QBE_TOP_PX Or Button = 2 Then
            If colIdx >= 0 And colIdx <= uCol Then
                QbeRemoveColumn colIdx
            End If
            Exit Sub
        End If

        If Y >= QD_QBE_TOP_PX + 6 * QD_QBE_ROW_PX Then Exit Sub
        rowIdx = (CLng(Y) - QD_QBE_TOP_PX) \ QD_QBE_ROW_PX

        If colIdx > uCol Then
            If colIdx = uCol + 1 And rowIdx = 0 Then
                Dim defTbl As String
                defTbl = ""
                If UBound(m_qbeTables) >= 0 Then defTbl = Split(m_qbeTables(0), "|")(0)
                ReDim Preserve m_qbeCols(0 To colIdx)
                m_qbeCols(colIdx) = "|" & defTbl & "||1||"
                m_qbeColCount = colIdx + 1
                uCol = colIdx
            Else
                Exit Sub
            End If
        End If

        parts = Split(m_qbeCols(colIdx) & "|||||", "|")
        cellLeft = picQbeGrid.Left + QD_QBE_HEADER_W_PX + colIdx * QD_QBE_COL_W_PX
        cellTop = picQbeGrid.Top + QD_QBE_TOP_PX + rowIdx * QD_QBE_ROW_PX

        m_qbeEditingCol = colIdx
        m_qbeEditingRow = rowIdx

        Select Case rowIdx
            Case 0  ' Field:
                fcTxt01.Visible = False
                fcCbo01.Clear
                Dim t As Long, fList() As String, fCnt As Long, fi As Long
                Dim uTb As Long
                On Error Resume Next
                uTb = -1
                uTb = UBound(m_qbeTables)
                On Error GoTo 0
                For t = 0 To uTb
                    Dim tKey As String, tSrc As String, tSplit() As String
                    tSplit = Split(m_qbeTables(t), "|")
                    tKey = tSplit(0)
                    If UBound(tSplit) >= 1 Then tSrc = tSplit(1) Else tSrc = tKey
                    fcCbo01.AddItem tKey & ".*"
                    fCnt = StudioController.GetTableFieldNames(tSrc, fList)
                    For fi = 0 To fCnt - 1
                        fcCbo01.AddItem tKey & "." & fList(fi)
                    Next fi
                Next t
                If Len(parts(1)) > 0 And Len(parts(0)) > 0 Then
                    fcCbo01.Text = parts(1) & "." & parts(0)
                Else
                    fcCbo01.Text = parts(0)
                End If
                fcCbo01.Left = cellLeft
                fcCbo01.Top = cellTop
                fcCbo01.Width = QD_QBE_COL_W_PX
                fcCbo01.Height = QD_QBE_ROW_PX + 4
                fcCbo01.Visible = True
                fcCbo01.ZOrder 0
                On Error Resume Next
                fcCbo01.SetFocus
                On Error GoTo 0

            Case 1  ' Table:
                fcTxt01.Visible = False
                fcCbo01.Clear
                Dim uTb1 As Long
                On Error Resume Next
                uTb1 = -1
                uTb1 = UBound(m_qbeTables)
                On Error GoTo 0
                For t = 0 To uTb1
                    fcCbo01.AddItem Split(m_qbeTables(t), "|")(0)
                Next t
                fcCbo01.Text = parts(1)
                fcCbo01.Left = cellLeft
                fcCbo01.Top = cellTop
                fcCbo01.Width = QD_QBE_COL_W_PX
                fcCbo01.Height = QD_QBE_ROW_PX + 4
                fcCbo01.Visible = True
                fcCbo01.ZOrder 0
                On Error Resume Next
                fcCbo01.SetFocus
                On Error GoTo 0

            Case 2  ' Sort:
                fcTxt01.Visible = False
                fcCbo01.Clear
                fcCbo01.AddItem "(not sorted)"
                fcCbo01.AddItem "Ascending"
                fcCbo01.AddItem "Descending"
                If Len(parts(2)) = 0 Then
                    fcCbo01.Text = "(not sorted)"
                Else
                    fcCbo01.Text = parts(2)
                End If
                fcCbo01.Left = cellLeft
                fcCbo01.Top = cellTop
                fcCbo01.Width = QD_QBE_COL_W_PX
                fcCbo01.Height = QD_QBE_ROW_PX + 4
                fcCbo01.Visible = True
                fcCbo01.ZOrder 0
                On Error Resume Next
                fcCbo01.SetFocus
                On Error GoTo 0

            Case 3  ' Show: toggle between "1" and "0"
                fcTxt01.Visible = False
                fcCbo01.Visible = False
                If parts(3) = "1" Then
                    parts(3) = "0"
                Else
                    parts(3) = "1"
                End If
                m_qbeCols(colIdx) = Join(parts, "|")
                PaintQbeGrid picQbeGrid, m_qbeCols
                RebuildSqlFromQbeGrid

            Case 4, 5  ' Criteria / or:
                fcCbo01.Visible = False
                fcTxt01.Text = parts(rowIdx)
                fcTxt01.Left = cellLeft
                fcTxt01.Top = cellTop
                fcTxt01.Width = QD_QBE_COL_W_PX
                fcTxt01.Height = QD_QBE_ROW_PX + 2
                fcTxt01.Visible = True
                fcTxt01.ZOrder 0
                On Error Resume Next
                fcTxt01.SetFocus
                fcTxt01.SelStart = 0
                fcTxt01.SelLength = Len(fcTxt01.Text)
                On Error GoTo 0
        End Select
    End Sub

    Public Function RebuildSqlFromQbeGrid() As String
        Dim sql As String
        Dim selItems() As String
        Dim selCount As Long
        Dim fromClause As String
        Dim whereItems() As String
        Dim whereCount As Long
        Dim orderItems() As String
        Dim orderCount As Long
        Dim c As Long
        Dim parts() As String
        Dim fld As String
        Dim tbl As String
        Dim sSort As String
        Dim sShow As String
        Dim sCrit As String
        Dim sOr As String
        Dim colExpr As String
        Dim critCond As String
        Dim orCond As String
        Dim combinedCond As String
        Dim j As Long
        Dim jParts() As String
        Dim uCol As Long, uTb As Long, uJn As Long

        selCount = 0
        whereCount = 0
        orderCount = 0

        On Error Resume Next
        uCol = -1
        uCol = UBound(m_qbeCols)
        uTb = -1
        uTb = UBound(m_qbeTables)
        uJn = -1
        uJn = UBound(m_qbeJoins)
        On Error GoTo 0

        If uCol >= 0 Then
            For c = 0 To uCol
                parts = Split(m_qbeCols(c) & "|||||", "|")
                fld = Trim$(parts(0))
                tbl = Trim$(parts(1))
                sSort = Trim$(parts(2))
                sShow = Trim$(parts(3))
                sCrit = Trim$(parts(4))
                sOr = Trim$(parts(5))

                If Len(fld) > 0 Then
                    If fld = "*" Then
                        If Len(tbl) > 0 Then colExpr = "[" & tbl & "].*" Else colExpr = "*"
                    ElseIf InStr(fld, "(") > 0 Or InStr(fld, "[") > 0 Then
                        colExpr = fld
                    Else
                        If Len(tbl) > 0 Then colExpr = "[" & tbl & "].[" & fld & "]" Else colExpr = "[" & fld & "]"
                    End If

                    If sShow = "1" Or Len(sShow) = 0 Then
                        ReDim Preserve selItems(0 To selCount)
                        selItems(selCount) = colExpr
                        selCount = selCount + 1
                    End If

                    If Len(sSort) > 0 Then
                        ReDim Preserve orderItems(0 To orderCount)
                        If LCase$(sSort) = "descending" Or LCase$(sSort) = "desc" Then
                            orderItems(orderCount) = colExpr & " DESC"
                        Else
                            orderItems(orderCount) = colExpr & " ASC"
                        End If
                        orderCount = orderCount + 1
                    End If

                    critCond = FormatQbeCondition(colExpr, sCrit)
                    orCond = FormatQbeCondition(colExpr, sOr)
                    If Len(critCond) > 0 And Len(orCond) > 0 Then
                        combinedCond = "(" & critCond & " OR " & orCond & ")"
                    ElseIf Len(critCond) > 0 Then
                        combinedCond = critCond
                    ElseIf Len(orCond) > 0 Then
                        combinedCond = orCond
                    Else
                        combinedCond = vbNullString
                    End If

                    If Len(combinedCond) > 0 Then
                        ReDim Preserve whereItems(0 To whereCount)
                        whereItems(whereCount) = combinedCond
                        whereCount = whereCount + 1
                    End If
                End If
            Next c
        End If

        If selCount = 0 Then
            sql = "SELECT *"
        Else
            sql = "SELECT " & Join(selItems, ", ")
        End If

        If uTb < 0 Then
            fromClause = vbNullString
        ElseIf uTb = 0 Then
            Dim singleTable As String
            singleTable = Split(m_qbeTables(0), "|")(0)
            fromClause = "[" & singleTable & "]"
        Else
            Dim rootTable As String
            Dim joinedList As String
            Dim usedJoin() As Boolean
            Dim pass As Long
            Dim ti As Long
            Dim tCand As String
            If uJn >= 0 Then
                ReDim usedJoin(0 To uJn)
                jParts = Split(m_qbeJoins(0), "|")
                If UBound(jParts) >= 3 Then
                    rootTable = jParts(0)
                Else
                    rootTable = Split(m_qbeTables(0), "|")(0)
                End If
                fromClause = "[" & rootTable & "]"
                joinedList = "|" & UCase$(rootTable) & "|"

                For pass = 0 To uJn
                    For j = 0 To uJn
                        If Not usedJoin(j) Then
                            jParts = Split(m_qbeJoins(j), "|")
                            If UBound(jParts) >= 3 Then
                                Dim in0 As Boolean
                                Dim in2 As Boolean
                                in0 = (InStr(1, joinedList, "|" & UCase$(jParts(0)) & "|") > 0)
                                in2 = (InStr(1, joinedList, "|" & UCase$(jParts(2)) & "|") > 0)
                                Dim jType As String
                                Dim rawType As String
                                rawType = "INNER"
                                If UBound(jParts) >= 4 Then rawType = UCase$(Trim$(jParts(4)))
                                If in0 And Not in2 Then
                                    jType = "INNER JOIN"
                                    If rawType = "LEFT" Then jType = "LEFT JOIN"
                                    If rawType = "RIGHT" Then jType = "RIGHT JOIN"
                                    fromClause = fromClause & " " & jType & " [" & jParts(2) & "] ON [" & jParts(0) & "].[" & jParts(1) & "] = [" & jParts(2) & "].[" & jParts(3) & "]"
                                    joinedList = joinedList & UCase$(jParts(2)) & "|"
                                    usedJoin(j) = True
                                ElseIf in2 And Not in0 Then
                                    jType = "INNER JOIN"
                                    If rawType = "LEFT" Then jType = "RIGHT JOIN"
                                    If rawType = "RIGHT" Then jType = "LEFT JOIN"
                                    fromClause = fromClause & " " & jType & " [" & jParts(0) & "] ON [" & jParts(2) & "].[" & jParts(3) & "] = [" & jParts(0) & "].[" & jParts(1) & "]"
                                    joinedList = joinedList & UCase$(jParts(0)) & "|"
                                    usedJoin(j) = True
                                End If
                            End If
                        End If
                    Next j
                Next pass

                For ti = 0 To uTb
                    tCand = Split(m_qbeTables(ti), "|")(0)
                    If InStr(1, joinedList, "|" & UCase$(tCand) & "|") = 0 Then
                        fromClause = fromClause & ", [" & tCand & "]"
                        joinedList = joinedList & UCase$(tCand) & "|"
                    End If
                Next ti
            Else
                rootTable = Split(m_qbeTables(0), "|")(0)
                fromClause = "[" & rootTable & "]"
                For ti = 1 To uTb
                    fromClause = fromClause & ", [" & Split(m_qbeTables(ti), "|")(0) & "]"
                Next ti
            End If
        End If

        If Len(fromClause) > 0 Then
            sql = sql & " FROM " & fromClause
        End If

        If whereCount > 0 Then
            sql = sql & " WHERE " & Join(whereItems, " AND ")
        End If

        If orderCount > 0 Then
            sql = sql & " ORDER BY " & Join(orderItems, ", ")
        End If

        sql = sql & ";"
        txtSql.Text = sql
        If m_currentWorkspaceMode = 13 Then
            txtSqlView.Text = StudioController.FormatSqlForDisplay(sql, False)
        End If
        RebuildSqlFromQbeGrid = sql
    End Function

    Private Function FormatQbeCondition(ByVal colExpr As String, ByVal critText As String) As String
        Dim c As String
        c = Trim$(critText)
        If Len(c) = 0 Then
            FormatQbeCondition = vbNullString
            Exit Function
        End If

        If Left$(c, 2) = ">=" Or Left$(c, 2) = "<=" Or Left$(c, 2) = "<>" Then
            FormatQbeCondition = colExpr & " " & c
        ElseIf Left$(c, 1) = ">" Or Left$(c, 1) = "<" Or Left$(c, 1) = "=" Then
            FormatQbeCondition = colExpr & " " & c
        ElseIf UCase$(Left$(c, 5)) = "LIKE " Or UCase$(Left$(c, 8)) = "BETWEEN " Or UCase$(Left$(c, 3)) = "IN " Or UCase$(Left$(c, 7)) = "IS NULL" Or UCase$(Left$(c, 11)) = "IS NOT NULL" Then
            FormatQbeCondition = colExpr & " " & c
        ElseIf InStr(c, "*") > 0 Or InStr(c, "?") > 0 Then
            FormatQbeCondition = colExpr & " LIKE '" & Replace$(c, "'", "''") & "'"
        ElseIf IsNumeric(c) Then
            FormatQbeCondition = colExpr & " = " & c
        Else
            FormatQbeCondition = colExpr & " = '" & Replace$(c, "'", "''") & "'"
        End If
    End Function

    Private Sub CommitQbeCellEdit()
        If m_currentWorkspaceMode <> 12 Then Exit Sub
        Dim uCol As Long
        On Error Resume Next
        uCol = -1
        uCol = UBound(m_qbeCols)
        On Error GoTo 0
        If m_qbeEditingCol < 0 Or m_qbeEditingCol > uCol Then Exit Sub

        Dim parts() As String
        parts = Split(m_qbeCols(m_qbeEditingCol) & "|||||", "|")

        If m_qbeEditingRow = 0 Then
            Dim selField As String
            selField = Trim$(fcCbo01.Text)
            If Len(selField) > 0 Then
                Dim dotPos As Long
                dotPos = InStr(1, selField, ".")
                If dotPos > 0 Then
                    parts(1) = Left$(selField, dotPos - 1)
                    parts(0) = Mid$(selField, dotPos + 1)
                Else
                    parts(0) = selField
                    If Len(parts(1)) = 0 And UBound(m_qbeTables) >= 0 Then
                        parts(1) = Split(m_qbeTables(0), "|")(0)
                    End If
                End If
                If Len(parts(3)) = 0 Then parts(3) = "1"
            End If
            fcCbo01.Visible = False
        ElseIf m_qbeEditingRow = 1 Then
            Dim selTable As String
            selTable = Trim$(fcCbo01.Text)
            If Len(selTable) > 0 Then parts(1) = selTable
            fcCbo01.Visible = False
        ElseIf m_qbeEditingRow = 2 Then
            Dim sSortVal As String
            sSortVal = Trim$(fcCbo01.Text)
            If sSortVal = "(not sorted)" Or sSortVal = "(none)" Then sSortVal = ""
            parts(2) = sSortVal
            fcCbo01.Visible = False
        ElseIf m_qbeEditingRow = 4 Or m_qbeEditingRow = 5 Then
            parts(m_qbeEditingRow) = Trim$(fcTxt01.Text)
            fcTxt01.Visible = False
        End If

        m_qbeCols(m_qbeEditingCol) = Join(parts, "|")
        m_qbeEditingRow = -1
        m_qbeEditingCol = -1

        PaintQbeGrid picQbeGrid, m_qbeCols
        RebuildSqlFromQbeGrid
    End Sub

    Private Sub btnLookupDrop_Click()
        Dim curTable As String
        Dim chosenVal As String
        Dim keyVal As String
        Dim errMsg As String
        Dim ok As Boolean

        If Not StudioController.IsDatabaseOpen() Then
            MsgBox "Please open a database first.", vbInformation, "Lookup ComboBox"
            Exit Sub
        End If

        curTable = StudioController.GetActiveTableName()
        chosenVal = InputBox("Lookup ComboBox [type_customer] (RowSource: ~sq_cCustomers~sq_ctype):" & vbCrLf & vbCrLf & "Select or enter Lookup value for [type]:" & vbCrLf & "  good  (Key = 1)" & vbCrLf & "  bad   (Key = 2)", "Lookup ComboBox Picker", "good")
        chosenVal = Trim$(chosenVal)
        If Len(chosenVal) = 0 Then Exit Sub

        keyVal = StudioController.ConvertLookupDisplayToKey(curTable, "type", chosenVal)
        ok = StudioController.UpdateActiveRecordField("type", keyVal, errMsg)
        If ok Then
            lblStatus.Caption = "Updated Lookup field [type] to '" & chosenVal & "' (Key=" & keyVal & ")."
            If StudioController.GetViewMode() = 2 Then
                DisplayFormView curTable
            Else
                DisplayTableDatasheet curTable
            End If
        Else
            If lblFormFld2.Caption = "type:" Then txtFormFld2.Text = chosenVal
            If lblFormFld5.Caption = "type:" Then txtFormFld5.Text = chosenVal
            lblStatus.Caption = "Selected Lookup display value: " & chosenVal
        End If
    End Sub

        Private Sub btnSaveFormRec_Click()
        Dim curTable As String
        Dim rs As Object
        Dim fldCnt As Long
        Dim i As Long
        Dim fName As String
        Dim fType As Long
        Dim uiVal As String
        Dim dbVal As String
        Dim errMsg As String
        Dim updatedAny As Boolean

        ' Native Form View (mode 10): write the edited pooled controls (the mode 0 path below is unchanged)
        If m_currentWorkspaceMode = 10 Then
            SaveNativeFormRecord
            Exit Sub
        End If

        If Not StudioController.IsDatabaseOpen() Then
            MsgBox "Please open a database first.", vbInformation, "Save Record"
            Exit Sub
        End If

        curTable = StudioController.GetActiveTableName()
        Set rs = StudioController.GetCurrentRecordset()
        If rs Is Nothing Then Exit Sub

        fldCnt = rs.Fields.Count
        If fldCnt > 5 Then fldCnt = 5

        ' 1. Field validation phase (matching field constraints and data types)
        For i = 0 To fldCnt - 1
            fName = rs.Fields(i).Name
            If UCase$(fName) <> "ID" Then
                Select Case i
                    Case 0: uiVal = Trim$(txtFormFld1.Text)
                    Case 1: uiVal = Trim$(txtFormFld2.Text)
                    Case 2: uiVal = Trim$(txtFormFld3.Text)
                    Case 3: uiVal = Trim$(txtFormFld4.Text)
                    Case 4: uiVal = Trim$(txtFormFld5.Text)
                End Select

                fType = rs.Fields(i).Type
                ' Numeric types: dbByte=2, dbInteger=3, dbLong=4, dbCurrency=5, dbSingle=6, dbDouble=7, dbDecimal=20
                If (fType = 2 Or fType = 3 Or fType = 4 Or fType = 5 Or fType = 6 Or fType = 7 Or fType = 20) And Len(uiVal) > 0 Then
                    If Not IsNumeric(uiVal) Then
                        MsgBox "Validation Error: Field [" & fName & "] must be a valid numeric value.", vbExclamation, "Validation Error"
                        Exit Sub
                    End If
                End If

                ' Date type: dbDate=8
                If fType = 8 And Len(uiVal) > 0 Then
                    If Not IsDate(uiVal) Then
                        MsgBox "Validation Error: Field [" & fName & "] must be a valid date/time format.", vbExclamation, "Validation Error"
                        Exit Sub
                    End If
                End If

                ' Required field constraint
                If rs.Fields(i).Required And Len(uiVal) = 0 Then
                    MsgBox "Validation Error: Field [" & fName & "] is required and cannot be empty.", vbExclamation, "Validation Error"
                    Exit Sub
                End If
            End If
        Next i

        ' 2. Commit updates to database
        updatedAny = False
        For i = 0 To fldCnt - 1
            fName = rs.Fields(i).Name
            If UCase$(fName) <> "ID" Then
                Select Case i
                    Case 0: uiVal = Trim$(txtFormFld1.Text)
                    Case 1: uiVal = Trim$(txtFormFld2.Text)
                    Case 2: uiVal = Trim$(txtFormFld3.Text)
                    Case 3: uiVal = Trim$(txtFormFld4.Text)
                    Case 4: uiVal = Trim$(txtFormFld5.Text)
                End Select
                dbVal = StudioController.ConvertLookupDisplayToKey(curTable, fName, uiVal)
                If StudioController.UpdateActiveRecordField(fName, dbVal, errMsg) Then
                    updatedAny = True
                End If
            End If
        Next i

        If updatedAny Then
            lblStatus.Caption = "Saved record #" & CStr(StudioController.GetCurrentRecordIndex()) & " changes to [" & curTable & "]!"
            If StudioController.GetViewMode() = 2 Then
                DisplayFormView curTable
            Else
                DisplayTableDatasheet curTable
            End If
        Else
            If Len(errMsg) > 0 Then
                MsgBox "Could not update record: " & errMsg, vbExclamation, "Save Record"
            End If
        End If
    End Sub

    Private Sub btnNewFormRec_Click()
        btnAddRecord_Click
    End Sub

    Private Sub btnRunVbaCode_Click()
        Dim codeText As String
        Dim lines() As String
        Dim i As Long
        Dim ln As String
        Dim q1 As Long
        Dim q2 As Long
