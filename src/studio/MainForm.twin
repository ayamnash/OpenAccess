    Private Sub fcTxt01_LostFocus()
        If m_currentWorkspaceMode = 0 Or m_currentWorkspaceMode = 11 Then
            CommitDatasheetCellEdit
        ElseIf m_currentWorkspaceMode = 12 Then
            CommitQbeCellEdit
        ElseIf m_currentWorkspaceMode = 1 Then
            CommitTableDesignCellEdit
        End If
    End Sub

    Private Sub fcCbo01_LostFocus()
        If m_currentWorkspaceMode = 0 Or m_currentWorkspaceMode = 11 Then
            CommitDatasheetCellEdit
        ElseIf m_currentWorkspaceMode = 12 Then
            CommitQbeCellEdit
        ElseIf m_currentWorkspaceMode = 1 Then
            CommitTableDesignCellEdit
        End If
    End Sub


    ' -------------------------------------------------------------------------
    ' Phase 5: Table Relationships & Referential Integrity
    ' -------------------------------------------------------------------------
    Private Function GetTableBoxX(ByVal t As Long) As Long
        If t >= 0 And t <= 63 Then
            If m_qbeBoxX(t) > 0 Then
                GetTableBoxX = m_qbeBoxX(t)
                Exit Function
            End If
        End If
        Dim colsPerRow As Long
        On Error Resume Next
        colsPerRow = (CLng(picQryTables.ScaleWidth) - 24) \ (QD_BOX_W_PX + 36)
        On Error GoTo 0
        If colsPerRow < 3 Then colsPerRow = 4
        GetTableBoxX = QD_BOX_LEFT_PX + (t Mod colsPerRow) * (QD_BOX_W_PX + 36)
    End Function

    Private Function GetTableBoxY(ByVal t As Long) As Long
        If t >= 0 And t <= 63 Then
            If m_qbeBoxY(t) > 0 Then
                GetTableBoxY = m_qbeBoxY(t)
                Exit Function
            End If
        End If
        Dim colsPerRow As Long
        On Error Resume Next
        colsPerRow = (CLng(picQryTables.ScaleWidth) - 24) \ (QD_BOX_W_PX + 36)
        On Error GoTo 0
        If colsPerRow < 3 Then colsPerRow = 4
        GetTableBoxY = 44 + (t \ colsPerRow) * 120
    End Function

    Private Sub btnRelationships_Click()
        If Not StudioController.IsDatabaseOpen() Then
            MsgBox "Please open a database first.", vbInformation, "OpenAccess Studio"
            Exit Sub
        End If

        If m_dsEditActive Then CommitDatasheetCellEdit
        If m_dsRecordDirty Then SaveDatasheetRecord
        If m_currentWorkspaceMode = 1 Then
            If m_tdEditing Then CommitTableDesignCellEdit
            If Not m_tdIsNewTable And Len(m_tdTableName) > 0 Then SyncExistingTableDesignToDisk m_tdTableName
        End If

        SwitchWorkspaceMode 8
        DisplayRelationshipsView False
    End Sub

    Private Sub UpdateQbeJoinDialogCheckCaptions()
        On Error Resume Next
        Dim lTbl As String
        Dim rTbl As String
        lTbl = Trim$(fcCbo02.Text)
        If Len(lTbl) = 0 And fcCbo02.ListIndex >= 0 Then lTbl = Trim$(fcCbo02.List(fcCbo02.ListIndex))
        rTbl = Trim$(fcCbo04.Text)
        If Len(rTbl) = 0 And fcCbo04.ListIndex >= 0 Then rTbl = Trim$(fcCbo04.List(fcCbo04.ListIndex))
        fcChk01.Caption = "1: INNER JOIN (Only rows where joined fields are equal)"
        fcChk02.Caption = "2: LEFT JOIN (Include ALL records from [" & lTbl & "])"
        fcChk03.Caption = "3: RIGHT JOIN (Include ALL records from [" & rTbl & "])"
        On Error GoTo 0
    End Sub

    Private Sub CloseVisualRelationshipDialog()
        On Error Resume Next
        m_relDialogActive = False
        m_relDialogIsQbeJoin = False
        m_relDialogQbeJoinIdx = -1
        m_relDialogExistingName = vbNullString
        picSub01.Visible = False
        fcCbo02.Visible = False
        fcCbo03.Visible = False
        fcCbo04.Visible = False
        fcCbo05.Visible = False
        fcChk01.Visible = False
        fcChk02.Visible = False
        fcChk03.Visible = False
        fcBtn01.Visible = False
        fcBtn02.Visible = False
        fcBtn03.Visible = False
        If m_currentWorkspaceMode = 8 Or m_currentWorkspaceMode = 12 Then
            PaintQueryTables picQryTables, m_qbeTables, m_qbeJoins
            If m_currentWorkspaceMode = 12 Then PaintQbeGrid picQbeGrid, m_qbeCols
        ElseIf m_currentWorkspaceMode = 1 Then
            PaintTableDesignGrid
        ElseIf m_currentWorkspaceMode = 0 Or m_currentWorkspaceMode = 11 Then
            PaintQueryDatasheet
        End If
        On Error GoTo 0
    End Sub

    Private Sub PopulateRelDialogFieldCombo(ByVal cbo As ComboBox, ByVal tblName As String, ByVal preferPk As Boolean, Optional ByVal preferredField As String = "")
        On Error Resume Next
        cbo.Clear
        Dim cleanT As String
        cleanT = Trim$(tblName)
        If Len(cleanT) = 0 Then Exit Sub

        Dim fNames() As String
        Dim fCount As Long
        Dim i As Long
        Dim selIdx As Long
        fCount = StudioController.GetTableFieldNames(cleanT, fNames)
        If fCount <= 0 Then Exit Sub

        selIdx = -1
        For i = 0 To fCount - 1
            cbo.AddItem fNames(i)
            If Len(preferredField) > 0 Then
                If StrComp(Trim$(fNames(i)), Trim$(preferredField), vbTextCompare) = 0 Then
                    If preferPk Or Not IsPrimaryKeyField(cleanT, fNames(i)) Then
                        selIdx = i
                    End If
                End If
            End If
        Next i

        If selIdx < 0 Then
            If preferPk Then
                For i = 0 To fCount - 1
                    If IsPrimaryKeyField(cleanT, fNames(i)) Then
                        selIdx = i
                        Exit For
                    End If
                Next i
                If selIdx < 0 Then selIdx = 0
            Else
                If Len(preferredField) > 0 Then
                    Dim uPref As String
                    uPref = UCase$(Trim$(Replace$(preferredField, "_", "")))
                    For i = 0 To fCount - 1
                        If Not IsPrimaryKeyField(cleanT, fNames(i)) Then
                            Dim uCand As String
                            uCand = UCase$(Trim$(Replace$(fNames(i), "_", "")))
                            If InStr(1, uCand, uPref) > 0 Or InStr(1, uPref, uCand) > 0 Then
                                selIdx = i
                                Exit For
                            End If
                        End If
                    Next i
                End If
                If selIdx < 0 Then
                    If fCount > 1 Then selIdx = fCount - 1 Else selIdx = 0
                End If
            End If
        End If

        If selIdx >= 0 And selIdx < cbo.ListCount Then
            cbo.ListIndex = selIdx
            cbo.Text = cbo.List(selIdx)
        End If
        On Error GoTo 0
    End Sub

    Public Sub PaintVisualRelationshipDialog()
        On Error Resume Next
        If Not m_relDialogActive Then Exit Sub
        Dim pic As PictureBox
        Set pic = picSub01
        If pic Is Nothing Then Exit Sub

        Dim w As Long
        Dim h As Long
        w = CLng(pic.ScaleWidth)
        h = CLng(pic.ScaleHeight)
        If w <= 0 Then w = 540
        If h <= 0 Then h = 310

        pic.AutoRedraw = True
        pic.ScaleMode = vbPixels
        pic.BackColor = &HF4F4F4&
        pic.Cls
        pic.FontTransparent = True

        ' Outer dialog border & shadow
        pic.Line (0, 0)-(w - 1, h - 1), &H404040&, B
        pic.Line (1, 1)-(w - 2, h - 2), &H909090&, B

        ' Title Bar
        pic.Line (2, 2)-(w - 3, 28), &H6B3A1E&, BF
        pic.FontName = "Segoe UI"
        pic.FontSize = 9
        pic.FontBold = True
        pic.ForeColor = &HFFFFFF&
        pic.CurrentX = 12
        pic.CurrentY = 6
        If m_relDialogIsQbeJoin Then
            pic.Print "Query Join Properties & Delete Relationship — [" & fcCbo02.Text & "] <---> [" & fcCbo04.Text & "]"
        ElseIf Len(m_relDialogExistingName) > 0 Then
            pic.Print "Edit Relationships — [" & m_relDialogExistingName & "]"
        Else
            pic.Print "Edit Relationships & Lookup Wizard (Visual Table/Field Selector)"
        End If

        ' Group 1: Primary / Left Table/Query
        pic.Line (14, 36)-(202, 148), &HC0C0C0&, B
        pic.Line (16, 38)-(200, 56), &HE8DFD5&, BF
        pic.FontBold = True
        pic.FontSize = 8
        pic.ForeColor = &H202020&
        pic.CurrentX = 22
        pic.CurrentY = 40
        If m_relDialogIsQbeJoin Then
            pic.Print "Left Table / Query:"
        Else
            pic.Print "Table/Query (Primary - 1):"
        End If

        pic.FontBold = False
        pic.CurrentX = 22
        pic.CurrentY = 92
        If m_relDialogIsQbeJoin Then
            pic.Print "Left Join Field:"
        Else
            pic.Print "Primary Key Field (1):"
        End If

        ' Group 2: Related / Right Table/Query
        pic.Line (212, 36)-(400, 148), &HC0C0C0&, B
        pic.Line (214, 38)-(398, 56), &HE8DFD5&, BF
        pic.FontBold = True
        pic.ForeColor = &H202020&
        pic.CurrentX = 220
        pic.CurrentY = 40
        If m_relDialogIsQbeJoin Then
            pic.Print "Right Table / Query:"
        Else
            pic.Print "Related Table (Foreign - oo):"
        End If

        pic.FontBold = False
        pic.CurrentX = 220
        pic.CurrentY = 92
        If m_relDialogIsQbeJoin Then
            pic.Print "Right Join Field:"
        Else
            pic.Print "Foreign Key Field (oo):"
        End If

        ' Group 3: Options / Checkboxes
        pic.Line (14, 156)-(400, 260), &HC0C0C0&, B

        ' Bottom Relationship Type & Lookup status box
        pic.Line (14, 268)-(w - 14, 298), &HEAEAEA&, BF
        pic.Line (14, 268)-(w - 14, 298), &HC0C0C0&, B
        pic.FontBold = True
        pic.ForeColor = &H503010&
        pic.CurrentX = 22
        pic.CurrentY = 275
        If m_relDialogIsQbeJoin Then
            pic.Print "Tip: Click 'Delete Join [X]' (or right-click any line / press Delete key) to remove this join."
        Else
            pic.Print "Relationship Type:   One-To-Many (1 ---> oo)   |   Auto Lookup ComboBox"
        End If
        On Error GoTo 0
    End Sub

    Public Sub LayoutVisualRelationshipDialog()
        On Error Resume Next
        If Not m_relDialogActive Then Exit Sub

        Dim sw As Long
        Dim sh As Long
        sw = CLng(Me.ScaleWidth)
        sh = CLng(Me.ScaleHeight)
        If sw < 780 Then sw = 1220
        If sh < 480 Then sh = 730

        Dim dlgW As Long
        Dim dlgH As Long
        Dim dlgX As Long
        Dim dlgY As Long
        dlgW = 536
        dlgH = 310
        dlgX = 238 + ((sw - 250 - dlgW) \ 2)
        If dlgX < 248 Then dlgX = 248
        dlgY = 104 + ((sh - 200 - dlgH) \ 2)
        If dlgY < 114 Then dlgY = 114

        picSub01.Left = dlgX
        picSub01.Top = dlgY
        picSub01.Width = dlgW
        picSub01.Height = dlgH
        picSub01.Visible = True
