        fcCbo02.ZOrder 0

        fcCbo03.Left = dlgX + 22
        fcCbo03.Top = dlgY + 112
        fcCbo03.Width = 172
        fcCbo03.Visible = True
        fcCbo03.ZOrder 0

        fcCbo04.Left = dlgX + 220
        fcCbo04.Top = dlgY + 62
        fcCbo04.Width = 172
        fcCbo04.Visible = True
        fcCbo04.ZOrder 0

        fcCbo05.Left = dlgX + 220
        fcCbo05.Top = dlgY + 112
        fcCbo05.Width = 172
        fcCbo05.Visible = True
        fcCbo05.ZOrder 0

        fcChk01.Left = dlgX + 24
        fcChk01.Top = dlgY + 166
        fcChk01.Width = 366
        fcChk01.Height = 22
        fcChk01.BackColor = &HF4F4F4&
        fcChk01.Visible = True
        fcChk01.ZOrder 0

        fcChk02.Left = IIf(m_relDialogIsQbeJoin, dlgX + 24, dlgX + 42)
        fcChk02.Top = dlgY + 196
        fcChk02.Width = IIf(m_relDialogIsQbeJoin, 366, 348)
        fcChk02.Height = 22
        fcChk02.BackColor = &HF4F4F4&
        fcChk02.Visible = True
        fcChk02.ZOrder 0

        fcChk03.Left = IIf(m_relDialogIsQbeJoin, dlgX + 24, dlgX + 42)
        fcChk03.Top = dlgY + 226
        fcChk03.Width = IIf(m_relDialogIsQbeJoin, 366, 348)
        fcChk03.Height = 22
        fcChk03.BackColor = &HF4F4F4&
        fcChk03.Visible = True
