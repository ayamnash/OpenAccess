        LoadSelectedTableOrQuery
    End Sub

    Private Sub lstTables_Click()
        LoadSelectedTableOrQuery
    End Sub

    Private Sub lstTables_DblClick()
        ' Double-clicking a table in the Navigation Pane stays in Datasheet View (use Design View button or Right-Click -> Design View to edit schema)
    End Sub

    Private Sub lstTables_MouseDown(Button As Integer, Shift As Integer, X As Single, Y As Single)
        On Error Resume Next
        If Button <> vbRightButton Then Exit Sub
        If Not StudioController.IsDatabaseOpen() Then Exit Sub

        Dim pt As WIN32_POINT
        Dim screenPt As WIN32_POINT
        Dim hitRet As Long
        Dim hitIdx As Long

        GetCursorPos screenPt
        pt.X = screenPt.X
        pt.Y = screenPt.Y
        ScreenToClient lstTables.hWnd, pt
        hitRet = CLng(SendMessageW(lstTables.hWnd, &H1A9&, 0, (pt.Y * 65536) Or (pt.X And &HFFFF&)))
        If (hitRet And &H10000) = 0 Then
            hitIdx = hitRet And &HFFFF&
            If hitIdx >= 0 And hitIdx < lstTables.ListCount Then
                If lstTables.ListIndex <> hitIdx Then
                    lstTables.ListIndex = hitIdx
                End If
            End If
        End If

        If lstTables.ListIndex < 0 Or lstTables.ListIndex >= lstTables.ListCount Then Exit Sub

        Dim selItem As String
        Dim isQueryItem As Boolean
        Dim isCustomObj As Boolean
        Dim objCleanName As String

        selItem = Trim$(lstTables.List(lstTables.ListIndex))
        If Len(selItem) = 0 Then Exit Sub

        If Left$(selItem, 8) = "[Query] " Then
            isQueryItem = True
            objCleanName = Trim$(Mid$(selItem, 9))
        ElseIf Left$(selItem, 1) = "[" Then
            isCustomObj = True
            objCleanName = selItem
        Else
            objCleanName = selItem
        End If

        #If VBA7 Then
            Dim hMenu As LongPtr
        #Else
            Dim hMenu As Long
        #End If
        Dim cmdId As Long
        Dim lblDelete As String
        Dim lblDesign As String
        Dim lblOpen As String

        hMenu = CreatePopupMenu()
        If hMenu = 0 Then Exit Sub

        If isQueryItem Then
            lblDelete = "Delete Query"
            lblDesign = "Design View"
            lblOpen = "Open Datasheet View"
            AppendMenuW hMenu, &H0&, 1, StrPtr(lblDelete)
            AppendMenuW hMenu, &H0&, 2, StrPtr(lblDesign)
            AppendMenuW hMenu, &H800&, 0, 0
            AppendMenuW hMenu, &H0&, 3, StrPtr(lblOpen)
        ElseIf Not isCustomObj Then
            lblDelete = "Delete Table"
            lblDesign = "Design View"
            lblOpen = "Open Datasheet View"
            AppendMenuW hMenu, &H0&, 1, StrPtr(lblDelete)
            AppendMenuW hMenu, &H0&, 2, StrPtr(lblDesign)
            AppendMenuW hMenu, &H800&, 0, 0
            AppendMenuW hMenu, &H0&, 3, StrPtr(lblOpen)
        Else
            lblOpen = "Open Object"
            AppendMenuW hMenu, &H0&, 3, StrPtr(lblOpen)
        End If

        cmdId = TrackPopupMenu(hMenu, &H100& Or &H2&, screenPt.X, screenPt.Y, 0, Me.hWnd, 0)
        DestroyMenu hMenu

        If cmdId = 1 Then
            If isQueryItem Then
                If MsgBox("Do you want to permanently delete the query '" & objCleanName & "'?", vbYesNo + vbQuestion + vbDefaultButton2, "Microsoft Access") = vbYes Then
                    StudioController.ActiveDatabase.QueryDefs.Delete objCleanName
                    RefreshNavigationPane
                    lblStatus.Caption = "Deleted query [" & objCleanName & "]."
                End If
            ElseIf Not isCustomObj Then
                Dim relTables As String
                Dim delErr As String
                relTables = StudioController.GetTableRelationshipsList(objCleanName)
                If Len(relTables) > 0 Then
                    MsgBox "You can't delete the table '" & objCleanName & "' because it is participating in one or more relationships with table(s): " & relTables & "." & vbCrLf & vbCrLf & "Delete its relationships in the Relationships window first before you delete the table.", vbExclamation, "Microsoft Access"
                    Exit Sub
                End If
                If MsgBox("Do you want to permanently delete the table '" & objCleanName & "'?", vbYesNo + vbQuestion + vbDefaultButton2, "Microsoft Access") = vbYes Then
                    CancelDatasheetCellEdit
                    m_tdEditing = False
                    fcTxt01.Visible = False
                    fcCbo01.Visible = False
                    If StudioController.DeleteTableIfUnlinked(objCleanName, delErr) Then
                        QbeRemoveTableByName objCleanName
                        RefreshNavigationPane
                        lblStatus.Caption = "Deleted table [" & objCleanName & "]."
                    ElseIf Len(delErr) > 0 Then
                        MsgBox delErr, vbExclamation, "Microsoft Access"
                    End If
                End If
            End If
        ElseIf cmdId = 2 Then
            If isQueryItem Then
                OpenQbeDesigner objCleanName
            ElseIf Not isCustomObj Then
                If m_dsEditActive Then CommitDatasheetCellEdit
                If m_dsRecordDirty Then SaveDatasheetRecord
                StudioController.SetViewMode 1
                btnToggleDesign.Caption = "Datasheet View"
                SwitchWorkspaceMode 1
                DisplayTableDesignView objCleanName
            End If
        ElseIf cmdId = 3 Then
            LoadSelectedTableOrQuery
        End If
        On Error GoTo 0
    End Sub

    Private Sub QbeRemoveTableByName(ByVal tblName As String)
        On Error Resume Next
        Dim lb As Long, ub As Long, i As Long, writeIdx As Long
        lb = -1: ub = -2
        lb = LBound(m_qbeTables): ub = UBound(m_qbeTables)
        If Err.Number <> 0 Or ub < lb Then
            Err.Clear
            On Error GoTo 0
            Exit Sub
        End If
        writeIdx = lb
        For i = lb To ub
            If StrComp(Trim$(m_qbeTables(i)), Trim$(tblName), vbTextCompare) <> 0 And Len(Trim$(m_qbeTables(i))) > 0 Then
                m_qbeTables(writeIdx) = m_qbeTables(i)
                m_qbeBoxX(writeIdx) = m_qbeBoxX(i)
                m_qbeBoxY(writeIdx) = m_qbeBoxY(i)
                writeIdx = writeIdx + 1
            End If
        Next i
        If writeIdx <= lb Then
            Erase m_qbeTables
        ElseIf writeIdx - 1 < ub Then
            ReDim Preserve m_qbeTables(lb To writeIdx - 1)
        End If
        On Error GoTo 0
    End Sub

    Private Sub txtNavSearch_Change()
        Dim searchPattern As String
        Dim tblCollection As Collection
        Dim qryCollection As Collection
        Dim frmCollection As Collection
        Dim rptCollection As Collection
        Dim macCollection As Collection
        Dim modCollection As Collection
        Dim itemVal As Variant
        Dim tName As String
        Dim catFilter As Long

        searchPattern = LCase$(Trim$(txtNavSearch.Text))
        lstTables.Clear
        If Not StudioController.IsDatabaseOpen() Then Exit Sub

        catFilter = StudioController.GetNavCategoryFilter()

        Set tblCollection = StudioController.GetTableNames()
        If catFilter = 0 Or catFilter = 1 Then
            For Each itemVal In tblCollection
                tName = CStr(itemVal)
                If Len(searchPattern) = 0 Or InStr(1, LCase$(tName), searchPattern) > 0 Then
                    lstTables.AddItem tName
                End If
            Next itemVal
        End If

        Set qryCollection = StudioController.GetQueryNames()
        If catFilter = 0 Or catFilter = 2 Then
            For Each itemVal In qryCollection
                tName = CStr(itemVal)
                If Len(searchPattern) = 0 Or InStr(1, LCase$(tName), searchPattern) > 0 Then
                    lstTables.AddItem "[Query] " & tName
                End If
            Next itemVal
        End If

        Set frmCollection = StudioController.GetCustomObjectNames("FORM")
        If catFilter = 0 Or catFilter = 3 Then
            For Each itemVal In frmCollection
                tName = CStr(itemVal)
                If Len(searchPattern) = 0 Or InStr(1, LCase$(tName), searchPattern) > 0 Then
                    lstTables.AddItem "[Form] " & tName
                End If
            Next itemVal
        End If

        Set rptCollection = StudioController.GetCustomObjectNames("REPORT")
        If catFilter = 0 Or catFilter = 4 Then
            For Each itemVal In rptCollection
                tName = CStr(itemVal)
                If Len(searchPattern) = 0 Or InStr(1, LCase$(tName), searchPattern) > 0 Then
                    lstTables.AddItem "[Report] " & tName
                End If
            Next itemVal
        End If

        Set macCollection = StudioController.GetCustomObjectNames("MACRO")
        If catFilter = 0 Or catFilter = 5 Then
            For Each itemVal In macCollection
                tName = CStr(itemVal)
                If Len(searchPattern) = 0 Or InStr(1, LCase$(tName), searchPattern) > 0 Then
                    lstTables.AddItem "[Macro] " & tName
                End If
            Next itemVal
        End If

        Set modCollection = StudioController.GetCustomObjectNames("MODULE")
        If catFilter = 0 Or catFilter = 6 Then
            For Each itemVal In modCollection
                tName = CStr(itemVal)
                If Len(searchPattern) = 0 Or InStr(1, LCase$(tName), searchPattern) > 0 Then
                    lstTables.AddItem "[Module] " & tName
                End If
            Next itemVal
        End If
    End Sub

    Private Sub LoadSelectedTableOrQuery()
        Dim selectedName As String
        Dim objName As String
        Dim srcName As String
        Dim objDef As String
        Dim errMsg As String
        Dim isQuery As Boolean

        If lstTables.ListIndex < 0 Then Exit Sub
        If m_dsEditActive Then CommitDatasheetCellEdit
        If m_dsRecordDirty Then SaveDatasheetRecord
        selectedName = lstTables.List(lstTables.ListIndex)

        ' Handle Saved Custom Objects (Forms, Reports, Macros, Modules)
        If Left$(selectedName, 7) = "[Form] " Then
            objName = Mid$(selectedName, 8)
            StudioController.SetActiveFormName objName
            m_formName = objName
            objDef = StudioController.GetCustomObjectDefinition("FORM", objName, srcName, errMsg)
            UpdateRibbonToolbar "FORM"
            ' Native form: layout from GetNativeFormLayout; _OpenAccess_Objects form: AutoForm layout.
            ' Both render through RenderNativeForm (mode 10); nothing is written to lstRecords.
            m_formNeedsOpen = True
            LoadFormLayout objName, objDef, srcName
            RenderNativeForm objName
            m_navSkipFormRebind = True
            UpdateNavigationControls
            m_navSkipFormRebind = False
            If Len(StudioController.GetActiveFormButtonCaption()) > 0 Then
                btnFormCmd.Caption = StudioController.GetActiveFormButtonCaption()
            Else
                btnFormCmd.Caption = "Form Event [Run]"
            End If
            SyncVisualFormControlsAndVbe
            lblStatus.Caption = "Form View: " & objName & " | Record Source: " & m_formLayout.RecordSource
            If Len(StudioController.GetLastLayoutStatus(objName)) > 0 Then
                lblStatus.Caption = lblStatus.Caption & " | " & StudioController.GetLastLayoutStatus(objName)
            End If
            If Len(m_formCanvasNote) > 0 Then
                lblStatus.Caption = lblStatus.Caption & " | " & m_formCanvasNote
            End If
            Exit Sub

        ElseIf Left$(selectedName, 9) = "[Report] " Then
            objName = Mid$(selectedName, 10)
            objDef = StudioController.GetCustomObjectDefinition("REPORT", objName, srcName, errMsg)
            UpdateRibbonToolbar "TABLE"
            SwitchWorkspaceMode 0
            DisplayReportView IIf(Len(srcName) > 0, srcName, objName)
            SyncVisualFormControlsAndVbe
            lblStatus.Caption = "Report View: [" & objName & "]"
            Exit Sub

        ElseIf Left$(selectedName, 8) = "[Macro] " Then
            objName = Mid$(selectedName, 9)
            objDef = StudioController.GetCustomObjectDefinition("MACRO", objName, srcName, errMsg)
            If Len(objDef) > 0 Then
                RunSavedMacroDefinition objName, objDef
            End If
            lblStatus.Caption = "Executed Macro: [" & objName & "]"
            Exit Sub

        ElseIf Left$(selectedName, 9) = "[Module] " Then
            objName = Mid$(selectedName, 10)
            StudioController.SetActiveFormName vbNullString
            StudioController.SetActiveModuleName objName
            UpdateRibbonToolbar "MODULE"
            SwitchWorkspaceMode 4
            btnFormCmd.Caption = "Run [" & objName & "]"
            DisplayVbaModuleView objName
            SyncVisualFormControlsAndVbe
            lblStatus.Caption = "VBE Tools: [" & objName & "] | Visual Basic Editor"
            Exit Sub

        ElseIf Left$(selectedName, 8) = "[Query] " Then
            selectedName = Mid$(selectedName, 9)
            isQuery = True
            StudioController.SetActiveFormName vbNullString
            m_formName = vbNullString
            UpdateRibbonToolbar "QUERY"
            ' Access opens a saved query in Datasheet View (mode 11, painted grid on picDatasheet)
            DisplayQueryDatasheet selectedName
            Exit Sub

        Else
            ' It is a standard Table!
            isQuery = False
            StudioController.SetActiveFormName vbNullString
            m_formName = vbNullString
            StudioController.SetActiveModuleName vbNullString
            btnFormCmd.Caption = "CALL MODULE"
            UpdateRibbonToolbar "TABLE"
            DisplayTableDatasheet selectedName
            lblStatus.Caption = "Table Tools: [" & selectedName & "] | Datasheet View"
        End If
    End Sub

    ' -------------------------------------------------------------------------
    ' Phase 19: Save Object Wizard (Query, Form, Report, Macro, VBA Module)
    ' -------------------------------------------------------------------------
    Private Sub btnSaveObject_Click()
        Dim objTypeChoice As String
        Dim objName As String
        Dim curTable As String
        Dim objDef As String
        Dim errMsg As String
        Dim ok As Boolean

        If Not StudioController.IsDatabaseOpen() Then
            MsgBox "Please open a database first.", vbInformation, "OpenAccess Studio"
            Exit Sub
        End If

        If m_currentWorkspaceMode = 4 Or m_currentWorkspaceMode = 7 Or m_currentWorkspaceMode = 9 Or m_currentRibbonContext = "MODULE" Then
            btnSaveVbaCode_Click
            Exit Sub
        End If

        If m_currentRibbonContext = "FORM" Or m_currentWorkspaceMode = 2 Or m_currentWorkspaceMode = 3 Or m_currentWorkspaceMode = 6 Or m_currentWorkspaceMode = 10 Or StudioController.IsNativeFormActive() Or Len(Trim$(m_formName)) > 0 Then
            SaveActiveFormDirectly
            Exit Sub
        End If

        If m_currentWorkspaceMode = 0 Or m_currentWorkspaceMode = 11 Then
            If m_dsEditActive Then CommitDatasheetCellEdit
            If m_dsRecordDirty Then
                If SaveDatasheetRecord() Then
                    lblStatus.Caption = "Datasheet record saved to disk."
                End If
                Exit Sub
            End If
        End If

        curTable = StudioController.GetActiveTableName()
        If Len(curTable) = 0 Or curTable = "SQL Query Result" Then curTable = "Customers"

        If m_currentWorkspaceMode = 1 Then
            If m_tdEditing Then CommitTableDesignCellEdit
            Dim saveTblName As String
            Dim createCols As String
            Dim pkColName As String
            Dim colSpec As String
            Dim fIdx As Long
            Dim saveErr As String
            Dim saveOk As Boolean

            saveTblName = m_tdTableName
            If m_tdIsNewTable Or Len(saveTblName) = 0 Then
                Dim tblConflictMsg As String
                If Len(saveTblName) = 0 Or Len(StudioController.CheckTableOrQueryNameConflict(saveTblName, False)) > 0 Then
                    saveTblName = GetNextAvailableTableName()
                End If
                Do
                    saveTblName = InputBox("Enter table name to save:", "Save Table", saveTblName)
                    saveTblName = Trim$(Replace$(Replace$(saveTblName, "[", ""), "]", ""))
                    If Len(saveTblName) = 0 Then Exit Sub
                    tblConflictMsg = StudioController.CheckTableOrQueryNameConflict(saveTblName, False)
                    If Len(tblConflictMsg) = 0 Then Exit Do
                    MsgBox tblConflictMsg, vbInformation, "Microsoft Access"
                Loop
            End If

            If m_tdIsNewTable Then
                If m_tdFieldCount <= 0 Then
                    MsgBox "Table must have at least one field.", vbExclamation, "Save Table"
                    Exit Sub
                End If

                createCols = ""
                pkColName = ""
                For fIdx = 0 To m_tdFieldCount - 1
                    If Len(Trim$(m_tdFields(fIdx).FieldName)) > 0 Then
                        colSpec = "[" & m_tdFields(fIdx).FieldName & "] " & MapAccessNameToDdlType(m_tdFields(fIdx).DataTypeName, m_tdFields(fIdx).FieldSize)
                        If m_tdFields(fIdx).IsPrimaryKey Then
                            pkColName = m_tdFields(fIdx).FieldName
                            If InStr(1, UCase$(colSpec), "PRIMARY KEY") = 0 Then
                                colSpec = colSpec & " PRIMARY KEY"
                            End If
                        End If
                        If Len(createCols) > 0 Then createCols = createCols & ", "
                        createCols = createCols & colSpec
                    End If
                Next fIdx

                saveOk = StudioController.CreateNewTableDdl(saveTblName, createCols, saveErr)
                If saveOk Then
                    m_tdIsNewTable = False
                    m_tdTableName = saveTblName
                    RefreshNavigationPane
                    MsgBox "Table [" & saveTblName & "] created and saved successfully!", vbInformation, "OpenAccess Studio"
                    DisplayTableDatasheet saveTblName
                Else
                    MsgBox "Error creating table: " & saveErr, vbCritical, "Save Table Error"
                End If
            Else
                SyncExistingTableDesignToDisk saveTblName
                RefreshNavigationPane
                MsgBox "Table [" & saveTblName & "] design changes saved successfully!", vbInformation, "OpenAccess Studio"
                DisplayTableDatasheet saveTblName
            End If
            Exit Sub
        End If

        If m_currentRibbonContext = "QUERY" Or m_currentWorkspaceMode = 11 Or m_currentWorkspaceMode = 12 Or m_currentWorkspaceMode = 13 Then
            Dim qSaveName As String
            Dim defName As String
            Dim qryConflictMsg As String
            defName = m_activeQueryName
            If Len(defName) = 0 Or defName = "SQL Query Result" Or Len(StudioController.CheckTableOrQueryNameConflict(defName, True)) > 0 Then
                defName = GetNextAvailableQueryName()
            End If
            If m_currentWorkspaceMode = 12 Then
                CommitQbeCellEdit
                If m_qbeColCount > 0 Then
                    RebuildSqlFromQbeGrid
                End If
            End If
            Do
                qSaveName = InputBox("Query Name:", "Save As", defName)
                qSaveName = Trim$(Replace$(Replace$(qSaveName, "[", ""), "]", ""))
                If Len(qSaveName) = 0 Then Exit Sub
                qryConflictMsg = StudioController.CheckTableOrQueryNameConflict(qSaveName, True)
                If Len(qryConflictMsg) = 0 Then Exit Do
                MsgBox qryConflictMsg, vbInformation, "Microsoft Access"
                defName = qSaveName
            Loop
            ok = StudioController.CreateSavedQuery(qSaveName, txtSql.Text, errMsg)
            If ok Then
                m_activeQueryName = qSaveName
                lblTableTitle.Caption = qSaveName
                RefreshNavigationPane
                MsgBox "QUERY [" & qSaveName & "] saved to database catalog successfully!", vbInformation, "Query Saved"
                lblStatus.Caption = "Saved QUERY [" & qSaveName & "]."
            Else
                MsgBox errMsg, vbInformation, "Microsoft Access"
            End If
            Exit Sub
        End If

        objTypeChoice = InputBox("Enter object type to save (QUERY, FORM, REPORT, MACRO, MODULE):", "Save Access Object (1/2)", "QUERY")
        objTypeChoice = UCase$(Trim$(objTypeChoice))
        If Len(objTypeChoice) = 0 Then Exit Sub

        If objTypeChoice = "QUERY" Then
            Dim qCandName As String
            Dim qObjConflictMsg As String
            qCandName = GetNextAvailableQueryName()
            Do
                objName = InputBox("Query Name:", "Save As", qCandName)
                objName = Trim$(Replace$(Replace$(objName, "[", ""), "]", ""))
                If Len(objName) = 0 Then Exit Sub
                qObjConflictMsg = StudioController.CheckTableOrQueryNameConflict(objName, True)
                If Len(qObjConflictMsg) = 0 Then Exit Do
                MsgBox qObjConflictMsg, vbInformation, "Microsoft Access"
                qCandName = objName
            Loop
            ok = StudioController.CreateSavedQuery(objName, txtSql.Text, errMsg)
        ElseIf objTypeChoice = "FORM" Then
            objName = InputBox("Enter name for the saved Form:", "Save Form (2/2)", "frm_" & curTable)
            If Len(Trim$(objName)) = 0 Then Exit Sub
            ok = StudioController.SaveCustomAccessObject("FORM", Trim$(objName), curTable, "AutoFormLayout|" & curTable, errMsg)
        ElseIf objTypeChoice = "REPORT" Then
            objName = InputBox("Enter name for the saved Report:", "Save Report (2/2)", "rpt_" & curTable)
            If Len(Trim$(objName)) = 0 Then Exit Sub
            ok = StudioController.SaveCustomAccessObject("REPORT", Trim$(objName), curTable, "AutoReportLayout|" & curTable, errMsg)
        ElseIf objTypeChoice = "MACRO" Then
            objName = InputBox("Enter name for the saved Macro:", "Save Macro (2/2)", "mac_" & curTable)
            If Len(Trim$(objName)) = 0 Then Exit Sub
            objDef = "OpenTable|" & curTable & ";ShowMessage|Macro [" & Trim$(objName) & "] executed on [" & curTable & "]"
            ok = StudioController.SaveCustomAccessObject("MACRO", Trim$(objName), curTable, objDef, errMsg)
        ElseIf objTypeChoice = "MODULE" Then
            objName = InputBox("Enter name for the saved VBA Module:", "Save VBA Module (2/2)", "mod_" & curTable)
            If Len(Trim$(objName)) = 0 Then Exit Sub
            objDef = InputBox("Enter VBA function or subroutine code:", "VBA Module Code", "Public Function GetVersion() As String : GetVersion = ""1.0"" : End Function")
            ok = StudioController.SaveCustomAccessObject("MODULE", Trim$(objName), "VBA", objDef, errMsg)
        Else
            MsgBox "Unsupported object type: " & objTypeChoice, vbExclamation, "Save Object"
            Exit Sub
        End If

        If ok Then
            RefreshNavigationPane
            MsgBox objTypeChoice & " [" & objName & "] saved to database catalog successfully!", vbInformation, "Object Saved"
            lblStatus.Caption = "Saved " & objTypeChoice & " [" & objName & "]."
        Else
            MsgBox "Error saving object: " & errMsg, vbCritical, "Save Error"
        End If
    End Sub

    ' -------------------------------------------------------------------------
    ' Phase 3 & Phase 18: Table Design View & Interactive Schema DDL Modifier
    ' -------------------------------------------------------------------------
    Private Sub btnToggleDesign_Click()
        If Not StudioController.IsDatabaseOpen() Then
            MsgBox "Please open a database first.", vbInformation, "OpenAccess Studio"
            Exit Sub
        End If

        If m_currentWorkspaceMode = 1 Then
            If m_tdEditing Then CommitTableDesignCellEdit
            If m_tdIsNewTable And m_tdFieldCount > 0 Then
                btnSaveObject_Click
                Exit Sub
            ElseIf Not m_tdIsNewTable And Len(m_tdTableName) > 0 Then
                SyncExistingTableDesignToDisk m_tdTableName
            End If
        End If

        Dim curTbl As String
        curTbl = StudioController.GetActiveTableName()

        If m_currentWorkspaceMode <> 1 Then
            StudioController.SetViewMode 1
            btnToggleDesign.Caption = "Datasheet View"
            If Len(curTbl) > 0 And curTbl <> "SQL Query Result" Then
                DisplayTableDesignView curTbl
            Else
                btnNewTable_Click
            End If
        Else
            StudioController.SetViewMode 0
            btnToggleDesign.Caption = "Design View [Alt+D]"
            If Len(curTbl) > 0 And curTbl <> "SQL Query Result" Then
                DisplayTableDatasheet curTbl
            End If
        End If
    End Sub



    Public Sub ApplyRuntimeModeRestrictions()
        StudioController.IsRuntimeMode = True
        On Error Resume Next
        btnRibbonCreate.Visible = False
        btnRibbonDbTools.Visible = False
        btnToggleDesign.Visible = False
        btnModifySchema.Visible = False
        btnQryDesign.Visible = False
        btnQbeDesign.Visible = False
        btnQueryBuilder.Visible = False
        btnFormDesign.Visible = False
        btnCreateFormWiz.Visible = False
        btnAddCtrlWiz.Visible = False
        btnVbaEditor.Visible = False
        btnNewTable.Visible = False
        On Error GoTo 0
        lblStatus.Caption = "OpenAccess Studio [Runtime Mode] - Application Mode Active"
    End Sub

    Public Sub LaunchDatabase(ByVal dbPath As String, ByVal asRuntime As Boolean)
        Dim errMsg As String
        Dim ok As Boolean
        ok = StudioController.OpenDatabaseFile(dbPath, errMsg)
        If ok Then
            lblDbInfo.Caption = "Active: " & dbPath
            RefreshNavigationPane
            If asRuntime Or StudioController.IsCompiledLocked Then
                ApplyRuntimeModeRestrictions
                Dim autoExecDef As String
                Dim autoExecSrc As String
                Dim autoExecErr As String
                If StudioController.HasMacro("AutoExec") Then
                    autoExecDef = StudioController.GetCustomObjectDefinition("MACRO", "AutoExec", autoExecSrc, autoExecErr)
                    If Len(autoExecDef) > 0 Then
                        RunSavedMacroDefinition "AutoExec", autoExecDef
                    End If
                Else
                    Dim startupForm As String
                    If StudioController.GetStartupFormName(startupForm) Then
                        OpenFormByName startupForm
                    End If
                End If
            End If
        Else
            lblStatus.Caption = "Runtime Error opening file: " & errMsg
        End If
    End Sub

        Private Function IsFieldInCollection(ByVal col As Collection, ByVal keyStr As String) As Boolean
        On Error GoTo NotFound
        Dim dummy As Variant
        dummy = col(UCase$(Trim$(keyStr)))
        IsFieldInCollection = True
        Exit Function
NotFound:
        IsFieldInCollection = False
        Err.Clear
    End Function

    Private Sub EnsureTdFieldCapacity(ByVal rowIdx As Long)
        On Error Resume Next
        Dim curUb As Long
        curUb = -1
        curUb = UBound(m_tdFields)
        If curUb < 0 Or Err.Number <> 0 Then
            Err.Clear
            ReDim m_tdFields(0 To 10)
            m_tdFieldCount = 0
            curUb = 10
        End If

        If rowIdx > curUb Then
            Dim newCap As Long
            newCap = rowIdx + 10
            ReDim Preserve m_tdFields(0 To newCap)
        End If

        If rowIdx >= m_tdFieldCount Then
            Dim k As Long
            For k = m_tdFieldCount To rowIdx
                m_tdFields(k).FieldName = ""
                m_tdFields(k).DataTypeName = "Short Text"
                m_tdFields(k).FieldSize = "255"
                m_tdFields(k).IsPrimaryKey = False
                m_tdFields(k).IsAutoNumber = False
                m_tdFields(k).Required = False
                m_tdFields(k).AllowZeroLength = True
                m_tdFields(k).DefaultValue = ""
                m_tdFields(k).ValidationRule = ""
                m_tdFields(k).ValidationText = ""
                m_tdFields(k).Description = ""
            Next k
            m_tdFieldCount = rowIdx + 1
            If UBound(m_tdFields) <= m_tdFieldCount Then
                ReDim Preserve m_tdFields(0 To m_tdFieldCount + 5)
            End If
            m_tdFields(m_tdFieldCount).FieldName = ""
            m_tdFields(m_tdFieldCount).DataTypeName = "(Click to add field)"
        End If
        On Error GoTo 0
    End Sub

    Public Sub DisplayTableDesignView(ByVal tableName As String)
        On Error Resume Next
        If StudioController.IsRuntimeMode Then Exit Sub

        If Len(Trim$(tableName)) = 0 Then
            StartNewVisualTableDesigner GetNextAvailableTableName()
            Exit Sub
        End If

        Dim db As Object
        Dim td As Object
        Dim fld As Object
        Dim idx As Object
        Dim pkFields As New Collection
        Dim i As Long
        Dim k As Long
        Dim fName As String
        Dim isPk As Boolean
        Dim isAuto As Boolean
        Dim dType As String
        Dim fSize As String

        Set db = StudioController.ActiveDatabase
        If db Is Nothing Then
            MsgBox "Please open a database first.", vbInformation, "OpenAccess Studio"
            Exit Sub
        End If

        Set td = db.TableDefs(tableName)
        If td Is Nothing Or Err.Number <> 0 Then
            Err.Clear
            StartNewVisualTableDesigner tableName
            Exit Sub
        End If

        ' Discover Primary Key fields safely
        For i = 0 To td.Indexes.Count - 1
            Set idx = td.Indexes(i)
            If Not idx Is Nothing Then
                If idx.Primary Then
                    For k = 0 To idx.Fields.Count - 1
                        pkFields.Add idx.Fields(k).Name, UCase$(idx.Fields(k).Name)
                    Next k
                End If
            End If
        Next i

        m_tdIsNewTable = False
        m_tdTableName = tableName
        m_tdFieldCount = td.Fields.Count
        m_tdSelectedRow = 0
        m_tdTopRow = 0

        ReDim m_tdFields(0 To m_tdFieldCount + 2)
        For i = 0 To m_tdFieldCount - 1
            Set fld = td.Fields(i)
            fName = fld.Name
            isAuto = False
            isAuto = ((fld.Attributes And 16) <> 0)

            isPk = IsFieldInCollection(pkFields, fName)
            If Not isPk And pkFields.Count = 0 And i = 0 And isAuto Then
                isPk = True
            End If

            dType = MapDaoTypeToAccessName(CInt(fld.Type), isAuto)
            fSize = CStr(fld.Size)

            m_tdFields(i).FieldName = fName
            m_tdFields(i).DataTypeName = dType
            m_tdFields(i).FieldSize = fSize
            m_tdFields(i).IsPrimaryKey = isPk
            m_tdFields(i).IsAutoNumber = isAuto
            m_tdFields(i).Required = fld.Required
            m_tdFields(i).AllowZeroLength = fld.AllowZeroLength
            m_tdFields(i).DefaultValue = CStr(fld.DefaultValue)
            m_tdFields(i).ValidationRule = CStr(fld.ValidationRule)
            m_tdFields(i).ValidationText = CStr(fld.ValidationText)
            m_tdFields(i).Description = ""
        Next i

        ' Empty trailing row for adding new fields
        m_tdFields(m_tdFieldCount).FieldName = ""
        m_tdFields(m_tdFieldCount).DataTypeName = "(Click to add field)"
        m_tdFields(m_tdFieldCount).FieldSize = "255"
        m_tdFields(m_tdFieldCount).IsPrimaryKey = False
        m_tdFields(m_tdFieldCount).IsAutoNumber = False
        m_tdFields(m_tdFieldCount).Required = False
        m_tdFields(m_tdFieldCount).AllowZeroLength = True
        m_tdFields(m_tdFieldCount).DefaultValue = ""
        m_tdFields(m_tdFieldCount).ValidationRule = ""
        m_tdFields(m_tdFieldCount).ValidationText = ""
        m_tdFields(m_tdFieldCount).Description = ""

        SwitchWorkspaceMode 1
        lblTableTitle.Caption = "Table: [" & tableName & "] - Design View (Schema & Properties)"
        UpdateNavigationControls
        PopulateTableFieldProperties 0
        PaintTableDesignGrid
        lblStatus.Caption = "Table Design View: [" & tableName & "] | " & m_tdFieldCount & " field(s)."
    End Sub

    Public Sub StartNewVisualTableDesigner(ByVal newTblName As String)
        On Error Resume Next
        If StudioController.IsRuntimeMode Then Exit Sub

        m_tdIsNewTable = True
        m_tdTableName = newTblName
        m_tdFieldCount = 1
        m_tdSelectedRow = 0
        m_tdTopRow = 0

        ReDim m_tdFields(0 To 4)
        ' Row 0: ID (AutoNumber, PK)
        m_tdFields(0).FieldName = "ID"
        m_tdFields(0).DataTypeName = "AutoNumber"
        m_tdFields(0).FieldSize = "4"
        m_tdFields(0).IsPrimaryKey = True
        m_tdFields(0).IsAutoNumber = True
        m_tdFields(0).Required = True
        m_tdFields(0).AllowZeroLength = False
        m_tdFields(0).DefaultValue = ""
        m_tdFields(0).ValidationRule = ""
        m_tdFields(0).ValidationText = ""
        m_tdFields(0).Description = "Primary key"

        ' Row 1: Empty trailing row
        m_tdFields(1).FieldName = ""
        m_tdFields(1).DataTypeName = "(Click to add field)"
        m_tdFields(1).FieldSize = "255"
        m_tdFields(1).IsPrimaryKey = False
        m_tdFields(1).IsAutoNumber = False
        m_tdFields(1).Required = False
        m_tdFields(1).AllowZeroLength = True
        m_tdFields(1).DefaultValue = ""
        m_tdFields(1).ValidationRule = ""
        m_tdFields(1).ValidationText = ""
        m_tdFields(1).Description = ""

        SwitchWorkspaceMode 1
        lblTableTitle.Caption = "Table: [" & newTblName & "] - Design View (New Table Draft)"
        UpdateNavigationControls
        PopulateTableFieldProperties 0
        PaintTableDesignGrid
        lblStatus.Caption = "Designing new table [" & newTblName & "]. Click fields to edit, or click Save to store in database."
    End Sub

    Private Function GetNextAvailableTableName() As String
        On Error Resume Next
        Dim candidate As String
        Dim num As Long
        num = 1
        Do
            candidate = "Table" & CStr(num)
            If Len(StudioController.CheckTableOrQueryNameConflict(candidate, False)) = 0 Then
                GetNextAvailableTableName = candidate
                Exit Function
            End If
            num = num + 1
        Loop
    End Function

    Private Function GetNextAvailableQueryName() As String
        On Error Resume Next
        Dim candidate As String
        Dim num As Long
        num = 1
        Do
            candidate = "Query" & CStr(num)
            If Len(StudioController.CheckTableOrQueryNameConflict(candidate, True)) = 0 Then
                GetNextAvailableQueryName = candidate
                Exit Function
            End If
            num = num + 1
        Loop
    End Function

    Private Sub btnModifySchema_Click()
        On Error Resume Next
        Dim curTable As String
        curTable = StudioController.GetActiveTableName()
        If Not StudioController.IsDatabaseOpen() Or Len(curTable) = 0 Or curTable = "SQL Query Result" Then
            MsgBox "Please select a table first to modify its schema.", vbInformation, "Modify Table Schema"
            Exit Sub
        End If

        DisplayTableDesignView curTable
    End Sub

    Private Sub PopulateTableFieldProperties(ByVal rowIdx As Long)
        On Error Resume Next
        lstPropSheet.Clear
        If rowIdx < 0 Or rowIdx >= m_tdFieldCount Then
            lstPropSheet.AddItem "(New Field - enter a Field Name above to define properties)"
            Exit Sub
        End If

        EnsureTdFieldCapacity rowIdx

        lstPropSheet.AddItem "Field Size:            " & m_tdFields(rowIdx).FieldSize
        lstPropSheet.AddItem "Format:                (Standard)"
        lstPropSheet.AddItem "Caption:               " & m_tdFields(rowIdx).FieldName
        lstPropSheet.AddItem "Default Value:         " & IIf(Len(m_tdFields(rowIdx).DefaultValue) > 0, m_tdFields(rowIdx).DefaultValue, "(None)")
        lstPropSheet.AddItem "Validation Rule:       " & IIf(Len(m_tdFields(rowIdx).ValidationRule) > 0, m_tdFields(rowIdx).ValidationRule, "(None)")
        lstPropSheet.AddItem "Validation Text:       " & IIf(Len(m_tdFields(rowIdx).ValidationText) > 0, m_tdFields(rowIdx).ValidationText, "(None)")
        lstPropSheet.AddItem "Required:              " & IIf(m_tdFields(rowIdx).Required, "Yes", "No")
        lstPropSheet.AddItem "Allow Zero Length:     " & IIf(m_tdFields(rowIdx).AllowZeroLength, "Yes", "No")
        lstPropSheet.AddItem "Indexed:               " & IIf(m_tdFields(rowIdx).IsPrimaryKey, "Yes (No Duplicates) [PK]", "No")

        Dim fName As String
        Dim hasLkp As Boolean
        Dim lkpSrc As String
        Dim dispCtrl As String
        fName = m_tdFields(rowIdx).FieldName
        hasLkp = False
        lkpSrc = "(None - Double-click to link Lookup Table)"
        dispCtrl = "Text Box"
        If Not StudioController.ActiveDatabase Is Nothing And Len(m_tdTableName) > 0 And Len(fName) > 0 Then
            Dim rIdx As Long
            Dim relObj As Object
            For rIdx = 0 To StudioController.ActiveDatabase.Relations.Count - 1
                Set relObj = StudioController.ActiveDatabase.Relations.Item(rIdx)
                If Not relObj Is Nothing Then
                    If StrComp(relObj.ForeignTable, m_tdTableName, vbTextCompare) = 0 And relObj.Fields.Count > 0 Then
                        If StrComp(relObj.Fields(0).ForeignName, fName, vbTextCompare) = 0 Then
                            hasLkp = True
                            dispCtrl = "Combo Box"
                            lkpSrc = "SELECT * FROM [" & relObj.Table & "] (Bound to [" & relObj.Fields(0).Name & "])"
                            Exit For
                        End If
                    End If
                End If
            Next rIdx
            If Not hasLkp Then
                If LookupCache.IsLookupField(StudioController.ActiveDatabase, m_tdTableName, fName) Then
                    hasLkp = True
                    dispCtrl = "Combo Box"
                    lkpSrc = "Table/Query Lookup Active"
                End If
            End If
        End If
        lstPropSheet.AddItem "--- [Lookup Properties (Dbl-Click to Configure Foreign Key / Combo Box)] ---"
        lstPropSheet.AddItem "Display Control:       " & dispCtrl
        lstPropSheet.AddItem "Row Source Type:       Table/Query"
        lstPropSheet.AddItem "Row Source:            " & lkpSrc
        lstPropSheet.AddItem "Bound Column:          1"
        lstPropSheet.AddItem "Column Count:          " & IIf(hasLkp, "2", "1")
        lstPropSheet.AddItem "Column Widths:         " & IIf(hasLkp, "0in;1in", "1in")
        lstPropSheet.AddItem "Limit To List:         " & IIf(hasLkp, "Yes", "No")
    End Sub

    Private Sub HandleTableDesignPropDblClick(ByVal selIdx As Long)
        On Error Resume Next
        If m_tdSelectedRow < 0 Or m_tdSelectedRow >= m_tdFieldCount Then Exit Sub
        If selIdx < 0 Or selIdx >= lstPropSheet.ListCount Then Exit Sub

        EnsureTdFieldCapacity m_tdSelectedRow

        Dim lineText As String
        Dim newVal As String
        Dim errMsg As String
        Dim fName As String

        lineText = lstPropSheet.List(selIdx)
        fName = m_tdFields(m_tdSelectedRow).FieldName

        If InStr(1, lineText, "Required:", vbTextCompare) > 0 Then
            m_tdFields(m_tdSelectedRow).Required = Not m_tdFields(m_tdSelectedRow).Required
            If Not m_tdIsNewTable Then
                StudioController.SetTableFieldProperty m_tdTableName, fName, "Required", m_tdFields(m_tdSelectedRow).Required, errMsg
            End If
            PopulateTableFieldProperties m_tdSelectedRow
            PaintTableDesignGrid

        ElseIf InStr(1, lineText, "Default Value:", vbTextCompare) > 0 Then
            newVal = InputBox("Enter Default Value for [" & fName & "]:", "Default Value", m_tdFields(m_tdSelectedRow).DefaultValue)
            If Len(newVal) > 0 Then
                m_tdFields(m_tdSelectedRow).DefaultValue = newVal
                If Not m_tdIsNewTable Then
                    StudioController.SetTableFieldProperty m_tdTableName, fName, "DefaultValue", newVal, errMsg
                End If
                PopulateTableFieldProperties m_tdSelectedRow
                PaintTableDesignGrid
            End If

        ElseIf InStr(1, lineText, "Validation Rule:", vbTextCompare) > 0 Then
            newVal = InputBox("Enter Validation Rule for [" & fName & "]:", "Validation Rule", m_tdFields(m_tdSelectedRow).ValidationRule)
            If Len(newVal) > 0 Then
                m_tdFields(m_tdSelectedRow).ValidationRule = newVal
                If Not m_tdIsNewTable Then
                    StudioController.SetTableFieldProperty m_tdTableName, fName, "ValidationRule", newVal, errMsg
                End If
                PopulateTableFieldProperties m_tdSelectedRow
                PaintTableDesignGrid
            End If

        ElseIf InStr(1, lineText, "Field Size:", vbTextCompare) > 0 Then
            newVal = InputBox("Enter Field Size for [" & fName & "]:", "Field Size", m_tdFields(m_tdSelectedRow).FieldSize)
            If Len(newVal) > 0 Then
                m_tdFields(m_tdSelectedRow).FieldSize = newVal
                PopulateTableFieldProperties m_tdSelectedRow
                PaintTableDesignGrid
            End If

        ElseIf InStr(1, lineText, "Allow Zero Length:", vbTextCompare) > 0 Then
            m_tdFields(m_tdSelectedRow).AllowZeroLength = Not m_tdFields(m_tdSelectedRow).AllowZeroLength
            PopulateTableFieldProperties m_tdSelectedRow
            PaintTableDesignGrid

        ElseIf InStr(1, lineText, "Indexed:", vbTextCompare) > 0 Then
            TogglePrimaryKey m_tdSelectedRow

        ElseIf InStr(1, lineText, "Lookup", vbTextCompare) > 0 Or InStr(1, lineText, "Display Control:", vbTextCompare) > 0 Or InStr(1, lineText, "Row Source", vbTextCompare) > 0 Or InStr(1, lineText, "Bound Column:", vbTextCompare) > 0 Or InStr(1, lineText, "Column Count:", vbTextCompare) > 0 Or InStr(1, lineText, "Column Widths:", vbTextCompare) > 0 Or InStr(1, lineText, "Limit To List:", vbTextCompare) > 0 Then
            If m_tdIsNewTable Then
                MsgBox "Please save the new table first (click 'Save Object'), then double-click Lookup Properties to link it to a primary table.", vbInformation, "Lookup Wizard"
                Exit Sub
            End If
            PromptCreateRelationshipDialog m_tdTableName, fName
            PopulateTableFieldProperties m_tdSelectedRow
        End If
    End Sub

    Private Sub TogglePrimaryKey(ByVal rowIdx As Long)
        On Error Resume Next
        If rowIdx < 0 Or rowIdx >= m_tdFieldCount Then Exit Sub
        EnsureTdFieldCapacity rowIdx

        m_tdFields(rowIdx).IsPrimaryKey = Not m_tdFields(rowIdx).IsPrimaryKey
        If m_tdFields(rowIdx).IsPrimaryKey Then
            m_tdFields(rowIdx).Required = True
        End If

        If Not m_tdIsNewTable Then
            Dim pkErr As String
            If m_tdFields(rowIdx).IsPrimaryKey Then
                StudioController.CreateTableIndexDdl m_tdTableName, "PrimaryKey", "[" & m_tdFields(rowIdx).FieldName & "]", True, True, pkErr
            Else
                StudioController.DropTableIndexDdl m_tdTableName, "PrimaryKey", pkErr
            End If
        End If

        PopulateTableFieldProperties rowIdx
        PaintTableDesignGrid
    End Sub

    Private Sub DeleteTableDesignField(ByVal rowIdx As Long)
        On Error Resume Next
        If rowIdx < 0 Or rowIdx >= m_tdFieldCount Then Exit Sub
        EnsureTdFieldCapacity rowIdx

        Dim fName As String
        Dim ans As VbMsgBoxResult
        Dim ok As Boolean
        Dim dropErr As String
        Dim k As Long

        fName = m_tdFields(rowIdx).FieldName
        ans = MsgBox("Do you want to permanently delete field [" & fName & "]?", vbYesNo + vbQuestion, "Delete Field")
        If ans <> vbYes Then Exit Sub

        If Not m_tdIsNewTable Then
            ok = StudioController.DropTableColumnDdl(m_tdTableName, fName, dropErr)
            If Not ok Then
                MsgBox "Error dropping column: " & dropErr, vbCritical, "Delete Field Error"
                Exit Sub
            End If
        End If

        For k = rowIdx To m_tdFieldCount - 1
            m_tdFields(k) = m_tdFields(k + 1)
        Next k
        m_tdFieldCount = m_tdFieldCount - 1

        If m_tdSelectedRow >= m_tdFieldCount Then m_tdSelectedRow = m_tdFieldCount - 1
        If m_tdSelectedRow < 0 Then m_tdSelectedRow = 0

        PopulateTableFieldProperties m_tdSelectedRow
        PaintTableDesignGrid
    End Sub

    Private Function MapAccessNameToDdlType(ByVal accessType As String, Optional ByVal fieldSize As String = "") As String
        Dim sz As Long
        sz = Val(fieldSize)
        If sz <= 0 Or sz > 255 Then sz = 255

        Select Case UCase$(Trim$(accessType))
            Case "AUTONUMBER": MapAccessNameToDdlType = "AUTOINCREMENT PRIMARY KEY"
            Case "SHORT TEXT", "TEXT": MapAccessNameToDdlType = "TEXT(" & CStr(sz) & ")"
            Case "LONG TEXT (MEMO)", "MEMO": MapAccessNameToDdlType = "MEMO"
            Case "NUMBER (LONG)", "LONG", "LONG INTEGER (32-BIT)": MapAccessNameToDdlType = "LONG"
            Case "NUMBER (DOUBLE)", "DOUBLE": MapAccessNameToDdlType = "DOUBLE"
            Case "CURRENCY": MapAccessNameToDdlType = "CURRENCY"
            Case "DATE/TIME", "DATETIME": MapAccessNameToDdlType = "DATETIME"
            Case "YES/NO", "YES/NO (BOOLEAN)", "BOOLEAN", "YESNO": MapAccessNameToDdlType = "YESNO"
            Case "BYTE": MapAccessNameToDdlType = "BYTE"
            Case "INTEGER (16-BIT)", "INTEGER": MapAccessNameToDdlType = "INTEGER"
            Case "SINGLE": MapAccessNameToDdlType = "SINGLE"
            Case "BINARY", "OLE OBJECT": MapAccessNameToDdlType = "LONGBINARY"
            Case Else: MapAccessNameToDdlType = "TEXT(255)"
        End Select
    End Function

    Private Function MapDaoTypeToAccessName(ByVal typeCode As Integer, Optional ByVal isAutoIncr As Boolean = False) As String
        If isAutoIncr Then
            MapDaoTypeToAccessName = "AutoNumber"
            Exit Function
        End If
        Select Case typeCode
            Case 1: MapDaoTypeToAccessName = "Yes/No"
            Case 2: MapDaoTypeToAccessName = "Byte"
            Case 3: MapDaoTypeToAccessName = "Integer (16-bit)"
            Case 4: MapDaoTypeToAccessName = "Number (Long)"
            Case 5: MapDaoTypeToAccessName = "Currency"
            Case 6: MapDaoTypeToAccessName = "Single"
            Case 7: MapDaoTypeToAccessName = "Number (Double)"
            Case 8: MapDaoTypeToAccessName = "Date/Time"
            Case 9: MapDaoTypeToAccessName = "Binary"
            Case 10: MapDaoTypeToAccessName = "Short Text"
            Case 11: MapDaoTypeToAccessName = "Long Text (Memo)"
            Case 12: MapDaoTypeToAccessName = "Long Text (Memo)"
            Case 15: MapDaoTypeToAccessName = "GUID"
            Case Else: MapDaoTypeToAccessName = "Short Text"
        End Select
    End Function

    Private Sub PaintTableDesignGrid()
        On Error Resume Next
        If m_currentWorkspaceMode <> 1 Then Exit Sub
        Dim pic As PictureBox
        Set pic = picDatasheet
        If pic Is Nothing Then Exit Sub

        pic.AutoRedraw = True
        pic.ScaleMode = vbPixels
        pic.BackColor = &HFFFFFF&
        pic.Cls
        pic.FontTransparent = True

        Dim hdrH As Long
        Dim rowH As Long
        Dim cw As Long
        Dim ch As Long
        Dim r As Long
        Dim y As Long
        Dim selPx As Long
        Dim nameW As Long
        Dim typeW As Long
        Dim descW As Long
        Dim actW As Long
        Dim totalFields As Long
        Dim isSelected As Boolean
        Dim rowBg As Long
        Dim fName As String
        Dim fType As String
        Dim fDesc As String
        Dim isPk As Boolean

        hdrH = 26
        rowH = 24
        selPx = 28
        nameW = 240
        typeW = 200
        descW = 360
        actW = 90
        cw = pic.ScaleWidth
        If cw > 954 Then descW = cw - selPx - nameW - typeW - 126
        ch = pic.ScaleHeight
        If cw <= 0 Then cw = 954
        If ch <= 0 Then ch = 300

        ' 1. Draw Header Row (y = 0 to hdrH - 1)
        pic.Line (0, 0)-(cw - 1, hdrH - 1), &HE6E6E6&, BF
        pic.Line (0, 0)-(cw - 1, hdrH - 1), &HA0A0A0&, B
        pic.Line (selPx, 0)-(selPx, hdrH - 1), &HA0A0A0&
        pic.Line (selPx + nameW, 0)-(selPx + nameW, hdrH - 1), &HA0A0A0&
        pic.Line (selPx + nameW + typeW, 0)-(selPx + nameW + typeW, hdrH - 1), &HA0A0A0&
        pic.Line (selPx + nameW + typeW + descW, 0)-(selPx + nameW + typeW + descW, hdrH - 1), &HA0A0A0&

        pic.FontName = "Segoe UI"
        pic.FontSize = 9
        pic.FontBold = True
        pic.ForeColor = &H202020&

        pic.CurrentX = selPx + 8
        pic.CurrentY = 4
        pic.Print "Field Name"

        pic.CurrentX = selPx + nameW + 8
        pic.CurrentY = 4
        pic.Print "Data Type"

        pic.CurrentX = selPx + nameW + typeW + 8
        pic.CurrentY = 4
        pic.Print "Description / Constraints"

        pic.CurrentX = selPx + nameW + typeW + descW + 8
        pic.CurrentY = 4
        pic.Print "Actions"

        totalFields = m_tdFieldCount + 1

        ' Check if any field has IsPrimaryKey = True
        Dim anyExplicitPk As Boolean
        anyExplicitPk = False
        For r = 0 To m_tdFieldCount - 1
            If m_tdFields(r).IsPrimaryKey Then anyExplicitPk = True: Exit For
        Next r

        ' Synchronize scrollbar
        Dim visibleRows As Long
        visibleRows = (ch - hdrH) \ rowH
        If visibleRows < 1 Then visibleRows = 1
        Dim maxTop As Long
        If totalFields > visibleRows Then maxTop = totalFields - visibleRows Else maxTop = 0
        vsbDatasheet.Min = 0
        vsbDatasheet.Max = maxTop
        vsbDatasheet.SmallChange = 1
        vsbDatasheet.LargeChange = IIf(visibleRows > 1, visibleRows, 1)
        vsbDatasheet.Enabled = (maxTop > 0)
        If m_tdTopRow > maxTop Then m_tdTopRow = maxTop
        vsbDatasheet.Value = m_tdTopRow

        ' 2. Draw Rows
        For r = m_tdTopRow To m_tdTopRow + visibleRows - 1
            If r >= totalFields Then Exit For
            y = hdrH + (r - m_tdTopRow) * rowH
            If y + rowH > ch Then Exit For

            isSelected = (r = m_tdSelectedRow)
            If isSelected Then rowBg = &HF2E6D8& Else rowBg = &HFFFFFF&

            ' Row selector cell (0 to selPx)
            pic.Line (0, y)-(selPx - 1, y + rowH - 1), &HEEEEEE&, BF
            pic.Line (0, y)-(selPx - 1, y + rowH - 1), &HD0D0D0&, B

            If r < m_tdFieldCount Then
                isPk = m_tdFields(r).IsPrimaryKey
                ' Primary key display: show ONLY for genuine PK or first field if AutoNumber without other PKs
                If Not isPk And Not anyExplicitPk And r = 0 And m_tdFields(r).IsAutoNumber Then
                    isPk = True
                End If

                fName = m_tdFields(r).FieldName
                fType = m_tdFields(r).DataTypeName
                fDesc = m_tdFields(r).Description
                If Len(fDesc) = 0 Then
                    If m_tdFields(r).Required Then fDesc = "[Required] "
                    If Len(m_tdFields(r).DefaultValue) > 0 Then fDesc = fDesc & "Default: " & m_tdFields(r).DefaultValue
                End If
            Else
                isPk = False
                fName = ""
                fType = "(Click to add field)"
                fDesc = ""
            End If

            ' Selector glyph: PK badge
            If isPk Then
                pic.Line (2, y + 3)-(16, y + rowH - 4), &H00C0FF&, BF
                pic.Line (2, y + 3)-(16, y + rowH - 4), &H0080C0&, B
                pic.FontName = "Segoe UI"
                pic.FontSize = 6
                pic.FontBold = True
                pic.ForeColor = &H000000&
                pic.CurrentX = 4
                pic.CurrentY = y + 4
                pic.Print "PK"
            End If

            If isSelected Then
                pic.FontName = "Segoe UI Symbol"
                pic.FontSize = 8
                pic.FontBold = False
                pic.ForeColor = &H303030&
                pic.CurrentX = 18
                pic.CurrentY = y + 3
                pic.Print ChrW$(&H25BA)
            End If

            ' Field Name cell
            pic.Line (selPx, y)-(selPx + nameW - 1, y + rowH - 1), rowBg, BF
            pic.Line (selPx, y)-(selPx + nameW - 1, y + rowH - 1), &HD8D8D8&, B
            pic.FontName = "Segoe UI"
            pic.FontSize = 9
            pic.FontBold = isSelected
            pic.ForeColor = &H101010&
            pic.CurrentX = selPx + 6
            pic.CurrentY = y + 3
            pic.Print fName

            ' Data Type cell
            pic.Line (selPx + nameW, y)-(selPx + nameW + typeW - 1, y + rowH - 1), rowBg, BF
            pic.Line (selPx + nameW, y)-(selPx + nameW + typeW - 1, y + rowH - 1), &HD8D8D8&, B
            If r = m_tdFieldCount Then
                pic.ForeColor = &H888888&
                pic.FontBold = False
            Else
                pic.ForeColor = &H202020&
                pic.FontBold = False
            End If
            pic.CurrentX = selPx + nameW + 6
            pic.CurrentY = y + 3
            pic.Print fType
            pic.FontName = "Segoe UI Symbol"
            pic.FontSize = 7
            pic.ForeColor = &H606060&
            pic.CurrentX = selPx + nameW + typeW - 16
            pic.CurrentY = y + 4
            pic.Print "v"

            ' Description / Constraints cell
            pic.Line (selPx + nameW + typeW, y)-(selPx + nameW + typeW + descW - 1, y + rowH - 1), rowBg, BF
            pic.Line (selPx + nameW + typeW, y)-(selPx + nameW + typeW + descW - 1, y + rowH - 1), &HD8D8D8&, B
            pic.FontName = "Segoe UI"
            pic.FontSize = 8
            pic.FontBold = False
            pic.ForeColor = &H505050&
            pic.CurrentX = selPx + nameW + typeW + 6
            pic.CurrentY = y + 3
            pic.Print fDesc

            ' Action buttons cell
            pic.Line (selPx + nameW + typeW + descW, y)-(cw - 1, y + rowH - 1), rowBg, BF
            pic.Line (selPx + nameW + typeW + descW, y)-(cw - 1, y + rowH - 1), &HD8D8D8&, B

            If r < m_tdFieldCount Then
                ' [PK] Button
                Dim btnPkX As Long
                btnPkX = selPx + nameW + typeW + descW + 4
                If isPk Then
                    pic.Line (btnPkX, y + 2)-(btnPkX + 36, y + rowH - 3), &H00C0FF&, BF
                Else
                    pic.Line (btnPkX, y + 2)-(btnPkX + 36, y + rowH - 3), &HE0E0E0&, BF
                End If
                pic.Line (btnPkX, y + 2)-(btnPkX + 36, y + rowH - 3), &HA0A0A0&, B
                pic.FontName = "Segoe UI"
                pic.FontSize = 8
                pic.FontBold = True
                pic.ForeColor = &H202020&
                pic.CurrentX = btnPkX + 8
                pic.CurrentY = y + 3
                pic.Print "PK"

                ' [Del X] Button
                Dim btnDelX As Long
                btnDelX = btnPkX + 42
                pic.Line (btnDelX, y + 2)-(btnDelX + 40, y + rowH - 3), &HE8E8F8&, BF
                pic.Line (btnDelX, y + 2)-(btnDelX + 40, y + rowH - 3), &H8080C0&, B
                pic.FontName = "Segoe UI"
                pic.FontSize = 7
                pic.FontBold = True
                pic.ForeColor = &H202090&
                pic.CurrentX = btnDelX + 6
                pic.CurrentY = y + 4
                pic.Print "Del X"
            End If
        Next r

        pic.Line (0, ch - 1)-(cw - 1, ch - 1), &HD0D0D0&
        On Error GoTo 0
    End Sub

    Private Sub TableDesign_MouseDown(ByVal Button As Integer, ByVal Shift As Integer, ByVal X As Single, ByVal Y As Single)
        On Error Resume Next
        Dim hdrH As Long
        Dim rowH As Long
        Dim selPx As Long
        Dim nameW As Long
        Dim typeW As Long
        Dim descW As Long
        Dim actW As Long
        Dim clickedRow As Long
        Dim cellLeft As Long
        Dim cellTop As Long

        hdrH = 26
        rowH = 24
        selPx = 28
        nameW = 240
        typeW = 200
        descW = 360
        actW = 90
        If picDatasheet.ScaleWidth > 954 Then descW = CLng(picDatasheet.ScaleWidth) - selPx - nameW - typeW - 126

        If Y < hdrH Then Exit Sub

        clickedRow = m_tdTopRow + (CLng(Y) - hdrH) \ rowH
        If clickedRow < 0 Or clickedRow > m_tdFieldCount Then Exit Sub

        CommitTableDesignCellEdit

        EnsureTdFieldCapacity clickedRow
        m_tdSelectedRow = clickedRow
        PopulateTableFieldProperties clickedRow

        If Button = 2 Then
            If clickedRow < m_tdFieldCount Then
                DeleteTableDesignField clickedRow
            End If
            Exit Sub
        End If

        cellTop = picDatasheet.Top + hdrH + (clickedRow - m_tdTopRow) * rowH

        If X >= selPx And X < selPx + nameW Then
            cellLeft = picDatasheet.Left + selPx
            m_tdEditing = False
            fcCbo01.Visible = False
            fcTxt01.Left = cellLeft
            fcTxt01.Top = cellTop
            fcTxt01.Width = nameW
            fcTxt01.Height = rowH
            If clickedRow < m_tdFieldCount Then
                fcTxt01.Text = m_tdFields(clickedRow).FieldName
            Else
                fcTxt01.Text = ""
            End If
            fcTxt01.Visible = True
            fcTxt01.ZOrder 0
            fcTxt01.SetFocus
            If Len(fcTxt01.Text) > 0 Then
                fcTxt01.SelStart = 0
                fcTxt01.SelLength = Len(fcTxt01.Text)
            End If
            m_tdEditRow = clickedRow
            m_tdEditCol = 1
            m_tdEditing = True

        ElseIf X >= selPx + nameW And X < selPx + nameW + typeW Then
            cellLeft = picDatasheet.Left + selPx + nameW
            m_tdEditing = False
            fcTxt01.Visible = False

            fcCbo01.Clear
            fcCbo01.AddItem "AutoNumber"
            fcCbo01.AddItem "Short Text"
            fcCbo01.AddItem "Long Text (Memo)"
            fcCbo01.AddItem "Number (Long)"
            fcCbo01.AddItem "Number (Double)"
            fcCbo01.AddItem "Currency"
            fcCbo01.AddItem "Date/Time"
            fcCbo01.AddItem "Yes/No"
            fcCbo01.AddItem "Lookup Wizard..."

            fcCbo01.Left = cellLeft
            fcCbo01.Top = cellTop
            fcCbo01.Width = typeW
            fcCbo01.Height = rowH
            If clickedRow < m_tdFieldCount Then
                fcCbo01.Text = m_tdFields(clickedRow).DataTypeName
            Else
                fcCbo01.Text = "Short Text"
            End If
            fcCbo01.Visible = True
            fcCbo01.ZOrder 0
            fcCbo01.SetFocus
            m_tdEditRow = clickedRow
            m_tdEditCol = 2
            m_tdEditing = True

        ElseIf X >= selPx + nameW + typeW And X < selPx + nameW + typeW + descW Then
            cellLeft = picDatasheet.Left + selPx + nameW + typeW
            m_tdEditing = False
            fcCbo01.Visible = False
            fcTxt01.Left = cellLeft
            fcTxt01.Top = cellTop
            fcTxt01.Width = descW
            fcTxt01.Height = rowH
            If clickedRow < m_tdFieldCount Then
                fcTxt01.Text = m_tdFields(clickedRow).Description
            Else
                fcTxt01.Text = ""
            End If
            fcTxt01.Visible = True
            fcTxt01.ZOrder 0
            fcTxt01.SetFocus
            m_tdEditRow = clickedRow
            m_tdEditCol = 3
            m_tdEditing = True

        ElseIf X >= selPx + nameW + typeW + descW Then
            If clickedRow < m_tdFieldCount Then
                Dim relX As Long
                relX = X - (selPx + nameW + typeW + descW)
                If relX >= 4 And relX <= 40 Then
                    TogglePrimaryKey clickedRow
                ElseIf relX >= 44 And relX <= 88 Then
                    DeleteTableDesignField clickedRow
                End If
            End If
        End If

        PaintTableDesignGrid
    End Sub

    Private Sub SyncExistingTableDesignToDisk(ByVal tblName As String)
        On Error Resume Next
        If m_tdIsNewTable Or Len(Trim$(tblName)) = 0 Or StudioController.ActiveDatabase Is Nothing Then Exit Sub
        Dim td As Object
        Set td = StudioController.ActiveDatabase.TableDefs(tblName)
        If td Is Nothing Then Exit Sub

        Dim fIdx As Long
        Dim fName As String
        Dim ddlType As String
        Dim existingFld As Object
        Dim errStr As String
        For fIdx = 0 To m_tdFieldCount - 1
            fName = Trim$(m_tdFields(fIdx).FieldName)
            If Len(fName) > 0 Then
                ddlType = MapAccessNameToDdlType(m_tdFields(fIdx).DataTypeName, m_tdFields(fIdx).FieldSize)
                Set existingFld = Nothing
                Err.Clear
                Set existingFld = td.Fields(fName)
                If Err.Number <> 0 Or existingFld Is Nothing Then
                    Err.Clear
                    StudioController.AddTableColumnDdl tblName, fName, ddlType, errStr
                Else
                    Dim curTypeName As String
                    curTypeName = MapDaoTypeToAccessName(CInt(existingFld.Type), ((existingFld.Attributes And 16) <> 0))
                    If StrComp(curTypeName, m_tdFields(fIdx).DataTypeName, vbTextCompare) <> 0 And Not m_tdFields(fIdx).IsAutoNumber Then
                        StudioController.AlterTableColumnDdl tblName, fName, ddlType, errStr
                    End If
                End If
            End If
        Next fIdx
        On Error GoTo 0
    End Sub

    Private Sub CommitTableDesignCellEdit()
        On Error Resume Next
        If Not m_tdEditing And Not fcTxt01.Visible And Not fcCbo01.Visible Then Exit Sub
        m_tdEditing = False

        Dim rowIdx As Long
        Dim colIdx As Long
        Dim valText As String
        Dim addErr As String
        Dim alterErr As String
        Dim ddlType As String
        Dim launchLookupWiz As Boolean

        rowIdx = m_tdEditRow
        colIdx = m_tdEditCol
        launchLookupWiz = False

        EnsureTdFieldCapacity rowIdx

        If colIdx = 1 Then
            valText = Trim$(fcTxt01.Text)
            fcTxt01.Visible = False

            If rowIdx = m_tdFieldCount Then
                If Len(valText) > 0 Then
                    EnsureTdFieldCapacity rowIdx + 1
                    m_tdFields(rowIdx).FieldName = valText
                    If Len(m_tdFields(rowIdx).DataTypeName) = 0 Or m_tdFields(rowIdx).DataTypeName = "(Click to add field)" Then
                        m_tdFields(rowIdx).DataTypeName = "Short Text"
                        m_tdFields(rowIdx).FieldSize = "255"
                    End If
                    m_tdFields(rowIdx).IsPrimaryKey = False
                    m_tdFields(rowIdx).IsAutoNumber = False
                    m_tdFields(rowIdx).Required = False
                    m_tdFields(rowIdx).AllowZeroLength = True
                    m_tdFields(rowIdx).DefaultValue = ""
                    m_tdFields(rowIdx).ValidationRule = ""
                    m_tdFields(rowIdx).ValidationText = ""
                    m_tdFields(rowIdx).Description = ""

                    m_tdFieldCount = rowIdx + 1
                    m_tdFields(m_tdFieldCount).FieldName = ""
                    m_tdFields(m_tdFieldCount).DataTypeName = "(Click to add field)"

                    If Not m_tdIsNewTable Then
                        ddlType = MapAccessNameToDdlType(m_tdFields(rowIdx).DataTypeName, m_tdFields(rowIdx).FieldSize)
                        StudioController.AddTableColumnDdl m_tdTableName, valText, ddlType, addErr
                    End If
                    m_tdSelectedRow = rowIdx
                End If
            ElseIf rowIdx < m_tdFieldCount Then
                If Len(valText) > 0 And StrComp(m_tdFields(rowIdx).FieldName, valText, vbTextCompare) <> 0 Then
                    Dim oldFieldName As String
                    oldFieldName = m_tdFields(rowIdx).FieldName
                    m_tdFields(rowIdx).FieldName = valText
                    If Not m_tdIsNewTable Then
                        ddlType = MapAccessNameToDdlType(m_tdFields(rowIdx).DataTypeName, m_tdFields(rowIdx).FieldSize)
                        If Len(oldFieldName) > 0 Then
                            StudioController.DropTableColumnDdl m_tdTableName, oldFieldName, addErr
                        End If
                        StudioController.AddTableColumnDdl m_tdTableName, valText, ddlType, addErr
                    End If
                End If
            End If

        ElseIf colIdx = 2 Then
            valText = Trim$(fcCbo01.Text)
            fcCbo01.Visible = False

            If Len(valText) > 0 And valText <> "(Click to add field)" Then
                If rowIdx = m_tdFieldCount Then
                    EnsureTdFieldCapacity rowIdx + 1
                    If Len(Trim$(m_tdFields(rowIdx).FieldName)) = 0 Then
                        m_tdFields(rowIdx).FieldName = "Field" & CStr(rowIdx + 1)
                    End If
                    m_tdFields(rowIdx).DataTypeName = "Short Text"
                    m_tdFields(rowIdx).FieldSize = "255"
                    m_tdFieldCount = rowIdx + 1
                    m_tdFields(m_tdFieldCount).FieldName = ""
                    m_tdFields(m_tdFieldCount).DataTypeName = "(Click to add field)"
                    m_tdSelectedRow = rowIdx
                End If

                If rowIdx < m_tdFieldCount Then
                    If StrComp(valText, "Lookup Wizard...", vbTextCompare) = 0 Then
                        valText = "Number (Long)"
                        launchLookupWiz = True
                    End If

                    m_tdFields(rowIdx).DataTypeName = valText
                    If valText = "AutoNumber" Then
                        m_tdFields(rowIdx).IsAutoNumber = True
                        m_tdFields(rowIdx).IsPrimaryKey = True
                        m_tdFields(rowIdx).Required = True
                        m_tdFields(rowIdx).FieldSize = "4"
                    ElseIf InStr(1, valText, "Number", vbTextCompare) > 0 Or valText = "Currency" Or valText = "Date/Time" Then
                        m_tdFields(rowIdx).FieldSize = "4"
                    ElseIf valText = "Short Text" Then
                        m_tdFields(rowIdx).FieldSize = "255"
                    End If

                    If Not m_tdIsNewTable Then
                        SyncExistingTableDesignToDisk m_tdTableName
                    End If
                End If
            End If

        ElseIf colIdx = 3 Then
            valText = Trim$(fcTxt01.Text)
            fcTxt01.Visible = False
            If rowIdx < m_tdFieldCount Then
                m_tdFields(rowIdx).Description = valText
            End If
        End If

        PopulateTableFieldProperties m_tdSelectedRow
        PaintTableDesignGrid

        If launchLookupWiz And rowIdx < m_tdFieldCount Then
            If m_tdIsNewTable Then
                Dim autoSaveName As String
                Dim lkConflictMsg As String
                autoSaveName = m_tdTableName
                If Len(autoSaveName) = 0 Or Len(StudioController.CheckTableOrQueryNameConflict(autoSaveName, False)) > 0 Then
                    autoSaveName = GetNextAvailableTableName()
                End If
                Do
                    autoSaveName = InputBox("Save new table before running Lookup Wizard. Enter table name:", "Lookup Wizard - Save Table", autoSaveName)
                    autoSaveName = Trim$(Replace$(Replace$(autoSaveName, "[", ""), "]", ""))
                    If Len(autoSaveName) = 0 Then Exit Sub
                    lkConflictMsg = StudioController.CheckTableOrQueryNameConflict(autoSaveName, False)
                    If Len(lkConflictMsg) = 0 Then Exit Do
                    MsgBox lkConflictMsg, vbInformation, "Microsoft Access"
                Loop
                If Len(autoSaveName) > 0 Then
                    Dim cCols As String
                    Dim fI As Long
                    Dim cSpec As String
                    Dim cErr As String
                    cCols = ""
                    For fI = 0 To m_tdFieldCount - 1
                        If Len(Trim$(m_tdFields(fI).FieldName)) > 0 Then
                            cSpec = "[" & m_tdFields(fI).FieldName & "] " & MapAccessNameToDdlType(m_tdFields(fI).DataTypeName, m_tdFields(fI).FieldSize)
                            If m_tdFields(fI).IsPrimaryKey And InStr(1, UCase$(cSpec), "PRIMARY KEY") = 0 Then
                                cSpec = cSpec & " PRIMARY KEY"
                            End If
                            If Len(cCols) > 0 Then cCols = cCols & ", "
                            cCols = cCols & cSpec
                        End If
                    Next fI
                    If StudioController.CreateNewTableDdl(autoSaveName, cCols, cErr) Then
                        m_tdIsNewTable = False
                        m_tdTableName = autoSaveName
                        lstTables.AddItem autoSaveName
                        lblTableTitle.Caption = "Table: [" & autoSaveName & "] - Design View"
                    End If
                End If
            End If
            If Not m_tdIsNewTable Then
                PromptCreateRelationshipDialog m_tdTableName, m_tdFields(rowIdx).FieldName
                PopulateTableFieldProperties m_tdSelectedRow
                PaintTableDesignGrid
            End If
        End If
    End Sub

    Private Sub picDatasheet_Paint()
        On Error Resume Next
        If m_currentWorkspaceMode = 1 Then
            PaintTableDesignGrid
        ElseIf m_currentWorkspaceMode = 0 Or m_currentWorkspaceMode = 11 Then
            PaintQueryDatasheet
        End If
    End Sub

    ' -------------------------------------------------------------------------
    ' Phase 6: Form View (Single Record Card & Continuous Form)
    ' -------------------------------------------------------------------------
    Private Sub btnFormView_Click()
        Dim curTable As String
        Dim curForm As String

        If Not StudioController.IsDatabaseOpen() Then
            MsgBox "Please open a database first.", vbInformation, "OpenAccess Studio"
            Exit Sub
        End If

        curForm = vbNullString
        If StudioController.IsNativeFormActive() Then
            curForm = StudioController.GetActiveFormName()
        ElseIf Len(m_formName) > 0 Then
            curForm = m_formName
        End If

        If Len(curForm) > 0 And (m_currentWorkspaceMode = 3 Or m_currentWorkspaceMode = 4 Or m_currentWorkspaceMode = 6 Or m_currentWorkspaceMode = 7 Or m_currentWorkspaceMode = 9) Then
            StudioController.SetActiveFormName curForm
            UpdateRibbonToolbar "FORM"
            StudioController.SetViewMode 2
            FormRuntime.OpenForm curForm, Me, True
            DisplayFormView curForm
            Exit Sub
        End If

        curTable = StudioController.GetActiveTableName()
        If Len(curTable) = 0 Or curTable = "SQL Query Result" Then
            If Len(curForm) > 0 Then
                StudioController.SetViewMode 2
                btnFormView.Caption = "Datasheet View"
                DisplayFormView curForm
                Exit Sub
            End If
            MsgBox "Please open and select a table first.", vbInformation, "OpenAccess Studio"
            Exit Sub
        End If

        If StudioController.GetViewMode() = 2 Or m_currentWorkspaceMode = 10 Then
            If m_currentWorkspaceMode = 10 Then SwitchWorkspaceMode 0
            StudioController.SetViewMode 0
            btnFormView.Caption = "Form View [Card]"
            DisplayTableDatasheet curTable
        Else
            StudioController.SetViewMode 2
            btnFormView.Caption = "Datasheet View"
            DisplayFormView curTable
        End If
    End Sub

    ' Form View entry point (name and signature kept for callers and QA).
    ' Active form (native or _OpenAccess_Objects): renders that form's layout.
    ' Otherwise (table "Form View [Card]" toggle): AutoForm layout of the open table.
    ' Always delegates to RenderNativeForm; nothing is written to lstRecords.
    Private Sub DisplayFormView(ByVal tableName As String)
        Dim formName As String
        Dim objDef As String
        Dim srcName As String
        Dim errMsg As String

        If StudioController.IsNativeFormActive() Then
            formName = StudioController.GetActiveFormName()
            If Not (m_formLayoutValid And m_formLayoutKey = "FORM|" & UCase$(formName)) Then
                objDef = StudioController.GetCustomObjectDefinition("FORM", formName, srcName, errMsg)
                If Len(Trim$(srcName)) = 0 Then srcName = tableName
                LoadFormLayout formName, objDef, srcName
            End If
            RenderNativeForm formName
        Else
            ' Table card view: AutoForm over the already open table (sort/filter and position kept)
            StudioController.BuildAutoFormLayout tableName, tableName, StudioController.GetCurrentRecordset(), vbNullString, vbNullString, m_formLayout
            m_formLayoutKey = "TABLE|" & UCase$(tableName)
            m_formLayoutValid = True
            m_formNeedsOpen = False
            RenderNativeForm tableName
        End If
    End Sub

    ' Loads m_formLayout for a form opened from the Navigation Pane or the form wizard.
    '   Native Access form (objDef "NativeAccessForm|..."): GetNativeFormLayout (Blob /
    '   SaveAsText / cache / TypeInfo). When no layout can be read, an empty form surface
    '   bound to the form's RecordSource is used (no generic fields are invented).
    '   _OpenAccess_Objects form: AutoForm layout (label/textbox per RecordSource field
    '   plus the saved command button).
    ' Returns True when a real layout (native or AutoForm) was built.
    Private Function LoadFormLayout(ByVal formName As String, ByVal objDef As String, ByVal srcName As String) As Boolean
        Dim errMsg As String
        Dim isNative As Boolean
        Dim layoutOk As Boolean
        Dim btnCap As String

        m_formLayoutValid = False
        m_formLayoutKey = "FORM|" & UCase$(formName)
        isNative = (Left$(objDef, 17) = "NativeAccessForm|")
        layoutOk = False

        If isNative And StudioController.IsNativeFormActive() Then
            layoutOk = StudioController.GetNativeFormLayout(formName, m_formLayout, errMsg)
            If Not layoutOk Then
                StudioController.BuildAutoFormLayout formName, srcName, Nothing, vbNullString, vbNullString, m_formLayout
                m_formLayout.LayoutSource = "None"
            End If
        Else
            errMsg = vbNullString
            StudioController.OpenFormRecordset srcName, errMsg
            m_formNeedsOpen = False
            btnCap = GetAutoFormButtonCaption(objDef)
            layoutOk = StudioController.BuildAutoFormLayout(formName, srcName, StudioController.GetCurrentRecordset(), "Command1", btnCap, m_formLayout)
        End If

        m_formLayoutValid = True
        LoadFormLayout = layoutOk
    End Function

    ' Caption of the command button saved in an _OpenAccess_Objects form definition
    ' ("AutoFormLayout|<source>|Button=<caption>|OnClick=<vba>"); "" when none.
    Private Function GetAutoFormButtonCaption(ByVal objDef As String) As String
        Dim parts() As String
        Dim i As Long

        GetAutoFormButtonCaption = vbNullString
        If Len(objDef) = 0 Then Exit Function
        parts = Split(objDef, "|")
        For i = 0 To UBound(parts)
            If Left$(parts(i), 7) = "Button=" Then
                GetAutoFormButtonCaption = Trim$(Mid$(parts(i), 8))
                Exit Function
            End If
        Next i
    End Function

    ' Native Form View entry point (mode 10) for the layout held in m_formLayout.
    ' Opens the layout RecordSource through OpenFormRecordset when it is not already the
    ' active source (or a fresh open was requested), shows the RecordSource (or its SQL)
    ' in the SQL bar, and switches the workspace to the form canvas.
    ' PaintFormCanvas then paints the bands and labels and binds the pooled controls.
    Private Sub RenderNativeForm(ByVal formName As String)
        Dim errMsg As String
        Dim src As String
        Dim openOk As Boolean
        Dim needOpen As Boolean

        m_formName = formName
        src = Trim$(m_formLayout.RecordSource)

        openOk = True
        needOpen = m_formNeedsOpen
        If StudioController.GetCurrentRecordset() Is Nothing Then needOpen = True
        If StrComp(StudioController.GetActiveTableName(), src, vbTextCompare) <> 0 Then needOpen = True
        If needOpen Then
            openOk = StudioController.OpenFormRecordset(src, errMsg)
        End If
        m_formNeedsOpen = False
        ' (New) position = recordset at EOF/BOF (also an empty or missing recordset)
        m_formAtNew = (GetFormCurrentRow(StudioController.GetTotalRecords()) = StudioController.GetTotalRecords())
        If needOpen Or StrComp(m_formRenderedName, formName, vbTextCompare) <> 0 Then m_formTopRow = 0
        m_formRenderedName = formName
        m_lkCacheCount = 0
        ResetPoolComboLists

        ' Initialize FAYT defaults for form
        m_faytFilterType = 0
        m_faytSearchProducts = True
        m_faytSearchSupplier = False
        m_faytFilterText = vbNullString

        SwitchWorkspaceMode 10
        lblTableTitle.Caption = formName
        txtSql.Text = StudioController.FormatSqlForDisplay(StudioController.GetRecordSourceDisplaySql(src), True)

        If Len(formName) > 0 Then
            FormRuntime.OpenForm formName, Me, True
        End If

        PaintFormCanvas

        lblStatus.Caption = "Form View: " & formName & " | Record Source: " & src
        If Not openOk And Len(errMsg) > 0 Then
            lblStatus.Caption = lblStatus.Caption & " | " & errMsg
        End If
        If Len(m_formCanvasNote) > 0 Then
            lblStatus.Caption = lblStatus.Caption & " | " & m_formCanvasNote
        End If
    End Sub

    ' Re-binds the Native Form View (mode 10) to the current record of the active
    ' recordset: repaints bands/labels/read-only controls and refreshes pooled values.
    Private Sub RebindFormCanvas()
        If m_currentWorkspaceMode <> 10 Then Exit Sub
        If Not m_formLayoutValid Then Exit Sub
        PaintFormCanvas
    End Sub

    ' Twips -> canvas pixels (Screen.TwipsPerPixelX/Y; 15 when unavailable).
    ' Mirrored by twips_to_px in tools/studio_render_model.py.
    Private Function TwipsToPxX(ByVal tw As Long) As Long
        Dim tpp As Single
        On Error Resume Next
        tpp = Screen.TwipsPerPixelX
        On Error GoTo 0
        If tpp <= 0 Then tpp = 15
        TwipsToPxX = CLng(tw / tpp)
    End Function

    Private Function TwipsToPxY(ByVal tw As Long) As Long
        Dim tpp As Single
        On Error Resume Next
        tpp = Screen.TwipsPerPixelY
        On Error GoTo 0
        If tpp <= 0 Then tpp = 15
        TwipsToPxY = CLng(tw / tpp)
    End Function

    ' Visible-canvas clipping for windowed pool controls: a control is shown only when
    ' its top-left corner lies inside the canvas and it has a size; width/height are
    ' clamped to the canvas edge. Mirrored by clip_rect_to_canvas in studio_render_model.py.
    Private Function ClipFormRect(ByVal x As Long, ByVal y As Long, ByRef w As Long, ByRef h As Long, ByVal cw As Long, ByVal ch As Long) As Boolean
        ClipFormRect = False
        If w <= 0 Or h <= 0 Then Exit Function
        If x < 0 Or y < 0 Then Exit Function
        If x >= cw Or y >= ch Then Exit Function
        If x + w > cw Then w = cw - x
        If y + h > ch Then h = ch - y
        ClipFormRect = True
    End Function

    ' Access colors are BGR longs like OLE_COLOR; negative (system) or out-of-range
    ' values fall back to the given default.
    Private Function FormSafeColor(ByVal c As Long, ByVal defaultColor As Long) As Long
        If c < 0 Or c > &HFFFFFF& Then FormSafeColor = defaultColor Else FormSafeColor = c
    End Function

    ' Pool slot accessors (no control arrays exist). n is 1-based within the pool type.
    Private Function PoolTextBox(ByVal n As Long) As Object
        Select Case n
            Case 1: Set PoolTextBox = fcTxt01
            Case 2: Set PoolTextBox = fcTxt02
            Case 3: Set PoolTextBox = fcTxt03
            Case 4: Set PoolTextBox = fcTxt04
            Case 5: Set PoolTextBox = fcTxt05
            Case 6: Set PoolTextBox = fcTxt06
            Case 7: Set PoolTextBox = fcTxt07
            Case 8: Set PoolTextBox = fcTxt08
            Case 9: Set PoolTextBox = fcTxt09
            Case 10: Set PoolTextBox = fcTxt10
            Case 11: Set PoolTextBox = fcTxt11
            Case 12: Set PoolTextBox = fcTxt12
            Case 13: Set PoolTextBox = fcTxt13
            Case 14: Set PoolTextBox = fcTxt14
            Case 15: Set PoolTextBox = fcTxt15
            Case 16: Set PoolTextBox = fcTxt16
            Case 17: Set PoolTextBox = fcTxt17
            Case 18: Set PoolTextBox = fcTxt18
            Case 19: Set PoolTextBox = fcTxt19
            Case 20: Set PoolTextBox = fcTxt20
            Case 21: Set PoolTextBox = fcTxt21
            Case 22: Set PoolTextBox = fcTxt22
            Case 23: Set PoolTextBox = fcTxt23
            Case 24: Set PoolTextBox = fcTxt24
            Case Else: Set PoolTextBox = Nothing
        End Select
    End Function

    Private Function PoolComboBox(ByVal n As Long) As Object
        Select Case n
            Case 1: Set PoolComboBox = fcCbo01
            Case 2: Set PoolComboBox = fcCbo02
            Case 3: Set PoolComboBox = fcCbo03
            Case 4: Set PoolComboBox = fcCbo04
            Case 5: Set PoolComboBox = fcCbo05
            Case 6: Set PoolComboBox = fcCbo06
            Case 7: Set PoolComboBox = fcCbo07
            Case 8: Set PoolComboBox = fcCbo08
            Case Else: Set PoolComboBox = Nothing
        End Select
    End Function

    Private Function PoolButton(ByVal n As Long) As Object
        Select Case n
            Case 1: Set PoolButton = fcBtn01
            Case 2: Set PoolButton = fcBtn02
            Case 3: Set PoolButton = fcBtn03
            Case 4: Set PoolButton = fcBtn04
            Case 5: Set PoolButton = fcBtn05
            Case 6: Set PoolButton = fcBtn06
            Case 7: Set PoolButton = fcBtn07
            Case 8: Set PoolButton = fcBtn08
            Case Else: Set PoolButton = Nothing
        End Select
    End Function

    Private Function PoolCheckBox(ByVal n As Long) As Object
        Select Case n
            Case 1: Set PoolCheckBox = fcChk01
            Case 2: Set PoolCheckBox = fcChk02
            Case 3: Set PoolCheckBox = fcChk03
            Case 4: Set PoolCheckBox = fcChk04
            Case 5: Set PoolCheckBox = fcChk05
            Case 6: Set PoolCheckBox = fcChk06
            Case 7: Set PoolCheckBox = fcChk07
            Case 8: Set PoolCheckBox = fcChk08
            Case Else: Set PoolCheckBox = Nothing
        End Select
    End Function

    ' Control for a global pool slot (see m_poolCtlIndex).
    Private Function PoolListBox(ByVal n As Long) As ListBox
        Select Case n
            Case 1: Set PoolListBox = fcLst01
            Case 2: Set PoolListBox = fcLst02
            Case 3: Set PoolListBox = fcLst03
            Case 4: Set PoolListBox = fcLst04
            Case Else: Set PoolListBox = Nothing
        End Select
    End Function

    ' Control for a global pool slot (see m_poolCtlIndex).
    Private Function PoolControlBySlot(ByVal slot As Long) As Object
        If slot > FC_SLOT_CHK_BASE Then
            Set PoolControlBySlot = PoolCheckBox(slot - FC_SLOT_CHK_BASE)
        ElseIf slot > FC_SLOT_BTN_BASE Then
            Set PoolControlBySlot = PoolButton(slot - FC_SLOT_BTN_BASE)
        ElseIf slot > FC_SLOT_LST_BASE Then
            Set PoolControlBySlot = PoolListBox(slot - FC_SLOT_LST_BASE)
        ElseIf slot > FC_SLOT_CBO_BASE Then
            Set PoolControlBySlot = PoolComboBox(slot - FC_SLOT_CBO_BASE)
        Else
            Set PoolControlBySlot = PoolTextBox(slot - FC_SLOT_TXT_BASE)
        End If
    End Function

    ' Next free global slot for a windowed control type; 0 when the type has no pool
    ' or its pool is exhausted.
    Private Function NextFreePoolSlot(ByVal ctlType As String) As Long
        Dim poolBase As Long
        Dim poolSize As Long
        Dim n As Long

        NextFreePoolSlot = 0
        Select Case ctlType
            Case "TextBox"
                poolBase = FC_SLOT_TXT_BASE
                poolSize = FC_POOL_TXT
            Case "ComboBox"
                poolBase = FC_SLOT_CBO_BASE
                poolSize = FC_POOL_CBO
            Case "ListBox"
                poolBase = FC_SLOT_LST_BASE
                poolSize = FC_POOL_LST
            Case "CommandButton"
                poolBase = FC_SLOT_BTN_BASE
                poolSize = FC_POOL_BTN
            Case "CheckBox"
                poolBase = FC_SLOT_CHK_BASE
                poolSize = FC_POOL_CHK
            Case Else
                Exit Function
        End Select
        For n = 1 To poolSize
            If m_poolCtlIndex(poolBase + n) < 0 Then
                NextFreePoolSlot = poolBase + n
                Exit Function
            End If
        Next n
    End Function

    ' Display text of a bound control for the current record:
    '   "" for unbound controls and the (New) position; Null -> "";
    '   "=expr" through EvaluateAccessExpression; failure or missing field -> "#Name?".
    Private Function GetFormControlValueText(ByVal ctlIdx As Long) As String
        Dim rs As Object
        Dim cs As String
        Dim v As Variant
        Dim res As String
        Dim errMsg As String
        Dim atRecord As Boolean

        GetFormControlValueText = vbNullString
        cs = Trim$(m_formLayout.Ctls(ctlIdx).ControlSource)
        If Len(cs) = 0 Then Exit Function

        If Left$(cs, 1) = "=" Then
            res = vbNullString
            errMsg = vbNullString
            If StudioController.EvaluateAccessExpression(cs, res, errMsg) And Len(errMsg) = 0 Then
                If res = "<NULL>" Then res = vbNullString
                GetFormControlValueText = res
            Else
                GetFormControlValueText = "#Name?"
            End If
            Exit Function
        End If

        Set rs = StudioController.GetCurrentRecordset()
        If rs Is Nothing Then Exit Function

        atRecord = False
        On Error Resume Next
        atRecord = Not (rs.EOF Or rs.BOF)
        If Err.Number <> 0 Then atRecord = False
        Err.Clear
        On Error GoTo 0
        If Not atRecord Then Exit Function

        If Left$(cs, 1) = "[" And Right$(cs, 1) = "]" Then cs = Mid$(cs, 2, Len(cs) - 2)

        On Error Resume Next
        v = rs.Fields(cs).Value
        If Err.Number <> 0 Then
            Err.Clear
            On Error GoTo 0
            GetFormControlValueText = "#Name?"
            Exit Function
        End If
        On Error GoTo 0

        If IsNull(v) Or IsEmpty(v) Then
            GetFormControlValueText = vbNullString
        Else
            On Error Resume Next
            GetFormControlValueText = CStr(v)
            If Err.Number <> 0 Then GetFormControlValueText = "#Name?"
            Err.Clear
            On Error GoTo 0
        End If
    End Function

    ' Raw bound value of a control (Null when unbound, missing or at (New)); used by CheckBox.
    ' Plan 7 WS2: Resolves the value of a control on the currently open form.
    ' If the control is bound, returns the active record value; otherwise returns its text/value.
    Public Function GetOpenFormControlValue(ByVal formName As String, ByVal controlName As String, Optional ByVal subformName As String = "") As Variant
        Dim cIdx As Long
        Dim upperCtl As String
        Dim upperForm As String
        Dim rs As Object

        GetOpenFormControlValue = Empty
        upperForm = UCase$(Trim$(formName))
        upperCtl = UCase$(Trim$(controlName))

        ' Check if this form is currently open
        If UCase$(Trim$(StudioController.GetActiveFormName())) <> upperForm Then
            Exit Function
        End If

        ' Search in form layout controls
        If m_formLayoutValid Then
            For cIdx = 0 To m_formLayout.CtlCount - 1
                If UCase$(Trim$(m_formLayout.Ctls(cIdx).CtlName)) = upperCtl Then
                    GetOpenFormControlValue = GetFormControlValueText(cIdx)
                    Exit Function
                End If
            Next cIdx
        End If

        ' Search directly in underlying recordset fields
        Set rs = StudioController.GetCurrentRecordset()
        If Not rs Is Nothing Then
            On Error Resume Next
            If Not (rs.EOF Or rs.BOF) Then
                GetOpenFormControlValue = rs.Fields(controlName).Value
            End If
            Err.Clear
            On Error GoTo 0
        End If
    End Function

    Private Function GetFormControlRawValue(ByVal ctlIdx As Long) As Variant
        Dim rs As Object
        Dim cs As String

        GetFormControlRawValue = Null
        cs = Trim$(m_formLayout.Ctls(ctlIdx).ControlSource)
        If Len(cs) = 0 Or Left$(cs, 1) = "=" Then Exit Function
        If Left$(cs, 1) = "[" And Right$(cs, 1) = "]" Then cs = Mid$(cs, 2, Len(cs) - 2)
        Set rs = StudioController.GetCurrentRecordset()
        If rs Is Nothing Then Exit Function
        On Error Resume Next
        If rs.EOF Or rs.BOF Then Exit Function
        GetFormControlRawValue = rs.Fields(cs).Value
        If Err.Number <> 0 Then GetFormControlRawValue = Null
        Err.Clear
        On Error GoTo 0
    End Function

    ' Sets the canvas font from a layout control (Calibri 11 regular by default).
    Private Sub SetCanvasFontFromCtl(ByVal ctlIdx As Long)
        On Error Resume Next
        If Len(m_formLayout.Ctls(ctlIdx).FontName) > 0 Then
            m_fcPic.FontName = m_formLayout.Ctls(ctlIdx).FontName
        Else
            m_fcPic.FontName = "Calibri"
        End If
        If m_formLayout.Ctls(ctlIdx).FontSize > 0 Then
            m_fcPic.FontSize = m_formLayout.Ctls(ctlIdx).FontSize
        Else
            m_fcPic.FontSize = 11
        End If
        m_fcPic.FontBold = m_formLayout.Ctls(ctlIdx).FontBold
        On Error GoTo 0
    End Sub

    ' Paints a Label at (x, y) with its caption, font and fore color.
    Private Sub PaintFormLabel(ByVal ctlIdx As Long, ByVal x As Long, ByVal y As Long)
        Dim cap As String
        Dim w As Long
        On Error Resume Next
        SetCanvasFontFromCtl ctlIdx
        m_fcPic.ForeColor = FormSafeColor(m_formLayout.Ctls(ctlIdx).ForeColor, 0)
        cap = m_formLayout.Ctls(ctlIdx).Caption
        w = TwipsToPxX(m_formLayout.Ctls(ctlIdx).WidthTw)
        If (m_formLayout.RightToLeft Or ArabicCollationHelper.HasArabicUnicode(cap)) And w > 0 Then
            m_fcPic.CurrentX = x + w - m_fcPic.TextWidth(cap) - 2
            If m_fcPic.CurrentX < x Then m_fcPic.CurrentX = x
        Else
            m_fcPic.CurrentX = x + 1
        End If
        m_fcPic.CurrentY = y + 1
        m_fcPic.Print cap
        On Error GoTo 0
    End Sub

    ' Paints a control read-only (pool overflow and control types without a pool):
    ' bordered box, back color and the bound value or caption inside.
    Private Sub PaintReadOnlyControl(ByVal ctlIdx As Long, ByVal x As Long, ByVal y As Long, ByVal w As Long, ByVal h As Long, ByVal textVal As String)
        Dim backC As Long

        If w <= 0 Or h <= 0 Then Exit Sub
        On Error Resume Next
        backC = FormSafeColor(m_formLayout.Ctls(ctlIdx).BackColor, &HFFFFFF&)
        m_fcPic.Line (x, y)-(x + w - 1, y + h - 1), backC, BF
        m_fcPic.Line (x, y)-(x + w - 1, y + h - 1), &HA0A0A0&, B
        SetCanvasFontFromCtl ctlIdx
        m_fcPic.ForeColor = FormSafeColor(m_formLayout.Ctls(ctlIdx).ForeColor, 0)
        If (m_formLayout.RightToLeft Or ArabicCollationHelper.HasArabicUnicode(textVal)) And w > 0 Then
            m_fcPic.CurrentX = x + w - m_fcPic.TextWidth(FitCanvasText(textVal, w - 6)) - 4
            If m_fcPic.CurrentX < x + 3 Then m_fcPic.CurrentX = x + 3
        Else
            m_fcPic.CurrentX = x + 3
        End If
        m_fcPic.CurrentY = y + 2
        m_fcPic.Print textVal
        On Error GoTo 0
    End Sub

    ' Places a pooled windowed control on MainForm over the canvas (canvas origin at
    ' picFormCanvas.Left/Top plus its border) and brings it in front of the canvas.
    ' Hidden when its rectangle is outside the visible canvas.
    Private Sub PlacePoolControl(ByVal ctlObj As Object, ByVal isCombo As Boolean, ByVal x As Long, ByVal y As Long, ByVal w As Long, ByVal h As Long, ByVal cw As Long, ByVal ch As Long, ByVal originX As Long, ByVal originY As Long)
        Dim cwClip As Long
        Dim chClip As Long

        If ctlObj Is Nothing Then Exit Sub
        cwClip = w
        chClip = h
        On Error Resume Next
        If Not ClipFormRect(x, y, cwClip, chClip, cw, ch) Then
            ctlObj.Visible = False
            Exit Sub
        End If
        ctlObj.Left = originX + x
        ctlObj.Top = originY + y
        ctlObj.Width = cwClip
        If Not isCombo Then ctlObj.Height = chClip
        ctlObj.Visible = True
        ctlObj.ZOrder 0
        On Error GoTo 0
    End Sub

    ' Applies font, colors and the current record value to a pooled control.
    Private Sub BindPoolControl(ByVal slot As Long)
        Dim ctlObj As Object
        Dim idx As Long
        Dim v As Variant
        Dim cap As String
        Dim n As Long

        idx = m_poolCtlIndex(slot)
        If idx < 0 Then Exit Sub
        Set ctlObj = PoolControlBySlot(slot)
        If ctlObj Is Nothing Then Exit Sub

        m_poolBinding = True
        m_poolDirty(slot) = False
        On Error Resume Next
        If Len(m_formLayout.Ctls(idx).FontName) > 0 Then ctlObj.FontName = m_formLayout.Ctls(idx).FontName
        If m_formLayout.Ctls(idx).FontSize > 0 Then ctlObj.FontSize = m_formLayout.Ctls(idx).FontSize
        ctlObj.FontBold = m_formLayout.Ctls(idx).FontBold
        ctlObj.ForeColor = FormSafeColor(m_formLayout.Ctls(idx).ForeColor, 0)

        If slot > FC_SLOT_CHK_BASE Then
            ' CheckBox: checked state from the bound value (Null -> unchecked)
            ctlObj.Caption = m_formLayout.Ctls(idx).Caption
            ctlObj.BackColor = FormSafeColor(m_formLayout.Ctls(idx).BackColor, &HFFFFFF&)
            v = GetFormControlRawValue(idx)
            If IsNull(v) Then
                ctlObj.Value = 0
            Else
                ctlObj.Value = IIf(CBool(v), 1, 0)
            End If
        ElseIf slot > FC_SLOT_BTN_BASE Then
            ' CommandButton: caption only (Click -> OnPoolButtonClick)
            cap = m_formLayout.Ctls(idx).Caption
            If Len(cap) = 0 Then cap = m_formLayout.Ctls(idx).CtlName
            ctlObj.Caption = cap
        ElseIf slot > FC_SLOT_LST_BASE Then
            ' ListBox: windowed list control (WS4)
            ctlObj.BackColor = FormSafeColor(m_formLayout.Ctls(idx).BackColor, &HFFFFFF&)
            On Error Resume Next
            ctlObj.RightToLeft = m_formLayout.RightToLeft
            On Error GoTo 0
        ElseIf slot > FC_SLOT_CBO_BASE Then
            ' ComboBox: list from the RowSource (filled once per render), the item whose bound
            ' value equals the field value selected, text = lookup-resolved value (same text
            ' as the painted rows and the table datasheet).
            ctlObj.BackColor = FormSafeColor(m_formLayout.Ctls(idx).BackColor, &HFFFFFF&)
            n = slot - FC_SLOT_CBO_BASE
            If Not m_cboFilled(n) Or m_cboListCtl(n) <> idx Then FillPoolComboList n, idx, ctlObj
            v = GetFormControlRawValue(idx)
            If IsNull(v) Or IsEmpty(v) Then
                SelectPoolComboItem n, ctlObj, v, GetFormControlValueText(idx)
            Else
                SelectPoolComboItem n, ctlObj, v, ResolveFormLookupText(idx, v)
            End If
        Else
            ' TextBox
            ctlObj.BackColor = FormSafeColor(m_formLayout.Ctls(idx).BackColor, &HFFFFFF&)
            If Len(Trim$(m_formLayout.Ctls(idx).ControlSource)) = 0 And (InStr(1, m_formLayout.Ctls(idx).CtlName, "Filter", vbTextCompare) > 0 Or InStr(1, m_formLayout.Ctls(idx).CtlName, "Search", vbTextCompare) > 0) Then
                ' Unbound filter textbox: preserve typed search query and position cursor
                ctlObj.Text = m_faytFilterText
                ctlObj.SelStart = Len(m_faytFilterText)
            Else
                ctlObj.Text = GetFormControlValueText(idx)
            End If
        End If
        On Error GoTo 0
        m_poolBinding = False
    End Sub

    ' Marks every pooled combo list as not filled (RenderNativeForm): the next BindPoolControl
    ' refills it from the RowSource of the control that owns the slot.
    Private Sub ResetPoolComboLists()
        Dim n As Long
        For n = 1 To FC_POOL_CBO
            m_cboFilled(n) = False
            m_cboListCtl(n) = -1
            m_cboCount(n) = 0
            m_cboBound(n) = Empty
        Next n
    End Sub

    ' 0-based display column of a combo: the first of the first colCount columns whose
    ' ColumnWidths entry is not zero (a missing or empty entry is the default width, so it
    ' counts as visible). Empty ColumnWidths or all-zero widths -> column 0.
    '   "0;1440" -> 1, "" -> 0, "0" with 2 columns -> 1, "0;0" -> 0.
    Private Function ComboDisplayColumn(ByVal columnWidths As String, ByVal colCount As Long) As Long
        Dim parts() As String
        Dim k As Long
        Dim w As String

        ComboDisplayColumn = 0
        If Len(Trim$(columnWidths)) = 0 Then Exit Function
        parts = Split(columnWidths, ";")
        For k = 0 To colCount - 1
            If k > UBound(parts) Then
                ComboDisplayColumn = k
                Exit Function
            End If
            w = Trim$(parts(k))
            If Len(w) = 0 Then
                ComboDisplayColumn = k
                Exit Function
            End If
            If Val(Replace$(w, ",", ".")) <> 0 Then
                ComboDisplayColumn = k
                Exit Function
            End If
        Next k
        ComboDisplayColumn = 0
    End Function

    ' Fills pooled combo slot n with the rows of layout control ctlIdx's RowSource (table,
    ' saved query, "~sq_..." lookup query or SQL) through StudioController.OpenLookupRowSource
    ' (a caller-owned recordset; the form's active recordset is not touched).
    '   Item text = display column (ComboDisplayColumn over ColumnWidths/ColumnCount).
    '   m_cboBound(n) = bound column values (BoundColumn, 1-based; 0 = the row index, as Access).
    ' An empty or unopenable RowSource leaves the list empty.
    Private Sub FillPoolComboList(ByVal n As Long, ByVal ctlIdx As Long, ByVal ctlObj As Object)
        Dim rs As Object
        Dim fldCount As Long
        Dim colCount As Long
        Dim dispCol As Long
        Dim boundCol As Long
        Dim cnt As Long
        Dim bound() As String
        Dim dispText As String
        Dim v As Variant

        m_cboFilled(n) = True
        m_cboListCtl(n) = ctlIdx
        m_cboCount(n) = 0
        m_cboBound(n) = Empty
        m_cboBinding = True
        On Error Resume Next
        ctlObj.Clear
        On Error GoTo 0
        m_cboBinding = False

        Set rs = StudioController.OpenLookupRowSource(m_formLayout.Ctls(ctlIdx).RowSource)
        If rs Is Nothing Then Exit Sub

        On Error Resume Next
        fldCount = rs.Fields.Count
        If fldCount > 0 Then
            colCount = m_formLayout.Ctls(ctlIdx).ColumnCount
            If colCount <= 0 Or colCount > fldCount Then colCount = fldCount
            dispCol = ComboDisplayColumn(m_formLayout.Ctls(ctlIdx).ColumnWidths, colCount)
            boundCol = m_formLayout.Ctls(ctlIdx).BoundColumn - 1
            If boundCol >= fldCount Then boundCol = fldCount - 1

            ReDim bound(0 To 31)
            cnt = 0
            m_cboBinding = True
            Do While Not rs.EOF
                If Err.Number <> 0 Or cnt >= FC_CBO_MAX_ITEMS Then Exit Do
                v = rs.Fields(dispCol).Value
                If IsNull(v) Then dispText = vbNullString Else dispText = CStr(v)
                If cnt > UBound(bound) Then ReDim Preserve bound(0 To UBound(bound) * 2 + 1)
                If boundCol < 0 Then
                    bound(cnt) = CStr(cnt)
                Else
                    v = rs.Fields(boundCol).Value
                    If IsNull(v) Then bound(cnt) = vbNullString Else bound(cnt) = CStr(v)
                End If
                ctlObj.AddItem dispText
                cnt = cnt + 1
                rs.MoveNext
            Loop
            m_cboBinding = False
            If cnt > 0 Then
                ReDim Preserve bound(0 To cnt - 1)
                m_cboBound(n) = bound
            End If
            m_cboCount(n) = cnt
        End If
        rs.Close
        Err.Clear
        On Error GoTo 0
    End Sub

    ' Selects the item of pooled combo slot n whose bound value equals rawVal (trimmed,
    ' case-insensitive; Null/Empty or no match -> ListIndex -1) and shows dispText.
    Private Sub SelectPoolComboItem(ByVal n As Long, ByVal ctlObj As Object, ByVal rawVal As Variant, ByVal dispText As String)
        Dim bound() As String
        Dim target As String
        Dim k As Long
        Dim found As Long

        found = -1
        If m_cboCount(n) > 0 And Not (IsNull(rawVal) Or IsEmpty(rawVal)) Then
            bound = m_cboBound(n)
            target = Trim$(CStr(rawVal))
            For k = 0 To m_cboCount(n) - 1
                If StrComp(Trim$(bound(k)), target, vbTextCompare) = 0 Then
                    found = k
                    Exit For
                End If
            Next k
        End If

        m_cboBinding = True
        On Error Resume Next
        ctlObj.ListIndex = found
        If found < 0 Or ctlObj.Text <> dispText Then ctlObj.Text = dispText
        On Error GoTo 0
        m_cboBinding = False
    End Sub

    ' -------------------------------------------------------------------------
    ' Native Form View pooled control events and Save Form Record (task 8.2)
    ' -------------------------------------------------------------------------
    ' One-line handlers per pooled control delegate to the shared procedures below.
    ' Each handler passes its 1-based index within its pool type (fcBtn03 -> 3).

    ' CommandButton click: runs <ControlName>_Click from the form's VBA module through
    ' StudioController.ExecuteFormButtonClick (Form1 Command2 -> Command2_Click -> Call ayman
    ' -> MsgBox "hi"). Forms without a native VBA module (_OpenAccess_Objects forms and the
    ' table AutoForm card) use the existing btnFormCmd_Click path.
    Private Sub OnPoolButtonClick(ByVal n As Long)
        Dim idx As Long
        Dim formName As String
        Dim btnName As String
        Dim execMsg As String
        Dim errMsg As String
        Dim ok As Boolean

        If m_poolBinding Or m_cboBinding Then Exit Sub
        If n < 1 Or n > FC_POOL_BTN Then Exit Sub
        idx = m_poolCtlIndex(FC_SLOT_BTN_BASE + n)
        If idx < 0 Or Not m_formLayoutValid Then Exit Sub
        If Not StudioController.IsDatabaseOpen() Then Exit Sub

        formName = StudioController.GetActiveFormName()
        If Len(formName) = 0 Then formName = m_formName

        If Len(formName) = 0 Then
            btnFormCmd_Click
            Exit Sub
        End If
        btnName = m_formLayout.Ctls(idx).CtlName
        If FormRuntime.RaiseControlEvent(formName, btnName, "Click") Then
            ProcessPendingVbaUiActions
            lblStatus.Caption = "Executed Form [" & formName & "] Button [" & btnName & "] event."
            Exit Sub
        End If
        ok = StudioController.ExecuteFormButtonClick(formName, btnName, True, execMsg, errMsg)
        If ok Then
            ProcessPendingVbaUiActions
            lblStatus.Caption = "Executed Form [" & formName & "] Button [" & btnName & "] ==> " & execMsg
        Else
            MsgBox "Form event error: " & errMsg, vbExclamation, "Form Event"
        End If
    End Sub

    Public Sub OpenFormByName(ByVal targetFormName As String, Optional ByVal whereCond As String = "")
        Dim cleanFrm As String
        Dim objDef As String
        Dim srcName As String
        Dim errMsg As String
        Dim i As Long

        cleanFrm = Trim$(Replace$(Replace$(targetFormName, "[", ""), "]", ""))
        If Len(cleanFrm) = 0 Then Exit Sub

        For i = 0 To lstTables.ListCount - 1
            If StrComp(lstTables.List(i), "[Form] " & cleanFrm, vbTextCompare) = 0 Then
                lstTables.ListIndex = i
                Exit For
            End If
        Next i

        StudioController.SetActiveFormName cleanFrm
        m_formName = cleanFrm
        objDef = StudioController.GetCustomObjectDefinition("FORM", cleanFrm, srcName, errMsg)
        UpdateRibbonToolbar "FORM"
        m_formNeedsOpen = True
        LoadFormLayout cleanFrm, objDef, srcName
        If Len(Trim$(whereCond)) > 0 And Len(Trim$(m_formLayout.RecordSource)) > 0 Then
            Dim baseSrc As String
            baseSrc = Trim$(m_formLayout.RecordSource)
            If Right$(baseSrc, 1) = ";" Then baseSrc = Trim$(Left$(baseSrc, Len(baseSrc) - 1))
            If UCase$(Left$(baseSrc, 7)) = "SELECT " Then
                If InStr(1, baseSrc, " WHERE ", vbTextCompare) > 0 Then
                    StudioController.OpenFormRecordset baseSrc & " AND (" & whereCond & ");", errMsg
                Else
                    StudioController.OpenFormRecordset baseSrc & " WHERE " & whereCond & ";", errMsg
                End If
            Else
                StudioController.OpenFormRecordset "SELECT * FROM [" & Replace$(Replace$(baseSrc, "[", ""), "]", "") & "] WHERE " & whereCond & ";", errMsg
            End If
            m_formNeedsOpen = False
        End If
        RenderNativeForm cleanFrm
        m_navSkipFormRebind = True
        UpdateNavigationControls
        m_navSkipFormRebind = False
        SyncVisualFormControlsAndVbe
        lblStatus.Caption = "Form View: [" & cleanFrm & "] opened via DoCmd.OpenForm."
    End Sub

    Private Sub ProcessPendingVbaUiActions()
        Dim targetFrm As String
        Dim targetWhere As String
        Dim targetQry As String

        If StudioController.ConsumePendingOpenForm(targetFrm, targetWhere) Then
            OpenFormByName targetFrm, targetWhere
            Exit Sub
        End If
        If StudioController.ConsumePendingOpenQuery(targetQry) Then
            DisplayQueryDatasheet targetQry
            Exit Sub
        End If
        If StudioController.ConsumePendingCloseForm() Then
            StudioController.SetActiveFormName vbNullString
            m_formName = vbNullString
            SwitchWorkspaceMode 0
            lblStatus.Caption = "Closed active form via DoCmd.Close."
        End If
    End Sub

    ' Bound key of pooled combo slot n (1..FC_POOL_CBO) for layout control ctlIdx: the bound
    ' column value of the selected list item, else the typed text converted through
    ' StudioController.ConvertLookupDisplayToKey ("" stays "").
    Private Function PoolComboKey(ByVal n As Long, ByVal ctlIdx As Long, ByVal ctlObj As Object) As String
        Dim bound() As String
        Dim li As Long
        Dim txt As String

        li = -1
        On Error Resume Next
        li = ctlObj.ListIndex
        txt = Trim$(ctlObj.Text)
        On Error GoTo 0
        If li >= 0 And li < m_cboCount(n) Then
            bound = m_cboBound(n)
            PoolComboKey = bound(li)
        ElseIf Len(txt) = 0 Then
            PoolComboKey = vbNullString
        Else
            PoolComboKey = StudioController.ConvertLookupDisplayToKey(m_formLayout.RecordSource, FormControlFieldName(ctlIdx), txt)
        End If
    End Function

    ' Marks pooled control `slot` as edited by the user and reports it in the status bar.
    Private Sub MarkPoolControlDirty(ByVal slot As Long, ByVal detail As String)
        Dim idx As Long

        If m_currentWorkspaceMode <> 10 Or Not m_formLayoutValid Then Exit Sub
        idx = m_poolCtlIndex(slot)
        If idx < 0 Then Exit Sub
        If Len(FormControlFieldName(idx)) = 0 Then Exit Sub
        m_poolDirty(slot) = True
        lblStatus.Caption = "Form View: " & m_formName & " | [" & FormControlFieldName(idx) & "] edited" & detail & " (Save Form Record to write it)"
    End Sub

    ' ComboBox list selection: converts the chosen display value to its bound key and marks
    ' the record dirty.
    Private Sub OnPoolComboClick(ByVal n As Long)
        Dim slot As Long
        Dim idx As Long
        Dim ctlObj As Object
        Dim keyVal As String

        If m_poolBinding Or m_cboBinding Then Exit Sub
        If n < 1 Or n > FC_POOL_CBO Then Exit Sub
        slot = FC_SLOT_CBO_BASE + n
        idx = m_poolCtlIndex(slot)
        If idx < 0 Then Exit Sub
        Set ctlObj = PoolComboBox(n)
        If ctlObj Is Nothing Then Exit Sub
        keyVal = PoolComboKey(n, idx, ctlObj)
        MarkPoolControlDirty slot, " to '" & ctlObj.Text & "' (Key=" & keyVal & ")"
    End Sub

    ' ComboBox typed text: marks the record dirty (the key is resolved when saving).
    Private Sub OnPoolComboChange(ByVal n As Long)
        If m_poolBinding Or m_cboBinding Then Exit Sub
        If n < 1 Or n > FC_POOL_CBO Then Exit Sub
        MarkPoolControlDirty FC_SLOT_CBO_BASE + n, vbNullString
    End Sub

    ' TextBox edit: marks the record dirty (changes made by BindPoolControl are ignored).
    Private Sub OnPoolTextChange(ByVal n As Long)
        Dim slot As Long
        Dim idx As Long
        Dim ctlName As String

        If m_currentWorkspaceMode <> 10 Or Not m_formLayoutValid Then Exit Sub
        If m_poolBinding Or m_cboBinding Then Exit Sub
        If n < 1 Or n > FC_POOL_TXT Then Exit Sub
        slot = FC_SLOT_TXT_BASE + n
        MarkPoolControlDirty slot, vbNullString

        idx = m_poolCtlIndex(slot)
        If idx >= 0 And m_formLayoutValid Then
            ctlName = m_formLayout.Ctls(idx).CtlName
            FormRuntime.RaiseControlEvent m_formName, ctlName, "Change"

            ' Live FAYT filter triggering on search / filter text boxes
            If InStr(1, ctlName, "Filter", vbTextCompare) > 0 Or InStr(1, ctlName, "Search", vbTextCompare) > 0 Then
                Dim txtObj As Object
                Set txtObj = PoolTextBox(n)
                If Not txtObj Is Nothing Then
                    m_faytFilterText = txtObj.Text
                    ApplyFaytFilter
                End If
            End If
        End If
    End Sub

    ' CheckBox click: marks the record dirty (changes made by BindPoolControl are ignored).
    Private Sub OnPoolCheckClick(ByVal n As Long)
        If m_poolBinding Or m_cboBinding Then Exit Sub
        If n < 1 Or n > FC_POOL_CHK Then Exit Sub
        MarkPoolControlDirty FC_SLOT_CHK_BASE + n, vbNullString
    End Sub

    ' "Save Form Record" in the Native Form View (mode 10): writes every dirty pooled control
    ' bound to a field of the current record through StudioController.UpdateActiveRecordField.
    '   TextBox -> its text; ComboBox -> PoolComboKey (bound key, ConvertLookupDisplayToKey for
    '   typed text); CheckBox -> "-1" / "0". Numeric and date fields are validated first (as
    '   the mode 0 editor does); nothing is written when a value is invalid.
    ' The form is repainted from the record afterwards (clears the dirty flags).
    Private Sub SaveNativeFormRecord()
        Dim rs As Object
        Dim slot As Long
        Dim idx As Long
        Dim ctlObj As Object
        Dim fName As String
        Dim fType As Long
        Dim cnt As Long
        Dim k As Long
        Dim slots() As Long
        Dim vals() As String
        Dim uiVal As String
        Dim errMsg As String
        Dim lastErr As String
        Dim savedCnt As Long
        Dim failCnt As Long

        If Not StudioController.IsDatabaseOpen() Then
            MsgBox "Please open a database first.", vbInformation, "Save Record"
            Exit Sub
        End If
        If Not m_formLayoutValid Then Exit Sub
        Set rs = StudioController.GetCurrentRecordset()
        If rs Is Nothing Then Exit Sub
        If m_formAtNew Then
            lblStatus.Caption = "Form View: " & m_formName & " | The (New) record has no saved values to update (use + New Record)."
            Exit Sub
        End If

        ' 1. Collect and validate the dirty values
        ReDim slots(1 To FC_SLOT_TOTAL)
        ReDim vals(1 To FC_SLOT_TOTAL)
        cnt = 0
        For slot = 1 To FC_SLOT_TOTAL
            idx = m_poolCtlIndex(slot)
            If m_poolDirty(slot) And idx >= 0 And (slot <= FC_SLOT_BTN_BASE Or slot > FC_SLOT_CHK_BASE) Then
                fName = FormControlFieldName(idx)
                Set ctlObj = PoolControlBySlot(slot)
                If Len(fName) > 0 And Not ctlObj Is Nothing Then
                    If slot > FC_SLOT_CHK_BASE Then
                        If ctlObj.Value = 1 Then uiVal = "-1" Else uiVal = "0"
                    ElseIf slot > FC_SLOT_CBO_BASE Then
                        uiVal = PoolComboKey(slot - FC_SLOT_CBO_BASE, idx, ctlObj)
                    Else
                        uiVal = Trim$(ctlObj.Text)
                    End If

                    fType = 10
                    On Error Resume Next
                    fType = rs.Fields(fName).Type
                    Err.Clear
                    On Error GoTo 0
                    ' Numeric types: dbByte=2, dbInteger=3, dbLong=4, dbCurrency=5, dbSingle=6, dbDouble=7, dbDecimal=20
                    If fType = 2 Or fType = 3 Or fType = 4 Or fType = 5 Or fType = 6 Or fType = 7 Or fType = 20 Then
                        If Not IsNumeric(uiVal) Then
                            MsgBox "Validation Error: Field [" & fName & "] must be a valid numeric value.", vbExclamation, "Validation Error"
                            Exit Sub
                        End If
                    ElseIf fType = 8 Then
                        If Not IsDate(uiVal) Then
                            MsgBox "Validation Error: Field [" & fName & "] must be a valid date/time format.", vbExclamation, "Validation Error"
                            Exit Sub
                        End If
                    End If

                    cnt = cnt + 1
                    slots(cnt) = slot
                    vals(cnt) = uiVal
                End If
            End If
        Next slot

        If cnt = 0 Then
            lblStatus.Caption = "Form View: " & m_formName & " | No changes to save."
            Exit Sub
        End If

        ' 2. Commit the values to the current record
        savedCnt = 0
        failCnt = 0
        lastErr = vbNullString
        For k = 1 To cnt
            fName = FormControlFieldName(m_poolCtlIndex(slots(k)))
            errMsg = vbNullString
            If StudioController.UpdateActiveRecordField(fName, vals(k), errMsg) Then
                savedCnt = savedCnt + 1
            Else
                failCnt = failCnt + 1
                lastErr = "[" & fName & "] " & errMsg
                ' Leave no pending edit behind a failed Update
                On Error Resume Next
                rs.CancelUpdate
                Err.Clear
                On Error GoTo 0
            End If
        Next k

        m_lkCacheCount = 0
        RebindFormCanvas
        If failCnt = 0 Then
            lblStatus.Caption = "Form View: " & m_formName & " | Saved " & CStr(savedCnt) & " field(s) of record #" & CStr(StudioController.GetCurrentRecordIndex()) & "."
        Else
            lblStatus.Caption = "Form View: " & m_formName & " | Saved " & CStr(savedCnt) & " field(s), " & CStr(failCnt) & " failed."
            MsgBox "Could not update record: " & lastErr, vbExclamation, "Save Record"
        End If
    End Sub

