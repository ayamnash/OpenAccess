        fcBtn01.Left = dlgX + 410
        fcBtn01.Top = dlgY + 40
        fcBtn01.Width = 112
        fcBtn01.Height = 32
        fcBtn01.Visible = True
        fcBtn01.ZOrder 0

        fcBtn02.Left = dlgX + 410
        fcBtn02.Top = dlgY + 80
        fcBtn02.Width = 112
        fcBtn02.Height = 32
        fcBtn02.Visible = True
        fcBtn02.ZOrder 0

        fcBtn03.Left = dlgX + 410
        fcBtn03.Top = dlgY + 128
        fcBtn03.Width = 112
        fcBtn03.Height = 32
        fcBtn03.Visible = (m_relDialogIsQbeJoin Or Len(m_relDialogExistingName) > 0 Or m_currentWorkspaceMode = 8)
        If fcBtn03.Visible Then fcBtn03.ZOrder 0
        On Error GoTo 0
    End Sub

    Private Sub CommitVisualRelationshipDialog()
        On Error Resume Next
        If Not m_relDialogActive Then Exit Sub

        Dim pkTbl As String
        Dim pkFld As String
        Dim fkTbl As String
        Dim fkFld As String
        Dim enf As Boolean
        Dim cascU As Boolean
        Dim cascD As Boolean
        Dim relName As String
        Dim errMsg As String

        pkTbl = Trim$(fcCbo02.Text)
        If Len(pkTbl) = 0 And fcCbo02.ListIndex >= 0 Then pkTbl = Trim$(fcCbo02.List(fcCbo02.ListIndex))
        pkFld = Trim$(fcCbo03.Text)
        If Len(pkFld) = 0 And fcCbo03.ListIndex >= 0 Then pkFld = Trim$(fcCbo03.List(fcCbo03.ListIndex))
        fkTbl = Trim$(fcCbo04.Text)
        If Len(fkTbl) = 0 And fcCbo04.ListIndex >= 0 Then fkTbl = Trim$(fcCbo04.List(fcCbo04.ListIndex))
        fkFld = Trim$(fcCbo05.Text)
        If Len(fkFld) = 0 And fcCbo05.ListIndex >= 0 Then fkFld = Trim$(fcCbo05.List(fcCbo05.ListIndex))

        If Len(pkTbl) = 0 Or Len(pkFld) = 0 Or Len(fkTbl) = 0 Or Len(fkFld) = 0 Then
            MsgBox "Please select both tables and fields from the dropdown lists.", vbExclamation, "Join Properties"
            Exit Sub
        End If
        If StrComp(pkTbl, fkTbl, vbTextCompare) = 0 Then
            MsgBox "Left Table and Right Table must be two different tables.", vbExclamation, "Join Properties"
            Exit Sub
        End If

        If m_relDialogIsQbeJoin Then
            Dim jTypeStr As String
            If fcChk02.Value = 1 Then
                jTypeStr = "LEFT"
            ElseIf fcChk03.Value = 1 Then
                jTypeStr = "RIGHT"
            Else
                jTypeStr = "INNER"
            End If
            Dim uJnSave As Long
            uJnSave = -1
            uJnSave = UBound(m_qbeJoins)
            If m_relDialogQbeJoinIdx >= 0 And m_relDialogQbeJoinIdx <= uJnSave Then
                m_qbeJoins(m_relDialogQbeJoinIdx) = pkTbl & "|" & pkFld & "|" & fkTbl & "|" & fkFld & "|" & jTypeStr
            End If
            CloseVisualRelationshipDialog
            RebuildSqlFromQbeGrid
            lblStatus.Caption = "Query relationship updated: [" & pkTbl & "].[" & pkFld & "] (" & jTypeStr & " JOIN) [" & fkTbl & "].[" & fkFld & "]."
            Exit Sub
        End If

        enf = (fcChk01.Value = 1)
        cascU = (enf And (fcChk02.Value = 1))
        cascD = (enf And (fcChk03.Value = 1))

        ' Remove any existing relationship between pkTbl and fkTbl before creating/updating
        If Not StudioController.ActiveDatabase Is Nothing Then
            Dim rScan As Long
            Dim rObj As Object
            Dim delErr As String
            For rScan = StudioController.ActiveDatabase.Relations.Count - 1 To 0 Step -1
                Set rObj = StudioController.ActiveDatabase.Relations.Item(rScan)
                If Not rObj Is Nothing Then
                    If (StrComp(rObj.Table, pkTbl, vbTextCompare) = 0 And StrComp(rObj.ForeignTable, fkTbl, vbTextCompare) = 0 And StrComp(rObj.Fields(0).ForeignName, fkFld, vbTextCompare) = 0) Or (Len(m_relDialogExistingName) > 0 And StrComp(rObj.Name, m_relDialogExistingName, vbTextCompare) = 0) Then
                        StudioController.DeleteRelationship rObj.Name, delErr
                    End If
                End If
            Next rScan
        End If

        relName = pkTbl & fkTbl
        If StudioController.CreateRelationship(relName, pkTbl, fkTbl, pkFld, fkFld, enf, cascU, cascD, errMsg) Then
            m_dsLkCount = 0
            LookupCache.ClearLookupCache
            CloseVisualRelationshipDialog
            lblStatus.Caption = "Relationship [" & pkTbl & "].[" & pkFld & "] (1) ---> [" & fkTbl & "].[" & fkFld & "] (oo) saved."
            If m_currentWorkspaceMode = 8 Then
                DisplayRelationshipsView True
            ElseIf m_currentWorkspaceMode = 1 Then
                PopulateTableFieldProperties m_tdSelectedRow
                PaintTableDesignGrid
            End If
        Else
            MsgBox "Failed to save relationship: " & errMsg, vbExclamation, "Edit Relationships"
        End If
        On Error GoTo 0
    End Sub

    Private Sub DeleteVisualRelationshipDialog()
        On Error Resume Next
        If Not m_relDialogActive Then Exit Sub
        If m_relDialogIsQbeJoin Then
            Dim targetJoinIdx As Long
            targetJoinIdx = m_relDialogQbeJoinIdx
            CloseVisualRelationshipDialog
            RemoveQbeJoinAt targetJoinIdx
            Exit Sub
        End If
        Dim delErr As String
        Dim pkTbl As String
        Dim fkTbl As String
        pkTbl = Trim$(fcCbo02.Text)
        fkTbl = Trim$(fcCbo04.Text)

        If Len(m_relDialogExistingName) > 0 Then
            StudioController.DeleteRelationship m_relDialogExistingName, delErr
        ElseIf Not StudioController.ActiveDatabase Is Nothing Then
            Dim rScan As Long
            Dim rObj As Object
            For rScan = StudioController.ActiveDatabase.Relations.Count - 1 To 0 Step -1
                Set rObj = StudioController.ActiveDatabase.Relations.Item(rScan)
                If Not rObj Is Nothing Then
                    If (StrComp(rObj.Table, pkTbl, vbTextCompare) = 0 And StrComp(rObj.ForeignTable, fkTbl, vbTextCompare) = 0) Or (StrComp(rObj.Table, fkTbl, vbTextCompare) = 0 And StrComp(rObj.ForeignTable, pkTbl, vbTextCompare) = 0) Then
                        StudioController.DeleteRelationship rObj.Name, delErr
                    End If
                End If
            Next rScan
        End If

        m_dsLkCount = 0
        LookupCache.ClearLookupCache
        CloseVisualRelationshipDialog
        lblStatus.Caption = "Relationship deleted."
        If m_currentWorkspaceMode = 8 Then
            DisplayRelationshipsView True
        ElseIf m_currentWorkspaceMode = 1 Then
            PopulateTableFieldProperties m_tdSelectedRow
            PaintTableDesignGrid
        End If
        On Error GoTo 0
    End Sub

    Public Sub PromptCreateRelationshipDialog(Optional ByVal defaultForeignTable As String = "", Optional ByVal defaultForeignField As String = "", Optional ByVal defaultPrimaryTable As String = "", Optional ByVal defaultPrimaryField As String = "", Optional ByVal existingRelName As String = "")
        On Error Resume Next
        If Not StudioController.IsDatabaseOpen() Then Exit Sub

        Dim tCol As Collection
        Dim tItem As Variant
        Set tCol = StudioController.GetTableNames()
        If tCol Is Nothing Then Exit Sub
        If tCol.Count < 2 Then
            MsgBox "At least 2 tables are required in the database to create a relationship.", vbInformation, "Edit Relationships"
            Exit Sub
        End If

        fcCbo02.Clear
        fcCbo04.Clear
        For Each tItem In tCol
            If Left$(CStr(tItem), 4) <> "MSys" And Left$(CStr(tItem), 1) <> "~" Then
                fcCbo02.AddItem CStr(tItem)
                fcCbo04.AddItem CStr(tItem)
            End If
        Next tItem
        If fcCbo02.ListCount < 2 Then Exit Sub

        Dim initEnf As Boolean
        Dim initCU As Boolean
        Dim initCD As Boolean
        initEnf = True
        initCU = False
        initCD = False
        m_relDialogIsQbeJoin = False
        m_relDialogQbeJoinIdx = -1
        m_relDialogExistingName = Trim$(existingRelName)

        ' Check if an existing relationship matches existingRelName or (defaultPrimaryTable, defaultForeignTable)
        If Not StudioController.ActiveDatabase Is Nothing Then
            Dim rIdx As Long
            Dim rObj As Object
            For rIdx = 0 To StudioController.ActiveDatabase.Relations.Count - 1
                Set rObj = Nothing
                Set rObj = StudioController.ActiveDatabase.Relations.Item(rIdx)
                If Not rObj Is Nothing Then
                    Dim isMatchRel As Boolean
                    isMatchRel = False
                    If Len(m_relDialogExistingName) > 0 And StrComp(rObj.Name, m_relDialogExistingName, vbTextCompare) = 0 Then
                        isMatchRel = True
                    ElseIf Len(defaultPrimaryTable) > 0 And Len(defaultForeignTable) > 0 Then
                        If (StrComp(rObj.Table, defaultPrimaryTable, vbTextCompare) = 0 And StrComp(rObj.ForeignTable, defaultForeignTable, vbTextCompare) = 0) Or (StrComp(rObj.Table, defaultForeignTable, vbTextCompare) = 0 And StrComp(rObj.ForeignTable, defaultPrimaryTable, vbTextCompare) = 0) Then
                            isMatchRel = True
                        End If
                    End If
                    If isMatchRel Then
                        m_relDialogExistingName = rObj.Name
                        defaultPrimaryTable = rObj.Table
                        defaultForeignTable = rObj.ForeignTable
                        If rObj.Fields.Count > 0 Then
                            defaultPrimaryField = rObj.Fields(0).Name
                            defaultForeignField = rObj.Fields(0).ForeignName
                        End If
                        initEnf = ((CLng(rObj.Attributes) And 2&) = 0)
                        initCU = ((CLng(rObj.Attributes) And &H100&) <> 0)
                        initCD = ((CLng(rObj.Attributes) And &H1000&) <> 0)
                        Exit For
                    End If
                End If
            Next rIdx
        End If

        ' 1. Select Foreign (Many) Table in fcCbo04
        Dim fkIdx As Long
        Dim i As Long
        fkIdx = -1
        If Len(defaultForeignTable) = 0 Then defaultForeignTable = StudioController.GetActiveTableName()
        For i = 0 To fcCbo04.ListCount - 1
            If StrComp(fcCbo04.List(i), defaultForeignTable, vbTextCompare) = 0 Then
                fkIdx = i
                Exit For
            End If
        Next i
        If fkIdx < 0 Then fkIdx = fcCbo04.ListCount - 1
        fcCbo04.ListIndex = fkIdx
        fcCbo04.Text = fcCbo04.List(fkIdx)

        ' 2. Select Primary (One) Table in fcCbo02 (with smart field-name matching, e.g. 'product' -> 'Products')
        Dim pkIdx As Long
        pkIdx = -1
        If Len(defaultPrimaryTable) > 0 Then
            For i = 0 To fcCbo02.ListCount - 1
                If StrComp(fcCbo02.List(i), defaultPrimaryTable, vbTextCompare) = 0 Then
                    pkIdx = i
                    Exit For
                End If
            Next i
        End If
        If pkIdx < 0 And Len(defaultForeignField) > 0 Then
            Dim uFkStem As String
            uFkStem = UCase$(Trim$(Replace$(defaultForeignField, "_", "")))
            If Right$(uFkStem, 2) = "ID" And Len(uFkStem) > 2 Then
                uFkStem = Left$(uFkStem, Len(uFkStem) - 2)
            End If
            For i = 0 To fcCbo02.ListCount - 1
                If i <> fkIdx Then
                    Dim uTblCand As String
                    uTblCand = UCase$(Trim$(Replace$(fcCbo02.List(i), "_", "")))
                    If uTblCand = uFkStem Or uTblCand = uFkStem & "S" Or uTblCand = uFkStem & "ES" Or (Right$(uFkStem, 1) = "Y" And uTblCand = Left$(uFkStem, Len(uFkStem) - 1) & "IES") Or InStr(1, uTblCand, uFkStem) > 0 Or InStr(1, uFkStem, uTblCand) > 0 Then
                        pkIdx = i
                        Exit For
                    End If
                End If
            Next i
        End If
        If pkIdx < 0 Then
            For i = 0 To fcCbo02.ListCount - 1
                If i <> fkIdx Then
                    pkIdx = i
                    Exit For
                End If
            Next i
        End If
        If pkIdx < 0 Then pkIdx = 0
        fcCbo02.ListIndex = pkIdx
        fcCbo02.Text = fcCbo02.List(pkIdx)

        ' 3. Populate field dropdowns fcCbo03 (Primary Key Field) and fcCbo05 (Foreign Key Field)
        PopulateRelDialogFieldCombo fcCbo03, fcCbo02.Text, True, defaultPrimaryField
        PopulateRelDialogFieldCombo fcCbo05, fcCbo04.Text, False, IIf(Len(defaultForeignField) > 0, defaultForeignField, fcCbo03.Text)

        ' 4. Configure Referential Integrity & Cascade Update / Cascade Delete checkboxes
        fcChk01.Caption = "Enforce Referential Integrity"
        fcChk01.Value = IIf(initEnf, 1, 0)
        fcChk02.Caption = "Cascade Update Related Fields"
        fcChk02.Value = IIf(initEnf And initCU, 1, 0)
        fcChk02.Enabled = initEnf
        fcChk03.Caption = "Cascade Delete Related Records"
        fcChk03.Value = IIf(initEnf And initCD, 1, 0)
        fcChk03.Enabled = initEnf

        ' 5. Configure OK / Cancel / Delete buttons
        If Len(m_relDialogExistingName) > 0 Then
            fcBtn01.Caption = "Save Changes"
        Else
            fcBtn01.Caption = "Create"
        End If
        fcBtn02.Caption = "Cancel"
        fcBtn03.Caption = "Delete Rel [X]"

        m_relDialogActive = True
        LayoutVisualRelationshipDialog
        On Error GoTo 0
    End Sub

    Private Sub DisplayRelationshipsView(Optional ByVal preserveCanvasTables As Boolean = False)
        Dim relLines As Collection
        Dim errMsg As String
        Dim itemVal As Variant
        Dim dbObj As Object
        Dim rIdx As Long
        Dim relObj As Object
        Dim tblSet As New Collection
        Dim tList As Collection
        Dim tName As String
        Dim tCount As Long
        Dim jCount As Long
        Dim prevU As Long
        Dim pIdx As Long
        Dim baseT As String

        lblTableTitle.Caption = "Database Relationships & Visual ERD Diagram (Drag Table Headers to Move, Drag Fields to Link)"
        lstRecords.Clear
        lstRecords.AddItem "[+ Double-Click Here to Create a New Relationship (or drag a field between Table boxes above)]"

        Set dbObj = StudioController.ActiveDatabase
        tCount = 0
        jCount = 0

        On Error Resume Next
        If preserveCanvasTables Then
            prevU = -1
            prevU = UBound(m_qbeTables)
            If prevU >= 0 Then
                For pIdx = 0 To prevU
                    baseT = Split(m_qbeTables(pIdx), "|")(0)
                    If Len(baseT) > 0 Then
                        tblSet.Add baseT, UCase$(baseT)
                        tCount = pIdx + 1
                    End If
                Next pIdx
            End If
        Else
            Erase m_qbeTables
            Erase m_qbeBoxX
            Erase m_qbeBoxY
        End If
        Erase m_qbeJoins

        If Not dbObj Is Nothing Then
            For rIdx = 0 To dbObj.Relations.Count - 1
                Set relObj = dbObj.Relations.Item(rIdx)
                If Not relObj Is Nothing Then
                    If Left$(relObj.Table, 4) <> "MSys" And Left$(relObj.ForeignTable, 4) <> "MSys" And relObj.Fields.Count > 0 Then
                        Err.Clear
                        tblSet.Add relObj.Table, UCase$(relObj.Table)
                        If Err.Number = 0 Then
                            ReDim Preserve m_qbeTables(0 To tCount)
                            m_qbeTables(tCount) = relObj.Table
                            tCount = tCount + 1
                        End If
                        Err.Clear
                        tblSet.Add relObj.ForeignTable, UCase$(relObj.ForeignTable)
                        If Err.Number = 0 Then
                            ReDim Preserve m_qbeTables(0 To tCount)
                            m_qbeTables(tCount) = relObj.ForeignTable
                            tCount = tCount + 1
                        End If
                        Err.Clear

                        ReDim Preserve m_qbeJoins(0 To jCount)
                        m_qbeJoins(jCount) = relObj.Table & "|" & relObj.Fields(0).Name & "|" & relObj.ForeignTable & "|" & relObj.Fields(0).ForeignName & "|" & IIf((CLng(relObj.Attributes) And 1&) <> 0, "ONE_TO_ONE", "ONE_TO_MANY")
                        jCount = jCount + 1
                    End If
                End If
            Next rIdx
        End If

        If tCount < 2 Then
            Set tList = StudioController.GetTableNames()
            If Not tList Is Nothing Then
                For Each itemVal In tList
                    tName = CStr(itemVal)
                    If Left$(tName, 4) <> "MSys" And Left$(tName, 1) <> "~" Then
                        Err.Clear
                        tblSet.Add tName, UCase$(tName)
                        If Err.Number = 0 Then
                            ReDim Preserve m_qbeTables(0 To tCount)
                            m_qbeTables(tCount) = tName
                            tCount = tCount + 1
                            If tCount >= 8 Then Exit For
                        End If
                    End If
                Next itemVal
            End If
        End If
        On Error GoTo 0

        PaintQueryTables picQryTables, m_qbeTables, m_qbeJoins

        Set relLines = StudioController.GetRelationshipLines(errMsg)
        If Len(errMsg) > 0 Then
            lstRecords.AddItem "Relationship Notice: " & errMsg
            Exit Sub
        End If

        For Each itemVal In relLines
            lstRecords.AddItem CStr(itemVal)
        Next itemVal

        lblStatus.Caption = "Relationships: Drag table title bars to move, drag a field to another table to link, or click a line to Edit/Delete."
    End Sub

    ' -------------------------------------------------------------------------
    ' Phase 7 & Phase 24: Table Summary Reports, Grouped Reports & CSV Export
    ' -------------------------------------------------------------------------
    Private Sub btnReport_Click()
        Dim curTable As String
        Dim rptMode As VbMsgBoxResult
        Dim grpCol As String
        Dim sumCol As String
        Dim rptLines As Collection
        Dim errMsg As String
        Dim itemVal As Variant

        curTable = StudioController.GetActiveTableName()
        If Not StudioController.IsDatabaseOpen() Or Len(curTable) = 0 Or curTable = "SQL Query Result" Then
            MsgBox "Please select a table to generate a report.", vbInformation, "OpenAccess Studio"
            Exit Sub
        End If

        StudioController.SetViewMode 4
        rptMode = MsgBox("Would you like to generate a Grouped Report with Subtotals (Yes) or a Standard Table Summary Report (No)?", vbYesNoCancel + vbQuestion, "Report Wizard")
        If rptMode = vbCancel Then Exit Sub

        If rptMode = vbYes Then
            grpCol = InputBox("Enter Group By column name:", "Grouped Report Wizard (1/2)", "ID")
            If Len(Trim$(grpCol)) = 0 Then Exit Sub
            sumCol = InputBox("Enter numeric column for SUM/Subtotal calculation (or leave blank):", "Grouped Report Wizard (2/2)", "ID")
            lblTableTitle.Caption = "Grouped Summary Report: [" & curTable & "] (Grouped by " & grpCol & ")"
            lstRecords.Clear
            Set rptLines = StudioController.GenerateGroupedReportLines(curTable, Trim$(grpCol), Trim$(sumCol), errMsg)
            If Len(errMsg) > 0 Then
                lstRecords.AddItem "Grouped Report Error: " & errMsg
            Else
                For Each itemVal In rptLines
                    lstRecords.AddItem CStr(itemVal)
                Next itemVal
                lblStatus.Caption = "Grouped report generated for [" & curTable & "]."
            End If
        Else
            DisplayReportView curTable
        End If
    End Sub

    Private Sub DisplayReportView(ByVal tableName As String)
        Dim rptLines As Collection
        Dim errMsg As String
        Dim itemVal As Variant

        lblTableTitle.Caption = "Table Summary Report: [" & tableName & "]"
        lstRecords.Clear

        Set rptLines = StudioController.GenerateTableReportLines(tableName, errMsg)
        If Len(errMsg) > 0 Then
            lstRecords.AddItem "Report Generation Error: " & errMsg
            Exit Sub
        End If

        For Each itemVal In rptLines
            lstRecords.AddItem CStr(itemVal)
        Next itemVal

        lblStatus.Caption = "Summary report generated for table [" & tableName & "]."
    End Sub

    Private Sub btnExportCsv_Click()
        Dim curTable As String
        Dim targetPath As String
        Dim errMsg As String
        Dim ok As Boolean

        curTable = StudioController.GetActiveTableName()
        If Not StudioController.IsDatabaseOpen() Or Len(curTable) = 0 Or curTable = "SQL Query Result" Then
            MsgBox "Please select a table to export.", vbInformation, "OpenAccess Studio"
            Exit Sub
        End If

        targetPath = InputBox("Enter target file path for CSV export:", "Export Table to CSV", curTable & "_export.csv")
        targetPath = Trim$(targetPath)
        If Len(targetPath) = 0 Then Exit Sub

        ok = StudioController.ExportTableToCsv(curTable, targetPath, errMsg)
        If ok Then
            MsgBox "Table [" & curTable & "] exported successfully to:" & vbCrLf & targetPath, vbInformation, "Export Complete"
            lblStatus.Caption = "Exported [" & curTable & "] to " & targetPath
        Else
            MsgBox "Error exporting table: " & errMsg, vbCritical, "Export Error"
        End If
    End Sub

    ' -------------------------------------------------------------------------
    ' Phase 21: External Data Import (CSV) & Portable SQL Database Dump
    ' -------------------------------------------------------------------------
    Private Sub btnImportData_Click()
        Dim modeChoice As String
        Dim filePath As String
        Dim targetTable As String
        Dim rowsCount As Long
        Dim tblsCount As Long
        Dim errMsg As String
        Dim ok As Boolean

        If Not StudioController.IsDatabaseOpen() Then
            MsgBox "Please open a database first.", vbInformation, "OpenAccess Studio"
            Exit Sub
        End If

        modeChoice = InputBox("External Data Wizard:" & vbCrLf & "1 = Import CSV File into New/Existing Table" & vbCrLf & "2 = Export Database to Portable SQL Script (.sql)", "External Data Import / Export", "1")
        modeChoice = Trim$(modeChoice)
        If Len(modeChoice) = 0 Then Exit Sub

        If modeChoice = "1" Then
            filePath = InputBox("Enter source CSV file path to import:", "Import CSV (1/2)", "import_data.csv")
            If Len(Trim$(filePath)) = 0 Then Exit Sub
            targetTable = InputBox("Enter destination table name:", "Import CSV (2/2)", "ImportedTable")
            If Len(Trim$(targetTable)) = 0 Then Exit Sub

            ok = StudioController.ImportCsvToTable(Trim$(filePath), Trim$(targetTable), True, rowsCount, errMsg)
            If ok Then
                RefreshNavigationPane
                MsgBox "Imported " & CStr(rowsCount) & " row(s) into table [" & targetTable & "]!", vbInformation, "CSV Import Complete"
                lblStatus.Caption = "CSV Import complete: " & CStr(rowsCount) & " row(s) imported into [" & targetTable & "]."
            Else
                MsgBox "CSV Import error: " & errMsg, vbCritical, "Import Error"
            End If
        ElseIf modeChoice = "2" Then
            filePath = InputBox("Enter output file path for portable SQL script dump:", "Export SQL Script", "database_dump.sql")
            If Len(Trim$(filePath)) = 0 Then Exit Sub
            ok = StudioController.ExportDatabaseToSqlScript(Trim$(filePath), tblsCount, rowsCount, errMsg)
            If ok Then
                MsgBox "Exported " & CStr(tblsCount) & " table(s) and " & CStr(rowsCount) & " row(s) to SQL script:" & vbCrLf & filePath, vbInformation, "SQL Dump Complete"
                lblStatus.Caption = "Database exported to SQL script: " & filePath
            Else
                MsgBox "SQL Export error: " & errMsg, vbCritical, "Export Error"
            End If
        End If
    End Sub

    ' -------------------------------------------------------------------------
    ' Phase 8: Database Maintenance, Compact & Repair, Diagnostics
    ' -------------------------------------------------------------------------
    Private Sub btnCompact_Click()
        Dim errMsg As String
        Dim savedBytes As Long
        Dim ok As Boolean

        If Not StudioController.IsDatabaseOpen() Then
            MsgBox "Please open a database first.", vbInformation, "OpenAccess Studio"
            Exit Sub
        End If

        lblStatus.Caption = "Compacting and repairing database..."
        ok = StudioController.CompactAndRepairDatabase(errMsg, savedBytes)
        If ok Then
            RefreshNavigationPane
            MsgBox "Compact and Repair completed successfully!" & vbCrLf & "Storage reclaimed: " & Format$(savedBytes / 1024, "0.0") & " KB", vbInformation, "Compact & Repair"
            lblStatus.Caption = "Compact & Repair finished. Database re-indexed."
        Else
            MsgBox "Compact & Repair error: " & errMsg, vbCritical, "Maintenance Error"
        End If
    End Sub

    Private Sub btnBackup_Click()
        Dim outBackup As String
        Dim errMsg As String
        Dim ok As Boolean

        If Not StudioController.IsDatabaseOpen() Then
            MsgBox "Please open a database first.", vbInformation, "OpenAccess Studio"
            Exit Sub
        End If

        ok = StudioController.CreateDatabaseBackup(outBackup, errMsg)
        If ok Then
            MsgBox "Backup created successfully!" & vbCrLf & "Saved to: " & outBackup, vbInformation, "Database Backup"
            lblStatus.Caption = "Backup saved: " & outBackup
        Else
            MsgBox "Error creating backup: " & errMsg, vbCritical, "Backup Error"
        End If
    End Sub

    Private Sub btnHealth_Click()
        Dim healthLines As Collection
        Dim errMsg As String
        Dim itemVal As Variant
        Dim msgText As String

        If Not StudioController.IsDatabaseOpen() Then
            MsgBox "Please open a database first.", vbInformation, "OpenAccess Studio"
            Exit Sub
        End If

        Set healthLines = StudioController.GetDatabaseHealthMetrics(errMsg)
        msgText = ""
        For Each itemVal In healthLines
            msgText = msgText & CStr(itemVal) & vbCrLf
        Next itemVal

        Dim repLog As String
        Dim repairsCount As Long
        repairsCount = StudioController.VerifyAndRepairDatabase("", repLog)
        If repairsCount > 0 Then
            msgText = msgText & vbCrLf & "Self-Healing Diagnostic: " & CStr(repairsCount) & " issue(s) detected and repaired automatically."
        End If
        MsgBox msgText, vbInformation, "Database Health & Storage Diagnostics"
    End Sub

    ' -------------------------------------------------------------------------
    ' Phase 9: Hierarchical Subdatasheet View
    ' -------------------------------------------------------------------------
    Private Sub btnSubdatasheet_Click()
        Dim curTable As String
        curTable = StudioController.GetActiveTableName()
        If Not StudioController.IsDatabaseOpen() Or Len(curTable) = 0 Or curTable = "SQL Query Result" Then
            MsgBox "Please select a master table first.", vbInformation, "OpenAccess Studio"
            Exit Sub
        End If

        StudioController.SetViewMode 5
        DisplaySubdatasheetView curTable
    End Sub

    Private Sub DisplaySubdatasheetView(ByVal tableName As String)
        Dim lines As Collection
        Dim errMsg As String
        Dim itemVal As Variant

        lblTableTitle.Caption = "Hierarchical Subdatasheet View: [" & tableName & "]"
        lstRecords.Clear

        Set lines = StudioController.GetSubdatasheetViewLines(tableName, "", errMsg)
        If Len(errMsg) > 0 Then
            lstRecords.AddItem "Subdatasheet Error: " & errMsg
            Exit Sub
        End If

        For Each itemVal In lines
            lstRecords.AddItem CStr(itemVal)
        Next itemVal

        lblStatus.Caption = "Subdatasheet view active for table [" & tableName & "]."
    End Sub

    ' -------------------------------------------------------------------------
    ' Phase 10: Visual Form Designer Layout
    ' -------------------------------------------------------------------------
    Private Sub btnFormDesign_Click()
        Dim targetName As String
        Dim curTable As String

        If Not StudioController.IsDatabaseOpen() Then
            MsgBox "Please open a database first.", vbInformation, "OpenAccess Studio"
            Exit Sub
        End If

        targetName = vbNullString
        If StudioController.IsNativeFormActive() Then
            targetName = StudioController.GetActiveFormName()
        ElseIf Len(m_formName) > 0 Then
            targetName = m_formName
        Else
            curTable = StudioController.GetActiveTableName()
            If Len(curTable) > 0 And curTable <> "SQL Query Result" Then
                targetName = curTable
            End If
        End If

        If Len(targetName) = 0 Then
            MsgBox "Please select a Form or Table to view Form Design layout.", vbInformation, "OpenAccess Studio"
            Exit Sub
        End If

        StudioController.SetViewMode 6
        DisplayFormDesignView targetName
    End Sub

    Private Sub DisplayFormDesignView(ByVal objName As String)
        If StudioController.IsRuntimeMode Then Exit Sub
        Dim errMsg As String
        Dim objDef As String
        Dim srcName As String
        Dim isNativeForm As Boolean

        lblTableTitle.Caption = "Form Design: [" & objName & "]"
        m_selectedDesignCtlIndex = -1
        m_activePropTab = 0

        isNativeForm = StudioController.IsNativeFormActive() Or (StrComp(m_formName, objName, vbTextCompare) = 0)
        If isNativeForm Then
            m_formName = objName
            If Not (m_formLayoutValid And m_formLayoutKey = "FORM|" & UCase$(objName)) Then
                objDef = StudioController.GetCustomObjectDefinition("FORM", objName, srcName, errMsg)
                If Len(Trim$(srcName)) = 0 Then srcName = objName
                LoadFormLayout objName, objDef, srcName
            End If
        Else
            If Not (m_formLayoutValid And m_formLayoutKey = "TABLE|" & UCase$(objName)) Then
                StudioController.BuildAutoFormLayout objName, objName, StudioController.GetCurrentRecordset(), vbNullString, vbNullString, m_formLayout
                m_formLayoutKey = "TABLE|" & UCase$(objName)
                m_formLayoutValid = True
            End If
        End If

        SwitchWorkspaceMode 6
        PaintVisualFormDesigner
        PopulateTabbedPropertySheet m_selectedDesignCtlIndex
        lblStatus.Caption = "Form Design View: " & objName & " | Interactive Canvas with Multi-Section Grid and Property Sheet."
    End Sub
    ' -------------------------------------------------------------------------
    ' Form Design & FAYT Interactive Engines
    ' -------------------------------------------------------------------------
    Private Function MaxLong(ByVal a As Long, ByVal b As Long) As Long
        If a > b Then MaxLong = a Else MaxLong = b
    End Function

    Private Sub ApplyFaytFilter()
        Dim filterClause As String
        Dim filterOn As Boolean
        Dim pattern As String
        Dim errMsg As String
        Dim filterTxt As String
        Dim rs As Object
        Dim fld As Object
        Dim hasProd As Boolean
        Dim hasSupp As Boolean
        Dim targetFields As Collection
        Dim fName As String
        Dim cond As String
        Dim k As Long

        filterTxt = Trim$(m_faytFilterText)
        If Len(filterTxt) = 0 Then
            filterClause = vbNullString
            filterOn = False
        Else
            If m_faytFilterType = 1 Then
                pattern = filterTxt & "*"
            Else
                pattern = "*" & filterTxt & "*"
            End If
            pattern = Replace$(pattern, "'", "''")

            Set rs = StudioController.GetCurrentRecordset()
            hasProd = False
            hasSupp = False
            Dim suppColName As String
            suppColName = vbNullString
            Set targetFields = New Collection

            If Not rs Is Nothing Then
                On Error Resume Next
                For Each fld In rs.Fields
                    fName = fld.Name
                    If StrComp(fName, "ProductName", vbTextCompare) = 0 Then hasProd = True
                    If StrComp(fName, "supplierName", vbTextCompare) = 0 Or StrComp(fName, "Supplier", vbTextCompare) = 0 Then
                        hasSupp = True
                        suppColName = fName
                    End If
                    If fld.Type = 10 Or fld.Type = 12 Then
                        targetFields.Add fName
                    End If
                Next fld
                On Error GoTo 0
            End If

            filterClause = vbNullString
            If hasProd Or hasSupp Then
                If (m_faytSearchProducts Or (Not m_faytSearchProducts And Not m_faytSearchSupplier)) And hasProd Then
                    filterClause = "([ProductName] LIKE '" & pattern & "')"
                End If
                If m_faytSearchSupplier And hasSupp And Len(suppColName) > 0 Then
                    cond = "([" & suppColName & "] LIKE '" & pattern & "')"
                    If Len(filterClause) > 0 Then
                        filterClause = "(" & filterClause & " OR " & cond & ")"
                    Else
                        filterClause = cond
                    End If
                End If
            ElseIf targetFields.Count > 0 Then
                For k = 1 To targetFields.Count
                    If k > 2 Then Exit For
                    cond = "([" & CStr(targetFields(k)) & "] LIKE '" & pattern & "')"
                    If Len(filterClause) > 0 Then
                        filterClause = "(" & filterClause & " OR " & cond & ")"
                    Else
                        filterClause = cond
                    End If
                Next k
            End If

            filterOn = (Len(filterClause) > 0)
        End If

        StudioController.ApplyFormFilter m_formName, filterClause, filterOn, errMsg
        m_formTopRow = 0
        PaintFormCanvas
        UpdateNavigationControls
    End Sub

    Private Sub HandleFormHeaderClick(ByVal X As Single, ByVal Y As Single)
        Dim i As Long
        Dim ctlX As Long
        Dim ctlY As Long
        Dim ctlW As Long
        Dim ctlH As Long
        Dim ctlName As String
        Dim ctlType As String
        Dim ctlCap As String

        If Not m_formLayoutValid Then Exit Sub

        For i = 0 To m_formLayout.CtlCount - 1
            If m_formLayout.Ctls(i).Section = 1 And m_formLayout.Ctls(i).Visible Then
                ctlX = TwipsToPxX(m_formLayout.Ctls(i).LeftTw)
                ctlY = TwipsToPxY(m_formLayout.Ctls(i).TopTw)
                ctlW = TwipsToPxX(m_formLayout.Ctls(i).WidthTw)
                ctlH = TwipsToPxY(m_formLayout.Ctls(i).HeightTw)
                If ctlW < 14 Then ctlW = 14
                If ctlH < 14 Then ctlH = 14

                If X >= ctlX And X <= ctlX + ctlW And Y >= ctlY And Y <= ctlY + ctlH Then
                    ctlName = m_formLayout.Ctls(i).CtlName
                    ctlType = m_formLayout.Ctls(i).CtlType
                    ctlCap = m_formLayout.Ctls(i).Caption

                    If ctlType = "OptionButton" Or InStr(1, ctlName, "Option", vbTextCompare) > 0 Then
                        If InStr(1, ctlName, "Option16", vbTextCompare) > 0 Or InStr(1, ctlCap, "Start", vbTextCompare) > 0 Then
                            m_faytFilterType = 1
                        ElseIf InStr(1, ctlName, "Option18", vbTextCompare) > 0 Or InStr(1, ctlCap, "Any", vbTextCompare) > 0 Then
                            m_faytFilterType = 0
                        End If
                        FormRuntime.RaiseControlEvent m_formName, ctlName, "Click"
                        ApplyFaytFilter
                        Exit Sub
                    ElseIf ctlType = "CheckBox" Then
                        If InStr(1, ctlName, "optionProducts", vbTextCompare) > 0 Or InStr(1, ctlCap, "Product", vbTextCompare) > 0 Then
                            m_faytSearchProducts = Not m_faytSearchProducts
                        ElseIf InStr(1, ctlName, "optionSupplier", vbTextCompare) > 0 Or InStr(1, ctlCap, "Supplier", vbTextCompare) > 0 Then
                            m_faytSearchSupplier = Not m_faytSearchSupplier
                        End If
                        FormRuntime.RaiseControlEvent m_formName, ctlName, "Click"
                        ApplyFaytFilter
                        Exit Sub
                    ElseIf ctlType = "CommandButton" Then
                        FormRuntime.RaiseControlEvent m_formName, ctlName, "Click"
                        Exit Sub
                    End If
                End If
            End If
        Next i
    End Sub

    Private Sub PaintCanvasOptionButton(ByVal x As Long, ByVal y As Long, ByVal w As Long, ByVal h As Long, ByVal isChecked As Boolean, ByVal captionText As String)
        Dim cy As Long
        Dim cx As Long
        Dim r As Long

        On Error Resume Next
        cx = x + 7
        cy = y + (h \ 2)
        r = 6
        m_fcPic.Circle (cx, cy), r, &H808080&
        m_fcPic.Circle (cx, cy), r - 1, &HA0A0A0&
        m_fcPic.Circle (cx, cy), r - 2, &HFFFFFF&
        m_fcPic.Circle (cx, cy), r - 3, &HFFFFFF&

        If isChecked Then
            m_fcPic.Circle (cx, cy), 3, &H202020&
            m_fcPic.Circle (cx, cy), 2, &H202020&
            m_fcPic.Circle (cx, cy), 1, &H202020&
            m_fcPic.PSet (cx, cy), &H202020&
        End If

        If Len(captionText) > 0 Then
            m_fcPic.FontName = "Segoe UI"
            m_fcPic.FontSize = 8
            m_fcPic.FontBold = False
            m_fcPic.ForeColor = &H0&
            m_fcPic.CurrentX = x + 16
            m_fcPic.CurrentY = y + (h - m_fcPic.TextHeight(captionText)) \ 2
            m_fcPic.Print captionText
        End If
        On Error GoTo 0
    End Sub

    Private Sub PaintCanvasOptionGroup(ByVal x As Long, ByVal y As Long, ByVal w As Long, ByVal h As Long, ByVal captionText As String)
        Dim textW As Long
        Dim titleY As Long

        If w <= 0 Or h <= 0 Then Exit Sub
        On Error Resume Next
        titleY = y + 6
        m_fcPic.FontName = "Segoe UI"
        m_fcPic.FontSize = 8
        m_fcPic.FontBold = False
        m_fcPic.ForeColor = &H404040&

        If Len(captionText) > 0 Then
            textW = m_fcPic.TextWidth(captionText) + 8
            m_fcPic.Line (x, titleY)-(x + 10, titleY), &HA0A0A0&
            m_fcPic.Line (x + 10 + textW, titleY)-(x + w - 1, titleY), &HA0A0A0&
            m_fcPic.CurrentX = x + 14
            m_fcPic.CurrentY = y
            m_fcPic.Print captionText
        Else
            m_fcPic.Line (x, titleY)-(x + w - 1, titleY), &HA0A0A0&
        End If

        m_fcPic.Line (x, titleY)-(x, y + h - 1), &HA0A0A0&
        m_fcPic.Line (x, y + h - 1)-(x + w - 1, y + h - 1), &HA0A0A0&
        m_fcPic.Line (x + w - 1, titleY)-(x + w - 1, y + h - 1), &HA0A0A0&
        On Error GoTo 0
    End Sub

    Private Sub PaintVisualFormDesigner()
        Dim cw As Long
        Dim ch As Long
        Dim headerH As Long
        Dim detailH As Long
        Dim footerH As Long
        Dim barH As Long
        Dim sec0Top As Long
        Dim sec1Top As Long
        Dim sec2Top As Long
        Dim curY As Long
        Dim ctlIdx As Long
        Dim ctlX As Long
        Dim ctlY As Long
        Dim ctlW As Long
        Dim ctlH As Long
        Dim ctlType As String
        Dim ctlCap As String
        Dim gx As Long
        Dim gy As Long

        If m_currentWorkspaceMode <> 3 And m_currentWorkspaceMode <> 6 Then Exit Sub
        If Not m_formLayoutValid Then Exit Sub
        Set m_fcPic = picFormCanvas

        On Error Resume Next
        cw = picFormCanvas.ScaleWidth
        ch = picFormCanvas.ScaleHeight
        On Error GoTo 0
        If cw <= 0 Then cw = 638
        If ch <= 0 Then ch = 520

        barH = 22
        curY = 0

        ' Header section (only if present)
        If m_formLayout.SectionPresent(1) Then
            headerH = TwipsToPxY(m_formLayout.SectionHeightTw(1))
            If headerH <= 0 Then headerH = 70
            sec1Top = curY + barH
            curY = sec1Top + headerH
        Else
            headerH = 0
            sec1Top = -1
        End If

        ' Detail section (always present)
        detailH = TwipsToPxY(m_formLayout.SectionHeightTw(0))
        If detailH <= 0 Then detailH = 220
        sec0Top = curY + barH
        curY = sec0Top + detailH

        ' Footer section (only if present)
        If m_formLayout.SectionPresent(2) Then
            footerH = TwipsToPxY(m_formLayout.SectionHeightTw(2))
            If footerH <= 0 Then footerH = 40
            sec2Top = curY + barH
            curY = sec2Top + footerH
        Else
            footerH = 0
            sec2Top = -1
        End If

        picFormCanvas.AutoRedraw = True
        picFormCanvas.BackColor = &HFFFFFF&
        picFormCanvas.Cls
        picFormCanvas.FontTransparent = True

        ' Draw Sections & Grid Dots
        If m_formLayout.SectionPresent(1) Then
            PaintDesignerSectionBar sec1Top - barH, "[-] Form Header", cw, barH
            For gy = sec1Top + 8 To sec1Top + headerH - 4 Step 12
                For gx = 12 To cw - 12 Step 12
                    picFormCanvas.PSet (gx, gy), &HC0C0C0&
                Next gx
            Next gy
        End If

        PaintDesignerSectionBar sec0Top - barH, "[-] Detail", cw, barH
        For gy = sec0Top + 8 To sec0Top + detailH - 4 Step 12
            For gx = 12 To cw - 12 Step 12
                picFormCanvas.PSet (gx, gy), &HC0C0C0&
            Next gx
        Next gy

        If m_formLayout.SectionPresent(2) Then
            PaintDesignerSectionBar sec2Top - barH, "[-] Form Footer", cw, barH
            For gy = sec2Top + 8 To sec2Top + footerH - 4 Step 12
                For gx = 12 To cw - 12 Step 12
                    picFormCanvas.PSet (gx, gy), &HC0C0C0&
                Next gx
            Next gy
        End If

        ' Render Controls
        For ctlIdx = 0 To m_formLayout.CtlCount - 1
            ctlType = m_formLayout.Ctls(ctlIdx).CtlType
            ctlW = TwipsToPxX(m_formLayout.Ctls(ctlIdx).WidthTw)
            ctlH = TwipsToPxY(m_formLayout.Ctls(ctlIdx).HeightTw)
            If ctlW < 12 Then ctlW = 12
            If ctlH < 12 Then ctlH = 12
            ctlX = TwipsToPxX(m_formLayout.Ctls(ctlIdx).LeftTw)
            Select Case m_formLayout.Ctls(ctlIdx).Section
                Case 1:
                    If sec1Top >= 0 Then ctlY = sec1Top + TwipsToPxY(m_formLayout.Ctls(ctlIdx).TopTw) Else ctlY = sec0Top + TwipsToPxY(m_formLayout.Ctls(ctlIdx).TopTw)
                Case 2:
                    If sec2Top >= 0 Then ctlY = sec2Top + TwipsToPxY(m_formLayout.Ctls(ctlIdx).TopTw) Else ctlY = sec0Top + TwipsToPxY(m_formLayout.Ctls(ctlIdx).TopTw)
                Case Else:
                    ctlY = sec0Top + TwipsToPxY(m_formLayout.Ctls(ctlIdx).TopTw)
            End Select
            ctlCap = m_formLayout.Ctls(ctlIdx).Caption
            If Len(ctlCap) = 0 Then ctlCap = m_formLayout.Ctls(ctlIdx).CtlName

            Select Case ctlType
                Case "TextBox"
                    picFormCanvas.Line (ctlX, ctlY)-(ctlX + ctlW - 1, ctlY + ctlH - 1), &HFFFFFF&, BF
                    picFormCanvas.Line (ctlX, ctlY)-(ctlX + ctlW - 1, ctlY + ctlH - 1), &H7A7A7A&, B
                    picFormCanvas.FontName = "Segoe UI"
                    picFormCanvas.FontSize = 8
                    picFormCanvas.FontBold = False
                    picFormCanvas.ForeColor = &H404040&
                    picFormCanvas.CurrentX = ctlX + 4
                    picFormCanvas.CurrentY = ctlY + 2
                    picFormCanvas.Print ctlCap

                Case "Label"
                    picFormCanvas.FontName = "Segoe UI"
                    picFormCanvas.FontSize = 8
                    picFormCanvas.FontBold = False
                    picFormCanvas.ForeColor = &H0&
                    picFormCanvas.CurrentX = ctlX + 2
                    picFormCanvas.CurrentY = ctlY + 2
                    picFormCanvas.Print ctlCap

                Case "CommandButton"
                    picFormCanvas.Line (ctlX, ctlY)-(ctlX + ctlW - 1, ctlY + ctlH - 1), &HE0E0E0&, BF
                    picFormCanvas.Line (ctlX, ctlY)-(ctlX + ctlW - 1, ctlY + ctlH - 1), &H808080&, B
                    picFormCanvas.FontName = "Segoe UI"
                    picFormCanvas.FontSize = 8
                    picFormCanvas.FontBold = False
                    picFormCanvas.ForeColor = &H0&
                    picFormCanvas.CurrentX = ctlX + (ctlW - picFormCanvas.TextWidth(ctlCap)) \ 2
                    picFormCanvas.CurrentY = ctlY + (ctlH - picFormCanvas.TextHeight(ctlCap)) \ 2
                    picFormCanvas.Print ctlCap

                Case "CheckBox"
                    picFormCanvas.Line (ctlX, ctlY + (ctlH - 12) \ 2)-(ctlX + 12, ctlY + (ctlH - 12) \ 2 + 12), &HFFFFFF&, BF
                    picFormCanvas.Line (ctlX, ctlY + (ctlH - 12) \ 2)-(ctlX + 12, ctlY + (ctlH - 12) \ 2 + 12), &H808080&, B
                    If Len(ctlCap) > 0 Then
                        picFormCanvas.FontName = "Segoe UI"
                        picFormCanvas.FontSize = 8
                        picFormCanvas.ForeColor = &H0&
                        picFormCanvas.CurrentX = ctlX + 16
                        picFormCanvas.CurrentY = ctlY + 2
                        picFormCanvas.Print ctlCap
                    End If

                Case "OptionButton"
                    PaintCanvasOptionButton ctlX, ctlY, ctlW, ctlH, False, ctlCap

                Case "OptionGroup"
                    PaintCanvasOptionGroup ctlX, ctlY, ctlW, ctlH, ctlCap

                Case "Line"
                    picFormCanvas.Line (ctlX, ctlY)-(ctlX + ctlW, ctlY + ctlH), &H808080&

                Case "Rectangle"
                    picFormCanvas.Line (ctlX, ctlY)-(ctlX + ctlW - 1, ctlY + ctlH - 1), &HA0A0A0&, B

                Case Else
                    picFormCanvas.Line (ctlX, ctlY)-(ctlX + ctlW - 1, ctlY + ctlH - 1), &HF5F5F5&, BF
                    picFormCanvas.Line (ctlX, ctlY)-(ctlX + ctlW - 1, ctlY + ctlH - 1), &HA0A0A0&, B
                    picFormCanvas.FontName = "Segoe UI"
                    picFormCanvas.FontSize = 8
                    picFormCanvas.ForeColor = &H606060&
                    picFormCanvas.CurrentX = ctlX + 4
                    picFormCanvas.CurrentY = ctlY + 2
                    picFormCanvas.Print "[" & ctlType & "] " & ctlCap
            End Select

            If ctlIdx = m_selectedDesignCtlIndex Then
                picFormCanvas.Line (ctlX - 1, ctlY - 1)-(ctlX + ctlW, ctlY + ctlH), &HFF0000&, B
                DrawSelectionHandle ctlX - 3, ctlY - 3
                DrawSelectionHandle ctlX + ctlW \ 2 - 2, ctlY - 3
                DrawSelectionHandle ctlX + ctlW - 2, ctlY - 3
                DrawSelectionHandle ctlX + ctlW - 2, ctlY + ctlH \ 2 - 2
                DrawSelectionHandle ctlX + ctlW - 2, ctlY + ctlH - 2
                DrawSelectionHandle ctlX + ctlW \ 2 - 2, ctlY + ctlH - 2
                DrawSelectionHandle ctlX - 3, ctlY + ctlH - 2
                DrawSelectionHandle ctlX - 3, ctlY + ctlH \ 2 - 2
            End If
        Next ctlIdx

        picFormCanvas.Refresh
    End Sub

    Private Sub PaintDesignerSectionBar(ByVal y As Long, ByVal title As String, ByVal cw As Long, ByVal barH As Long)
        picFormCanvas.Line (0, y)-(cw - 1, y + barH - 1), &HD8D8D8&, BF
        picFormCanvas.Line (0, y)-(cw - 1, y), &HFFFFFF&
        picFormCanvas.Line (0, y + barH - 1)-(cw - 1, y + barH - 1), &H808080&
        picFormCanvas.FontName = "Segoe UI"
        picFormCanvas.FontSize = 8
        picFormCanvas.FontBold = True
        picFormCanvas.ForeColor = &H303030&
        picFormCanvas.CurrentX = 8
        picFormCanvas.CurrentY = y + (barH - picFormCanvas.TextHeight(title)) \ 2
        picFormCanvas.Print title
    End Sub

    Private Sub DrawSelectionHandle(ByVal x As Long, ByVal y As Long)
        picFormCanvas.Line (x, y)-(x + 4, y + 4), &H000000&, BF
    End Sub

    Private Sub HandleFormDesignerMouseDown(ByVal X As Single, ByVal Y As Single)
        Dim i As Long
        Dim barH As Long
        Dim headerH As Long
        Dim detailH As Long
        Dim footerH As Long
        Dim sec0Top As Long
        Dim sec1Top As Long
        Dim sec2Top As Long
        Dim curY As Long
        Dim ctlX As Long
        Dim ctlY As Long
        Dim ctlW As Long
        Dim ctlH As Long
        Dim hitCtl As Long
        Dim h As Long
        Dim hX(1 To 8) As Long
        Dim hY(1 To 8) As Long

        If Not m_formLayoutValid Then Exit Sub

        barH = 22
        curY = 0

        If m_formLayout.SectionPresent(1) Then
            headerH = TwipsToPxY(m_formLayout.SectionHeightTw(1))
            If headerH <= 0 Then headerH = 70
            sec1Top = curY + barH
            curY = sec1Top + headerH
        Else
            headerH = 0
            sec1Top = -1
        End If

        detailH = TwipsToPxY(m_formLayout.SectionHeightTw(0))
        If detailH <= 0 Then detailH = 220
        sec0Top = curY + barH
        curY = sec0Top + detailH

        If m_formLayout.SectionPresent(2) Then
            footerH = TwipsToPxY(m_formLayout.SectionHeightTw(2))
            If footerH <= 0 Then footerH = 40
            sec2Top = curY + barH
        Else
            footerH = 0
            sec2Top = -1
        End If

        ' First hit-test 8 selection handles on the currently selected control
        If m_selectedDesignCtlIndex >= 0 And m_selectedDesignCtlIndex < m_formLayout.CtlCount Then
            ctlW = TwipsToPxX(m_formLayout.Ctls(m_selectedDesignCtlIndex).WidthTw)
            ctlH = TwipsToPxY(m_formLayout.Ctls(m_selectedDesignCtlIndex).HeightTw)
            If ctlW < 12 Then ctlW = 12
            If ctlH < 12 Then ctlH = 12
            ctlX = TwipsToPxX(m_formLayout.Ctls(m_selectedDesignCtlIndex).LeftTw)
            Select Case m_formLayout.Ctls(m_selectedDesignCtlIndex).Section
                Case 1:
                    If sec1Top >= 0 Then ctlY = sec1Top + TwipsToPxY(m_formLayout.Ctls(m_selectedDesignCtlIndex).TopTw) Else ctlY = sec0Top + TwipsToPxY(m_formLayout.Ctls(m_selectedDesignCtlIndex).TopTw)
                Case 2:
                    If sec2Top >= 0 Then ctlY = sec2Top + TwipsToPxY(m_formLayout.Ctls(m_selectedDesignCtlIndex).TopTw) Else ctlY = sec0Top + TwipsToPxY(m_formLayout.Ctls(m_selectedDesignCtlIndex).TopTw)
                Case Else:
                    ctlY = sec0Top + TwipsToPxY(m_formLayout.Ctls(m_selectedDesignCtlIndex).TopTw)
            End Select

            hX(1) = ctlX: hY(1) = ctlY
            hX(2) = ctlX + ctlW \ 2: hY(2) = ctlY
            hX(3) = ctlX + ctlW: hY(3) = ctlY
            hX(4) = ctlX + ctlW: hY(4) = ctlY + ctlH \ 2
            hX(5) = ctlX + ctlW: hY(5) = ctlY + ctlH
            hX(6) = ctlX + ctlW \ 2: hY(6) = ctlY + ctlH
            hX(7) = ctlX: hY(7) = ctlY + ctlH
            hX(8) = ctlX: hY(8) = ctlY + ctlH \ 2

            For h = 1 To 8
                If Abs(X - hX(h)) <= 6 And Abs(Y - hY(h)) <= 6 Then
                    m_isResizingControl = True
                    m_resizeHandleIndex = h
                    m_ctlDragStartX = X
                    m_ctlDragStartY = Y
                    m_dragOrigCtlLeft = m_formLayout.Ctls(m_selectedDesignCtlIndex).LeftTw
                    m_dragOrigCtlTop = m_formLayout.Ctls(m_selectedDesignCtlIndex).TopTw
                    m_dragOrigCtlWidth = m_formLayout.Ctls(m_selectedDesignCtlIndex).WidthTw
                    m_dragOrigCtlHeight = m_formLayout.Ctls(m_selectedDesignCtlIndex).HeightTw
                    Exit Sub
                End If
            Next h
        End If

        ' Hit-test controls for selection
        hitCtl = -1
        For i = m_formLayout.CtlCount - 1 To 0 Step -1
            ctlW = TwipsToPxX(m_formLayout.Ctls(i).WidthTw)
            ctlH = TwipsToPxY(m_formLayout.Ctls(i).HeightTw)
            If ctlW < 12 Then ctlW = 12
            If ctlH < 12 Then ctlH = 12
            ctlX = TwipsToPxX(m_formLayout.Ctls(i).LeftTw)
            Select Case m_formLayout.Ctls(i).Section
                Case 1:
                    If sec1Top >= 0 Then ctlY = sec1Top + TwipsToPxY(m_formLayout.Ctls(i).TopTw) Else ctlY = sec0Top + TwipsToPxY(m_formLayout.Ctls(i).TopTw)
                Case 2:
                    If sec2Top >= 0 Then ctlY = sec2Top + TwipsToPxY(m_formLayout.Ctls(i).TopTw) Else ctlY = sec0Top + TwipsToPxY(m_formLayout.Ctls(i).TopTw)
                Case Else:
                    ctlY = sec0Top + TwipsToPxY(m_formLayout.Ctls(i).TopTw)
            End Select

            If X >= ctlX And X <= ctlX + ctlW And Y >= ctlY And Y <= ctlY + ctlH Then
                hitCtl = i
                Exit For
            End If
        Next i

        m_selectedDesignCtlIndex = hitCtl
        If hitCtl >= 0 Then
            m_isDraggingControl = True
            m_isResizingControl = False
            m_ctlDragStartX = X
            m_ctlDragStartY = Y
            m_dragOrigCtlLeft = m_formLayout.Ctls(hitCtl).LeftTw
            m_dragOrigCtlTop = m_formLayout.Ctls(hitCtl).TopTw
            m_dragOrigCtlWidth = m_formLayout.Ctls(hitCtl).WidthTw
            m_dragOrigCtlHeight = m_formLayout.Ctls(hitCtl).HeightTw
        Else
            m_isDraggingControl = False
            m_isResizingControl = False
        End If

        PopulateTabbedPropertySheet m_selectedDesignCtlIndex
        PaintVisualFormDesigner
    End Sub

    Private Sub HandleFormDesignerMouseMove(ByVal X As Single, ByVal Y As Single)
        Dim dx As Long
        Dim dy As Long

        If Not m_formLayoutValid Then Exit Sub

        If m_isResizingControl And m_selectedDesignCtlIndex >= 0 And m_selectedDesignCtlIndex < m_formLayout.CtlCount Then
            dx = CLng((X - m_ctlDragStartX) * 15)
            dy = CLng((Y - m_ctlDragStartY) * 15)
            Select Case m_resizeHandleIndex
                Case 1: ' Top-Left
                    m_formLayout.Ctls(m_selectedDesignCtlIndex).LeftTw = MaxLong(0, m_dragOrigCtlLeft + dx)
                    m_formLayout.Ctls(m_selectedDesignCtlIndex).TopTw = MaxLong(0, m_dragOrigCtlTop + dy)
                    m_formLayout.Ctls(m_selectedDesignCtlIndex).WidthTw = MaxLong(180, m_dragOrigCtlWidth - dx)
                    m_formLayout.Ctls(m_selectedDesignCtlIndex).HeightTw = MaxLong(180, m_dragOrigCtlHeight - dy)
                Case 2: ' Top
                    m_formLayout.Ctls(m_selectedDesignCtlIndex).TopTw = MaxLong(0, m_dragOrigCtlTop + dy)
                    m_formLayout.Ctls(m_selectedDesignCtlIndex).HeightTw = MaxLong(180, m_dragOrigCtlHeight - dy)
                Case 3: ' Top-Right
                    m_formLayout.Ctls(m_selectedDesignCtlIndex).TopTw = MaxLong(0, m_dragOrigCtlTop + dy)
                    m_formLayout.Ctls(m_selectedDesignCtlIndex).WidthTw = MaxLong(180, m_dragOrigCtlWidth + dx)
                    m_formLayout.Ctls(m_selectedDesignCtlIndex).HeightTw = MaxLong(180, m_dragOrigCtlHeight - dy)
                Case 4: ' Right
                    m_formLayout.Ctls(m_selectedDesignCtlIndex).WidthTw = MaxLong(180, m_dragOrigCtlWidth + dx)
                Case 5: ' Bottom-Right
                    m_formLayout.Ctls(m_selectedDesignCtlIndex).WidthTw = MaxLong(180, m_dragOrigCtlWidth + dx)
                    m_formLayout.Ctls(m_selectedDesignCtlIndex).HeightTw = MaxLong(180, m_dragOrigCtlHeight + dy)
                Case 6: ' Bottom
                    m_formLayout.Ctls(m_selectedDesignCtlIndex).HeightTw = MaxLong(180, m_dragOrigCtlHeight + dy)
                Case 7: ' Bottom-Left
                    m_formLayout.Ctls(m_selectedDesignCtlIndex).LeftTw = MaxLong(0, m_dragOrigCtlLeft + dx)
                    m_formLayout.Ctls(m_selectedDesignCtlIndex).WidthTw = MaxLong(180, m_dragOrigCtlWidth - dx)
                    m_formLayout.Ctls(m_selectedDesignCtlIndex).HeightTw = MaxLong(180, m_dragOrigCtlHeight + dy)
                Case 8: ' Left
                    m_formLayout.Ctls(m_selectedDesignCtlIndex).LeftTw = MaxLong(0, m_dragOrigCtlLeft + dx)
                    m_formLayout.Ctls(m_selectedDesignCtlIndex).WidthTw = MaxLong(180, m_dragOrigCtlWidth - dx)
            End Select
            PaintVisualFormDesigner
            Exit Sub
        End If

        If m_isDraggingControl And m_selectedDesignCtlIndex >= 0 And m_selectedDesignCtlIndex < m_formLayout.CtlCount Then
            dx = CLng((X - m_ctlDragStartX) * 15)
            dy = CLng((Y - m_ctlDragStartY) * 15)
            m_formLayout.Ctls(m_selectedDesignCtlIndex).LeftTw = MaxLong(0, m_dragOrigCtlLeft + dx)
            m_formLayout.Ctls(m_selectedDesignCtlIndex).TopTw = MaxLong(0, m_dragOrigCtlTop + dy)
            PaintVisualFormDesigner
        End If
    End Sub

    Private Sub HandleFormDesignerMouseUp(ByVal X As Single, ByVal Y As Single)
        If m_isDraggingControl Or m_isResizingControl Then
            If m_selectedDesignCtlIndex >= 0 And m_selectedDesignCtlIndex < m_formLayout.CtlCount Then
                Dim newLeft As Long, newTop As Long, newWidth As Long, newHeight As Long
                newLeft = m_formLayout.Ctls(m_selectedDesignCtlIndex).LeftTw
                newTop = m_formLayout.Ctls(m_selectedDesignCtlIndex).TopTw
                newWidth = m_formLayout.Ctls(m_selectedDesignCtlIndex).WidthTw
                newHeight = m_formLayout.Ctls(m_selectedDesignCtlIndex).HeightTw
                If newLeft <> m_dragOrigCtlLeft Or newTop <> m_dragOrigCtlTop Or newWidth <> m_dragOrigCtlWidth Or newHeight <> m_dragOrigCtlHeight Then
                    m_formLayout.Ctls(m_selectedDesignCtlIndex).LeftTw = m_dragOrigCtlLeft
                    m_formLayout.Ctls(m_selectedDesignCtlIndex).TopTw = m_dragOrigCtlTop
                    m_formLayout.Ctls(m_selectedDesignCtlIndex).WidthTw = m_dragOrigCtlWidth
                    m_formLayout.Ctls(m_selectedDesignCtlIndex).HeightTw = m_dragOrigCtlHeight
                    StudioController.SetDesignerLayout m_formLayout
                    StudioController.RecordMoveResizeCommand m_selectedDesignCtlIndex, newLeft, newTop, newWidth, newHeight, m_dragOrigCtlLeft, m_dragOrigCtlTop, m_dragOrigCtlWidth, m_dragOrigCtlHeight, Me
                End If
            End If
            m_isDraggingControl = False
            m_isResizingControl = False
            PopulateTabbedPropertySheet m_selectedDesignCtlIndex
        End If
    End Sub

    Public Sub ApplyControlGeometry(ByVal ctlIndex As Long, ByVal leftTw As Long, ByVal topTw As Long, ByVal widthTw As Long, ByVal heightTw As Long)
        If ctlIndex >= 0 And ctlIndex < m_formLayout.CtlCount Then
            m_formLayout.Ctls(ctlIndex).LeftTw = leftTw
            m_formLayout.Ctls(ctlIndex).TopTw = topTw
            m_formLayout.Ctls(ctlIndex).WidthTw = widthTw
            m_formLayout.Ctls(ctlIndex).HeightTw = heightTw
            StudioController.SetDesignerLayout m_formLayout
            PaintVisualFormDesigner
            PopulateTabbedPropertySheet ctlIndex
        End If
    End Sub

    Public Sub ApplyControlProperty(ByVal ctlIndex As Long, ByVal propName As String, ByVal propVal As String)
        Dim pName As String
        pName = LCase$(Trim$(propName))
        If ctlIndex >= 0 And ctlIndex < m_formLayout.CtlCount Then
            Select Case pName
                Case "caption": m_formLayout.Ctls(ctlIndex).Caption = propVal
                Case "controlsource": m_formLayout.Ctls(ctlIndex).ControlSource = propVal
                Case "rowsource": m_formLayout.Ctls(ctlIndex).RowSource = propVal
                Case "ctlname", "name": m_formLayout.Ctls(ctlIndex).CtlName = propVal
                Case "left", "lefttw": m_formLayout.Ctls(ctlIndex).LeftTw = Val(propVal)
                Case "top", "toptw": m_formLayout.Ctls(ctlIndex).TopTw = Val(propVal)
                Case "width", "widthtw": m_formLayout.Ctls(ctlIndex).WidthTw = Val(propVal)
                Case "height", "heighttw": m_formLayout.Ctls(ctlIndex).HeightTw = Val(propVal)
            End Select
            StudioController.SetDesignerLayout m_formLayout
            PaintVisualFormDesigner
            PopulateTabbedPropertySheet ctlIndex
        End If
    End Sub

    Public Sub UndoDesignerAction()
        If StudioController.UndoDesignerAction() Then
            lblStatus.Caption = "Undo: " & StudioController.CommandHistory.LastRedoDescription()
        End If
    End Sub

    Public Sub RedoDesignerAction()
        If StudioController.RedoDesignerAction() Then
            lblStatus.Caption = "Redo: " & StudioController.CommandHistory.LastUndoDescription()
        End If
    End Sub

    Private Sub Form_KeyDown(KeyCode As Integer, Shift As Integer)
        If Shift = 2 Then
            If KeyCode = 90 Then
                UndoDesignerAction
                Exit Sub
            ElseIf KeyCode = 89 Then
                RedoDesignerAction
                Exit Sub
            End If
        End If
        If KeyCode = vbKeyDelete Or KeyCode = vbKeyBack Then
            If m_relDialogActive And m_relDialogIsQbeJoin Then
                DeleteVisualRelationshipDialog
                KeyCode = 0
                Exit Sub
            End If
            If m_currentWorkspaceMode = 12 And Not fcTxt01.Visible And Not fcCbo01.Visible Then
                If m_qbeSelectedJoinIdx >= 0 Then
                    RemoveQbeJoinAt m_qbeSelectedJoinIdx
                    KeyCode = 0
                    Exit Sub
                End If
            End If
        End If
    End Sub

    Private Sub PopulateTabbedPropertySheet(ByVal ctlIdx As Long)
        Dim selObjName As String
        Dim tabHeader As String

        If Not m_formLayoutValid Then Exit Sub
        lstPropSheet.Clear

        If ctlIdx >= 0 And ctlIdx < m_formLayout.CtlCount Then
            selObjName = m_formLayout.Ctls(ctlIdx).CtlName & " (" & m_formLayout.Ctls(ctlIdx).CtlType & ")"
        Else
            selObjName = "Form: " & m_formLayout.FormName
        End If

        tabHeader = ""
        tabHeader = tabHeader & IIf(m_activePropTab = 0, " [ FORMAT ] ", "  Format  ")
        tabHeader = tabHeader & IIf(m_activePropTab = 1, " [ DATA ] ", "  Data  ")
        tabHeader = tabHeader & IIf(m_activePropTab = 2, " [ EVENT ] ", "  Event  ")
        tabHeader = tabHeader & IIf(m_activePropTab = 3, " [ OTHER ] ", "  Other  ")
        tabHeader = tabHeader & IIf(m_activePropTab = 4, " [ ALL ] ", "  All  ")

        lstPropSheet.AddItem tabHeader
        lstPropSheet.AddItem "Selection: " & selObjName
        lstPropSheet.AddItem "----------------------------------------"

        If ctlIdx >= 0 And ctlIdx < m_formLayout.CtlCount Then
            If m_activePropTab = 0 Or m_activePropTab = 4 Then
                lstPropSheet.AddItem "Caption: " & m_formLayout.Ctls(ctlIdx).Caption
                lstPropSheet.AddItem "Visible: " & IIf(m_formLayout.Ctls(ctlIdx).Visible, "Yes", "No")
                lstPropSheet.AddItem "Left: " & CStr(m_formLayout.Ctls(ctlIdx).LeftTw)
                lstPropSheet.AddItem "Top: " & CStr(m_formLayout.Ctls(ctlIdx).TopTw)
                lstPropSheet.AddItem "Width: " & CStr(m_formLayout.Ctls(ctlIdx).WidthTw)
                lstPropSheet.AddItem "Height: " & CStr(m_formLayout.Ctls(ctlIdx).HeightTw)
                lstPropSheet.AddItem "Back Color: &H" & Hex$(m_formLayout.Ctls(ctlIdx).BackColor)
                lstPropSheet.AddItem "Fore Color: &H" & Hex$(m_formLayout.Ctls(ctlIdx).ForeColor)
                lstPropSheet.AddItem "Font Name: " & m_formLayout.Ctls(ctlIdx).FontName
                lstPropSheet.AddItem "Font Size: " & CStr(m_formLayout.Ctls(ctlIdx).FontSize)
                lstPropSheet.AddItem "Font Bold: " & IIf(m_formLayout.Ctls(ctlIdx).FontBold, "Yes", "No")
                lstPropSheet.AddItem "Text Align: " & CStr(m_formLayout.Ctls(ctlIdx).TextAlign)
            End If

            If m_activePropTab = 1 Or m_activePropTab = 4 Then
                lstPropSheet.AddItem "Control Source: " & m_formLayout.Ctls(ctlIdx).ControlSource
                lstPropSheet.AddItem "Enabled: Yes"
                lstPropSheet.AddItem "Locked: No"
                lstPropSheet.AddItem "Row Source: " & m_formLayout.Ctls(ctlIdx).RowSource
                lstPropSheet.AddItem "Bound Column: " & CStr(m_formLayout.Ctls(ctlIdx).BoundColumn)
            End If

            If m_activePropTab = 2 Or m_activePropTab = 4 Then
                lstPropSheet.AddItem "On Click:               [Event Procedure] [...]"
                lstPropSheet.AddItem "On Dbl Click:           [Event Procedure] [...]"
                lstPropSheet.AddItem "On Change:              [Event Procedure] [...]"
                lstPropSheet.AddItem "On Got Focus:           [Event Procedure] [...]"
                lstPropSheet.AddItem "On Lost Focus:          [Event Procedure] [...]"
                lstPropSheet.AddItem "On Key Down:            [Event Procedure] [...]"
                lstPropSheet.AddItem "On Key Up:              [Event Procedure] [...]"
                lstPropSheet.AddItem "On Mouse Move:          [Event Procedure] [...]"
            End If

            If m_activePropTab = 3 Or m_activePropTab = 4 Then
                lstPropSheet.AddItem "Name: " & m_formLayout.Ctls(ctlIdx).CtlName
                lstPropSheet.AddItem "Section: " & CStr(m_formLayout.Ctls(ctlIdx).Section)
                lstPropSheet.AddItem "Tab Stop: Yes"
            End If
        Else
            If m_activePropTab = 0 Or m_activePropTab = 4 Then
                lstPropSheet.AddItem "Caption: " & m_formLayout.FormName
                lstPropSheet.AddItem "Default View: " & IIf(m_formLayout.DefaultView = 1, "Continuous Forms", IIf(m_formLayout.DefaultView = 2, "Datasheet", "Single Form"))
                lstPropSheet.AddItem "Record Selectors: " & IIf(m_formLayout.RecordSelectors, "Yes", "No")
                lstPropSheet.AddItem "Navigation Buttons: " & IIf(m_formLayout.NavigationButtons, "Yes", "No")
                lstPropSheet.AddItem "Width: " & CStr(m_formLayout.FormWidthTw)
            End If

            If m_activePropTab = 1 Or m_activePropTab = 4 Then
                lstPropSheet.AddItem "Record Source: " & m_formLayout.RecordSource
                lstPropSheet.AddItem "Filter: " & StudioController.GetActiveFilterClause()
                lstPropSheet.AddItem "Filter On Load: " & IIf(StudioController.IsActiveFilterOn(), "Yes", "No")
                lstPropSheet.AddItem "Allow Additions: " & IIf(m_formLayout.AllowAdditions, "Yes", "No")
            End If

            If m_activePropTab = 2 Or m_activePropTab = 4 Then
                lstPropSheet.AddItem "On Current:             [Event Procedure] [...]"
                lstPropSheet.AddItem "On Load:                [Event Procedure] [...]"
                lstPropSheet.AddItem "On Open:                [Event Procedure] [...]"
                lstPropSheet.AddItem "On Close:               [Event Procedure] [...]"
                lstPropSheet.AddItem "On Activate:            [Event Procedure] [...]"
                lstPropSheet.AddItem "On Deactivate:          [Event Procedure] [...]"
                lstPropSheet.AddItem "On Dirty:               [Event Procedure] [...]"
                lstPropSheet.AddItem "On Resize:              [Event Procedure] [...]"
            End If

            If m_activePropTab = 3 Or m_activePropTab = 4 Then
                lstPropSheet.AddItem "Name: " & m_formLayout.FormName
                lstPropSheet.AddItem "Has Module: Yes"
                lstPropSheet.AddItem "Pop Up: No"
                lstPropSheet.AddItem "Modal: No"
            End If
        End If
    End Sub

    Public Sub JumpToVbeEventCode(ByVal ctlName As String, ByVal eventName As String)
        Dim formName As String
        Dim modName As String
        Dim procName As String
        Dim curCode As String
        Dim newCode As String
        Dim subHeader As String
        Dim paramList As String
        Dim pos As Long
        Dim errMsg As String
        Dim objBox As String
        Dim procBox As String

        formName = m_formName
        If Len(formName) = 0 Then formName = StudioController.GetActiveFormName()
        If Len(formName) = 0 Then formName = StudioController.GetActiveTableName()
        If Len(formName) = 0 Then
            MsgBox "No active Form to edit VBA code.", vbInformation, "OpenAccess Studio"
            Exit Sub
        End If

        modName = "Form_" & formName
        If ctlName = "Form" Or StrComp(ctlName, formName, vbTextCompare) = 0 Then
            procName = "Form_" & eventName
            objBox = "Form"
        Else
            procName = ctlName & "_" & eventName
            objBox = ctlName
        End If
        procBox = eventName

        Select Case LCase$(eventName)
            Case "dblclick", "open", "dirty", "unload"
                paramList = "(Cancel As Integer)"
            Case "keydown", "keyup"
                paramList = "(KeyCode As Integer, Shift As Integer)"
            Case "keypress"
                paramList = "(KeyAscii As Integer)"
            Case "mousemove", "mousedown", "mouseup"
                paramList = "(Button As Integer, Shift As Integer, X As Single, Y As Single)"
            Case Else
                paramList = "()"
        End Select

        curCode = StudioController.GetNativeVbaModuleCode(modName)
        If Len(Trim$(curCode)) = 0 Then
            curCode = "Option Compare Database" & vbCrLf & "Option Explicit" & vbCrLf
        End If

        subHeader = "Sub " & procName & "("
        If InStr(1, curCode, subHeader, vbTextCompare) = 0 Then
            newCode = curCode & vbCrLf & vbCrLf & "Private Sub " & procName & paramList & vbCrLf & "    ' Event handler generated for " & procName & vbCrLf & "End Sub" & vbCrLf
            StudioController.SaveVbaModuleCode modName, newCode, errMsg
            curCode = newCode
        End If

        SwitchWorkspaceMode 4
        lblVbeHeader.Caption = "VBE Code: " & modName & " (Code)"
        txtVbeObj.Text = objBox
        txtVbeProc.Text = procBox
        txtVbaCode.Text = StudioController.GetCleanVbaModuleCode(modName, objBox, procBox)

        pos = InStr(1, txtVbaCode.Text, subHeader, vbTextCompare)
        If pos > 0 Then
            txtVbaCode.SelStart = pos + Len(subHeader) - 1
            txtVbaCode.SelLength = 0
        End If
        txtVbaCode.SetFocus
        lblStatus.Caption = "VBE: Jumped to event procedure [" & procName & "] in [" & modName & "]."
    End Sub


    ' -------------------------------------------------------------------------
    ' Phase 11: Visual Query Builder & Parameter Queries
    ' -------------------------------------------------------------------------
    Private Sub btnQueryBuilder_Click()
        StartNewVisualQueryDesigner
    End Sub

    Public Sub StartNewVisualQueryDesigner()
        If Not StudioController.IsDatabaseOpen() Then
            MsgBox "Please open a database first.", vbInformation, "Visual Query Designer"
            Exit Sub
        End If

        Dim qNum As Long
        Dim candidate As String
        Dim qList As Collection
        Dim itemVal As Variant
        Dim nameExists As Boolean

        Set qList = StudioController.GetQueryNames()
        qNum = 1
        Do
            candidate = "Query" & CStr(qNum)
            nameExists = False
            If Not qList Is Nothing Then
                For Each itemVal In qList
                    If StrComp(CStr(itemVal), candidate, vbTextCompare) = 0 Then
                        nameExists = True
                        Exit For
                    End If
                Next itemVal
            End If
            If Not nameExists Then Exit Do
            qNum = qNum + 1
        Loop

        m_activeQueryName = candidate
        lblTableTitle.Caption = candidate
        SwitchWorkspaceMode 12
        UpdateRibbonToolbar "QUERY"

        Erase m_qbeTables
        Erase m_qbeJoins
        Erase m_qbeCols
        Erase m_qbeBoxX
        Erase m_qbeBoxY
        m_qbeSelectedJoinIdx = -1
        m_qbeColCount = 0

        txtSql.Text = "SELECT *;"
        PaintQueryTables picQryTables, m_qbeTables, m_qbeJoins
        PaintQbeGrid picQbeGrid, m_qbeCols
        lblStatus.Caption = "New Query: [" & candidate & "] | Double-click tables in the Add Tables pane to design."
    End Sub

    ' -------------------------------------------------------------------------
    ' Phase 12: Macro Automation Sequence Runner
    ' -------------------------------------------------------------------------
    Private Sub btnMacro_Click()
        Dim curTable As String
        Dim steps As New Collection
        Dim logs As Collection
        Dim itemVal As Variant
        Dim ok As Boolean

        If Not StudioController.IsDatabaseOpen() Then
            MsgBox "Please open a database first.", vbInformation, "OpenAccess Studio"
            Exit Sub
        End If

        If m_currentWorkspaceMode = 12 Then
            If m_relDialogActive And m_relDialogIsQbeJoin Then
                DeleteVisualRelationshipDialog
                Exit Sub
            ElseIf m_qbeSelectedJoinIdx >= 0 Then
                RemoveQbeJoinAt m_qbeSelectedJoinIdx
                Exit Sub
            End If
        End If

        curTable = StudioController.GetActiveTableName()
        If Len(curTable) = 0 Or curTable = "SQL Query Result" Then
            curTable = "Customers"
        End If

        If StudioController.IsNativeFormActive() Or StudioController.IsNativeModuleActive() Then
            btnFormCmd_Click
            Exit Sub
        End If
        steps.Add "OpenTable|" & curTable
        steps.Add "ShowMessage|Automated macro successfully verified table [" & curTable & "]."

        lblStatus.Caption = "Executing macro automation sequence..."
        ok = StudioController.RunMacroSequence(steps, logs)

        lblTableTitle.Caption = "Macro Automation Execution Log"
        lstRecords.Clear
        For Each itemVal In logs
            lstRecords.AddItem CStr(itemVal)
        Next itemVal

        If ok Then
            lblStatus.Caption = "Macro automation sequence completed successfully."
            MsgBox "Macro sequence executed successfully!", vbInformation, "Macro Automation"
        Else
            lblStatus.Caption = "Macro automation finished with warnings/errors."
        End If
    End Sub

    Private Sub RunSavedMacroDefinition(ByVal macroName As String, ByVal macroDef As String)
        Dim stepTokens() As String
        Dim steps As New Collection
        Dim logs As Collection
        Dim i As Long
        Dim itemVal As Variant
        Dim ok As Boolean

        stepTokens = Split(macroDef, ";")
        For i = 0 To UBound(stepTokens)
            If Len(Trim$(stepTokens(i))) > 0 Then
                steps.Add Trim$(stepTokens(i))
            End If
        Next i

        ok = StudioController.RunMacroSequence(steps, logs)
        lblTableTitle.Caption = "Saved Macro Execution Log: [" & macroName & "]"
        lstRecords.Clear
        For Each itemVal In logs
            lstRecords.AddItem CStr(itemVal)
        Next itemVal
    End Sub

