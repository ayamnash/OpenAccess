    Public Function TruncateFile(ByVal filePath As String, ByVal newByteLength As LongLong) As Boolean Implements IPal.TruncateFile
        Dim hFile As LongPtr
        hFile = CreateFileW(StrPtr(filePath), &H80000000 Or &H40000000, 1 Or 2 Or 4, 0, 3, &H80, 0)
        If hFile = 0 Or hFile = -1 Then Exit Function
        Dim newPos As LongLong
        If SetFilePointerEx(hFile, newByteLength, newPos, 0) <> 0 Then
            If SetEndOfFile(hFile) <> 0 Then
                FlushFileBuffers hFile
                TruncateFile = True
            End If
        End If
        CloseHandle hFile

    End Function

    Public Function NormalizeCrLf(ByVal text As String) As String Implements IPal.NormalizeCrLf
        Dim s As String
        s = Replace$(text, vbCrLf, vbLf)
        s = Replace$(s, vbCr, vbLf)
        NormalizeCrLf = Replace$(s, vbLf, vbCrLf)

    End Function

    Public Function GetPlatformName() As String Implements IPal.GetPlatformName
        GetPlatformName = "WINDOWS"

    End Function
    ' =========================================================================
    ' IFileSystem Implementation
