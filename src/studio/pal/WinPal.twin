    Public Function ShowOpenFile(ByVal ownerHwnd As LongPtr, ByVal title As String, ByVal filter As String, Optional ByVal defaultExt As String = "") As String Implements IDialogs.ShowOpenFile
        Dim ofn As OPENFILENAMEW
        Dim filePath As String
        filePath = String$(1024, vbNullChar)
        Dim filterStr As String
        Dim titleStr As String
        Dim filterBytes() As Byte
        Dim titleBytes() As Byte
        Dim res As Long
        filterStr = filter
        If Len(filterStr) = 0 Then
            filterStr = "Access Databases (*.accdb;*.mdb)" & vbNullChar & "*.accdb;*.mdb" & vbNullChar & "All Files (*.*)" & vbNullChar & "*.*" & vbNullChar & vbNullChar
        ElseIf Right$(filterStr, 2) <> vbNullChar & vbNullChar Then
            filterStr = filterStr & vbNullChar & vbNullChar
        End If
        titleStr = title
        If Len(titleStr) = 0 Then titleStr = "Open Database"
        filterBytes = filterStr
        titleBytes = titleStr
        ofn.lStructSize = LenB(ofn)
        ofn.hwndOwner = ownerHwnd
        ofn.lpstrFilter = VarPtr(filterBytes(0))
        ofn.nFilterIndex = 1
        ofn.lpstrFile = StrPtr(filePath)
        ofn.nMaxFile = 1024
        ofn.lpstrTitle = VarPtr(titleBytes(0))
        ofn.Flags = OFN_FILEMUSTEXIST Or OFN_PATHMUSTEXIST Or OFN_HIDEREADONLY
        res = GetOpenFileNameW(ofn)
        If res <> 0 Then
            Dim nullPos As Long
            nullPos = InStr(filePath, vbNullChar)
            If nullPos > 0 Then
                ShowOpenFile = Trim$(Left$(filePath, nullPos - 1))
            Else
                ShowOpenFile = Trim$(filePath)
            End If
        Else
            ShowOpenFile = vbNullString
        End If

    End Function

    Public Function ShowSaveFile(ByVal ownerHwnd As LongPtr, ByVal title As String, ByVal filter As String, Optional ByVal defaultExt As String = "") As String Implements IDialogs.ShowSaveFile
        Dim ofn As OPENFILENAMEW
        Dim filePath As String
        filePath = String$(1024, vbNullChar)
        Dim filterStr As String
        Dim titleStr As String
        Dim defExtStr As String
        Dim filterBytes() As Byte
        Dim titleBytes() As Byte
        Dim defExtBytes() As Byte
        Dim res As Long
        filterStr = filter
        If Len(filterStr) = 0 Then
            filterStr = "Access Database (*.accdb)" & vbNullChar & "*.accdb" & vbNullChar & "Jet Database (*.mdb)" & vbNullChar & "*.mdb" & vbNullChar & vbNullChar
        ElseIf Right$(filterStr, 2) <> vbNullChar & vbNullChar Then
            filterStr = filterStr & vbNullChar & vbNullChar
        End If
        titleStr = title
        If Len(titleStr) = 0 Then titleStr = "Save Database"
        defExtStr = defaultExt
        If Len(defExtStr) = 0 Then defExtStr = "accdb"
        filterBytes = filterStr
        titleBytes = titleStr
        defExtBytes = defExtStr & vbNullChar
        ofn.lStructSize = LenB(ofn)
        ofn.hwndOwner = ownerHwnd
        ofn.lpstrFilter = VarPtr(filterBytes(0))
        ofn.nFilterIndex = 1
        ofn.lpstrFile = StrPtr(filePath)
        ofn.nMaxFile = 1024
        ofn.lpstrTitle = VarPtr(titleBytes(0))
        ofn.lpstrDefExt = VarPtr(defExtBytes(0))
        ofn.Flags = OFN_PATHMUSTEXIST Or OFN_OVERWRITEPROMPT Or OFN_HIDEREADONLY
        res = GetSaveFileNameW(ofn)
        If res <> 0 Then
            Dim nullPos As Long
            nullPos = InStr(filePath, vbNullChar)
            If nullPos > 0 Then
                ShowSaveFile = Trim$(Left$(filePath, nullPos - 1))
            Else
                ShowSaveFile = Trim$(filePath)
            End If
        Else
            ShowSaveFile = vbNullString
        End If

    End Function

    Public Function ShowMessage(ByVal prompt As String, Optional ByVal buttons As Long = 0, Optional ByVal title As String = "") As Long Implements IDialogs.ShowMessage
        ShowMessage = MsgBox(prompt, buttons, title)

    End Function

    Public Function ShowInput(ByVal prompt As String, Optional ByVal title As String = "", Optional ByVal defaultVal As String = "") As String Implements IDialogs.ShowInput
        ShowInput = InputBox(prompt, title, defaultVal)

    End Function
    ' =========================================================================
    ' IClipboard Implementation
    ' =========================================================================

    Public Function GetText() As String Implements IClipboard.GetText
        On Error Resume Next
        GetText = Clipboard.GetText()
        On Error GoTo 0

    End Function

    Public Function SetText(ByVal text As String) As Boolean Implements IClipboard.SetText
        On Error Resume Next
        Clipboard.Clear
        Clipboard.SetText text
        SetText = (Err.Number = 0)
        On Error GoTo 0

    End Function

    Public Function Clear() As Boolean Implements IClipboard.Clear
        On Error Resume Next
        Clipboard.Clear
        Clear = (Err.Number = 0)
        On Error GoTo 0

    End Function
    ' =========================================================================
    ' IShell Implementation
    ' =========================================================================

    Public Function OpenUrl(ByVal url As String) As Boolean Implements IShell.OpenUrl
        If Len(url) = 0 Then Exit Function
        Dim res As LongPtr
        Dim opBytes() As Byte
        Dim urlBytes() As Byte
        opBytes = "open" & vbNullChar
        urlBytes = url & vbNullChar
        res = ShellExecuteW(0, VarPtr(opBytes(0)), VarPtr(urlBytes(0)), 0, 0, 1)
        OpenUrl = (res > 32)

    End Function

    Public Function Execute(ByVal command As String, Optional ByVal parameters As String = "", Optional ByVal workingDir As String = "") As LongPtr Implements IShell.Execute
        If Len(command) = 0 Then Exit Function
        Dim opBytes() As Byte
        Dim cmdBytes() As Byte
        Dim paramBytes() As Byte
        Dim dirBytes() As Byte
        opBytes = "open" & vbNullChar
        cmdBytes = command & vbNullChar
        paramBytes = parameters & vbNullChar
        dirBytes = workingDir & vbNullChar
        Dim res As LongPtr
        res = ShellExecuteW(0, VarPtr(opBytes(0)), VarPtr(cmdBytes(0)), IIf(Len(parameters) > 0, VarPtr(paramBytes(0)), 0), IIf(Len(workingDir) > 0, VarPtr(dirBytes(0)), 0), 1)
        Execute = res

    End Function
    ' =========================================================================
    ' IFonts Implementation
    ' =========================================================================

    Public Function GetCodeFont() As String Implements IFonts.GetCodeFont
        GetCodeFont = "Consolas"

    End Function

    Public Function GetUiFont() As String Implements IFonts.GetUiFont
        GetUiFont = "Segoe UI"

    End Function

    Public Function GetArabicFont() As String Implements IFonts.GetArabicFont
        GetArabicFont = "Segoe UI"

    End Function

    Public Function GetDefaultFontSize() As Single Implements IFonts.GetDefaultFontSize
        GetDefaultFontSize = 9.0!

    End Function
     ' =========================================================================
    ' IDynamicCall Implementation
    ' =========================================================================

    Public Sub SetUserApproved(ByVal approved As Boolean) Implements IDynamicCall.SetUserApproved
        m_dynamicUserApproved = approved

    End Sub

    Public Sub AddAllowed(ByVal dllName As String, ByVal procName As String) Implements IDynamicCall.AddAllowed
        If m_dynamicAllowed Is Nothing Then
            Set m_dynamicAllowed = CreateDictionary()
        End If
        Dim key As String
        key = LCase$(GetFileName(dllName)) & "!" & LCase$(procName)
        If Not m_dynamicAllowed.Exists(key) Then
            m_dynamicAllowed.Add key, True
        End If

    End Sub

    Public Function IsCallAllowed(ByVal dllName As String, ByVal procName As String) As Boolean Implements IDynamicCall.IsCallAllowed
        If m_dynamicUserApproved Then
            IsCallAllowed = True
            Exit Function
        End If
        Dim dllLower As String
        Dim procLower As String
        dllLower = LCase$(GetFileName(dllName))
        procLower = LCase$(procName)
        If Not m_dynamicAllowed Is Nothing Then
            Dim key As String
            key = dllLower & "!" & procLower
            If m_dynamicAllowed.Exists(key) Then
                IsCallAllowed = True
                Exit Function
            End If
        End If
        Select Case dllLower
            Case "kernel32.dll", "kernel32"
                Select Case procLower
                    Case "sleep", "gettickcount", "gettickcount64", "getsystemtime", "getlocaltime", "beep"
                        IsCallAllowed = True
                        Exit Function
                End Select
            Case "user32.dll", "user32"
                Select Case procLower
                    Case "messagebox", "messageboxw", "messageboxa", "getsystemmetrics", "getcursorpos", _
                         "findwindowex", "findwindowexa", "findwindowexw", "getfocus", "getwindow", _
                         "getwindowlong", "getwindowlonga", "getwindowlongw", "setwindowlong", _
                         "setwindowlonga", "setwindowlongw", "showwindow", "setactivewindow", _
                         "setforegroundwindow", "invalidaterect", "vkkeyscan", "vkkeyscana", _
                         "vkkeyscanw", "apisetfocus", "keybd_event"
                        IsCallAllowed = True
                        Exit Function
                End Select
            Case "ole32.dll", "ole32"
                Select Case procLower
                    Case "cocreateguid"
                        IsCallAllowed = True
                        Exit Function
                End Select
            Case "advapi32.dll", "advapi32"
                Select Case procLower
                    Case "regopenkeyex", "regopenkeyexa", "regopenkeyexw", _
                         "regqueryvalueex", "regqueryvalueexa", "regqueryvalueexw", _
                         "regclosekey", "regqueryvalueexlong", "regqueryvalueexnull"
                        IsCallAllowed = True
                        Exit Function
                End Select
        End Select
        IsCallAllowed = False

    End Function

    Public Function CallProcedure(ByVal dllName As String, ByVal procName As String, ByRef args() As Variant, ByVal returnType As Integer) As Variant Implements IDynamicCall.CallProcedure
        If InStr(dllName, "\") > 0 Or InStr(dllName, "/") > 0 Then
            Err.Raise 453, "WinPal.CallProcedure", "Calling procedure failed: DLL path separators are prohibited."
            Exit Function
        End If
        If Not IsCallAllowed(dllName, procName) Then
            Err.Raise 453, "WinPal.CallProcedure", "Calling procedure '" & procName & "' in '" & dllName & "' is restricted by security policy."
            Exit Function
        End If
        Dim procLower As String
        procLower = LCase$(Trim$(procName))
        Select Case procLower
            Case "sleep"
                If UBound(args) >= LBound(args) Then
                    Sleep CLng(args(LBound(args)))
                End If
                CallProcedure = Empty
                Exit Function
            Case "gettickcount", "gettickcount64"
                CallProcedure = CLng(GetTickCount())
                Exit Function
            Case "beep"
                If (UBound(args) - LBound(args) + 1) >= 2 Then
                    CallProcedure = CLng(BeepAPI(CLng(args(LBound(args))), CLng(args(LBound(args) + 1))))
                Else
                    CallProcedure = CLng(BeepAPI(800, 200))
                End If
                Exit Function
            Case "getsystemmetrics"
                If UBound(args) >= LBound(args) Then
                    CallProcedure = CLng(GetSystemMetrics(CLng(args(LBound(args)))))
                Else
                    CallProcedure = 0&
                End If
                Exit Function
            Case "messagebox", "messageboxa", "messageboxw"
                Dim msgText As String
                Dim msgTitle As String
                Dim msgFlags As Long
                msgTitle = "OpenAccess Studio"
                msgFlags = 0
                If UBound(args) >= LBound(args) Then msgText = CStr(args(LBound(args)))
                If UBound(args) >= LBound(args) + 1 Then msgTitle = CStr(args(LBound(args) + 1))
                If UBound(args) >= LBound(args) + 2 Then msgFlags = CLng(args(LBound(args) + 2))
                CallProcedure = PalManager.Dialogs.ShowMessage(msgText, msgTitle, msgFlags)
                Exit Function
        End Select
        Dim fullDll As String
        fullDll = GetFileName(dllName)
        If InStr(fullDll, ".") = 0 Then fullDll = fullDll & ".dll"
        Dim hMod As LongPtr
        hMod = LoadLibraryW(StrPtr(fullDll))
        If hMod = 0 Then
            Err.Raise 453, "WinPal.CallProcedure", "Specified DLL could not be loaded: " & dllName
            Exit Function
        End If
        Dim pProc As LongPtr
        pProc = GetProcAddress(hMod, procName)
        If pProc = 0 Then
            pProc = GetProcAddress(hMod, procName & "W")
            If pProc = 0 Then
                pProc = GetProcAddress(hMod, procName & "A")
            End If
        End If
        If pProc = 0 Then
            FreeLibrary hMod
            Err.Raise 453, "WinPal.CallProcedure", "Specified procedure not found in DLL: " & procName
            Exit Function
        End If
        Dim numArgs As Long
        numArgs = UBound(args) - LBound(args) + 1
        Dim vResult As Variant
        Dim hr As Long
        If numArgs <= 0 Then
            hr = DispCallFunc(0, pProc, 4, returnType, 0, 0, 0, VarPtr(vResult))
        Else
            Dim vTypes() As Integer
            ReDim vTypes(0 To numArgs - 1)
            #If Win64 Then
                Dim pArgs() As LongPtr
                ReDim pArgs(0 To numArgs - 1)
            #Else
                Dim pArgs() As Long
                ReDim pArgs(0 To numArgs - 1)
            #End If
            Dim i As Long
            For i = 0 To numArgs - 1
                vTypes(i) = VarType(args(LBound(args) + i))
                pArgs(i) = VarPtr(args(LBound(args) + i))
            Next i
            hr = DispCallFunc(0, pProc, 4, returnType, numArgs, VarPtr(vTypes(0)), VarPtr(pArgs(0)), VarPtr(vResult))
        End If
        FreeLibrary hMod
        If hr = 0 Then
            CallProcedure = vResult
        Else
            Select Case returnType
                Case vbLong
                    CallProcedure = 0&
                Case vbBoolean
                    CallProcedure = True
                Case vbString
                    CallProcedure = ""
                Case Else
                    CallProcedure = Empty
            End Select
        End If

    End Function

End Class
