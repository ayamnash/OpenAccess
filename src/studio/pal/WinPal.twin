    Public Function PathSeparator() As String Implements IFileSystem.PathSeparator
        PathSeparator = "\"

    End Function

    Public Function Combine(ByVal path1 As String, ByVal path2 As String) As String Implements IFileSystem.Combine
        Dim p1 As String
        Dim p2 As String
        p1 = Trim$(path1)
        p2 = Trim$(path2)
        If Len(p1) = 0 Then
            Combine = p2
            Exit Function
        End If
        If Len(p2) = 0 Then
            Combine = p1
            Exit Function
        End If
        ' If p2 is an absolute path (drive rooted or UNC), return p2
        If Len(p2) >= 2 Then
            If Mid$(p2, 2, 1) = ":" Then
                Combine = p2
                Exit Function
            End If
            If Left$(p2, 2) = "\\" Or Left$(p2, 2) = "//" Then
                Combine = p2
                Exit Function
            End If
        End If
        ' Preserve root UNC "\\"
        If p1 = "\\" Or p1 = "//" Then
            Do While Left$(p2, 1) = "\" Or Left$(p2, 1) = "/"
                p2 = Mid$(p2, 2)
            Loop
            Combine = "\\" & p2
            Exit Function
        End If
        ' Preserve drive root "C:\"
        If Len(p1) = 2 And Mid$(p1, 2, 1) = ":" Then
            Do While Left$(p2, 1) = "\" Or Left$(p2, 1) = "/"
                p2 = Mid$(p2, 2)
            Loop
            Combine = p1 & "\" & p2
            Exit Function
        End If
        Do While Right$(p1, 1) = "\" Or Right$(p1, 1) = "/"
            If Len(p1) <= 1 Then Exit Do
            If Len(p1) = 3 And Mid$(p1, 2, 1) = ":" Then Exit Do
            p1 = Left$(p1, Len(p1) - 1)
        Loop
        Do While Left$(p2, 1) = "\" Or Left$(p2, 1) = "/"
            p2 = Mid$(p2, 2)
        Loop
        If Right$(p1, 1) = "\" Or Right$(p1, 1) = "/" Then
            Combine = p1 & p2
        Else
            Combine = p1 & "\" & p2
        End If

    End Function

    Public Function FileExists(ByVal filePath As String) As Boolean Implements IFileSystem.FileExists
        If Len(filePath) = 0 Then Exit Function
        Dim attr As Long
        attr = GetFileAttributesW(StrPtr(filePath))
        If attr = INVALID_FILE_ATTRIBUTES Then Exit Function
        FileExists = ((attr And FILE_ATTRIBUTE_DIRECTORY) = 0)

    End Function

    Public Function FolderExists(ByVal folderPath As String) As Boolean Implements IFileSystem.FolderExists
        If Len(folderPath) = 0 Then Exit Function
        Dim attr As Long
        attr = GetFileAttributesW(StrPtr(folderPath))
        If attr = INVALID_FILE_ATTRIBUTES Then Exit Function
        FolderExists = ((attr And FILE_ATTRIBUTE_DIRECTORY) <> 0)

    End Function

    Public Function CopyFile(ByVal sourcePath As String, ByVal destPath As String, Optional ByVal overwrite As Boolean = True) As Boolean Implements IFileSystem.CopyFile
        If Len(sourcePath) = 0 Or Len(destPath) = 0 Then Exit Function
        Dim failIfExists As Long
        failIfExists = IIf(overwrite, 0&, 1&)
        CopyFile = (CopyFileW(StrPtr(sourcePath), StrPtr(destPath), failIfExists) <> 0)

    End Function

    Public Function DeleteFile(ByVal filePath As String) As Boolean Implements IFileSystem.DeleteFile
        If Len(filePath) = 0 Then Exit Function
        DeleteFile = (DeleteFileW(StrPtr(filePath)) <> 0)

    End Function

    Public Function CreateFolder(ByVal folderPath As String) As Boolean Implements IFileSystem.CreateFolder
        Dim p As String
        p = Trim$(folderPath)
        If Len(p) = 0 Then Exit Function
        If FolderExists(p) Then
            CreateFolder = True
            Exit Function
        End If
        ' Recursive creation: ensure parent folder exists
        Dim parent As String
        parent = GetDirectoryName(p)
        If Len(parent) > 0 And parent <> p And Not FolderExists(parent) Then
            CreateFolder parent
        End If
        CreateFolder = (CreateDirectoryW(StrPtr(p), 0) <> 0)

    End Function

    Public Function GetTempPath() As String Implements IFileSystem.GetTempPath
        Dim buf As String
        buf = String$(MAX_PATH, vbNullChar)
        Dim cch As Long
        cch = GetTempPathW(MAX_PATH, StrPtr(buf))
        If cch > MAX_PATH Then
            buf = String$(cch + 1, vbNullChar)
            cch = GetTempPathW(cch + 1, StrPtr(buf))
        End If
        If cch > 0 Then
            GetTempPath = Left$(buf, cch)
        Else
            GetTempPath = Environ$("TEMP")
            If Len(GetTempPath) = 0 Then GetTempPath = "C:\Windows\Temp"
        End If

    End Function

    Public Function GetTempFileName(Optional ByVal prefix As String = "oas") As String Implements IFileSystem.GetTempFileName
        Dim tmpDir As String
        tmpDir = GetTempPath()
        Dim buf As String
        buf = String$(MAX_PATH, vbNullChar)
        Dim res As Long
        res = GetTempFileNameW(StrPtr(tmpDir), StrPtr(prefix), 0, StrPtr(buf))
        If res <> 0 Then
            Dim nullPos As Long
            nullPos = InStr(buf, vbNullChar)
            If nullPos > 0 Then
                GetTempFileName = Left$(buf, nullPos - 1)
            Else
                GetTempFileName = buf
            End If
        Else
            GetTempFileName = Combine(tmpDir, prefix & "_" & CStr(Timer) & ".tmp")
        End If

    End Function

    Public Function GetAppDataPath() As String Implements IFileSystem.GetAppDataPath
        Dim p As String
        p = Environ$("LOCALAPPDATA")
        If Len(p) = 0 Then p = Environ$("APPDATA")
        If Len(p) = 0 Then p = GetTempPath()
        GetAppDataPath = p

    End Function

    Public Function GetCachePath() As String Implements IFileSystem.GetCachePath
        Dim root As String
        root = GetAppDataPath()
        Dim cacheDir As String
        cacheDir = Combine(root, "OpenAccessStudio\Cache")
        If Not FolderExists(cacheDir) Then
            CreateFolder cacheDir
        End If
        GetCachePath = cacheDir

    End Function

    Public Function GetFileName(ByVal filePath As String) As String Implements IFileSystem.GetFileName
        Dim p As String
        p = Trim$(filePath)
        ' Strip trailing slashes so directory name is returned
        Do While Right$(p, 1) = "\" Or Right$(p, 1) = "/"
            If Len(p) <= 1 Then Exit Do
            If Len(p) = 3 And Mid$(p, 2, 1) = ":" Then Exit Do
            p = Left$(p, Len(p) - 1)
        Loop
        Dim pos1 As Long
        Dim pos2 As Long
        Dim maxPos As Long
        pos1 = InStrRev(p, "\")
        pos2 = InStrRev(p, "/")
        maxPos = IIf(pos1 > pos2, pos1, pos2)
        If maxPos > 0 Then
            GetFileName = Mid$(p, maxPos + 1)
        Else
            GetFileName = p
        End If

    End Function

    Public Function GetDirectoryName(ByVal filePath As String) As String Implements IFileSystem.GetDirectoryName
        Dim p As String
        p = Trim$(filePath)
        ' Strip trailing slash
        Do While Right$(p, 1) = "\" Or Right$(p, 1) = "/"
            If Len(p) <= 1 Then Exit Do
            If Len(p) = 3 And Mid$(p, 2, 1) = ":" Then Exit Do
            p = Left$(p, Len(p) - 1)
        Loop
        Dim pos1 As Long
        Dim pos2 As Long
        Dim maxPos As Long
        pos1 = InStrRev(p, "\")
        pos2 = InStrRev(p, "/")
        maxPos = IIf(pos1 > pos2, pos1, pos2)
        If maxPos > 1 Then
            ' Check if root drive like C:\
            If maxPos = 3 And Mid$(p, 2, 1) = ":" Then
                GetDirectoryName = Left$(p, 3)
            ' Check if UNC share root like \\server\share
            ElseIf Left$(p, 2) = "\\" And InStr(3, p, "\") = maxPos Then
                GetDirectoryName = p
            Else
                GetDirectoryName = Left$(p, maxPos - 1)
            End If
        ElseIf maxPos = 1 Then
            GetDirectoryName = Left$(p, 1)
        Else
            GetDirectoryName = vbNullString
        End If

    End Function

    Public Function GetExtension(ByVal filePath As String) As String Implements IFileSystem.GetExtension
        Dim fn As String
        fn = GetFileName(filePath)
        Dim dotPos As Long
        dotPos = InStrRev(fn, ".")
        ' If dot is the very first character (e.g. .gitignore), it has no extension
        If dotPos > 1 Then
            GetExtension = Mid$(fn, dotPos)
        Else
            GetExtension = vbNullString
        End If

    End Function

    Public Function IsLockFilePresent(ByVal dbPath As String) As Boolean Implements IFileSystem.IsLockFilePresent
        If Len(dbPath) = 0 Then Exit Function
        Dim dirPart As String
        Dim filePart As String
        Dim extPart As String
        dirPart = GetDirectoryName(dbPath)
        filePart = GetFileName(dbPath)
        extPart = LCase$(GetExtension(dbPath))
        Dim lockName As String
        Select Case extPart
            Case ".accdb", ".accde", ".accdr", ".accdt"
                lockName = Left$(filePart, Len(filePart) - Len(extPart)) & ".laccdb"
            Case ".mdb", ".mde"
                lockName = Left$(filePart, Len(filePart) - Len(extPart)) & ".ldb"
            Case Else
                lockName = filePart & ".lock"
        End Select
        Dim lockPath As String
        lockPath = Combine(dirPart, lockName)
        IsLockFilePresent = FileExists(lockPath)

    End Function

    Public Function LockFileRange(ByVal filePath As String, ByVal offsetBytes As LongLong, ByVal lengthBytes As LongLong, Optional ByVal exclusive As Boolean = True) As LongPtr Implements IFileSystem.LockFileRange
        Dim startPage As Long, pageCount As Long
        startPage = CLng(offsetBytes \ 4096^)
        pageCount = CLng((lengthBytes + 4095^) \ 4096^)
        If pageCount <= 0 Then pageCount = 1
        LockFileRange = PageWriter.LockPageRange(filePath, startPage, pageCount, exclusive)

    End Function

    Public Function UnlockFileRange(ByVal hFile As LongPtr, ByVal offsetBytes As LongLong, ByVal lengthBytes As LongLong) As Boolean Implements IFileSystem.UnlockFileRange
        Dim startPage As Long, pageCount As Long
        startPage = CLng(offsetBytes \ 4096^)
        pageCount = CLng((lengthBytes + 4095^) \ 4096^)
        If pageCount <= 0 Then pageCount = 1
        UnlockFileRange = PageWriter.UnlockPageRange(hFile, startPage, pageCount)

    End Function

    Public Function ReadAllText(ByVal filePath As String) As String Implements IFileSystem.ReadAllText
        If Not FileExists(filePath) Then Exit Function
        On Error Resume Next
        Dim fn As Integer
        fn = FreeFile
        Open filePath For Binary Access Read As #fn
        Dim flen As Long
        flen = LOF(fn)
        If flen > 0 Then
            Dim raw() As Byte
            ReDim raw(0 To flen - 1)
            Get #fn, , raw
            Close #fn
            ' Check for UTF-8 BOM (&HEF, &HBB, &HBF)
            Dim startIdx As Long
            startIdx = 0
            If flen >= 3 Then
                If raw(0) = &HEF& And raw(1) = &HBB& And raw(2) = &HBF& Then
                    startIdx = 3
                End If
            End If
            ' Check for UTF-16 LE BOM (&HFF, &HFE)
            If flen >= 2 And startIdx = 0 Then
                If raw(0) = &HFF& And raw(1) = &HFE& Then
                    Dim u16Len As Long
                    u16Len = (flen - 2) \ 2
                    Dim u16Str As String
                    u16Str = String$(u16Len, vbNullChar)
                    #If Win64 Then
                        Dim pSrc As LongPtr
                        Dim pDst As LongPtr
                        pSrc = VarPtr(raw(2))
                        pDst = StrPtr(u16Str)
                    #Else
                        Dim pSrc As Long
                        Dim pDst As Long
                        pSrc = VarPtr(raw(2))
                        pDst = StrPtr(u16Str)
                    #End If
                    ' Direct memory copy or assignment
                    ReadAllText = Mid$(CStr(raw), 2)
                    Exit Function
                End If
            End If
            ' Decode UTF-8 to UTF-16
            Dim dataLen As Long
            dataLen = flen - startIdx
            If dataLen > 0 Then
                Dim cchWide As Long
                cchWide = MultiByteToWideChar(CP_UTF8, 0, VarPtr(raw(startIdx)), dataLen, 0, 0)
                If cchWide > 0 Then
                    Dim outStr As String
                    outStr = String$(cchWide, vbNullChar)
                    MultiByteToWideChar CP_UTF8, 0, VarPtr(raw(startIdx)), dataLen, StrPtr(outStr), cchWide
                    ReadAllText = outStr
                Else
                    ' Fallback
                    ReadAllText = StrConv(raw, vbUnicode)
                End If
            Else
                ReadAllText = vbNullString
            End If
        Else
            Close #fn
            ReadAllText = vbNullString
        End If
        On Error GoTo 0

    End Function

    Public Function WriteAllText(ByVal filePath As String, ByVal content As String) As Boolean Implements IFileSystem.WriteAllText
        On Error Resume Next
        If FileExists(filePath) Then DeleteFile filePath
        Dim fn As Integer
        fn = FreeFile
        Open filePath For Binary Access Write As #fn
        If Len(content) > 0 Then
            Dim cchWide As Long
            cchWide = Len(content)
            Dim cbUtf8 As Long
            cbUtf8 = WideCharToMultiByte(CP_UTF8, 0, StrPtr(content), cchWide, 0, 0, 0, 0)
            If cbUtf8 > 0 Then
                Dim raw() As Byte
                ReDim raw(0 To cbUtf8 - 1)
                WideCharToMultiByte CP_UTF8, 0, StrPtr(content), cchWide, VarPtr(raw(0)), cbUtf8, 0, 0
                Put #fn, , raw
            End If
        End If
        Close #fn
        WriteAllText = (Err.Number = 0)
        On Error GoTo 0

    End Function
    ' =========================================================================
    ' ISettings Implementation
    ' =========================================================================

    Public Function GetValue(ByVal appName As String, ByVal section As String, ByVal key As String, Optional ByVal defaultValue As String = "") As String Implements ISettings.GetValue
        On Error Resume Next
        GetValue = GetSetting(appName, section, key, defaultValue)
        If Err.Number <> 0 Then GetValue = defaultValue
        On Error GoTo 0

    End Function

    Public Function SetValue(ByVal appName As String, ByVal section As String, ByVal key As String, ByVal value As String) As Boolean Implements ISettings.SetValue
        On Error Resume Next
        SaveSetting appName, section, key, value
        SetValue = (Err.Number = 0)
        On Error GoTo 0

    End Function

    Public Function DeleteValue(ByVal appName As String, ByVal section As String, Optional ByVal key As String = "") As Boolean Implements ISettings.DeleteValue
        On Error Resume Next
        If Len(key) > 0 Then
            DeleteSetting appName, section, key
        Else
            DeleteSetting appName, section
        End If
        DeleteValue = (Err.Number = 0)
        On Error GoTo 0

    End Function
