' File: src/com-compat/DaoEngine.twin
' Full Live Read/Write DAO-Compatible Engine in twinBASIC
Option Explicit
[ClassId("429ebb3b-f082-40cb-9dd5-c72256c8a6df")]
[InterfaceId("a26190e1-657c-4580-938d-b447e6ef5c99")]
[COMCreatable(True)]

Public Class DBEngine
    Private Const ENGINE_VERSION As String = "12.0"
    Private m_activeDb As Database
    Private m_workspaces As Workspaces

    Public Property Get Workspaces() As Workspaces
        If m_workspaces Is Nothing Then Set m_workspaces = New Workspaces
        Set Workspaces = m_workspaces
    End Property

        Public Function NormalizeArabicForComparison(ByVal s As String) As String
        NormalizeArabicForComparison = ArabicCollationHelper.NormalizeArabicForComparison(s)
    End Function

Public Property Get Version() As String
        Version = ENGINE_VERSION
    End Property

    Public Function OpenDatabase(ByVal Name As String, Optional ByVal Options As Variant, Optional ByVal ReadOnly As Variant, Optional ByVal Connect As Variant) As Database
        Dim probe As DatabaseProbeResult
        Dim dbObj As Database
        Dim reqReadOnly As Boolean

        If Len(Trim$(Name)) = 0 Then
            Err.Raise vbObjectError + 3024, "DBEngine.OpenDatabase", "Could not find file ''."
        End If
        PageWriter.RecoverHotJournalIfPresent Name
        probe = FormatProbe.ProbeDatabaseFile(Name)
        If probe.Status = EngineFormatStatus.FormatUnsupportedVersion Then
            Err.Raise vbObjectError + 3343, "DBEngine.OpenDatabase", "Unrecognized database format (" & probe.EngineName & "): " & probe.ErrorMessage
        ElseIf probe.Status = EngineFormatStatus.FormatMalformedError Then
            Err.Raise vbObjectError + 3024, "DBEngine.OpenDatabase", "Could not find file '" & Name & "' or file is corrupt: " & probe.ErrorMessage
        End If

        reqReadOnly = False
        If Not IsMissing(ReadOnly) And Not IsEmpty(ReadOnly) Then
            On Error Resume Next
            reqReadOnly = CBool(ReadOnly)
            On Error GoTo 0
        End If

        Set dbObj = New Database
        dbObj.Init Name, probe.EngineName, probe.TotalPages, reqReadOnly
        Set m_activeDb = dbObj
        Set OpenDatabase = dbObj
    End Function

    Public Function CreateDatabase(ByVal Name As String, Optional ByVal Connect As Variant, Optional ByVal Options As Variant) As Database
        Dim isAce As Boolean
        If Not IsMissing(Options) Then
            If IsNumeric(Options) Then
                If CLng(Options) = 64 Then
                    isAce = False
                ElseIf CLng(Options) >= 128 Then
                    isAce = True
                Else
                    isAce = (LCase$(Right$(Trim$(Name), 4)) <> ".mdb")
                End If
            Else
                isAce = (LCase$(Right$(Trim$(Name), 4)) <> ".mdb")
            End If
        Else
            isAce = (LCase$(Right$(Trim$(Name), 4)) <> ".mdb")
        End If

        Dim ok As Boolean
        ok = PageWriter.CreateBlankJet4Database(Name, isAce)
        If Not ok Then
            Err.Raise 3024, "DBEngine.CreateDatabase", "Could not find file / template: " & PageWriter.LastError
            Exit Function
        End If

        Dim openedDb As Database
        Set openedDb = Me.OpenDatabase(Name)
        Set m_activeDb = openedDb
        Set CreateDatabase = openedDb
    End Function

    Public Function CompactDatabase(ByVal SrcPath As String, ByVal DstPath As String, Optional ByVal DstConnect As Variant, Optional ByVal Options As Variant) As Boolean
        On Error GoTo CompactErr
        If StrComp(SrcPath, DstPath, vbTextCompare) = 0 Then
            Err.Raise vbObjectError + 3000, "DBEngine.CompactDatabase", "Destination path cannot be identical to source path."
        End If
        If Len(Dir$(DstPath)) > 0 Then
            Kill DstPath
        End If
        Dim srcDb As Database
        Set srcDb = Me.OpenDatabase(SrcPath, False, True)
        If srcDb Is Nothing Then Exit Function
        Dim dstDb As Database
        Set dstDb = Me.CreateDatabase(DstPath)
        If dstDb Is Nothing Then
            srcDb.Close
            Exit Function
        End If
        Dim tIdx As Long
        For tIdx = 0 To srcDb.TableDefs.Count - 1
            Dim srcTd As TableDef
            Set srcTd = srcDb.TableDefs(tIdx)
            Dim tName As String
            tName = srcTd.Name
            If Left$(tName, 4) <> "MSys" And Left$(tName, 1) <> "~" Then
                Dim ddlSql As String
                ddlSql = "CREATE TABLE [" & tName & "] ("
                Dim fIdx As Long
                For fIdx = 0 To srcTd.Fields.Count - 1
                    Dim fld As Field
                    Set fld = srcTd.Fields(fIdx)
                    If fIdx > 0 Then ddlSql = ddlSql & ", "
                    ddlSql = ddlSql & "[" & fld.Name & "] "
                    Select Case fld.Type
                        Case 1: ddlSql = ddlSql & "YESNO"
                        Case 2: ddlSql = ddlSql & "BYTE"
                        Case 3: ddlSql = ddlSql & "INTEGER"
                        Case 4: ddlSql = ddlSql & "LONG"
                        Case 5: ddlSql = ddlSql & "CURRENCY"
                        Case 6: ddlSql = ddlSql & "SINGLE"
                        Case 7: ddlSql = ddlSql & "DOUBLE"
                        Case 8: ddlSql = ddlSql & "DATETIME"
                        Case 9, 11: ddlSql = ddlSql & "LONGBINARY"
                        Case 10: ddlSql = ddlSql & "TEXT(" & CStr(fld.Size) & ")"
                        Case 12: ddlSql = ddlSql & "MEMO"
                        Case 15: ddlSql = ddlSql & "GUID"
                        Case Else: ddlSql = ddlSql & "TEXT"
                    End Select
                Next fIdx
                ddlSql = ddlSql & ")"
                dstDb.Execute ddlSql
                Dim srcRs As Recordset
                Set srcRs = srcDb.OpenRecordset(tName)
                Dim dstRs As Recordset
                Set dstRs = dstDb.OpenRecordset(tName)
                If srcRs.RecordCount > 0 Then
                    srcRs.MoveFirst
                    Do Until srcRs.EOF
                        dstRs.AddNew
                        For fIdx = 0 To srcTd.Fields.Count - 1
                            Dim val As Variant
                            val = srcRs.Fields(fIdx).Value
                            If Not IsNull(val) And Not IsEmpty(val) Then
                                dstRs.Fields(fIdx).Value = val
                            End If
                        Next fIdx
                        dstRs.Update
                        srcRs.MoveNext
                    Loop
                End If
                srcRs.Close
                dstRs.Close
            End If
        Next tIdx
        srcDb.Close
        dstDb.Close
        CompactDatabase = True
        Exit Function
CompactErr:
        If Not srcDb Is Nothing Then On Error Resume Next: srcDb.Close
        If Not dstDb Is Nothing Then On Error Resume Next: dstDb.Close
        CompactDatabase = False
    End Function

    Public Function VerifyAndRepairDatabase(ByVal dbPath As String, Optional ByRef outReport As String) As Long
        Dim dbObj As Database
        Set dbObj = Me.OpenDatabase(dbPath)
        If dbObj Is Nothing Then Exit Function
        VerifyAndRepairDatabase = dbObj.VerifyAndRepair(outReport)
        dbObj.Close
    End Function

    Public Sub BeginTrans()
        If m_activeDb Is Nothing Then
            Err.Raise vbObjectError + 3034, "DBEngine.BeginTrans", "No active database for transaction."
        End If
        m_activeDb.BeginTrans
    End Sub

    Public Sub CommitTrans()
        If m_activeDb Is Nothing Then
            Err.Raise vbObjectError + 3034, "DBEngine.CommitTrans", "No active database for transaction."
        End If
        m_activeDb.CommitTrans
    End Sub

    Public Sub Rollback()
        If m_activeDb Is Nothing Then
            Err.Raise vbObjectError + 3034, "DBEngine.Rollback", "No active database for transaction."
        End If
        m_activeDb.Rollback
    End Sub
End Class
[COMCreatable(False)]
Public Class Workspace
    Public Name As String

    Public Function CreateDatabase(ByVal Name As String, Optional ByVal Connect As Variant, Optional ByVal Options As Variant) As Database
        Dim isAce As Boolean
        If Not IsMissing(Options) Then
            If IsNumeric(Options) Then
                If CLng(Options) = 64 Then
                    isAce = False
                ElseIf CLng(Options) >= 128 Then
                    isAce = True
                Else
                    isAce = (LCase$(Right$(Trim$(Name), 4)) <> ".mdb")
                End If
            Else
                isAce = (LCase$(Right$(Trim$(Name), 4)) <> ".mdb")
            End If
        Else
            isAce = (LCase$(Right$(Trim$(Name), 4)) <> ".mdb")
        End If

        Dim ok As Boolean
        ok = PageWriter.CreateBlankJet4Database(Name, isAce)
        If Not ok Then
            Err.Raise 3024, "Workspace.CreateDatabase", "Could not find file / template: " & PageWriter.LastError
            Exit Function
        End If

        Dim dbe As New DBEngine
        Set CreateDatabase = dbe.OpenDatabase(Name)
    End Function

    Public Function OpenDatabase(ByVal Name As String, Optional ByVal Options As Variant, Optional ByVal ReadOnly As Variant, Optional ByVal Connect As Variant) As Database
        Dim dbe As New DBEngine
        Set OpenDatabase = dbe.OpenDatabase(Name, Options, ReadOnly, Connect)
    End Function

    Public Sub BeginTrans()
        Dim dbe As New DBEngine
        dbe.BeginTrans
    End Sub

    Public Sub CommitTrans()
        Dim dbe As New DBEngine
        dbe.CommitTrans
    End Sub

    Public Sub Rollback()
        Dim dbe As New DBEngine
        dbe.Rollback
    End Sub
End Class

[COMCreatable(False)]
Public Class Workspaces
    Private m_items As New Collection

    Public Sub Class_Initialize()
        Dim defaultWs As New Workspace
        defaultWs.Name = "#Default Workspace#"
        m_items.Add defaultWs, "0"
    End Sub

    Public Property Get Count() As Long
        Count = m_items.Count
    End Property

    [DefaultMember]
    Public Property Get Item(ByVal Index As Variant) As Workspace
        If IsNumeric(Index) Then
            Set Item = m_items(CLng(Index) + 1)
        Else
            Set Item = m_items(CStr(Index))
        End If
    End Property
End Class

[ClassId("06ad7b3b-549b-4451-bea5-9cf6cea1890e")]
[InterfaceId("7c0d076b-d791-4f24-8750-10e044dbdc8b")]
[COMCreatable(False)]

Public Class Document
    Public Name As String
End Class

Public Class Documents
    Private m_items As New Collection

    Public Property Get Count() As Long
        Count = m_items.Count
    End Property
    [DefaultMember]

    Public Property Get Item(ByVal IndexOrName As Variant) As Document
        If VarType(IndexOrName) = vbString Then
            On Error Resume Next
            Set Item = m_items(UCase$(CStr(IndexOrName)))
            On Error GoTo 0
        Else
            Dim idx As Long
            idx = CLng(IndexOrName)
            If idx >= 0 And idx < m_items.Count Then
                Set Item = m_items(idx + 1)
            End If
        End If
    End Property

    Friend Sub AddDocument(ByVal doc As Document)
        On Error Resume Next
        m_items.Add doc, UCase$(doc.Name)
        On Error GoTo 0
    End Sub
End Class

Public Class Container
    Public Name As String
    Public Documents As New Documents
End Class

Public Class Containers
    Private m_items As New Collection

    Public Property Get Count() As Long
        Count = m_items.Count
    End Property
    [DefaultMember]

    Public Property Get Item(ByVal IndexOrName As Variant) As Container
        If VarType(IndexOrName) = vbString Then
            On Error Resume Next
            Set Item = m_items(UCase$(CStr(IndexOrName)))
            On Error GoTo 0
        Else
            Dim idx As Long
            idx = CLng(IndexOrName)
            If idx >= 0 And idx < m_items.Count Then
                Set Item = m_items(idx + 1)
            End If
        End If
    End Property

    Friend Sub AddContainer(ByVal cont As Container)
        On Error Resume Next
        m_items.Add cont, UCase$(cont.Name)
        On Error GoTo 0
    End Sub
End Class

Public Class Database
    Private m_name As String
    Private m_version As String
    Private m_totalPages As Long
    Private m_isOpen As Boolean
    Private m_fileNum As Integer
    Private m_tableDefs As TableDefs
    Private m_queryDefs As New QueryDefs
    Private m_relations As New Relations
    Private m_containers As New Containers
    Private m_recordsAffected As Long
    Private m_formParams As New Collection
    Private m_backendDbs As New Collection
    Private m_lastFileLen As LongLong
    Private m_lastFileTime As Date
    Private m_isCompiledLocked As Boolean
    Private m_isReadOnly As Boolean

    Public Property Get IsCompiledLocked() As Boolean
        IsCompiledLocked = m_isCompiledLocked
    End Property

    Public Property Get Updatable() As Boolean
        Updatable = (Not m_isReadOnly) And (Not m_isCompiledLocked)
    End Property

    Public Property Get ReadOnly() As Boolean
        ReadOnly = m_isReadOnly
    End Property

    Friend Sub EnsureWritable(ByVal memberName As String)
        EnsureOpen memberName
        If m_isReadOnly Then
            Err.Raise 3027, "Database." & memberName, "Cannot update. Database or object is read-only."
        End If
    End Sub

    Public Property Let IsCompiledLocked(ByVal value As Boolean)
        m_isCompiledLocked = value
    End Property

    Public Sub SetFormParameter(ByVal key As String, ByVal paramVal As Variant)
        Dim k As String
        k = NormalizeFormParamKey(key)
        On Error Resume Next
        m_formParams.Remove k
        On Error GoTo 0
        m_formParams.Add paramVal, k
        Dim bangPos As Long
        bangPos = InStrRev(k, "!")
        If bangPos > 0 Then
            Dim shortKey As String
            shortKey = Mid$(k, bangPos + 1)
            On Error Resume Next
            m_formParams.Remove shortKey
            m_formParams.Add paramVal, shortKey
            On Error GoTo 0
        End If
    End Sub

    Public Sub ClearFormParameters()
        Set m_formParams = New Collection
    End Sub

    Public Function GetFormParameter(ByVal key As String, ByRef outFound As Boolean) As Variant
        Dim k As String
        k = NormalizeFormParamKey(key)
        outFound = False
        On Error Resume Next
        GetFormParameter = m_formParams(k)
        If Err.Number = 0 Then outFound = True
        On Error GoTo 0
    End Function

    Private Function NormalizeFormParamKey(ByVal s As String) As String
        Dim res As String
        res = Trim$(s)
        res = Replace$(res, "[", "")
        res = Replace$(res, "]", "")
        res = Replace$(res, "PARENT.", "PARENT!", , , vbTextCompare)
        res = Replace$(res, "Forms.", "FORMS!", , , vbTextCompare)
        res = Replace$(res, "Form.", "FORM!", , , vbTextCompare)
        NormalizeFormParamKey = UCase$(Trim$(res))
    End Function

    Public Function EvaluateExpression(ByVal expr As String, Optional ByVal contextRs As Recordset = Nothing) As Variant
        Dim s As String
        s = Trim$(expr)
        If Left$(s, 1) = "=" Then s = Trim$(Mid$(s, 2))
        If Len(s) = 0 Then
            EvaluateExpression = Null
            Exit Function
        End If
        Dim uExpr As String
        uExpr = UCase$(s)
        If InStr(1, uExpr, "SUM(") > 0 Or InStr(1, uExpr, "COUNT(") > 0 Or InStr(1, uExpr, "AVG(") > 0 Or InStr(1, uExpr, "MIN(") > 0 Or InStr(1, uExpr, "MAX(") > 0 Then
            If Not contextRs Is Nothing Then
                EvaluateExpression = ComputeAggregateColumn(contextRs, "EXPR_AGG", s)
            Else
                EvaluateExpression = Null
            End If
        Else
            EvaluateExpression = EvaluateRowExpr(s, contextRs)
        End If
    End Function

    Public Function DLookup(ByVal expr As String, ByVal domain As String, Optional ByVal criteria As String = "") As Variant
        DLookup = DomainAggregateHelper("LOOKUP", expr, domain, criteria)
    End Function

    Public Function DSum(ByVal expr As String, ByVal domain As String, Optional ByVal criteria As String = "") As Variant
        DSum = DomainAggregateHelper("SUM", expr, domain, criteria)
    End Function

    Public Function DCount(ByVal expr As String, ByVal domain As String, Optional ByVal criteria As String = "") As Variant
        DCount = DomainAggregateHelper("COUNT", expr, domain, criteria)
    End Function

    Public Function DMin(ByVal expr As String, ByVal domain As String, Optional ByVal criteria As String = "") As Variant
        DMin = DomainAggregateHelper("MIN", expr, domain, criteria)
    End Function

    Public Function DMax(ByVal expr As String, ByVal domain As String, Optional ByVal criteria As String = "") As Variant
        DMax = DomainAggregateHelper("MAX", expr, domain, criteria)
    End Function

    Private Function DomainAggregateHelper(ByVal aggKind As String, ByVal expr As String, ByVal domain As String, ByVal criteria As String) As Variant
        On Error Resume Next
        Dim cleanDom As String
        cleanDom = CleanSqlColName(domain)
        If Len(cleanDom) = 0 Then
            If aggKind = "COUNT" Then DomainAggregateHelper = 0& Else DomainAggregateHelper = Null
            Exit Function
        End If
        Dim sql As String
        sql = "SELECT * FROM [" & cleanDom & "]"
        If Len(Trim$(criteria)) > 0 Then
            sql = sql & " WHERE " & criteria
        End If
        Dim rs As Recordset
        Set rs = Me.OpenRecordset(sql)
        If Err.Number <> 0 Or rs Is Nothing Then
            Err.Clear
            On Error GoTo 0
            If aggKind = "COUNT" Then DomainAggregateHelper = 0& Else DomainAggregateHelper = Null
            Exit Function
        End If
        If rs.EOF Or rs.RecordCount = 0 Then
            rs.Close
            On Error GoTo 0
            If aggKind = "COUNT" Then DomainAggregateHelper = 0& Else DomainAggregateHelper = Null
            Exit Function
        End If
        rs.MoveFirst
        Dim cleanExpr As String
        cleanExpr = Trim$(expr)
        If cleanExpr <> "*" Then
            Dim cleanColName As String
            cleanColName = CleanSqlColName(cleanExpr)
            Dim fldFound As Boolean
            fldFound = False
            Dim fi As Long
            For fi = 0 To rs.Fields.Count - 1
                If StrComp(rs.Fields(fi).Name, cleanColName, vbTextCompare) = 0 Then
                    fldFound = True
                    Exit For
                End If
            Next fi
            If Not fldFound Then
                rs.Close
                On Error GoTo 0
                Err.Raise vbObjectError + 3265, "Database." & aggKind, "Item not found in this collection: '" & cleanExpr & "' in domain '" & domain & "'."
            End If
        End If
        If aggKind = "LOOKUP" Then
            Dim cleanCol As String
            cleanCol = CleanSqlColName(cleanExpr)
            Dim lkVal As Variant
            Err.Clear
            lkVal = rs.Fields(cleanCol).Value
            If Err.Number <> 0 Then
                Err.Clear
                lkVal = EvaluateRowExpr(cleanExpr, rs)
            End If
            DomainAggregateHelper = lkVal
        ElseIf aggKind = "COUNT" And cleanExpr = "*" Then
            DomainAggregateHelper = rs.RecordCount
        Else
            DomainAggregateHelper = ComputeAggregateColumn(rs, aggKind, cleanExpr)
        End If
        rs.Close
        On Error GoTo 0
    End Function

    Friend Sub Init(ByVal dbPath As String, ByVal engineVer As String, ByVal totalPages As Long, Optional ByVal requestReadOnly As Boolean = False)
        Dim contForms As Container
        Dim contReports As Container
        Dim contModules As Container
        Dim contScripts As Container
        Dim extLock As String
        Dim dotPosLock As Long
        Dim openReadOnly As Boolean

        m_name = dbPath
        m_version = engineVer
        m_totalPages = totalPages
        m_isReadOnly = False
        m_fileNum = FreeFile()

        openReadOnly = requestReadOnly Or PageWriter.IsAccessLockFileActive(dbPath)

        If openReadOnly Then
            Open dbPath For Binary Access Read Shared As #m_fileNum
            m_isReadOnly = True
        Else
            On Error Resume Next
            Open dbPath For Binary Access Read Write Shared As #m_fileNum
            If Err.Number <> 0 Then
                Err.Clear
                Open dbPath For Binary Access Read Shared As #m_fileNum
                m_isReadOnly = True
            End If
            On Error GoTo 0
        End If
        m_isOpen = True
        PageWriter.RegisterDatabaseHandle m_fileNum, dbPath
        CatalogReader.InvalidatePageDirectory
        CatalogReader.EnsurePageDirectory m_fileNum, m_totalPages

        Set contForms = New Container
        contForms.Name = "Forms"
        m_containers.AddContainer contForms

        Set contReports = New Container
        contReports.Name = "Reports"
        m_containers.AddContainer contReports

        Set contModules = New Container
        contModules.Name = "Modules"
        m_containers.AddContainer contModules

        Set contScripts = New Container
        contScripts.Name = "Scripts"
        m_containers.AddContainer contScripts

        On Error Resume Next
        m_lastFileLen = FileLen(dbPath)
        m_lastFileTime = FileDateTime(dbPath)
        On Error GoTo 0
        m_relations.Init Me
        m_queryDefs.Init Me
        Set m_tableDefs = New TableDefs
        m_tableDefs.Init Me, m_fileNum, m_totalPages
        Me.EnsureTableCatalogAndACEs 0

        dotPosLock = InStrRev(dbPath, ".")
        If dotPosLock > 0 Then extLock = LCase$(Mid$(dbPath, dotPosLock))
        If extLock = ".accde" Or extLock = ".mde" Then
            m_isCompiledLocked = True
        End If
    End Sub

    Friend Property Get FileNumber() As Integer
        FileNumber = m_fileNum
    End Property

    Friend Property Get TotalPages() As Long
        TotalPages = m_totalPages
    End Property

    Friend Property Let TotalPages(ByVal newTotal As Long)
        m_totalPages = newTotal
    End Property

    Friend Property Get IsOpen() As Boolean
        IsOpen = m_isOpen
    End Property

    Public Property Get Name() As String
        EnsureOpen "Name"
        Name = m_name
    End Property

    Public Property Get Version() As String
        EnsureOpen "Version"
        Version = m_version
    End Property

    Public Property Get TableDefs() As TableDefs
        EnsureOpen "TableDefs"
        Set TableDefs = m_tableDefs
    End Property

    Public Property Get QueryDefs() As QueryDefs
        EnsureOpen "QueryDefs"
        Set QueryDefs = m_queryDefs
    End Property

    Public Property Get Relations() As Relations
        EnsureOpen "Relations"
        Set Relations = m_relations
    End Property

    Public Property Get Containers() As Containers
        EnsureOpen "Containers"
        Set Containers = m_containers
    End Property

    Public Property Get RecordsAffected() As Long
        RecordsAffected = m_recordsAffected
    End Property

    Public Sub BeginTrans()
        EnsureOpen "BeginTrans"
        PageWriter.BeginTransaction m_fileNum, m_name, m_totalPages
    End Sub

    Public Sub CommitTrans()
        EnsureOpen "CommitTrans"
        PageWriter.CommitTransaction
    End Sub

    Public Sub Rollback()
        EnsureOpen "Rollback"
        Dim restoredTotalPages As Long
        PageWriter.RollbackTransaction restoredTotalPages
        m_totalPages = restoredTotalPages
        CatalogReader.InvalidatePageDirectory
        CatalogReader.EnsurePageDirectory m_fileNum, m_totalPages
        Set m_tableDefs = New TableDefs
        m_tableDefs.Init Me, m_fileNum, m_totalPages
    End Sub

    Friend Sub PersistNewTableDef(ByRef desc As TableDefDescriptor)
        Dim msysDesc As TableDefDescriptor
        Dim sysVals() As Variant
        Dim cIdx As Long
        Dim outPg As Long
        Dim outSl As Integer
        Dim tablesParentId As Long
        Dim msysTd As TableDef
        Dim rsObj As Recordset
        Dim rName As String
        Dim rType As Long

        If desc.TdefPageNumber > 0 Then Exit Sub
        If desc.ColumnCount <= 0 Then Exit Sub
        If Left$(desc.TableName, 4) <> "MSys" And Left$(desc.TableName, 12) <> "_OpenAccess_" Then
            If Me.HasTableName(desc.TableName) Then
                Err.Raise 3010, "Microsoft Access", "Table '" & desc.TableName & "' already exists."
            End If
            If Me.HasQueryName(desc.TableName) Then
                Err.Raise 3012, "Microsoft Access", "You can't give a table and a query the same name ('" & desc.TableName & "')."
            End If
        End If
        RecordWriter.CreateTableTdefPage m_fileNum, m_totalPages, desc

        Dim msysParseErrNum As Long
        Dim msysParseErrDesc As String
        On Error Resume Next
        msysDesc = CatalogReader.ParseTableDef(m_fileNum, m_totalPages, 2, "MSysObjects")
        msysParseErrNum = Err.Number
        msysParseErrDesc = Err.Description
        Err.Clear
        On Error GoTo 0

        ' Never silently skip the catalog insert: a TDEF page without an MSysObjects row is an
        ' orphan that disappears on reopen and is discarded by Compact & Repair.
        If msysDesc.ColumnCount < 17 Then
            If msysParseErrNum <> 0 Then
                Err.Raise vbObjectError + 3110, "Database.PersistNewTableDef", "Cannot register table '" & desc.TableName & "' in MSysObjects: the system catalog definition could not be read (" & msysParseErrDesc & ")."
            Else
                Err.Raise vbObjectError + 3110, "Database.PersistNewTableDef", "Cannot register table '" & desc.TableName & "' in MSysObjects: unexpected system catalog layout (" & CStr(msysDesc.ColumnCount) & " columns)."
            End If
        End If

        If msysDesc.ColumnCount >= 17 Then
            Dim ownerBytes(0 To 1) As Byte
            Dim ownerVal As Variant
            Dim foundTablesCont As Boolean
            ownerBytes(0) = &HA6&
            ownerBytes(1) = &H33&
            ownerVal = ownerBytes
            tablesParentId = &HF0000001
            foundTablesCont = False

            On Error Resume Next
            Set msysTd = m_tableDefs("MSYSOBJECTS")
            If Not msysTd Is Nothing Then
                Set rsObj = msysTd.OpenRecordset()
                If Not rsObj Is Nothing Then
                    Do Until rsObj.EOF
                        rName = CStr(rsObj.Fields("Name").Value)
                        If IsNumeric(rsObj.Fields("Type").Value) Then
                            rType = CLng(rsObj.Fields("Type").Value)
                        Else
                            rType = 0
                        End If
                        If StrComp(rName, "Tables", vbTextCompare) = 0 And rType = 3 Then
                            If IsNumeric(rsObj.Fields("Id").Value) Then
                                If CLng(rsObj.Fields("Id").Value) <> 0 Then
                                    tablesParentId = CLng(rsObj.Fields("Id").Value)
                                    foundTablesCont = True
                                End If
                            End If
                        ElseIf rType = 1 And Left$(rName, 4) <> "MSys" Then
                            If Not foundTablesCont And IsNumeric(rsObj.Fields("ParentId").Value) Then
                                If CLng(rsObj.Fields("ParentId").Value) <> 0 Then
                                    tablesParentId = CLng(rsObj.Fields("ParentId").Value)
                                End If
                            End If
                            If Not IsNull(rsObj.Fields("Owner").Value) And Not IsEmpty(rsObj.Fields("Owner").Value) Then
                                ownerVal = rsObj.Fields("Owner").Value
                            End If
                        End If
                        rsObj.MoveNext
                    Loop
                    rsObj.Close
                End If
            End If
            On Error GoTo 0

            ReDim sysVals(0 To msysDesc.ColumnCount - 1)
            For cIdx = 0 To msysDesc.ColumnCount - 1
                Select Case UCase$(msysDesc.Columns(cIdx).Name)
                    Case "ID": sysVals(cIdx) = CLng(desc.TdefPageNumber)
                    Case "PARENTID": sysVals(cIdx) = tablesParentId
                    Case "NAME": sysVals(cIdx) = desc.TableName
                    Case "TYPE": sysVals(cIdx) = CInt(1)
                    Case "DATECREATE": sysVals(cIdx) = Now
                    Case "DATEUPDATE": sysVals(cIdx) = Now
                    Case "OWNER": sysVals(cIdx) = ownerVal
                    Case "FLAGS": sysVals(cIdx) = 0&
                    Case Else: sysVals(cIdx) = Null
                End Select
            Next cIdx
            RecordWriter.InsertRecord m_fileNum, m_totalPages, msysDesc, sysVals, outPg, outSl
            Me.EnsureTableCatalogAndACEs CLng(desc.TdefPageNumber)
        End If
    End Sub
    ' =========================================================================
    ' Live Action SQL Executor (INSERT, UPDATE, DELETE, CREATE TABLE, DROP TABLE)
    ' =========================================================================

    Public Sub Execute(ByVal Query As String, Optional ByVal Options As Variant)
        Dim q As String
        Dim uq As String

        EnsureOpen "Execute"
        m_recordsAffected = 0
        q = Trim$(Query)
        If Right$(q, 1) = ";" Then q = Trim$(Left$(q, Len(q) - 1))
        If Len(q) = 0 Then Exit Sub
        uq = UCase$(q)

        If Left$(uq, 12) = "INSERT INTO " Or Left$(uq, 7) = "UPDATE " Or Left$(uq, 12) = "DELETE FROM " Or Left$(uq, 14) = "DELETE * FROM " Or Left$(uq, 13) = "CREATE TABLE " Or Left$(uq, 11) = "DROP TABLE " Or Left$(uq, 12) = "ALTER TABLE " Or Left$(uq, 13) = "CREATE INDEX " Or Left$(uq, 20) = "CREATE UNIQUE INDEX " Or Left$(uq, 11) = "DROP INDEX " Then
            EnsureWritable "Execute"
        End If

        If m_isCompiledLocked Then
            If Left$(uq, 13) = "CREATE TABLE " Or Left$(uq, 11) = "DROP TABLE " Or Left$(uq, 12) = "ALTER TABLE " Or Left$(uq, 13) = "CREATE INDEX " Or Left$(uq, 20) = "CREATE UNIQUE INDEX " Or Left$(uq, 11) = "DROP INDEX " Then
                Err.Raise vbObjectError + 3033, "Database.Execute", "Design access denied: DDL statements are disabled in compiled application packages."
            End If
        End If
        If Left$(uq, 12) = "INSERT INTO " Then
            ExecuteInsertSql q
        ElseIf Left$(uq, 7) = "UPDATE " Then
            ExecuteUpdateSql q
        ElseIf Left$(uq, 12) = "DELETE FROM " Or Left$(uq, 14) = "DELETE * FROM " Then
            ExecuteDeleteSql q
        ElseIf Left$(uq, 13) = "CREATE TABLE " Then
            ExecuteCreateTableSql q
        ElseIf Left$(uq, 11) = "DROP TABLE " Then
            Dim dropName As String
            dropName = CleanSqlColName(Mid$(q, 12))
            ExecuteDropTable dropName
        ElseIf Left$(uq, 12) = "ALTER TABLE " Then
            ExecuteAlterTableSql q
        ElseIf Left$(uq, 13) = "CREATE INDEX " Or Left$(uq, 20) = "CREATE UNIQUE INDEX " Then
            ExecuteCreateIndexSql q
        ElseIf Left$(uq, 11) = "DROP INDEX " Then
            ExecuteDropIndexSql q
        Else
            Err.Raise vbObjectError + 3129, "Database.Execute", "Invalid SQL statement; expected 'DELETE', 'INSERT', 'SELECT', 'UPDATE', or DDL statement: " & Left$(q, 80)
        End If
    End Sub

    Friend Sub DropLocalTableFromDisk(ByVal dropName As String)
        Dim uName As String
        Dim targetTd As TableDef
        Dim desc As TableDefDescriptor
        Dim tdefPage As Long
        Dim rsCatalog As Recordset
        Dim rsAces As Recordset
        Dim oType As Variant
        Dim aceObjId As Variant
        Dim zeroBuf(0 To 4095) As Byte
        Dim dPages As Collection
        Dim dpIdx As Long

        uName = UCase$(Trim$(dropName))
        On Error Resume Next
        Set targetTd = m_tableDefs(uName)
        On Error GoTo 0
        If targetTd Is Nothing Then Exit Sub

        desc = targetTd.Descriptor
        tdefPage = desc.TdefPageNumber

        On Error Resume Next
        Set rsCatalog = Me.OpenRecordset("MSysObjects")
        If Not rsCatalog Is Nothing Then
            Do Until rsCatalog.EOF
                If StrComp(CStr(rsCatalog.Fields("Name").Value & ""), dropName, vbTextCompare) = 0 Then
                    oType = rsCatalog.Fields("Type").Value
                    If Not IsNull(oType) Then
                        If CLng(oType) = 1 Then
                            rsCatalog.Delete
                            Exit Do
                        End If
                    End If
                End If
                rsCatalog.MoveNext
            Loop
            rsCatalog.Close
        End If

        If tdefPage > 2 Then
            Set rsAces = Me.OpenRecordset("MSysACEs")
            If Not rsAces Is Nothing Then
                Do Until rsAces.EOF
                    aceObjId = rsAces.Fields("ObjectId").Value
                    If Not IsNull(aceObjId) And IsNumeric(aceObjId) Then
                        If CLng(aceObjId) = tdefPage Then
                            rsAces.Delete
                        Else
                            rsAces.MoveNext
                        End If
                    Else
                        rsAces.MoveNext
                    End If
                Loop
                rsAces.Close
            End If
        End If
        On Error GoTo 0

        If tdefPage > 2 And tdefPage < m_totalPages Then
            Set dPages = CatalogReader.FindAllDataPages(m_fileNum, m_totalPages, tdefPage)
            For dpIdx = 1 To dPages.Count
                PageWriter.WritePageBytes m_fileNum, m_totalPages, CLng(dPages(dpIdx)), zeroBuf
            Next dpIdx
            PageWriter.WritePageBytes m_fileNum, m_totalPages, tdefPage, zeroBuf
        End If

        CatalogReader.InvalidatePageDirectory
        CatalogReader.EnsurePageDirectory m_fileNum, m_totalPages
    End Sub

    Private Sub ExecuteDropTable(ByVal dropName As String)
        Dim uName As String
        uName = UCase$(Trim$(dropName))
        If Not m_tableDefs.HasItem(uName) Then
            Err.Raise vbObjectError + 3376, "Database.Execute", "Table '" & dropName & "' does not exist."
        End If
        m_tableDefs.Delete dropName
    End Sub

    Private Sub ExecuteAlterTableSql(ByVal sql As String)
        Dim s As String
        Dim rest As String
        Dim tblName As String
        Dim closeBr As Long
        Dim sp As Long
        Dim targetTd As TableDef
        Dim desc As TableDefDescriptor
        Dim uRest As String
        Dim colSpec As String
        Dim cName As String
        Dim typePart As String
        Dim cBr As Long
        Dim sp2 As Long
        Dim i As Integer
        Dim isFixedCol As Boolean
        Dim cType As JetColumnType
        Dim bLen As Long
        Dim newColIdx As Integer
        Dim maxFixed As Integer
        Dim fEnd As Integer
        Dim dropCol As String
        Dim foundIdx As Integer
        Dim k As Integer
        Dim vCount As Integer
        Dim altSpec As String
        Dim altCol As String
        Dim altType As String
        Dim altBr As Long
        Dim altSp As Long
        Dim mIdx As Integer
        Dim isPhysicalTable As Boolean
        Dim needRepack As Boolean
        Dim oldColCount As Integer
        Dim oldColNames() As String
        Dim savedRows As Collection
        Dim curFixedOff As Integer
        Dim dPages As Collection
        Dim pVar As Variant
        Dim dpPage As Long
        Dim dp() As Byte
        Dim rRow As Variant
        Dim oldVals() As Variant
        Dim newVals() As Variant
        Dim nc As Integer
        Dim oc As Integer
        Dim outPg As Long
        Dim outSl As Integer
        Dim savedAutoNum As Long
        Dim rs As Recordset
        Dim rVals() As Variant
        Dim idxHasDropCol As Boolean
        Dim icIdx As Integer
        Dim remI As Integer

        s = Trim$(sql)
        If Right$(s, 1) = ";" Then s = Trim$(Left$(s, Len(s) - 1))
        rest = Trim$(Mid$(s, 12))
        If Len(rest) = 0 Then
            Err.Raise vbObjectError + 3129, "Database.Execute", "Syntax error in ALTER TABLE statement."
        End If

        If Left$(rest, 1) = "[" Then
            closeBr = InStr(1, rest, "]")
            If closeBr = 0 Then Err.Raise vbObjectError + 3129, "Database.Execute", "Missing closing bracket in table name."
            tblName = Mid$(rest, 2, closeBr - 2)
            rest = Trim$(Mid$(rest, closeBr + 1))
        Else
            sp = InStr(1, rest, " ")
            If sp = 0 Then Err.Raise vbObjectError + 3129, "Database.Execute", "Missing clause in ALTER TABLE statement."
            tblName = Left$(rest, sp - 1)
            rest = Trim$(Mid$(rest, sp + 1))
        End If
        tblName = CleanSqlColName(tblName)

        On Error Resume Next
        Set targetTd = m_tableDefs(tblName)
        On Error GoTo 0
        If targetTd Is Nothing Then
            Err.Raise vbObjectError + 3078, "Database.Execute", "Cannot find table '" & tblName & "'."
        End If

        desc = targetTd.Descriptor
        uRest = UCase$(rest)
        isPhysicalTable = (desc.TdefPageNumber > 0 And desc.TdefPageNumber < m_totalPages)
        needRepack = False
        Set savedRows = New Collection

        If isPhysicalTable And (Left$(uRest, 11) = "ADD COLUMN " Or Left$(uRest, 4) = "ADD " Or Left$(uRest, 12) = "DROP COLUMN " Or Left$(uRest, 5) = "DROP " Or Left$(uRest, 13) = "ALTER COLUMN ") Then
            oldColCount = desc.ColumnCount
            If oldColCount > 0 Then
                ReDim oldColNames(0 To oldColCount - 1)
                For i = 0 To oldColCount - 1
                    oldColNames(i) = desc.Columns(i).Name
                Next i
                Set rs = targetTd.OpenRecordset()
                If Not rs Is Nothing Then
                    Do While Not rs.EOF
                        ReDim rVals(0 To oldColCount - 1)
                        For i = 0 To oldColCount - 1
                            rVals(i) = rs.Fields(i).Value
                        Next i
                        savedRows.Add rVals
                        rs.MoveNext
                    Loop
                    rs.Close
                End If
                If savedRows.Count > 0 Then
                    needRepack = True
                End If
            End If
        End If

        If Left$(uRest, 11) = "ADD COLUMN " Or Left$(uRest, 4) = "ADD " Then
            If Left$(uRest, 11) = "ADD COLUMN " Then
                colSpec = Trim$(Mid$(rest, 12))
            Else
                colSpec = Trim$(Mid$(rest, 5))
            End If

            If Left$(colSpec, 1) = "[" Then
                cBr = InStr(1, colSpec, "]")
                If cBr = 0 Then Err.Raise vbObjectError + 3129, "Database.Execute", "Syntax error in column specification."
                cName = Mid$(colSpec, 2, cBr - 2)
                typePart = UCase$(Trim$(Mid$(colSpec, cBr + 1)))
            Else
                sp2 = InStr(1, colSpec, " ")
                If sp2 > 0 Then
                    cName = Left$(colSpec, sp2 - 1)
                    typePart = UCase$(Trim$(Mid$(colSpec, sp2 + 1)))
                Else
                    cName = colSpec
                    typePart = "TEXT(255)"
                End If
            End If
            cName = CleanSqlColName(cName)

            For i = 0 To desc.ColumnCount - 1
                If StrComp(desc.Columns(i).Name, cName, vbTextCompare) = 0 Then
                    Err.Raise vbObjectError + 3191, "Database.Execute", "Column '" & cName & "' already exists in table '" & tblName & "'."
                End If
            Next i

            isFixedCol = False
            bLen = 0
            If InStr(1, typePart, "AUTOINCREMENT") > 0 Or InStr(1, typePart, "COUNTER") > 0 Then
                cType = JetColumnType.ColLong
                isFixedCol = True
                bLen = 4
            ElseIf Left$(typePart, 6) = "BIGINT" Then
                cType = JetColumnType.ColBigInt
                isFixedCol = True
                bLen = 8
            ElseIf Left$(typePart, 7) = "DECIMAL" Or Left$(typePart, 7) = "NUMERIC" Or Left$(typePart, 3) = "DEC" Or Left$(typePart, 3) = "NUM" Then
                cType = JetColumnType.ColDecimal
                isFixedCol = True
                bLen = 17
            ElseIf Left$(typePart, 4) = "LONG" Or Left$(typePart, 3) = "INT" Then
                cType = JetColumnType.ColLong
                isFixedCol = True
                bLen = 4
            ElseIf Left$(typePart, 6) = "DOUBLE" Or Left$(typePart, 5) = "FLOAT" Then
                cType = JetColumnType.ColDouble
                isFixedCol = True
                bLen = 8
            ElseIf Left$(typePart, 8) = "CURRENCY" Then
                cType = JetColumnType.ColCurrency
                isFixedCol = True
                bLen = 8
            ElseIf Left$(typePart, 4) = "DATE" Or Left$(typePart, 8) = "DATETIME" Then
                cType = JetColumnType.ColDateTime
                isFixedCol = True
                bLen = 8
            ElseIf Left$(typePart, 5) = "YESNO" Or Left$(typePart, 3) = "BIT" Or Left$(typePart, 7) = "BOOLEAN" Then
                cType = JetColumnType.ColBoolean
                isFixedCol = True
                bLen = 0
            ElseIf Left$(typePart, 4) = "MEMO" Or Left$(typePart, 8) = "LONGTEXT" Then
                cType = JetColumnType.ColMemo
                isFixedCol = False
                bLen = 0
            Else
                cType = JetColumnType.ColText
                isFixedCol = False
                bLen = 510
            End If

            newColIdx = desc.ColumnCount
            desc.ColumnCount = desc.ColumnCount + 1
            ReDim Preserve desc.Columns(0 To desc.ColumnCount - 1)
            desc.Columns(newColIdx).Name = cName
            desc.Columns(newColIdx).ColType = cType
            desc.Columns(newColIdx).ColNumber = newColIdx
            desc.Columns(newColIdx).ColId = newColIdx
            desc.Columns(newColIdx).IsFixed = isFixedCol
            desc.Columns(newColIdx).ByteLength = bLen
            If isFixedCol Then
                maxFixed = 0
                For i = 0 To newColIdx - 1
                    If desc.Columns(i).IsFixed Then
                        fEnd = desc.Columns(i).FixedOffset + CInt(desc.Columns(i).ByteLength)
                        If fEnd > maxFixed Then maxFixed = fEnd
                    End If
                Next i
                desc.Columns(newColIdx).FixedOffset = maxFixed
            Else
                desc.Columns(newColIdx).VarOffsetIndex = desc.VariableColumnCount
                desc.Columns(newColIdx).CompressedUnicode = True
                desc.VariableColumnCount = desc.VariableColumnCount + 1
            End If
        ElseIf Left$(uRest, 12) = "DROP COLUMN " Or Left$(uRest, 5) = "DROP " Then
            If Left$(uRest, 12) = "DROP COLUMN " Then
                dropCol = Trim$(Mid$(rest, 13))
            Else
                dropCol = Trim$(Mid$(rest, 6))
            End If
            dropCol = CleanSqlColName(dropCol)
            foundIdx = -1
            For k = 0 To desc.ColumnCount - 1
                If StrComp(desc.Columns(k).Name, dropCol, vbTextCompare) = 0 Then
                    foundIdx = k
                    Exit For
                End If
            Next k
            If foundIdx = -1 Then
                Err.Raise vbObjectError + 3265, "Database.Execute", "Column '" & dropCol & "' not found in table '" & tblName & "'."
            End If
            For k = foundIdx To desc.ColumnCount - 2
                desc.Columns(k) = desc.Columns(k + 1)
                desc.Columns(k).ColNumber = k
            Next k
            desc.ColumnCount = desc.ColumnCount - 1
            If desc.ColumnCount > 0 Then
                ReDim Preserve desc.Columns(0 To desc.ColumnCount - 1)
            End If
            curFixedOff = 0
            For k = 0 To desc.ColumnCount - 1
                desc.Columns(k).ColNumber = k
                desc.Columns(k).ColId = k
                If desc.Columns(k).IsFixed Then
                    desc.Columns(k).FixedOffset = curFixedOff
                    If desc.Columns(k).ColType <> JetColumnType.ColBoolean Then
                        curFixedOff = curFixedOff + desc.Columns(k).ByteLength
                    End If
                End If
            Next k
            vCount = 0
            For k = 0 To desc.ColumnCount - 1
                If Not desc.Columns(k).IsFixed Then
                    desc.Columns(k).VarOffsetIndex = vCount
                    vCount = vCount + 1
                End If
            Next k
            desc.VariableColumnCount = vCount

            ' Clean up any index referencing the dropped column
            For k = desc.IndexCount - 1 To 0 Step -1
                idxHasDropCol = False
                For icIdx = 0 To desc.Indexes(k).ColumnCount - 1
                    If StrComp(desc.Indexes(k).ColumnNames(icIdx), dropCol, vbTextCompare) = 0 Then
                        idxHasDropCol = True
                        Exit For
                    End If
                Next icIdx
                If idxHasDropCol Then
                    For remI = k To desc.IndexCount - 2
                        desc.Indexes(remI) = desc.Indexes(remI + 1)
                    Next remI
                    desc.IndexCount = desc.IndexCount - 1
                    If desc.IndexCount > 0 Then
                        ReDim Preserve desc.Indexes(0 To desc.IndexCount - 1)
                    Else
                        Erase desc.Indexes
                    End If
                End If
            Next k
        ElseIf Left$(uRest, 13) = "ALTER COLUMN " Then
            altSpec = Trim$(Mid$(rest, 14))
            If Left$(altSpec, 1) = "[" Then
                altBr = InStr(1, altSpec, "]")
                altCol = Mid$(altSpec, 2, altBr - 2)
                altType = UCase$(Trim$(Mid$(altSpec, altBr + 1)))
            Else
                altSp = InStr(1, altSpec, " ")
                If altSp > 0 Then
                    altCol = Left$(altSpec, altSp - 1)
                    altType = UCase$(Trim$(Mid$(altSpec, altSp + 1)))
                Else
                    altCol = altSpec
                    altType = "TEXT(255)"
                End If
            End If
            altCol = CleanSqlColName(altCol)
            mIdx = -1
            For k = 0 To desc.ColumnCount - 1
                If StrComp(desc.Columns(k).Name, altCol, vbTextCompare) = 0 Then
                    mIdx = k
                    Exit For
                End If
            Next k
            If mIdx = -1 Then
                Err.Raise vbObjectError + 3265, "Database.Execute", "Column '" & altCol & "' not found in table '" & tblName & "'."
            End If
            If InStr(1, altType, "BIGINT") > 0 Then
                desc.Columns(mIdx).ColType = JetColumnType.ColBigInt
                desc.Columns(mIdx).ByteLength = 8
                desc.Columns(mIdx).IsFixed = True
            ElseIf InStr(1, altType, "DECIMAL") > 0 Or InStr(1, altType, "NUMERIC") > 0 Or InStr(1, altType, "DEC") > 0 Then
                desc.Columns(mIdx).ColType = JetColumnType.ColDecimal
                desc.Columns(mIdx).ByteLength = 17
                desc.Columns(mIdx).IsFixed = True
            ElseIf InStr(1, altType, "LONG") > 0 Or InStr(1, altType, "INT") > 0 Then
                desc.Columns(mIdx).ColType = JetColumnType.ColLong
                desc.Columns(mIdx).ByteLength = 4
                desc.Columns(mIdx).IsFixed = True
            ElseIf InStr(1, altType, "CURRENCY") > 0 Then
                desc.Columns(mIdx).ColType = JetColumnType.ColCurrency
                desc.Columns(mIdx).ByteLength = 8
                desc.Columns(mIdx).IsFixed = True
            ElseIf InStr(1, altType, "DOUBLE") > 0 Then
                desc.Columns(mIdx).ColType = JetColumnType.ColDouble
                desc.Columns(mIdx).ByteLength = 8
                desc.Columns(mIdx).IsFixed = True
            ElseIf InStr(1, altType, "DATE") > 0 Then
                desc.Columns(mIdx).ColType = JetColumnType.ColDateTime
                desc.Columns(mIdx).ByteLength = 8
                desc.Columns(mIdx).IsFixed = True
            ElseIf InStr(1, altType, "YESNO") > 0 Or InStr(1, altType, "BIT") > 0 Or InStr(1, altType, "BOOLEAN") > 0 Then
                desc.Columns(mIdx).ColType = JetColumnType.ColBoolean
                desc.Columns(mIdx).ByteLength = 0
                desc.Columns(mIdx).IsFixed = True
            ElseIf InStr(1, altType, "MEMO") > 0 Or InStr(1, altType, "LONGTEXT") > 0 Then
                desc.Columns(mIdx).ColType = JetColumnType.ColMemo
                desc.Columns(mIdx).ByteLength = 0
                desc.Columns(mIdx).IsFixed = False
                desc.Columns(mIdx).CompressedUnicode = True
            Else
                desc.Columns(mIdx).ColType = JetColumnType.ColText
                desc.Columns(mIdx).ByteLength = 510
                desc.Columns(mIdx).IsFixed = False
                desc.Columns(mIdx).CompressedUnicode = True
            End If
            curFixedOff = 0
            For k = 0 To desc.ColumnCount - 1
                desc.Columns(k).ColNumber = k
                desc.Columns(k).ColId = k
                If desc.Columns(k).IsFixed Then
                    desc.Columns(k).FixedOffset = curFixedOff
                    If desc.Columns(k).ColType <> JetColumnType.ColBoolean Then
                        curFixedOff = curFixedOff + desc.Columns(k).ByteLength
                    End If
                End If
            Next k
            vCount = 0
            For k = 0 To desc.ColumnCount - 1
                If Not desc.Columns(k).IsFixed Then
                    desc.Columns(k).VarOffsetIndex = vCount
                    vCount = vCount + 1
                End If
            Next k
            desc.VariableColumnCount = vCount
        Else
            Err.Raise vbObjectError + 3129, "Database.Execute", "Invalid ALTER TABLE syntax: " & rest
        End If

        If isPhysicalTable Then
            savedAutoNum = desc.AutoNumberNext
            If needRepack Then
                Set dPages = CatalogReader.FindAllDataPages(m_fileNum, m_totalPages, desc.TdefPageNumber)
                If dPages.Count = 0 And desc.PrimaryDataPage > 0 And desc.PrimaryDataPage < m_totalPages Then
                    dPages.Add desc.PrimaryDataPage
                End If
                For Each pVar In dPages
                    dpPage = CLng(pVar)
                    If dpPage > 0 And dpPage < m_totalPages Then
                        dp = CatalogReader.ReadPageBytes(m_fileNum, m_totalPages, dpPage)
                        If dp(0) = &H1& Then
                            PageWriter.WriteUInt16LE dp, 2, 4082
                            PageWriter.WriteUInt16LE dp, 12, 0
                            PageWriter.WritePageBytes m_fileNum, m_totalPages, dpPage, dp
                        End If
                    End If
                Next pVar
                desc.RowCount = 0
                RecordWriter.WriteTableTdefPage m_fileNum, m_totalPages, desc

                For Each rRow In savedRows
                    oldVals = rRow
                    ReDim newVals(0 To desc.ColumnCount - 1)
                    For nc = 0 To desc.ColumnCount - 1
                        newVals(nc) = Null
                        For oc = 0 To oldColCount - 1
                            If StrComp(desc.Columns(nc).Name, oldColNames(oc), vbTextCompare) = 0 Then
                                newVals(nc) = oldVals(oc)
                                If desc.Columns(nc).IsFixed And Not IsNull(newVals(nc)) And Not IsEmpty(newVals(nc)) Then
                                    If Len(Trim$(CStr(newVals(nc)))) = 0 Then
                                        newVals(nc) = Null
                                    ElseIf desc.Columns(nc).ColType <> JetColumnType.ColDateTime And desc.Columns(nc).ColType <> JetColumnType.ColGUID And desc.Columns(nc).ColType <> JetColumnType.ColBinary Then
                                        If Not IsNumeric(newVals(nc)) Then newVals(nc) = Null
                                    End If
                                End If
                                Exit For
                            End If
                        Next oc
                    Next nc
                    RecordWriter.InsertRecord m_fileNum, m_totalPages, desc, newVals, outPg, outSl, False
                Next rRow
                If savedAutoNum > desc.AutoNumberNext Then
                    desc.AutoNumberNext = savedAutoNum
                    If desc.TdefPageNumber > 0 And desc.TdefPageNumber < m_totalPages Then
                        Dim tpAuto() As Byte
                        tpAuto = CatalogReader.ReadPageBytes(m_fileNum, m_totalPages, desc.TdefPageNumber)
                        If tpAuto(0) = &H2& Then
                            PageWriter.WriteInt32LE tpAuto, 20, desc.AutoNumberNext
                            PageWriter.WritePageBytes m_fileNum, m_totalPages, desc.TdefPageNumber, tpAuto
                        End If
                    End If
                End If
            Else
                RecordWriter.WriteTableTdefPage m_fileNum, m_totalPages, desc
            End If
        End If
        targetTd.UpdateDescriptor desc
        targetTd.Fields.InitForTable desc
    End Sub

    Private Sub ExecuteCreateIndexSql(ByVal sql As String)
        Dim s As String
        s = Trim$(sql)
        If Right$(s, 1) = ";" Then s = Trim$(Left$(s, Len(s) - 1))
        Dim uq As String
        uq = UCase$(s)
        Dim isUnique As Boolean
        isUnique = (InStr(1, uq, " UNIQUE ") > 0)
        Dim pOn As Long
        pOn = InStr(1, uq, " ON ")
        If pOn = 0 Then
            Err.Raise vbObjectError + 3129, "Database.Execute", "Syntax error in CREATE INDEX statement; missing ON keyword."
        End If
        Dim idxName As String
        If isUnique Then
            idxName = CleanSqlColName(Mid$(s, 21, pOn - 21))
        Else
            idxName = CleanSqlColName(Mid$(s, 14, pOn - 14))
        End If
        Dim rest As String
        rest = Trim$(Mid$(s, pOn + 4))
        Dim pOpen As Long
        pOpen = InStr(1, rest, "(")
        Dim pClose As Long
        pClose = InStrRev(rest, ")")
        If pOpen = 0 Or pClose <= pOpen Then
            Err.Raise vbObjectError + 3129, "Database.Execute", "Syntax error in CREATE INDEX statement; missing column list in parentheses."
        End If
        Dim tblName As String
        tblName = CleanSqlColName(Left$(rest, pOpen - 1))
        Dim colsStr As String
        colsStr = Mid$(rest, pOpen + 1, pClose - pOpen - 1)
        Dim colParts() As String
        colParts = Split(colsStr, ",")
        Dim targetTd As TableDef
        On Error Resume Next
        Set targetTd = m_tableDefs(tblName)
        On Error GoTo 0
        If targetTd Is Nothing Then
            Err.Raise vbObjectError + 3078, "Database.Execute", "Cannot find table '" & tblName & "'."
        End If
        Dim isPrimary As Boolean
        isPrimary = (InStr(1, uq, "WITH PRIMARY") > 0) Or (StrComp(idxName, "PrimaryKey", vbTextCompare) = 0)
        If isPrimary Then isUnique = True
        Dim newIdx As New Index
        newIdx.Name = idxName
        newIdx.Unique = isUnique
        newIdx.Primary = isPrimary
        Dim curDesc As TableDefDescriptor
        curDesc = targetTd.Descriptor
        Dim existingIdxPos As Integer
        Dim scanI As Integer
        existingIdxPos = -1
        For scanI = 0 To curDesc.IndexCount - 1
            If StrComp(curDesc.Indexes(scanI).Name, idxName, vbTextCompare) = 0 Then
                existingIdxPos = scanI
                Exit For
            End If
        Next scanI
        Dim newIdxCount As Integer
        If existingIdxPos >= 0 Then
            newIdxCount = existingIdxPos + 1
        Else
            newIdxCount = curDesc.IndexCount + 1
            ReDim Preserve curDesc.Indexes(0 To newIdxCount - 1)
            curDesc.IndexCount = newIdxCount
        End If
        curDesc.Indexes(newIdxCount - 1).Name = idxName
        curDesc.Indexes(newIdxCount - 1).IsUnique = isUnique
        curDesc.Indexes(newIdxCount - 1).IsPrimary = isPrimary
        curDesc.Indexes(newIdxCount - 1).ColumnCount = CInt(UBound(colParts) + 1)
        ReDim curDesc.Indexes(newIdxCount - 1).ColumnNames(0 To curDesc.Indexes(newIdxCount - 1).ColumnCount - 1)
        Dim c As Long
        For c = 0 To UBound(colParts)
            Dim rawCol As String
            rawCol = Trim$(colParts(c))
            Dim uCol As String
            uCol = UCase$(rawCol)
            If Right$(uCol, 4) = " ASC" Then
                rawCol = Trim$(Left$(rawCol, Len(rawCol) - 4))
            ElseIf Right$(uCol, 5) = " DESC" Then
                rawCol = Trim$(Left$(rawCol, Len(rawCol) - 5))
            End If
            Dim cleanCol As String
            cleanCol = CleanSqlColName(rawCol)
            newIdx.AddColumnName cleanCol
            curDesc.Indexes(newIdxCount - 1).ColumnNames(c) = cleanCol
        Next c
        targetTd.UpdateDescriptor curDesc
        If existingIdxPos < 0 Then targetTd.Indexes.Append newIdx
        RecordWriter.WriteTableTdefPage m_fileNum, m_totalPages, curDesc
    End Sub

    Private Sub ExecuteDropIndexSql(ByVal sql As String)
        Dim s As String
        Dim uq As String
        Dim pOn As Long
        Dim idxName As String
        Dim tblName As String
        Dim targetTd As TableDef
        Dim curDesc As TableDefDescriptor
        Dim fIdx As Integer
        Dim i As Integer

        s = Trim$(sql)
        If Right$(s, 1) = ";" Then s = Trim$(Left$(s, Len(s) - 1))
        uq = UCase$(s)
        pOn = InStr(1, uq, " ON ")
        If pOn = 0 Then
            Err.Raise vbObjectError + 3129, "Database.Execute", "Syntax error in DROP INDEX statement; missing ON keyword."
        End If
        idxName = CleanSqlColName(Mid$(s, 12, pOn - 12))
        tblName = CleanSqlColName(Mid$(s, pOn + 4))

        On Error Resume Next
        Set targetTd = m_tableDefs(tblName)
        On Error GoTo 0
        If targetTd Is Nothing Then
            Err.Raise vbObjectError + 3078, "Database.Execute", "Cannot find table '" & tblName & "'."
        End If

        targetTd.Indexes.Delete idxName
        curDesc = targetTd.Descriptor
        fIdx = -1
        For i = 0 To curDesc.IndexCount - 1
            If StrComp(curDesc.Indexes(i).Name, idxName, vbTextCompare) = 0 Then
                fIdx = i
                Exit For
            End If
        Next i
        If fIdx >= 0 Then
            For i = fIdx To curDesc.IndexCount - 2
                curDesc.Indexes(i) = curDesc.Indexes(i + 1)
            Next i
            curDesc.IndexCount = curDesc.IndexCount - 1
            If curDesc.IndexCount > 0 Then
                ReDim Preserve curDesc.Indexes(0 To curDesc.IndexCount - 1)
            End If
            targetTd.UpdateDescriptor curDesc
            If curDesc.TdefPageNumber > 0 And curDesc.TdefPageNumber < m_totalPages Then
                RecordWriter.WriteTableTdefPage m_fileNum, m_totalPages, curDesc
            End If
        End If
    End Sub

    Private Sub ExecuteInsertSql(ByVal sql As String)
        Dim rest As String
        rest = Trim$(Mid$(sql, 13))
        Dim valPos As Long
        valPos = FindSqlClauseKeyword(rest, "VALUES")
        If valPos = 0 Then valPos = InStr(1, rest, "VALUES(", vbTextCompare)
        If valPos = 0 Then
            Err.Raise vbObjectError + 3134, "Database.Execute", "Syntax error in INSERT INTO statement."
        End If
        Dim leftPart As String
        Dim rightPart As String
        leftPart = Trim$(Left$(rest, valPos - 1))
        rightPart = Trim$(Mid$(rest, valPos + 6))
        rightPart = StripOuterParens(rightPart)
        Dim tblName As String
        Dim colSpec As String
        Dim pOpen As Long
        pOpen = InStr(1, leftPart, "(")
        If pOpen > 0 Then
            tblName = CleanSqlColName(Left$(leftPart, pOpen - 1))
            colSpec = StripOuterParens(Mid$(leftPart, pOpen))
        Else
            tblName = CleanSqlColName(leftPart)
            colSpec = vbNullString
        End If
        Dim td As TableDef
        Set td = m_tableDefs.Item(tblName)
        If td Is Nothing Then
            Err.Raise vbObjectError + 3078, "Database.Execute", "The database engine cannot find the input table or query '" & tblName & "'."
        End If
        Dim rs As Recordset
        Set rs = td.OpenRecordset()
        rs.AddNew
        Dim valItems() As String
        valItems = SplitSqlItems(rightPart)
        Dim colItems() As String
        Dim hasExplicitCols As Boolean
        hasExplicitCols = (Len(Trim$(colSpec)) > 0)
        If hasExplicitCols Then colItems = SplitSqlItems(colSpec)
        Dim i As Long
        For i = 0 To UBound(valItems)
            Dim parsedVal As Variant
            parsedVal = ParseSqlLiteralValue(valItems(i))
            If hasExplicitCols Then
                If i <= UBound(colItems) Then
                    Dim cName As String
                    cName = CleanSqlColName(colItems(i))
                    rs.Fields(cName).Value = parsedVal
                End If
            ElseIf i < rs.Fields.Count Then
                rs.Fields(i).Value = parsedVal
            End If
        Next i
        rs.Update
        m_recordsAffected = 1
    End Sub

    Private Sub ExecuteUpdateSql(ByVal sql As String)
        Dim setPos As Long
        Dim tblName As String
        Dim afterSet As String
        Dim whereClause As String
        Dim setClause As String
        Dim whPos As Long
        Dim td As TableDef
        Dim assignItems() As String
        Dim rs As Recordset
        Dim match As Boolean
        Dim aIdx As Long
        Dim eqPos As Long
        Dim fName As String
        Dim fValStr As String
        Dim autoTransStarted As Boolean
        Dim savedErrNum As Long
        Dim savedErrDesc As String
        Dim savedErrSrc As String

        setPos = FindSqlClauseKeyword(sql, "SET")
        If setPos = 0 Then
            Err.Raise vbObjectError + 3144, "Database.Execute", "Syntax error in UPDATE statement."
        End If
        tblName = CleanSqlColName(Mid$(sql, 8, setPos - 8))
        afterSet = Trim$(Mid$(sql, setPos + 4))
        whPos = FindSqlClauseKeyword(afterSet, "WHERE")
        If whPos > 0 Then
            setClause = Trim$(Left$(afterSet, whPos - 1))
            whereClause = Trim$(Mid$(afterSet, whPos + 5))
        Else
            setClause = afterSet
            whereClause = vbNullString
        End If
        Set td = m_tableDefs.Item(tblName)
        If td Is Nothing Then
            Err.Raise vbObjectError + 3078, "Database.Execute", "The database engine cannot find the input table or query '" & tblName & "'."
        End If
        assignItems = SplitSqlItems(setClause)
        Set rs = td.OpenRecordset()
        If rs.EOF Then Exit Sub

        autoTransStarted = PageWriter.BeginAutoTransaction(m_fileNum, m_totalPages)
        On Error GoTo UpdateErr

        rs.MoveFirst
        Do Until rs.EOF
            If Len(whereClause) = 0 Then
                match = True
            Else
                match = EvaluateWhereClauseTree(whereClause, rs)
            End If
            If match Then
                rs.Edit
                For aIdx = 0 To UBound(assignItems)
                    eqPos = InStr(1, assignItems(aIdx), "=")
                    If eqPos > 0 Then
                        fName = CleanSqlColName(Left$(assignItems(aIdx), eqPos - 1))
                        fValStr = Trim$(Mid$(assignItems(aIdx), eqPos + 1))
                        rs.Fields(fName).Value = ParseSqlLiteralValue(fValStr)
                    End If
                Next aIdx
                rs.Update
                m_recordsAffected = m_recordsAffected + 1
            End If
            rs.MoveNext
        Loop

        If autoTransStarted Then PageWriter.CommitTransaction
        Exit Sub

UpdateErr:
        savedErrNum = Err.Number
        savedErrDesc = Err.Description
        savedErrSrc = Err.Source
        If autoTransStarted Then
            On Error Resume Next
            PageWriter.RollbackTransaction m_totalPages
            On Error GoTo 0
        End If
        Err.Raise savedErrNum, savedErrSrc, savedErrDesc
    End Sub

    Private Sub ExecuteDeleteSql(ByVal sql As String)
        Dim fromPos As Long
        Dim afterFrom As String
        Dim tblName As String
        Dim whereClause As String
        Dim whPos As Long
        Dim td As TableDef
        Dim rs As Recordset
        Dim match As Boolean
        Dim autoTransStarted As Boolean
        Dim savedErrNum As Long
        Dim savedErrDesc As String
        Dim savedErrSrc As String

        fromPos = FindSqlClauseKeyword(sql, "FROM")
        If fromPos = 0 Then
            Err.Raise vbObjectError + 3128, "Database.Execute", "Specify the table containing the records you want to delete."
        End If
        afterFrom = Trim$(Mid$(sql, fromPos + 4))
        whPos = FindSqlClauseKeyword(afterFrom, "WHERE")
        If whPos > 0 Then
            tblName = CleanSqlColName(Left$(afterFrom, whPos - 1))
            whereClause = Trim$(Mid$(afterFrom, whPos + 5))
        Else
            tblName = CleanSqlColName(afterFrom)
            whereClause = vbNullString
        End If
        Set td = m_tableDefs.Item(tblName)
        If td Is Nothing Then
            Err.Raise vbObjectError + 3078, "Database.Execute", "The database engine cannot find the input table or query '" & tblName & "'."
        End If
        Set rs = td.OpenRecordset()
        If rs.EOF Then Exit Sub

        autoTransStarted = PageWriter.BeginAutoTransaction(m_fileNum, m_totalPages)
        On Error GoTo DeleteErr

        rs.MoveFirst
        Do Until rs.EOF
            If Len(whereClause) = 0 Then
                match = True
            Else
                match = EvaluateWhereClauseTree(whereClause, rs)
            End If
            If match Then
                rs.Delete
                m_recordsAffected = m_recordsAffected + 1
            Else
                rs.MoveNext
            End If
        Loop

        If autoTransStarted Then PageWriter.CommitTransaction
        Exit Sub

DeleteErr:
        savedErrNum = Err.Number
        savedErrDesc = Err.Description
        savedErrSrc = Err.Source
        If autoTransStarted Then
            On Error Resume Next
            PageWriter.RollbackTransaction m_totalPages
            On Error GoTo 0
        End If
        Err.Raise savedErrNum, savedErrSrc, savedErrDesc
    End Sub

    Private Sub ExecuteCreateTableSql(ByVal sql As String)
        Dim pOpen As Long
        Dim tblName As String
        Dim colDefsStr As String
        Dim colSpecs() As String
        Dim desc As TableDefDescriptor
        Dim fixedOff As Integer
        Dim varIdx As Integer
        Dim i As Integer
        Dim spec As String
        Dim cName As String
        Dim typePart As String
        Dim closeBr As Long
        Dim spPos As Long
        Dim isPk As Boolean
        Dim isUq As Boolean
        Dim isReq As Boolean
        Dim colReq() As Boolean
        Dim colPk() As Boolean
        Dim colUq() As Boolean
        Dim p1 As Long
        Dim p2 As Long
        Dim lenStr As String
        Dim tLen As Long
        Dim idxCount As Integer
        Dim curIdx As Integer
        Dim newTd As TableDef

        pOpen = InStr(1, sql, "(")
        If pOpen = 0 Then
            Err.Raise vbObjectError + 3290, "Database.Execute", "Syntax error in CREATE TABLE statement."
        End If
        tblName = CleanSqlColName(Mid$(sql, 14, pOpen - 14))
        If Left$(tblName, 4) <> "MSys" And Left$(tblName, 12) <> "_OpenAccess_" Then
            If Me.HasTableName(tblName) Then
                Err.Raise 3010, "Microsoft Access", "You have given this table the same name as an existing table ('" & tblName & "') in your database." & vbCrLf & vbCrLf & "Give this object a name that isn't already used by another table or query."
            End If
            If Me.HasQueryName(tblName) Then
                Err.Raise 3012, "Microsoft Access", "You have given this table the same name as an existing query ('" & tblName & "') in your database." & vbCrLf & vbCrLf & "You can't give a table and a query the same name." & vbCrLf & "Give this object a name that isn't already used by another table or query."
            End If
        End If
        colDefsStr = StripOuterParens(Mid$(sql, pOpen))
        Dim rawSpecs() As String
        Dim cleanSpecs() As String
        Dim cleanCount As Long
        Dim rsIdx As Long
        Dim uRawSpec As String
        rawSpecs = SplitSqlItems(colDefsStr)
        cleanCount = 0
        For rsIdx = 0 To UBound(rawSpecs)
            uRawSpec = UCase$(Trim$(rawSpecs(rsIdx)))
            If Left$(uRawSpec, 11) <> "CONSTRAINT " And Left$(uRawSpec, 12) <> "PRIMARY KEY " And Left$(uRawSpec, 12) <> "PRIMARY KEY(" And Left$(uRawSpec, 12) <> "FOREIGN KEY " And Left$(uRawSpec, 12) <> "FOREIGN KEY(" Then
                ReDim Preserve cleanSpecs(0 To cleanCount)
                cleanSpecs(cleanCount) = rawSpecs(rsIdx)
                cleanCount = cleanCount + 1
            End If
        Next rsIdx
        If cleanCount > 0 Then
            colSpecs = cleanSpecs
        Else
            colSpecs = rawSpecs
        End If

        desc.TableName = tblName
        desc.TableTypeByte = &H4E& ' User table 'N'
        desc.RowCount = 0
        desc.AutoNumberNext = 1
        desc.ColumnCount = CInt(UBound(colSpecs) + 1)
        ReDim desc.Columns(0 To desc.ColumnCount - 1)
        ReDim colReq(0 To desc.ColumnCount - 1)
        ReDim colPk(0 To desc.ColumnCount - 1)
        ReDim colUq(0 To desc.ColumnCount - 1)

        fixedOff = 0
        varIdx = 0

        For i = 0 To desc.ColumnCount - 1
            spec = Trim$(colSpecs(i))
            If Left$(spec, 1) = "[" Then
                closeBr = InStr(1, spec, "]")
                cName = Mid$(spec, 2, closeBr - 2)
                typePart = UCase$(Trim$(Mid$(spec, closeBr + 1)))
            Else
                spPos = InStr(1, spec, " ")
                If spPos > 0 Then
                    cName = Left$(spec, spPos - 1)
                    typePart = UCase$(Trim$(Mid$(spec, spPos + 1)))
                Else
                    cName = spec
                    typePart = "TEXT(255)"
                End If
            End If

            cName = CleanSqlColName(cName)
            desc.Columns(i).Name = cName
            desc.Columns(i).SourceTable = tblName
            desc.Columns(i).ColNumber = i
            desc.Columns(i).ColId = i

            isPk = (InStr(1, typePart, "PRIMARY KEY") > 0)
            isUq = (InStr(1, typePart, "UNIQUE") > 0)
            isReq = isPk Or (InStr(1, typePart, "NOT NULL") > 0)

            colPk(i) = isPk
            colUq(i) = (isPk Or isUq)
            colReq(i) = isReq

            If InStr(1, typePart, "AUTOINCREMENT") > 0 Or InStr(1, typePart, "COUNTER") > 0 Then
                desc.Columns(i).ColType = JetColumnType.ColLong
                desc.Columns(i).IsFixed = True
                desc.Columns(i).IsAutoNumber = True
                desc.Columns(i).FixedOffset = fixedOff
                desc.Columns(i).ByteLength = 4
                fixedOff = fixedOff + 4
            ElseIf Left$(typePart, 6) = "BIGINT" Then
                desc.Columns(i).ColType = JetColumnType.ColBigInt
                desc.Columns(i).IsFixed = True
                desc.Columns(i).FixedOffset = fixedOff
                desc.Columns(i).ByteLength = 8
                fixedOff = fixedOff + 8
            ElseIf Left$(typePart, 7) = "DECIMAL" Or Left$(typePart, 7) = "NUMERIC" Or Left$(typePart, 3) = "DEC" Or Left$(typePart, 3) = "NUM" Then
                desc.Columns(i).ColType = JetColumnType.ColDecimal
                desc.Columns(i).IsFixed = True
                desc.Columns(i).FixedOffset = fixedOff
                desc.Columns(i).ByteLength = 17
                fixedOff = fixedOff + 17
            ElseIf Left$(typePart, 4) = "BYTE" Or Left$(typePart, 7) = "TINYINT" Then
                desc.Columns(i).ColType = JetColumnType.ColByte
                desc.Columns(i).IsFixed = True
                desc.Columns(i).FixedOffset = fixedOff
                desc.Columns(i).ByteLength = 1
                fixedOff = fixedOff + 1
            ElseIf Left$(typePart, 7) = "INTEGER" Or Left$(typePart, 5) = "SHORT" Or Left$(typePart, 8) = "SMALLINT" Then
                desc.Columns(i).ColType = JetColumnType.ColInteger
                desc.Columns(i).IsFixed = True
                desc.Columns(i).FixedOffset = fixedOff
                desc.Columns(i).ByteLength = 2
                fixedOff = fixedOff + 2
            ElseIf Left$(typePart, 4) = "LONG" Or Left$(typePart, 3) = "INT" Then
                desc.Columns(i).ColType = JetColumnType.ColLong
                desc.Columns(i).IsFixed = True
                desc.Columns(i).FixedOffset = fixedOff
                desc.Columns(i).ByteLength = 4
                fixedOff = fixedOff + 4
            ElseIf Left$(typePart, 6) = "SINGLE" Or Left$(typePart, 4) = "REAL" Then
                desc.Columns(i).ColType = JetColumnType.ColSingle
                desc.Columns(i).IsFixed = True
                desc.Columns(i).FixedOffset = fixedOff
                desc.Columns(i).ByteLength = 4
                fixedOff = fixedOff + 4
            ElseIf Left$(typePart, 6) = "DOUBLE" Or Left$(typePart, 5) = "FLOAT" Then
                desc.Columns(i).ColType = JetColumnType.ColDouble
                desc.Columns(i).IsFixed = True
                desc.Columns(i).FixedOffset = fixedOff
                desc.Columns(i).ByteLength = 8
                fixedOff = fixedOff + 8
            ElseIf Left$(typePart, 8) = "CURRENCY" Or Left$(typePart, 5) = "MONEY" Then
                desc.Columns(i).ColType = JetColumnType.ColCurrency
                desc.Columns(i).IsFixed = True
                desc.Columns(i).FixedOffset = fixedOff
                desc.Columns(i).ByteLength = 8
                fixedOff = fixedOff + 8
            ElseIf Left$(typePart, 4) = "DATE" Or Left$(typePart, 8) = "DATETIME" Or Left$(typePart, 4) = "TIME" Or Left$(typePart, 9) = "TIMESTAMP" Then
                desc.Columns(i).ColType = JetColumnType.ColDateTime
                desc.Columns(i).IsFixed = True
                desc.Columns(i).FixedOffset = fixedOff
                desc.Columns(i).ByteLength = 8
                fixedOff = fixedOff + 8
            ElseIf Left$(typePart, 5) = "YESNO" Or Left$(typePart, 3) = "BIT" Or Left$(typePart, 7) = "BOOLEAN" Then
                desc.Columns(i).ColType = JetColumnType.ColBoolean
                desc.Columns(i).IsFixed = True
                desc.Columns(i).ByteLength = 0
            ElseIf Left$(typePart, 4) = "GUID" Or Left$(typePart, 16) = "UNIQUEIDENTIFIER" Then
                desc.Columns(i).ColType = JetColumnType.ColGUID
                desc.Columns(i).IsFixed = True
                desc.Columns(i).FixedOffset = fixedOff
                desc.Columns(i).ByteLength = 16
                fixedOff = fixedOff + 16
            ElseIf Left$(typePart, 10) = "LONGBINARY" Or Left$(typePart, 9) = "OLEOBJECT" Or Left$(typePart, 5) = "IMAGE" Or Left$(typePart, 4) = "BLOB" Then
                desc.Columns(i).ColType = JetColumnType.ColLongBinary
                desc.Columns(i).IsFixed = False
                desc.Columns(i).VarOffsetIndex = varIdx
                desc.Columns(i).ByteLength = 0
                varIdx = varIdx + 1
            ElseIf Left$(typePart, 6) = "BINARY" Or Left$(typePart, 9) = "VARBINARY" Then
                desc.Columns(i).ColType = JetColumnType.ColBinary
                desc.Columns(i).IsFixed = False
                desc.Columns(i).VarOffsetIndex = varIdx
                desc.Columns(i).ByteLength = 255
                varIdx = varIdx + 1
            ElseIf Left$(typePart, 4) = "MEMO" Or Left$(typePart, 8) = "LONGTEXT" Then
                desc.Columns(i).ColType = JetColumnType.ColMemo
                desc.Columns(i).IsFixed = False
                desc.Columns(i).VarOffsetIndex = varIdx
                desc.Columns(i).CompressedUnicode = True
                desc.Columns(i).ByteLength = 0
                varIdx = varIdx + 1
            Else
                desc.Columns(i).ColType = JetColumnType.ColText
                desc.Columns(i).IsFixed = False
                desc.Columns(i).VarOffsetIndex = varIdx
                desc.Columns(i).CompressedUnicode = True
                tLen = 255
                p1 = InStr(1, typePart, "(")
                If p1 > 0 Then
                    p2 = InStr(p1 + 1, typePart, ")")
                    If p2 > p1 Then
                        lenStr = Trim$(Mid$(typePart, p1 + 1, p2 - p1 - 1))
                        If IsNumeric(lenStr) Then
                            tLen = CLng(lenStr)
                            If tLen <= 0 Then tLen = 255
                            If tLen > 255 Then tLen = 255
                        End If
                    End If
                End If
                desc.Columns(i).ByteLength = CInt(tLen * 2)
                varIdx = varIdx + 1
            End If
        Next i

        desc.VariableColumnCount = varIdx

        idxCount = 0
        For i = 0 To desc.ColumnCount - 1
            If colPk(i) Or colUq(i) Then
                idxCount = idxCount + 1
            End If
        Next i

        desc.IndexCount = idxCount
        If idxCount > 0 Then
            ReDim desc.Indexes(0 To idxCount - 1)
            curIdx = 0
            For i = 0 To desc.ColumnCount - 1
                If colPk(i) Then
                    desc.Indexes(curIdx).Name = "PrimaryKey"
                    desc.Indexes(curIdx).IsPrimary = True
                    desc.Indexes(curIdx).IsUnique = True
                    desc.Indexes(curIdx).ColumnCount = 1
                    ReDim desc.Indexes(curIdx).ColumnNames(0 To 0)
                    desc.Indexes(curIdx).ColumnNames(0) = desc.Columns(i).Name
                    curIdx = curIdx + 1
                ElseIf colUq(i) Then
                    desc.Indexes(curIdx).Name = "idx_" & desc.Columns(i).Name
                    desc.Indexes(curIdx).IsPrimary = False
                    desc.Indexes(curIdx).IsUnique = True
                    desc.Indexes(curIdx).ColumnCount = 1
                    ReDim desc.Indexes(curIdx).ColumnNames(0 To 0)
                    desc.Indexes(curIdx).ColumnNames(0) = desc.Columns(i).Name
                    curIdx = curIdx + 1
                End If
            Next i
        End If

        PersistNewTableDef desc

        Set newTd = New TableDef
        newTd.Init Me, desc

        For i = 0 To desc.ColumnCount - 1
            If colReq(i) Then
                newTd.Fields(i).Required = True
            End If
        Next i

        m_tableDefs.Append newTd
    End Sub

    Private Function ParseSqlLiteralValue(ByVal rawText As String) As Variant
        Dim s As String
        s = Trim$(rawText)
        If UCase$(s) = "NULL" Or Len(s) = 0 Then
            ParseSqlLiteralValue = Null
        ElseIf UCase$(s) = "TRUE" Or UCase$(s) = "YES" Then
            ParseSqlLiteralValue = True
        ElseIf UCase$(s) = "FALSE" Or UCase$(s) = "NO" Then
            ParseSqlLiteralValue = False
        ElseIf (Left$(s, 1) = "'" And Right$(s, 1) = "'") Or (Left$(s, 1) = """" And Right$(s, 1) = """") Then
            Dim inner As String
            inner = Mid$(s, 2, Len(s) - 2)
            inner = Replace$(inner, "''", "'")
            inner = Replace$(inner, """""", """")
            ParseSqlLiteralValue = inner
        ElseIf Left$(s, 1) = "#" And Right$(s, 1) = "#" And Len(s) >= 3 Then
            On Error Resume Next
            ParseSqlLiteralValue = CDate(Mid$(s, 2, Len(s) - 2))
            If Err.Number <> 0 Then
                Err.Clear
                ParseSqlLiteralValue = Mid$(s, 2, Len(s) - 2)
            End If
            On Error GoTo 0
        ElseIf IsNumeric(s) Then
            If InStr(1, s, ".") > 0 Then
                ParseSqlLiteralValue = CDbl(Val(s))
            Else
                ParseSqlLiteralValue = CLng(Val(s))
            End If
        Else
            ParseSqlLiteralValue = s
        End If
    End Function

    Public Function CreateQueryDef(Optional ByVal Name As Variant, Optional ByVal SqlText As Variant) As Object
        EnsureOpen "CreateQueryDef"
        Dim qd As QueryDef: Set qd = New QueryDef
        qd.Init Me
        If Not IsMissing(Name) Then qd.Name = CStr(Name)
        If Not IsMissing(SqlText) Then qd.SQL = CStr(SqlText)
        If Len(Trim$(qd.Name)) > 0 Then
            If Me.HasTableName(qd.Name) Then
                Err.Raise 3012, "Microsoft Access", "You have given this query the same name as an existing table in your database." & vbCrLf & vbCrLf & "You can't give a table and a query the same name." & vbCrLf & "Give this object a name that isn't already used by another table or query."
            End If
            If Me.HasQueryName(qd.Name) Then
                Err.Raise 3012, "Microsoft Access", "You have given this query the same name as an existing query in your database." & vbCrLf & vbCrLf & "Give this object a name that isn't already used by another table or query."
            End If
            m_queryDefs.AddQueryDef qd
            Me.PersistQueryDefToCatalog qd
        End If
        Set CreateQueryDef = qd
    End Function

    Public Function CreateTableDef(Optional ByVal Name As Variant, Optional ByVal Attributes As Variant, Optional ByVal SourceTableName As Variant, Optional ByVal Connect As Variant) As Object
        EnsureOpen "CreateTableDef"
        Dim td As New TableDef
        If Not IsMissing(Name) Then
            Dim desc As TableDefDescriptor
            desc.TableName = CStr(Name)
            td.Init Me, desc
        End If
        If Not IsMissing(SourceTableName) Then td.SourceTableName = CStr(SourceTableName)
        If Not IsMissing(Connect) Then td.Connect = CStr(Connect)
        Set CreateTableDef = td
    End Function

    Public Function CreateRelation(Optional ByVal Name As Variant, Optional ByVal Table As Variant, Optional ByVal ForeignTable As Variant, Optional ByVal Attributes As Variant) As Relation
        EnsureOpen "CreateRelation"
        Dim rel As New Relation
        Dim rName As String, rTable As String, rForeign As String, rAttrs As Long
        If Not IsMissing(Name) Then rName = CStr(Name)
        If Not IsMissing(Table) Then rTable = CStr(Table)
        If Not IsMissing(ForeignTable) Then rForeign = CStr(ForeignTable)
        If Not IsMissing(Attributes) Then rAttrs = CLng(Attributes)
        rel.Init rName, rTable, rForeign, rAttrs
        Set CreateRelation = rel
    End Function
    ' =========================================================================
    ' Access SQL Grammar & Expression Execution Engine
    ' =========================================================================

    Private Function FindSqlClauseKeyword(ByVal s As String, ByVal kw As String) As Long
        Dim inSq As Boolean, inDq As Boolean, inBk As Long, inPar As Long
        Dim kwLen As Long, sLen As Long, i As Long
        Dim c As String, prevC As String, nextC As String
        kwLen = Len(kw)
        sLen = Len(s)
        If sLen < kwLen Then Exit Function
        For i = 1 To sLen - kwLen + 1
            c = Mid$(s, i, 1)
            If c = "'" And Not inDq Then
                inSq = Not inSq
            ElseIf c = """" And Not inSq Then
                inDq = Not inDq
            ElseIf c = "[" And Not inSq And Not inDq Then
                inBk = inBk + 1
            ElseIf c = "]" And Not inSq And Not inDq Then
                If inBk > 0 Then inBk = inBk - 1
            ElseIf c = "(" And Not inSq And Not inDq Then
                inPar = inPar + 1
            ElseIf c = ")" And Not inSq And Not inDq Then
                If inPar > 0 Then inPar = inPar - 1
            ElseIf Not inSq And Not inDq And inBk = 0 And inPar = 0 Then
                If StrComp(Mid$(s, i, kwLen), kw, vbTextCompare) = 0 Then
                    If i > 1 Then prevC = Mid$(s, i - 1, 1) Else prevC = " "
                    If i + kwLen <= sLen Then nextC = Mid$(s, i + kwLen, 1) Else nextC = " "
                    If (prevC = " " Or prevC = vbTab Or prevC = vbCr Or prevC = vbLf Or prevC = ")") And (nextC = " " Or nextC = vbTab Or nextC = vbCr Or nextC = vbLf Or nextC = "(") Then
                        FindSqlClauseKeyword = i
                        Exit Function
                    End If
                End If
            End If
        Next i
        FindSqlClauseKeyword = 0
    End Function

    Private Sub SplitSqlClauses(ByVal sql As String, ByRef outSelect As String, ByRef outFrom As String, ByRef outWhere As String, ByRef outOrderBy As String, ByRef outGroupBy As String, Optional ByRef outHaving As String = "")
        Dim stmt As SqlStatement
        stmt = SqlParser.ParseSql(sql)
        If stmt.StatementType = SqlStatementType.StmtSelect Then
            outSelect = stmt.SelectClause
            outFrom = stmt.FromClause
            outWhere = stmt.WhereClause
            outGroupBy = stmt.GroupByClause
            outHaving = stmt.HavingClause
            outOrderBy = stmt.OrderByClause
            Exit Sub
        End If
        Dim s As String
        s = Trim$(sql)
        If Right$(s, 1) = ";" Then s = Left$(s, Len(s) - 1)
        s = Trim$(s)
        outSelect = vbNullString
        outFrom = vbNullString
        outWhere = vbNullString
        outOrderBy = vbNullString
        outGroupBy = vbNullString
        outHaving = vbNullString
        Dim obPos As Long
        obPos = FindSqlClauseKeyword(s, "ORDER BY")
        If obPos > 0 Then
            outOrderBy = Trim$(Mid$(s, obPos + 8))
            s = Trim$(Left$(s, obPos - 1))
        End If
        Dim hvPos As Long
        hvPos = FindSqlClauseKeyword(s, "HAVING")
        If hvPos > 0 Then
            outHaving = Trim$(Mid$(s, hvPos + 6))
            s = Trim$(Left$(s, hvPos - 1))
        End If
        Dim gbPos As Long
        gbPos = FindSqlClauseKeyword(s, "GROUP BY")
        If gbPos > 0 Then
            outGroupBy = Trim$(Mid$(s, gbPos + 8))
            s = Trim$(Left$(s, gbPos - 1))
        End If
        Dim whPos As Long
        whPos = FindSqlClauseKeyword(s, "WHERE")
        If whPos > 0 Then
            outWhere = Trim$(Mid$(s, whPos + 5))
            s = Trim$(Left$(s, whPos - 1))
        End If
        Dim fromPos As Long
        fromPos = FindSqlClauseKeyword(s, "FROM")
        If fromPos > 0 Then
            outFrom = Trim$(Mid$(s, fromPos + 4))
            s = Trim$(Left$(s, fromPos - 1))
            If UCase$(Left$(s, 7)) = "SELECT " Then
                s = Trim$(Mid$(s, 8))
                If UCase$(Left$(s, 9)) = "DISTINCT " Then
                    s = Trim$(Mid$(s, 10))
                ElseIf UCase$(Left$(s, 12)) = "DISTINCTROW " Then
                    s = Trim$(Mid$(s, 13))
                End If
                If UCase$(Left$(s, 4)) = "TOP " Then
                    s = Trim$(Mid$(s, 5))
                    Dim spTop As Long
                    spTop = InStr(1, s, " ")
                    If spTop > 0 Then
                        s = Trim$(Mid$(s, spTop + 1))
                        If UCase$(Left$(s, 8)) = "PERCENT " Then
                            s = Trim$(Mid$(s, 9))
                        End If
                    End If
                End If
            End If
            outSelect = s
        Else
            If UCase$(Left$(s, 7)) = "SELECT " Then
                outSelect = Trim$(Mid$(s, 8))
            Else
                outFrom = s
            End If
        End If
    End Sub

    Private Function SplitSqlItems(ByVal s As String) As String()
        Dim items() As String
        Dim count As Long
        count = 0
        Dim inSq As Boolean, inDq As Boolean, inBk As Long, inPar As Long
        Dim i As Long, startIdx As Long, sLen As Long, c As String
        sLen = Len(s)
        startIdx = 1
        For i = 1 To sLen
            c = Mid$(s, i, 1)
            If c = "'" And Not inDq Then
                inSq = Not inSq
            ElseIf c = """" And Not inSq Then
                inDq = Not inDq
            ElseIf c = "[" And Not inSq And Not inDq Then
                inBk = inBk + 1
            ElseIf c = "]" And Not inSq And Not inDq Then
                If inBk > 0 Then inBk = inBk - 1
            ElseIf c = "(" And Not inSq And Not inDq Then
                inPar = inPar + 1
            ElseIf c = ")" And Not inSq And Not inDq Then
                If inPar > 0 Then inPar = inPar - 1
            ElseIf c = "," And Not inSq And Not inDq And inBk = 0 And inPar = 0 Then
                ReDim Preserve items(0 To count)
                items(count) = Trim$(Mid$(s, startIdx, i - startIdx))
                count = count + 1
                startIdx = i + 1
            End If
        Next i
        If startIdx <= sLen Then
            ReDim Preserve items(0 To count)
            items(count) = Trim$(Mid$(s, startIdx))
            count = count + 1
        End If
        SplitSqlItems = items
    End Function

    Private Function ExtractSqlTablePrefix(ByVal s As String) As String
        Dim res As String
        res = Trim$(Replace$(Replace$(s, "[", ""), "]", ""))
        Dim dotPos As Long
        dotPos = InStrRev(res, ".")
        If dotPos > 1 Then
            ExtractSqlTablePrefix = Trim$(Left$(res, dotPos - 1))
        Else
            ExtractSqlTablePrefix = vbNullString
        End If
    End Function

    Private Function CleanSqlColName(ByVal s As String) As String
        Dim res As String
        res = Trim$(s)
        res = Replace$(Replace$(res, "[", ""), "]", "")
        Dim dotPos As Long
        dotPos = InStrRev(res, ".")
        If dotPos > 0 Then res = Mid$(res, dotPos + 1)
        CleanSqlColName = Trim$(res)
    End Function

    Private Function IsSingleFuncCall(ByVal expr As String, ByVal funcPrefix As String, ByRef outInnerArg As String) As Boolean
        Dim s As String
        s = Trim$(expr)
        Dim pLen As Long
        pLen = Len(funcPrefix)
        If Len(s) <= pLen Then
            IsSingleFuncCall = False
            Exit Function
        End If
        If StrComp(Left$(s, pLen), funcPrefix, vbTextCompare) <> 0 Or Right$(s, 1) <> ")" Then
            IsSingleFuncCall = False
            Exit Function
        End If
        Dim depth As Long, i As Long
        Dim inSq As Boolean, inDq As Boolean, ch As String
        depth = 1
        For i = pLen + 1 To Len(s) - 1
            ch = Mid$(s, i, 1)
            If ch = "'" And Not inDq Then inSq = Not inSq
            If ch = """" And Not inSq Then inDq = Not inDq
            If Not inSq And Not inDq Then
                If ch = "(" Then depth = depth + 1
                If ch = ")" Then
                    depth = depth - 1
                    If depth = 0 Then
                        IsSingleFuncCall = False
                        Exit Function
                    End If
                End If
            End If
        Next i
        outInnerArg = Trim$(Mid$(s, pLen + 1, Len(s) - pLen - 1))
        IsSingleFuncCall = True
    End Function

    Private Sub ParseSelectItem(ByVal itemStr As String, ByRef outExpr As String, ByRef outAlias As String, ByRef outIsConcat As Boolean, ByRef outAggFunc As String)
        Dim s As String
        s = Trim$(itemStr)
        outIsConcat = False
        outAggFunc = vbNullString
        Dim asPos As Long
        asPos = FindSqlClauseKeyword(s, "AS")
        If asPos = 0 Then
            asPos = InStrRev(s, " AS ", -1, vbTextCompare)
        End If
        If asPos > 0 Then
            If Mid$(s, asPos, 1) = " " Then
                outAlias = CleanSqlColName(Mid$(s, asPos + 4))
            Else
                outAlias = CleanSqlColName(Mid$(s, asPos + 3))
            End If
            outExpr = Trim$(Left$(s, asPos - 1))
        Else
            outExpr = s
            outAlias = CleanSqlColName(s)
        End If
        Dim innerArg As String
        If IsSingleFuncCall(outExpr, "COUNT(", innerArg) Then
            outAggFunc = "COUNT"
            outExpr = innerArg
            If asPos = 0 Then outAlias = "CountOf" & CleanSqlColName(outExpr)
            Exit Sub
        ElseIf IsSingleFuncCall(outExpr, "SUM(", innerArg) Then
            outAggFunc = "SUM"
            outExpr = innerArg
            If asPos = 0 Then outAlias = "SumOf" & CleanSqlColName(outExpr)
            Exit Sub
        ElseIf IsSingleFuncCall(outExpr, "AVG(", innerArg) Then
            outAggFunc = "AVG"
            outExpr = innerArg
            If asPos = 0 Then outAlias = "AvgOf" & CleanSqlColName(outExpr)
            Exit Sub
        ElseIf IsSingleFuncCall(outExpr, "MIN(", innerArg) Then
            outAggFunc = "MIN"
            outExpr = innerArg
            If asPos = 0 Then outAlias = "MinOf" & CleanSqlColName(outExpr)
            Exit Sub
        ElseIf IsSingleFuncCall(outExpr, "MAX(", innerArg) Then
            outAggFunc = "MAX"
            outExpr = innerArg
            If asPos = 0 Then outAlias = "MaxOf" & CleanSqlColName(outExpr)
            Exit Sub
        ElseIf IsSingleFuncCall(outExpr, "FIRST(", innerArg) Then
            outAggFunc = "MIN"
            outExpr = innerArg
            If asPos = 0 Then outAlias = "FirstOf" & CleanSqlColName(outExpr)
            Exit Sub
        ElseIf IsSingleFuncCall(outExpr, "LAST(", innerArg) Then
            outAggFunc = "MAX"
            outExpr = innerArg
            If asPos = 0 Then outAlias = "LastOf" & CleanSqlColName(outExpr)
            Exit Sub
        End If
        Dim uExpr As String
        uExpr = UCase$(outExpr)
        If InStr(1, uExpr, "SUM(") > 0 Or InStr(1, uExpr, "COUNT(") > 0 Or InStr(1, uExpr, "AVG(") > 0 Or InStr(1, uExpr, "MIN(") > 0 Or InStr(1, uExpr, "MAX(") > 0 Then
            outAggFunc = "EXPR_AGG"
            Exit Sub
        End If
        Dim inSq As Boolean, inDq As Boolean, inPar As Long, i As Long, c As String
        For i = 1 To Len(outExpr)
            c = Mid$(outExpr, i, 1)
            If c = "'" And Not inDq Then inSq = Not inSq
            If c = """" And Not inSq Then inDq = Not inDq
            If Not inSq And Not inDq Then
                If c = "(" Then inPar = inPar + 1
                If c = ")" And inPar > 0 Then inPar = inPar - 1
                If c = "&" And inPar = 0 Then
                    outIsConcat = True
                    Exit For
                End If
            End If
        Next i
    End Sub

    Private Function EvaluateConcatExpr(ByVal expr As String, ByVal baseRs As Recordset) As String
        Dim parts() As String
        Dim pCount As Long
        pCount = 0
        Dim inSq As Boolean, inDq As Boolean, inPar As Long, i As Long, startIdx As Long, sLen As Long, c As String
        sLen = Len(expr)
        startIdx = 1
        For i = 1 To sLen
            c = Mid$(expr, i, 1)
            If c = "'" And Not inDq Then inSq = Not inSq
            If c = """" And Not inSq Then inDq = Not inDq
            If Not inSq And Not inDq Then
                If c = "(" Then inPar = inPar + 1
                If c = ")" And inPar > 0 Then inPar = inPar - 1
                If c = "&" And inPar = 0 Then
                    ReDim Preserve parts(0 To pCount)
                    parts(pCount) = Trim$(Mid$(expr, startIdx, i - startIdx))
                    pCount = pCount + 1
                    startIdx = i + 1
                End If
            End If
        Next i
        If startIdx <= sLen Then
            ReDim Preserve parts(0 To pCount)
            parts(pCount) = Trim$(Mid$(expr, startIdx))
            pCount = pCount + 1
        End If
        Dim fullRes As String
        fullRes = vbNullString
        Dim p As Long
        For p = 0 To pCount - 1
            Dim pt As String
            pt = Trim$(parts(p))
            If (Left$(pt, 1) = """" And Right$(pt, 1) = """") Or (Left$(pt, 1) = "'" And Right$(pt, 1) = "'") Then
                If Len(pt) >= 2 Then
                    fullRes = fullRes & Mid$(pt, 2, Len(pt) - 2)
                End If
            ElseIf UCase$(Left$(pt, 6)) = "SPACE(" And Right$(pt, 1) = ")" Then
                Dim nSp As Long
                nSp = Val(Mid$(pt, 7, Len(pt) - 7))
                If nSp > 0 Then fullRes = fullRes & String$(nSp, " ")
            Else
                Dim v As Variant
                v = EvaluateRowExpr(pt, baseRs)
                If Not IsNull(v) And Not IsEmpty(v) Then
                    fullRes = fullRes & CStr(v)
                End If
            End If
        Next p
        EvaluateConcatExpr = fullRes
    End Function

    Private Function EvaluateRowExpr(ByVal expr As String, ByVal baseRs As Recordset) As Variant
        Dim s As String
        s = StripOuterParens(expr)
        If Len(s) = 0 Then
            EvaluateRowExpr = Null
            Exit Function
        End If
        ' 1. String literal
        If (Left$(s, 1) = """" And Right$(s, 1) = """") Or (Left$(s, 1) = "'" And Right$(s, 1) = "'") Then
            If Len(s) >= 2 Then
                EvaluateRowExpr = Mid$(s, 2, Len(s) - 2)
            Else
                EvaluateRowExpr = vbNullString
            End If
            Exit Function
        End If
        ' 2. Date literal #...#
        If Left$(s, 1) = "#" And Right$(s, 1) = "#" And Len(s) > 2 Then
            Dim dtStr As String
            dtStr = Mid$(s, 2, Len(s) - 2)
            If IsDate(dtStr) Then
                EvaluateRowExpr = CDate(dtStr)
            Else
                EvaluateRowExpr = dtStr
            End If
            Exit Function
        End If
        ' 2b. Form Parameter Check
        Dim paramFound As Boolean
        Dim paramVal As Variant
        paramVal = GetFormParameter(s, paramFound)
        If paramFound Then
            EvaluateRowExpr = paramVal
            Exit Function
        End If
        ' 3. Boolean / Null / Date / Numeric literal
        Dim us As String
        us = UCase$(s)
        If us = "NULL" Then
            EvaluateRowExpr = Null
            Exit Function
        ElseIf us = "TRUE" Then
            EvaluateRowExpr = True
            Exit Function
        ElseIf us = "FALSE" Then
            EvaluateRowExpr = False
            Exit Function
        ElseIf us = "DATE()" Or us = "DATE" Then
            EvaluateRowExpr = VBA.Date
            Exit Function
        ElseIf us = "NOW()" Or us = "NOW" Then
            EvaluateRowExpr = VBA.Now
            Exit Function
        ElseIf IsNumeric(s) And InStr(1, s, "[") = 0 Then
            EvaluateRowExpr = CDbl(Val(s))
            Exit Function
        End If
        ' 4. Top-level string concatenation (&)
        Dim inSq As Boolean, inDq As Boolean, inBk As Long, inPar As Long
        Dim i As Long, sLen As Long, c As String
        sLen = Len(s)
        For i = 1 To sLen
            c = Mid$(s, i, 1)
            If c = "'" And Not inDq Then inSq = Not inSq
            If c = """" And Not inSq Then inDq = Not inDq
            If Not inSq And Not inDq Then
                If c = "[" Then inBk = inBk + 1
                If c = "]" And inBk > 0 Then inBk = inBk - 1
                If c = "(" Then inPar = inPar + 1
                If c = ")" And inPar > 0 Then inPar = inPar - 1
                If c = "&" And inBk = 0 And inPar = 0 Then
                    EvaluateRowExpr = EvaluateConcatExpr(s, baseRs)
                    Exit Function
                End If
            End If
        Next i
        ' 5. Top-level binary + or - (right-to-left for left-associativity)
        inSq = False: inDq = False: inBk = 0: inPar = 0
        Dim addSubPos As Long, addSubOp As String
        addSubPos = 0
        For i = 1 To sLen
            c = Mid$(s, i, 1)
            If c = "'" And Not inDq Then inSq = Not inSq
            If c = """" And Not inSq Then inDq = Not inDq
            If Not inSq And Not inDq Then
                If c = "[" Then inBk = inBk + 1
                If c = "]" And inBk > 0 Then inBk = inBk - 1
                If c = "(" Then inPar = inPar + 1
                If c = ")" And inPar > 0 Then inPar = inPar - 1
                If (c = "+" Or c = "-") And inBk = 0 And inPar = 0 And i > 1 Then
                    addSubPos = i
                    addSubOp = c
                End If
            End If
        Next i
        If addSubPos > 1 Then
            Dim lAdd As Variant, rAdd As Variant
            lAdd = EvaluateRowExpr(Left$(s, addSubPos - 1), baseRs)
            rAdd = EvaluateRowExpr(Mid$(s, addSubPos + 1), baseRs)
            If addSubOp = "+" Then
                If IsNumeric(lAdd) And IsNumeric(rAdd) Then
                    EvaluateRowExpr = CDbl(lAdd) + CDbl(rAdd)
                ElseIf IsNull(lAdd) And IsNumeric(rAdd) Then
                    EvaluateRowExpr = CDbl(rAdd)
                ElseIf IsNumeric(lAdd) And IsNull(rAdd) Then
                    EvaluateRowExpr = CDbl(lAdd)
                Else
                    EvaluateRowExpr = CStr(lAdd & "") & CStr(rAdd & "")
                End If
            Else
                EvaluateRowExpr = CDbl(Val(CStr(lAdd & ""))) - CDbl(Val(CStr(rAdd & "")))
            End If
            Exit Function
        End If
        ' 6. Top-level binary * or / (right-to-left)
        inSq = False: inDq = False: inBk = 0: inPar = 0
        Dim mulDivPos As Long, mulDivOp As String
        mulDivPos = 0
        For i = 1 To sLen
            c = Mid$(s, i, 1)
            If c = "'" And Not inDq Then inSq = Not inSq
            If c = """" And Not inSq Then inDq = Not inDq
            If Not inSq And Not inDq Then
                If c = "[" Then inBk = inBk + 1
                If c = "]" And inBk > 0 Then inBk = inBk - 1
                If c = "(" Then inPar = inPar + 1
                If c = ")" And inPar > 0 Then inPar = inPar - 1
                If (c = "*" Or c = "/") And inBk = 0 And inPar = 0 And i > 1 Then
                    mulDivPos = i
                    mulDivOp = c
                End If
            End If
        Next i
        If mulDivPos > 1 Then
            Dim lMul As Variant, rMul As Variant
            lMul = EvaluateRowExpr(Left$(s, mulDivPos - 1), baseRs)
            rMul = EvaluateRowExpr(Mid$(s, mulDivPos + 1), baseRs)
            If mulDivOp = "*" Then
                EvaluateRowExpr = CDbl(Val(CStr(lMul & ""))) * CDbl(Val(CStr(rMul & "")))
            Else
                Dim denom As Double
                denom = CDbl(Val(CStr(rMul & "")))
                If denom <> 0# Then
                    EvaluateRowExpr = CDbl(Val(CStr(lMul & ""))) / denom
                Else
                    EvaluateRowExpr = Null
                End If
            End If
            Exit Function
        End If
        ' 7. Scalar functions: Nz, Round, Format, DateValue, Year, Month, Day, IIf, Val, Trim
        Dim fnInner As String
        Dim fnArgs() As String
        Dim fnArgCnt As Long
        If IsSingleFuncCall(s, "NZ(", fnInner) Then
            fnArgs = SplitSqlItems(fnInner)
            fnArgCnt = UBound(fnArgs) + 1
            Dim nzVal As Variant
            nzVal = EvaluateRowExpr(fnArgs(0), baseRs)
            If IsNull(nzVal) Or IsEmpty(nzVal) Then
                If fnArgCnt >= 2 Then
                    EvaluateRowExpr = EvaluateRowExpr(fnArgs(1), baseRs)
                Else
                    EvaluateRowExpr = vbNullString
                End If
                Exit Function
            ElseIf VarType(nzVal) = vbString Then
                If Len(CStr(nzVal)) = 0 Then
                    If fnArgCnt >= 2 Then
                        EvaluateRowExpr = EvaluateRowExpr(fnArgs(1), baseRs)
                    Else
                        EvaluateRowExpr = vbNullString
                    End If
                    Exit Function
                End If
            End If
            EvaluateRowExpr = nzVal
            Exit Function
        ElseIf IsSingleFuncCall(s, "ROUND(", fnInner) Then
            fnArgs = SplitSqlItems(fnInner)
            fnArgCnt = UBound(fnArgs) + 1
            Dim rndVal As Variant
            rndVal = EvaluateRowExpr(fnArgs(0), baseRs)
            Dim rndDec As Long
            rndDec = 0
            If fnArgCnt >= 2 Then rndDec = CLng(Val(CStr(EvaluateRowExpr(fnArgs(1), baseRs) & "")))
            If IsNumeric(rndVal) Then
                EvaluateRowExpr = VBA.Round(CDbl(rndVal), rndDec)
            Else
                EvaluateRowExpr = rndVal
            End If
            Exit Function
        ElseIf IsSingleFuncCall(s, "FORMAT(", fnInner) Then
            fnArgs = SplitSqlItems(fnInner)
            fnArgCnt = UBound(fnArgs) + 1
            Dim fmtVal As Variant
            fmtVal = EvaluateRowExpr(fnArgs(0), baseRs)
            If IsNull(fmtVal) Or IsEmpty(fmtVal) Then
                EvaluateRowExpr = vbNullString
            ElseIf fnArgCnt >= 2 Then
                Dim fmtPat As String
                fmtPat = CStr(EvaluateRowExpr(fnArgs(1), baseRs) & "")
                On Error Resume Next
                EvaluateRowExpr = VBA.Format$(fmtVal, fmtPat)
                If Err.Number <> 0 Then
                    Err.Clear
                    EvaluateRowExpr = CStr(fmtVal)
                End If
                On Error GoTo 0
            Else
                EvaluateRowExpr = CStr(fmtVal)
            End If
            Exit Function
        ElseIf IsSingleFuncCall(s, "DATEVALUE(", fnInner) Then
            Dim dvVal As Variant
            dvVal = EvaluateRowExpr(fnInner, baseRs)
            If IsDate(dvVal) Then
                EvaluateRowExpr = VBA.DateValue(CDate(dvVal))
            Else
                EvaluateRowExpr = dvVal
            End If
            Exit Function
        ElseIf IsSingleFuncCall(s, "YEAR(", fnInner) Then
            Dim yrVal As Variant
            yrVal = EvaluateRowExpr(fnInner, baseRs)
            If IsDate(yrVal) Then
                EvaluateRowExpr = VBA.Year(CDate(yrVal))
            Else
                EvaluateRowExpr = Null
            End If
            Exit Function
        ElseIf IsSingleFuncCall(s, "MONTH(", fnInner) Then
            Dim moVal As Variant
            moVal = EvaluateRowExpr(fnInner, baseRs)
            If IsDate(moVal) Then
                EvaluateRowExpr = VBA.Month(CDate(moVal))
            Else
                EvaluateRowExpr = Null
            End If
            Exit Function
        ElseIf IsSingleFuncCall(s, "DAY(", fnInner) Then
            Dim dyVal As Variant
            dyVal = EvaluateRowExpr(fnInner, baseRs)
            If IsDate(dyVal) Then
                EvaluateRowExpr = VBA.Day(CDate(dyVal))
            Else
                EvaluateRowExpr = Null
            End If
            Exit Function
        ElseIf IsSingleFuncCall(s, "IIF(", fnInner) Then
            fnArgs = SplitSqlItems(fnInner)
            fnArgCnt = UBound(fnArgs) + 1
            If fnArgCnt >= 3 Then
                If EvaluateWhereClauseTree(fnArgs(0), baseRs) Then
                    EvaluateRowExpr = EvaluateRowExpr(fnArgs(1), baseRs)
                Else
                    EvaluateRowExpr = EvaluateRowExpr(fnArgs(2), baseRs)
                End If
            Else
                EvaluateRowExpr = Null
            End If
            Exit Function
        ElseIf IsSingleFuncCall(s, "VAL(", fnInner) Then
            EvaluateRowExpr = Val(CStr(EvaluateRowExpr(fnInner, baseRs) & ""))
            Exit Function
        ElseIf IsSingleFuncCall(s, "TRIM(", fnInner) Or IsSingleFuncCall(s, "TRIM$(", fnInner) Then
            EvaluateRowExpr = Trim$(CStr(EvaluateRowExpr(fnInner, baseRs) & ""))
            Exit Function
        ElseIf IsSingleFuncCall(s, "SUM(", fnInner) Then
            EvaluateRowExpr = ComputeAggregateColumn(baseRs, "SUM", fnInner)
            Exit Function
        ElseIf IsSingleFuncCall(s, "COUNT(", fnInner) Then
            EvaluateRowExpr = ComputeAggregateColumn(baseRs, "COUNT", fnInner)
            Exit Function
        ElseIf IsSingleFuncCall(s, "AVG(", fnInner) Then
            EvaluateRowExpr = ComputeAggregateColumn(baseRs, "AVG", fnInner)
            Exit Function
        ElseIf IsSingleFuncCall(s, "MIN(", fnInner) Or IsSingleFuncCall(s, "FIRST(", fnInner) Then
            EvaluateRowExpr = ComputeAggregateColumn(baseRs, "MIN", fnInner)
            Exit Function
        ElseIf IsSingleFuncCall(s, "MAX(", fnInner) Or IsSingleFuncCall(s, "LAST(", fnInner) Then
            EvaluateRowExpr = ComputeAggregateColumn(baseRs, "MAX", fnInner)
            Exit Function
        ElseIf IsSingleFuncCall(s, "DLOOKUP(", fnInner) Or IsSingleFuncCall(s, "DSUM(", fnInner) Or IsSingleFuncCall(s, "DCOUNT(", fnInner) Or IsSingleFuncCall(s, "DMIN(", fnInner) Or IsSingleFuncCall(s, "DMAX(", fnInner) Then
            fnArgs = SplitSqlItems(fnInner)
            fnArgCnt = UBound(fnArgs) + 1
            If fnArgCnt >= 2 Then
                Dim dExpr As String, dDom As String, dCrit As String
                dExpr = CStr(EvaluateRowExpr(fnArgs(0), baseRs) & "")
                dDom = CStr(EvaluateRowExpr(fnArgs(1), baseRs) & "")
                dCrit = vbNullString
                If fnArgCnt >= 3 Then dCrit = CStr(EvaluateRowExpr(fnArgs(2), baseRs) & "")
                Dim uFn As String
                uFn = UCase$(Left$(Trim$(s), 5))
                If uFn = "DLOOK" Then
                    EvaluateRowExpr = Me.DLookup(dExpr, dDom, dCrit)
                ElseIf uFn = "DSUM(" Then
                    EvaluateRowExpr = Me.DSum(dExpr, dDom, dCrit)
                ElseIf uFn = "DCOUN" Then
                    EvaluateRowExpr = Me.DCount(dExpr, dDom, dCrit)
                ElseIf uFn = "DMIN(" Then
                    EvaluateRowExpr = Me.DMin(dExpr, dDom, dCrit)
                ElseIf uFn = "DMAX(" Then
                    EvaluateRowExpr = Me.DMax(dExpr, dDom, dCrit)
                End If
            Else
                EvaluateRowExpr = Null
            End If
            Exit Function
        End If
        ' 8. Direct column lookup in baseRs
        If Not baseRs Is Nothing Then
            If Not baseRs.EOF Then
                Dim fVal As Variant
                On Error Resume Next
                fVal = baseRs.Fields(Trim$(s)).Value
                If Err.Number <> 0 Then
                    Err.Clear
                    fVal = baseRs.Fields(CleanSqlColName(s)).Value
                End If
                If Err.Number = 0 Then
                    On Error GoTo 0
                    EvaluateRowExpr = fVal
                    Exit Function
                End If
                Err.Clear
                On Error GoTo 0
            End If
        End If
        EvaluateRowExpr = Null
    End Function

    Private Function StripOuterParens(ByVal s As String) As String
        Dim res As String
        res = Trim$(s)
        Do While Left$(res, 1) = "(" And Right$(res, 1) = ")"
            Dim depth As Long, i As Long, isEnclosing As Boolean
            Dim inSq As Boolean, inDq As Boolean, ch As String
            isEnclosing = True
            depth = 0
            For i = 1 To Len(res) - 1
                ch = Mid$(res, i, 1)
                If ch = "'" And Not inDq Then inSq = Not inSq
                If ch = """" And Not inSq Then inDq = Not inDq
                If Not inSq And Not inDq Then
                    If ch = "(" Then depth = depth + 1
                    If ch = ")" Then depth = depth - 1
                    If depth = 0 Then
                        isEnclosing = False
                        Exit For
                    End If
                End If
            Next i
            If isEnclosing Then
                res = Trim$(Mid$(res, 2, Len(res) - 2))
            Else
                Exit Do
            End If
        Loop
        StripOuterParens = res
    End Function
    ' Finds top-level logical AND while skipping the AND belonging to BETWEEN ... AND ...

    Private Function FindWhereLogicalAnd(ByVal s As String) As Long
        Dim inSq As Boolean, inDq As Boolean, inBk As Long, inPar As Long
        Dim inBetween As Boolean
        Dim sLen As Long, i As Long
        Dim c As String, prevC As String, nextC As String
        sLen = Len(s)
        If sLen < 3 Then
            FindWhereLogicalAnd = 0
            Exit Function
        End If
        inBetween = False
        For i = 1 To sLen
            c = Mid$(s, i, 1)
            If c = "'" And Not inDq Then
                inSq = Not inSq
            ElseIf c = """" And Not inSq Then
                inDq = Not inDq
            ElseIf c = "[" And Not inSq And Not inDq Then
                inBk = inBk + 1
            ElseIf c = "]" And Not inSq And Not inDq Then
                If inBk > 0 Then inBk = inBk - 1
            ElseIf c = "(" And Not inSq And Not inDq Then
                inPar = inPar + 1
            ElseIf c = ")" And Not inSq And Not inDq Then
                If inPar > 0 Then inPar = inPar - 1
            ElseIf Not inSq And Not inDq And inBk = 0 And inPar = 0 Then
                If i + 6 <= sLen Then
                    If StrComp(Mid$(s, i, 7), "BETWEEN", vbTextCompare) = 0 Then
                        If i > 1 Then prevC = Mid$(s, i - 1, 1) Else prevC = " "
                        If i + 7 <= sLen Then nextC = Mid$(s, i + 7, 1) Else nextC = " "
                        If (prevC = " " Or prevC = vbTab Or prevC = vbCr Or prevC = vbLf Or prevC = ")") And (nextC = " " Or nextC = vbTab Or nextC = vbCr Or nextC = vbLf Or nextC = "(") Then
                            inBetween = True
                        End If
                    End If
                End If
                If i + 2 <= sLen Then
                    If StrComp(Mid$(s, i, 3), "AND", vbTextCompare) = 0 Then
                        If i > 1 Then prevC = Mid$(s, i - 1, 1) Else prevC = " "
                        If i + 3 <= sLen Then nextC = Mid$(s, i + 3, 1) Else nextC = " "
                        If (prevC = " " Or prevC = vbTab Or prevC = vbCr Or prevC = vbLf Or prevC = ")") And (nextC = " " Or nextC = vbTab Or nextC = vbCr Or nextC = vbLf Or nextC = "(") Then
                            If inBetween Then
                                inBetween = False
                            Else
                                FindWhereLogicalAnd = i
                                Exit Function
                            End If
                        End If
                    End If
                End If
            End If
        Next i
        FindWhereLogicalAnd = 0
    End Function

    Private Function IsUnboundWhereParameter(ByVal expr As String) As Boolean
        Dim u As String
        u = NormalizeFormParamKey(expr)
        If Len(u) = 0 Then
            IsUnboundWhereParameter = False
            Exit Function
        End If
        Dim found As Boolean
        GetFormParameter u, found
        If Not found Then
            Dim bangPos As Long
            bangPos = InStrRev(u, "!")
            If bangPos > 0 Then
                GetFormParameter Mid$(u, bangPos + 1), found
            End If
        End If
        If found Then
            IsUnboundWhereParameter = False
            Exit Function
        End If
        If InStr(1, u, "!") > 0 Or Left$(u, 6) = "FORMS!" Or Left$(u, 7) = "PARENT!" Or Left$(u, 5) = "FORM!" Or InStr(1, u, "TEMPVARS") > 0 Or InStr(1, u, "GET_USERID(") > 0 Or InStr(1, u, "DLOOKUP(") > 0 Or InStr(1, u, "DSUM(") > 0 Or InStr(1, u, "DCOUNT(") > 0 Then
            IsUnboundWhereParameter = True
        Else
            IsUnboundWhereParameter = False
        End If
    End Function
    ' Evaluates full WHERE tree supporting AND, OR, BETWEEN...AND, parentheses, LIKE, IS NULL, IS NOT NULL, =, <>, <, >, <=, >=

    Private Function EvaluateWhereClauseTree(ByVal expr As String, ByVal baseRs As Recordset) As Boolean
        Dim s As String
        s = StripOuterParens(expr)
        If Len(s) = 0 Then
            EvaluateWhereClauseTree = True
            Exit Function
        End If
        ' 1. Split by top-level OR
        Dim orPos As Long
        orPos = FindSqlClauseKeyword(s, "OR")
        If orPos > 0 Then
            Dim leftOr As String, rightOr As String
            leftOr = Trim$(Left$(s, orPos - 1))
            rightOr = Trim$(Mid$(s, orPos + 2))
            EvaluateWhereClauseTree = EvaluateWhereClauseTree(leftOr, baseRs) Or EvaluateWhereClauseTree(rightOr, baseRs)
            Exit Function
        End If
        ' 2. Split by top-level AND (ignoring AND inside BETWEEN ... AND ...)
        Dim andPos As Long
        andPos = FindWhereLogicalAnd(s)
        If andPos > 0 Then
            Dim leftAnd As String, rightAnd As String
            leftAnd = Trim$(Left$(s, andPos - 1))
            rightAnd = Trim$(Mid$(s, andPos + 3))
            EvaluateWhereClauseTree = EvaluateWhereClauseTree(leftAnd, baseRs) And EvaluateWhereClauseTree(rightAnd, baseRs)
            Exit Function
        End If
        EvaluateWhereClauseTree = EvaluateWhereCondition(s, baseRs)
    End Function

    Private Function EvaluateWhereCondition(ByVal condText As String, ByVal baseRs As Recordset) As Boolean
        Dim s As String
        s = StripOuterParens(condText)
        Dim us As String
        us = UCase$(s)
        If Left$(us, 4) = "NOT " Or Left$(us, 4) = "NOT(" Then
            EvaluateWhereCondition = Not EvaluateWhereClauseTree(Trim$(Mid$(s, 4)), baseRs)
            Exit Function
        End If
        ' Check IS NOT NULL / IS NULL
        If Right$(us, 11) = "IS NOT NULL" Then
            Dim nnExpr As String
            nnExpr = Trim$(Left$(s, Len(s) - 11))
            If IsUnboundWhereParameter(nnExpr) Then
                EvaluateWhereCondition = True
                Exit Function
            End If
            Dim nnVal As Variant
            nnVal = EvaluateRowExpr(nnExpr, baseRs)
            EvaluateWhereCondition = Not (IsNull(nnVal) Or IsEmpty(nnVal))
            Exit Function
        ElseIf Right$(us, 7) = "IS NULL" Then
            Dim nExpr As String
            nExpr = Trim$(Left$(s, Len(s) - 7))
            If IsUnboundWhereParameter(nExpr) Then
                EvaluateWhereCondition = True
                Exit Function
            End If
            Dim nVal As Variant
            nVal = EvaluateRowExpr(nExpr, baseRs)
            EvaluateWhereCondition = (IsNull(nVal) Or IsEmpty(nVal))
            Exit Function
        End If
        ' Check BETWEEN ... AND ...
        Dim btwPos As Long
        btwPos = FindSqlClauseKeyword(s, "BETWEEN")
        If btwPos > 0 Then
            Dim btwLeftExpr As String
            Dim btwRest As String
            btwLeftExpr = Trim$(Left$(s, btwPos - 1))
            btwRest = Trim$(Mid$(s, btwPos + 7))
            Dim btwAndPos As Long
            btwAndPos = FindSqlClauseKeyword(btwRest, "AND")
            If btwAndPos > 0 Then
                Dim btwLowExpr As String, btwHighExpr As String
                btwLowExpr = Trim$(Left$(btwRest, btwAndPos - 1))
                btwHighExpr = Trim$(Mid$(btwRest, btwAndPos + 3))
                If IsUnboundWhereParameter(btwLeftExpr) Or IsUnboundWhereParameter(btwLowExpr) Or IsUnboundWhereParameter(btwHighExpr) Then
                    EvaluateWhereCondition = True
                    Exit Function
                End If
                Dim vBtwCell As Variant, vBtwLow As Variant, vBtwHigh As Variant
                vBtwCell = EvaluateRowExpr(btwLeftExpr, baseRs)
                vBtwLow = EvaluateRowExpr(btwLowExpr, baseRs)
                vBtwHigh = EvaluateRowExpr(btwHighExpr, baseRs)
                If IsNull(vBtwLow) Or IsNull(vBtwHigh) Then
                    EvaluateWhereCondition = True
                ElseIf IsNull(vBtwCell) Then
                    EvaluateWhereCondition = False
                Else
                    EvaluateWhereCondition = (CompareSortCells(vBtwCell, vBtwLow, False) >= 0 And CompareSortCells(vBtwCell, vBtwHigh, False) <= 0)
                End If
                Exit Function
            End If
        End If
        ' Check LIKE operator
        Dim likePos As Long
        likePos = FindSqlClauseKeyword(s, "LIKE")
        If likePos > 0 Then
            Dim likeLeftRaw As String
            Dim likePat As String
            likeLeftRaw = StripOuterParens(Left$(s, likePos - 1))
            likePat = StripOuterParens(Trim$(Mid$(s, likePos + 4)))
            If IsUnboundWhereParameter(likeLeftRaw) Or IsUnboundWhereParameter(likePat) Then
                EvaluateWhereCondition = True
                Exit Function
            End If
            If (Left$(likePat, 1) = "'" And Right$(likePat, 1) = "'") Or (Left$(likePat, 1) = """" And Right$(likePat, 1) = """") Then
                likePat = Mid$(likePat, 2, Len(likePat) - 2)
            End If
            likePat = Replace$(likePat, "%", "*")
            likePat = Replace$(likePat, "_", "?")
            Dim likeCellVal As Variant
            likeCellVal = EvaluateRowExpr(likeLeftRaw, baseRs)
            If IsNull(likeCellVal) Or IsEmpty(likeCellVal) Then
                EvaluateWhereCondition = False
            Else
                Dim normLikeCell As String, normLikePat As String
                normLikeCell = ArabicCollationHelper.NormalizeArabicForComparison(UCase$(CStr(likeCellVal)))
                normLikePat = ArabicCollationHelper.NormalizeArabicForComparison(UCase$(likePat))
                EvaluateWhereCondition = (normLikeCell Like normLikePat)
            End If
            Exit Function
        End If
        Dim opPos As Long
        Dim opStr As String
        If InStr(1, s, "<>") > 0 Then
            opPos = InStr(1, s, "<>")
            opStr = "<>"
        ElseIf InStr(1, s, "<=") > 0 Then
            opPos = InStr(1, s, "<=")
            opStr = "<="
        ElseIf InStr(1, s, ">=") > 0 Then
            opPos = InStr(1, s, ">=")
            opStr = ">="
        ElseIf InStr(1, s, "<") > 0 Then
            opPos = InStr(1, s, "<")
            opStr = "<"
        ElseIf InStr(1, s, ">") > 0 Then
            opPos = InStr(1, s, ">")
            opStr = ">"
        ElseIf InStr(1, s, "=") > 0 Then
            opPos = InStr(1, s, "=")
            opStr = "="
        Else
            EvaluateWhereCondition = True
            Exit Function
        End If
        Dim leftRaw As String
        leftRaw = StripOuterParens(Left$(s, opPos - 1))
        Dim leftPart As String
        leftPart = CleanSqlColName(leftRaw)
        Dim rightPart As String
        rightPart = StripOuterParens(Trim$(Mid$(s, opPos + Len(opStr))))
        If IsUnboundWhereParameter(leftRaw) Or IsUnboundWhereParameter(rightPart) Then
            EvaluateWhereCondition = True
            Exit Function
        End If
        Dim cellVal As Variant
        On Error Resume Next
        cellVal = baseRs.Fields(leftRaw).Value
        If Err.Number <> 0 Then
            Err.Clear
            cellVal = baseRs.Fields(leftPart).Value
            If Err.Number <> 0 Then
                Err.Clear
                cellVal = EvaluateRowExpr(leftRaw, baseRs)
            End If
        End If
        On Error GoTo 0
        If IsNull(cellVal) Or IsEmpty(cellVal) Then
            If opStr = "<>" Then
                EvaluateWhereCondition = True
            Else
                EvaluateWhereCondition = False
            End If
            Exit Function
        End If
        If (Left$(rightPart, 1) = "'" And Right$(rightPart, 1) = "'") Or (Left$(rightPart, 1) = """" And Right$(rightPart, 1) = """") Then
            Dim strTarget As String
            strTarget = Mid$(rightPart, 2, Len(rightPart) - 2)
            Dim strCell As String
            strCell = CStr(cellVal)
            If Left$(strCell, 1) = Chr$(3) Then strCell = Mid$(strCell, 2)
            Dim normStrCell As String, normStrTarget As String
            normStrCell = ArabicCollationHelper.NormalizeArabicForComparison(strCell)
            normStrTarget = ArabicCollationHelper.NormalizeArabicForComparison(strTarget)
            Select Case opStr
                Case "=": EvaluateWhereCondition = (StrComp(normStrCell, normStrTarget, vbTextCompare) = 0)
                Case "<>": EvaluateWhereCondition = (StrComp(normStrCell, normStrTarget, vbTextCompare) <> 0)
                Case "<": EvaluateWhereCondition = (StrComp(normStrCell, normStrTarget, vbTextCompare) < 0)
                Case ">": EvaluateWhereCondition = (StrComp(normStrCell, normStrTarget, vbTextCompare) > 0)
                Case "<=": EvaluateWhereCondition = (StrComp(normStrCell, normStrTarget, vbTextCompare) <= 0)
                Case ">=": EvaluateWhereCondition = (StrComp(normStrCell, normStrTarget, vbTextCompare) >= 0)
                Case Else: EvaluateWhereCondition = False
            End Select
            Exit Function
        End If
        If IsNumeric(rightPart) Then
            Dim numTarget As Double, numCell As Double
            On Error Resume Next
            numTarget = CDbl(Val(rightPart))
            numCell = CDbl(cellVal)
            If Err.Number = 0 Then
                Select Case opStr
                    Case "=": EvaluateWhereCondition = (numCell = numTarget)
                    Case "<>": EvaluateWhereCondition = (numCell <> numTarget)
                    Case "<": EvaluateWhereCondition = (numCell < numTarget)
                    Case ">": EvaluateWhereCondition = (numCell > numTarget)
                    Case "<=": EvaluateWhereCondition = (numCell <= numTarget)
                    Case ">=": EvaluateWhereCondition = (numCell >= numTarget)
                End Select
                On Error GoTo 0
                Exit Function
            End If
            Err.Clear
            On Error GoTo 0
        End If
        Dim rhsVal As Variant
        rhsVal = EvaluateRowExpr(rightPart, baseRs)
        If Not IsNull(rhsVal) And Not IsEmpty(rhsVal) Then
            Dim cmpRes As Long
            cmpRes = CompareSortCells(cellVal, rhsVal, False)
            Select Case opStr
                Case "=": EvaluateWhereCondition = (cmpRes = 0)
                Case "<>": EvaluateWhereCondition = (cmpRes <> 0)
                Case "<": EvaluateWhereCondition = (cmpRes < 0)
                Case ">": EvaluateWhereCondition = (cmpRes > 0)
                Case "<=": EvaluateWhereCondition = (cmpRes <= 0)
                Case ">=": EvaluateWhereCondition = (cmpRes >= 0)
                Case Else: EvaluateWhereCondition = True
            End Select
            Exit Function
        End If
        Dim fallbackCell As String, fallbackRight As String
        fallbackCell = ArabicCollationHelper.NormalizeArabicForComparison(UCase$(Trim$(CStr(cellVal))))
        fallbackRight = ArabicCollationHelper.NormalizeArabicForComparison(UCase$(Trim$(rightPart)))
        Select Case opStr
            Case "=": EvaluateWhereCondition = (fallbackCell = fallbackRight)
            Case "<>": EvaluateWhereCondition = (fallbackCell <> fallbackRight)
            Case Else: EvaluateWhereCondition = True
        End Select
    End Function

    Private Function ParseJoinClause(ByVal fromStr As String, ByRef outJoinType As String, ByRef outLeftTable As String, ByRef outRightTable As String, ByRef outLeftKey As String, ByRef outRightKey As String, Optional ByRef outLeftKeyTbl As String = "", Optional ByRef outRightKeyTbl As String = "") As Boolean
        Dim s As String
        s = StripOuterParens(fromStr)
        Dim joinPos As Long
        Dim joinKwLen As Long
        Dim jType As String
        joinPos = 0
        joinKwLen = 0
        ' Scan at top-level (inPar = 0) for the outermost (rightmost) INNER JOIN / LEFT JOIN / RIGHT JOIN
        Dim inSq As Boolean, inDq As Boolean, inBk As Long, inPar As Long
        Dim i As Long, sLen As Long, c As String
        sLen = Len(s)
        For i = 1 To sLen
            c = Mid$(s, i, 1)
            If c = "'" And Not inDq Then
                inSq = Not inSq
            ElseIf c = """" And Not inSq Then
                inDq = Not inDq
            ElseIf c = "[" And Not inSq And Not inDq Then
                inBk = inBk + 1
            ElseIf c = "]" And Not inSq And Not inDq Then
                If inBk > 0 Then inBk = inBk - 1
            ElseIf c = "(" And Not inSq And Not inDq Then
                inPar = inPar + 1
            ElseIf c = ")" And Not inSq And Not inDq Then
                If inPar > 0 Then inPar = inPar - 1
            ElseIf Not inSq And Not inDq And inBk = 0 And inPar = 0 Then
                If i + 11 <= sLen Then
                    If StrComp(Mid$(s, i, 12), " INNER JOIN ", vbTextCompare) = 0 Then
                        joinPos = i
                        jType = "INNER"
                        joinKwLen = 12
                    ElseIf StrComp(Mid$(s, i, 12), " RIGHT JOIN ", vbTextCompare) = 0 Then
                        joinPos = i
                        jType = "RIGHT"
                        joinKwLen = 12
                    End If
                End If
                If i + 10 <= sLen Then
                    If StrComp(Mid$(s, i, 11), " LEFT JOIN ", vbTextCompare) = 0 Then
                        joinPos = i
                        jType = "LEFT"
                        joinKwLen = 11
                    End If
                End If
            End If
        Next i
        If joinPos = 0 Then
            ParseJoinClause = False
            Exit Function
        End If
        outJoinType = jType
        Dim rawLeft As String
        rawLeft = StripOuterParens(Left$(s, joinPos - 1))
        If InStr(1, rawLeft, " JOIN ", vbTextCompare) > 0 Then
            outLeftTable = rawLeft
        Else
            outLeftTable = CleanSqlColName(rawLeft)
        End If
        Dim afterJoin As String
        afterJoin = Trim$(Mid$(s, joinPos + joinKwLen))
        Dim onPos As Long
        onPos = FindSqlClauseKeyword(afterJoin, "ON")
        If onPos = 0 Then
            onPos = InStr(1, afterJoin, " ON ", vbTextCompare)
        End If
        If onPos = 0 Then
            ParseJoinClause = False
            Exit Function
        End If
        Dim rawRight As String
        rawRight = StripOuterParens(Left$(afterJoin, onPos - 1))
        If InStr(1, rawRight, " JOIN ", vbTextCompare) > 0 Then
            outRightTable = rawRight
        Else
            outRightTable = CleanSqlColName(rawRight)
        End If
        Dim onExpr As String
        If Mid$(afterJoin, onPos, 1) = " " Then
            onExpr = StripOuterParens(Trim$(Mid$(afterJoin, onPos + 4)))
        Else
            onExpr = StripOuterParens(Trim$(Mid$(afterJoin, onPos + 2)))
        End If
        Dim andInOn As Long
        andInOn = FindSqlClauseKeyword(onExpr, "AND")
        If andInOn > 0 Then
            onExpr = StripOuterParens(Trim$(Left$(onExpr, andInOn - 1)))
        End If
        Dim eqPos As Long
        eqPos = InStr(1, onExpr, "=")
        If eqPos > 0 Then
            Dim lhsRaw As String, rhsRaw As String
            Dim lhsTbl As String, rhsTbl As String
            lhsRaw = StripOuterParens(Left$(onExpr, eqPos - 1))
            rhsRaw = StripOuterParens(Mid$(onExpr, eqPos + 1))
            lhsTbl = ExtractSqlTablePrefix(lhsRaw)
            rhsTbl = ExtractSqlTablePrefix(rhsRaw)

            If (Len(lhsTbl) > 0 And StrComp(lhsTbl, CleanSqlColName(outRightTable), vbTextCompare) = 0) Or (Len(rhsTbl) > 0 And StrComp(rhsTbl, CleanSqlColName(outLeftTable), vbTextCompare) = 0) Then
                outLeftKey = CleanSqlColName(rhsRaw)
                outRightKey = CleanSqlColName(lhsRaw)
                outLeftKeyTbl = rhsTbl
                outRightKeyTbl = lhsTbl
            Else
                outLeftKey = CleanSqlColName(lhsRaw)
                outRightKey = CleanSqlColName(rhsRaw)
                outLeftKeyTbl = lhsTbl
                outRightKeyTbl = rhsTbl
            End If
        End If
        ParseJoinClause = True
    End Function
    ' Fast QuickSort O(N log N) replacing O(N^2) Bubble Sort

    Private Sub SortProjectedRows(ByRef rowsCol As Collection, ByVal colIdx As Long, ByVal isDesc As Boolean)
        If rowsCol.Count <= 1 Then Exit Sub
        Dim arr() As Variant
        ReDim arr(0 To rowsCol.Count - 1)
        Dim i As Long
        For i = 1 To rowsCol.Count
            arr(i - 1) = rowsCol(i)
        Next i
        QuickSortRowArray arr, 0, UBound(arr), colIdx, isDesc
        Set rowsCol = New Collection
        For i = 0 To UBound(arr)
            rowsCol.Add arr(i)
        Next i
    End Sub

    Private Sub QuickSortRowArray(ByRef arr() As Variant, ByVal low As Long, ByVal high As Long, ByVal colIdx As Long, ByVal isDesc As Boolean)
        Dim i As Long, j As Long
        Dim pivotRow As Variant, pivotVal As Variant, temp As Variant
        i = low
        j = high
        pivotRow = arr((low + high) \ 2)
        pivotVal = pivotRow(colIdx)
        Do While i <= j
            Do While CompareSortCells(arr(i)(colIdx), pivotVal, isDesc) < 0
                i = i + 1
            Loop
            Do While CompareSortCells(arr(j)(colIdx), pivotVal, isDesc) > 0
                j = j - 1
            Loop
            If i <= j Then
                temp = arr(i)
                arr(i) = arr(j)
                arr(j) = temp
                i = i + 1
                j = j - 1
            End If
        Loop
        If low < j Then QuickSortRowArray arr, low, j, colIdx, isDesc
        If i < high Then QuickSortRowArray arr, i, high, colIdx, isDesc
    End Sub

    Private Function CompareSortCells(ByVal vI As Variant, ByVal vJ As Variant, ByVal isDesc As Boolean) As Long
        Dim cmp As Long
        If IsNull(vI) And IsNull(vJ) Then
            cmp = 0
        ElseIf IsNull(vI) Then
            cmp = -1
        ElseIf IsNull(vJ) Then
            cmp = 1
        ElseIf IsNumeric(vI) And IsNumeric(vJ) Then
            If CDbl(vI) < CDbl(vJ) Then
                cmp = -1
            ElseIf CDbl(vI) > CDbl(vJ) Then
                cmp = 1
            Else
                cmp = 0
            End If
        Else
            Dim normVI As String, normVJ As String
            normVI = ArabicCollationHelper.NormalizeArabicForComparison(CStr(vI))
            normVJ = ArabicCollationHelper.NormalizeArabicForComparison(CStr(vJ))
            cmp = StrComp(normVI, normVJ, vbTextCompare)
            If cmp = 0 Then
                cmp = StrComp(CStr(vI), CStr(vJ), vbTextCompare)
            End If
        End If
        If isDesc Then CompareSortCells = -cmp Else CompareSortCells = cmp
    End Function

    Private Function NormalizeJoinKeyVal(ByVal v As Variant) As String
        If IsNull(v) Or IsEmpty(v) Then
            NormalizeJoinKeyVal = ""
        ElseIf IsNumeric(v) Then
            NormalizeJoinKeyVal = Trim$(Str$(CDbl(v)))
        Else
            NormalizeJoinKeyVal = UCase$(Trim$(CStr(v)))
        End If
    End Function

    Public Function OpenRecordset(ByVal Source As String, Optional ByVal RecordsetType As Variant, Optional ByVal Options As Variant, Optional ByVal LockEdit As Variant) As Recordset
        EnsureOpen "OpenRecordset"
        Me.RefreshIfModified
        Dim rawQuery As String
        rawQuery = Trim$(Source)
        If UCase$(Left$(rawQuery, 10)) = "TRANSFORM " Then
            Err.Raise vbObjectError + 3075, "Database.OpenRecordset", "Crosstab query (TRANSFORM) is not supported for direct datasheet rendering. Please inspect in SQL View."
        End If
        If UCase$(Left$(rawQuery, 11)) = "PARAMETERS " Then
            Dim semiPos As Long
            semiPos = InStr(1, rawQuery, ";")
            If semiPos > 0 Then
                rawQuery = Trim$(Mid$(rawQuery, semiPos + 1))
            End If
        End If
        Dim selectClause As String
        Dim fromClause As String
        Dim whereClause As String
        Dim orderByClause As String
        Dim groupByClause As String
        Dim havingClause As String
        If UCase$(Left$(rawQuery, 7)) = "SELECT " Then
            SplitSqlClauses rawQuery, selectClause, fromClause, whereClause, orderByClause, groupByClause, havingClause
        Else
            Dim cleanObj As String
            cleanObj = Trim$(Replace$(Replace$(Replace$(rawQuery, "[", ""), "]", ""), ";", ""))
            fromClause = cleanObj
            selectClause = "*"
            whereClause = vbNullString
            orderByClause = vbNullString
        End If
        ' Handle scalar expression query without FROM (e.g., SELECT 1+1 AS ExprResult)
        If Len(Trim$(fromClause)) = 0 And Len(Trim$(selectClause)) > 0 Then
            Dim scalarDesc As TableDefDescriptor
            scalarDesc.TableName = "ScalarResult"
            scalarDesc.RowCount = 1
            scalarDesc.ColumnCount = 1
            ReDim scalarDesc.Columns(0 To 0)
            scalarDesc.Columns(0).Name = "ExprResult"
            scalarDesc.Columns(0).ColType = JetColumnType.ColText
            Dim scalarRows As New Collection
            Dim sRow(0 To 0) As Variant
            sRow(0) = ParseSqlLiteralValue(selectClause)
            scalarRows.Add sRow
            Dim scalarRs As New Recordset
            scalarRs.Init Me, scalarDesc, scalarRows
            Set OpenRecordset = scalarRs
            Exit Function
        End If
        ' Check if fromClause is a QueryDef
        Dim qdObj As QueryDef
        Dim cleanFrom As String
        cleanFrom = CleanSqlColName(fromClause)
        On Error Resume Next
        Set qdObj = m_queryDefs.Item(cleanFrom)
        On Error GoTo 0
        If Not qdObj Is Nothing And UCase$(Left$(rawQuery, 7)) <> "SELECT " Then
            Dim qSql As String
            qSql = Trim$(qdObj.SQL)
            If Len(qSql) > 0 And UCase$(qSql) <> UCase$(rawQuery) Then
                Set OpenRecordset = Me.OpenRecordset(qSql, RecordsetType, Options, LockEdit)
                Exit Function
            End If
        End If
        ' Resolve base data source (Table or Join)
        Dim baseRs As Recordset
        Dim hasJoin As Boolean
        Dim jType As String, jLeftTbl As String, jRightTbl As String, jLeftKey As String, jRightKey As String
        hasJoin = ParseJoinClause(fromClause, jType, jLeftTbl, jRightTbl, jLeftKey, jRightKey)
        If hasJoin Then
            Dim leftRs As Recordset, rightRs As Recordset
            On Error Resume Next
            If InStr(1, jLeftTbl, " JOIN ", vbTextCompare) > 0 Then
                Set leftRs = Me.OpenRecordset("SELECT * FROM " & jLeftTbl)
            Else
                Set leftRs = Me.OpenRecordset(jLeftTbl)
            End If
            If InStr(1, jRightTbl, " JOIN ", vbTextCompare) > 0 Then
                Set rightRs = Me.OpenRecordset("SELECT * FROM " & jRightTbl)
            Else
                Set rightRs = Me.OpenRecordset(jRightTbl)
            End If
            On Error GoTo 0
            If leftRs Is Nothing Then
                Err.Raise vbObjectError + 3078, "Database.OpenRecordset", "Cannot find table or query '" & jLeftTbl & "' in JOIN."
            End If
            If rightRs Is Nothing Then
                Set baseRs = leftRs
            Else
                Dim leftDesc As TableDefDescriptor, rightDesc As TableDefDescriptor
                leftDesc = leftRs.TableDefDescriptor
                rightDesc = rightRs.TableDefDescriptor
                Dim joinedDesc As TableDefDescriptor
                joinedDesc.TableName = "JoinedRecordset"
                joinedDesc.RowCount = leftRs.RecordCount
                Dim lCount As Long, rCount As Long, totalCols As Long
                lCount = leftDesc.ColumnCount
                rCount = rightDesc.ColumnCount
                totalCols = lCount + rCount
                joinedDesc.ColumnCount = CInt(totalCols)
                ReDim joinedDesc.Columns(0 To totalCols - 1)
                Dim ci As Long
                For ci = 0 To lCount - 1
                    joinedDesc.Columns(ci) = leftDesc.Columns(ci)
                    If InStr(1, jLeftTbl, " JOIN ", vbTextCompare) = 0 Then
                        joinedDesc.Columns(ci).SourceTable = CleanSqlColName(jLeftTbl)
                    ElseIf Len(joinedDesc.Columns(ci).SourceTable) = 0 Then
                        joinedDesc.Columns(ci).SourceTable = leftDesc.TableName
                    End If
                Next ci
                For ci = 0 To rCount - 1
                    joinedDesc.Columns(lCount + ci) = rightDesc.Columns(ci)
                    If InStr(1, jRightTbl, " JOIN ", vbTextCompare) = 0 Then
                        joinedDesc.Columns(lCount + ci).SourceTable = CleanSqlColName(jRightTbl)
                    ElseIf Len(joinedDesc.Columns(lCount + ci).SourceTable) = 0 Then
                        joinedDesc.Columns(lCount + ci).SourceTable = rightDesc.TableName
                    End If
                Next ci
                ' Resolve join key indices (and swap if ON clause ordered Right.Col = Left.Col)
                Dim leftKeyIdx As Long, rightKeyIdx As Long
                leftKeyIdx = -1
                rightKeyIdx = -1
                For ci = 0 To lCount - 1
                    If StrComp(leftDesc.Columns(ci).Name, jLeftKey, vbTextCompare) = 0 Then
                        leftKeyIdx = ci
                        Exit For
                    End If
                Next ci
                For ci = 0 To rCount - 1
                    If StrComp(rightDesc.Columns(ci).Name, jRightKey, vbTextCompare) = 0 Then
                        rightKeyIdx = ci
                        Exit For
                    End If
                Next ci
                If leftKeyIdx < 0 Or rightKeyIdx < 0 Then
                    Dim swapLeftIdx As Long, swapRightIdx As Long
                    swapLeftIdx = -1
                    swapRightIdx = -1
                    For ci = 0 To lCount - 1
                        If StrComp(leftDesc.Columns(ci).Name, jRightKey, vbTextCompare) = 0 Then
                            swapLeftIdx = ci
                            Exit For
                        End If
                    Next ci
                    For ci = 0 To rCount - 1
                        If StrComp(rightDesc.Columns(ci).Name, jLeftKey, vbTextCompare) = 0 Then
                            swapRightIdx = ci
                            Exit For
                        End If
                    Next ci
                    If swapLeftIdx >= 0 And swapRightIdx >= 0 Then
                        leftKeyIdx = swapLeftIdx
                        rightKeyIdx = swapRightIdx
                    End If
                End If
                Dim rightRecCount As Long
                rightRecCount = rightRs.RecordCount
                Dim rightMatched() As Boolean
                Dim rightRowCache As New Collection
                Dim rightHashBuckets As New Collection
                If rightRecCount > 0 Then
                    ReDim rightMatched(0 To rightRecCount - 1)
                    rightRs.MoveFirst
                    Dim rBuildIdx As Long
                    rBuildIdx = 0
                    Do Until rightRs.EOF
                        Dim rCacheArr() As Variant
                        ReDim rCacheArr(0 To rCount - 1)
                        Dim rc As Long
                        For rc = 0 To rCount - 1
                            rCacheArr(rc) = rightRs.Fields(rc).Value
                        Next rc
                        rightRowCache.Add rCacheArr
                        If rightKeyIdx >= 0 Then
                            Dim rNormKey As String
                            rNormKey = NormalizeJoinKeyVal(rCacheArr(rightKeyIdx))
                            If Len(rNormKey) > 0 Then
                                Dim rBucket As Collection
                                Set rBucket = Nothing
                                On Error Resume Next
                                Set rBucket = rightHashBuckets("K_" & rNormKey)
                                On Error GoTo 0
                                If rBucket Is Nothing Then
                                    Set rBucket = New Collection
                                    rightHashBuckets.Add rBucket, "K_" & rNormKey
                                End If
                                rBucket.Add rBuildIdx
                            End If
                        End If
                        rBuildIdx = rBuildIdx + 1
                        rightRs.MoveNext
                    Loop
                End If
                Dim joinedRows As New Collection
                If leftRs.RecordCount > 0 Then
                    leftRs.MoveFirst
                    Do Until leftRs.EOF
                        Dim lCacheArr() As Variant
                        ReDim lCacheArr(0 To lCount - 1)
                        Dim lc As Long
                        For lc = 0 To lCount - 1
                            lCacheArr(lc) = leftRs.Fields(lc).Value
                        Next lc
                        Dim lKeyVal As Variant
                        lKeyVal = Null
                        If leftKeyIdx >= 0 Then
                            lKeyVal = lCacheArr(leftKeyIdx)
                            If IsNull(lKeyVal) Then
                                For ci = leftKeyIdx + 1 To lCount - 1
                                    If StrComp(leftDesc.Columns(ci).Name, leftDesc.Columns(leftKeyIdx).Name, vbTextCompare) = 0 Then
                                        If Not IsNull(lCacheArr(ci)) Then
                                            lKeyVal = lCacheArr(ci)
                                            Exit For
                                        End If
                                    End If
                                Next ci
                            End If
                        End If
                        Dim matchFound As Boolean
                        matchFound = False
                        If rightRecCount > 0 And rightKeyIdx >= 0 Then
                            Dim lNormKey As String
                            lNormKey = NormalizeJoinKeyVal(lKeyVal)
                            If Len(lNormKey) > 0 Then
                                Dim hitBucket As Collection
                                Set hitBucket = Nothing
                                On Error Resume Next
                                Set hitBucket = rightHashBuckets("K_" & lNormKey)
                                On Error GoTo 0
                                If Not hitBucket Is Nothing Then
                                    matchFound = True
                                    Dim hitIdxVal As Variant
                                    For Each hitIdxVal In hitBucket
                                        Dim rHitIdx As Long
                                        rHitIdx = CLng(hitIdxVal)
                                        If rHitIdx < rightRecCount Then rightMatched(rHitIdx) = True
                                        Dim rHitRow As Variant
                                        rHitRow = rightRowCache(rHitIdx + 1)
                                        Dim jRowData() As Variant
                                        ReDim jRowData(0 To totalCols - 1)
                                        Dim jc As Long
                                        For jc = 0 To lCount - 1
                                            jRowData(jc) = lCacheArr(jc)
                                        Next jc
                                        For jc = 0 To rCount - 1
                                            jRowData(lCount + jc) = rHitRow(jc)
                                        Next jc
                                        joinedRows.Add jRowData
                                    Next hitIdxVal
                                End If
                            End If
                        End If
                        If Not matchFound And jType = "LEFT" Then
                            Dim nullRowData() As Variant
                            ReDim nullRowData(0 To totalCols - 1)
                            Dim nc As Long
                            For nc = 0 To lCount - 1
                                nullRowData(nc) = lCacheArr(nc)
                            Next nc
                            For nc = 0 To rCount - 1
                                nullRowData(lCount + nc) = Null
                            Next nc
                            joinedRows.Add nullRowData
                        End If
                        leftRs.MoveNext
                    Loop
                End If
                If jType = "RIGHT" And rightRecCount > 0 Then
                    rightRs.MoveFirst
                    Dim rCheckIdx As Long
                    rCheckIdx = 0
                    Do Until rightRs.EOF
                        If rCheckIdx < rightRecCount Then
                            If Not rightMatched(rCheckIdx) Then
                                Dim rNullRow() As Variant
                                ReDim rNullRow(0 To totalCols - 1)
                                Dim rnc As Long
                                For rnc = 0 To lCount - 1
                                    rNullRow(rnc) = Null
                                Next rnc
                                For rnc = 0 To rCount - 1
                                    rNullRow(lCount + rnc) = rightRs.Fields(rnc).Value
                                Next rnc
                                joinedRows.Add rNullRow
                            End If
                        End If
                        rCheckIdx = rCheckIdx + 1
                        rightRs.MoveNext
                    Loop
                End If
                Dim jRs As New Recordset
                jRs.Init Me, joinedDesc, joinedRows
                Set baseRs = jRs
            End If
            If (Len(selectClause) = 0 Or selectClause = "*") And Len(whereClause) = 0 And Len(orderByClause) = 0 And Len(groupByClause) = 0 Then
                Set OpenRecordset = baseRs
                Exit Function
            End If
        Else
            If Not qdObj Is Nothing Then
                Set baseRs = qdObj.OpenRecordset()
                If Not baseRs Is Nothing Then baseRs.SetSourceTableName cleanFrom
            Else
                Dim tdefObj As TableDef
                cleanFrom = CleanSqlColName(fromClause)
                If InStr(1, cleanFrom, ",") > 0 Then
                    Dim commaParts() As String
                    commaParts = SplitTopLevelCommas(fromClause)
                    cleanFrom = CleanSqlColName(commaParts(LBound(commaParts)))
                    On Error Resume Next
                    Set qdObj = m_queryDefs.Item(cleanFrom)
                    On Error GoTo 0
                End If
                If Not qdObj Is Nothing Then
                    Set baseRs = qdObj.OpenRecordset()
                    If Not baseRs Is Nothing Then baseRs.SetSourceTableName cleanFrom
                Else
                    On Error Resume Next
                    Set tdefObj = m_tableDefs.Item(cleanFrom)
                    On Error GoTo 0
                    If tdefObj Is Nothing Then
                        Err.Raise vbObjectError + 3078, "Database.OpenRecordset", "The OpenAccess database engine cannot find the input table or query '" & fromClause & "'."
                    End If
                    Set baseRs = tdefObj.OpenRecordset()
                End If
            End If
            ' Fast return for plain table/query open with no clauses
            If (Len(selectClause) = 0 Or selectClause = "*") And Len(whereClause) = 0 And Len(orderByClause) = 0 And Len(groupByClause) = 0 Then
                Set OpenRecordset = baseRs
                Exit Function
            End If
        End If
        ' Filter rows by WHERE clause
        Dim rowsAfterWhere As New Collection
        Dim locsAfterWhere As New Collection
        If Len(whereClause) > 0 Then
            If Not baseRs.EOF Then
                baseRs.MoveFirst
                Do Until baseRs.EOF
                    If EvaluateWhereClauseTree(whereClause, baseRs) Then
                        Dim wData() As Variant
                        ReDim wData(0 To baseRs.Fields.Count - 1)
                        Dim wf As Long
                        For wf = 0 To baseRs.Fields.Count - 1
                            wData(wf) = baseRs.Fields(wf).Value
                        Next wf
                        rowsAfterWhere.Add wData
                        locsAfterWhere.Add baseRs.GetCurrentRowLocation()
                    End If
                    baseRs.MoveNext
                Loop
            End If
            Dim whereFilteredRs As New Recordset
            whereFilteredRs.Init Me, baseRs.TableDefDescriptor, rowsAfterWhere, locsAfterWhere
            Set baseRs = whereFilteredRs
        End If
        ' Apply SELECT projection, GROUP BY, Aggregates & Expressions
        Dim isProjected As Boolean
        isProjected = False
        Dim projDesc As TableDefDescriptor
        Dim projRows As New Collection
        If (Len(selectClause) > 0 And selectClause <> "*") Or Len(groupByClause) > 0 Then
            Dim selItems() As String
            If Len(selectClause) = 0 Then
                ReDim selItems(0 To 0)
                selItems(0) = "*"
            Else
                selItems = SplitSqlItems(selectClause)
            End If
            Dim numItems As Long
            numItems = UBound(selItems) + 1
            If numItems > 0 Then
                isProjected = True
                projDesc.TableName = baseRs.TableDefDescriptor.TableName
                projDesc.RowCount = baseRs.RecordCount
                Dim maxExpandedCols As Long
                maxExpandedCols = (numItems * (baseRs.Fields.Count + 2)) + 4
                Dim tempColDesc() As ColumnDescriptor
                Dim colExprList() As String
                Dim colAliasList() As String
                Dim colIsConcatList() As Boolean
                Dim colAggFuncList() As String
                Dim colBaseFieldIdx() As Long
                ReDim tempColDesc(0 To maxExpandedCols)
                ReDim colExprList(0 To maxExpandedCols)
                ReDim colAliasList(0 To maxExpandedCols)
                ReDim colIsConcatList(0 To maxExpandedCols)
                ReDim colAggFuncList(0 To maxExpandedCols)
                ReDim colBaseFieldIdx(0 To maxExpandedCols)
                Dim hasAnyAggregate As Boolean
                hasAnyAggregate = False
                Dim finalColCount As Long
                finalColCount = 0
                Dim itm As Long
                For itm = 0 To numItems - 1
                    Dim eStr As String, aStr As String, isCat As Boolean, aggFn As String
                    ParseSelectItem selItems(itm), eStr, aStr, isCat, aggFn
                    If Len(aggFn) > 0 Then hasAnyAggregate = True
                    If aStr = "*" Or InStr(1, eStr, ".*") > 0 Then
                        Dim starTblName As String
                        starTblName = vbNullString
                        Dim dotStarPos As Long
                        dotStarPos = InStr(1, eStr, ".*")
                        If dotStarPos > 1 Then
                            starTblName = CleanSqlColName(Left$(eStr, dotStarPos - 1))
                        End If
                        Dim starTdef As TableDef
                        Set starTdef = Nothing
                        If Len(starTblName) > 0 Then
                            On Error Resume Next
                            Set starTdef = m_tableDefs.Item(starTblName)
                            On Error GoTo 0
                        End If
                        Dim sc As Long
                        If Not starTdef Is Nothing Then
                            Dim tfIdx As Long
                            For tfIdx = 0 To starTdef.Fields.Count - 1
                                Dim tfName As String
                                tfName = starTdef.Fields(tfIdx).Name
                                For sc = 0 To baseRs.Fields.Count - 1
                                    If (Len(baseRs.TableDefDescriptor.Columns(sc).SourceTable) = 0 Or StrComp(baseRs.TableDefDescriptor.Columns(sc).SourceTable, starTblName, vbTextCompare) = 0) And StrComp(baseRs.Fields(sc).Name, tfName, vbTextCompare) = 0 Then
                                        tempColDesc(finalColCount) = baseRs.TableDefDescriptor.Columns(sc)
                                        colExprList(finalColCount) = tfName
                                        colAliasList(finalColCount) = tfName
                                        colIsConcatList(finalColCount) = False
                                        colAggFuncList(finalColCount) = vbNullString
                                        colBaseFieldIdx(finalColCount) = sc
                                        finalColCount = finalColCount + 1
                                        Exit For
                                    End If
                                Next sc
                            Next tfIdx
                        Else
                            For sc = 0 To baseRs.Fields.Count - 1
                                If Len(starTblName) = 0 Or Len(baseRs.TableDefDescriptor.Columns(sc).SourceTable) = 0 Or StrComp(baseRs.TableDefDescriptor.Columns(sc).SourceTable, starTblName, vbTextCompare) = 0 Then
                                    tempColDesc(finalColCount) = baseRs.TableDefDescriptor.Columns(sc)
                                    colExprList(finalColCount) = baseRs.Fields(sc).Name
                                    colAliasList(finalColCount) = baseRs.Fields(sc).Name
                                    colIsConcatList(finalColCount) = False
                                    colAggFuncList(finalColCount) = vbNullString
                                    colBaseFieldIdx(finalColCount) = sc
                                    finalColCount = finalColCount + 1
                                End If
                            Next sc
                        End If
                    ElseIf Len(aggFn) > 0 Then
                        Dim aggCol As ColumnDescriptor
                        aggCol.Name = aStr
                        If aggFn = "COUNT" Then
                            aggCol.ColType = JetColumnType.ColLong
                        Else
                            aggCol.ColType = JetColumnType.ColDouble
                        End If
                        aggCol.ByteLength = 8
                        tempColDesc(finalColCount) = aggCol
                        colExprList(finalColCount) = eStr
                        colAliasList(finalColCount) = aStr
                        colIsConcatList(finalColCount) = False
                        colAggFuncList(finalColCount) = aggFn
                        colBaseFieldIdx(finalColCount) = -1
                        finalColCount = finalColCount + 1
                    ElseIf isCat Then
                        Dim catCol As ColumnDescriptor
                        catCol.Name = aStr
                        catCol.ColType = ColText
                        catCol.ByteLength = 255
                        tempColDesc(finalColCount) = catCol
                        colExprList(finalColCount) = eStr
                        colAliasList(finalColCount) = aStr
                        colIsConcatList(finalColCount) = True
                        colAggFuncList(finalColCount) = vbNullString
                        colBaseFieldIdx(finalColCount) = -1
                        finalColCount = finalColCount + 1
                    Else
                        Dim colFound As Boolean
                        colFound = False
                        Dim matchIdx As Long
                        Dim cleanTargetCol As String
                        Dim targetTblPrefix As String
                        cleanTargetCol = CleanSqlColName(eStr)
                        targetTblPrefix = ExtractSqlTablePrefix(eStr)

                        If Len(targetTblPrefix) > 0 Then
                            For matchIdx = 0 To baseRs.Fields.Count - 1
                                If StrComp(baseRs.TableDefDescriptor.Columns(matchIdx).SourceTable, targetTblPrefix, vbTextCompare) = 0 And StrComp(baseRs.Fields(matchIdx).Name, cleanTargetCol, vbTextCompare) = 0 Then
                                    tempColDesc(finalColCount) = baseRs.TableDefDescriptor.Columns(matchIdx)
                                    tempColDesc(finalColCount).Name = aStr
                                    colExprList(finalColCount) = eStr
                                    colAliasList(finalColCount) = aStr
                                    colIsConcatList(finalColCount) = False
                                    colAggFuncList(finalColCount) = vbNullString
                                    colBaseFieldIdx(finalColCount) = matchIdx
                                    colFound = True
                                    finalColCount = finalColCount + 1
                                    Exit For
                                End If
                            Next matchIdx
                        End If

                        If Not colFound Then
                            For matchIdx = 0 To baseRs.Fields.Count - 1
                                If StrComp(baseRs.Fields(matchIdx).Name, cleanTargetCol, vbTextCompare) = 0 Or StrComp(baseRs.Fields(matchIdx).Name, aStr, vbTextCompare) = 0 Then
                                    tempColDesc(finalColCount) = baseRs.TableDefDescriptor.Columns(matchIdx)
                                    tempColDesc(finalColCount).Name = aStr
                                    colExprList(finalColCount) = eStr
                                    colAliasList(finalColCount) = aStr
                                    colIsConcatList(finalColCount) = False
                                    colAggFuncList(finalColCount) = vbNullString
                                    colBaseFieldIdx(finalColCount) = matchIdx
                                    colFound = True
                                    finalColCount = finalColCount + 1
                                    Exit For
                                End If
                            Next matchIdx
                        End If
                        If Not colFound Then
                            Dim genCol As ColumnDescriptor
                            genCol.Name = aStr
                            genCol.ColType = ColText
                            genCol.ByteLength = 255
                            tempColDesc(finalColCount) = genCol
                            colExprList(finalColCount) = eStr
                            colAliasList(finalColCount) = aStr
                            colIsConcatList(finalColCount) = False
                            colAggFuncList(finalColCount) = vbNullString
                            colBaseFieldIdx(finalColCount) = -1
                            finalColCount = finalColCount + 1
                        End If
                    End If
                Next itm
                projDesc.ColumnCount = CInt(finalColCount)
                ReDim projDesc.Columns(0 To finalColCount - 1)
                Dim fc As Long
                For fc = 0 To finalColCount - 1
                    projDesc.Columns(fc) = tempColDesc(fc)
                Next fc
                If Len(groupByClause) > 0 Then
                    ' Partition baseRs rows into group buckets by groupByClause expressions
                    Dim gbItems() As String
                    gbItems = SplitSqlItems(groupByClause)
                    Dim gbCount As Long
                    gbCount = UBound(gbItems) + 1
                    Dim groupBucketMap As New Collection
                    Dim groupRowBuckets As New Collection
                    If Not baseRs.EOF Then
                        baseRs.MoveFirst
                        Do Until baseRs.EOF
                            Dim gKey As String
                            gKey = "G"
                            Dim gi As Long
                            For gi = 0 To gbCount - 1
                                Dim gv As Variant
                                gv = EvaluateRowExpr(gbItems(gi), baseRs)
                                If IsNull(gv) Or IsEmpty(gv) Then
                                    gKey = gKey & Chr$(31) & "<NULL>"
                                Else
                                    gKey = gKey & Chr$(31) & UCase$(Trim$(CStr(gv)))
                                End If
                            Next gi
                            Dim grpBucket As Collection
                            Set grpBucket = Nothing
                            On Error Resume Next
                            Set grpBucket = groupBucketMap(gKey)
                            On Error GoTo 0
                            If grpBucket Is Nothing Then
                                Set grpBucket = New Collection
                                groupBucketMap.Add grpBucket, gKey
                                groupRowBuckets.Add grpBucket
                            End If
                            Dim gRowCopy() As Variant
                            ReDim gRowCopy(0 To baseRs.Fields.Count - 1)
                            Dim gf As Long
                            For gf = 0 To baseRs.Fields.Count - 1
                                gRowCopy(gf) = baseRs.Fields(gf).Value
                            Next gf
                            grpBucket.Add gRowCopy
                            baseRs.MoveNext
                        Loop
                    End If
                    Dim bktIdx As Long
                    For bktIdx = 1 To groupRowBuckets.Count
                        Dim curBucket As Collection
                        Set curBucket = groupRowBuckets(bktIdx)
                        Dim grpRs As New Recordset
                        grpRs.Init Me, baseRs.TableDefDescriptor, curBucket
                        If Not grpRs.EOF Then grpRs.MoveFirst
                        Dim gOutRow() As Variant
                        ReDim gOutRow(0 To finalColCount - 1)
                        For fc = 0 To finalColCount - 1
                            If Len(colAggFuncList(fc)) > 0 Then
                                gOutRow(fc) = ComputeAggregateColumn(grpRs, colAggFuncList(fc), colExprList(fc))
                            ElseIf colIsConcatList(fc) Then
                                gOutRow(fc) = EvaluateConcatExpr(colExprList(fc), grpRs)
                            ElseIf colBaseFieldIdx(fc) >= 0 Then
                                gOutRow(fc) = grpRs.Fields(colBaseFieldIdx(fc)).Value
                            Else
                                Dim substitutedExpr As String
                                substitutedExpr = colExprList(fc)
                                Dim prevFc As Long
                                For prevFc = 0 To fc - 1
                                    Dim prevAlias As String
                                    prevAlias = colAliasList(prevFc)
                                    If Len(prevAlias) > 0 Then
                                        Dim valStr As String
                                        If IsNull(gOutRow(prevFc)) Or IsEmpty(gOutRow(prevFc)) Then
                                            valStr = "0"
                                        ElseIf IsNumeric(gOutRow(prevFc)) Then
                                            valStr = Trim$(Str$(CDbl(gOutRow(prevFc))))
                                        Else
                                            valStr = Chr$(34) & Replace$(CStr(gOutRow(prevFc)), Chr$(34), Chr$(34) & Chr$(34)) & Chr$(34)
                                        End If
                                        substitutedExpr = Replace$(substitutedExpr, "[" & prevAlias & "]", valStr, , , vbTextCompare)
                                    End If
                                Next prevFc
                                gOutRow(fc) = EvaluateRowExpr(substitutedExpr, grpRs)
                            End If
                        Next fc
                        Dim includeGroup As Boolean
                        includeGroup = True
                        If Len(havingClause) > 0 Then
                            includeGroup = EvaluateWhereClauseTree(havingClause, grpRs)
                        End If
                        If includeGroup Then
                            projRows.Add gOutRow
                        End If
                    Next bktIdx
                ElseIf hasAnyAggregate Then
                    ' Compute single aggregate summary row
                    Dim aggRow() As Variant
                    ReDim aggRow(0 To finalColCount - 1)
                    For fc = 0 To finalColCount - 1
                        If Len(colAggFuncList(fc)) > 0 Then
                            aggRow(fc) = ComputeAggregateColumn(baseRs, colAggFuncList(fc), colExprList(fc))
                        Else
                            aggRow(fc) = EvaluateRowExpr(colExprList(fc), baseRs)
                        End If
                    Next fc
                    projRows.Add aggRow
                ElseIf Not baseRs.EOF Then
                    baseRs.MoveFirst
                    Do Until baseRs.EOF
                        Dim pRow() As Variant
                        ReDim pRow(0 To finalColCount - 1)
                        For fc = 0 To finalColCount - 1
                            If colIsConcatList(fc) Then
                                pRow(fc) = EvaluateConcatExpr(colExprList(fc), baseRs)
                            ElseIf colBaseFieldIdx(fc) >= 0 Then
                                pRow(fc) = baseRs.Fields(colBaseFieldIdx(fc)).Value
                            Else
                                pRow(fc) = EvaluateRowExpr(colExprList(fc), baseRs)
                            End If
                        Next fc
                        projRows.Add pRow
                        baseRs.MoveNext
                    Loop
                End If
            End If
        End If
        Dim finalRsDesc As TableDefDescriptor
        Dim finalRows As Collection
        Dim finalLocs As Collection
        If isProjected Then
            finalRsDesc = projDesc
            Set finalRows = projRows
            Set finalLocs = Nothing
        Else
            finalRsDesc = baseRs.TableDefDescriptor
            Set finalRows = New Collection
            Set finalLocs = New Collection
            If Not baseRs.EOF Then
                baseRs.MoveFirst
                Do Until baseRs.EOF
                    Dim bData() As Variant
                    ReDim bData(0 To baseRs.Fields.Count - 1)
                    Dim bf As Long
                    For bf = 0 To baseRs.Fields.Count - 1
                        bData(bf) = baseRs.Fields(bf).Value
                    Next bf
                    finalRows.Add bData
                    finalLocs.Add baseRs.GetCurrentRowLocation()
                    baseRs.MoveNext
                Loop
            End If
        End If
        If Len(orderByClause) > 0 And finalRows.Count > 1 Then
            Dim orderItems() As String
            orderItems = SplitSqlItems(orderByClause)
            Dim firstOrder As String
            firstOrder = orderItems(0)
            Dim cleanOrder As String
            cleanOrder = CleanSqlColName(firstOrder)
            Dim isDesc As Boolean
            isDesc = (InStr(1, firstOrder, " DESC", vbTextCompare) > 0)
            If isDesc Then
                cleanOrder = CleanSqlColName(Replace$(firstOrder, " DESC", "", , , vbTextCompare))
            ElseIf InStr(1, firstOrder, " ASC", vbTextCompare) > 0 Then
                cleanOrder = CleanSqlColName(Replace$(firstOrder, " ASC", "", , , vbTextCompare))
            End If
            Dim sortColIdx As Long
            sortColIdx = -1
            Dim sortCheck As Long
            For sortCheck = 0 To finalRsDesc.ColumnCount - 1
                If StrComp(finalRsDesc.Columns(sortCheck).Name, cleanOrder, vbTextCompare) = 0 Then
                    sortColIdx = sortCheck
                    Exit For
                End If
            Next sortCheck
            If sortColIdx >= 0 Then
                SortProjectedRows finalRows, sortColIdx, isDesc
                Set finalLocs = Nothing
            End If
        End If
        Dim resultRs As New Recordset
        resultRs.Init Me, finalRsDesc, finalRows, finalLocs
        Set OpenRecordset = resultRs
    End Function

    Private Function ComputeAggregateColumn(ByVal rs As Recordset, ByVal aggFunc As String, ByVal colExpr As String) As Variant
        If aggFunc = "EXPR_AGG" Then
            ' Replace inner SUM(...), COUNT(...), AVG(...), MIN(...), MAX(...) calls and evaluate scalar expression
            Dim workExpr As String
            workExpr = colExpr
            Dim aggNames(0 To 4) As String
            aggNames(0) = "SUM("
            aggNames(1) = "COUNT("
            aggNames(2) = "AVG("
            aggNames(3) = "MIN("
            aggNames(4) = "MAX("
            Dim guard As Long
            For guard = 1 To 16
                Dim foundPos As Long, foundFn As String, foundPrefixLen As Long
                foundPos = 0
                Dim an As Long
                For an = 0 To 4
                    Dim p As Long
                    p = InStr(1, workExpr, aggNames(an), vbTextCompare)
                    If p > 0 And (foundPos = 0 Or p < foundPos) Then
                        foundPos = p
                        foundFn = Left$(aggNames(an), Len(aggNames(an)) - 1)
                        foundPrefixLen = Len(aggNames(an))
                    End If
                Next an
                If foundPos = 0 Then Exit For
                Dim d As Long, scanIdx As Long, closeIdx As Long
                d = 1
                closeIdx = 0
                For scanIdx = foundPos + foundPrefixLen To Len(workExpr)
                    Dim ch As String
                    ch = Mid$(workExpr, scanIdx, 1)
                    If ch = "(" Then d = d + 1
                    If ch = ")" Then
                        d = d - 1
                        If d = 0 Then
                            closeIdx = scanIdx
                            Exit For
                        End If
                    End If
                Next scanIdx
                If closeIdx = 0 Then Exit For
                Dim innerSub As String
                innerSub = Trim$(Mid$(workExpr, foundPos + foundPrefixLen, closeIdx - (foundPos + foundPrefixLen)))
                Dim subAggVal As Variant
                subAggVal = ComputeAggregateColumn(rs, foundFn, innerSub)
                Dim subAggStr As String
                If IsNull(subAggVal) Or IsEmpty(subAggVal) Then
                    subAggStr = "0"
                Else
                    subAggStr = Trim$(Str$(CDbl(Val(CStr(subAggVal)))))
                End If
                workExpr = Left$(workExpr, foundPos - 1) & subAggStr & Mid$(workExpr, closeIdx + 1)
            Next guard
            ComputeAggregateColumn = EvaluateRowExpr(workExpr, rs)
            Exit Function
        End If
        Dim cleanCol As String
        cleanCol = CleanSqlColName(colExpr)
        If aggFunc = "COUNT" And (cleanCol = "*" Or Len(cleanCol) = 0) Then
            ComputeAggregateColumn = rs.RecordCount
            Exit Function
        End If
        Dim cnt As Long
        Dim sumVal As Double
        Dim minVal As Variant
        Dim maxVal As Variant
        cnt = 0
        sumVal = 0#
        minVal = Empty
        maxVal = Empty
        If rs.RecordCount > 0 Then
            rs.MoveFirst
            Do Until rs.EOF
                Dim v As Variant
                On Error Resume Next
                v = rs.Fields(cleanCol).Value
                If Err.Number <> 0 Then
                    Err.Clear
                    v = EvaluateRowExpr(colExpr, rs)
                End If
                On Error GoTo 0
                If Not IsNull(v) And Not IsEmpty(v) Then
                    cnt = cnt + 1
                    If IsNumeric(v) Then sumVal = sumVal + CDbl(v)
                    If IsEmpty(minVal) Then
                        minVal = v
                        maxVal = v
                    Else
                        If CompareSortCells(v, minVal, False) < 0 Then minVal = v
                        If CompareSortCells(v, maxVal, False) > 0 Then maxVal = v
                    End If
                End If
                rs.MoveNext
            Loop
            rs.MoveFirst
        End If
        Select Case aggFunc
            Case "COUNT": ComputeAggregateColumn = cnt
            Case "SUM": ComputeAggregateColumn = sumVal
            Case "AVG"
                If cnt > 0 Then
                    ComputeAggregateColumn = sumVal / cnt
                Else
                    ComputeAggregateColumn = Null
                End If
            Case "MIN"
                If IsEmpty(minVal) Then
                    ComputeAggregateColumn = Null
                Else
                    ComputeAggregateColumn = minVal
                End If
            Case "MAX"
                If IsEmpty(maxVal) Then
                    ComputeAggregateColumn = Null
                Else
                    ComputeAggregateColumn = maxVal
                End If
            Case Else: ComputeAggregateColumn = Null
        End Select
    End Function

    Public Function GetOrOpenBackendDatabase(ByVal dbPath As String, Optional ByVal forceReload As Boolean = False) As Database
        Dim cleanPath As String
        cleanPath = Trim$(dbPath)
        If Len(cleanPath) = 0 Then Exit Function
        Dim key As String
        key = UCase$(cleanPath)
        If Not forceReload Then
            On Error Resume Next
            Dim cachedDb As Database
            Set cachedDb = m_backendDbs(key)
            On Error GoTo 0
            If Not cachedDb Is Nothing Then
                If cachedDb.IsOpen Then
                    cachedDb.RefreshIfModified
                    Set GetOrOpenBackendDatabase = cachedDb
                    Exit Function
                End If
            End If
        Else
            On Error Resume Next
            m_backendDbs.Remove key
            On Error GoTo 0
        End If
        If Len(Dir$(cleanPath)) = 0 Then
            Err.Raise vbObjectError + 3024, "Database.GetOrOpenBackendDatabase", "Could not find file '" & cleanPath & "'."
        End If
        Dim newDb As Database
        Dim beEngine As DBEngine
        Set beEngine = New DBEngine
        Set newDb = beEngine.OpenDatabase(cleanPath)
        If Not newDb Is Nothing Then
            On Error Resume Next
            m_backendDbs.Remove key
            m_backendDbs.Add newDb, key
            On Error GoTo 0
            Set GetOrOpenBackendDatabase = newDb
        End If
    End Function

    Public Sub RefreshIfModified()
        If Not m_isOpen Or Len(m_name) = 0 Then Exit Sub
        Dim curLen As LongLong
        Dim curTime As Date
        On Error Resume Next
        curLen = FileLen(m_name)
        curTime = FileDateTime(m_name)
        On Error GoTo 0
        If curLen <> m_lastFileLen Or curTime <> m_lastFileTime Then
            m_lastFileLen = curLen
            m_lastFileTime = curTime
            If curLen >= 4096 Then
                If Not PageWriter.IsInTransaction(m_fileNum) Then
                    On Error Resume Next
                    Close #m_fileNum
                    m_fileNum = FreeFile()
                    If m_isReadOnly Then
                        Open m_name For Binary Access Read Shared As #m_fileNum
                    Else
                        Open m_name For Binary Access Read Write Shared As #m_fileNum
                        If Err.Number <> 0 Then
                            Err.Clear
                            Open m_name For Binary Access Read Shared As #m_fileNum
                            m_isReadOnly = True
                        End If
                    End If
                    PageWriter.RegisterDatabaseHandle m_fileNum, m_name
                    On Error GoTo 0
                End If
                m_totalPages = CLng(curLen \ 4096)
                CatalogReader.InvalidatePageDirectory
                CatalogReader.EnsurePageDirectory m_fileNum, m_totalPages
                If Not m_tableDefs Is Nothing Then
                    m_tableDefs.Refresh
                End If
            End If
        End If
    End Sub

    Public Sub CloseDatabase()
        Me.[Close]
    End Sub

    Public Function VerifyAndRepair(Optional ByRef outReport As String) As Long
        EnsureOpen "VerifyAndRepair"
        Dim fixedCount As Long
        fixedCount = 0
        Dim report As String
        report = "=== OpenAccess Database Self-Healing & Diagnostic Report ===" & vbCrLf
        report = report & "Target File: " & m_name & vbCrLf
        report = report & "Total Pages: " & CStr(m_totalPages) & vbCrLf

        If m_fileNum <= 0 Or m_totalPages < 4 Then
            report = report & "[Error] Database file is not accessible or has fewer than 4 pages." & vbCrLf
            outReport = report
            VerifyAndRepair = 0
            Exit Function
        End If

        ' 1. Check Page 0: Database Header Page
        Dim pg0() As Byte
        pg0 = CatalogReader.ReadPageBytes(m_fileNum, m_totalPages, 0)
        Dim pg0Modified As Boolean
        pg0Modified = False

        If pg0(0) <> 0 Or pg0(1) <> 1 Or pg0(2) <> 0 Or pg0(3) <> 0 Then
            pg0(0) = 0: pg0(1) = 1: pg0(2) = 0: pg0(3) = 0
            pg0Modified = True
            fixedCount = fixedCount + 1
            report = report & "[Fixed] Page 0 magic signature restored." & vbCrLf
        End If

        Dim sigStr As String
        sigStr = Space$(15)
        Dim sIdx As Long
        For sIdx = 1 To 15
            sigStr = Mid$(sigStr, 1, sIdx - 1) & Chr$(pg0(3 + sIdx)) & Mid$(sigStr, sIdx + 1)
        Next sIdx
        If InStr(1, sigStr, "Standard Jet DB") = 0 And InStr(1, sigStr, "Standard ACE DB") = 0 Then
            Dim defSig As String
            If pg0(20) = 1 Then defSig = "Standard Jet DB" Else defSig = "Standard ACE DB"
            For sIdx = 1 To Len(defSig)
                pg0(3 + sIdx) = CByte(Asc(Mid$(defSig, sIdx, 1)))
            Next sIdx
            pg0Modified = True
            fixedCount = fixedCount + 1
            report = report & "[Fixed] Page 0 engine format string restored: " & defSig & vbCrLf
        End If

        If pg0Modified Then
            PageWriter.WritePageBytes m_fileNum, m_totalPages, 0, pg0
        End If

        ' 2. Check Page 1: Usage Map / Allocation Bitmap
        Dim pg1() As Byte
        pg1 = CatalogReader.ReadPageBytes(m_fileNum, m_totalPages, 1)
        Dim pg1Modified As Boolean
        pg1Modified = False

        If pg1(0) <> &H5& And pg1(0) <> &H1& Then
            pg1(0) = &H5&
            pg1(1) = &H1&
            pg1Modified = True
            fixedCount = fixedCount + 1
            report = report & "[Fixed] Page 1 usage map type header restored." & vbCrLf
        End If

        If (pg1(8) And &HF&) <> &HF& Then
            pg1(8) = pg1(8) Or &HF&
            pg1Modified = True
            fixedCount = fixedCount + 1
            report = report & "[Fixed] Page 1 base system page allocation bitmap restored." & vbCrLf
        End If

        If pg1Modified Then
            PageWriter.WritePageBytes m_fileNum, m_totalPages, 1, pg1
        End If

        ' 3. Check All Tables: TDEF Header, RowCount, AutoNumberNext, Data Pages & LVAL
        Dim tIdx As Long
        For tIdx = 0 To m_tableDefs.Count - 1
            Dim td As TableDef
            Set td = m_tableDefs.Item(tIdx)
            If Not td Is Nothing Then
                Dim tblName As String
                tblName = td.Name
                If Len(Trim$(td.Connect)) = 0 Then
                    Dim desc As TableDefDescriptor
                    desc = td.Descriptor
                    Dim tdefPage As Long
                    tdefPage = desc.TdefPageNumber

                    If tdefPage > 0 And tdefPage < m_totalPages Then
                        Dim tp() As Byte
                        tp = CatalogReader.ReadPageBytes(m_fileNum, m_totalPages, tdefPage)

                        Dim tdefModified As Boolean
                        tdefModified = False

                        If tp(0) <> &H2& Then
                            tp(0) = &H2&
                            tp(1) = &H1&
                            tdefModified = True
                            fixedCount = fixedCount + 1
                            report = report & "[Fixed] Table '" & tblName & "' TDEF page type restored." & vbCrLf
                        End If

                        Dim storedRowCount As Long
                        storedRowCount = FormatProbe.ReadInt32LE(tp, 16)
                        Dim storedAutoNum As Long
                        storedAutoNum = FormatProbe.ReadInt32LE(tp, 20)

                        Dim actualRows As Long
                        actualRows = 0
                        Dim maxAutoNumVal As Long
                        maxAutoNumVal = 0
                        Dim hasAutoNumCol As Boolean
                        hasAutoNumCol = False
                        Dim autoNumFixedOff As Long
                        autoNumFixedOff = -1

                        Dim c As Integer
                        For c = 0 To desc.ColumnCount - 1
                            If desc.Columns(c).IsAutoNumber Then
                                hasAutoNumCol = True
                                autoNumFixedOff = desc.Columns(c).FixedOffset
                                Exit For
                            End If
                        Next c

                        Dim dPages As Collection
                        Set dPages = CatalogReader.FindAllDataPages(m_fileNum, m_totalPages, tdefPage)

                        Dim pVal As Variant
                        For Each pVal In dPages
                            Dim dpNum As Long
                            dpNum = CLng(pVal)
                            If dpNum > 0 And dpNum < m_totalPages Then
                                Dim dp() As Byte
                                dp = CatalogReader.ReadPageBytes(m_fileNum, m_totalPages, dpNum)

                                If dp(0) = &H1& Then
                                    Dim dpNumRows As Long
                                    dpNumRows = CLng(FormatProbe.ReadUInt16LE(dp, 12))
                                    Dim freeBytes As Long
                                    freeBytes = CLng(FormatProbe.ReadUInt16LE(dp, 2))

                                    Dim lowestRowStart As Long
                                    lowestRowStart = 4096&

                                    Dim r As Long
                                    For r = 0 To dpNumRows - 1
                                        Dim raw As Long
                                        raw = CLng(FormatProbe.ReadUInt16LE(dp, 14 + (r * 2)))
                                        Dim topFlags As Long
                                        topFlags = raw And (&H8000& Or &H4000&)
                                        Dim rStart As Long
                                        rStart = raw And &H1FFF&

                                        If topFlags = 0 And rStart > 0 And rStart < 4096& Then
                                            actualRows = actualRows + 1
                                            If rStart < lowestRowStart Then lowestRowStart = rStart

                                            If hasAutoNumCol And autoNumFixedOff >= 0 Then
                                                If (rStart + 2& + autoNumFixedOff + 4&) <= 4096& Then
                                                    Dim autoVal As Long
                                                    autoVal = FormatProbe.ReadInt32LE(dp, rStart + 2& + autoNumFixedOff)
                                                    If autoVal > maxAutoNumVal Then maxAutoNumVal = autoVal
                                                End If
                                            End If
                                        ElseIf topFlags = &H4000& Then
                                            actualRows = actualRows + 1
                                        End If
                                    Next r

                                    Dim expectedFree As Long
                                    expectedFree = lowestRowStart - (14& + (dpNumRows * 2&))
                                    If expectedFree < 0 Then expectedFree = 0
                                    If freeBytes <> expectedFree And expectedFree <= 4096& Then
                                        PageWriter.WriteUInt16LE dp, 2, CInt(expectedFree)
                                        PageWriter.WritePageBytes m_fileNum, m_totalPages, dpNum, dp
                                        fixedCount = fixedCount + 1
                                        report = report & "[Fixed] Data Page " & CStr(dpNum) & " free space counter adjusted (" & CStr(freeBytes) & " -> " & CStr(expectedFree) & ")." & vbCrLf
                                    End If
                                End If
                            End If
                        Next pVal

                        If storedRowCount <> actualRows Then
                            PageWriter.WriteInt32LE tp, 16, actualRows
                            desc.RowCount = actualRows
                            tdefModified = True
                            fixedCount = fixedCount + 1
                            report = report & "[Fixed] Table '" & tblName & "' RowCount rebalanced: was " & CStr(storedRowCount) & ", corrected to " & CStr(actualRows) & "." & vbCrLf
                        End If

                        If hasAutoNumCol Then
                            Dim expectedAutoNum As Long
                            expectedAutoNum = maxAutoNumVal + 1
                            If expectedAutoNum <= 0 Then expectedAutoNum = 1
                            If storedAutoNum < expectedAutoNum Or (storedAutoNum = 0 And expectedAutoNum > 1) Then
                                PageWriter.WriteInt32LE tp, 20, expectedAutoNum
                                desc.AutoNumberNext = expectedAutoNum
                                tdefModified = True
                                fixedCount = fixedCount + 1
                                report = report & "[Fixed] Table '" & tblName & "' AutoNumberNext adjusted: was " & CStr(storedAutoNum) & ", corrected to " & CStr(expectedAutoNum) & "." & vbCrLf
                            End If
                        End If

                        If tdefModified Then
                            PageWriter.WritePageBytes m_fileNum, m_totalPages, tdefPage, tp
                            td.UpdateDescriptor desc
                        End If
                    End If
                End If
            End If
        Next tIdx

        CatalogReader.InvalidatePageDirectory
        CatalogReader.EnsurePageDirectory m_fileNum, m_totalPages
        If Not m_tableDefs Is Nothing Then
            m_tableDefs.Refresh
        End If

        report = report & "Diagnostics complete. Total errors corrected: " & CStr(fixedCount) & vbCrLf
        outReport = report
        VerifyAndRepair = fixedCount
    End Function

    Friend Sub PersistNewLinkedTableDef(ByVal tblName As String, ByVal connectStr As String, ByVal foreignTblName As String)
        If m_fileNum <= 0 Or m_totalPages <= 0 Then Exit Sub
        Dim msysDesc As TableDefDescriptor
        On Error Resume Next
        msysDesc = CatalogReader.ParseTableDef(m_fileNum, m_totalPages, 2, "MSysObjects")
        On Error GoTo 0
        If msysDesc.ColumnCount >= 17 Then
            Dim sysVals() As Variant
            ReDim sysVals(0 To msysDesc.ColumnCount - 1)
            Dim cIdx As Long
            Dim fNameVal As String
            fNameVal = IIf(Len(foreignTblName) > 0, foreignTblName, tblName)
            For cIdx = 0 To msysDesc.ColumnCount - 1
                Select Case UCase$(msysDesc.Columns(cIdx).Name)
                    Case "ID": sysVals(cIdx) = 0&
                    Case "PARENTID": sysVals(cIdx) = 1&
                    Case "NAME": sysVals(cIdx) = tblName
                    Case "TYPE": sysVals(cIdx) = CInt(6)
                    Case "DATECREATE": sysVals(cIdx) = Now
                    Case "DATEUPDATE": sysVals(cIdx) = Now
                    Case "FLAGS": sysVals(cIdx) = &H40000000
                    Case "DATABASE": sysVals(cIdx) = LinkedTableHelper.ExtractDatabasePathFromConnect(connectStr)
                    Case "CONNECT": sysVals(cIdx) = connectStr
                    Case "FOREIGNNAME": sysVals(cIdx) = fNameVal
                    Case Else: sysVals(cIdx) = Null
                End Select
            Next cIdx
            Dim outPg As Long, outSl As Integer
            RecordWriter.InsertRecord m_fileNum, m_totalPages, msysDesc, sysVals, outPg, outSl
        End If
    End Sub

    Friend Sub PersistRelationToCatalog(ByVal rel As Relation)
        On Error Resume Next
        If rel Is Nothing Or m_fileNum <= 0 Or m_totalPages <= 0 Then Exit Sub
        If rel.Fields.Count <= 0 Then Exit Sub
        DeleteRelationFromCatalog rel.Name
        Dim msysRelTd As TableDef
        Set msysRelTd = m_tableDefs("MSYSRELATIONSHIPS")
        If msysRelTd Is Nothing Then Exit Sub
        Dim msysRelDesc As TableDefDescriptor
        msysRelDesc = msysRelTd.Descriptor
        If msysRelDesc.ColumnCount < 7 Then Exit Sub
        Dim fIdx As Long
        Dim cIdx As Long
        Dim relVals() As Variant
        Dim outPg As Long
        Dim outSl As Integer
        For fIdx = 0 To rel.Fields.Count - 1
            ReDim relVals(0 To msysRelDesc.ColumnCount - 1)
            For cIdx = 0 To msysRelDesc.ColumnCount - 1
                Select Case UCase$(msysRelDesc.Columns(cIdx).Name)
                    Case "CCOLUMN": relVals(cIdx) = CLng(rel.Fields.Count)
                    Case "GRBIT": relVals(cIdx) = CLng(rel.Attributes)
                    Case "ICOLUMN": relVals(cIdx) = CLng(fIdx)
                    Case "SZCOLUMN": relVals(cIdx) = CStr(rel.Fields(fIdx).ForeignName)
                    Case "SZOBJECT": relVals(cIdx) = CStr(rel.ForeignTable)
                    Case "SZREFERENCEDCOLUMN": relVals(cIdx) = CStr(rel.Fields(fIdx).Name)
                    Case "SZREFERENCEDOBJECT": relVals(cIdx) = CStr(rel.Table)
                    Case "SZRELATIONSHIP": relVals(cIdx) = CStr(rel.Name)
                    Case Else: relVals(cIdx) = Null
                End Select
            Next cIdx
            RecordWriter.InsertRecord m_fileNum, m_totalPages, msysRelDesc, relVals, outPg, outSl
        Next fIdx
        msysRelTd.UpdateDescriptor msysRelDesc
        EnsureRelationCatalogEntry rel.Name
        If (rel.Attributes And 2&) = 0 Then
            SyncForeignKeyIndexesOnTdefs rel
        End If
        SyncTableLookupLvProp rel.ForeignTable
        On Error GoTo 0
    End Sub

    ' =========================================================================
    ' QueryDef Catalog & Disk Persistence Engine (MSysObjects, MSysQueries, MSysACEs, MSysNavPane)
    ' =========================================================================

    Friend Sub PersistQueryDefToCatalog(ByVal qd As QueryDef)
        On Error Resume Next
        If qd Is Nothing Or m_fileNum <= 0 Or m_totalPages <= 0 Or m_isReadOnly Then Exit Sub
        Dim qName As String
        qName = Trim$(qd.Name)
        If Len(qName) = 0 Then Exit Sub

        Dim msysTd As TableDef
        Set msysTd = Nothing
        If Not m_tableDefs Is Nothing Then Set msysTd = m_tableDefs("MSYSOBJECTS")
        If msysTd Is Nothing Then Exit Sub

        Dim msysQryTd As TableDef
        Set msysQryTd = Nothing
        If Not m_tableDefs Is Nothing Then Set msysQryTd = m_tableDefs("MSYSQUERIES")
        If msysQryTd Is Nothing Then Exit Sub

        Dim tablesParentId As Long
        Dim foundTablesCont As Boolean
        Dim ownerBytes(0 To 1) As Byte
        Dim ownerVal As Variant
        Dim minSynthId As Long
        Dim rId As Long
        Dim rType As Long
        Dim rName As String
        Dim rParentId As Long
        Dim existingObjId As Long
        Dim foundExisting As Boolean

        ownerBytes(0) = &HA6&
        ownerBytes(1) = &H33&
        ownerVal = ownerBytes
        tablesParentId = &HF0000001
        foundTablesCont = False
        minSynthId = -2147483640&
        existingObjId = 0
        foundExisting = False

        Dim rsObj As Recordset
        Set rsObj = msysTd.OpenRecordset()
        If Not rsObj Is Nothing Then
            If Not rsObj.EOF Then
                rsObj.MoveFirst
                Do Until rsObj.EOF
                    rName = Trim$(CStr(rsObj.Fields("Name").Value & ""))
                    If IsNumeric(rsObj.Fields("Type").Value) Then rType = CLng(rsObj.Fields("Type").Value) Else rType = 0
                    If IsNumeric(rsObj.Fields("Id").Value) Then rId = CLng(rsObj.Fields("Id").Value) Else rId = 0

                    If StrComp(rName, "Tables", vbTextCompare) = 0 And rType = 3 Then
                        If rId <> 0 Then
                            tablesParentId = rId
                            foundTablesCont = True
                        End If
                        If Not IsNull(rsObj.Fields("Owner").Value) And Not IsEmpty(rsObj.Fields("Owner").Value) Then
                            ownerVal = rsObj.Fields("Owner").Value
                        End If
                    ElseIf (rType = 1 Or rType = 5) And Left$(rName, 4) <> "MSys" And Left$(rName, 1) <> "~" Then
                        If Not foundTablesCont And IsNumeric(rsObj.Fields("ParentId").Value) Then
                            rParentId = CLng(rsObj.Fields("ParentId").Value)
                            If rParentId <> 0 And rParentId <> 1 And rParentId <> &HF0000000 And rParentId <> &HF0000002 Then
                                tablesParentId = rParentId
                            End If
                        End If
                    End If

                    If rType = 5 And StrComp(rName, qName, vbTextCompare) = 0 Then
                        existingObjId = rId
                        foundExisting = True
                    End If

                    If rId < &HF0000000 And rId >= minSynthId Then
                        minSynthId = rId + 1
                    End If
                    rsObj.MoveNext
                Loop
            End If
            rsObj.Close
        End If

        Dim targetObjId As Long
        If foundExisting And existingObjId <> 0 Then
            targetObjId = existingObjId
        Else
            targetObjId = minSynthId
        End If

        ' 1. Delete any existing rows for this query in MSysQueries
        Dim rsQry As Recordset
        Set rsQry = msysQryTd.OpenRecordset()
        If Not rsQry Is Nothing Then
            If Not rsQry.EOF Then
                rsQry.MoveFirst
                Do Until rsQry.EOF
                    Dim qryRowObjId As Long
                    If IsNumeric(rsQry.Fields("ObjectId").Value) Then
                        qryRowObjId = CLng(rsQry.Fields("ObjectId").Value)
                    Else
                        qryRowObjId = 0
                    End If
                    If qryRowObjId = targetObjId Then
                        rsQry.Delete
                    Else
                        rsQry.MoveNext
                    End If
                Loop
            End If
            rsQry.Close
        End If

        ' 2. Insert or update row in MSysObjects
        If Not foundExisting Then
            Dim msysDesc As TableDefDescriptor
            msysDesc = msysTd.Descriptor
            If msysDesc.ColumnCount >= 7 Then
                Dim sysVals() As Variant
                ReDim sysVals(0 To msysDesc.ColumnCount - 1)
                Dim cIdx As Long
                For cIdx = 0 To msysDesc.ColumnCount - 1
                    Select Case UCase$(msysDesc.Columns(cIdx).Name)
                        Case "ID": sysVals(cIdx) = targetObjId
                        Case "PARENTID": sysVals(cIdx) = tablesParentId
                        Case "NAME": sysVals(cIdx) = qName
                        Case "TYPE": sysVals(cIdx) = CInt(5)
                        Case "DATECREATE": sysVals(cIdx) = Now
                        Case "DATEUPDATE": sysVals(cIdx) = Now
                        Case "FLAGS": sysVals(cIdx) = 0&
                        Case "OWNER": sysVals(cIdx) = ownerVal
                        Case Else: sysVals(cIdx) = Null
                    End Select
                Next cIdx
                Dim outPg As Long
                Dim outSl As Integer
                RecordWriter.InsertRecord m_fileNum, m_totalPages, msysDesc, sysVals, outPg, outSl
                msysTd.UpdateDescriptor msysDesc
            End If
        Else
            Set rsObj = msysTd.OpenRecordset()
            If Not rsObj Is Nothing Then
                Do Until rsObj.EOF
                    If StrComp(Trim$(CStr(rsObj.Fields("Name").Value & "")), qName, vbTextCompare) = 0 And CLng(Val(CStr(rsObj.Fields("Type").Value & ""))) = 5 Then
                        rsObj.Edit
                        rsObj.Fields("ParentId").Value = tablesParentId
                        rsObj.Fields("DateUpdate").Value = Now
                        rsObj.Update
                        Exit Do
                    End If
                    rsObj.MoveNext
                Loop
                rsObj.Close
            End If
        End If

        ' 3. Ensure entry in MSysACEs
        Dim msysAceTd As TableDef
        Set msysAceTd = Nothing
        If Not m_tableDefs Is Nothing Then Set msysAceTd = m_tableDefs("MSYSACES")
        If Not msysAceTd Is Nothing Then
            Dim hasAce As Boolean
            hasAce = False
            Dim rsAce As Recordset
            Set rsAce = msysAceTd.OpenRecordset()
            If Not rsAce Is Nothing Then
                Do Until rsAce.EOF
                    If CLng(Val(CStr(rsAce.Fields("ObjectId").Value & ""))) = targetObjId Then
                        hasAce = True
                        Exit Do
                    End If
                    rsAce.MoveNext
                Loop
                rsAce.Close
            End If
            If Not hasAce Then
                Dim msysAceDesc As TableDefDescriptor
                msysAceDesc = msysAceTd.Descriptor
                If msysAceDesc.ColumnCount >= 4 Then
                    Dim aceVals() As Variant
                    ReDim aceVals(0 To msysAceDesc.ColumnCount - 1)
                    Dim acIdx As Long
                    For acIdx = 0 To msysAceDesc.ColumnCount - 1
                        Select Case UCase$(msysAceDesc.Columns(acIdx).Name)
                            Case "ACM": aceVals(acIdx) = 1048575&
                            Case "FINHERITABLE": aceVals(acIdx) = False
                            Case "OBJECTID": aceVals(acIdx) = targetObjId
                            Case "SID": aceVals(acIdx) = ownerVal
                            Case Else: aceVals(acIdx) = Null
                        End Select
                    Next acIdx
                    Dim aceOutPg As Long
                    Dim aceOutSl As Integer
                    RecordWriter.InsertRecord m_fileNum, m_totalPages, msysAceDesc, aceVals, aceOutPg, aceOutSl
                    msysAceTd.UpdateDescriptor msysAceDesc
                End If
            End If
        End If

        ' 4. Write query clauses to MSysQueries matching exact Jet 4 / ACE specification
        Dim msysQryDesc As TableDefDescriptor
        msysQryDesc = msysQryTd.Descriptor
        If msysQryDesc.ColumnCount >= 5 Then
            Dim stmt As SqlStatement
            stmt = SqlParser.ParseSql(qd.SQL)

            ' Attribute 0: Query Type Header (Flag = 0 for SELECT query, Order = 1)
            InsertMSysQueryRow targetObjId, 0, 0, vbNullString, vbNullString, vbNullString, 1

            ' Attribute 255: End of Query marker (Flag = Null, Order = 1)
            InsertMSysQueryRow targetObjId, 255, Null, vbNullString, vbNullString, vbNullString, 1

            ' Attribute 6: Selected columns / expressions (Flag = 0, Order = 1, 2, ...)
            Dim colOrder As Integer
            colOrder = 1
            Dim cleanMainTbl As String
            cleanMainTbl = CleanSqlColName(stmt.TableName)
            If Len(stmt.SelectClause) > 0 Then
                Dim colTokens() As String
                colTokens = SplitTopLevelCommas(stmt.SelectClause)
                Dim ctIdx As Long
                For ctIdx = LBound(colTokens) To UBound(colTokens)
                    Dim colItem As String
                    colItem = Trim$(colTokens(ctIdx))
                    If Len(colItem) > 0 Then
                        If colItem = "*" Or Right$(colItem, 2) = ".*" Then
                            Dim starSrcName As String
                            If colItem = "*" Then
                                starSrcName = cleanMainTbl
                            Else
                                starSrcName = CleanSqlColName(Left$(colItem, Len(colItem) - 2))
                            End If
                            Dim srcTd As TableDef
                            Set srcTd = Nothing
                            If Len(starSrcName) > 0 Then Set srcTd = m_tableDefs(UCase$(starSrcName))
                            If Not srcTd Is Nothing Then
                                Dim srcDesc As TableDefDescriptor
                                srcDesc = srcTd.Descriptor
                                If srcDesc.ColumnCount > 0 Then
                                    Dim scIdx As Long
                                    For scIdx = 0 To srcDesc.ColumnCount - 1
                                        InsertMSysQueryRow targetObjId, 6, 0, "[" & starSrcName & "].[" & srcDesc.Columns(scIdx).Name & "]", vbNullString, vbNullString, colOrder
                                        colOrder = colOrder + 1
                                    Next scIdx
                                Else
                                    InsertMSysQueryRow targetObjId, 3, 1, vbNullString, vbNullString, vbNullString, 1
                                End If
                            Else
                                Dim srcQd As QueryDef
                                Set srcQd = Nothing
                                If Len(starSrcName) > 0 And Not m_queryDefs Is Nothing Then Set srcQd = m_queryDefs.Item(starSrcName)
                                If Not srcQd Is Nothing And srcQd.Fields.Count > 0 Then
                                    Dim qfIdx As Long
                                    For qfIdx = 0 To srcQd.Fields.Count - 1
                                        InsertMSysQueryRow targetObjId, 6, 0, "[" & starSrcName & "].[" & srcQd.Fields(qfIdx).Name & "]", vbNullString, vbNullString, colOrder
                                        colOrder = colOrder + 1
                                    Next qfIdx
                                Else
                                    InsertMSysQueryRow targetObjId, 3, 1, vbNullString, vbNullString, vbNullString, 1
                                End If
                            End If
                        Else
                            Dim colExpr As String
                            Dim colAlias As String
                            ParseColumnAndAlias colItem, colExpr, colAlias
                            InsertMSysQueryRow targetObjId, 6, 0, colExpr, colAlias, vbNullString, colOrder
                            colOrder = colOrder + 1
                        End If
                    End If
                Next ctIdx
            End If

            ' Attribute 5 (Source tables, Flag = Null) and Attribute 7 (JOIN edges)
            If Len(stmt.FromClause) > 0 Then
                EmitFromClauseToMSysQueries targetObjId, stmt.FromClause, cleanMainTbl
            End If

            ' Attribute 8: WHERE clause (Flag = Null, Order = 1)
            If Len(stmt.WhereClause) > 0 Then
                InsertMSysQueryRow targetObjId, 8, Null, stmt.WhereClause, vbNullString, vbNullString, 1
            End If

            ' Attribute 9: GROUP BY clause (Flag = Null, Order = 1, 2, ...)
            If Len(stmt.GroupByClause) > 0 Then
                Dim grpTokens() As String
                grpTokens = SplitTopLevelCommas(stmt.GroupByClause)
                Dim gIdx As Long
                Dim grpOrder As Integer
                grpOrder = 1
                For gIdx = LBound(grpTokens) To UBound(grpTokens)
                    Dim grpItem As String
                    grpItem = Trim$(grpTokens(gIdx))
                    If Len(grpItem) > 0 Then
                        InsertMSysQueryRow targetObjId, 9, Null, grpItem, vbNullString, vbNullString, grpOrder
                        grpOrder = grpOrder + 1
                    End If
                Next gIdx
            End If

            ' Attribute 10: HAVING clause (Flag = Null, Order = 1)
            If Len(stmt.HavingClause) > 0 Then
                InsertMSysQueryRow targetObjId, 10, Null, stmt.HavingClause, vbNullString, vbNullString, 1
            End If

            ' Attribute 11: ORDER BY clause (Flag = Null, Name1 = "d" for DESC or Null for ASC, Order = 1, 2, ...)
            If Len(stmt.OrderByClause) > 0 Then
                Dim ordTokens() As String
                ordTokens = SplitTopLevelCommas(stmt.OrderByClause)
                Dim oIdx As Long
                Dim ordOrder As Integer
                ordOrder = 1
                For oIdx = LBound(ordTokens) To UBound(ordTokens)
                    Dim orderExpr As String
                    Dim orderDescFlag As String
                    orderExpr = Trim$(ordTokens(oIdx))
                    If Len(orderExpr) > 0 Then
                        If UCase$(Right$(orderExpr, 5)) = " DESC" Then
                            orderDescFlag = "d"
                            orderExpr = Trim$(Left$(orderExpr, Len(orderExpr) - 5))
                        ElseIf UCase$(Right$(orderExpr, 4)) = " ASC" Then
                            orderDescFlag = vbNullString
                            orderExpr = Trim$(Left$(orderExpr, Len(orderExpr) - 4))
                        Else
                            orderDescFlag = vbNullString
                        End If
                        InsertMSysQueryRow targetObjId, 11, Null, orderExpr, orderDescFlag, vbNullString, ordOrder
                        ordOrder = ordOrder + 1
                    End If
                Next oIdx
            End If

            ' Attribute 3: Query Options Flag (Flag = 2 for DISTINCT, Order = 1)
            If stmt.IsDistinct Then
                InsertMSysQueryRow targetObjId, 3, 2, vbNullString, vbNullString, vbNullString, 1
            End If
        End If

        ' Clean any previously corrupted entries in MSysNavPane tables (do not manually insert NavPane rows)
        CleanCorruptedNavPaneEntries

        On Error GoTo 0
    End Sub

    Private Sub EmitFromClauseToMSysQueries(ByVal qId As Long, ByVal fromClause As String, ByVal fallbackTableName As String)
        On Error Resume Next
        Dim tblNames As New Collection
        Dim joinLefts As New Collection
        Dim joinRights As New Collection
        Dim joinFlags As New Collection
        Dim joinExprs As New Collection

        If InStr(1, fromClause, " JOIN ", vbTextCompare) > 0 Then
            CollectJoinTreeForMSysQueries fromClause, tblNames, joinLefts, joinRights, joinFlags, joinExprs
            Dim jIdx As Long
            For jIdx = 1 To joinLefts.Count
                InsertMSysQueryRow qId, 7, CInt(joinFlags(jIdx)), CStr(joinExprs(jIdx)), CStr(joinLefts(jIdx)), CStr(joinRights(jIdx)), CInt(jIdx)
            Next jIdx
            Dim tIdx As Long
            For tIdx = 1 To tblNames.Count
                InsertMSysQueryRow qId, 5, Null, vbNullString, CStr(tblNames(tIdx)), vbNullString, CInt(tIdx)
            Next tIdx
        ElseIf InStr(1, fromClause, ",") > 0 Then
            Dim fromParts() As String
            fromParts = SplitTopLevelCommas(fromClause)
            Dim fpIdx As Long
            Dim tblOrd As Integer
            tblOrd = 1
            For fpIdx = LBound(fromParts) To UBound(fromParts)
                Dim cleanPart As String
                cleanPart = CleanSqlColName(fromParts(fpIdx))
                If Len(cleanPart) > 0 Then
                    InsertMSysQueryRow qId, 5, Null, vbNullString, cleanPart, vbNullString, tblOrd
                    tblOrd = tblOrd + 1
                End If
            Next fpIdx
        Else
            Dim singleTbl As String
            singleTbl = fallbackTableName
            If Len(singleTbl) = 0 Then singleTbl = CleanSqlColName(fromClause)
            If Len(singleTbl) > 0 Then
                InsertMSysQueryRow qId, 5, Null, vbNullString, singleTbl, vbNullString, 1
            End If
        End If
        On Error GoTo 0
    End Sub

    Private Function FindTableOwningColumn(ByVal tblNames As Collection, ByVal colName As String) As String
        On Error Resume Next
        FindTableOwningColumn = vbNullString
        If tblNames Is Nothing Or Len(colName) = 0 Or m_tableDefs Is Nothing Then Exit Function
        Dim tVar As Variant
        Dim tdCand As TableDef
        Dim descCand As TableDefDescriptor
        Dim cIdx As Long
        For Each tVar In tblNames
            Set tdCand = Nothing
            Set tdCand = m_tableDefs(UCase$(CStr(tVar)))
            If Not tdCand Is Nothing Then
                descCand = tdCand.Descriptor
                For cIdx = 0 To descCand.ColumnCount - 1
                    If StrComp(descCand.Columns(cIdx).Name, colName, vbTextCompare) = 0 Then
                        FindTableOwningColumn = CStr(tVar)
                        Exit Function
                    End If
                Next cIdx
            End If
        Next tVar
        On Error GoTo 0
    End Function

    Private Sub CollectJoinTreeForMSysQueries(ByVal fromSegment As String, ByVal tblNames As Collection, ByVal joinLefts As Collection, ByVal joinRights As Collection, ByVal joinFlags As Collection, ByVal joinExprs As Collection)
        On Error Resume Next
        Dim jType As String
        Dim jLeft As String
        Dim jRight As String
        Dim jLeftKey As String
        Dim jRightKey As String
        Dim jLeftKeyTbl As String
        Dim jRightKeyTbl As String
        If ParseJoinClause(fromSegment, jType, jLeft, jRight, jLeftKey, jRightKey, jLeftKeyTbl, jRightKeyTbl) Then
            Dim leftLeaf As String
            Dim rightLeaf As String
            If InStr(1, jLeft, " JOIN ", vbTextCompare) > 0 Then
                CollectJoinTreeForMSysQueries jLeft, tblNames, joinLefts, joinRights, joinFlags, joinExprs
                leftLeaf = jLeftKeyTbl
                If Len(leftLeaf) = 0 Then leftLeaf = ExtractSqlTablePrefix(jLeftKey)
                If Len(leftLeaf) = 0 Then leftLeaf = FindTableOwningColumn(tblNames, CleanSqlColName(jLeftKey))
                If Len(leftLeaf) = 0 And tblNames.Count > 0 Then leftLeaf = CStr(tblNames(1))
            Else
                leftLeaf = CleanSqlColName(jLeft)
                AddUniqueTableName tblNames, leftLeaf
            End If
            If InStr(1, jRight, " JOIN ", vbTextCompare) > 0 Then
                CollectJoinTreeForMSysQueries jRight, tblNames, joinLefts, joinRights, joinFlags, joinExprs
                rightLeaf = jRightKeyTbl
                If Len(rightLeaf) = 0 Then rightLeaf = ExtractSqlTablePrefix(jRightKey)
                If Len(rightLeaf) = 0 Then rightLeaf = FindTableOwningColumn(tblNames, CleanSqlColName(jRightKey))
                If Len(rightLeaf) = 0 And tblNames.Count > 0 Then rightLeaf = CStr(tblNames(tblNames.Count))
            Else
                rightLeaf = CleanSqlColName(jRight)
                AddUniqueTableName tblNames, rightLeaf
            End If
            Dim jFlag As Integer
            If StrComp(jType, "LEFT", vbTextCompare) = 0 Then
                jFlag = 2
            ElseIf StrComp(jType, "RIGHT", vbTextCompare) = 0 Then
                jFlag = 3
            Else
                jFlag = 1
            End If
            Dim onCond As String
            onCond = "[" & leftLeaf & "].[" & CleanSqlColName(jLeftKey) & "] = [" & rightLeaf & "].[" & CleanSqlColName(jRightKey) & "]"
            joinLefts.Add leftLeaf
            joinRights.Add rightLeaf
            joinFlags.Add jFlag
            joinExprs.Add onCond
        Else
            Dim cleanSeg As String
            cleanSeg = CleanSqlColName(fromSegment)
            If Len(cleanSeg) > 0 Then AddUniqueTableName tblNames, cleanSeg
        End If
        On Error GoTo 0
    End Sub

    Private Sub AddUniqueTableName(ByVal tblNames As Collection, ByVal tName As String)
        If Len(tName) = 0 Then Exit Sub
        Dim existing As Variant
        For Each existing In tblNames
            If StrComp(CStr(existing), tName, vbTextCompare) = 0 Then Exit Sub
        Next existing
        tblNames.Add tName
    End Sub

    Private Sub CleanCorruptedNavPaneEntries()
        On Error Resume Next
        If m_tableDefs Is Nothing Then Exit Sub
        Dim navObjTd As TableDef
        Set navObjTd = m_tableDefs("MSYSNAVPANEOBJECTIDS")
        If Not navObjTd Is Nothing Then
            Dim rsNavObj As Recordset
            Set rsNavObj = navObjTd.OpenRecordset()
            If Not rsNavObj Is Nothing Then
                Do Until rsNavObj.EOF
                    If IsNull(rsNavObj.Fields("Id").Value) Or IsNull(rsNavObj.Fields("Type").Value) Then
                        rsNavObj.Delete
                    Else
                        rsNavObj.MoveNext
                    End If
                Loop
                rsNavObj.Close
            End If
        End If

        Dim navGrpTd As TableDef
        Set navGrpTd = m_tableDefs("MSYSNAVPANEGROUPTOOBJECTS")
        If Not navGrpTd Is Nothing Then
            Dim rsNavGrp As Recordset
            Set rsNavGrp = navGrpTd.OpenRecordset()
            If Not rsNavGrp Is Nothing Then
                Do Until rsNavGrp.EOF
                    If IsNull(rsNavGrp.Fields("Id").Value) Or IsNull(rsNavGrp.Fields("GroupID").Value) Or IsNull(rsNavGrp.Fields("ObjectID").Value) Then
                        rsNavGrp.Delete
                    Else
                        rsNavGrp.MoveNext
                    End If
                Loop
                rsNavGrp.Close
            End If
        End If
        Err.Clear
        On Error GoTo 0
    End Sub

    Private Sub InsertMSysQueryRow(ByVal qId As Long, ByVal attr As Integer, ByVal flagVal As Variant, ByVal expr As String, ByVal name1 As String, ByVal name2 As String, ByVal orderVal As Integer)
        Dim msysQryTd As TableDef
        Set msysQryTd = m_tableDefs("MSYSQUERIES")
        If msysQryTd Is Nothing Then Exit Sub
        Dim msysQryDesc As TableDefDescriptor
        msysQryDesc = msysQryTd.Descriptor
        If msysQryDesc.ColumnCount < 5 Then Exit Sub

        If orderVal <= 0 Then orderVal = 1
        Dim ordBytes(0 To 3) As Byte
        ordBytes(0) = 0
        ordBytes(1) = 0
        ordBytes(2) = CByte((orderVal \ 256) And &HFF&)
        ordBytes(3) = CByte(orderVal And &HFF&)

        Dim qryVals() As Variant
        ReDim qryVals(0 To msysQryDesc.ColumnCount - 1)
        Dim cIdx As Long
        For cIdx = 0 To msysQryDesc.ColumnCount - 1
            Select Case UCase$(msysQryDesc.Columns(cIdx).Name)
                Case "OBJECTID": qryVals(cIdx) = qId
                Case "ATTRIBUTE": qryVals(cIdx) = CByte(attr And &HFF&)
                Case "FLAG": If IsNull(flagVal) Or IsEmpty(flagVal) Then qryVals(cIdx) = Null Else qryVals(cIdx) = CInt(flagVal)
                Case "EXPRESSION": If Len(expr) > 0 Then qryVals(cIdx) = expr Else qryVals(cIdx) = Null
                Case "NAME1": If Len(name1) > 0 Then qryVals(cIdx) = name1 Else qryVals(cIdx) = Null
                Case "NAME2": If Len(name2) > 0 Then qryVals(cIdx) = name2 Else qryVals(cIdx) = Null
                Case "ORDER": qryVals(cIdx) = ordBytes
                Case Else: qryVals(cIdx) = Null
            End Select
        Next cIdx
        Dim outPg As Long
        Dim outSl As Integer
        RecordWriter.InsertRecord m_fileNum, m_totalPages, msysQryDesc, qryVals, outPg, outSl
        msysQryTd.UpdateDescriptor msysQryDesc
    End Sub

    Private Function SplitTopLevelCommas(ByVal s As String) As String()
        Dim res() As String
        Dim count As Long
        count = 0
        Dim inSq As Boolean, inDq As Boolean, inBk As Long, inPar As Long
        Dim i As Long, startPos As Long, sLen As Long
        Dim c As String
        sLen = Len(s)
        startPos = 1
        For i = 1 To sLen
            c = Mid$(s, i, 1)
            If c = "'" And Not inDq Then
                inSq = Not inSq
            ElseIf c = """" And Not inSq Then
                inDq = Not inDq
            ElseIf c = "[" And Not inSq And Not inDq Then
                inBk = inBk + 1
            ElseIf c = "]" And Not inSq And Not inDq Then
                If inBk > 0 Then inBk = inBk - 1
            ElseIf c = "(" And Not inSq And Not inDq Then
                inPar = inPar + 1
            ElseIf c = ")" And Not inSq And Not inDq Then
                If inPar > 0 Then inPar = inPar - 1
            ElseIf c = "," And Not inSq And Not inDq And inBk = 0 And inPar = 0 Then
                ReDim Preserve res(0 To count)
                res(count) = Trim$(Mid$(s, startPos, i - startPos))
                count = count + 1
                startPos = i + 1
            End If
        Next i
        If startPos <= sLen + 1 Then
            ReDim Preserve res(0 To count)
            res(count) = Trim$(Mid$(s, startPos, sLen - startPos + 1))
            count = count + 1
        End If
        SplitTopLevelCommas = res
    End Function

    Private Sub ParseColumnAndAlias(ByVal item As String, ByRef outExpr As String, ByRef outAlias As String)
        Dim s As String
        s = Trim$(item)
        outExpr = s
        outAlias = vbNullString
        Dim asPos As Long
        asPos = SqlParser.FindSqlClauseKeyword(s, "AS")
        If asPos > 0 Then
            outExpr = Trim$(Left$(s, asPos - 1))
            outAlias = CleanSqlColName(Trim$(Mid$(s, asPos + 2)))
        End If
    End Sub

    Friend Sub DeleteQueryDefFromCatalog(ByVal queryName As String)
        On Error Resume Next
        Dim cleanQry As String
        cleanQry = Trim$(Replace$(Replace$(queryName, "[", ""), "]", ""))
        If Len(cleanQry) = 0 Or m_fileNum <= 0 Or m_totalPages <= 0 Or m_isReadOnly Then Exit Sub
        If m_tableDefs Is Nothing Then Exit Sub

        Dim msysTd As TableDef
        Set msysTd = m_tableDefs("MSYSOBJECTS")
        If msysTd Is Nothing Then Exit Sub

        Dim msysQryTd As TableDef
        Set msysQryTd = m_tableDefs("MSYSQUERIES")

        Dim msysAceTd As TableDef
        Set msysAceTd = m_tableDefs("MSYSACES")

        Dim navObjTd As TableDef
        Set navObjTd = m_tableDefs("MSYSNAVPANEOBJECTIDS")

        Dim navGrpTd As TableDef
        Set navGrpTd = m_tableDefs("MSYSNAVPANEGROUPTOOBJECTS")

        Dim targetObjId As Long
        targetObjId = 0

        ' 1. Remove row from MSysObjects and get ObjectId
        Dim rsObj As Recordset
        Set rsObj = msysTd.OpenRecordset()
        If Not rsObj Is Nothing Then
            Do Until rsObj.EOF
                Dim rName As String
                Dim rType As Long
                rName = Trim$(CStr(rsObj.Fields("Name").Value & ""))
                If IsNumeric(rsObj.Fields("Type").Value) Then rType = CLng(rsObj.Fields("Type").Value) Else rType = 0
                If rType = 5 And StrComp(rName, cleanQry, vbTextCompare) = 0 Then
                    If IsNumeric(rsObj.Fields("Id").Value) Then targetObjId = CLng(rsObj.Fields("Id").Value)
                    rsObj.Delete
                    Exit Do
                End If
                rsObj.MoveNext
            Loop
            rsObj.Close
        End If

        ' 2. Remove rows from MSysQueries
        If Not msysQryTd Is Nothing And targetObjId <> 0 Then
            Dim rsQry As Recordset
            Set rsQry = msysQryTd.OpenRecordset()
            If Not rsQry Is Nothing Then
                Do Until rsQry.EOF
                    Dim qryObjId As Long
                    If IsNumeric(rsQry.Fields("ObjectId").Value) Then qryObjId = CLng(rsQry.Fields("ObjectId").Value) Else qryObjId = 0
                    If qryObjId = targetObjId Then
                        rsQry.Delete
                    Else
                        rsQry.MoveNext
                    End If
                Loop
                rsQry.Close
            End If
        End If

        ' 3. Remove rows from MSysACEs
        If Not msysAceTd Is Nothing And targetObjId <> 0 Then
            Dim rsAce As Recordset
            Set rsAce = msysAceTd.OpenRecordset()
            If Not rsAce Is Nothing Then
                Do Until rsAce.EOF
                    Dim aceObjId As Long
                    If IsNumeric(rsAce.Fields("ObjectId").Value) Then aceObjId = CLng(rsAce.Fields("ObjectId").Value) Else aceObjId = 0
                    If aceObjId = targetObjId Then
                        rsAce.Delete
                    Else
                        rsAce.MoveNext
                    End If
                Loop
                rsAce.Close
            End If
        End If

        ' 4. Remove rows from MSysNavPaneObjectIDs
        If Not navObjTd Is Nothing And targetObjId <> 0 Then
            Dim rsNavObj As Recordset
            Set rsNavObj = navObjTd.OpenRecordset()
            If Not rsNavObj Is Nothing Then
                Do Until rsNavObj.EOF
                    If CLng(Val(CStr(rsNavObj.Fields("Id").Value & ""))) = targetObjId Then
                        rsNavObj.Delete
                        Exit Do
                    End If
                    rsNavObj.MoveNext
                Loop
                rsNavObj.Close
            End If
        End If

        ' 5. Remove rows from MSysNavPaneGroupToObjects
        If Not navGrpTd Is Nothing And targetObjId <> 0 Then
            Dim rsNavGrp As Recordset
            Set rsNavGrp = navGrpTd.OpenRecordset()
            If Not rsNavGrp Is Nothing Then
                Do Until rsNavGrp.EOF
                    If CLng(Val(CStr(rsNavGrp.Fields("ObjectID").Value & ""))) = targetObjId Then
                        rsNavGrp.Delete
                    Else
                        rsNavGrp.MoveNext
                    End If
                Loop
                rsNavGrp.Close
            End If
        End If

        On Error GoTo 0
    End Sub

    Public Function HasTableName(ByVal objName As String) As Boolean
        On Error Resume Next
        Dim cleanName As String
        cleanName = Trim$(Replace$(Replace$(objName, "[", ""), "]", ""))
        If Len(cleanName) = 0 Then
            HasTableName = False
            On Error GoTo 0
            Exit Function
        End If
        If Not m_tableDefs Is Nothing Then
            If m_tableDefs.HasItem(cleanName) Then
                HasTableName = True
                On Error GoTo 0
                Exit Function
            End If
            Dim msysTd As TableDef
            Set msysTd = m_tableDefs("MSYSOBJECTS")
            If Not msysTd Is Nothing Then
                Dim rsObj As Recordset
                Set rsObj = msysTd.OpenRecordset()
                If Not rsObj Is Nothing Then
                    Do Until rsObj.EOF
                        Dim rName As String
                        Dim rType As Long
                        rName = Trim$(CStr(rsObj.Fields("Name").Value & ""))
                        If IsNumeric(rsObj.Fields("Type").Value) Then rType = CLng(rsObj.Fields("Type").Value) Else rType = 0
                        If (rType = 1 Or rType = 4 Or rType = 6) And StrComp(rName, cleanName, vbTextCompare) = 0 Then
                            HasTableName = True
                            rsObj.Close
                            On Error GoTo 0
                            Exit Function
                        End If
                        rsObj.MoveNext
                    Loop
                    rsObj.Close
                End If
            End If
        End If
        HasTableName = False
        Err.Clear
        On Error GoTo 0
    End Function

    Public Function HasQueryName(ByVal objName As String) As Boolean
        On Error Resume Next
        Dim cleanName As String
        cleanName = Trim$(Replace$(Replace$(objName, "[", ""), "]", ""))
        If Len(cleanName) = 0 Then
            HasQueryName = False
            On Error GoTo 0
            Exit Function
        End If
        If Not m_queryDefs Is Nothing Then
            Dim qdExisting As QueryDef
            Set qdExisting = Nothing
            Set qdExisting = m_queryDefs.Item(cleanName)
            If Not qdExisting Is Nothing Then
                HasQueryName = True
                On Error GoTo 0
                Exit Function
            End If
        End If
        If Not m_tableDefs Is Nothing Then
            Dim msysTd As TableDef
            Set msysTd = m_tableDefs("MSYSOBJECTS")
            If Not msysTd Is Nothing Then
                Dim rsObj As Recordset
                Set rsObj = msysTd.OpenRecordset()
                If Not rsObj Is Nothing Then
                    Do Until rsObj.EOF
                        Dim rName As String
                        Dim rType As Long
                        rName = Trim$(CStr(rsObj.Fields("Name").Value & ""))
                        If IsNumeric(rsObj.Fields("Type").Value) Then rType = CLng(rsObj.Fields("Type").Value) Else rType = 0
                        If rType = 5 And StrComp(rName, cleanName, vbTextCompare) = 0 Then
                            HasQueryName = True
                            rsObj.Close
                            On Error GoTo 0
                            Exit Function
                        End If
                        rsObj.MoveNext
                    Loop
                    rsObj.Close
                End If
            End If
        End If
        HasQueryName = False
        Err.Clear
        On Error GoTo 0
    End Function

    Private Sub WriteMr2UInt16(ByRef buf() As Byte, ByRef pos As Long, ByVal v As Long)
        buf(pos) = CByte(v And &HFF&)
        buf(pos + 1) = CByte((v \ &H100&) And &HFF&)
        pos = pos + 2
    End Sub

    Private Sub WriteMr2Int32(ByRef buf() As Byte, ByRef pos As Long, ByVal v As Long)
        buf(pos) = CByte(v And &HFF&)
        buf(pos + 1) = CByte((v \ &H100&) And &HFF&)
        buf(pos + 2) = CByte((v \ &H10000) And &HFF&)
        buf(pos + 3) = CByte((v \ &H1000000) And &HFF&)
        pos = pos + 4
    End Sub

    Private Sub WriteMr2Ucs2(ByRef buf() As Byte, ByRef pos As Long, ByVal s As String)
        Dim i As Long
        Dim ch As Long
        For i = 1 To Len(s)
            ch = AscW(Mid$(s, i, 1)) And &HFFFF&
            buf(pos) = CByte(ch And &HFF&)
            buf(pos + 1) = CByte((ch \ &H100&) And &HFF&)
            pos = pos + 2
        Next i
    End Sub

    Private Sub WriteMr2PropText(ByRef buf() As Byte, ByRef pos As Long, ByVal dtype As Byte, ByVal nameIdx As Long, ByVal valStr As String)
        Dim dsize As Long
        dsize = Len(valStr) * 2
        WriteMr2UInt16 buf, pos, 8 + dsize
        buf(pos) = 0
        buf(pos + 1) = dtype
        pos = pos + 2
        WriteMr2UInt16 buf, pos, nameIdx
        WriteMr2UInt16 buf, pos, dsize
        WriteMr2Ucs2 buf, pos, valStr
    End Sub

    Private Sub WriteMr2PropInt16(ByRef buf() As Byte, ByRef pos As Long, ByVal nameIdx As Long, ByVal intVal As Long)
        WriteMr2UInt16 buf, pos, 10
        buf(pos) = 0
        buf(pos + 1) = 3 ' JetColumnType.ColInteger
        pos = pos + 2
        WriteMr2UInt16 buf, pos, nameIdx
        WriteMr2UInt16 buf, pos, 2
        WriteMr2UInt16 buf, pos, intVal
    End Sub

    Private Sub WriteMr2PropBool(ByRef buf() As Byte, ByRef pos As Long, ByVal nameIdx As Long, ByVal boolVal As Boolean)
        WriteMr2UInt16 buf, pos, 9
        buf(pos) = 0
        buf(pos + 1) = 1 ' JetColumnType.ColBoolean
        pos = pos + 2
        WriteMr2UInt16 buf, pos, nameIdx
        WriteMr2UInt16 buf, pos, 1
        buf(pos) = IIf(boolVal, 1, 0)
        pos = pos + 1
    End Sub

    Private Function BuildTableLookupMr2Bytes(ByRef fkCols() As String, ByRef rowSources() As String, ByRef colCounts() As Long, ByRef colWidthsArr() As String, ByVal fkCount As Long) As Byte()
        Dim propNames(0 To 6) As String
        propNames(0) = "DisplayControl"
        propNames(1) = "RowSourceType"
        propNames(2) = "RowSource"
        propNames(3) = "BoundColumn"
        propNames(4) = "ColumnCount"
        propNames(5) = "ColumnWidths"
        propNames(6) = "LimitToList"

        Dim pIdx As Long
        Dim namesBodyLen As Long
        namesBodyLen = 0
        For pIdx = 0 To 6
            namesBodyLen = namesBodyLen + 2 + (Len(propNames(pIdx)) * 2)
        Next pIdx
        Dim chunk80Len As Long
        chunk80Len = 6 + namesBodyLen

        Dim chunk00Len As Long
        chunk00Len = 12

        Dim colChunkLens() As Long
        ReDim colChunkLens(0 To fkCount - 1)
        Dim k As Long
        Dim cNameBytes As Long
        Dim nameSubLen As Long
        Dim rSrcBytes As Long
        Dim cWidBytes As Long
        Dim totalBytes As Long
        totalBytes = 4 + chunk80Len + chunk00Len

        For k = 0 To fkCount - 1
            cNameBytes = Len(fkCols(k)) * 2
            nameSubLen = 6 + cNameBytes
            rSrcBytes = Len(rowSources(k)) * 2
            cWidBytes = Len(colWidthsArr(k)) * 2
            colChunkLens(k) = 6 + nameSubLen + 10 + 30 + (8 + rSrcBytes) + 10 + 10 + (8 + cWidBytes) + 9
            totalBytes = totalBytes + colChunkLens(k)
        Next k

        Dim outBuf() As Byte
        ReDim outBuf(0 To totalBytes - 1)
        Dim pos As Long
        pos = 0

        ' 1. 4-byte MR2\0 header
        outBuf(0) = &H4D& ' M
        outBuf(1) = &H52& ' R
        outBuf(2) = &H32& ' 2
        outBuf(3) = &H0&
        pos = 4

        ' 2. Chunk 0x0080: Property Name Dictionary
        WriteMr2Int32 outBuf, pos, chunk80Len
        WriteMr2UInt16 outBuf, pos, &H80&
        For pIdx = 0 To 6
            WriteMr2UInt16 outBuf, pos, Len(propNames(pIdx)) * 2
            WriteMr2Ucs2 outBuf, pos, propNames(pIdx)
        Next pIdx

        ' 3. Chunk 0x0000: Table-level default block
        WriteMr2Int32 outBuf, pos, chunk00Len
        WriteMr2UInt16 outBuf, pos, &H0&
        WriteMr2UInt16 outBuf, pos, 6
        WriteMr2UInt16 outBuf, pos, 0
        WriteMr2UInt16 outBuf, pos, 0

        ' 4. Chunks 0x0001: Column-level Lookup property blocks
        For k = 0 To fkCount - 1
            cNameBytes = Len(fkCols(k)) * 2
            nameSubLen = 6 + cNameBytes
            WriteMr2Int32 outBuf, pos, colChunkLens(k)
            WriteMr2UInt16 outBuf, pos, &H1&
            WriteMr2UInt16 outBuf, pos, nameSubLen
            WriteMr2UInt16 outBuf, pos, 0
            WriteMr2UInt16 outBuf, pos, cNameBytes
            WriteMr2Ucs2 outBuf, pos, fkCols(k)
            WriteMr2PropInt16 outBuf, pos, 0, 111                         ' DisplayControl = 111 (Combo Box)
            WriteMr2PropText outBuf, pos, 10, 1, "Table/Query"            ' RowSourceType = "Table/Query"
            WriteMr2PropText outBuf, pos, 12, 2, rowSources(k)            ' RowSource = SELECT ...
            WriteMr2PropInt16 outBuf, pos, 3, 1                           ' BoundColumn = 1
            WriteMr2PropInt16 outBuf, pos, 4, colCounts(k)                ' ColumnCount = 2
            WriteMr2PropText outBuf, pos, 10, 5, colWidthsArr(k)          ' ColumnWidths = "0;1440"
            WriteMr2PropBool outBuf, pos, 6, True                         ' LimitToList = True
        Next k

        BuildTableLookupMr2Bytes = outBuf
    End Function

    Friend Sub SyncTableLookupLvProp(ByVal foreignTableName As String)
        On Error Resume Next
        Dim cleanTbl As String
        cleanTbl = Trim$(foreignTableName)
        If Len(cleanTbl) = 0 Or m_fileNum <= 0 Or m_totalPages <= 0 Or m_isReadOnly Then
            On Error GoTo 0
            Exit Sub
        End If
        If m_tableDefs Is Nothing Or m_relations Is Nothing Then
            On Error GoTo 0
            Exit Sub
        End If

        Dim msysTd As TableDef
        Set msysTd = m_tableDefs("MSYSOBJECTS")
        If msysTd Is Nothing Then
            On Error GoTo 0
            Exit Sub
        End If

        Dim fkCols() As String
        Dim rowSources() As String
        Dim colCounts() As Long
        Dim colWidthsArr() As String
        Dim fkCount As Long
        fkCount = 0

        Dim rIdx As Long
        Dim relObj As Relation
        Dim fIdx As Long
        Dim fkCol As String
        Dim pkCol As String
        Dim parentTbl As String
        Dim dispCol As String
        Dim parentTd As TableDef
        Dim parentDesc As TableDefDescriptor
        Dim cIdx As Integer
        Dim candName As String
        Dim candType As Byte
        Dim sqlSrc As String
        Dim cCnt As Long
        Dim cWid As String
        Dim dupIdx As Long
        Dim isDup As Boolean

        For rIdx = 0 To m_relations.Count - 1
            Set relObj = m_relations.Item(rIdx)
            If Not relObj Is Nothing Then
                If StrComp(Trim$(relObj.ForeignTable), cleanTbl, vbTextCompare) = 0 And relObj.Fields.Count > 0 Then
                    parentTbl = Trim$(relObj.Table)
                    Set parentTd = Nothing
                    Set parentTd = m_tableDefs(UCase$(parentTbl))
                    For fIdx = 0 To relObj.Fields.Count - 1
                        fkCol = Trim$(relObj.Fields(fIdx).ForeignName)
                        pkCol = Trim$(relObj.Fields(fIdx).Name)
                        If Len(fkCol) > 0 And Len(pkCol) > 0 And Len(parentTbl) > 0 Then
                            dispCol = ""
                            If Not parentTd Is Nothing Then
                                parentDesc = parentTd.Descriptor
                                For cIdx = 0 To parentDesc.ColumnCount - 1
                                    candName = Trim$(parentDesc.Columns(cIdx).Name)
                                    candType = parentDesc.Columns(cIdx).ColType
                                    If StrComp(candName, pkCol, vbTextCompare) <> 0 Then
                                        If candType = 10 Or candType = 12 Then
                                            dispCol = candName
                                            Exit For
                                        End If
                                    End If
                                Next cIdx
                                If Len(dispCol) = 0 Then
                                    For cIdx = 0 To parentDesc.ColumnCount - 1
                                        candName = Trim$(parentDesc.Columns(cIdx).Name)
                                        If StrComp(candName, pkCol, vbTextCompare) <> 0 Then
                                            dispCol = candName
                                            Exit For
                                        End If
                                    Next cIdx
                                End If
                            End If
                            If Len(dispCol) = 0 Then dispCol = pkCol

                            If StrComp(dispCol, pkCol, vbTextCompare) <> 0 Then
                                sqlSrc = "SELECT [" & parentTbl & "].[" & pkCol & "], [" & parentTbl & "].[" & dispCol & "] FROM [" & parentTbl & "];"
                                cCnt = 2
                                cWid = "0;1440"
                            Else
                                sqlSrc = "SELECT [" & parentTbl & "].[" & pkCol & "] FROM [" & parentTbl & "];"
                                cCnt = 1
                                cWid = "1440"
                            End If

                            isDup = False
                            For dupIdx = 0 To fkCount - 1
                                If StrComp(fkCols(dupIdx), fkCol, vbTextCompare) = 0 Then
                                    fkCols(dupIdx) = fkCol
                                    rowSources(dupIdx) = sqlSrc
                                    colCounts(dupIdx) = cCnt
                                    colWidthsArr(dupIdx) = cWid
                                    isDup = True
                                    Exit For
                                End If
                            Next dupIdx

                            If Not isDup Then
                                ReDim Preserve fkCols(0 To fkCount)
                                ReDim Preserve rowSources(0 To fkCount)
                                ReDim Preserve colCounts(0 To fkCount)
                                ReDim Preserve colWidthsArr(0 To fkCount)
                                fkCols(fkCount) = fkCol
                                rowSources(fkCount) = sqlSrc
                                colCounts(fkCount) = cCnt
                                colWidthsArr(fkCount) = cWid
                                fkCount = fkCount + 1
                            End If
                        End If
                    Next fIdx
                End If
            End If
        Next rIdx

        Dim mr2Bytes() As Byte
        Dim targetLen As Long
        If fkCount > 0 Then
            mr2Bytes = BuildTableLookupMr2Bytes(fkCols, rowSources, colCounts, colWidthsArr, fkCount)
            targetLen = UBound(mr2Bytes) - LBound(mr2Bytes) + 1
        Else
            targetLen = 0
        End If

        Dim rsObj As Recordset
        Set rsObj = msysTd.OpenRecordset()
        If Not rsObj Is Nothing Then
            If Not rsObj.EOF Then
                rsObj.MoveFirst
                Do Until rsObj.EOF
                    Dim rName As String
                    Dim rType As Long
                    rName = Trim$(CStr(rsObj.Fields("Name").Value & ""))
                    If IsNumeric(rsObj.Fields("Type").Value) Then rType = CLng(rsObj.Fields("Type").Value) Else rType = 0
                    If rType = 1 And StrComp(rName, cleanTbl, vbTextCompare) = 0 Then
                        Dim curLv As Variant
                        Dim curLen As Long
                        curLv = rsObj.Fields("LvProp").Value
                        curLen = 0
                        If Not IsNull(curLv) And Not IsEmpty(curLv) Then
                            If VarType(curLv) = (vbArray Or vbByte) Then
                                Dim curArr() As Byte
                                curArr = curLv
                                curLen = UBound(curArr) - LBound(curArr) + 1
                            End If
                        End If
                        If targetLen > 0 Then
                            If curLen <> targetLen Then
                                rsObj.Edit
                                rsObj.Fields("LvProp").Value = mr2Bytes
                                rsObj.Update
                            End If
                        ElseIf curLen > 0 Then
                            rsObj.Edit
                            rsObj.Fields("LvProp").Value = Null
                            rsObj.Update
                        End If
                        Exit Do
                    End If
                    rsObj.MoveNext
                Loop
            End If
            rsObj.Close
        End If
        Err.Clear
        On Error GoTo 0
    End Sub

    Friend Sub EnsureRelationCatalogEntry(ByVal relName As String)
        On Error Resume Next
        Dim cleanRel As String
        cleanRel = Trim$(relName)
        If Len(cleanRel) = 0 Or m_fileNum <= 0 Or m_totalPages <= 0 Or m_isReadOnly Then
            On Error GoTo 0
            Exit Sub
        End If
        If m_tableDefs Is Nothing Then
            On Error GoTo 0
            Exit Sub
        End If

        Dim msysTd As TableDef
        Set msysTd = m_tableDefs("MSYSOBJECTS")
        If msysTd Is Nothing Then
            On Error GoTo 0
            Exit Sub
        End If

        Dim relParentId As Long
        Dim ownerBytes(0 To 1) As Byte
        Dim ownerVal As Variant
        Dim existsRelObj As Boolean
        Dim minSynthId As Long
        Dim rId As Long
        Dim rType As Long
        Dim rName As String

        ownerBytes(0) = &HA6&
        ownerBytes(1) = &H33&
        ownerVal = ownerBytes
        relParentId = &HF0000003
        existsRelObj = False
        minSynthId = -2147483640&

        Dim rsObj As Recordset
        Set rsObj = msysTd.OpenRecordset()
        If Not rsObj Is Nothing Then
            If Not rsObj.EOF Then
                rsObj.MoveFirst
                Do Until rsObj.EOF
                    rName = Trim$(CStr(rsObj.Fields("Name").Value & ""))
                    If IsNumeric(rsObj.Fields("Type").Value) Then rType = CLng(rsObj.Fields("Type").Value) Else rType = 0
                    If IsNumeric(rsObj.Fields("Id").Value) Then rId = CLng(rsObj.Fields("Id").Value) Else rId = 0

                    If rType = 3 And StrComp(rName, "Relationships", vbTextCompare) = 0 Then
                        If rId <> 0 Then relParentId = rId
                        If Not IsNull(rsObj.Fields("Owner").Value) And Not IsEmpty(rsObj.Fields("Owner").Value) Then
                            ownerVal = rsObj.Fields("Owner").Value
                        End If
                    ElseIf rType = 8 And StrComp(rName, cleanRel, vbTextCompare) = 0 Then
                        existsRelObj = True
                    End If

                    If rId < &HF0000000 And rId >= minSynthId Then
                        minSynthId = rId + 1
                    End If
                    rsObj.MoveNext
                Loop
            End If
            rsObj.Close
        End If

        If Not existsRelObj Then
            Dim msysDesc As TableDefDescriptor
            msysDesc = msysTd.Descriptor
            If msysDesc.ColumnCount >= 7 Then
                Dim sysVals() As Variant
                ReDim sysVals(0 To msysDesc.ColumnCount - 1)
                Dim cIdx As Long
                For cIdx = 0 To msysDesc.ColumnCount - 1
                    Select Case UCase$(msysDesc.Columns(cIdx).Name)
                        Case "ID": sysVals(cIdx) = minSynthId
                        Case "PARENTID": sysVals(cIdx) = relParentId
                        Case "NAME": sysVals(cIdx) = cleanRel
                        Case "TYPE": sysVals(cIdx) = CInt(8)
                        Case "DATECREATE": sysVals(cIdx) = Now
                        Case "DATEUPDATE": sysVals(cIdx) = Now
                        Case "FLAGS": sysVals(cIdx) = 0&
                        Case "OWNER": sysVals(cIdx) = ownerVal
                        Case Else: sysVals(cIdx) = Null
                    End Select
                Next cIdx
                Dim outPg As Long
                Dim outSl As Integer
                RecordWriter.InsertRecord m_fileNum, m_totalPages, msysDesc, sysVals, outPg, outSl
                msysTd.UpdateDescriptor msysDesc

                Dim msysAceTd As TableDef
                Set msysAceTd = Nothing
                Set msysAceTd = m_tableDefs("MSYSACES")
                If Not msysAceTd Is Nothing Then
                    Dim msysAceDesc As TableDefDescriptor
                    msysAceDesc = msysAceTd.Descriptor
                    If msysAceDesc.ColumnCount >= 4 Then
                        Dim aceVals() As Variant
                        ReDim aceVals(0 To msysAceDesc.ColumnCount - 1)
                        Dim acIdx As Long
                        For acIdx = 0 To msysAceDesc.ColumnCount - 1
                            Select Case UCase$(msysAceDesc.Columns(acIdx).Name)
                                Case "ACM": aceVals(acIdx) = 1048575&
                                Case "FINHERITABLE": aceVals(acIdx) = False
                                Case "OBJECTID": aceVals(acIdx) = minSynthId
                                Case "SID": aceVals(acIdx) = ownerVal
                                Case Else: aceVals(acIdx) = Null
                            End Select
                        Next acIdx
                        Dim acePg As Long
                        Dim aceSl As Integer
                        RecordWriter.InsertRecord m_fileNum, m_totalPages, msysAceDesc, aceVals, acePg, aceSl
                        msysAceTd.UpdateDescriptor msysAceDesc
                    End If
                End If
            End If
        End If
        Err.Clear
        On Error GoTo 0
    End Sub

    Friend Sub SyncForeignKeyIndexesOnTdefs(ByVal rel As Relation)
        On Error Resume Next
        If rel Is Nothing Or m_fileNum <= 0 Or m_totalPages <= 0 Or m_isReadOnly Then
            On Error GoTo 0
            Exit Sub
        End If
        If rel.Fields.Count <= 0 Or m_tableDefs Is Nothing Then
            On Error GoTo 0
            Exit Sub
        End If
        If (rel.Attributes And 2&) <> 0 Then
            On Error GoTo 0
            Exit Sub
        End If

        Dim relName As String
        Dim pkTblName As String
        Dim fkTblName As String
        Dim pkColName As String
        Dim fkColName As String
        relName = Trim$(rel.Name)
        pkTblName = Trim$(rel.Table)
        fkTblName = Trim$(rel.ForeignTable)
        pkColName = Trim$(rel.Fields(0).Name)
        fkColName = Trim$(rel.Fields(0).ForeignName)
        If Len(relName) = 0 Or Len(pkTblName) = 0 Or Len(fkTblName) = 0 Or Len(pkColName) = 0 Or Len(fkColName) = 0 Then
            On Error GoTo 0
            Exit Sub
        End If
        If StrComp(pkTblName, fkTblName, vbTextCompare) = 0 Then
            On Error GoTo 0
            Exit Sub
        End If

        Dim pkTd As TableDef
        Dim fkTd As TableDef
        Set pkTd = Nothing
        Set fkTd = Nothing
        Set pkTd = m_tableDefs(UCase$(pkTblName))
        Set fkTd = m_tableDefs(UCase$(fkTblName))
        If pkTd Is Nothing Or fkTd Is Nothing Then
            On Error GoTo 0
            Exit Sub
        End If

        Dim pkDesc As TableDefDescriptor
        Dim fkDesc As TableDefDescriptor
        pkDesc = pkTd.Descriptor
        fkDesc = fkTd.Descriptor
        If pkDesc.TdefPageNumber <= 0 Or fkDesc.TdefPageNumber <= 0 Then
            On Error GoTo 0
            Exit Sub
        End If

        Dim pkNeedWrite As Boolean
        Dim fkNeedWrite As Boolean
        pkNeedWrite = False
        fkNeedWrite = False

        ' Ensure primary table has a PrimaryKey index at slot 0 so the RelTblType=1 Primary FK index can share RealIdxNum = 0
        If pkDesc.IndexCount <= 0 Then
            pkDesc.IndexCount = 1
            ReDim pkDesc.Indexes(0 To 0)
            pkDesc.Indexes(0).Name = "PrimaryKey"
            pkDesc.Indexes(0).IndexNumber = 0
            pkDesc.Indexes(0).RealIdxNum = 0
            pkDesc.Indexes(0).IsPrimary = True
            pkDesc.Indexes(0).IsUnique = True
            pkDesc.Indexes(0).IndexType = 1
            pkDesc.Indexes(0).RelIdxNum = -1&
            pkDesc.Indexes(0).RealIdxFlags = &H89&
            pkDesc.Indexes(0).ColumnCount = 1
            ReDim pkDesc.Indexes(0).ColumnNames(0 To 0)
            pkDesc.Indexes(0).ColumnNames(0) = pkColName
            pkNeedWrite = True
        End If

        Dim i As Integer
        Dim pkIdxPos As Integer
        Dim fkIdxPos As Integer
        pkIdxPos = -1
        For i = 0 To pkDesc.IndexCount - 1
            If StrComp(pkDesc.Indexes(i).Name, relName, vbTextCompare) = 0 And Not pkDesc.Indexes(i).IsPrimary Then
                pkIdxPos = i
                Exit For
            End If
        Next i
        If pkIdxPos < 0 Then
            pkIdxPos = pkDesc.IndexCount
            pkDesc.IndexCount = pkDesc.IndexCount + 1
            ReDim Preserve pkDesc.Indexes(0 To pkDesc.IndexCount - 1)
            pkNeedWrite = True
        End If

        fkIdxPos = -1
        For i = 0 To fkDesc.IndexCount - 1
            If StrComp(fkDesc.Indexes(i).Name, relName, vbTextCompare) = 0 And Not fkDesc.Indexes(i).IsPrimary Then
                fkIdxPos = i
                Exit For
            End If
        Next i
        If fkIdxPos < 0 Then
            fkIdxPos = fkDesc.IndexCount
            fkDesc.IndexCount = fkDesc.IndexCount + 1
            ReDim Preserve fkDesc.Indexes(0 To fkDesc.IndexCount - 1)
            fkNeedWrite = True
        End If

        Dim cascUpd As Byte
        Dim cascDel As Byte
        cascUpd = IIf((rel.Attributes And &H100&) <> 0, 1, 0)
        cascDel = IIf((rel.Attributes And &H1000&) <> 0, 1, 0)

        ' In Jet4/ACE (Jackcess IndexImpl):
        '   RelTblType = 1 (PRIMARY_TABLE_TYPE) on the Primary (One) table, sharing RealIdxNum = 0
        '   RelTblType = 2 (SECONDARY_TABLE_TYPE) on the Foreign (Many) table, with its own Real Index block
        If pkDesc.Indexes(pkIdxPos).IndexType <> 2 Or pkDesc.Indexes(pkIdxPos).RelTblType <> 1 Or pkDesc.Indexes(pkIdxPos).RealIdxNum <> 0 Or pkDesc.Indexes(pkIdxPos).RelIdxNum <> CLng(fkIdxPos) Or pkDesc.Indexes(pkIdxPos).RelTblPage <> fkDesc.TdefPageNumber Then
            pkNeedWrite = True
        End If
        pkDesc.Indexes(pkIdxPos).Name = relName
        pkDesc.Indexes(pkIdxPos).IndexNumber = pkIdxPos
        pkDesc.Indexes(pkIdxPos).RealIdxNum = 0
        pkDesc.Indexes(pkIdxPos).IsPrimary = False
        pkDesc.Indexes(pkIdxPos).IsUnique = False
        pkDesc.Indexes(pkIdxPos).IndexType = 2
        pkDesc.Indexes(pkIdxPos).RelTblType = 1
        pkDesc.Indexes(pkIdxPos).RelIdxNum = CLng(fkIdxPos)
        pkDesc.Indexes(pkIdxPos).RelTblPage = fkDesc.TdefPageNumber
        pkDesc.Indexes(pkIdxPos).CascadeUpdates = cascUpd
        pkDesc.Indexes(pkIdxPos).CascadeDeletes = cascDel
        pkDesc.Indexes(pkIdxPos).ColumnCount = 1
        ReDim pkDesc.Indexes(pkIdxPos).ColumnNames(0 To 0)
        pkDesc.Indexes(pkIdxPos).ColumnNames(0) = pkColName

        If fkDesc.Indexes(fkIdxPos).IndexType <> 2 Or fkDesc.Indexes(fkIdxPos).RelTblType <> 2 Or fkDesc.Indexes(fkIdxPos).RelIdxNum <> CLng(pkIdxPos) Or fkDesc.Indexes(fkIdxPos).RelTblPage <> pkDesc.TdefPageNumber Then
            fkNeedWrite = True
        End If
        fkDesc.Indexes(fkIdxPos).Name = relName
        fkDesc.Indexes(fkIdxPos).IndexNumber = fkIdxPos
        fkDesc.Indexes(fkIdxPos).IsPrimary = False
        fkDesc.Indexes(fkIdxPos).IsUnique = ((rel.Attributes And 1&) <> 0)
        fkDesc.Indexes(fkIdxPos).IndexType = 2
        fkDesc.Indexes(fkIdxPos).RelTblType = 2
        fkDesc.Indexes(fkIdxPos).RelIdxNum = CLng(pkIdxPos)
        fkDesc.Indexes(fkIdxPos).RelTblPage = pkDesc.TdefPageNumber
        fkDesc.Indexes(fkIdxPos).CascadeUpdates = cascUpd
        fkDesc.Indexes(fkIdxPos).CascadeDeletes = cascDel
        fkDesc.Indexes(fkIdxPos).RealIdxFlags = IIf((rel.Attributes And 1&) <> 0, &H83&, &H82&)
        fkDesc.Indexes(fkIdxPos).ColumnCount = 1
        ReDim fkDesc.Indexes(fkIdxPos).ColumnNames(0 To 0)
        fkDesc.Indexes(fkIdxPos).ColumnNames(0) = fkColName

        If pkNeedWrite Then
            RecordWriter.WriteTableTdefPage m_fileNum, m_totalPages, pkDesc
            pkTd.UpdateDescriptor pkDesc
        End If
        If fkNeedWrite Then
            RecordWriter.WriteTableTdefPage m_fileNum, m_totalPages, fkDesc
            fkTd.UpdateDescriptor fkDesc
        End If
        Err.Clear
        On Error GoTo 0
    End Sub

    Friend Sub RemoveForeignKeyIndexFromTdefs(ByVal relName As String)
        On Error Resume Next
        Dim cleanRel As String
        cleanRel = Trim$(relName)
        If Len(cleanRel) = 0 Or m_fileNum <= 0 Or m_totalPages <= 0 Or m_isReadOnly Then
            On Error GoTo 0
            Exit Sub
        End If

        ' 1. Remove Type = 8 relationship object row from MSysObjects
        Dim msysTd As TableDef
        Set msysTd = Nothing
        If Not m_tableDefs Is Nothing Then Set msysTd = m_tableDefs("MSYSOBJECTS")
        If Not msysTd Is Nothing Then
            Dim rsObj As Recordset
            Set rsObj = msysTd.OpenRecordset()
            If Not rsObj Is Nothing Then
                Do Until rsObj.EOF
                    Dim rName As String
                    Dim rType As Long
                    rName = Trim$(CStr(rsObj.Fields("Name").Value & ""))
                    If IsNumeric(rsObj.Fields("Type").Value) Then rType = CLng(rsObj.Fields("Type").Value) Else rType = 0
                    If rType = 8 And StrComp(rName, cleanRel, vbTextCompare) = 0 Then
                        rsObj.Delete
                    Else
                        rsObj.MoveNext
                    End If
                Loop
                rsObj.Close
            End If
        End If

        ' 2. Remove any non-PrimaryKey logical index matching relName from user tables
        If Not m_tableDefs Is Nothing Then
            Dim tIdx As Long
            Dim td As TableDef
            Dim desc As TableDefDescriptor
            Dim idxPos As Integer
            Dim k As Integer
            For tIdx = 0 To m_tableDefs.Count - 1
                Set td = m_tableDefs.Item(tIdx)
                If Not td Is Nothing Then
                    If Left$(td.Name, 4) <> "MSys" And Left$(td.Name, 1) <> "~" Then
                        desc = td.Descriptor
                        If desc.TdefPageNumber > 0 And desc.IndexCount > 0 Then
                            idxPos = -1
                            For k = 0 To desc.IndexCount - 1
                                If StrComp(desc.Indexes(k).Name, cleanRel, vbTextCompare) = 0 And Not desc.Indexes(k).IsPrimary Then
                                    idxPos = k
                                    Exit For
                                End If
                            Next k
                            If idxPos >= 0 Then
                                For k = idxPos To desc.IndexCount - 2
                                    desc.Indexes(k) = desc.Indexes(k + 1)
                                    desc.Indexes(k).IndexNumber = k
                                Next k
                                desc.IndexCount = desc.IndexCount - 1
                                If desc.IndexCount > 0 Then
                                    ReDim Preserve desc.Indexes(0 To desc.IndexCount - 1)
                                Else
                                    Erase desc.Indexes
                                End If
                                RecordWriter.WriteTableTdefPage m_fileNum, m_totalPages, desc
                                td.UpdateDescriptor desc
                            End If
                        End If
                    End If
                End If
            Next tIdx
        End If
        Err.Clear
        On Error GoTo 0
    End Sub


















    Friend Sub DeleteRelationFromCatalog(ByVal relName As String)
        On Error Resume Next
        If Len(Trim$(relName)) = 0 Then Exit Sub
        Dim msysRelTd As TableDef
        Set msysRelTd = m_tableDefs("MSYSRELATIONSHIPS")
        If msysRelTd Is Nothing Then Exit Sub
        Dim rsRel As Recordset
        Set rsRel = msysRelTd.OpenRecordset()
        If Not rsRel Is Nothing Then
            Do Until rsRel.EOF
                If StrComp(Trim$(CStr(rsRel.Fields("szRelationship").Value & "")), Trim$(relName), vbTextCompare) = 0 Then
                    rsRel.Delete
                Else
                    rsRel.MoveNext
                End If
            Loop
            rsRel.Close
        End If
        On Error GoTo 0
    End Sub

    Public Sub EnsureTableCatalogAndACEs(Optional ByVal onlyTableId As Long = 0)
        On Error Resume Next
        If m_fileNum <= 0 Or m_totalPages <= 0 Or m_isReadOnly Then
            On Error GoTo 0
            Exit Sub
        End If
        If m_tableDefs Is Nothing Then
            On Error GoTo 0
            Exit Sub
        End If

        Dim msysTd As TableDef
        Set msysTd = m_tableDefs("MSYSOBJECTS")
        If msysTd Is Nothing Then
            On Error GoTo 0
            Exit Sub
        End If

        Dim tablesParentId As Long
        Dim foundTablesCont As Boolean
        Dim ownerBytes(0 To 1) As Byte
        Dim ownerVal As Variant
        ownerBytes(0) = &HA6&
        ownerBytes(1) = &H33&
        ownerVal = ownerBytes
        tablesParentId = &HF0000001
        foundTablesCont = False

        Dim rsObj As Recordset
        Set rsObj = msysTd.OpenRecordset()
        If rsObj Is Nothing Then
            On Error GoTo 0
            Exit Sub
        End If

        Dim rName As String
        Dim rType As Long
        Dim rId As Long
        Dim rParentId As Long
        Dim rFlags As Long

        ' Pass 1: Discover Tables container Id (&HF0000002) and default Owner SID ({0xA6, 0x33})
        If Not rsObj.EOF Then
            rsObj.MoveFirst
            Do Until rsObj.EOF
                rName = Trim$(CStr(rsObj.Fields("Name").Value & ""))
                If IsNumeric(rsObj.Fields("Type").Value) Then rType = CLng(rsObj.Fields("Type").Value) Else rType = 0
                If StrComp(rName, "Tables", vbTextCompare) = 0 And rType = 3 Then
                    If IsNumeric(rsObj.Fields("Id").Value) Then
                        If CLng(rsObj.Fields("Id").Value) <> 0 Then
                            tablesParentId = CLng(rsObj.Fields("Id").Value)
                            foundTablesCont = True
                        End If
                    End If
                    If Not IsNull(rsObj.Fields("Owner").Value) And Not IsEmpty(rsObj.Fields("Owner").Value) Then
                        ownerVal = rsObj.Fields("Owner").Value
                    End If
                ElseIf rType = 1 And Left$(rName, 4) <> "MSys" And Left$(rName, 1) <> "~" Then
                    If Not foundTablesCont And IsNumeric(rsObj.Fields("ParentId").Value) Then
                        rParentId = CLng(rsObj.Fields("ParentId").Value)
                        If rParentId <> 0 And rParentId <> 1 And rParentId <> &HF0000000 Then
                            tablesParentId = rParentId
                        End If
                    End If
                End If
                rsObj.MoveNext
            Loop
        End If

        ' Pass 2: Collect user table and query IDs and heal any MSysObjects row with wrong ParentId, missing Owner, or Hidden flag (0x08)
        Dim userTableIds As New Collection
        Dim userQueryIds As New Collection
        Dim userQueryNames As New Collection
        Dim needObjHeal As Boolean
        Dim curOwner As Variant
        If Not rsObj.EOF Or rsObj.RecordCount > 0 Then
            rsObj.MoveFirst
            Do Until rsObj.EOF
                rName = Trim$(CStr(rsObj.Fields("Name").Value & ""))
                If IsNumeric(rsObj.Fields("Type").Value) Then rType = CLng(rsObj.Fields("Type").Value) Else rType = 0
                If (rType = 1 Or rType = 5) And Left$(rName, 4) <> "MSys" And Left$(rName, 1) <> "~" And Left$(rName, 2) <> "f_" Then
                    If IsNumeric(rsObj.Fields("Id").Value) Then rId = CLng(rsObj.Fields("Id").Value) Else rId = 0
                    If rId <> 0 And (onlyTableId = 0 Or rId = onlyTableId) Then
                        userTableIds.Add rId
                        If rType = 5 Then
                            userQueryIds.Add rId
                            userQueryNames.Add rName
                        End If
                        needObjHeal = False
                        If IsNumeric(rsObj.Fields("ParentId").Value) Then rParentId = CLng(rsObj.Fields("ParentId").Value) Else rParentId = 0
                        If rParentId <> tablesParentId Then needObjHeal = True
                        curOwner = rsObj.Fields("Owner").Value
                        If IsNull(curOwner) Or IsEmpty(curOwner) Then needObjHeal = True
                        If IsNumeric(rsObj.Fields("Flags").Value) Then rFlags = CLng(rsObj.Fields("Flags").Value) Else rFlags = 0
                        If (rFlags And &H8&) <> 0 Then needObjHeal = True
                        If rType = 1 And (InStr(1, rName, "_") > 0 Or InStr(1, rName, "-") > 0) Then needObjHeal = True

                        If needObjHeal Then
                            rsObj.Edit
                            rsObj.Fields("ParentId").Value = tablesParentId
                            If IsNull(curOwner) Or IsEmpty(curOwner) Then
                                rsObj.Fields("Owner").Value = ownerVal
                            End If
                            If (rFlags And &H8&) <> 0 Then
                                rsObj.Fields("Flags").Value = (rFlags And (Not &H8&))
                            End If
                            rsObj.Update
                        End If
                    End If
                End If
                rsObj.MoveNext
            Loop
        End If
        rsObj.Close

        ' Pass 2b: Clean any corrupted NavPane entries and ensure every query has valid MSysQueries rows & B-Tree keys
        CleanCorruptedNavPaneEntries
        If userQueryIds.Count > 0 Then
            Dim msysQryTd As TableDef
            Set msysQryTd = m_tableDefs("MSYSQUERIES")
            If Not msysQryTd Is Nothing Then
                Dim qIdx As Long
                For qIdx = 1 To userQueryIds.Count
                    Dim checkQId As Long
                    Dim checkQName As String
                    checkQId = CLng(userQueryIds(qIdx))
                    checkQName = CStr(userQueryNames(qIdx))
                    Dim hasValidAttr255 As Boolean
                    Dim hasOldAttr1 As Boolean
                    hasValidAttr255 = False
                    hasOldAttr1 = False
                    Dim rsQryCheck As Recordset
                    Set rsQryCheck = msysQryTd.OpenRecordset()
                    If Not rsQryCheck Is Nothing Then
                        If Not rsQryCheck.EOF Then
                            rsQryCheck.MoveFirst
                            Do Until rsQryCheck.EOF
                                If CLng(Val(CStr(rsQryCheck.Fields("ObjectId").Value & ""))) = checkQId Then
                                    Dim chkAttr As Long
                                    chkAttr = CLng(Val(CStr(rsQryCheck.Fields("Attribute").Value & "")))
                                    If chkAttr = 1 Then
                                        hasOldAttr1 = True
                                    ElseIf chkAttr = 255 Then
                                        Dim chkOrd As Variant
                                        chkOrd = rsQryCheck.Fields("Order").Value
                                        If VarType(chkOrd) = (vbArray Or vbByte) Then
                                            Dim chkOrdBytes() As Byte
                                            chkOrdBytes = chkOrd
                                            If UBound(chkOrdBytes) - LBound(chkOrdBytes) + 1 = 4 Then
                                                If chkOrdBytes(LBound(chkOrdBytes) + 3) = 1 And IsNull(rsQryCheck.Fields("Flag").Value) Then
                                                    hasValidAttr255 = True
                                                End If
                                            End If
                                        End If
                                    End If
                                End If
                                rsQryCheck.MoveNext
                            Loop
                        End If
                        rsQryCheck.Close
                    End If
                    If Not m_queryDefs Is Nothing Then
                        Dim qdHeal As QueryDef
                        Set qdHeal = Nothing
                        Set qdHeal = m_queryDefs.Item(checkQName)
                        If Not qdHeal Is Nothing Then
                            If Not hasValidAttr255 Or hasOldAttr1 Or InStr(1, qdHeal.SQL, "SELECT * FROM ", vbTextCompare) > 0 Then
                                Dim healStmt As SqlStatement
                                healStmt = SqlParser.ParseSql(qdHeal.SQL)
                                Dim cleanHealTbl As String
                                cleanHealTbl = CleanSqlColName(healStmt.TableName)
                                If Trim$(healStmt.SelectClause) = "*" And Len(cleanHealTbl) > 0 And InStr(1, healStmt.FromClause, " JOIN ", vbTextCompare) = 0 And InStr(1, healStmt.FromClause, ",") = 0 Then
                                    Dim healTd As TableDef
                                    Set healTd = Nothing
                                    Set healTd = m_tableDefs(UCase$(cleanHealTbl))
                                    If Not healTd Is Nothing Then
                                        Dim healDesc As TableDefDescriptor
                                        healDesc = healTd.Descriptor
                                        If healDesc.ColumnCount > 0 Then
                                            Dim hCols As String
                                            Dim hIdx As Long
                                            hCols = vbNullString
                                            For hIdx = 0 To healDesc.ColumnCount - 1
                                                If Len(hCols) > 0 Then hCols = hCols & ", "
                                                hCols = hCols & "[" & cleanHealTbl & "].[" & healDesc.Columns(hIdx).Name & "]"
                                            Next hIdx
                                            qdHeal.Init Me, True
                                            qdHeal.SQL = "SELECT " & hCols & " FROM [" & cleanHealTbl & "];"
                                            qdHeal.Init Me, False
                                        End If
                                    End If
                                End If
                                Me.PersistQueryDefToCatalog qdHeal
                            End If
                        End If
                    End If
                Next qIdx
            End If
        End If

        ' Pass 3: Ensure every user table has full-access (ACM = 1048575 = dbSecFullAccess) rows in MSysACEs
        Dim msysAceTd As TableDef
        Set msysAceTd = Nothing
        Set msysAceTd = m_tableDefs("MSYSACES")
        If Not msysAceTd Is Nothing And userTableIds.Count > 0 Then
            Dim msysAceDesc As TableDefDescriptor
            msysAceDesc = msysAceTd.Descriptor
            If msysAceDesc.ColumnCount >= 4 Then
                Dim templateSids As New Collection
                Dim coveredTableIds As New Collection
                Dim rsAce As Recordset
                Set rsAce = msysAceTd.OpenRecordset()
                If Not rsAce Is Nothing Then
                    If Not rsAce.EOF Then
                        rsAce.MoveFirst
                        Do Until rsAce.EOF
                            Dim aceObjId As Long
                            Dim aceAcm As Long
                            Dim aceSid As Variant
                            If IsNumeric(rsAce.Fields("ObjectId").Value) Then aceObjId = CLng(rsAce.Fields("ObjectId").Value) Else aceObjId = 0
                            If IsNumeric(rsAce.Fields("ACM").Value) Then aceAcm = CLng(rsAce.Fields("ACM").Value) Else aceAcm = 0
                            aceSid = rsAce.Fields("SID").Value
                            If aceObjId = tablesParentId And Not IsNull(aceSid) And Not IsEmpty(aceSid) Then
                                templateSids.Add aceSid
                            End If
                            If (aceAcm And 4&) <> 0 Then
                                Err.Clear
                                coveredTableIds.Add True, "T_" & CStr(aceObjId)
                                Err.Clear
                            End If
                            rsAce.MoveNext
                        Loop
                    End If
                    rsAce.Close
                End If

                If templateSids.Count = 0 Then
                    templateSids.Add ownerVal
                End If

                Dim tblIdVar As Variant
                Dim targetTblId As Long
                Dim hasAce As Boolean
                Dim sidVar As Variant
                Dim aceVals() As Variant
                Dim acIdx As Long
                Dim aceOutPg As Long
                Dim aceOutSl As Integer

                For Each tblIdVar In userTableIds
                    targetTblId = CLng(tblIdVar)
                    hasAce = False
                    Err.Clear
                    hasAce = CBool(coveredTableIds("T_" & CStr(targetTblId)))
                    If Err.Number <> 0 Then
                        hasAce = False
                        Err.Clear
                    End If
                    If Not hasAce Then
                        For Each sidVar In templateSids
                            ReDim aceVals(0 To msysAceDesc.ColumnCount - 1)
                            For acIdx = 0 To msysAceDesc.ColumnCount - 1
                                Select Case UCase$(msysAceDesc.Columns(acIdx).Name)
                                    Case "ACM": aceVals(acIdx) = 1048575& ' dbSecFullAccess (&HFFFFF)
                                    Case "FINHERITABLE": aceVals(acIdx) = False
                                    Case "OBJECTID": aceVals(acIdx) = targetTblId
                                    Case "SID": aceVals(acIdx) = sidVar
                                    Case Else: aceVals(acIdx) = Null
                                End Select
                            Next acIdx
                            RecordWriter.InsertRecord m_fileNum, m_totalPages, msysAceDesc, aceVals, aceOutPg, aceOutSl
                        Next sidVar
                    End If
                Next tblIdVar
                msysAceTd.UpdateDescriptor msysAceDesc
            End If
        End If

        ' Pass 4: Clear Hidden Flag (Flags = 8) in MSysNavPaneGroupToObjects if MS Access Compact marked the table hidden
        Dim msysNavTd As TableDef
        Set msysNavTd = Nothing
        Set msysNavTd = m_tableDefs("MSYSNAVPANEGROUPTOOBJECTS")
        If Not msysNavTd Is Nothing And userTableIds.Count > 0 Then
            Dim rsNav As Recordset
            Set rsNav = msysNavTd.OpenRecordset()
            If Not rsNav Is Nothing Then
                If Not rsNav.EOF Then
                    rsNav.MoveFirst
                    Do Until rsNav.EOF
                        Dim navObjId As Long
                        Dim navFlags As Long
                        If IsNumeric(rsNav.Fields("ObjectID").Value) Then navObjId = CLng(rsNav.Fields("ObjectID").Value) Else navObjId = 0
                        If IsNumeric(rsNav.Fields("Flags").Value) Then navFlags = CLng(rsNav.Fields("Flags").Value) Else navFlags = 0
                        If navObjId > 0 And (navFlags And 8&) <> 0 Then
                            Dim isUserTbl As Boolean
                            Dim uVar As Variant
                            isUserTbl = False
                            For Each uVar In userTableIds
                                If CLng(uVar) = navObjId Then
                                    isUserTbl = True
                                    Exit For
                                End If
                            Next uVar
                            If isUserTbl Then
                                rsNav.Edit
                                rsNav.Fields("Flags").Value = (navFlags And (Not 8&))
                                rsNav.Update
                            End If
                        End If
                        rsNav.MoveNext
                    Loop
                End If
                rsNav.Close
            End If
        End If

        Err.Clear
        On Error GoTo 0
    End Sub

    Friend Sub DeleteLinkedTableDefFromCatalog(ByVal tblName As String)
        Dim rsCatalog As Recordset
        On Error Resume Next
        Set rsCatalog = Me.OpenRecordset("MSysObjects")
        If Not rsCatalog Is Nothing Then
            Do Until rsCatalog.EOF
                If StrComp(CStr(rsCatalog.Fields("Name").Value), tblName, vbTextCompare) = 0 Then
                    Dim oType As Variant
                    oType = rsCatalog.Fields("Type").Value
                    If Not IsNull(oType) Then
                        If CLng(oType) = 6 Or CLng(oType) = 4 Then
                            rsCatalog.Delete
                            Exit Do
                        End If
                    End If
                End If
                rsCatalog.MoveNext
            Loop
            rsCatalog.Close
        End If
        On Error GoTo 0
    End Sub

    Public Sub [Close]()
        Dim bDbVal As Variant
        Dim bDb As Database

        If m_isOpen Then
            If PageWriter.IsInTransaction(m_fileNum) Then
                On Error Resume Next
                Me.Rollback
                On Error GoTo 0
            End If
            m_isOpen = False
            CatalogReader.InvalidatePageDirectory
            If m_fileNum <> 0 Then
                PageWriter.RegisterDatabaseHandle 0, ""
                On Error Resume Next
                Close #m_fileNum
                m_fileNum = 0
            End If
            For Each bDbVal In m_backendDbs
                On Error Resume Next
                Set bDb = bDbVal
                If Not bDb Is Nothing Then bDb.[Close]
                On Error GoTo 0
            Next bDbVal
            Set m_backendDbs = New Collection
        End If
    End Sub

    Private Sub EnsureOpen(ByVal memberName As String)
        If Not m_isOpen Then
            Err.Raise vbObjectError + 3420, "Database." & memberName, "Object invalid or no longer set."
        End If
    End Sub

    Private Sub Class_Terminate()
        Me.[Close]
    End Sub
End Class
[ClassId("3248576c-9b8f-45b9-8687-c7162230b789")]
[InterfaceId("ffca6ca9-63d3-4b6f-8999-409c4cb509fe")]
[COMCreatable(False)]

Public Class TableDefs
    Private m_schemaOnly As Boolean
    Private m_items As New Collection
    Private m_db As Database

Friend Sub Init(ByVal parentDb As Database, ByVal fileNum As Integer, ByVal totalPages As Long)
        Set m_db = parentDb
        Dim sysTdef As TableDefDescriptor
        On Error Resume Next
        Dim parseErr As String
        parseErr = ""
        sysTdef = CatalogReader.ParseTableDef(fileNum, totalPages, 2, "MSysObjects")
        If Err.Number <> 0 Then parseErr = Err.Description
        On Error GoTo 0
        If sysTdef.ColumnCount > 0 Then
            Dim sysTableDef As New TableDef
            sysTableDef.Init m_db, sysTdef
            Dim sysTdefName As String
            sysTdefName = UCase$(sysTdef.TableName)
            m_items.Add sysTableDef, sysTdefName
        End If
        Dim msysPages As Collection
        Set msysPages = CatalogReader.FindAllDataPages(fileNum, totalPages, 2)
        If msysPages.Count = 0 And sysTdef.PrimaryDataPage > 0 And sysTdef.PrimaryDataPage < totalPages Then
            Dim msysPrimPage As Long
            msysPrimPage = sysTdef.PrimaryDataPage
            msysPages.Add msysPrimPage
        End If
        Dim queryIds As New Collection
        Dim queryNames As New Collection
        Dim pVal As Variant
        For Each pVal In msysPages
            Dim pNum As Long
            pNum = CLng(pVal)
            Dim dp() As Byte
            dp = CatalogReader.ReadPageBytes(fileNum, totalPages, pNum)
            If dp(0) = &H1& Then
                Dim numRows As Long
                numRows = CLng(FormatProbe.ReadUInt16LE(dp, 12))
                Dim r As Long
                For r = 0 To numRows - 1
                    On Error Resume Next
                    Dim raw As Long
                    raw = CLng(FormatProbe.ReadUInt16LE(dp, 14 + (r * 2)))
                    Dim topFlags As Long
                    topFlags = raw And (&H8000& Or &H4000&)
                    Dim rStart As Long
                    Dim rEnd As Long
                    rStart = raw And &H1FFF&
                    rEnd = 4096&
                    Dim slotScan As Long
                    Dim slotOff As Long
                    For slotScan = 0 To numRows - 1
                        If slotScan <> r Then
                            slotOff = CLng(FormatProbe.ReadUInt16LE(dp, 14 + (slotScan * 2))) And &H1FFF&
                            If slotOff > rStart And slotOff < rEnd Then
                                rEnd = slotOff
                            End If
                        End If
                    Next slotScan
                    Dim rowPageBuf() As Byte
                    Dim hasValidRow As Boolean
                    hasValidRow = False
                    If topFlags = 0 Then
                        rowPageBuf = dp
                        hasValidRow = True
                    ElseIf topFlags = &H4000& And (rEnd - rStart) >= 4 And rStart > 0 And rEnd <= 4096& Then
                        ' Follow Jet 4 / ACE 0x4000 overflow pointer to relocated catalog row
                        Dim tSlot As Long
                        Dim tPage As Long
                        tSlot = CLng(dp(rStart))
                        tPage = CLng(dp(rStart + 1)) Or (CLng(dp(rStart + 2)) * &H100&) Or (CLng(dp(rStart + 3)) * &H10000&)
                        If tPage > 0 And tPage < totalPages Then
                            rowPageBuf = CatalogReader.ReadPageBytes(fileNum, totalPages, tPage)
                            If rowPageBuf(0) = &H1& Then
                                Dim tNumRows As Long
                                tNumRows = CLng(FormatProbe.ReadUInt16LE(rowPageBuf, 12))
                                If tSlot >= 0 And tSlot < tNumRows Then
                                    Dim tRaw As Long
                                    tRaw = CLng(FormatProbe.ReadUInt16LE(rowPageBuf, 14 + (tSlot * 2)))
                                    rStart = tRaw And &H1FFF&
                                    If tSlot = 0 Then
                                        rEnd = 4096&
                                    Else
                                        rEnd = CLng(FormatProbe.ReadUInt16LE(rowPageBuf, 14 + ((tSlot - 1) * 2))) And &H1FFF&
                                    End If
                                    hasValidRow = True
                                End If
                            End If
                        End If
                    End If
                    If hasValidRow Then
                        Dim rLen As Long
                        rLen = rEnd - rStart
                        If rLen >= 36 And rStart < 4096& And rEnd <= 4096& Then
                            Dim nCols As Long
                            nCols = CLng(FormatProbe.ReadUInt16LE(rowPageBuf, rStart))
                            If nCols >= 17 Then
                                Dim objId As Long
                                Dim objType As Long
                                objId = FormatProbe.ReadInt32LE(rowPageBuf, rStart + 2)
                                objType = CLng(FormatProbe.ReadUInt16LE(rowPageBuf, rStart + 10))
                                If (objType And &H8000&) <> 0 Then objType = objType - 65536&
                                Dim nullMaskLen As Long
                                nullMaskLen = (nCols + 7) \ 8
                                Dim varLenPos As Long
                                varLenPos = rEnd - nullMaskLen - 2
                                If varLenPos >= 2 Then
                                    Dim varLen As Long
                                    varLen = CLng(FormatProbe.ReadUInt16LE(rowPageBuf, varLenPos))
                                    Dim eodPos As Long
                                    eodPos = varLenPos - (varLen * 2) - 2
                                    If eodPos >= 0 Then
                                        Dim eod As Long
                                        eod = CLng(FormatProbe.ReadUInt16LE(rowPageBuf, eodPos))
                                        Dim soff As Long
                                        soff = CLng(FormatProbe.ReadUInt16LE(rowPageBuf, varLenPos - 2))
                                        Dim eoff As Long
                                        If varLen > 1 Then
                                            eoff = CLng(FormatProbe.ReadUInt16LE(rowPageBuf, varLenPos - 4))
                                        Else
                                            eoff = eod
                                        End If
                                        Dim objName As String
                                        objName = vbNullString
                                        If eoff > soff And (rStart + eoff) <= rEnd Then
                                            Dim nBytes() As Byte
                                            ReDim nBytes(0 To (eoff - soff) - 1)
                                            Dim nb As Long
                                            For nb = 0 To (eoff - soff) - 1
                                                nBytes(nb) = rowPageBuf(rStart + soff + nb)
                                            Next nb
                                            objName = RowDecoder.DecodeJet4Text(nBytes)
                                        End If
                                        If Len(objName) > 0 Then
                                            Dim isSystemStorage As Boolean
                                            isSystemStorage = (UCase$(objName) = "MSYSACCESSSTORAGE" Or UCase$(objName) = "MSYSQUERIES" Or UCase$(objName) = "MSYSRELATIONSHIPS" Or UCase$(objName) = "MSYSACES" Or UCase$(objName) = "MSYSNAVPANEOBJECTIDS" Or UCase$(objName) = "MSYSNAVPANEGROUPTOOBJECTS" Or UCase$(objName) = "MSYSNAVPANEGROUPS")
                                            If (objType = 1) And ((Left$(objName, 4) <> "MSys" And Left$(objName, 2) <> "f_" And Left$(objName, 1) <> "~") Or isSystemStorage) Then
                                                If objId > 0 And objId < totalPages Then
                                                    Dim userTdef As TableDefDescriptor
                                                    userTdef = CatalogReader.ParseTableDef(fileNum, totalPages, objId, objName)
                                                    If userTdef.ColumnCount > 0 Then
                                                        Dim userTableDef As TableDef
                                                        Set userTableDef = New TableDef
                                                        userTableDef.Init m_db, userTdef
                                                        m_items.Add userTableDef, UCase$(objName)
                                                    End If
                                                End If
                                            ElseIf objType = 6 Or objType = 4 Then
                                                If Left$(objName, 1) <> "~" And Left$(objName, 4) <> "MSys" Then
                                                    Dim connStr As String, srcTbl As String, dbStr As String
                                                    connStr = vbNullString
                                                    srcTbl = vbNullString
                                                    dbStr = vbNullString
                                                    If varLen > 2 Then
                                                        dbStr = ExtractVarString(rowPageBuf, rStart, rEnd, varLenPos, varLen, eod, 2)
                                                    End If
                                                    If varLen > 3 Then
                                                        connStr = ExtractVarString(rowPageBuf, rStart, rEnd, varLenPos, varLen, eod, 3)
                                                    End If
                                                    If varLen > 4 Then
                                                        srcTbl = ExtractVarString(rowPageBuf, rStart, rEnd, varLenPos, varLen, eod, 4)
                                                    End If
                                                    If Len(connStr) = 0 And Len(dbStr) > 0 Then
                                                        connStr = ";DATABASE=" & dbStr
                                                    End If
                                                    If Len(srcTbl) = 0 Then srcTbl = objName
                                                    Dim linkedTableDef As TableDef
                                                    Set linkedTableDef = New TableDef
                                                    Dim linkedDesc As TableDefDescriptor
                                                    linkedDesc.TableName = objName
                                                    linkedDesc.TdefPageNumber = 0
                                                    linkedTableDef.Init m_db, linkedDesc
                                                    linkedTableDef.Connect = connStr
                                                    linkedTableDef.SourceTableName = srcTbl
                                                    On Error Resume Next
                                                    m_items.Remove UCase$(objName)
                                                    m_items.Add linkedTableDef, UCase$(objName)
                                                    On Error GoTo 0
                                                End If
                                            ElseIf objType = 5 And Not m_schemaOnly Then
                                                If Left$(objName, 4) <> "MSys" And (Left$(objName, 1) <> "~" Or Left$(LCase$(objName), 4) = "~sq_") Then
                                                    queryIds.Add objId
                                                    queryNames.Add objName
                                                End If
                                            ElseIf objType = -32768& And Not m_schemaOnly Then
                                                If Left$(objName, 1) <> "~" And Left$(objName, 4) <> "MSys" Then
                                                    Dim docForm As Document: Set docForm = New Document
                                                    docForm.Name = objName
                                                    m_db.Containers("Forms").Documents.AddDocument docForm
                                                End If
                                            ElseIf objType = -32764& And Not m_schemaOnly Then
                                                If Left$(objName, 1) <> "~" And Left$(objName, 4) <> "MSys" Then
                                                    Dim docRpt As Document: Set docRpt = New Document
                                                    docRpt.Name = objName
                                                    m_db.Containers("Reports").Documents.AddDocument docRpt
                                                End If
                                            ElseIf objType = -32761& And Not m_schemaOnly Then
                                                If Left$(objName, 1) <> "~" And Left$(objName, 4) <> "MSys" Then
                                                    Dim docMod As Document: Set docMod = New Document
                                                    docMod.Name = objName
                                                    m_db.Containers("Modules").Documents.AddDocument docMod
                                                End If
                                            ElseIf objType = -32766& And Not m_schemaOnly Then
                                                If Left$(objName, 1) <> "~" And Left$(objName, 4) <> "MSys" Then
                                                    Dim docMac As Document: Set docMac = New Document
                                                    docMac.Name = objName
                                                    m_db.Containers("Scripts").Documents.AddDocument docMac
                                                End If
                                            End If
                                        End If
                                    End If
                                End If
                            End If
                        End If
                    End If
                    On Error GoTo 0
                Next r
            End If
        Next pVal
        ' Reconstruct real SQL queries from MSysQueries
        If queryNames.Count > 0 Then
            ReconstructQueriesFromMSysQueries queryIds, queryNames
        End If
        If Not m_schemaOnly Then
            LoadRelationsFromMSysRelationships
        End If
    End Sub

    Private Function ExtractVarString(ByRef rowBuf() As Byte, ByVal rStart As Long, ByVal rEnd As Long, ByVal varLenPos As Long, ByVal varLen As Long, ByVal eod As Long, ByVal vIdx As Long) As String
        If vIdx < 0 Or vIdx >= varLen Then Exit Function
        Dim sOff As Long, eOff As Long
        sOff = CLng(FormatProbe.ReadUInt16LE(rowBuf, varLenPos - 2 - (vIdx * 2)))
        If (vIdx + 1) < varLen Then
            eOff = CLng(FormatProbe.ReadUInt16LE(rowBuf, varLenPos - 2 - ((vIdx + 1) * 2)))
        Else
            eOff = eod
        End If
        If eOff > sOff And (rStart + eOff) <= rEnd Then
            Dim b() As Byte
            ReDim b(0 To (eOff - sOff) - 1)
            Dim i As Long
            For i = 0 To (eOff - sOff) - 1
                b(i) = rowBuf(rStart + sOff + i)
            Next i
            Dim fNum As Integer, tPages As Long
            If Not m_db Is Nothing Then
                fNum = m_db.FileNumber
                tPages = m_db.TotalPages
            End If
            If UBound(b) + 1 >= 12 And (b(3) = &H80& Or b(3) = &H40&) Then
                ExtractVarString = RowDecoder.DecodeJet4Memo(fNum, tPages, b)
            Else
                ExtractVarString = RowDecoder.DecodeJet4Text(b)
            End If
        End If
    End Function

    Private Sub ReconstructQueriesFromMSysQueries(ByVal queryIds As Collection, ByVal queryNames As Collection)
        Dim msysQryTd As TableDef
        On Error Resume Next
        Set msysQryTd = m_items("MSYSQUERIES")
        On Error GoTo 0
        ' Single-pass index of MSysQueries rows grouped by ObjectId (eliminates N full-table scans)
        Dim groupedQueries As New Collection
        If Not msysQryTd Is Nothing Then
            On Error Resume Next
            Dim rs As Recordset
            Set rs = msysQryTd.OpenRecordset()
            If Err.Number = 0 And Not rs Is Nothing Then
                If Not rs.EOF Then
                    rs.MoveFirst
                    Do Until rs.EOF
                        Dim rowObjId As Long
                        Dim attr As Long
                        Dim flagVal As Long
                        Dim expr As String
                        Dim name1 As String
                        Dim name2 As String
                        rowObjId = CLng(Val(CStr(rs.Fields("ObjectId").Value & "")))
                        attr = CLng(Val(CStr(rs.Fields("Attribute").Value & "")))
                        flagVal = CLng(Val(CStr(rs.Fields("Flag").Value & "")))
                        expr = Trim$(CStr(rs.Fields("Expression").Value & ""))
                        name1 = Trim$(CStr(rs.Fields("Name1").Value & ""))
                        name2 = Trim$(CStr(rs.Fields("Name2").Value & ""))
                        Dim qKey As String
                        qKey = "Q_" & CStr(rowObjId)
                        Dim qBucket As Collection
                        Set qBucket = Nothing
                        Set qBucket = groupedQueries(qKey)
                        If qBucket Is Nothing Then
                            Set qBucket = New Collection
                            groupedQueries.Add qBucket, qKey
                        End If
                        Dim qRow(0 To 4) As Variant
                        qRow(0) = attr
                        qRow(1) = flagVal
                        qRow(2) = expr
                        qRow(3) = name1
                        qRow(4) = name2
                        qBucket.Add qRow
                        rs.MoveNext
                    Loop
                End If
                rs.Close
            End If
            On Error GoTo 0
        End If
        Dim qIdx As Long
        For qIdx = 1 To queryNames.Count
            Dim qName As String
            Dim qId As Long
            qName = CStr(queryNames(qIdx))
            qId = CLng(queryIds(qIdx))
            Dim qd As QueryDef: Set qd = New QueryDef
            qd.Init m_db, True
            qd.Name = qName
            Dim sqlBuilt As String
            sqlBuilt = vbNullString
            Dim targetBucket As Collection
            Set targetBucket = Nothing
            On Error Resume Next
            Set targetBucket = groupedQueries("Q_" & CStr(qId))
            On Error GoTo 0
            If Not targetBucket Is Nothing Then
                sqlBuilt = BuildSqlFromQueryBucket(targetBucket)
            End If
            qd.SQL = sqlBuilt
            qd.Init m_db, False
            m_db.QueryDefs.AddQueryDef qd
        Next qIdx
    End Sub

    Private Function BuildSqlFromQueryBucket(ByVal qBucket As Collection) As String
        On Error Resume Next
        If qBucket Is Nothing Or qBucket.Count = 0 Then Exit Function
        Dim fromTbl As String
        Dim joinClause As String
        Dim selectCols As String
        Dim whereExpr As String
        Dim groupExpr As String
        Dim havingExpr As String
        Dim orderExpr As String
        Dim rawSqlExpr As String
        Dim tableCount As Long
        tableCount = 0
        Dim itemVal As Variant
        For Each itemVal In qBucket
            Dim attr As Long
            Dim flagVal As Long
            Dim expr As String
            Dim name1 As String
            Dim name2 As String
            attr = CLng(itemVal(0))
            flagVal = CLng(itemVal(1))
            expr = CStr(itemVal(2))
            name1 = CStr(itemVal(3))
            name2 = CStr(itemVal(4))
            Select Case attr
                Case 5 ' Source table/query
                    If Len(name1) > 0 Then
                        tableCount = tableCount + 1
                        If Len(fromTbl) > 0 Then fromTbl = fromTbl & ", "
                        If Len(name2) > 0 And UCase$(name2) <> UCase$(name1) Then
                            fromTbl = fromTbl & "[" & name1 & "] AS [" & name2 & "]"
                        Else
                            fromTbl = fromTbl & "[" & name1 & "]"
                        End If
                    ElseIf Len(expr) > 0 Then
                        tableCount = tableCount + 1
                        fromTbl = expr
                    End If
                Case 6 ' Selected column / expression
                    If Len(expr) > 0 Then
                        If Len(selectCols) > 0 Then selectCols = selectCols & ", "
                        If Len(name1) > 0 Then
                            selectCols = selectCols & expr & " AS [" & name1 & "]"
                        Else
                            selectCols = selectCols & expr
                        End If
                    End If
                Case 7 ' JOIN clause (collect all edges for multi-table join tree)
                    If Len(name1) > 0 And Len(name2) > 0 And Len(expr) > 0 Then
                        If Len(joinClause) = 0 Then
                            joinClause = name1 & Chr$(30) & name2 & Chr$(30) & CStr(flagVal) & Chr$(30) & expr
                        Else
                            joinClause = joinClause & Chr$(29) & name1 & Chr$(30) & name2 & Chr$(30) & CStr(flagVal) & Chr$(30) & expr
                        End If
                    End If
                Case 8 ' WHERE clause
                    If Len(expr) > 0 Then whereExpr = expr
                Case 9 ' GROUP BY clause
                    If Len(expr) > 0 Then
                        If Len(groupExpr) > 0 Then groupExpr = groupExpr & ", "
                        groupExpr = groupExpr & expr
                    End If
                Case 10 ' HAVING clause
                    If Len(expr) > 0 Then
                        If Len(havingExpr) > 0 Then
                            havingExpr = "(" & havingExpr & ") AND (" & expr & ")"
                        Else
                            havingExpr = expr
                        End If
                    End If
                Case 11 ' ORDER BY
                    If Len(expr) > 0 Then
                        If Len(orderExpr) > 0 Then orderExpr = orderExpr & ", "
                        If UCase$(name1) = "D" Then
                            orderExpr = orderExpr & expr & " DESC"
                        Else
                            orderExpr = orderExpr & expr
                        End If
                    End If
                Case 0, 1 ' Raw SQL fallback / Pass-through
                    If Len(rawSqlExpr) = 0 And Len(expr) > 0 Then
                        rawSqlExpr = expr
                    End If
            End Select
        Next itemVal
        If Len(joinClause) > 0 Then
            Dim jEdges() As String
            jEdges = Split(joinClause, Chr$(29))
            Dim jEdgeCount As Long
            jEdgeCount = UBound(jEdges) + 1
            Dim jL() As String, jR() As String, jF() As Long, jE() As String, jU() As Boolean
            ReDim jL(0 To jEdgeCount - 1)
            ReDim jR(0 To jEdgeCount - 1)
            ReDim jF(0 To jEdgeCount - 1)
            ReDim jE(0 To jEdgeCount - 1)
            ReDim jU(0 To jEdgeCount - 1)
            Dim ei As Long
            For ei = 0 To jEdgeCount - 1
                Dim eParts() As String
                eParts = Split(jEdges(ei), Chr$(30))
                If UBound(eParts) >= 3 Then
                    jL(ei) = eParts(0)
                    jR(ei) = eParts(1)
                    jF(ei) = CLng(Val(eParts(2)))
                    jE(ei) = eParts(3)
                End If
                jU(ei) = False
            Next ei
            Dim joinedSet As New Collection
            Dim builtJoin As String
            If jF(0) = 3 Then
                builtJoin = "[" & jR(0) & "] LEFT JOIN [" & jL(0) & "] ON " & jE(0)
            ElseIf jF(0) = 2 Then
                builtJoin = "[" & jL(0) & "] LEFT JOIN [" & jR(0) & "] ON " & jE(0)
            Else
                builtJoin = "[" & jL(0) & "] INNER JOIN [" & jR(0) & "] ON " & jE(0)
            End If
            joinedSet.Add True, UCase$(jL(0))
            joinedSet.Add True, UCase$(jR(0))
            jU(0) = True
            Dim passIdx As Long
            For passIdx = 1 To jEdgeCount
                Dim madeProgress As Boolean
                madeProgress = False
                For ei = 1 To jEdgeCount - 1
                    If Not jU(ei) Then
                        Dim inL As Boolean, inR As Boolean
                        inL = False: inR = False
                        Err.Clear
                        inL = CBool(joinedSet(UCase$(jL(ei))))
                        If Err.Number <> 0 Then inL = False: Err.Clear
                        inR = CBool(joinedSet(UCase$(jR(ei))))
                        If Err.Number <> 0 Then inR = False: Err.Clear
                        If inL And Not inR Then
                            Dim kwLR As String
                            If jF(ei) = 2 Then
                                kwLR = "LEFT JOIN"
                            ElseIf jF(ei) = 3 Then
                                kwLR = "RIGHT JOIN"
                            Else
                                kwLR = "INNER JOIN"
                            End If
                            builtJoin = "(" & builtJoin & ") " & kwLR & " [" & jR(ei) & "] ON " & jE(ei)
                            joinedSet.Add True, UCase$(jR(ei))
                            jU(ei) = True
                            madeProgress = True
                        ElseIf inR And Not inL Then
                            Dim kwRL As String
                            If jF(ei) = 2 Then
                                kwRL = "RIGHT JOIN"
                            ElseIf jF(ei) = 3 Then
                                kwRL = "LEFT JOIN"
                            Else
                                kwRL = "INNER JOIN"
                            End If
                            builtJoin = "(" & builtJoin & ") " & kwRL & " [" & jL(ei) & "] ON " & jE(ei)
                            joinedSet.Add True, UCase$(jL(ei))
                            jU(ei) = True
                            madeProgress = True
                        ElseIf inL And inR Then
                            If Len(whereExpr) > 0 Then
                                whereExpr = "(" & whereExpr & ") AND (" & jE(ei) & ")"
                            Else
                                whereExpr = jE(ei)
                            End If
                            jU(ei) = True
                            madeProgress = True
                        End If
                    End If
                Next ei
                If Not madeProgress Then Exit For
            Next passIdx
            fromTbl = builtJoin
        End If
        If Len(fromTbl) > 0 Then
            If Len(selectCols) = 0 Then selectCols = "*"
            Dim fullSql As String
            fullSql = "SELECT " & selectCols & " FROM " & fromTbl
            If Len(whereExpr) > 0 Then fullSql = fullSql & " WHERE " & whereExpr
            If Len(groupExpr) > 0 Then fullSql = fullSql & " GROUP BY " & groupExpr
            If Len(havingExpr) > 0 Then fullSql = fullSql & " HAVING " & havingExpr
            If Len(orderExpr) > 0 Then fullSql = fullSql & " ORDER BY " & orderExpr
            BuildSqlFromQueryBucket = fullSql & ";"
        ElseIf Len(rawSqlExpr) > 0 Then
            If Right$(rawSqlExpr, 1) <> ";" Then rawSqlExpr = rawSqlExpr & ";"
            BuildSqlFromQueryBucket = rawSqlExpr
        End If
        On Error GoTo 0
    End Function

    Public Property Get Count() As Long
        Count = m_items.Count
    End Property
    [DefaultMember]

    Public Property Get Item(ByVal IndexOrName As Variant) As TableDef
        If VarType(IndexOrName) = vbString Then
            Dim key As String
            key = UCase$(CStr(IndexOrName))
            On Error Resume Next
            Dim td As TableDef
            Set td = m_items(key)
            On Error GoTo 0
            If td Is Nothing Then
                Err.Raise vbObjectError + 3265, "TableDefs.Item", "Item not found in this collection."
            End If
            Set Item = td
        Else
            Dim idx As Long
            idx = CLng(IndexOrName)
            If idx < 0 Or idx >= m_items.Count Then
                Err.Raise vbObjectError + 3265, "TableDefs.Item", "Item not found in this collection."
            End If
            Set Item = m_items(idx + 1)
        End If
    End Property

    Public Sub Append(ByVal td As TableDef)
        If Not m_db Is Nothing Then
            If Len(Trim$(td.Connect)) > 0 Then
                m_db.PersistNewLinkedTableDef td.Name, td.Connect, td.SourceTableName
                td.RefreshLink
            Else
                Dim desc As TableDefDescriptor
                desc = td.Descriptor
                If desc.TdefPageNumber <= 0 And desc.ColumnCount > 0 Then
                    m_db.PersistNewTableDef desc
                    td.UpdateDescriptor desc
                End If
            End If
        End If
        On Error Resume Next
        m_items.Remove UCase$(td.Name)
        m_items.Add td, UCase$(td.Name)
        On Error GoTo 0
    End Sub

    Public Sub Delete(ByVal tableName As String)
        Dim uName As String
        Dim td As TableDef
        Dim relIdx As Long
        Dim relObj As Relation

        uName = UCase$(Trim$(tableName))
        On Error Resume Next
        Set td = m_items(uName)
        On Error GoTo 0
        If td Is Nothing Then
            Err.Raise 3265, "TableDefs.Delete", "Item not found in this collection."
        End If

        If Not m_db Is Nothing Then
            For relIdx = 0 To m_db.Relations.Count - 1
                Set relObj = m_db.Relations.Item(relIdx)
                If Not relObj Is Nothing Then
                    If StrComp(relObj.Table, td.Name, vbTextCompare) = 0 Or StrComp(relObj.ForeignTable, td.Name, vbTextCompare) = 0 Then
                        Err.Raise 3280, "TableDefs.Delete", "You can't delete the table '" & td.Name & "'; it is participating in one or more relationships. Delete its relationships in the Relationships window first before you delete the table."
                    End If
                End If
            Next relIdx

            If Len(Trim$(td.Connect)) > 0 Then
                m_db.DeleteLinkedTableDefFromCatalog td.Name
            Else
                m_db.DropLocalTableFromDisk td.Name
            End If
        End If

        On Error Resume Next
        m_items.Remove uName
        On Error GoTo 0
    End Sub

    Friend Property Let SchemaOnly(ByVal v As Boolean)
        m_schemaOnly = v
    End Property

    Friend Function HasItem(ByVal tableName As String) As Boolean
        Dim td As TableDef
        On Error Resume Next
        Set td = m_items(UCase$(tableName))
        On Error GoTo 0
        HasItem = Not td Is Nothing
    End Function

    Public Sub Refresh()
        ' Synchronizes in-memory TableDef descriptors with disk (including page renumbering after Compact & Repair)
        If m_db Is Nothing Then Exit Sub
        Dim diskDefs As TableDefs
        Set diskDefs = New TableDefs
        diskDefs.SchemaOnly = True
        diskDefs.Init m_db, m_db.FileNumber, m_db.TotalPages
        Dim i As Long
        For i = 0 To diskDefs.Count - 1
            Dim diskTd As TableDef
            Set diskTd = diskDefs.Item(i)
            If Not diskTd Is Nothing Then
                If Not Me.HasItem(diskTd.Name) Then
                    On Error Resume Next
                    m_items.Add diskTd, UCase$(diskTd.Name)
                    On Error GoTo 0
                Else
                    Dim existingTd As TableDef
                    Set existingTd = Nothing
                    On Error Resume Next
                    Set existingTd = m_items(UCase$(diskTd.Name))
                    On Error GoTo 0
                    If Not existingTd Is Nothing Then
                        existingTd.UpdateDescriptor diskTd.Descriptor
                    End If
                End If
            End If
        Next i
    End Sub

    Private Sub LoadRelationsFromMSysRelationships()
        Dim msysRelTd As TableDef
        On Error Resume Next
        Set msysRelTd = m_items("MSYSRELATIONSHIPS")
        On Error GoTo 0
        If msysRelTd Is Nothing Then Exit Sub

        On Error Resume Next
        Dim rs As Recordset
        Set rs = msysRelTd.OpenRecordset()
        If Err.Number <> 0 Or rs Is Nothing Then
            Err.Clear
            On Error GoTo 0
            Exit Sub
        End If

        If Not rs.EOF Then
            rs.MoveFirst
            Do Until rs.EOF
                Dim relName As String
                Dim fkTbl As String
                Dim fkCol As String
                Dim pkTbl As String
                Dim pkCol As String
                Dim grbitVal As Long

                relName = Trim$(CStr(rs.Fields("szRelationship").Value & ""))
                fkTbl = Trim$(CStr(rs.Fields("szObject").Value & ""))
                fkCol = Trim$(CStr(rs.Fields("szColumn").Value & ""))
                pkTbl = Trim$(CStr(rs.Fields("szReferencedObject").Value & ""))
                pkCol = Trim$(CStr(rs.Fields("szReferencedColumn").Value & ""))
                If IsNumeric(rs.Fields("grbit").Value) Then
                    grbitVal = CLng(rs.Fields("grbit").Value)
                Else
                    grbitVal = 0&
                End If
                If Len(relName) = 0 And Len(pkTbl) > 0 And Len(fkTbl) > 0 Then
                    relName = pkTbl & fkTbl
                End If

                If Len(relName) > 0 And Len(pkTbl) > 0 And Len(fkTbl) > 0 And Left$(pkTbl, 4) <> "MSys" And Left$(fkTbl, 4) <> "MSys" Then
                    Dim existingRel As Relation
                    Set existingRel = Nothing
                    Err.Clear
                    Set existingRel = m_db.Relations.Item(relName)
                    If Err.Number <> 0 Then Set existingRel = Nothing: Err.Clear

                    If existingRel Is Nothing Then
                        Dim newRel As Relation
                        Set newRel = m_db.CreateRelation(relName, pkTbl, fkTbl, grbitVal)
                        Dim relFld As Field
                        Set relFld = newRel.CreateField(pkCol)
                        relFld.ForeignName = fkCol
                        newRel.Fields.Append relFld
                        m_db.Relations.AddLoadedRelation newRel
                    ElseIf Len(pkCol) > 0 And Len(fkCol) > 0 Then
                        Dim addFld As Field
                        Set addFld = existingRel.CreateField(pkCol)
                        addFld.ForeignName = fkCol
                        existingRel.Fields.Append addFld
                    End If
                End If
                rs.MoveNext
            Loop
        End If
        rs.Close
        On Error GoTo 0
    End Sub
End Class
[ClassId("aa03cb01-e8a8-42e9-9bd5-02de62034bce")]
[InterfaceId("0ee3df49-cd1c-489a-aef1-02ad1cc2e77d")]
[COMCreatable(False)]

Public Class TableDef
    Private m_db As Database
    Private m_tdef As TableDefDescriptor
    Private m_fields As Fields
    Private m_indexes As New Indexes
    Private m_inMemoryRows As Collection
    Public Connect As String
    Public SourceTableName As String

    Friend Sub Init(ByVal parentDb As Database, ByRef tdefDesc As TableDefDescriptor)
        Dim idx As Long
        Dim c As Long
        Dim colName As String
        Dim fld As Field

        Set m_db = parentDb
        m_tdef = tdefDesc
        Set m_fields = New Fields
        m_fields.InitForTable m_tdef
        Set m_indexes = New Indexes
        m_indexes.InitForTable Me, m_tdef
        Set m_inMemoryRows = New Collection

        If m_tdef.IndexCount > 0 Then
            For idx = 0 To m_tdef.IndexCount - 1
                If m_tdef.Indexes(idx).IsPrimary Then
                    For c = 0 To m_tdef.Indexes(idx).ColumnCount - 1
                        colName = m_tdef.Indexes(idx).ColumnNames(c)
                        On Error Resume Next
                        Set fld = Nothing
                        Set fld = m_fields(colName)
                        If Not fld Is Nothing Then
                            fld.Required = True
                        End If
                        On Error GoTo 0
                    Next c
                End If
            Next idx
        End If
    End Sub

    Friend Property Get Descriptor() As TableDefDescriptor
        Descriptor = m_tdef
    End Property

    Friend Sub UpdateDescriptor(ByRef newDesc As TableDefDescriptor)
        m_tdef = newDesc
        If Not m_indexes Is Nothing Then
            m_indexes.InitForTable Me, m_tdef
        End If
    End Sub

    Friend Property Get InMemoryRows() As Collection
        Set InMemoryRows = m_inMemoryRows
    End Property

    Public Property Get Name() As String
        Name = m_tdef.TableName
    End Property

    Public Property Let Name(ByVal newName As String)
        m_tdef.TableName = newName
    End Property

    Private Sub EnsureLinkedFieldsLoaded()
        If Len(Trim$(Me.Connect)) > 0 And (m_fields Is Nothing Or m_fields.Count = 0) Then
            Dim bePath As String
            bePath = LinkedTableHelper.ExtractDatabasePathFromConnect(Me.Connect)
            If Len(bePath) > 0 And Not m_db Is Nothing Then
                Dim beDb As Database
                Set beDb = m_db.GetOrOpenBackendDatabase(bePath)
                If Not beDb Is Nothing Then
                    Dim beTbl As String
                    beTbl = IIf(Len(Me.SourceTableName) > 0, Me.SourceTableName, Me.Name)
                    On Error Resume Next
                    Dim beTd As TableDef
                    Set beTd = beDb.TableDefs(beTbl)
                    On Error GoTo 0
                    If Not beTd Is Nothing Then
                        Dim localTblName1 As String
                        localTblName1 = Me.Name
                        m_tdef = beTd.Descriptor
                        m_tdef.TableName = localTblName1
                        Dim csi1 As Long
                        For csi1 = 0 To m_tdef.ColumnCount - 1
                            m_tdef.Columns(csi1).SourceTable = localTblName1
                        Next csi1
                        Set m_fields = New Fields
                        m_fields.InitForTable m_tdef
                        Set m_indexes = New Indexes
                        m_indexes.InitForTable Me, m_tdef
                    End If
                End If
            End If
        End If
    End Sub

    Public Sub RefreshLink()
        If Len(Trim$(Me.Connect)) = 0 Then Exit Sub
        Dim bePath As String
        bePath = LinkedTableHelper.ExtractDatabasePathFromConnect(Me.Connect)
        If Len(bePath) > 0 And Not m_db Is Nothing Then
            Dim beDb As Database
            Set beDb = m_db.GetOrOpenBackendDatabase(bePath, True)
            If Not beDb Is Nothing Then
                Dim beTbl As String
                beTbl = IIf(Len(Me.SourceTableName) > 0, Me.SourceTableName, Me.Name)
                Dim beTd As TableDef
                Set beTd = beDb.TableDefs(beTbl)
                If Not beTd Is Nothing Then
                    Dim localTblName2 As String
                    localTblName2 = Me.Name
                    m_tdef = beTd.Descriptor
                    m_tdef.TableName = localTblName2
                    Dim csi As Long
                    For csi = 0 To m_tdef.ColumnCount - 1
                        m_tdef.Columns(csi).SourceTable = localTblName2
                    Next csi
                    Set m_fields = New Fields
                    m_fields.InitForTable m_tdef
                    Set m_indexes = New Indexes
                    m_indexes.InitForTable Me, m_tdef
                End If
            End If
        End If
    End Sub

    Public Property Get RecordCount() As Long
        If Len(Trim$(Me.Connect)) > 0 Then
            EnsureLinkedFieldsLoaded
            Dim rs As Recordset
            On Error Resume Next
            Set rs = Me.OpenRecordset()
            If Not rs Is Nothing Then RecordCount = rs.RecordCount
            On Error GoTo 0
        Else
            RecordCount = m_tdef.RowCount
        End If
    End Property

    Public Property Get Fields() As Fields
        EnsureLinkedFieldsLoaded
        Set Fields = m_fields
    End Property

    Public Property Get Indexes() As Indexes
        EnsureLinkedFieldsLoaded
        Set Indexes = m_indexes
    End Property

    Public Function CreateIndex(Optional ByVal Name As Variant = "") As Index
        Dim idx As New Index
        If Not IsMissing(Name) Then idx.Name = CStr(Name)
        Set CreateIndex = idx
    End Function

    Public Function CreateField(Optional ByVal Name As Variant = "", Optional ByVal Type As Variant = Empty, Optional ByVal Size As Variant = Empty) As Field
        Dim f As New Field
        Dim fName As String
        If Not IsMissing(Name) Then fName = CStr(Name)
        Dim fType As Integer
        If Not IsMissing(Type) Then fType = CInt(Type) Else fType = 10
        Dim fSize As Long
        If Not IsMissing(Size) Then fSize = CLng(Size) Else fSize = 255
        f.Init fName, fType, fSize, Nothing, m_fields.Count, False, m_tdef.TableName
        Set CreateField = f
    End Function

    Friend Function IndexSeek(ByVal colName As String, ByVal keyVal As Variant, ByRef outRows As Collection, ByRef outLocs As Collection) As Boolean
        Set outRows = New Collection
        Set outLocs = New Collection
        If m_tdef.ColumnCount <= 0 Then Exit Function
        Dim targetCol As Long
        targetCol = -1
        Dim i As Long
        For i = 0 To m_tdef.ColumnCount - 1
            If StrComp(m_tdef.Columns(i).Name, colName, vbTextCompare) = 0 Then
                targetCol = i
                Exit For
            End If
        Next i
        If targetCol < 0 Then Exit Function
        Dim allRows As Collection
        Dim allLocs As Collection
        If m_tdef.TdefPageNumber > 0 And m_tdef.TdefPageNumber < m_db.TotalPages Then
            Set allRows = RowDecoder.ReadDataPageRows(m_db.FileNumber, m_db.TotalPages, m_tdef, allLocs)
        Else
            Set allRows = m_inMemoryRows
            Set allLocs = New Collection
        End If
        Dim r As Long
        For r = 1 To allRows.Count
            Dim rowVals() As Variant
            rowVals = allRows(r)
            Dim cv As Variant
            cv = rowVals(targetCol)
            Dim isMatch As Boolean
            isMatch = False
            If Not IsNull(cv) And Not IsNull(keyVal) Then
                If VarType(cv) = vbString Or VarType(keyVal) = vbString Then
                    isMatch = (StrComp(CStr(cv), CStr(keyVal), vbTextCompare) = 0)
                Else
                    isMatch = (cv = keyVal)
                End If
            ElseIf IsNull(cv) And IsNull(keyVal) Then
                isMatch = True
            End If
            If isMatch Then
                outRows.Add rowVals
                If r <= allLocs.Count Then
                    outLocs.Add allLocs(r)
                End If
            End If
        Next r
        IndexSeek = (outRows.Count > 0)
    End Function

    Public Function OpenRecordset(Optional ByVal RecordsetType As Variant, Optional ByVal Options As Variant, Optional ByVal LockEdit As Variant) As Recordset
        If Not m_db.IsOpen Then
            Err.Raise vbObjectError + 3420, "TableDef.OpenRecordset", "Object invalid or no longer set."
        End If
        If Len(Trim$(Me.Connect)) > 0 Then
            Dim bePath As String
            bePath = LinkedTableHelper.ExtractDatabasePathFromConnect(Me.Connect)
            Dim beDb As Database
            Set beDb = m_db.GetOrOpenBackendDatabase(bePath)
            If beDb Is Nothing Then
                Err.Raise vbObjectError + 3024, "TableDef.OpenRecordset", "Could not open backend database '" & bePath & "'."
            End If
            Dim beTbl As String
            beTbl = IIf(Len(Me.SourceTableName) > 0, Me.SourceTableName, Me.Name)
            Dim beRs As Recordset
            Set beRs = beDb.OpenRecordset(beTbl, RecordsetType, Options, LockEdit)
            If Not beRs Is Nothing Then beRs.SetSourceTableName Me.Name
            Set OpenRecordset = beRs
            Exit Function
        End If
        Dim rowsColl As Collection
        Dim locsColl As Collection
        If m_tdef.TdefPageNumber > 0 And m_tdef.TdefPageNumber < m_db.TotalPages Then
            Set rowsColl = RowDecoder.ReadDataPageRows(m_db.FileNumber, m_db.TotalPages, m_tdef, locsColl)
        Else
            Set rowsColl = m_inMemoryRows
            Set locsColl = New Collection
        End If
        Dim rs As New Recordset
        rs.Init m_db, m_tdef, rowsColl, locsColl, Me
        Set OpenRecordset = rs
    End Function
End Class
[ClassId("91f8e412-6b19-4e89-9a2c-512088a1e301")]
[InterfaceId("2dc137aa-fce0-47ce-82da-27c277e6ebde")]
[COMCreatable(False)]

Public Class Recordset
    Private m_db As Database

    Friend Sub SetSourceTableName(ByVal newTableName As String)
        m_tdef.TableName = newTableName
        Dim i As Long
        For i = 0 To m_tdef.ColumnCount - 1
            m_tdef.Columns(i).SourceTable = newTableName
        Next i
        If Not m_fields Is Nothing Then
            For i = 0 To m_fields.Count - 1
                Dim f As Field
                Set f = m_fields.Item(i)
                If Not f Is Nothing Then
                    f.SourceTable = newTableName
                End If
            Next i
        End If
    End Sub
    Private m_parentTdef As TableDef
    Private m_tdef As TableDefDescriptor
    Private m_rows As Collection
    Private m_locs As Collection
    Private m_cursor As Long
    Private m_recordCount As Long
    Private m_bof As Boolean
    Private m_eof As Boolean
    Private m_isOpen As Boolean
    Private m_fields As Fields
    Private m_editMode As Long ' 0 = dbEditNone, 1 = dbEditInProgress, 2 = dbEditAdd
    Private m_editBuffer() As Variant
    Private m_currentIndex As String
    Private m_noMatch As Boolean

    Friend Sub Init(ByVal parentDb As Database, ByRef tdefDesc As TableDefDescriptor, ByVal rows As Collection, Optional ByVal locs As Collection = Nothing, Optional ByVal parentTdefObj As TableDef = Nothing)
        Dim fldI As Long

        Set m_db = parentDb
        Set m_parentTdef = parentTdefObj
        m_tdef = tdefDesc
        Set m_rows = rows
        If locs Is Nothing Then Set m_locs = New Collection Else Set m_locs = locs
        m_recordCount = m_rows.Count
        m_isOpen = True
        m_editMode = 0
        If m_recordCount = 0 Then
            m_bof = True
            m_eof = True
            m_cursor = -1
        Else
            m_cursor = 0
            m_bof = False
            m_eof = False
        End If
        Set m_fields = New Fields
        m_fields.InitForRecordset Me, m_tdef
        If Not parentTdefObj Is Nothing Then
            For fldI = 0 To m_tdef.ColumnCount - 1
                On Error Resume Next
                m_fields.Item(fldI).Required = parentTdefObj.Fields(fldI).Required
                m_fields.Item(fldI).AllowZeroLength = parentTdefObj.Fields(fldI).AllowZeroLength
                On Error GoTo 0
            Next fldI
        End If
    End Sub

    Friend Function GetCurrentRowLocation() As String
        If m_cursor >= 0 And m_cursor < m_locs.Count Then
            GetCurrentRowLocation = CStr(m_locs(m_cursor + 1))
        Else
            GetCurrentRowLocation = "0|0"
        End If
    End Function

    Friend Function GetCurrentRowValue(ByVal colIndex As Long) As Variant
        EnsureOpen "Fields.Value"
        If m_editMode <> 0 Then
            GetCurrentRowValue = m_editBuffer(colIndex)
            Exit Function
        End If
        If m_bof Or m_eof Or m_cursor < 0 Or m_cursor >= m_recordCount Then
            Err.Raise vbObjectError + 3021, "Recordset.Fields", "No current record."
        End If
        Dim rowArr() As Variant
        rowArr = m_rows(m_cursor + 1)
        GetCurrentRowValue = rowArr(colIndex)
    End Function

    Friend Sub SetCurrentRowValue(ByVal colIndex As Long, ByVal newVal As Variant)
        EnsureOpen "Fields.Value"
        If m_editMode = 0 Then
            ' Auto-enter Edit mode if not already in Edit/AddNew
            Me.Edit
        End If
        If colIndex >= 0 And colIndex < m_tdef.ColumnCount Then
            m_editBuffer(colIndex) = newVal
        End If
    End Sub

    Public Property Get Updatable() As Boolean
        If Not m_db Is Nothing Then
            Updatable = m_db.Updatable
        Else
            Updatable = True
        End If
    End Property

    Public Property Get EditMode() As Long
        EditMode = m_editMode
    End Property

    Public Sub Edit()
        Dim rowArr() As Variant
        Dim i As Long

        EnsureOpen "Edit"
        If Not m_db Is Nothing Then m_db.EnsureWritable "Edit"
        If m_bof Or m_eof Or m_cursor < 0 Or m_cursor >= m_recordCount Then
            Err.Raise vbObjectError + 3021, "Recordset.Edit", "No current record."
        End If
        rowArr = m_rows(m_cursor + 1)
        ReDim m_editBuffer(0 To m_tdef.ColumnCount - 1)
        For i = 0 To m_tdef.ColumnCount - 1
            m_editBuffer(i) = rowArr(i)
            If m_tdef.Columns(i).IsAutoNumber And (IsNull(m_editBuffer(i)) Or IsEmpty(m_editBuffer(i))) Then
                Dim candId As Long
                Dim rCheck As Long
                Dim chkArr() As Variant
                Dim idTaken As Boolean
                candId = m_cursor + 1
                Do
                    idTaken = False
                    If Not m_rows Is Nothing Then
                        For rCheck = 1 To m_rows.Count
                            If (rCheck - 1) <> m_cursor Then
                                chkArr = m_rows(rCheck)
                                If i <= UBound(chkArr) Then
                                    If IsNumeric(chkArr(i)) Then
                                        If CLng(chkArr(i)) = candId Then
                                            idTaken = True
                                            Exit For
                                        End If
                                    End If
                                End If
                            End If
                        Next rCheck
                    End If
                    If Not idTaken Then Exit Do
                    candId = candId + 1
                Loop
                m_editBuffer(i) = candId
            End If
        Next i
        m_editMode = 1
    End Sub

    Public Sub AddNew()
        Dim i As Long

        EnsureOpen "AddNew"
        If Not m_db Is Nothing Then m_db.EnsureWritable "AddNew"
        ReDim m_editBuffer(0 To m_tdef.ColumnCount - 1)
        For i = 0 To m_tdef.ColumnCount - 1
            If m_tdef.Columns(i).IsAutoNumber Then
                Dim maxExistingId As Long
                Dim rScan As Long
                Dim rowScanArr() As Variant
                maxExistingId = 0
                If Not m_rows Is Nothing Then
                    For rScan = 1 To m_rows.Count
                        rowScanArr = m_rows(rScan)
                        If i <= UBound(rowScanArr) Then
                            If IsNumeric(rowScanArr(i)) Then
                                If CLng(rowScanArr(i)) > maxExistingId Then
                                    maxExistingId = CLng(rowScanArr(i))
                                End If
                            End If
                        End If
                    Next rScan
                End If
                If m_tdef.AutoNumberNext <= maxExistingId Then
                    m_tdef.AutoNumberNext = maxExistingId + 1
                End If
                If m_tdef.AutoNumberNext <= 0 Then m_tdef.AutoNumberNext = 1
                m_editBuffer(i) = m_tdef.AutoNumberNext
            ElseIf m_tdef.Columns(i).ColType = JetColumnType.ColBoolean Then
                m_editBuffer(i) = False
            Else
                m_editBuffer(i) = Null
            End If
        Next i
        m_editMode = 2
    End Sub

    Private Sub ValidateRecordConstraints()
        Dim c As Integer
        Dim fVal As Variant
        Dim fldObj As Field
        Dim isReq As Boolean
        Dim allowZls As Boolean
        Dim sVal As String
        Dim idxObj As Object
        Dim idxIdx As Long
        Dim isPkOrUnique As Boolean
        Dim idxColsRaw As String
        Dim idxParts() As String
        Dim p As Long
        Dim colNameClean As String
        Dim keyColIndices() As Long
        Dim keyColCount As Long
        Dim k As Integer
        Dim allNullKey As Boolean
        Dim rIdx As Long
        Dim existingRow() As Variant
        Dim sameKey As Boolean
        Dim kc As Long
        Dim v1 As Variant
        Dim v2 As Variant
        Dim idxFlds As Fields
        Dim objColCount As Long

        ' 1. Check Required and AllowZeroLength per column
        For c = 0 To m_tdef.ColumnCount - 1
            fVal = m_editBuffer(c)
            Set fldObj = Nothing
            On Error Resume Next
            Set fldObj = m_fields.Item(c)
            On Error GoTo 0

            isReq = False
            allowZls = True
            If Not fldObj Is Nothing Then
                isReq = fldObj.Required
                allowZls = fldObj.AllowZeroLength
            End If

            If Not isReq And Not m_parentTdef Is Nothing Then
                On Error Resume Next
                isReq = m_parentTdef.Fields(c).Required
                If Not isReq Then isReq = m_parentTdef.Fields(m_tdef.Columns(c).Name).Required
                On Error GoTo 0
            End If
            If allowZls And Not m_parentTdef Is Nothing Then
                On Error Resume Next
                allowZls = m_parentTdef.Fields(c).AllowZeroLength
                If allowZls Then allowZls = m_parentTdef.Fields(m_tdef.Columns(c).Name).AllowZeroLength
                On Error GoTo 0
            End If

            If isReq And Not m_tdef.Columns(c).IsAutoNumber Then
                If IsNull(fVal) Or IsEmpty(fVal) Then
                    Err.Raise 3314, "Recordset.Update", "The field '" & m_tdef.TableName & "." & m_tdef.Columns(c).Name & "' cannot contain a Null value because the Required property for this field is set to True."
                End If
            End If

            If (m_tdef.Columns(c).ColType = JetColumnType.ColText Or m_tdef.Columns(c).ColType = JetColumnType.ColMemo) Then
                If Not IsNull(fVal) And Not IsEmpty(fVal) Then
                    sVal = CStr(fVal)
                    If Len(sVal) = 0 And Not allowZls Then
                        Err.Raise 3315, "Recordset.Update", "Field '" & m_tdef.TableName & "." & m_tdef.Columns(c).Name & "' cannot be a zero-length string."
                    End If
                End If
            End If
        Next c

        ' 2. Check Primary Key and Unique Indexes on parent TableDef
        If Not m_parentTdef Is Nothing Then
            For idxIdx = 0 To m_parentTdef.Indexes.Count - 1
                Set idxObj = Nothing
                On Error Resume Next
                Set idxObj = m_parentTdef.Indexes(idxIdx)
                On Error GoTo 0

                If Not idxObj Is Nothing Then
                    isPkOrUnique = False
                    idxColsRaw = vbNullString
                    On Error Resume Next
                    isPkOrUnique = (CBool(idxObj.Primary) Or CBool(idxObj.Unique))
                    idxColsRaw = CStr(idxObj.Fields)
                    On Error GoTo 0

                    If isPkOrUnique Then
                        keyColCount = 0
                        If Len(Trim$(idxColsRaw)) > 0 Then
                            idxParts = Split(Replace$(idxColsRaw, "+", ";"), ";")
                            ReDim keyColIndices(0 To UBound(idxParts))
                            For p = 0 To UBound(idxParts)
                                colNameClean = Trim$(Replace$(Replace$(idxParts(p), "[", ""), "]", ""))
                                If Len(colNameClean) > 0 Then
                                    For k = 0 To m_tdef.ColumnCount - 1
                                        If StrComp(m_tdef.Columns(k).Name, colNameClean, vbTextCompare) = 0 Then
                                            keyColIndices(keyColCount) = k
                                            keyColCount = keyColCount + 1
                                            Exit For
                                        End If
                                    Next k
                                End If
                            Next p
                        Else
                            Set idxFlds = Nothing
                            On Error Resume Next
                            Set idxFlds = idxObj.Fields
                            On Error GoTo 0
                            If Not idxFlds Is Nothing Then
                                If idxFlds.Count > 0 Then
                                    ReDim keyColIndices(0 To idxFlds.Count - 1)
                                    For p = 0 To idxFlds.Count - 1
                                        colNameClean = Trim$(Replace$(Replace$(idxFlds.Item(p).Name, "[", ""), "]", ""))
                                        If Len(colNameClean) > 0 Then
                                            For k = 0 To m_tdef.ColumnCount - 1
                                                If StrComp(m_tdef.Columns(k).Name, colNameClean, vbTextCompare) = 0 Then
                                                    keyColIndices(keyColCount) = k
                                                    keyColCount = keyColCount + 1
                                                    Exit For
                                                End If
                                            Next k
                                        End If
                                    Next p
                                End If
                            End If
                        End If

                        If keyColCount = 0 Then
                            On Error Resume Next
                            objColCount = idxObj.ColumnCount
                            If objColCount > 0 Then
                                ReDim keyColIndices(0 To objColCount - 1)
                                For p = 0 To objColCount - 1
                                    colNameClean = Trim$(Replace$(Replace$(idxObj.ColumnName(p), "[", ""), "]", ""))
                                    If Len(colNameClean) > 0 Then
                                        For k = 0 To m_tdef.ColumnCount - 1
                                            If StrComp(m_tdef.Columns(k).Name, colNameClean, vbTextCompare) = 0 Then
                                                keyColIndices(keyColCount) = k
                                                keyColCount = keyColCount + 1
                                                Exit For
                                            End If
                                        Next k
                                    End If
                                Next p
                            End If
                            On Error GoTo 0
                        End If

                        If keyColCount > 0 Then
                            allNullKey = True
                            For kc = 0 To keyColCount - 1
                                v1 = m_editBuffer(keyColIndices(kc))
                                If Not IsNull(v1) And Not IsEmpty(v1) Then
                                    allNullKey = False
                                ElseIf CBool(idxObj.Primary) Then
                                    Err.Raise 3058, "Recordset.Update", "Index or primary key cannot contain a Null value."
                                End If
                            Next kc

                            If Not allNullKey And Not m_rows Is Nothing Then
                                For rIdx = 1 To m_rows.Count
                                    ' Skip current record when editing in place (m_editMode = 1)
                                    If Not (m_editMode = 1 And (rIdx - 1) = m_cursor) Then
                                        existingRow = m_rows(rIdx)
                                        sameKey = True
                                        For kc = 0 To keyColCount - 1
                                            v1 = m_editBuffer(keyColIndices(kc))
                                            If keyColIndices(kc) <= UBound(existingRow) Then
                                                v2 = existingRow(keyColIndices(kc))
                                            Else
                                                v2 = Null
                                            End If
                                            If IsNull(v1) Or IsNull(v2) Or IsEmpty(v1) Or IsEmpty(v2) Then
                                                sameKey = False
                                                Exit For
                                            ElseIf IsNumeric(v1) And IsNumeric(v2) Then
                                                If CDbl(v1) <> CDbl(v2) Then
                                                    sameKey = False
                                                    Exit For
                                                End If
                                            Else
                                                If StrComp(CStr(v1), CStr(v2), vbTextCompare) <> 0 Then
                                                    sameKey = False
                                                    Exit For
                                                End If
                                            End If
                                        Next kc

                                        If sameKey Then
                                            Err.Raise 3022, "Recordset.Update", "The changes you requested to the table were not successful because they would create duplicate values in the index, primary key, or relationship."
                                        End If
                                    End If
                                Next rIdx
                            End If
                        End If
                    End If
                End If
            Next idxIdx
        End If

        ' 3. Check Foreign Key Referential Integrity via m_db.Relations
        If Not m_db Is Nothing And Left$(m_tdef.TableName, 4) <> "MSys" Then
            Dim relIdx As Long
            Dim relObj As Relation
            Dim relFldIdx As Long
            Dim fkColName As String
            Dim pkColName As String
            Dim fkColPos As Long
            Dim fkVal As Variant
            Dim pkTd As TableDef
            Dim pkRs As Recordset
            Dim pkMatchFound As Boolean
            Dim pkCellVal As Variant
            Dim dispCellVal As Variant

            For relIdx = 0 To m_db.Relations.Count - 1
                Set relObj = m_db.Relations.Item(relIdx)
                If Not relObj Is Nothing Then
                    If StrComp(relObj.ForeignTable, m_tdef.TableName, vbTextCompare) = 0 And (relObj.Attributes And 2) = 0 Then
                        For relFldIdx = 0 To relObj.Fields.Count - 1
                            pkColName = relObj.Fields.Item(relFldIdx).Name
                            fkColName = relObj.Fields.Item(relFldIdx).ForeignName
                            fkColPos = -1
                            For k = 0 To m_tdef.ColumnCount - 1
                                If StrComp(m_tdef.Columns(k).Name, fkColName, vbTextCompare) = 0 Then
                                    fkColPos = k
                                    Exit For
                                End If
                            Next k
                            If fkColPos >= 0 Then
                                fkVal = m_editBuffer(fkColPos)
                                If Not IsNull(fkVal) And Not IsEmpty(fkVal) Then
                                    If Len(Trim$(CStr(fkVal))) > 0 Then
                                        Set pkTd = Nothing
                                        On Error Resume Next
                                        Set pkTd = m_db.TableDefs.Item(relObj.Table)
                                        On Error GoTo 0
                                        If Not pkTd Is Nothing Then
                                            Set pkRs = Nothing
                                            On Error Resume Next
                                            Set pkRs = pkTd.OpenRecordset()
                                            On Error GoTo 0
                                            If Not pkRs Is Nothing Then
                                                pkMatchFound = False
                                                Do Until pkRs.EOF
                                                    On Error Resume Next
                                                    pkCellVal = pkRs.Fields(pkColName).Value
                                                    On Error GoTo 0
                                                    If Not IsNull(pkCellVal) And Not IsEmpty(pkCellVal) Then
                                                        If IsNumeric(fkVal) And IsNumeric(pkCellVal) Then
                                                            If CDbl(fkVal) = CDbl(pkCellVal) Then
                                                                pkMatchFound = True
                                                                Exit Do
                                                            End If
                                                        ElseIf StrComp(Trim$(CStr(fkVal)), Trim$(CStr(pkCellVal)), vbTextCompare) = 0 Then
                                                            pkMatchFound = True
                                                            Exit Do
                                                        End If
                                                        If pkRs.Fields.Count >= 2 Then
                                                            On Error Resume Next
                                                            dispCellVal = pkRs.Fields(1).Value
                                                            On Error GoTo 0
                                                            If Not IsNull(dispCellVal) And Not IsEmpty(dispCellVal) Then
                                                                If StrComp(Trim$(CStr(fkVal)), Trim$(CStr(dispCellVal)), vbTextCompare) = 0 Then
                                                                    m_editBuffer(fkColPos) = pkCellVal
                                                                    pkMatchFound = True
                                                                    Exit Do
                                                                End If
                                                            End If
                                                        End If
                                                    End If
                                                    pkRs.MoveNext
                                                Loop
                                                pkRs.Close
                                                If Not pkMatchFound Then
                                                    Err.Raise 3201, "Recordset.Update", "You cannot add or change a record because a related record is required in table '" & relObj.Table & "'."
                                                End If
                                            End If
                                        End If
                                    End If
                                End If
                            End If
                        Next relFldIdx
                    End If
                End If
            Next relIdx
        End If
    End Sub

    Public Sub Update()
        Dim totalPgs As Long
        Dim newPage As Long
        Dim newSlot As Integer
        Dim writeOk As Boolean
        Dim locStr As String
        Dim parts() As String
        Dim pNum As Long
        Dim sIdx As Integer

        EnsureOpen "Update"
        If Not m_db Is Nothing Then m_db.EnsureWritable "Update"
        If m_editMode = 0 Then
            Err.Raise 3020, "Recordset.Update", "Update or CancelUpdate without AddNew or Edit."
        End If

        ValidateRecordConstraints

        totalPgs = m_db.TotalPages
        writeOk = True

        If m_editMode = 2 Then
            ' Ensure any AutoNumber column that is still Null/Empty gets assigned before writing
            Dim aCol As Long
            For aCol = 0 To m_tdef.ColumnCount - 1
                If m_tdef.Columns(aCol).IsAutoNumber Then
                    If IsNull(m_editBuffer(aCol)) Or IsEmpty(m_editBuffer(aCol)) Then
                        If m_tdef.AutoNumberNext <= 0 Then m_tdef.AutoNumberNext = m_recordCount + 1
                        m_editBuffer(aCol) = m_tdef.AutoNumberNext
                    End If
                End If
            Next aCol
            ' Insert new record
            If m_tdef.TdefPageNumber > 0 And m_tdef.TdefPageNumber < totalPgs Then
                writeOk = RecordWriter.InsertRecord(m_db.FileNumber, totalPgs, m_tdef, m_editBuffer, newPage, newSlot)
                If Not writeOk Then
                    Err.Raise 3197, "Recordset.Update", "Failed to write inserted record to disk page."
                End If
                m_db.TotalPages = totalPgs
                If Not m_parentTdef Is Nothing Then m_parentTdef.UpdateDescriptor m_tdef
            ElseIf Not m_parentTdef Is Nothing Then
                m_tdef.RowCount = m_tdef.RowCount + 1
                m_tdef.AutoNumberNext = m_tdef.AutoNumberNext + 1
                m_parentTdef.UpdateDescriptor m_tdef
            End If
            m_rows.Add m_editBuffer
            m_locs.Add CStr(newPage) & "|" & CStr(newSlot)
            m_recordCount = m_rows.Count
            m_cursor = m_recordCount - 1
            m_bof = False
            m_eof = False
        ElseIf m_editMode = 1 Then
            ' Update existing record
            If m_tdef.TdefPageNumber > 0 And m_tdef.TdefPageNumber < totalPgs And m_cursor < m_locs.Count Then
                locStr = CStr(m_locs(m_cursor + 1))
                parts = Split(locStr, "|")
                If UBound(parts) >= 1 Then
                    pNum = CLng(Val(parts(0)))
                    sIdx = CInt(Val(parts(1)))
                    writeOk = RecordWriter.UpdateRecord(m_db.FileNumber, totalPgs, m_tdef, pNum, sIdx, m_editBuffer, newPage, newSlot)
                    If Not writeOk Then
                        Err.Raise 3197, "Recordset.Update", "Failed to write updated record to disk page."
                    End If
                    m_db.TotalPages = totalPgs
                    If Not m_parentTdef Is Nothing Then m_parentTdef.UpdateDescriptor m_tdef
                    ReplaceCollectionItemInPlace m_locs, m_cursor + 1, CStr(newPage) & "|" & CStr(newSlot)
                End If
            End If

            ReplaceCollectionItemInPlace m_rows, m_cursor + 1, m_editBuffer
        End If

        m_editMode = 0
    End Sub

    Private Sub ReplaceCollectionItemInPlace(ByVal col As Collection, ByVal oneBasedIdx As Long, ByVal newItem As Variant)
        If col Is Nothing Then Exit Sub
        If oneBasedIdx < 1 Or oneBasedIdx > col.Count Then Exit Sub
        If oneBasedIdx < col.Count Then
            col.Add newItem, , oneBasedIdx
            col.Remove oneBasedIdx + 1
        Else
            col.Remove oneBasedIdx
            col.Add newItem
        End If
    End Sub

    Public Sub CancelUpdate()
        m_editMode = 0
        Erase m_editBuffer
    End Sub

    Public Sub Delete()
        Dim totalPgs As Long
        Dim locStr As String
        Dim parts() As String
        Dim pNum As Long
        Dim sIdx As Integer

        EnsureOpen "Delete"
        If Not m_db Is Nothing Then m_db.EnsureWritable "Delete"
        If m_bof Or m_eof Or m_cursor < 0 Or m_cursor >= m_recordCount Then
            Err.Raise vbObjectError + 3021, "Recordset.Delete", "No current record."
        End If

        ' Check Referential Integrity before deleting parent row
        If Not m_db Is Nothing And Left$(m_tdef.TableName, 4) <> "MSys" Then
            Dim delRelIdx As Long
            Dim delRelObj As Relation
            Dim delRowArr() As Variant
            Dim delPkCol As String
            Dim delFkCol As String
            Dim delPkVal As Variant
            Dim delColScan As Long
            Dim childTd As TableDef
            Dim childRs As Recordset
            Dim childVal As Variant
            Dim childMatch As Boolean

            delRowArr = m_rows(m_cursor + 1)
            For delRelIdx = 0 To m_db.Relations.Count - 1
                Set delRelObj = m_db.Relations.Item(delRelIdx)
                If Not delRelObj Is Nothing Then
                    If StrComp(delRelObj.Table, m_tdef.TableName, vbTextCompare) = 0 And (delRelObj.Attributes And 2) = 0 And delRelObj.Fields.Count > 0 Then
                        delPkCol = delRelObj.Fields.Item(0).Name
                        delFkCol = delRelObj.Fields.Item(0).ForeignName
                        delPkVal = Null
                        For delColScan = 0 To m_tdef.ColumnCount - 1
                            If StrComp(m_tdef.Columns(delColScan).Name, delPkCol, vbTextCompare) = 0 Then
                                delPkVal = delRowArr(delColScan)
                                Exit For
                            End If
                        Next delColScan
                        If Not IsNull(delPkVal) And Not IsEmpty(delPkVal) Then
                            Set childTd = Nothing
                            On Error Resume Next
                            Set childTd = m_db.TableDefs.Item(delRelObj.ForeignTable)
                            On Error GoTo 0
                            If Not childTd Is Nothing Then
                                Set childRs = Nothing
                                On Error Resume Next
                                Set childRs = childTd.OpenRecordset()
                                On Error GoTo 0
                                If Not childRs Is Nothing Then
                                    Do Until childRs.EOF
                                        childMatch = False
                                        On Error Resume Next
                                        childVal = childRs.Fields(delFkCol).Value
                                        On Error GoTo 0
                                        If Not IsNull(childVal) And Not IsEmpty(childVal) Then
                                            If IsNumeric(delPkVal) And IsNumeric(childVal) Then
                                                childMatch = (CDbl(delPkVal) = CDbl(childVal))
                                            Else
                                                childMatch = (StrComp(Trim$(CStr(delPkVal)), Trim$(CStr(childVal)), vbTextCompare) = 0)
                                            End If
                                        End If
                                        If childMatch Then
                                            If (delRelObj.Attributes And 4096) <> 0 Then
                                                childRs.Delete
                                            Else
                                                childRs.Close
                                                Err.Raise 3200, "Recordset.Delete", "The record cannot be deleted or changed because table '" & delRelObj.ForeignTable & "' includes related records."
                                            End If
                                        Else
                                            childRs.MoveNext
                                        End If
                                    Loop
                                    childRs.Close
                                End If
                            End If
                        End If
                    End If
                End If
            Next delRelIdx
        End If

        totalPgs = m_db.TotalPages
        If m_tdef.TdefPageNumber > 0 And m_tdef.TdefPageNumber < totalPgs And m_cursor < m_locs.Count Then
            locStr = CStr(m_locs(m_cursor + 1))
            parts = Split(locStr, "|")
            If UBound(parts) >= 1 Then
                pNum = CLng(Val(parts(0)))
                sIdx = CInt(Val(parts(1)))
                RecordWriter.DeleteRecordOnPage m_db.FileNumber, totalPgs, m_tdef, pNum, sIdx
                If Not m_parentTdef Is Nothing Then m_parentTdef.UpdateDescriptor m_tdef
            End If
        End If
        m_rows.Remove m_cursor + 1
        If m_cursor < m_locs.Count Then m_locs.Remove m_cursor + 1
        m_recordCount = m_rows.Count
        If m_recordCount = 0 Then
            m_cursor = -1
            m_bof = True
            m_eof = True
        ElseIf m_cursor >= m_recordCount Then
            m_cursor = m_recordCount
            m_eof = True
        End If
        m_editMode = 0
    End Sub

    Public Function Clone() As Recordset
        Dim clonedRs As New Recordset
        clonedRs.Init m_db, m_tdef, m_rows, m_locs, m_parentTdef
        Set Clone = clonedRs
    End Function

    Public Property Get BOF() As Boolean
        EnsureOpen "BOF"
        BOF = m_bof
    End Property

    Public Property Get EOF() As Boolean
        EnsureOpen "EOF"
        EOF = m_eof
    End Property

    Public Property Get RecordCount() As Long
        EnsureOpen "RecordCount"
        RecordCount = m_recordCount
    End Property

    Public Property Get AbsolutePosition() As Long
        EnsureOpen "AbsolutePosition"
        If m_bof Or m_eof Or m_cursor < 0 Or m_cursor >= m_recordCount Then
            AbsolutePosition = -1
        Else
            AbsolutePosition = m_cursor
        End If
    End Property

    Public Property Get Descriptor() As TableDefDescriptor
        Descriptor = m_tdef
    End Property

    Public Property Get TableDefDescriptor() As TableDefDescriptor
        TableDefDescriptor = m_tdef
    End Property

    Public Function EvaluateExpression(ByVal expr As String) As Variant
        If Not m_db Is Nothing Then
            EvaluateExpression = m_db.EvaluateExpression(expr, Me)
        Else
            EvaluateExpression = Null
        End If
    End Function

    Public Property Get Fields() As Fields
        EnsureOpen "Fields"
        Set Fields = m_fields
    End Property

    Public Sub MoveFirst()
        EnsureOpen "MoveFirst"
        m_editMode = 0
        If m_recordCount = 0 Then
            m_bof = True
            m_eof = True
            m_cursor = -1
        Else
            m_cursor = 0
            m_bof = False
            m_eof = False
        End If
    End Sub

    Public Sub MoveNext()
        EnsureOpen "MoveNext"
        m_editMode = 0
        If m_eof Then Exit Sub
        m_cursor = m_cursor + 1
        If m_cursor >= m_recordCount Then
            m_eof = True
            m_cursor = m_recordCount
        End If
        m_bof = False
    End Sub

    Public Sub MovePrevious()
        EnsureOpen "MovePrevious"
        m_editMode = 0
        If m_bof Then Exit Sub
        m_cursor = m_cursor - 1
        If m_cursor < 0 Then
            m_bof = True
            m_cursor = -1
        End If
        m_eof = False
    End Sub

    Public Sub MoveLast()
        EnsureOpen "MoveLast"
        m_editMode = 0
        If m_recordCount = 0 Then
            m_bof = True
            m_eof = True
            m_cursor = -1
        Else
            m_cursor = m_recordCount - 1
            m_bof = False
            m_eof = False
        End If
    End Sub

    Public Property Get Index() As String
        Index = m_currentIndex
    End Property

    Public Property Let Index(ByVal v As String)
        Dim idxName As String
        idxName = Trim$(v)
        If Len(idxName) = 0 Then
            m_currentIndex = ""
            Exit Property
        End If
        If Not m_parentTdef Is Nothing Then
            Dim idxObj As Index
            On Error Resume Next
            Set idxObj = m_parentTdef.Indexes(idxName)
            On Error GoTo 0
            If idxObj Is Nothing Then
                Err.Raise vbObjectError + 3800, "Recordset.Index", "'" & idxName & "' is not an index in this table."
            End If
        End If
        m_currentIndex = idxName
    End Property

    Public Property Get NoMatch() As Boolean
        NoMatch = m_noMatch
    End Property

    Public Sub Seek(ByVal Comparison As String, ByVal Key1 As Variant, Optional ByVal Key2 As Variant = Empty)
        EnsureOpen "Seek"
        If Len(m_currentIndex) = 0 Then
            Err.Raise vbObjectError + 3019, "Recordset.Seek", "No current index set for Seek."
        End If
        Dim idxObj As Index
        If Not m_parentTdef Is Nothing Then
            On Error Resume Next
            Set idxObj = m_parentTdef.Indexes(m_currentIndex)
            On Error GoTo 0
        End If
        If idxObj Is Nothing Or idxObj.ColumnCount = 0 Then
            Err.Raise vbObjectError + 3800, "Recordset.Seek", "Index '" & m_currentIndex & "' not found or has no columns."
        End If
        Dim colName As String
        colName = idxObj.ColumnName(0)
        Dim colIdx As Long
        colIdx = -1
        Dim i As Long
        For i = 0 To m_tdef.ColumnCount - 1
            If StrComp(m_tdef.Columns(i).Name, colName, vbTextCompare) = 0 Then
                colIdx = i
                Exit For
            End If
        Next i
        If colIdx < 0 Then
            m_noMatch = True
            m_eof = True
            Exit Sub
        End If
        Dim compOp As String
        compOp = Trim$(Comparison)
        Dim matchFound As Boolean
        matchFound = False
        Dim r As Long
        For r = 0 To m_recordCount - 1
            Dim rowVals() As Variant
            rowVals = m_rows(r + 1)
            Dim cellVal As Variant
            cellVal = rowVals(colIdx)
            Dim isCmpMatch As Boolean
            isCmpMatch = False
            If Not IsNull(cellVal) And Not IsNull(Key1) Then
                Select Case compOp
                    Case "=", "=="
                        If VarType(cellVal) = vbString Or VarType(Key1) = vbString Then
                            isCmpMatch = (StrComp(CStr(cellVal), CStr(Key1), vbTextCompare) = 0)
                        Else
                            isCmpMatch = (cellVal = Key1)
                        End If
                    Case ">="
                        isCmpMatch = (cellVal >= Key1)
                    Case "<="
                        isCmpMatch = (cellVal <= Key1)
                    Case ">"
                        isCmpMatch = (cellVal > Key1)
                    Case "<"
                        isCmpMatch = (cellVal < Key1)
                End Select
            ElseIf IsNull(cellVal) And IsNull(Key1) Then
                If compOp = "=" Or compOp = "==" Or compOp = ">=" Or compOp = "<=" Then
                    isCmpMatch = True
                End If
            End If
            If isCmpMatch Then
                m_cursor = r
                m_bof = False
                m_eof = False
                m_noMatch = False
                matchFound = True
                Exit For
            End If
        Next r
        If Not matchFound Then
            m_noMatch = True
            m_eof = True
            m_cursor = m_recordCount
        End If
    End Sub

    Public Sub [Close]()
        m_isOpen = False
        m_bof = True
        m_eof = True
        m_editMode = 0
        Set m_rows = Nothing
        Set m_locs = Nothing
    End Sub

    Private Sub EnsureOpen(ByVal memberName As String)
        If Not m_isOpen Then
            Err.Raise vbObjectError + 3420, "Recordset." & memberName, "Object invalid or no longer set."
        End If
    End Sub
End Class
[ClassId("a5c5a971-a97c-4c7f-a247-2ca3fb2a92b6")]
[InterfaceId("c8739f66-e1b0-4308-99e2-48f5a852e579")]
[COMCreatable(False)]

Public Class Fields
    Private m_items As New Collection

    Friend Sub InitForTable(ByRef tdefDesc As TableDefDescriptor)
        Set m_items = New Collection
        Dim i As Integer
        For i = 0 To tdefDesc.ColumnCount - 1
            Dim fld As Field
            Set fld = New Field
            Dim colSrcTbl As String
            colSrcTbl = tdefDesc.Columns(i).SourceTable
            If Len(colSrcTbl) = 0 Then colSrcTbl = tdefDesc.TableName
            fld.Init tdefDesc.Columns(i).Name, CInt(tdefDesc.Columns(i).ColType), CLng(tdefDesc.Columns(i).ByteLength), Nothing, CLng(i), tdefDesc.Columns(i).IsAutoNumber, colSrcTbl
            On Error Resume Next
            m_items.Add fld, UCase$(tdefDesc.Columns(i).Name)
            If Err.Number <> 0 Then
                Err.Clear
                m_items.Add fld, UCase$(tdefDesc.Columns(i).Name) & "_DUP_" & CStr(i)
            End If
            On Error GoTo 0
        Next i
    End Sub

    Friend Sub InitForRecordset(ByVal parentRs As Recordset, ByRef tdefDesc As TableDefDescriptor)
        Set m_items = New Collection
        Dim i As Integer
        For i = 0 To tdefDesc.ColumnCount - 1
            Dim fld As Field
            Set fld = New Field
            Dim colSrcTblRs As String
            colSrcTblRs = tdefDesc.Columns(i).SourceTable
            If Len(colSrcTblRs) = 0 Then colSrcTblRs = tdefDesc.TableName
            fld.Init tdefDesc.Columns(i).Name, CInt(tdefDesc.Columns(i).ColType), CLng(tdefDesc.Columns(i).ByteLength), parentRs, CLng(i), tdefDesc.Columns(i).IsAutoNumber, colSrcTblRs
            On Error Resume Next
            m_items.Add fld, UCase$(tdefDesc.Columns(i).Name)
            If Err.Number <> 0 Then
                Err.Clear
                m_items.Add fld, UCase$(tdefDesc.Columns(i).Name) & "_DUP_" & CStr(i)
            End If
            On Error GoTo 0
        Next i
    End Sub

    Public Property Get Count() As Long
        Count = m_items.Count
    End Property
    [DefaultMember]

    Public Property Get Item(ByVal IndexOrName As Variant) As Field
        If VarType(IndexOrName) = vbString Then
            Dim key As String
            key = UCase$(Trim$(Replace$(Replace$(CStr(IndexOrName), "[", ""), "]", "")))
            Dim dotPos As Long
            dotPos = InStrRev(key, ".")
            If dotPos > 0 Then
                Dim reqTbl As String, reqCol As String
                reqTbl = Trim$(Left$(key, dotPos - 1))
                reqCol = Trim$(Mid$(key, dotPos + 1))
                Dim fScan As Field
                For Each fScan In m_items
                    If StrComp(fScan.SourceTable, reqTbl, vbTextCompare) = 0 And StrComp(fScan.Name, reqCol, vbTextCompare) = 0 Then
                        Set Item = fScan
                        Exit Property
                    End If
                Next fScan
                key = reqCol
            End If
            On Error Resume Next
            Dim fld As Field
            Set fld = m_items(key)
            On Error GoTo 0
            If fld Is Nothing Then
                Err.Raise vbObjectError + 3265, "Fields.Item", "Item not found in this collection."
            End If
            Set Item = fld
        Else
            Dim idx As Long
            idx = CLng(IndexOrName)
            If idx < 0 Or idx >= m_items.Count Then
                Err.Raise vbObjectError + 3265, "Fields.Item", "Item not found in this collection."
            End If
            Set Item = m_items(idx + 1)
        End If
    End Property

    Public Sub Append(ByVal fld As Field)
        If fld Is Nothing Then Exit Sub
        Dim key As String
        key = UCase$(fld.Name)
        On Error Resume Next
        m_items.Remove key
        m_items.Add fld, key
        On Error GoTo 0
    End Sub

    Public Sub Delete(ByVal IndexOrName As Variant)
        If VarType(IndexOrName) = vbString Then
            On Error Resume Next
            m_items.Remove UCase$(Trim$(CStr(IndexOrName)))
            On Error GoTo 0
        Else
            Dim n As Long
            n = CLng(IndexOrName)
            If n >= 0 And n < m_items.Count Then
                m_items.Remove n + 1
            End If
        End If
    End Sub
End Class
[ClassId("a5e5a748-9586-4224-9afc-5bd676f34b34")]
[InterfaceId("02455d52-e7e6-46be-ae67-0a2c5f06883f")]
[COMCreatable(False)]

Public Class Field
    Private m_name As String
    Private m_type As Integer
    Private m_size As Long
    Private m_rs As Recordset
    Private m_colIndex As Long
    Private m_isAutoNum As Boolean
    Private m_sourceTable As String
    Public ForeignName As String
    Public Required As Boolean
    Public AllowZeroLength As Boolean = True
    Public DefaultValue As String
    Public ValidationRule As String
    Public ValidationText As String

    Friend Sub Init(ByVal fName As String, ByVal fType As Integer, ByVal fSize As Long, ByVal parentRs As Recordset, ByVal colIndex As Long, Optional ByVal isAutoNum As Boolean = False, Optional ByVal srcTable As String = "")
        m_name = fName
        m_type = fType
        m_size = fSize
        Set m_rs = parentRs
        m_colIndex = colIndex
        m_isAutoNum = isAutoNum
        m_sourceTable = srcTable
    End Sub

    Public Property Get Name() As String
        Name = m_name
    End Property

    Public Property Get [Type]() As Integer
        [Type] = m_type
    End Property

    Public Property Get Size() As Long
        Size = m_size
    End Property

    Public Property Get Attributes() As Long
        If m_isAutoNum Then Attributes = &H10& Else Attributes = 0&
    End Property

    Public Property Get SourceTable() As String
        SourceTable = m_sourceTable
    End Property

    Public Property Let SourceTable(ByVal v As String)
        m_sourceTable = v
    End Property
    [DefaultMember]

    Public Property Get Value() As Variant
        If m_rs Is Nothing Then
            Value = Null
        Else
            Value = m_rs.GetCurrentRowValue(m_colIndex)
        End If
    End Property
    [DefaultMember]

    Public Property Let Value(ByVal NewVal As Variant)
        If m_rs Is Nothing Then
            Err.Raise vbObjectError + 3420, "Field.Value", "Field is not bound to an active Recordset."
        End If
        m_rs.SetCurrentRowValue m_colIndex, NewVal
    End Property
End Class
[ClassId("2de323e7-5c80-4422-8ef6-1087fe20b283")]
[InterfaceId("fcfcd0b5-aee2-4f4f-b325-12cb452cc435")]
[COMCreatable(False)]

Public Class Parameter
    Public Name As String
    Public [Type] As Long
    Public Value As Variant
End Class
[ClassId("8615e244-b605-4162-b8ba-b7b6838655ae")]
[InterfaceId("eade8a62-0461-4f33-b61d-d945f64d4280")]
[COMCreatable(False)]

Public Class Parameters
    Private m_items As New Collection

    Public Property Get Count() As Long
        Count = m_items.Count
    End Property
    [DefaultMember]

    Public Property Get Item(ByVal IndexOrName As Variant) As Parameter
        If VarType(IndexOrName) = vbString Then
            On Error Resume Next
            Set Item = m_items(UCase$(CStr(IndexOrName)))
            On Error GoTo 0
        Else
            Dim idx As Long
            idx = CLng(IndexOrName)
            If idx >= 0 And idx < m_items.Count Then
                Set Item = m_items(idx + 1)
            End If
        End If
    End Property

    Friend Sub AddParameter(ByVal p As Parameter)
        If Len(p.Name) > 0 Then
            On Error Resume Next
            m_items.Add p, UCase$(p.Name)
            On Error GoTo 0
        Else
            m_items.Add p
        End If
    End Sub
End Class
[ClassId("e94f1c8a-78b2-4d10-8b1e-92a0194857b1")]
[InterfaceId("a8123c50-3d71-4a92-91f0-28e49175a2bc")]
[COMCreatable(False)]

Public Class QueryDef
    Private m_db As Database
    Private m_params As New Parameters
    Public Name As String
    Private m_sql As String
    Public [Type] As Long
    Public Connect As String
    Public ReturnsRecords As Boolean = True
    Private m_loading As Boolean

    Friend Sub Init(ByVal parentDb As Database, Optional ByVal isLoading As Boolean = False)
        Set m_db = parentDb
        m_loading = isLoading
    End Sub

    Public Property Get SQL() As String
        SQL = m_sql
    End Property

    Public Property Let SQL(ByVal val As String)
        m_sql = val
        If Not m_db Is Nothing And Len(Trim$(Me.Name)) > 0 And Not m_loading Then
            If m_db.HasQueryName(Me.Name) Then
                m_db.PersistQueryDefToCatalog Me
            End If
        End If
    End Property

    Public Property Get Parameters() As Parameters
        Set Parameters = m_params
    End Property

    Public Property Get Fields() As Fields
        Dim flds As New Fields
        If Not m_db Is Nothing And Len(Trim$(m_sql)) > 0 Then
            On Error Resume Next
            Dim rs As Recordset
            Set rs = Me.OpenRecordset()
            If Err.Number = 0 And Not rs Is Nothing Then
                If Not rs.Fields Is Nothing Then
                    If rs.Fields.Count > 0 Then
                        Set Fields = rs.Fields
                        On Error GoTo 0
                        Exit Property
                    End If
                End If
            End If
            Err.Clear
            Dim stmt As SqlStatement
            stmt = SqlParser.ParseSql(m_sql)
            If Len(Trim$(stmt.SelectClause)) > 0 Then
                Dim items() As String
                items = Split(stmt.SelectClause, ",")
                Dim i As Long
                For i = LBound(items) To UBound(items)
                    Dim rawItm As String
                    rawItm = Trim$(items(i))
                    If Len(rawItm) > 0 Then
                        Dim asPos As Long
                        asPos = SqlParser.FindSqlClauseKeyword(rawItm, "AS")
                        Dim cName As String
                        If asPos > 0 Then
                            cName = Trim$(Mid$(rawItm, asPos + 2))
                        Else
                            Dim dotPos As Long
                            dotPos = InStrRev(rawItm, ".")
                            If dotPos > 0 Then
                                cName = Trim$(Mid$(rawItm, dotPos + 1))
                            Else
                                cName = rawItm
                            End If
                        End If
                        cName = Trim$(Replace$(Replace$(cName, "[", ""), "]", ""))
                        If Len(cName) > 0 And cName <> "*" Then
                            Dim f As New Field
                            f.Init cName, 10, 255, Nothing, flds.Count, False, Me.Name
                            flds.Append f
                        End If
                    End If
                Next i
            End If
            On Error GoTo 0
        End If
        Set Fields = flds
    End Property

    Public Property Get RecordsAffected() As Long
        If m_db Is Nothing Then RecordsAffected = 0 Else RecordsAffected = m_db.RecordsAffected
    End Property

    Public Sub Execute(Optional ByVal Options As Variant)
        If Not m_db Is Nothing Then
            m_db.Execute Me.SQL, Options
        End If
    End Sub

    Public Function OpenRecordset(Optional ByVal RecordsetType As Variant, Optional ByVal Options As Variant) As Recordset
        If m_db Is Nothing Then
            Dim emptyRs As New Recordset
            Set OpenRecordset = emptyRs
            Exit Function
        End If
        Set OpenRecordset = m_db.OpenRecordset(Me.SQL, RecordsetType, Options)
    End Function

    Public Sub [Close]()
    End Sub
End Class
[ClassId("f0123a45-6789-4bcd-ef01-23456789abcd")]
[InterfaceId("e0123a45-6789-4bcd-ef01-23456789abcd")]
[COMCreatable(False)]

Public Class QueryDefs
    Private m_items As New Collection
    Private m_db As Database

    Friend Sub Init(ByVal parentDb As Database)
        Set m_db = parentDb
    End Sub

    Public Property Get Count() As Long
        Count = m_items.Count
    End Property
    [DefaultMember]

    Public Property Get Item(ByVal IndexOrName As Variant) As QueryDef
        If VarType(IndexOrName) = vbString Then
            Dim key As String
            key = UCase$(CStr(IndexOrName))
            On Error Resume Next
            Set Item = m_items(key)
            On Error GoTo 0
        Else
            Dim idx As Long
            idx = CLng(IndexOrName)
            If idx >= 0 And idx < m_items.Count Then
                Set Item = m_items(idx + 1)
            End If
        End If
    End Property

    Friend Sub AddQueryDef(ByVal qd As QueryDef)
        If Len(qd.Name) > 0 Then
            On Error Resume Next
            m_items.Remove UCase$(qd.Name)
            m_items.Add qd, UCase$(qd.Name)
            On Error GoTo 0
        Else
            m_items.Add qd
        End If
    End Sub

    Public Sub Append(ByVal qd As QueryDef)
        If qd Is Nothing Then Exit Sub
        AddQueryDef qd
        If Not m_db Is Nothing And Len(Trim$(qd.Name)) > 0 Then
            m_db.PersistQueryDefToCatalog qd
        End If
    End Sub

    Public Sub Delete(ByVal queryName As String)
        On Error Resume Next
        m_items.Remove UCase$(Trim$(queryName))
        If Not m_db Is Nothing Then
            m_db.DeleteQueryDefFromCatalog queryName
        End If
        On Error GoTo 0
    End Sub

    Public Sub Refresh()
    End Sub
End Class

Public Class Relation
    Private m_name As String
    Private m_table As String
    Private m_foreignTable As String
    Private m_attributes As Long
    Private m_fields As Fields

    Public Sub New()
        Set m_fields = New Fields
    End Sub

    Friend Sub Init(ByVal relName As String, ByVal tbl As String, ByVal foreignTbl As String, Optional ByVal attrs As Long = 0)
        m_name = relName
        m_table = tbl
        m_foreignTable = foreignTbl
        m_attributes = attrs
        Set m_fields = New Fields
    End Sub

    Public Property Get Name() As String
        Name = m_name
    End Property

    Public Property Let Name(ByVal v As String)
        m_name = v
    End Property

    Public Property Get Table() As String
        Table = m_table
    End Property

    Public Property Let Table(ByVal v As String)
        m_table = v
    End Property

    Public Property Get ForeignTable() As String
        ForeignTable = m_foreignTable
    End Property

    Public Property Let ForeignTable(ByVal v As String)
        m_foreignTable = v
    End Property

    Public Property Get Attributes() As Long
        Attributes = m_attributes
    End Property

    Public Property Let Attributes(ByVal v As Long)
        m_attributes = v
    End Property

    Public Property Get Fields() As Fields
        Set Fields = m_fields
    End Property

    Public Function CreateField(Optional ByVal fName As Variant) As Field
        Dim f As New Field
        Dim sName As String
        If Not IsMissing(fName) Then sName = CStr(fName)
        f.Init sName, 10, 255, Nothing, -1, False, m_table
        Set CreateField = f
    End Function
End Class

Public Class Relations
    Private m_items As New Collection
    Private m_db As Database

    Friend Sub Init(ByVal parentDb As Database)
        Set m_db = parentDb
    End Sub

    Public Property Get Count() As Long
        Count = m_items.Count
    End Property
    [DefaultMember]

    Public Property Get Item(ByVal IndexOrName As Variant) As Relation
        If VarType(IndexOrName) = vbString Then
            Dim key As String
            key = UCase$(Trim$(Replace$(Replace$(CStr(IndexOrName), "[", ""), "]", "")))
            On Error Resume Next
            Set Item = m_items(key)
            On Error GoTo 0
        Else
            Dim idx As Long
            idx = CLng(IndexOrName)
            If idx >= 0 And idx < m_items.Count Then
                Set Item = m_items(idx + 1)
            End If
        End If
    End Property

    Friend Sub AddLoadedRelation(ByVal rel As Relation)
        If rel Is Nothing Then Exit Sub
        On Error Resume Next
        If Len(rel.Name) > 0 Then
            m_items.Remove UCase$(rel.Name)
            m_items.Add rel, UCase$(rel.Name)
        Else
            m_items.Add rel
        End If
        On Error GoTo 0
    End Sub

    Public Sub Append(ByVal rel As Relation)
        If rel Is Nothing Then Exit Sub
        On Error Resume Next
        If Len(rel.Name) > 0 Then
            m_items.Remove UCase$(rel.Name)
            m_items.Add rel, UCase$(rel.Name)
        Else
            m_items.Add rel
        End If
        If Not m_db Is Nothing Then
            m_db.PersistRelationToCatalog rel
        End If
        On Error GoTo 0
    End Sub

    Public Sub Delete(ByVal relName As String)
        On Error Resume Next
        Dim oldForeignTbl As String
        Dim existingRel As Relation
        Set existingRel = m_items(UCase$(Trim$(relName)))
        If Not existingRel Is Nothing Then
            oldForeignTbl = existingRel.ForeignTable
        End If
        m_items.Remove UCase$(Trim$(relName))
        If Not m_db Is Nothing Then
            m_db.DeleteRelationFromCatalog relName
            m_db.RemoveForeignKeyIndexFromTdefs relName
            If Len(Trim$(oldForeignTbl)) > 0 Then
                m_db.SyncTableLookupLvProp oldForeignTbl
            End If
        End If
        On Error GoTo 0
    End Sub

    Public Sub Refresh()
    End Sub
End Class

[ClassId("9832d201-90a1-4ee3-b09a-18cb55f11001")]
[InterfaceId("27891cf1-4562-42da-9f82-a98263124891")]
[COMCreatable(False)]

Public Class Indexes
    Private m_items As New Collection

    Friend Sub InitForTable(ByVal parentTd As TableDef, ByRef tdefDesc As TableDefDescriptor)
        Set m_items = New Collection
        Dim i As Integer
        For i = 0 To tdefDesc.IndexCount - 1
            Dim idxObj As New Index
            idxObj.InitFromDescriptor parentTd, tdefDesc.Indexes(i)
            On Error Resume Next
            m_items.Add idxObj, UCase$(tdefDesc.Indexes(i).Name)
            If Err.Number <> 0 Then
                Err.Clear
                m_items.Add idxObj, UCase$(tdefDesc.Indexes(i).Name) & "_DUP_" & CStr(i)
            End If
            On Error GoTo 0
        Next i
    End Sub

    Public Property Get Count() As Long
        Count = m_items.Count
    End Property
    [DefaultMember]

    Public Property Get Item(ByVal IndexOrName As Variant) As Index
        If VarType(IndexOrName) = vbString Then
            Dim key As String
            key = UCase$(CStr(IndexOrName))
            On Error Resume Next
            Dim idx As Index
            Set idx = m_items(key)
            On Error GoTo 0
            If idx Is Nothing Then
                Err.Raise vbObjectError + 3265, "Indexes.Item", "Item not found in this collection: " & CStr(IndexOrName)
            End If
            Set Item = idx
        Else
            Dim n As Long
            n = CLng(IndexOrName)
            If n < 0 Or n >= m_items.Count Then
                Err.Raise vbObjectError + 3265, "Indexes.Item", "Subscript out of range: " & CStr(IndexOrName)
            End If
            Set Item = m_items(n + 1)
        End If
    End Property

    Public Sub Append(ByVal idx As Index)
        If idx Is Nothing Then Exit Sub
        Dim key As String
        key = UCase$(Trim$(idx.Name))
        If Len(key) = 0 Then Exit Sub
        On Error Resume Next
        m_items.Remove key
        m_items.Add idx, key
        On Error GoTo 0
    End Sub

    Public Sub Delete(ByVal IndexOrName As Variant)
        If VarType(IndexOrName) = vbString Then
            On Error Resume Next
            m_items.Remove UCase$(Trim$(CStr(IndexOrName)))
            On Error GoTo 0
        Else
            Dim n As Long
            n = CLng(IndexOrName)
            If n >= 0 And n < m_items.Count Then
                m_items.Remove n + 1
            End If
        End If
    End Sub

    Public Sub Refresh()
    End Sub
End Class
[ClassId("38e89f10-9112-4aa3-8fa2-09418293d002")]
[InterfaceId("48cb5e23-7182-411a-8219-583920194821")]
[COMCreatable(False)]

Public Class Index
    Private m_parentTd As TableDef
    Private m_name As String
    Private m_primary As Boolean
    Private m_unique As Boolean
    Private m_clustered As Boolean
    Private m_ignoreNulls As Boolean
    Private m_required As Boolean
    Private m_foreign As Boolean
    Private m_fields As Fields
    Private m_colNames() As String
    Private m_colCount As Long

    Public Sub New()
        Set m_fields = New Fields
    End Sub

    Friend Sub InitFromDescriptor(ByVal parentTd As TableDef, ByRef idxDesc As IndexDescriptor)
        Set m_parentTd = parentTd
        m_name = idxDesc.Name
        m_primary = idxDesc.IsPrimary
        m_unique = idxDesc.IsUnique
        m_foreign = (idxDesc.IndexType = 2)
        m_colCount = idxDesc.ColumnCount
        Set m_fields = New Fields
        If m_colCount > 0 Then
            ReDim m_colNames(0 To m_colCount - 1)
            Dim c As Integer
            For c = 0 To m_colCount - 1
                m_colNames(c) = idxDesc.ColumnNames(c)
                Dim fld As New Field
                fld.Init idxDesc.ColumnNames(c), 10, 0, Nothing, c, False, ""
                m_fields.Append fld
            Next c
        End If
    End Sub

    Public Property Get Name() As String
        Name = m_name
    End Property

    Public Property Let Name(ByVal v As String)
        m_name = v
    End Property

    Public Property Get Primary() As Boolean
        Primary = m_primary
    End Property

    Public Property Let Primary(ByVal v As Boolean)
        m_primary = v
        If v Then m_unique = True
    End Property

    Public Property Get Unique() As Boolean
        Unique = m_unique
    End Property

    Public Property Let Unique(ByVal v As Boolean)
        m_unique = v
    End Property

    Public Property Get Clustered() As Boolean
        Clustered = m_clustered
    End Property

    Public Property Let Clustered(ByVal v As Boolean)
        m_clustered = v
    End Property

    Public Property Get IgnoreNulls() As Boolean
        IgnoreNulls = m_ignoreNulls
    End Property

    Public Property Let IgnoreNulls(ByVal v As Boolean)
        m_ignoreNulls = v
    End Property

    Public Property Get Required() As Boolean
        Required = m_required
    End Property

    Public Property Let Required(ByVal v As Boolean)
        m_required = v
    End Property

    Public Property Get Foreign() As Boolean
        Foreign = m_foreign
    End Property

    Public Property Get Fields() As Fields
        Set Fields = m_fields
    End Property

    Public Function CreateField(Optional ByVal Name As Variant = "", Optional ByVal Type As Variant = Empty, Optional ByVal Size As Variant = Empty) As Field
        Dim f As New Field
        Dim fName As String
        If Not IsMissing(Name) Then fName = CStr(Name)
        f.Init fName, 10, 0, Nothing, m_fields.Count, False, ""
        Set CreateField = f
    End Function

    Friend Sub AddColumnName(ByVal colName As String)
        ReDim Preserve m_colNames(0 To m_colCount)
        m_colNames(m_colCount) = colName
        m_colCount = m_colCount + 1
        Dim fld As New Field
        fld.Init colName, 10, 0, Nothing, m_fields.Count, False, ""
        m_fields.Append fld
    End Sub

    Friend Property Get ColumnCount() As Long
        ColumnCount = m_colCount
    End Property

    Friend Property Get ColumnName(ByVal idx As Long) As String
        If idx >= 0 And idx < m_colCount Then
            ColumnName = m_colNames(idx)
        End If
    End Property
End Class

Public Module ArabicCollationHelper
    ' Normalizes Arabic strings for collation, search (= and LIKE) and sorting (ORDER BY)
    ' Unifies:
    ' - Alef with Hamza Above (&H0623), Below (&H0625), Madda (&H0622), Wasla (&H0671) -> Alef (&H0627)
    ' - Teh Marbuta (&H0629) -> Heh (&H0647)
    ' - Alef Maksura (&H0649) and Yeh with Hamza (&H0626) -> Yeh (&H064A)
    ' - Waw with Hamza (&H0624) -> Waw (&H0648)
    ' Removes:
    ' - Tashkeel / Harakat (&H064B To &H0652)
    ' - Maddah / Hamza marks (&H0653 To &H0655, &H0670)
    ' - Tatweel / Kashida (&H0640)

    Public Function NormalizeArabicForComparison(ByVal s As String) As String
        If Len(s) = 0 Then
            NormalizeArabicForComparison = ""
            Exit Function
        End If
        Dim res As String
        Dim i As Long, chCode As Long
        Dim ch As String
        res = ""
        For i = 1 To Len(s)
            ch = Mid$(s, i, 1)
            chCode = AscW(ch) And &HFFFF&
            Select Case chCode
                Case &H064B To &H0652, &H0653 To &H0655, &H0670, &H0640
                    ' Strip diacritics / tatweel
                Case &H0622, &H0623, &H0625, &H0671
                    res = res & ChrW$(&H0627)
                Case &H0629
                    res = res & ChrW$(&H0647)
                Case &H0649, &H0626
                    res = res & ChrW$(&H064A)
                Case &H0624
                    res = res & ChrW$(&H0648)
                Case Else
                    res = res & ch
            End Select
        Next i
        NormalizeArabicForComparison = res
    End Function

    Public Function HasArabicUnicode(ByVal s As String) As Boolean
        Dim i As Long, chCode As Long
        For i = 1 To Len(s)
            chCode = AscW(Mid$(s, i, 1)) And &HFFFF&
            If (chCode >= &H0600& And chCode <= &H06FF&) Or (chCode >= &H0750& And chCode <= &H077F&) Or (chCode >= &H08A0& And chCode <= &H08FF&) Or (chCode >= &HFB50& And chCode <= &HFDFF&) Or (chCode >= &HFE70& And chCode <= &HFEFF&) Then
                HasArabicUnicode = True
                Exit Function
            End If
        Next i
        HasArabicUnicode = False
    End Function
End Module

Public Module LinkedTableHelper

    Public Function ExtractDatabasePathFromConnect(ByVal conn As String) As String
        Dim s As String
        s = Trim$(conn)
        If Len(s) = 0 Then Exit Function
        Dim p As Long
        p = InStr(1, s, "DATABASE=", vbTextCompare)
        If p > 0 Then
            s = Mid$(s, p + 9)
            Dim sc As Long
            sc = InStr(1, s, ";")
            If sc > 0 Then s = Left$(s, sc - 1)
            ExtractDatabasePathFromConnect = Trim$(s)
        Else
            ExtractDatabasePathFromConnect = s
        End If
    End Function
End Module
